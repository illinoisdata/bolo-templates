{% set repo_id = repo_id | default("LiquidAI/LFM2.5-1.2B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('LFM2.5-1.2B-Instruct-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short haiku about on-device AI.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = {{ prompt | tojson }}

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=weights_path,
    n_ctx=256,
    n_threads=max(1, (os.cpu_count() or 1) // 2),
    n_gpu_layers=-1 if device.startswith('cuda') else 0,
    verbose=False,
)

result = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.95,
    stop=["</s>"]
)

output_text = result["choices"][0]["text"].strip()

RESULT = {"output_text": output_text}
