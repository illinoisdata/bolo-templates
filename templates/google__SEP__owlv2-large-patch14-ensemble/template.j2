{% set task = task | default("zero-shot-object-detection") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image2.jpeg") %}
{% set candidate_labels = candidate_labels | default(["fox", "bear", "seagull", "cat"]) %}

{% set repo_id = repo_id | default("google/owlv2-large-patch14-ensemble") %}
{% set device = device | default("cuda:0") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
image_path = {{ image_path | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from PIL import Image
from transformers import pipeline

image = Image.open(image_path).convert("RGB")

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(image=image, candidate_labels=candidate_labels)
