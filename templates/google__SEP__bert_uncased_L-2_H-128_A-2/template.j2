{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/bert_uncased_L-2_H-128_A-2") %}
{% set text_inputs = text_inputs | default(["The quick brown fox jumps over the lazy dog.", "Transformers power modern NLP."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs }}

import os
from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(text_inputs, padding=True, truncation=True, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state.cpu()
RESULT = {"last_hidden_state": last_hidden_state}
