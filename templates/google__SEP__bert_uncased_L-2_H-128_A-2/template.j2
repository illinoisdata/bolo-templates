{% set repo_id = repo_id | default("google/bert_uncased_L-2_H-128_A-2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
repo_dir = vocab_path.rsplit('/', 1)[0]

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModel.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state,
    "pooler_output": outputs.pooler_output,
}
