{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sshleifer/distilbart-xsum-1-1") %}
{% set input_text = input_text | default("The council approved a new climate resilience fund to help coastal communities rebuild after the storm surge that eroded miles of shoreline.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""

from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=1024,
)
encoded = {k: v.to(device) for k, v in encoded.items()}

generated_ids = model.generate(
    **encoded,
    max_length=128,
    min_length=30,
    num_beams=4,
    early_stopping=True,
)
generated_ids = generated_ids.cpu()

summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
