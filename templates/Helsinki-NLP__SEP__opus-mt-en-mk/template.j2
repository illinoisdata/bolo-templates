{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-mk") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from the repo snapshot using the downloaded file locations.
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=False,
    tokenizer_file=None,
    vocab_file=vocab_path,
    source_spm=source_spm_path,
    target_spm=target_spm_path,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=128)

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
