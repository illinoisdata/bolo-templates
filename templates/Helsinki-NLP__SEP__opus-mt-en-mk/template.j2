{% set repo_id = "Helsinki-NLP/opus-mt-en-mk" %}
{% set device = "cuda:0" %}
{% set input_text = "Hello, world! Translate this from English to Macedonian." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-mk" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    serialized_translation = (
        translations if isinstance(translations, str) else "\n".join(translations)
    )
    with (output_path / "translation.txt").open("w", encoding="utf-8") as output_file:
        output_file.write(serialized_translation)