{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-mk") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Hello, world! Translate this from English to Macedonian.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations}
