{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
import os
from pathlib import Path

import torch
import timm
from PIL import Image
from huggingface_hub import hf_hub_download
from timm.data import create_transform
from timm.data.constants import IMAGENET_DEFAULT_MEAN, IMAGENET_DEFAULT_STD

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    cfg = json.load(f)

labels = cfg["labels"]
input_size = tuple(cfg.get("input_size", [3, 224, 224]))
mean = tuple(cfg.get("mean", IMAGENET_DEFAULT_MEAN))
std = tuple(cfg.get("std", IMAGENET_DEFAULT_STD))
crop_pct = cfg.get("crop_pct", 0.95)
interpolation = cfg.get("interpolation", "bicubic")

if image_path.startswith("http://") or image_path.startswith("https://"):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = timm.create_model(cfg["architecture"], num_classes=cfg["num_classes"], pretrained=False)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.eval()
model.to(device)

transform = create_transform(
    input_size=input_size,
    is_training=False,
    mean=mean,
    std=std,
    crop_pct=crop_pct,
    interpolation=interpolation,
)

x = transform(image).unsqueeze(0).to(device)
with torch.no_grad():
    logits = model(x)
    probs = torch.softmax(logits, dim=-1)[0]
    top_prob, top_idx = torch.max(probs, dim=-1)

pred_label = labels[top_idx.item()]
RESULT = {"label": pred_label, "score": top_prob.item(), "probabilities": probs.detach().cpu().tolist()}
