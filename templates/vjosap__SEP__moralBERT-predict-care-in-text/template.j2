{% set repo_id = repo_id | default("vjosap/moralBERT-predict-care-in-text") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The caregiver showed compassion and concern for the patient throughout the conversation.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import json
import os
import torch
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from transformers import AutoTokenizer, BertConfig, BertForSequenceClassification

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

with open(config_path, "r") as f:
    raw_config = json.load(f)

local_dir = os.path.dirname(tokenizer_path)
tokenizer = AutoTokenizer.from_pretrained(local_dir, local_files_only=True)

bert_config = BertConfig(
    vocab_size=tokenizer.vocab_size,
    hidden_size=768,
    num_hidden_layers=12,
    num_attention_heads=12,
    intermediate_size=3072,
    num_labels=3,
    id2label={"0": "LABEL_0", "1": "LABEL_1", "2": "LABEL_2"},
    label2id={"LABEL_0": 0, "LABEL_1": 1, "LABEL_2": 2},
)
model = BertForSequenceClassification(bert_config)
state_dict = load_file(model_path)
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)
    pred_id = int(torch.argmax(probs, dim=-1).item())

RESULT = {"logits": logits.detach().cpu().tolist(), "probabilities": probs.detach().cpu().tolist(), "predicted_class": pred_id, "moral_label": int(raw_config.get("moral_label", 2))}
