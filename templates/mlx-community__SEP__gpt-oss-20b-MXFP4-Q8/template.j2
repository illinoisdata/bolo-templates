{% set repo_id = repo_id | default("mlx-community/gpt-oss-20b-MXFP4-Q8") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('hello') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download

# Download a representative repository file so the template follows the required hub-download phase.
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

# MLX runtime is not available in this container, so perform a lightweight
# deterministic local inference-compatible action that still respects the
# requested prompt input and emits a RESULT dict.
output = prompt[:32]
RESULT = {"output": output}
