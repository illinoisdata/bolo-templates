{% set repo_id = repo_id | default("microsoft/udop-large") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-text-to-text") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/doc.jpeg") %}
{% set input_prompt = input_prompt | default("Question answering. What is the date on the form?") %}

task = "{{ task }}"
input_image = "{{ input_image }}"
input_prompt = "{{ input_prompt }}"
repo_id = "{{ repo_id }}"
device = "{{ device }}"

from transformers import pipeline

# Initialize the pipeline for image-text-to-text
pipe = pipeline(task=task, model=repo_id, device=device)

# Perform inference
RESULT = pipe(input_image, text=input_prompt)
