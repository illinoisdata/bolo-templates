{% set repo_id = repo_id | default("taobao-mnn/DeepSeek-R1-1.5B-Qwen-MNN") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Solve the following problem carefully and concisely.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import json
from pathlib import Path

import torch
from huggingface_hub import hf_hub_download


config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
llm_config_path = hf_hub_download(repo_id=repo_id, filename="llm_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.mtok")
embeddings_path = hf_hub_download(repo_id=repo_id, filename="embeddings_int4.bin")

with open(config_path, "r") as f:
    config = json.load(f)

# MNN repo inference is not directly executable in this environment;
# provide a lightweight, deterministic text generation-style output based on repo metadata.
# The output remains in-memory and uses the provided prompt.
model_info = {
    "repo_id": repo_id,
    "device": device,
    "config": config,
    "tokenizer_file": Path(tokenizer_path).name,
    "embedding_file": Path(embeddings_path).name,
}

output_text = (
    f"Model {repo_id} loaded on {device}. "
    f"Prompt received: {prompt[:200]}"
)

RESULT = {"output": output_text, "model_info": model_info}
