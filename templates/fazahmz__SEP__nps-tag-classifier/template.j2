{% set repo_id = repo_id | default("fazahmz/nps-tag-classifier") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('This is a sample text for classification.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import BertTokenizer, BertForSequenceClassification, AutoConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = AutoConfig.from_pretrained(config_path)
state_dict = torch.load(weights_path, map_location="cpu")
model = BertForSequenceClassification(config)
state_dict.pop("bert.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=False)
tokenizer = BertTokenizer(vocab_file=vocab_path)

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
model = model.to(device)
model.eval()
with torch.no_grad():
    logits = model(**inputs).logits
probs = torch.sigmoid(logits).squeeze(0).tolist()
labels = model.config.id2label
output = [{"label": labels[i] if i in labels else labels[str(i)], "score": float(probs[i])} for i in range(len(probs))]

RESULT = {"predictions": output}
