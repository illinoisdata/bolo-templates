{% set repo_id = repo_id | default("Systran/faster-distil-whisper-small.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(5) %}
{% set best_of = best_of | default(5) %}
{% set temperature = temperature | default(0.0) %}
{% set condition_on_previous_text = condition_on_previous_text | default(false) %}
{% set vad_filter = vad_filter | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
best_of = {{ best_of }}
temperature = {{ temperature }}
condition_on_previous_text = {{ condition_on_previous_text }}
vad_filter = {{ vad_filter }}

import os
import requests
from faster_whisper import WhisperModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.json")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    response = requests.get(audio_path, timeout=30)
    import tempfile
    fd, local_audio_path = tempfile.mkstemp(suffix=os.path.splitext(audio_path)[1] or ".wav")
    os.close(fd)
    with open(local_audio_path, "wb") as f:
        f.write(response.content)
    audio_path = local_audio_path

model = WhisperModel(
    os.path.dirname(model_path),
    device="cpu",
    compute_type="int8",
)

segments, info = model.transcribe(
    audio_path,
    task=task,
    language=language,
    beam_size=beam_size,
    best_of=best_of,
    temperature=temperature,
    condition_on_previous_text=condition_on_previous_text,
    vad_filter=vad_filter,
)

output_text = "".join(segment.text for segment in segments).strip()
RESULT = {
    "text": output_text,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
