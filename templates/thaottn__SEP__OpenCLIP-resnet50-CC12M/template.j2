{% set repo_id = repo_id | default("thaottn/OpenCLIP-resnet50-CC12M") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('a photo of a cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import json
import requests
import torch
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from open_clip import create_model_and_transforms, get_tokenizer

config_path = hf_hub_download(repo_id=repo_id, filename='open_clip_config.json')
weights_path = hf_hub_download(repo_id=repo_id, filename='open_clip_pytorch_model.bin')
with open(config_path, 'r') as f:
    cfg = json.load(f)
model_cfg = cfg['model_cfg']
preprocess_cfg = cfg['preprocess_cfg']
model, _, preprocess = create_model_and_transforms(
    'RN50',
    pretrained=None,
    precision='fp32',
    device=device,
    jit=False,
    force_quick_gelu=False,
)
state_dict = torch.load(weights_path, map_location='cpu')
model.load_state_dict(state_dict)
model.to(device)
model.eval()
tokenizer = get_tokenizer('RN50')

if isinstance(image_path, str) and image_path.startswith(('http://', 'https://')):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer([text_prompt]).to(device)
with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logit_scale = model.logit_scale.exp()
    logits_per_image = logit_scale * image_features @ text_features.T
    probabilities = logits_per_image.softmax(dim=-1)

RESULT = {
    'logits_per_image': logits_per_image.detach().cpu().tolist(),
    'probabilities': probabilities.detach().cpu().tolist(),
    'text_prompt': text_prompt,
}
