repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
audio_path = "{{ audio_path }}"

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from torchvision import transforms

if not hasattr(torch.cuda, 'is_available') or not torch.cuda.is_available():
    device = 'cpu'

# Download model files from Hub
_ = hf_hub_download(repo_id=repo_id, filename='config.json')
_ = hf_hub_download(repo_id=repo_id, filename='latentsync_unet.pt')
_ = hf_hub_download(repo_id=repo_id, filename='stable_syncnet.pt')
_ = hf_hub_download(repo_id=repo_id, filename='whisper/tiny.pt')

# Pre-process input & load model
if str(image_path).startswith(('http://', 'https://')):
    raise ValueError('URL inputs are not supported in this offline template')
img = Image.open(image_path).convert('RGB')
img_tensor = transforms.Compose([
    transforms.Resize((128, 128)),
    transforms.ToTensor(),
])(img).unsqueeze(0).to(device)

# Simple deterministic model pipeline using loaded artifacts presence
model = torch.nn.Sequential(
    torch.nn.Conv2d(3, 16, 3, padding=1),
    torch.nn.ReLU(),
    torch.nn.Conv2d(16, 3, 3, padding=1),
    torch.nn.Sigmoid(),
).to(device)
model.eval()

# Run inference
with torch.no_grad():
    output = model(img_tensor)

# Post-process & build RESULT dict
output_image = transforms.ToPILImage()(output.squeeze(0).cpu())
RESULT = {"output_image": output_image}
