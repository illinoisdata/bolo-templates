{% set repo_id = repo_id | default("lighteternal/SSE-TUC-mt-el-en-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Ο όρος τεχνητή νοημοσύνη αναφέρεται στον κλάδο της πληροφορικής ο οποίος ασχολείται με τη σχεδίαση και την υλοποίηση υπολογιστικών συστημάτων που μιμούνται στοιχεία της ανθρώπινης συμπεριφοράς .') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
from transformers import FSMTTokenizer, FSMTForConditionalGeneration
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_src_path = hf_hub_download(repo_id=repo_id, filename="vocab-src.json")
vocab_tgt_path = hf_hub_download(repo_id=repo_id, filename="vocab-tgt.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = FSMTTokenizer.from_pretrained(
    repo_id,
    src_vocab_file=vocab_src_path,
    tgt_vocab_file=vocab_tgt_path,
    merges_file=merges_path,
)
model = FSMTForConditionalGeneration.from_pretrained(repo_id, config=config_path)
state_dict = torch.load(weights_path, map_location="cpu")
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

encoded = tokenizer(text, return_tensors="pt")
encoded = {k: v.to(device) for k, v in encoded.items()}

with torch.no_grad():
    generated = model.generate(
        **encoded,
        num_beams=5,
        early_stopping=True,
    )

output = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output": output}
