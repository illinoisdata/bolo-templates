{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("lighteternal/SSE-TUC-mt-el-en-cased") %}
{% set prompt_text = prompt_text | default("Ο όρος τεχνητή νοημοσύνη αναφέρεται στον κλάδο της πληροφορικής ο οποίος ασχολείται με τη σχεδίαση και την υλοποίηση υπολογιστικών συστημάτων που μιμούνται στοιχεία της ανθρώπινης συμπεριφοράς .") %}
{% set max_length = max_length | default(200) %}
{% set num_beams = num_beams | default(5) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt_text = """{{ prompt_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
early_stopping = {{ early_stopping }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input
inputs = tokenizer(
    prompt_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.inference_mode():
    generated_tokens = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
        num_return_sequences=num_return_sequences,
        early_stopping=early_stopping,
    )

# Post-process & build RESULT dict
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}
