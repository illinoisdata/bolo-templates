{% set repo_id = repo_id | default("3una/finetuned-AffectNet") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set base_model = base_model | default("microsoft/beit-base-patch16-224-pt22k-ft22k") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
task = "{{ task }}"
base_model = "{{ base_model }}"
device = "{{ device }}"
input_image = "{{ input_image }}"

from transformers import pipeline, AutoImageProcessor

# Load processor and create pipeline
feature_extractor = AutoImageProcessor.from_pretrained(base_model)
pipe = pipeline(task=task, model=repo_id, image_processor=feature_extractor, device=device)

# Run inference
RESULT = pipe(input_image)
