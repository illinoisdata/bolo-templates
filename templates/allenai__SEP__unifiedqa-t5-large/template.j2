{% set repo_id = repo_id | default("allenai/unifiedqa-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('') %}
{% set max_new_tokens = max_new_tokens | default(16) %}
{% set num_beams = num_beams | default(1) %}
{% set do_sample = do_sample | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="spiece.model")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)

if context:
    prompt = f"question: {question} context: {context}"
else:
    prompt = f"question: {question}"

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        do_sample=do_sample,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
