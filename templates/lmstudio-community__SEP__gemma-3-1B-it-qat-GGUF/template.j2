{% set repo_id = repo_id | default("lmstudio-community/gemma-3-1B-it-qat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("gemma-3-1B-it-QAT-Q4_0.gguf") %}
{% set prompt = prompt | default("Explain in one short paragraph what quantization-aware training is.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=weights_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=0 if str(device).startswith("cpu") else -1,
    verbose=False,
)

result = llm(
    prompt,
    max_tokens=128,
    temperature=0.2,
    top_p=0.95,
    stop=["</s>", "<end_of_turn>"],
)

output_text = result["choices"][0]["text"].strip()

RESULT = {"text": output_text}
