repo_id = "{{ repo_id }}"
device = "{{ device }}"
video_path = "{{ video_path }}"
prompt_text = "{{ prompt_text }}"

import os
import numpy as np
import torch
import av
from huggingface_hub import hf_hub_download
from transformers import LlavaNextVideoProcessor, LlavaNextVideoForConditionalGeneration

model_file = hf_hub_download(repo_id=repo_id, filename="model-00001-of-00003.safetensors")
processor_config_file = hf_hub_download(repo_id=repo_id, filename="processor_config.json")

def read_video_pyav(container, indices):
    frames = []
    container.seek(0)
    start_index = int(indices[0])
    end_index = int(indices[-1])
    for i, frame in enumerate(container.decode(video=0)):
        if i > end_index:
            break
        if i >= start_index and i in indices:
            frames.append(frame)
    return np.stack([x.to_ndarray(format="rgb24") for x in frames])

processor = LlavaNextVideoProcessor.from_pretrained(repo_id)
model = LlavaNextVideoForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float16,
    low_cpu_mem_usage=True,
).to(device)

if video_path.startswith("http://") or video_path.startswith("https://"):
    import tempfile, requests
    with tempfile.NamedTemporaryFile(suffix=os.path.splitext(video_path)[1]) as f:
        f.write(requests.get(video_path, timeout=30).content)
        f.flush()
        local_video_path = f.name
        container = av.open(local_video_path)
        total_frames = container.streams.video[0].frames
        if total_frames and total_frames > 0:
            indices = np.linspace(0, total_frames - 1, num=8, dtype=int)
        else:
            indices = np.arange(0, 8)
        clip = read_video_pyav(container, indices)
else:
    container = av.open(video_path)
    total_frames = container.streams.video[0].frames
    if total_frames and total_frames > 0:
        indices = np.linspace(0, total_frames - 1, num=8, dtype=int)
    else:
        indices = np.arange(0, 8)
    clip = read_video_pyav(container, indices)

conversation = [
    {
        "role": "user",
        "content": [
            {"type": "text", "text": prompt_text},
            {"type": "video"},
        ],
    },
]
prompt = processor.apply_chat_template(conversation, add_generation_prompt=True)
inputs = processor(text=prompt, videos=clip, padding=True, return_tensors="pt").to(device)
output_ids = model.generate(**inputs, max_new_tokens=64, do_sample=False)
output_text = processor.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
