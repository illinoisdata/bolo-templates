{% set repo_id = repo_id | default("allenai/longformer-large-4096-finetuned-triviaqa") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('France is a country in Western Europe. Its capital and most populous city is Paris, which is known for the Eiffel Tower.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")

model = AutoModelForQuestionAnswering.from_pretrained(repo_id, trust_remote_code=False)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(outputs.start_logits.argmax(dim=-1).item())
end_idx = int(outputs.end_logits.argmax(dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx : end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer}
