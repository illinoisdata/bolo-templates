{% set use_fast_processor = use_fast_processor | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_new_tokens = {{ max_new_tokens }}
use_fast_processor = {{ use_fast_processor }}

import os
from PIL import Image
import requests
import torch
from transformers import VisionEncoderDecoderModel, AutoImageProcessor, AutoTokenizer, BertJapaneseTokenizer
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
processor_config_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = AutoImageProcessor.from_pretrained(os.path.dirname(processor_config_file))
try:
    tokenizer = BertJapaneseTokenizer.from_pretrained(os.path.dirname(tokenizer_config_file))
except Exception:
    tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_config_file), use_fast=False)

model = VisionEncoderDecoderModel.from_pretrained(os.path.dirname(config_file), local_files_only=True)
model.load_state_dict(torch.load(weights_file, map_location="cpu"), strict=False)
model.to(device)
model.eval()

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(device)
with torch.no_grad():
    generated_ids = model.generate(pixel_values, max_new_tokens=max_new_tokens, num_beams=4)
text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": text}
