{% set device = "cuda:0" %}
{% set repo_id = "Salesforce/bart-large-xsum-samsum" %}
{% set input_text = "Salesforce research summary: The Salesforce paper release includes a new abstractive summarization training corpus and method described for research purposes." %}
{% set max_length = 128 %}
{% set num_beams = 6 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True).to(device)
generated_ids = model.generate(
    **tokenized_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)
summary_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary_text}
