{% set input_text = "Salesforce research summary: The Salesforce paper release includes a new abstractive summarization training corpus and method described for research purposes." %}
{% set max_length = 128 %}
{% set num_beams = 6 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Salesforce__SEP__bart-large-xsum-samsum" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True).to(device)
generated_ids = model.generate(
    **tokenized_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)
summary_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")