{% set repo_id = repo_id | default("rsvp-ai/bertserini-bert-base-squad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('France is a country in Western Europe. Its capital city is Paris, which is known for the Eiffel Tower.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering, BertConfig
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
config = BertConfig.from_json_file(config_path)
model = AutoModelForQuestionAnswering.from_config(config)
state_dict = torch.load(model_path, map_location="cpu")
state_dict.pop("bert.pooler.dense.weight", None)
state_dict.pop("bert.pooler.dense.bias", None)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx : end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer}
