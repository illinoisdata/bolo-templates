{% set repo_id = repo_id | default("sjrhuschlee/flan-t5-large-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Where do I live?') %}
{% set context = context | default('My name is Sarah and I live in London.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import os
import sys
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer
from transformers.models.t5.modeling_t5 import T5Stack

modeling_file = hf_hub_download(repo_id=repo_id, filename="modeling_t5qa.py")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

repo_dir = os.path.dirname(modeling_file)
sys.path.insert(0, repo_dir)
from modeling_t5qa import T5ForQuestionAnswering

if not hasattr(T5Stack, "_patched_for_lora_qa"):
    old_init = T5Stack.__init__
    def new_init(self, config, embed_tokens=None):
        return old_init(self, config)
    T5Stack.__init__ = new_init
    T5Stack._patched_for_lora_qa = True

model = T5ForQuestionAnswering.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
question = f"{tokenizer.cls_token}{question}"
inputs = tokenizer(question, context, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

all_tokens = tokenizer.convert_ids_to_tokens(inputs["input_ids"][0].tolist())
answer_tokens = all_tokens[start_idx:end_idx + 1]
answer = tokenizer.decode(tokenizer.convert_tokens_to_ids(answer_tokens), skip_special_tokens=True)

RESULT = {"answer": answer}
