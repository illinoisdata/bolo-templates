{% set repo_id = repo_id | default("lmstudio-community/LFM2-1.2B-MLX-bf16") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") -%}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") -%}
{% set max_new_tokens = max_new_tokens | default(128) -%}
{% set model_kwargs = model_kwargs | default({"ignore_mismatched_sizes": True}) -%}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}
model_kwargs = {{ model_kwargs }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=repo_id,
    device=device,
    model_kwargs=model_kwargs,
)

prompt = input_prompt

RESULT = pipe(prompt, max_new_tokens=max_new_tokens)
RESULT = {"generated_text": RESULT}
