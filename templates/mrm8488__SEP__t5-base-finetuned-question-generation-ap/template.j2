{% set repo_id = repo_id | default("mrm8488/t5-base-finetuned-question-generation-ap") %}
{% set device = device | default("cuda:0") %}
{% set answer = answer | default('Manuel') %}
{% set context = context | default('Manuel has created RuPERTa-base with the support of HF-Transformers and Google') %}
{% set max_length = max_length | default(64) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
answer = "{{ answer }}"
context = "{{ context }}"
max_length = {{ max_length }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

local_files_dir = os.path.dirname(config_path)

tokenizer = AutoTokenizer.from_pretrained(local_files_dir, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(local_files_dir, torch_dtype=torch.float32)
model = model.to(device)
model.eval()

input_text = f"answer: {answer}  context: {context} </s>"
features = tokenizer([input_text], return_tensors="pt")
features = {k: v.to(device) for k, v in features.items()}

with torch.no_grad():
    output_ids = model.generate(
        input_ids=features["input_ids"],
        attention_mask=features["attention_mask"],
        max_length=max_length,
    )

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"question": output_text}
