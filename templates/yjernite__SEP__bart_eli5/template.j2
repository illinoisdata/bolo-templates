{% set repo_id = repo_id | default("yjernite/bart_eli5") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("Why is the sky blue?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import pathlib

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))

inputs = tokenizer(question, return_tensors="pt").to(torch.device(device))
outputs = model.generate(**inputs)
answer = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"answer": answer}
