{% set repo_id = "yjernite/bart_eli5" %}
{% set device = "cuda:0" %}
{% set question = "Why is the sky blue?" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import pathlib

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))

inputs = tokenizer(question, return_tensors="pt").to(torch.device(device))
outputs = model.generate(**inputs)
answer = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"answer": answer}

if __name__ == "__main__":
    out_dir = pathlib.Path("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/yjernite__SEP__bart_eli5")
    out_dir.mkdir(parents=True, exist_ok=True)
    with open(out_dir / "answer.txt", "w") as f:
        f.write(RESULT["answer"])