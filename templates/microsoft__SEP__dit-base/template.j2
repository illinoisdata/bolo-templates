{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set mask_probability = 0.15 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/microsoft__SEP__dit-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
mask_probability = {{ mask_probability }}
output_dir = "{{ output_dir }}"

import os
from io import BytesIO

from PIL import Image
import numpy as np
import requests
import torch
from transformers import AutoImageProcessor, BeitForMaskedImageModeling

processor = AutoImageProcessor.from_pretrained(repo_id)
model = BeitForMaskedImageModeling.from_pretrained(repo_id).to(device)
model.eval()

def _load_image(path: str) -> Image.Image:
    if path.startswith("http://") or path.startswith("https://"):
        response = requests.get(path, timeout=30)
        response.raise_for_status()
        return Image.open(BytesIO(response.content)).convert("RGB")
    return Image.open(path).convert("RGB")

image = _load_image(image_path)

pixel_values = processor(images=image, return_tensors="pt").pixel_values
num_patches = (int(model.config.image_size) // int(model.config.patch_size)) ** 2
bool_masked_pos = torch.rand(1, num_patches, device=device) < mask_probability

with torch.no_grad():
    outputs = model(pixel_values.to(device), bool_masked_pos=bool_masked_pos)
    logits = outputs.logits

logits_cpu = logits.cpu()
predicted_token_ids = logits_cpu.argmax(dim=-1)
mask_positions = bool_masked_pos.cpu()

RESULT = {
    "logits": logits_cpu,
    "predicted_token_ids": predicted_token_ids,
    "mask_positions": mask_positions,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    torch.save(RESULT["logits"], os.path.join(output_dir, "logits.pt"))
    np.savetxt(
        os.path.join(output_dir, "predicted_token_ids.txt"),
        RESULT["predicted_token_ids"].numpy(),
        fmt="%d",
    )
    np.savetxt(
        os.path.join(output_dir, "mask_positions.txt"),
        RESULT["mask_positions"].numpy().astype(int),
        fmt="%d",
    )