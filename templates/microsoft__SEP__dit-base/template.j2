{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("microsoft/dit-base") %}
{% set num_masked_patches = num_masked_patches | default(10) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
num_masked_patches = {{ num_masked_patches }}

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import BeitForMaskedImageModeling, BeitImageProcessor

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

processor = BeitImageProcessor.from_pretrained(os.path.dirname(preprocessor_config_path))
model = BeitForMaskedImageModeling.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

if image_path.startswith("http://") or image_path.startswith("https://"):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(device)
num_patches = (model.config.image_size // model.config.patch_size) ** 2
bool_masked_pos = torch.zeros((1, num_patches), dtype=torch.bool, device=device)
bool_masked_pos[:, :num_masked_patches] = True

with torch.no_grad():
    outputs = model(pixel_values=pixel_values, bool_masked_pos=bool_masked_pos)

RESULT = {
    "loss": outputs.loss.detach().cpu().item() if outputs.loss is not None else None,
    "logits_shape": list(outputs.logits.shape),
    "logits": outputs.logits.detach().cpu(),
}
