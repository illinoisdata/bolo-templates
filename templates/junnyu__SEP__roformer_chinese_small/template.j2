{% set repo_id = repo_id | default("junnyu/roformer_chinese_small") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("fill-mask") %}
{% set masked_prompt = masked_prompt | default("今天[MASK]很好，我[MASK]去公园玩。") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
masked_prompt = "{{ masked_prompt }}"

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
RESULT = pipe(text)
