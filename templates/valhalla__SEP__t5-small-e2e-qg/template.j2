{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("valhalla/t5-small-e2e-qg") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device=torch.device(device))
model.eval()
encoded_inputs = tokenizer(input_text, return_tensors="pt")
prepared_inputs = {key: value.to(device=torch.device(device)) for key, value in encoded_inputs.items()}
generated_ids = model.generate(**prepared_inputs, num_beams=num_beams, max_new_tokens=max_new_tokens)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": generated_text}
