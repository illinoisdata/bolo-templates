{% set repo_id = "cahya/t5-base-indonesian-summarization-cased" %}
{% set device = "cuda:0" %}
{% set article_text = "Presiden Indonesia menyampaikan perkembangan penting dalam konferensi global terkait perubahan iklim." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/cahya__SEP__t5-base-indonesian-summarization-cased" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = """{{ article_text }}"""
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

inputs = tokenizer(
    article_text,
    return_tensors="pt",
    truncation=True,
    max_length=1024,
)
input_ids = inputs["input_ids"].to(torch_device)
attention_mask = inputs["attention_mask"].to(torch_device)

summary_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    min_length=20,
    max_length=80,
    num_beams=10,
    repetition_penalty=2.5,
    length_penalty=1.0,
    early_stopping=True,
    no_repeat_ngram_size=2,
    use_cache=True,
    do_sample=True,
    temperature=0.8,
    top_k=50,
    top_p=0.95,
)

summary_text = tokenizer.decode(
    summary_ids[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"summary_text": summary_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    summary_path = os.path.join(output_dir, "summary.txt")
    with open(summary_path, "w", encoding="utf-8") as writer:
        writer.write(summary_text)