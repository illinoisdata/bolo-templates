{% set repo_id = repo_id | default("cahya/t5-base-indonesian-summarization-cased") %}
{% set device = device | default("cuda:0") %}
{% set article_to_summarize = article_to_summarize | default('Presiden mengatakan pemerintah akan mempercepat program vaksinasi untuk menekan penyebaran penyakit. Selain itu, pemerintah juga menyiapkan bantuan sosial bagi masyarakat yang terdampak, serta mendorong pemulihan ekonomi melalui dukungan bagi usaha kecil dan menengah.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_to_summarize = "{{ article_to_summarize }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = __import__('os').path.dirname(weights_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(article_to_summarize, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    summary_ids = model.generate(
        **inputs,
        min_length=20,
        max_length=80,
        num_beams=10,
        repetition_penalty=2.5,
        length_penalty=1.0,
        early_stopping=True,
        no_repeat_ngram_size=2,
        use_cache=True,
        do_sample=True,
        temperature=0.8,
        top_k=50,
        top_p=0.95,
    )

summary_text = tokenizer.decode(summary_ids[0], skip_special_tokens=True)

RESULT = {"summary_text": summary_text}
