repo_id = "{{ repo_id }}"
device = "{{ device }}"
image1 = "{{ image1 }}"
image2 = "{{ image2 }}"
export_format = "{{ export_format }}"

import os
from pathlib import Path
from PIL import Image
import numpy as np
import torch
from huggingface_hub import hf_hub_download


def load_image(path_or_url):
    if isinstance(path_or_url, str) and path_or_url.startswith(("http://", "https://")):
        from io import BytesIO
        import requests
        return Image.open(BytesIO(requests.get(path_or_url, timeout=30).content)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")


weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

images = [load_image(image1), load_image(image2)]
RESULT = {
    "images": [np.array(im) for im in images],
    "weights_path": str(weights_path),
    "device": device,
}
