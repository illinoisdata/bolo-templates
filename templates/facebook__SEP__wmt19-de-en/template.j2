{% set repo_id = repo_id | default("facebook/wmt19-de-en") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Maschinelles Lernen ist großartig, oder?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs)

translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation}
