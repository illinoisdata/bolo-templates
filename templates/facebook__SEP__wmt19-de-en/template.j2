{% set repo_id = repo_id | default("facebook/wmt19-de-en") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Maschinelles Lernen ist großartig, oder?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import FSMTForConditionalGeneration, FSMTTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
if not model_path:
    model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = FSMTTokenizer.from_pretrained(repo_id)
model = FSMTForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=5, max_new_tokens=64)
translation = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"translation": translation}
