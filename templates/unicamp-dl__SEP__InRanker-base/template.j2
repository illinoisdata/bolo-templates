{% set repo_id = repo_id | default("unicamp-dl/InRanker-base") %}
{% set device = device | default("cuda:0") %}
{% set query = query | default('What is the best way to learn deep learning?') %}
{% set docs = docs | default(['The capital of France is Paris', 'Learn deep learning with InRanker and transformers']) %}
{% set model_max_length = model_max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"
docs = {{ docs }}
model_max_length = {{ model_max_length }}

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model = T5ForConditionalGeneration.from_pretrained(repo_id, local_files_only=True)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, local_files_only=True)
model.to(device)
model.eval()

scores = []
for doc in docs:
    enc = tokenizer(query, doc, truncation=True, max_length=model_max_length, return_tensors="pt")
    enc = {k: v.to(device) for k, v in enc.items()}
    decoder_input_ids = torch.tensor([[model.config.decoder_start_token_id]], device=device)
    with torch.no_grad():
        outputs = model(**enc, decoder_input_ids=decoder_input_ids, return_dict=True)
        score = outputs.logits[0, 0, 0].float().detach().cpu().item()
    scores.append(score)

sorted_docs = [doc for _, doc in sorted(zip(scores, docs), key=lambda x: x[0], reverse=True)]
RESULT = {"scores": scores, "sorted_docs": sorted_docs}
