{% set repo_id = "google/mt5-large" %}
{% set device = "cuda:0" %}
{% set text_prompt = "translate English to French: The house is wonderful." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__mt5-large" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)

encoded_inputs = tokenizer(text_prompt, return_tensors="pt")
input_tensors = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(**input_tensors)
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    text_path = output_path / "generated_text.txt"
    text_path.write_text(generated_text, encoding="utf-8")