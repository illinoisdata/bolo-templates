{% set device = "cuda:0" %}
{% set repo_id = "patrickvonplaten/led-large-16384-pubmed" %}
{% set text_input = "Anxiety affects quality of life in those living with Parkinson's disease more so than overall cognitive status, motor deficits, apathy, and depression. Recent research suggests anxiety rather than depression is the most prominent mood disorder in PD patients. This model is fine-tuned on PubMed abstracts to provide concise summaries for long scientific texts." %}
{% set num_beams = 4 %}
{% set min_length = 100 %}
{% set max_length = 256 %}
{% set early_stopping = true %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
num_beams = {{ num_beams }}
min_length = {{ min_length }}
max_length = {{ max_length }}
early_stopping = {{ early_stopping }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text_input,
    truncation=True,
    max_length=16384,
    return_tensors="pt",
)

input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)
global_attention_mask = torch.zeros_like(input_ids)
global_attention_mask[:, 0] = 1

generated_sequences = model.generate(
    input_ids,
    attention_mask=attention_mask,
    global_attention_mask=global_attention_mask,
    num_beams=num_beams,
    max_length=max_length,
    min_length=min_length,
    early_stopping=early_stopping,
)

decoded_sequences = tokenizer.batch_decode(
    generated_sequences,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

summary_text = decoded_sequences[0] if decoded_sequences else ""
RESULT = {"summary": summary_text}
