{% set repo_id = 'ai-forever/sage-fredt5-distilled-95m' %}
{% set device = 'cuda:0' %}
{% set input_text = 'И не чсно прохожим в этот день непогожйи почему я веселый такйо' %}
{% set length_multiplier = 1.5 %}
{% set output_dir = '/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/ai-forever__SEP__sage-fredt5-distilled-95m' %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
length_multiplier = {{ length_multiplier }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, max_length=None, padding="longest", truncation=False, return_tensors="pt")
inputs = inputs.to(device)

outputs = model.generate(**inputs, max_length=int(inputs["input_ids"].size(1) * length_multiplier))

generated_texts = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_texts.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        for text in RESULT["generated_texts"]:
            f.write(text + "\n")