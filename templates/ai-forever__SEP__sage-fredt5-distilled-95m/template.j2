{% set repo_id = repo_id | default("ai-forever/sage-fredt5-distilled-95m") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('И не чсно прохожим в этот день непогожйи почему я веселый такйо') %}
{% set length_multiplier = length_multiplier | default(1.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
length_multiplier = {{ length_multiplier }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, max_length=None, padding="longest", truncation=False, return_tensors="pt")
inputs = inputs.to(device)

outputs = model.generate(**inputs, max_length=int(inputs["input_ids"].size(1) * length_multiplier))

generated_texts = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
