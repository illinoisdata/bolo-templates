{% set repo_id = repo_id | default("dropbox-dash/faster-whisper-large-v3-turbo") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}
{% set beam_size = beam_size | default(5) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"
beam_size = {{ beam_size }}

from urllib.parse import urlparse

import soundfile as sf
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.json")

if urlparse(audio_path).scheme in ("http", "https"):
    raise ValueError("URL inputs are not supported for audio in this inference script")

audio, sample_rate = sf.read(audio_path)
if audio.ndim > 1:
    audio = audio.mean(axis=1)

model = WhisperModel(repo_id, device="cpu", compute_type="int8", download_root="/workspace")
segments, info = model.transcribe(
    audio,
    language=language,
    task=task,
    beam_size=beam_size,
)
transcript = "".join(segment.text for segment in segments).strip()

RESULT = {
    "text": transcript,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
