{% set repo_id = repo_id | default("InvokeAI/ip_adapter_sd_image_encoder") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import requests
import torch
from safetensors.torch import load_file
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import CLIPImageProcessor, CLIPVisionModelWithProjection

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
repo_dir = os.path.dirname(config_path)

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = CLIPVisionModelWithProjection.from_pretrained(repo_dir, torch_dtype=torch.float16)
state_dict = load_file(weights_path)
state_dict.pop("vision_model.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()
inputs = CLIPImageProcessor(image_size=224, crop_size={"height": 224, "width": 224})(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

RESULT = {"image_embeds": outputs.image_embeds, "last_hidden_state": outputs.last_hidden_state}
