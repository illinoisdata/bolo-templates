{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ine-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = MarianTokenizer(vocab=vocab_path, source_spm=source_spm_path, target_spm=target_spm_path)
model = MarianMTModel.from_pretrained(repo_id)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
output = decoded[0]

RESULT = {"translation": output}
