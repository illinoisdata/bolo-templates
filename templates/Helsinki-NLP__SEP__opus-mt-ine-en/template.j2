{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-ine-en" %}
{% set text = "This is a short sentence to translate into English." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

# Load tokenizer/processor & model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

# Pre-process input
encoded_inputs = tokenizer(text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

# Run inference
generated_ids = model.generate(**encoded_inputs, max_length=256)

# Post-process & build RESULT dict
translation_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"translation": translation_text}
