{% set repo_id = repo_id | default("Kyle1668/ag-news-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('summarize: The stock market rallied today as major tech companies reported strong quarterly earnings, boosting investor confidence and lifting the S&P 500 to a record high.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_file = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=64,
        num_beams=4,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
