{% set repo_id = repo_id | default("jxm/gtr__nq__32__correct") %}
{% set base_model = base_model | default("t5-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("This is a smple text with som errrors.") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
base_model = "{{ base_model }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}

from transformers import AutoConfig, AutoTokenizer, AutoModelForSeq2SeqLM
import torch

config = AutoConfig.from_pretrained(base_model)
tokenizer = AutoTokenizer.from_pretrained(base_model)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, config=config).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
corrected_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"corrected_text": corrected_text}
