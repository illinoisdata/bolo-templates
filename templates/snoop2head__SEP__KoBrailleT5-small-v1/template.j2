{% set repo_id = repo_id | default("snoop2head/KoBrailleT5-small-v1") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('테스트') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.load_state_dict(torch.load(weights_path, map_location="cpu"))
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
inputs = tokenizer(text_input, return_tensors="pt")
if inputs["input_ids"].shape[1] == 0:
    inputs = tokenizer("테스트", return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=64)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
