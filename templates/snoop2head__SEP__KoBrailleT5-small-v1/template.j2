{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("snoop2head/KoBrailleT5-small-v1") %}
{% set input_text = input_text | default("Please translate this sample sentence into Braille.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)

decoded_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"generated_text": decoded_text}
