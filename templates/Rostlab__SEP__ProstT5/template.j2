{% set repo_id = repo_id | default("Rostlab/ProstT5") %}
{% set device = device | default("cuda:0") %}
{% set input_sequence = input_sequence | default('PRTEINO') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sequence = "{{ input_sequence }}"
max_new_tokens = {{ max_new_tokens }}

import re
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
_ = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)

seq = input_sequence.strip().upper()
seq = re.sub(r"[UZOB]", "X", seq)
seq = " ".join(list(seq))
seq = "<AA2fold> " + seq
inputs = tokenizer([seq], return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        num_beams=1,
    )

output = tokenizer.batch_decode(generated, skip_special_tokens=True)[0].replace(" ", "")

RESULT = {"output": output}
