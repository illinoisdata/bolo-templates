{% set repo_id = repo_id | default("khhuang/zerofec-qa2claim-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("What is Night of the Living Dead?") %}
{% set answer = answer | default("a 1968 american independent horror film") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
answer = "{{ answer }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

formatted_input = f"{answer}\n{question}"
encoded_inputs = tokenizer(formatted_input, return_tensors="pt")
input_ids = encoded_inputs.input_ids.to(device)
attention_mask = encoded_inputs.attention_mask.to(device)

generated_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    num_beams=num_beams,
)
generated_claims = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_claim = generated_claims[0]
RESULT = {"generated_claim": generated_claim}
