{% set repo_id = repo_id | default("khhuang/zerofec-qa2claim-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("What is Night of the Living Dead?") %}
{% set answer = answer | default("a 1968 american independent horror film") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
answer = "{{ answer }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

text = f"{answer} \n {question}"

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_file.rsplit('/', 1)[0],
    use_fast=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    model_file.rsplit('/', 1)[0],
    torch_dtype=torch.float32,
)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=32, num_beams=4)
output = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"output": output}
