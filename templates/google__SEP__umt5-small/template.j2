{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "translate English to Spanish: Machine learning is transforming the world." %}
{% set max_new_tokens = 64 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__umt5-small" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, UMT5Config, UMT5ForConditionalGeneration

torch_device = torch.device(device)

config = UMT5Config.from_pretrained(repo_id)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = UMT5ForConditionalGeneration.from_pretrained(repo_id, config=config).to(torch_device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(torch_device)
attention_mask = inputs["attention_mask"].to(torch_device)

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_new_tokens=max_new_tokens,
)

decoded_texts = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"generated_text": decoded_texts[0]}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_text.txt")
    with open(output_path, "w", encoding="utf-8") as out_file:
        out_file.write(RESULT["generated_text"])