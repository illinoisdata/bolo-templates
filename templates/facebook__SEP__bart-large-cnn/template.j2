repo_id = '{{ repo_id }}'
device = '{{ device }}'
output_dir = '{{ output_dir }}'
article = '''{{ article }}'''

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
config = model.config

inputs = tokenizer(article, return_tensors='pt', truncation=True).to(device)

output_ids = model.generate(
    **inputs,
    max_length=config.task_specific_params['summarization']['max_length'],
    min_length=config.task_specific_params['summarization']['min_length'],
    length_penalty=config.task_specific_params['summarization']['length_penalty'],
    num_beams=config.task_specific_params['summarization']['num_beams'],
    no_repeat_ngram_size=config.task_specific_params['summarization']['no_repeat_ngram_size'],
    early_stopping=config.task_specific_params['summarization']['early_stopping'],
)

summary = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {'summary_text': summary}

if __name__ == '__main__':
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, 'summary_text.txt')
    with open(output_path, 'w') as f:
        f.write(RESULT['summary_text'])