{% set repo_id = repo_id | default("llm-book/bert-base-japanese-v3-ner-wikipedia-dataset") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set aggregation_strategy = aggregation_strategy | default("simple") %}
{% set input_prompt = input_prompt | default("大谷翔平は岩手県水沢市出身のプロ野球選手です。") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
aggregation_strategy = {{ aggregation_strategy | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=repo_id,
    device=device,
    aggregation_strategy=aggregation_strategy,
)

RESULT = pipe(input_prompt)
