{% set repo_id = repo_id | default("allenai/unifiedqa-t5-small") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("What is the capital of France?") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded_sequences = tokenizer.batch_decode(generated, skip_special_tokens=True)
generated_text = decoded_sequences[0] if decoded_sequences else ""

RESULT = {"generated_text": generated_text}
