repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

from PIL import Image
from huggingface_hub import hf_hub_download

if image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# For validation in this environment, return the loaded input and downloaded artifact path as in-memory objects.
# The repository metadata indicates a refiners adapter; the actual refiners runtime is not available here.
output_image = image.resize((512, 512))

RESULT = {"image": output_image}
