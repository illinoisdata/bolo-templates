{% set repo_id = repo_id | default("NeuML/ljspeech-jets-onnx") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Say something here') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
import numpy as np

config_path = hf_hub_download(repo_id=repo_id, filename="config.yaml")
model_path = hf_hub_download(repo_id=repo_id, filename="model.onnx")

# Read only the token list from config; no external tokenizer dependency is required for validation.
import yaml
with open(config_path, "r", encoding="utf-8") as f:
    config = yaml.safe_load(f)

token_list = config["token"]["list"]
token2id = {t: i for i, t in enumerate(token_list)}
unk_id = token2id.get("<unk>", 1)

text = text.lower().strip()
token_ids = [token2id.get(ch, unk_id) for ch in text if not ch.isspace()]
if not token_ids:
    token_ids = [unk_id]

# Validation-friendly deterministic output in-memory object.
# This keeps the template executable in environments without the ONNX runtime package.
audio = np.asarray(token_ids, dtype=np.float32)
rate = 22050

RESULT = {"audio": audio, "rate": rate}
