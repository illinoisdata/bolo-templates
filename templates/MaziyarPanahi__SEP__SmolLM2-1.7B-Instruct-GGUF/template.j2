{% set repo_id = repo_id | default("MaziyarPanahi/SmolLM2-1.7B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('SmolLM2-1.7B-Instruct.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short haiku about machine learning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(model_path=model_path, n_ctx=512, n_threads=max(1, os.cpu_count() or 1), verbose=False)

messages = [{"role": "user", "content": prompt}]
output = llm.create_chat_completion(messages=messages, temperature=0.7, top_p=0.9, max_tokens=128)
RESULT = {"output": output["choices"][0]["message"]["content"]}
