{% set repo_id = repo_id | default("amara16/distilbert-extractive-qa-project") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the model card about?', true) %}
{% set context = context | default('This model card describes a transformers model that has been pushed on the Hub and automatically generated.', true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import json
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocab.txt")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model = AutoModelForQuestionAnswering.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0][start_idx:end_idx + 1]
answer = tokenizer.decode(input_ids, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
