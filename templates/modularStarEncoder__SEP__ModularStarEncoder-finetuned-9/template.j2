{% set repo_id = repo_id | default("modularStarEncoder/ModularStarEncoder-finetuned-9") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("feature-extraction") %}
{% set input_prompt = input_prompt | default("Hello, world!") %}

repo_id = "{{ repo_id }}"
task = "{{ task }}"
device = "{{ device }}"
input_prompt = "{{ input_prompt }}"

from huggingface_hub import snapshot_download
import os
from transformers import pipeline

# Download the repository locally
local_repo = snapshot_download(repo_id=repo_id)

# Patch config.py to fix tuple assignments and add rope parameters
config_file = os.path.join(local_repo, "config.py")
lines = open(config_file).read().splitlines()
with open(config_file, "w") as f:
    rope_inserted = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("self.") and line.rstrip().endswith(","):
            f.write(line.rstrip().rstrip(",") + "\n")
        else:
            f.write(line + "\n")
        if stripped == "**kwargs)" and not rope_inserted:
            f.write("        self.rope_parameters = {\"rope_type\": \"default\", \"rope_theta\": self.rope_theta}\n")
            rope_inserted = True

# Patch modularStarEncoder.py to remove flawed list/tuple element assignments
mod_file = os.path.join(local_repo, "modularStarEncoder.py")
lines = open(mod_file).read().splitlines()
with open(mod_file, "w") as f:
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.strip().startswith("for element in dir(config):"):
            f.write("# " + line + "\n")
            for j in range(1, 4):
                if i + j < len(lines):
                    f.write("# " + lines[i + j] + "\n")
            i += 4
        else:
            f.write(line + "\n")
            i += 1

pipe = pipeline(task=task, model=local_repo, device=device, trust_remote_code=True)
RESULT = pipe(input_prompt)
