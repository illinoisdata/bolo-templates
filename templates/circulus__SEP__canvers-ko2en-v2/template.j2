{% set repo_id = "circulus/canvers-ko2en-v2" %}
{% set device = "cuda:0" %}
{% set text_input = "안녕하세요. 영어로 번역을 위한 예시 문장입니다." %}
{% set max_new_tokens = 256 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/circulus__SEP__canvers-ko2en-v2" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {
    name: tensor.to(device)
    for name, tensor in encoded_inputs.items()
    if name != "token_type_ids"
}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")