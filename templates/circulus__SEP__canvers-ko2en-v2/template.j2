{% set repo_id = repo_id | default("circulus/canvers-ko2en-v2") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("안녕하세요. 영어로 번역을 위한 예시 문장입니다.") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {
    name: tensor.to(device)
    for name, tensor in encoded_inputs.items()
    if name != "token_type_ids"
}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
