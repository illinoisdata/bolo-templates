{% set repo_id = repo_id | default("timm/deit_tiny_patch16_224.fb_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

preprocessed_input = Image.open(input_data).convert("RGB")

RESULT = pipe(preprocessed_input)
