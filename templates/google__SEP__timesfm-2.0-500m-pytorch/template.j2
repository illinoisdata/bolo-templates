{% set repo_id = repo_id | default("google/timesfm-2.0-500m-pytorch") %}
{% set device = device | default("cuda:0") %}
{% set context = context | default([1.0, 1.2, 1.4, 1.35, 1.5, 1.7, 1.65, 1.8, 2.0, 2.1, 2.05, 2.2, 2.4, 2.35, 2.5, 2.7, 2.8, 2.75, 2.9, 3.1, 3.2, 3.15, 3.3, 3.5, 3.6, 3.55, 3.7, 3.9, 4.0, 4.05, 4.2, 4.4]) %}
{% set freq = freq | default(0) %}
{% set horizon = horizon | default(16) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = {{ context }}
freq = {{ freq }}
horizon = {{ horizon }}

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoConfig, AutoModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="torch_model.ckpt")

config = AutoConfig.from_pretrained(config_path, trust_remote_code=True)
model = AutoModel.from_config(config, trust_remote_code=True)
state = torch.load(weights_path, map_location="cpu")
if isinstance(state, dict) and "state_dict" in state:
    state = state["state_dict"]
model.load_state_dict(state, strict=False)
model.to(device)
model.eval()

series = np.asarray(context, dtype=np.float32)
if np.isnan(series).any():
    n = len(series)
    x = np.arange(n)
    mask = ~np.isnan(series)
    series = np.interp(x, x[mask], series[mask]).astype(np.float32)

patch_len = int(getattr(config, "patch_length", 32))
pad = (-len(series)) % patch_len
if pad:
    series = np.pad(series, (0, pad), mode="constant", constant_values=0.0)

input_tensor = torch.tensor(series, dtype=torch.float32, device=device).unsqueeze(0)
past_values_padding = torch.zeros_like(input_tensor, dtype=torch.float32)
freq_tensor = torch.tensor([freq], dtype=torch.long, device=device)
with torch.no_grad():
    outputs = model(input_tensor, past_values_padding, freq_tensor)

if isinstance(outputs, (tuple, list)):
    point_output = outputs[0]
    quantile_output = outputs[1] if len(outputs) > 1 else None
else:
    point_output = outputs
    quantile_output = None

RESULT = {
    "point_forecast": point_output.detach().cpu().numpy().tolist() if hasattr(point_output, "detach") else np.asarray(point_output).tolist(),
    "quantile_forecast": None if quantile_output is None else (quantile_output.detach().cpu().numpy().tolist() if hasattr(quantile_output, "detach") else np.asarray(quantile_output).tolist()),
}
