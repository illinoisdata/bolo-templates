{% set repo_id = repo_id | default("llm-blender/PairRM") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-classification") -%}
{% set model = model | default(repo_id) -%}
{% set instruction = instruction | default("Hello, my name is Eric, how are you?") -%}
{% set candidate_1 = candidate_1 | default("I am fine, thanks!") -%}
{% set candidate_2 = candidate_2 | default("I am doing well, thank you.") -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
instruction = {{ instruction | tojson }}
candidate_1 = {{ candidate_1 | tojson }}
candidate_2 = {{ candidate_2 | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

sequence_1 = instruction + " " + candidate_1
sequence_2 = instruction + " " + candidate_2
pipe_kwargs = {"padding": True, "truncation": True}

RESULT = {"outputs": pipe((sequence_1, sequence_2), **pipe_kwargs)}
