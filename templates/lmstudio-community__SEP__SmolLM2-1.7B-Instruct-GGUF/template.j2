{% set repo_id = repo_id | default("lmstudio-community/SmolLM2-1.7B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('SmolLM2-1.7B-Instruct-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short, cheerful two-sentence greeting.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_ctx = 512
n_threads = max(1, os.cpu_count() or 1)
n_gpu_layers = -1 if str(device).startswith('cuda') else 0

llm = Llama(
    model_path=model_path,
    n_ctx=n_ctx,
    n_threads=n_threads,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

response = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    top_p=0.9,
    max_tokens=128,
)

output_text = response["choices"][0]["message"]["content"]

RESULT = {"text": output_text}
