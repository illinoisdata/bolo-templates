{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-da-de") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hej! Hvordan har du det?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, MarianMTModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
gen_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# tokenizer/model load
_tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
model = MarianMTModel.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = _tokenizer([text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=512)

output_text = _tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
