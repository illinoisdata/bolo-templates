{% set repo_id = repo_id | default("allenai/longformer-base-4096") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Longformer is a transformer model for long documents. It supports sequences of length up to 4096 tokens.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

# Load tokenizer and model from downloaded local files.
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
    local_files_only=True,
)
model = AutoModelForMaskedLM.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
predicted_token_ids = torch.argmax(logits, dim=-1)
predicted_tokens = tokenizer.convert_ids_to_tokens(predicted_token_ids[0].tolist())

RESULT = {
    "logits": logits.detach().cpu(),
    "predicted_token_ids": predicted_token_ids.detach().cpu(),
    "predicted_tokens": predicted_tokens,
}
