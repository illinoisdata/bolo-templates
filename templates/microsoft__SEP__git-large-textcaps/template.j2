{% set repo_id = "microsoft/git-large-textcaps" %}
{% set device = "cuda:0" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set max_new_tokens = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_new_tokens = {{ max_new_tokens }}

import io
from pathlib import Path

import requests
import torch
from PIL import Image
from transformers import AutoModelForCausalLM, AutoProcessor

processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id).to(torch.device(device))

if image_path.lower().startswith("http"):
    response = requests.get(image_path)
    response.raise_for_status()
    image = Image.open(io.BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(torch.device(device)) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_new_tokens=max_new_tokens)
generated_text = processor.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"generated_text": generated_text}
