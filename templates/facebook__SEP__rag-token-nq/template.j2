{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("facebook/rag-token-nq") %}
{% set question_text = question_text | default("who holds the record in 100m freestyle") %}
{% set use_dummy_retriever = use_dummy_retriever | default(true) %}
{% set retriever_index_name = retriever_index_name | default("exact") %}
{% set num_return_sequences = num_return_sequences | default(1) %}
{% set max_length = max_length | default(50) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question_text = "{{ question_text | replace('"', '\\"') }}"
use_dummy_retriever = {{ "True" if use_dummy_retriever else "False" }}
retriever_index_name = "{{ retriever_index_name }}"
num_return_sequences = {{ num_return_sequences }}
max_length = {{ max_length }}

import numpy as np
import torch
from pathlib import Path
from transformers import RagRetriever, RagTokenForGeneration, RagTokenizer

_original_numpy_array = np.array

def _patched_numpy_array(*args, **kwargs):
    try:
        return _original_numpy_array(*args, **kwargs)
    except ValueError as error:
        if kwargs.get("copy") is False and "Unable to avoid copy while creating an array as requested" in str(error):
            kwargs.pop("copy", None)
            return _original_numpy_array(*args, **kwargs)
        raise

np.array = _patched_numpy_array

inference_device = torch.device(device)

tokenizer = RagTokenizer.from_pretrained(repo_id)
retriever = RagRetriever.from_pretrained(
    repo_id,
    index_name=retriever_index_name,
    use_dummy_dataset=use_dummy_retriever,
)
model = RagTokenForGeneration.from_pretrained(repo_id, retriever=retriever)
model = model.to(inference_device)
model.eval()

encoded_inputs = tokenizer(question_text, return_tensors="pt")
encoded_inputs.pop("token_type_ids", None)
encoded_inputs = {name: tensor.to(inference_device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_return_sequences=num_return_sequences,
)

decoded_answers = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"answers": decoded_answers}
