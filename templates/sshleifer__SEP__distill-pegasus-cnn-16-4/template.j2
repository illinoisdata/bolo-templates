{% set repo_id = repo_id | default("sshleifer/distill-pegasus-cnn-16-4") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The US economy added more jobs than expected last month, according to a new report. Analysts say the labor market remains resilient even as interest rates stay elevated, but wage growth has begun to cool. Investors are watching closely for signs that consumer spending may slow in the coming months.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

from huggingface_hub import hf_hub_download
from transformers import PegasusTokenizer, PegasusForConditionalGeneration
import torch

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")


tokenizer = PegasusTokenizer.from_pretrained(repo_id, local_files_only=True)
model = PegasusForConditionalGeneration.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=128,
        num_beams=8,
        length_penalty=0.8,
        early_stopping=True,
    )
summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
