{% set input_text = "The government announced a new climate initiative that aims to reduce emissions substantially while boosting renewable energy infrastructure." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/sshleifer__SEP__distill-pegasus-cnn-16-4" %}
{% set generation_max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
output_dir = "{{ output_dir }}"
generation_max_length = {{ generation_max_length }}

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=generation_max_length,
        num_beams=getattr(model.config, "num_beams", 1),
    )

summary = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0].strip()

RESULT = {"summary": summary}

if __name__ == "__main__":
    out_dir = Path(output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")