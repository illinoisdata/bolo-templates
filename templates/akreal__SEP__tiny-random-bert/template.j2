{% set repo_id = "akreal/tiny-random-bert" %}
{% set device = "cuda:0" %}
{% set text_input = "The quick brown fox jumps over the lazy dog." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import json
import os
from typing import Dict, Any

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

model = AutoModelForMaskedLM.from_pretrained(repo_id)
model = model.to(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    padding=True,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

outputs = model(**encoded_inputs)
logits = outputs.logits
predicted_token_ids = logits.argmax(dim=-1)[0]
predicted_tokens = tokenizer.convert_ids_to_tokens(predicted_token_ids)
predicted_token_ids_list = predicted_token_ids.detach().cpu().tolist()
logits_list = logits.detach().cpu().tolist()
prediction_text = tokenizer.decode(predicted_token_ids_list, skip_special_tokens=True)

RESULT: Dict[str, Any] = {
    "logits": logits_list,
    "predicted_token_ids": predicted_token_ids_list,
    "predicted_tokens": predicted_tokens,
    "prediction_text": prediction_text,
}
