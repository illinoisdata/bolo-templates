{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("MingZhong/unieval-sum") %}
{% set source_text = source_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set summary_text = summary_text | default("A quick fox jumps over a lazy dog.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
summary_text = "{{ summary_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

# Pre-process input texts
inputs = tokenizer(source_text, summary_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Generate evaluation scores
outputs = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

# Decode generated tokens to text
decoded = tokenizer.batch_decode(outputs, skip_special_tokens=True)
evaluation = decoded[0]

RESULT = {"evaluation": evaluation}
