{% set input_sentences = ["[START] Einstein [END] era un fisico tedesco."] %}
{% set num_beams = 5 %}
{% set num_return_sequences = 5 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mgenre-wiki" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sentences = {{ input_sentences }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
output_dir = "{{ output_dir }}"
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(input_sentences, return_tensors="pt", padding=True).to(device)
outputs = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
)

generated_texts = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"generated_entities": generated_texts}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_file = os.path.join(output_dir, "generated_entities.txt")
    with open(output_file, "w", encoding="utf-8") as f:
        for text in generated_texts:
            f.write(text + "\n")