{% set repo_id = "prajjwal1/bert-mini" %}
{% set device = "cuda:0" %}
{% set text = "The quick brown fox jumps over the lazy dog." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import BertModel, BertTokenizer

tokenizer = BertTokenizer.from_pretrained("bert-base-uncased")
model = BertModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()
RESULT = {"last_hidden_state": last_hidden_state}
