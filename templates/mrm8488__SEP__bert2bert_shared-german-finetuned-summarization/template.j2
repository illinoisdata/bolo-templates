{% set repo_id = "mrm8488/bert2bert_shared-german-finetuned-summarization" %}
{% set device = "cuda:0" %}
{% set text_input = "Der Bericht hebt hervor, dass neue Technologien die Forschung beschleunigen können." %}
{% set tokenizer_max_length = 512 %}
{% set generation_max_length = 64 %}
{% set generation_min_length = 8 %}
{% set generation_num_beams = 4 %}
{% set generation_no_repeat_ngram_size = 3 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
tokenizer_max_length = {{ tokenizer_max_length }}
generation_max_length = {{ generation_max_length }}
generation_min_length = {{ generation_min_length }}
generation_num_beams = {{ generation_num_beams }}
generation_no_repeat_ngram_size = {{ generation_no_repeat_ngram_size }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text_input,
    padding="max_length",
    truncation=True,
    max_length=tokenizer_max_length,
    return_tensors="pt",
)
input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)

with torch.no_grad():
    generated_tokens = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        max_length=generation_max_length,
        min_length=generation_min_length,
        num_beams=generation_num_beams,
        no_repeat_ngram_size=generation_no_repeat_ngram_size,
        early_stopping=True,
    )

summary = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()
RESULT = {"summary": summary}
