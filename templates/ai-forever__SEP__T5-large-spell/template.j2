{% set device = "cuda:0" %}
{% set repo_id = "ai-forever/T5-large-spell" %}
{% set prefix = "grammar: " %}
{% set text = "If you bought something goregous, you well be very happy." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prefix = "{{ prefix }}"
text = "{{ text }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_text = prefix + text
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(**inputs)
decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
result_text = decoded[0]

RESULT = {"generated_text": result_text}
