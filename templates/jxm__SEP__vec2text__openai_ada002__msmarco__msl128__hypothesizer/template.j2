{% set repo_id = repo_id | default("jxm/vec2text__openai_ada002__msmarco__msl128__hypothesizer") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('Represent the meaning of this passage as a search query: A small cat is sleeping on a sunny windowsill.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, T5EncoderModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained("t5-base")
model = T5EncoderModel.from_pretrained("t5-base")
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt", truncation=True, max_length=128)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooled = last_hidden_state.mean(dim=1)
RESULT = {"embedding": pooled.detach().cpu().numpy()}
