{% set repo_id = repo_id | default("chuhac/BiomedCLIP-vit-bert-hf") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-image-classification") %}
{% set model = model | default(repo_id) %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set candidate_labels = candidate_labels | default(["medical scan", "healthcare scene", "laboratory equipment", "doctor", "patient"]) %}
{% set hypothesis_template = hypothesis_template | default("This is a photo of {}.") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
candidate_labels = {{ candidate_labels | tojson }}
hypothesis_template = {{ hypothesis_template | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_image, candidate_labels=candidate_labels, hypothesis_template=hypothesis_template)
