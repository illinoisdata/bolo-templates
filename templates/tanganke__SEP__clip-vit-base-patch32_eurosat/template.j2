{% set task = task | default("image-feature-extraction") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set processor_repo = processor_repo | default("openai/clip-vit-base-patch32") %}
{% set repo_id = repo_id | default("tanganke/clip-vit-base-patch32_eurosat") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"
processor_repo = "{{ processor_repo }}"

from transformers import AutoImageProcessor, pipeline
from PIL import Image

image_processor = AutoImageProcessor.from_pretrained(processor_repo)
pipe = pipeline(task=task, model=repo_id, device=device, image_processor=image_processor)

image = Image.open(input_image).convert("RGB")
RESULT = {"features": pipe(image)}
