{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set candidate_labels = candidate_labels | default(['playing music', 'playing sports']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
candidate_labels = {{ candidate_labels }}

import os
import requests
import torch
from PIL import Image
from transformers import CLIPModel, CLIPProcessor
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = CLIPProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = CLIPModel.from_pretrained(os.path.dirname(config_path), torch_dtype=torch.float32)
state_dict = load_file(model_path)
state_dict.pop("text_model.embeddings.position_ids", None)
state_dict.pop("vision_model.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

inputs = processor(text=candidate_labels, images=image, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
    probs = outputs.logits_per_image.softmax(dim=1).squeeze(0)

result = {label: float(prob) for label, prob in zip(candidate_labels, probs.detach().cpu())}
RESULT = {"labels": candidate_labels, "scores": result}
