{% set repo_id = repo_id | default("monologg/kocharelectra-base-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('이 문장은 긍정적인가요?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForPreTraining, ElectraConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = ElectraConfig.from_json_file(config_path)
tokenizer = AutoTokenizer.from_pretrained(repo_id, vocab_file=vocab_path, local_files_only=True)
model = AutoModelForPreTraining.from_config(config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits.detach().cpu()
probabilities = torch.sigmoid(logits)
RESULT = {"logits": logits, "probabilities": probabilities}
