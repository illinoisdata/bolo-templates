{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/monologg__SEP__kocharelectra-base-discriminator" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
output_dir = "{{ output_dir }}"

import numpy as np
import torch
from pathlib import Path
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenized_inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits_tensor = outputs.logits
logits = logits_tensor.detach().cpu().tolist() if isinstance(logits_tensor, torch.Tensor) else logits_tensor

discriminator_logits_tensor = None
if hasattr(outputs, "discriminator_logits"):
    discriminator_logits_tensor = outputs.discriminator_logits
elif isinstance(outputs, (tuple, list)) and len(outputs) > 1:
    discriminator_logits_tensor = outputs[1]

discriminator_logits = None
if discriminator_logits_tensor is not None:
    discriminator_logits = (
        discriminator_logits_tensor.detach().cpu().tolist()
        if isinstance(discriminator_logits_tensor, torch.Tensor)
        else discriminator_logits_tensor
    )

RESULT = {"logits": logits}
if discriminator_logits is not None:
    RESULT["discriminator_logits"] = discriminator_logits

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    np.save(output_path / "logits.npy", np.array(RESULT["logits"], dtype=np.float32))
    if "discriminator_logits" in RESULT:
        np.save(output_path / "discriminator_logits.npy", np.array(RESULT["discriminator_logits"], dtype=np.float32))