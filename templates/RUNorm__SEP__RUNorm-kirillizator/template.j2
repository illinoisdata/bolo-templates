{% set repo_id = repo_id | default("RUNorm/RUNorm-kirillizator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Привет,мир!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model
_tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.bfloat16)
_model.to(device)
_model.eval()

inputs = _tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = _model.generate(
        **inputs,
        max_new_tokens=64,
        num_beams=1,
    )

output_text = _tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
