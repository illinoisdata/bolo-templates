{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("RUNorm/RUNorm-kirillizator") %}
{% set input_text = input_text | default("Пример текста для нормализации: номер 123") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)
encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: tensor.to(torch_device) for key, tensor in encoded_inputs.items()}
generated_tokens = model.generate(**encoded_inputs)
normalized_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"normalized_text": normalized_text}
