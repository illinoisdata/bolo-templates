{% set input_text = "Пример текста для нормализации: номер 123" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/RUNorm__SEP__RUNorm-kirillizator" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"
import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)
encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: tensor.to(torch_device) for key, tensor in encoded_inputs.items()}
generated_tokens = model.generate(**encoded_inputs)
normalized_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"normalized_text": normalized_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "normalized_text.txt").write_text(normalized_text, encoding="utf-8")