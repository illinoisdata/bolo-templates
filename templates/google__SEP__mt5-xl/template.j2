{% set repo_id = repo_id | default("google/mt5-xl") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hello, how are you?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(text, return_tensors="pt")
encoded = {k: v.to(device) for k, v in encoded.items()}

outputs = model.generate(**encoded)

generated = tokenizer.batch_decode(outputs, skip_special_tokens=True)
generated_text = generated[0]

RESULT = {"generated_text": generated_text}
