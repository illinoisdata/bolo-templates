{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("KETI-AIR/ke-t5-small") %}
{% set input_text = input_text | default("아버지가 방에 들어가신다.</s>") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
