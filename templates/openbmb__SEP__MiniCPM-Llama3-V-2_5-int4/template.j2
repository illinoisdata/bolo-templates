{% set repo_id = repo_id | default("openbmb/MiniCPM-Llama3-V-2_5-int4") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is in the image?') %}
{% set image1 = image1 | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
image1 = {{ image1 | tojson }}

import os
import requests
import torch
from PIL import Image
from huggingface_hub import snapshot_download
from transformers import AutoModel, AutoTokenizer

model_dir = snapshot_download(repo_id=repo_id, allow_patterns=['*.py', '*.json', '*.safetensors', '*.bin', '*.model', '*.txt'])

if str(image1).startswith(('http://', 'https://')):
    image = Image.open(requests.get(image1, stream=True).raw).convert('RGB')
else:
    image = Image.open(image1).convert('RGB')

model = AutoModel.from_pretrained(model_dir, trust_remote_code=True, torch_dtype=torch.float16, device_map=None).to(device)
tokenizer = AutoTokenizer.from_pretrained(model_dir, trust_remote_code=True)
model.eval()
msgs = [{'role': 'user', 'content': question}]
with torch.no_grad():
    output = model.chat(image=image, msgs=msgs, tokenizer=tokenizer, sampling=True, temperature=0.7)

RESULT = {"output": output}
