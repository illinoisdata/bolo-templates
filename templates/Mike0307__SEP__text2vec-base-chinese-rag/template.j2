{% set repo_id = repo_id | default("Mike0307/text2vec-base-chinese-rag") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('福井舞所屬哪家唱片公司？') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")


def mean_pooling(model_output, attention_mask):
    token_embeddings = model_output.last_hidden_state
    input_mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()
    return torch.sum(token_embeddings * input_mask_expanded, 1) / torch.clamp(input_mask_expanded.sum(1), min=1e-9)


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

sentences = [
    question,
    "23歲時出道、血型A型的福井舞是出身於京都的日本女創作歌手，所屬唱片公司為J-more。2004年，與WADAGAKI、SHINO組合地下音樂隊Poplar，發表了兩張專輯，天照和夢死物語。在2006年時退出，2007年10月加入了Avex獨立發展。",
]

encode_output = tokenizer(sentences, padding=True, truncation=True, return_tensors="pt", max_length=512)
encode_output = {k: v.to(device) for k, v in encode_output.items()}
with torch.no_grad():
    model_output = model(**encode_output)
    embeddings = mean_pooling(model_output, encode_output["attention_mask"])
    similarity = torch.cosine_similarity(embeddings[0], embeddings[1], dim=0)

RESULT = {"similarity": similarity.item(), "embeddings": embeddings.detach().cpu().tolist()}
