{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set target_language = "zho" %}
{% set max_new_tokens = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-zh" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}
target_language = {{ target_language | tojson }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = {{ output_dir | tojson }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)

torch_device = torch.device(device)
model = model.to(torch_device)

language_token = f">>{target_language}<<"
prefixed_text = f"{language_token} {input_text}"
inputs = tokenizer(prefixed_text, return_tensors="pt")
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
)

translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translation_path = os.path.join(output_dir, "translation.txt")
    with open(translation_path, "w", encoding="utf-8") as writer:
        writer.write(RESULT["translation"])