{% set input_text = "ستایش خدای را که پروردگار جهانیان است." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translated_text = decoded_outputs[0] if decoded_outputs else ""

RESULT = {"translation": translated_text}

if __name__ == "__main__":
    output_dir = Path("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/persiannlp__SEP__mt5-small-parsinlu-opus-translation_fa_en")
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")