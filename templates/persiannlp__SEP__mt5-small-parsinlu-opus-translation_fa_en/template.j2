{% set repo_id = repo_id | default("persiannlp/mt5-small-parsinlu-opus-translation_fa_en") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("ستایش خدای را که پروردگار جهانیان است.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

# Pre-process input & load model
_tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
_model.to(device)
_model.eval()

inputs = _tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    generated_ids = _model.generate(**inputs, max_new_tokens=64)
    output_text = _tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

# Post-process & build RESULT dict
RESULT = {"translation": output_text}
