{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("knkarthick/MEETING_SUMMARY") %}
{% set input_text = input_text | default("The tower is 324 metres (1,063 ft) tall, about the same height as an 81-storey building, and the tallest structure in Paris. Its base is square, measuring 125 metres (410 ft) on each side.") %}
{% set max_output_length = max_output_length | default(128) %}
{% set min_output_length = min_output_length | default(30) %}
{% set num_beams = num_beams | default(6) %}
{% set output_file_name = output_file_name | default("summary.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_output_length = {{ max_output_length }}
min_output_length = {{ min_output_length }}
num_beams = {{ num_beams }}
output_file_name = "{{ output_file_name }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_output_length,
        min_length=min_output_length,
        num_beams=num_beams,
        early_stopping=True,
    )

summary_tokens = generated_tokens
summary_outputs = tokenizer.batch_decode(summary_tokens, skip_special_tokens=True)
summary_text = summary_outputs[0].strip()

RESULT = {"summary": summary_text}
