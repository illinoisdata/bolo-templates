{% set repo_id = repo_id | default("twmkn9/albert-base-v2-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the model trained on?') %}
{% set context = context | default('This model is ALBERT base v2 trained on SQuAD v2.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering, AlbertConfig

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

config = AlbertConfig.from_pretrained(config_file)
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=False,
    config=config,
)
model = AutoModelForQuestionAnswering.from_pretrained(
    repo_id,
    config=config,
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True, max_length=384)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx
answer = tokenizer.decode(inputs["input_ids"][0][start_idx:end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
