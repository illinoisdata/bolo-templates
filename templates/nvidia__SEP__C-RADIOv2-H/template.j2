{% set repo_id = repo_id | default("nvidia/C-RADIOv2-H") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import sys
import importlib
import setuptools._distutils as _distutils
sys.modules.setdefault("distutils", _distutils)
sys.modules.setdefault("distutils.core", importlib.import_module("setuptools._distutils.core"))
sys.modules.setdefault("distutils.errors", importlib.import_module("setuptools._distutils.errors"))
sys.modules.setdefault("distutils.sysconfig", importlib.import_module("setuptools._distutils.sysconfig"))

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoModel

_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = AutoModel.from_pretrained(repo_id, trust_remote_code=True, torch_dtype=torch.float32)
model = model.to(device)
model.eval()
from transformers import AutoImageProcessor
preprocessor = AutoImageProcessor.from_pretrained(os.path.dirname(_), trust_remote_code=True)
inputs = preprocessor(images=image, return_tensors="pt")
pixel_values = inputs["pixel_values"].to(device)
with torch.no_grad():
    out = model(pixel_values)
summary, spatial_features = out if isinstance(out, tuple) else (out[0], out[1])

RESULT = {"summary": summary, "spatial_features": spatial_features}
