{% set repo_id = repo_id | default("SpanBERT/spanbert-base-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)
if pooler_output is not None:
    pooler_output = pooler_output.detach().cpu()

RESULT = {
    "last_hidden_state": last_hidden_state.detach().cpu(),
    "pooler_output": pooler_output,
}
