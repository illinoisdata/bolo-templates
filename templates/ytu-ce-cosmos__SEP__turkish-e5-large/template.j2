{% set repo_id = repo_id | default("ytu-ce-cosmos/turkish-e5-large") %}
{% set device = device | default("cuda:0") %}
{% set query_1 = query_1 | default('Given a Turkish search query, retrieve relevant passages written in Turkish that best answer the query') %}
{% set query_2 = query_2 | default('Given a Turkish search query, retrieve relevant passages written in Turkish that best answer the query') %}
{% set text_1 = text_1 | default('Kolay bir kahvaltı tarifi nedir?') %}
{% set text_2 = text_2 | default('Dış mekan yürüyüşü için en iyi saat hangisidir?') %}
{% set doc_1 = doc_1 | default('Güne enerjik başlamak için yulaf ezmesi, süt ve meyveyle hazırlanan basit bir kahvaltı hem pratik hem de besleyicidir. Üzerine biraz bal ve tarçın eklerseniz lezzeti artar.') %}
{% set doc_2 = doc_2 | default('Sabah saatleri, özellikle 07:00 ile 10:00 arası, açık havada yürüyüş yapmak için idealdir. Bu saatlerde hava daha serin ve temiz olur, ayrıca gün ışığı vücut ritmini destekler.') %}
{% set doc_3 = doc_3 | default("Türkiye'nin en uzun nehri Kızılırmak'tır. Sivas'tan doğar, Karadeniz'e dökülür ve yaklaşık 1.355 kilometre uzunluğundadır.") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
query_1 = "{{ query_1 }}"
query_2 = "{{ query_2 }}"
text_1 = "{{ text_1 }}"
text_2 = "{{ text_2 }}"
doc_1 = "{{ doc_1 }}"
doc_2 = "{{ doc_2 }}"
doc_3 = "{{ doc_3 }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModel

weights_path = hf_hub_download(repo_id=repo_id, filename='model.safetensors')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
tokenizer_path = hf_hub_download(repo_id=repo_id, filename='tokenizer.json')
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
sentencepiece_path = hf_hub_download(repo_id=repo_id, filename='sentencepiece.bpe.model')

model_dir = weights_path.rsplit('/', 1)[0]

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModel.from_pretrained(model_dir).to(device)
model.eval()

def get_detailed_instruct(task_description: str, query: str) -> str:
    return f'Instruct: {task_description}\nQuery: {query}'

task = 'Given a Turkish search query, retrieve relevant passages written in Turkish that best answer the query'
queries = [
    get_detailed_instruct(task, text_1),
    get_detailed_instruct(task, text_2),
]
documents = [doc_1, doc_2, doc_3]
input_texts = queries + documents

batch = tokenizer(input_texts, padding=True, truncation=True, return_tensors='pt')
batch = {k: v.to(device) for k, v in batch.items()}

with torch.no_grad():
    outputs = model(**batch)
    last_hidden = outputs.last_hidden_state
    attention_mask = batch['attention_mask'].unsqueeze(-1).type_as(last_hidden)
    embeddings = (last_hidden * attention_mask).sum(dim=1) / attention_mask.sum(dim=1).clamp(min=1e-9)
    embeddings = torch.nn.functional.normalize(embeddings, p=2, dim=1)
    scores = (embeddings[:2] @ embeddings[2:].T) * 100

RESULT = {
    'embeddings': embeddings.detach().cpu(),
    'scores': scores.detach().cpu(),
    'queries': queries,
    'documents': documents,
}
