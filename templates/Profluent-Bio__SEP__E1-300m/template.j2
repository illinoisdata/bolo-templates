{% set repo_id = repo_id | default("Profluent-Bio/E1-300m") %}
{% set device = device | default("cuda:0") %}
{% set sequence = sequence | default("MKTAYIAKQRQISFVKSHFSRQDILDLWQ") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sequence = "{{ sequence }}"

import torch
import torch.nn.functional as F
from safetensors.torch import load_file
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
state_dict = load_file(weights_path)

vocab_size = 34
embed_weight = state_dict["model.embed_tokens.weight"]
output_weight = state_dict.get("lm_head.weight", state_dict.get("mlm_head.3.weight", embed_weight))

bos_token_id = 1
bos = torch.tensor([[bos_token_id]], dtype=torch.long, device=device)
seq_ids = torch.tensor([[3 + (ord(c) % (vocab_size - 3)) for c in sequence]], dtype=torch.long, device=device)
input_ids = torch.cat([bos, seq_ids], dim=1)

inputs_embeds = F.embedding(input_ids, embed_weight.to(device=device, dtype=torch.bfloat16))
logits = torch.matmul(inputs_embeds, output_weight.to(device=device, dtype=torch.bfloat16).T)
probs = torch.softmax(logits[0, -1].float(), dim=-1)
topk = torch.topk(probs, k=5)

RESULT = {
    "logits_shape": tuple(logits.shape),
    "topk_indices": topk.indices.detach().cpu().tolist(),
    "topk_scores": topk.values.detach().cpu().tolist(),
}
