repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

from huggingface_hub import hf_hub_download
import json
import torch
import numpy as np
from PIL import Image
import torchvision.transforms as T
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

img = Image.open(image_path).convert("RGB")
input_size = tuple(config["data"]["image_shape"])
preprocess = T.Compose([
    T.Resize(input_size, interpolation=T.InterpolationMode.BICUBIC),
    T.CenterCrop(input_size),
    T.ToTensor(),
    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])
image_tensor = preprocess(img).unsqueeze(0).to(device)

state_dict = load_file(weights_path, device=device)

class SimpleWrapper(torch.nn.Module):
    def __init__(self):
        super().__init__()
        self.backbone = torch.nn.Sequential(
            torch.nn.Conv2d(3, 8, kernel_size=3, padding=1),
            torch.nn.ReLU(),
            torch.nn.AdaptiveAvgPool2d((1, 1)),
            torch.nn.Flatten(),
            torch.nn.Linear(8, 1),
        )
    def forward(self, x):
        return self.backbone(x)

model = SimpleWrapper().to(device)
model.load_state_dict(state_dict, strict=False)
model.eval()

with torch.no_grad():
    output = model(image_tensor)

output_value = output.detach().cpu().numpy()
RESULT = {"output": output_value}
