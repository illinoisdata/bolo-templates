{% set repo_id = repo_id | default("openbmb/MiniCPM3-4B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("minicpm3-4b-q4_k_m.gguf") %}
{% set prompt = prompt | default("What is the capital of France?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith("cuda") else 0
llm = Llama(
    model_path=model_path,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

result = llm(prompt, max_tokens=32, temperature=0.0, top_p=1.0)
output_text = result["choices"][0]["text"].strip()

RESULT = {"text": output_text}
