{% set repo_id = repo_id | default("s-nlp/Mutual_Implication_Score") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default('I want to leave this room') %}
{% set paraphrase_text = paraphrase_text | default('I want to go out of this room') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
paraphrase_text = "{{ paraphrase_text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoModelForSequenceClassification, AutoTokenizer

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_config_file), use_fast=True)
model = AutoModelForSequenceClassification.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(source_text, paraphrase_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)

label2id = getattr(model.config, "label2id", {"entailment": 0, "neutral": 1, "contradiction": 2})
entailment_idx = label2id["entailment"] if isinstance(label2id, dict) and "entailment" in label2id else 0
contradiction_idx = label2id["contradiction"] if isinstance(label2id, dict) and "contradiction" in label2id else 2
output = {
    "score": float(probs[0, entailment_idx].item()),
    "logits": logits.detach().cpu().tolist()[0],
    "probabilities": probs.detach().cpu().tolist()[0],
    "contradiction_score": float(probs[0, contradiction_idx].item()),
}

RESULT = {"output": output}
