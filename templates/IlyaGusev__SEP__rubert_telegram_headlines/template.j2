{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("IlyaGusev/rubert_telegram_headlines") %}
{% set article_text = article_text | default("Это пример текста новости, на основе которого модель должна сгенерировать краткий заголовок.") %}
{% set max_input_length = max_input_length | default(256) %}
{% set max_output_length = max_output_length | default(64) %}
{% set num_beams = num_beams | default(10) %}
{% set top_p = top_p | default(0.95) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = "{{ article_text }}"
max_input_length = {{ max_input_length }}
max_output_length = {{ max_output_length }}
num_beams = {{ num_beams }}
top_p = {{ top_p }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}

import os
from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    do_lower_case=False,
    do_basic_tokenize=False,
    strip_accents=False,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)

torch_device = torch.device(device)
model = model.to(torch_device)

input_tensors = tokenizer(
    article_text,
    add_special_tokens=True,
    max_length=max_input_length,
    padding="max_length",
    truncation=True,
    return_tensors="pt",
)
input_tensors = {name: tensor.to(torch_device) for name, tensor in input_tensors.items()}

generated_ids = model.generate(
    **input_tensors,
    max_length=max_output_length,
    num_beams=num_beams,
    top_p=top_p,
    no_repeat_ngram_size=no_repeat_ngram_size,
)

headline = tokenizer.decode(
    generated_ids[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"headline": headline}
