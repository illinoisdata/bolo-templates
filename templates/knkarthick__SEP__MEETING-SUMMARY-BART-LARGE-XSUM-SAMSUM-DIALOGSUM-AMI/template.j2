{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("knkarthick/MEETING-SUMMARY-BART-LARGE-XSUM-SAMSUM-DIALOGSUM-AMI") %}
{% set text_input = text_input | default("The team held a kickoff meeting to design a remote control, discussing functionality, production cost, marketing, and next steps. They debated how to keep the device trendy yet affordable while covering a wide range of user needs.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(text_input, return_tensors="pt", truncation=True, padding=True).to(device)
with torch.inference_mode():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        early_stopping=True,
    )
summary = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"summary": summary}
