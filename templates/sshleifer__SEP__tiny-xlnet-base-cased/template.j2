{% set repo_id = repo_id | default("sshleifer/tiny-xlnet-base-cased") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
model = {{ model | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

if isinstance(device, str):
    if device.startswith("cuda"):
        pipeline_device = int(device.split(":", 1)[1])
    elif device == "cpu":
        pipeline_device = -1
    else:
        pipeline_device = int(device)
else:
    pipeline_device = device

pipe = pipeline(task=task, model=model, device=pipeline_device)
RESULT = pipe(input_prompt)
