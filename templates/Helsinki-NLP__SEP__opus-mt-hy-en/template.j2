{% set repo_id = "Helsinki-NLP/opus-mt-hy-en" %}
{% set device = "cuda:0" %}
{% set input_text = "Ես սիրում եմ ծրագրավորություն:" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(**encoded_inputs)
translation = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"translation": translation}
