{% set repo_id = "Helsinki-NLP/opus-mt-hy-en" %}
{% set device = "cuda:0" %}
{% set input_text = "Ես սիրում եմ ծրագրավորություն:" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-hy-en" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(**encoded_inputs)
translation = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"translation": translation}

if __name__ == "__main__":
    target_path = Path(output_dir)
    target_path.mkdir(parents=True, exist_ok=True)
    (target_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")