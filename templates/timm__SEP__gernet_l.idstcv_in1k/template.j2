{% set repo_id = repo_id | default("timm/gernet_l.idstcv_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set top_k = top_k | default(5) %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
top_k = {{ top_k }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

preprocessed_image = Image.open(input_image).convert("RGB")

inference_output = pipe(preprocessed_image, top_k=top_k)

RESULT = {"predictions": inference_output}
