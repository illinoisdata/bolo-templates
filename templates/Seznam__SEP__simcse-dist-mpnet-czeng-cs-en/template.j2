{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Seznam/simcse-dist-mpnet-czeng-cs-en") %}
{% set text_a = text_a | default("Dnes je výborné počasí na procházku po parku.") %}
{% set text_b = text_b | default("Večer si oblíbím dobrý film a uvařím si čaj.") %}
{% set max_length = max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_a = "{{ text_a }}"
text_b = "{{ text_b }}"
max_length = {{ max_length }}

from transformers import AutoModel, AutoTokenizer
import torch

model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(
    [text_a, text_b],
    padding=True,
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

embeddings = outputs.last_hidden_state[:, 0, :]
similarity = torch.nn.functional.cosine_similarity(embeddings[0:1], embeddings[1:2], dim=1)[0]

embeddings_cpu = embeddings.cpu()
similarity_value = similarity.cpu().item()

RESULT = {
    "embeddings": embeddings_cpu.tolist(),
    "similarity_score": similarity_value,
}
