{% set repo_id = repo_id | default("VMware/open-llama-7b-open-instruct") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you today?") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import AutoTokenizer, pipeline

tokenizer = AutoTokenizer.from_pretrained(model, use_fast=False)

pipe = pipeline(
    task=task,
    model=model,
    device=device,
    tokenizer=tokenizer,
)

RESULT = {"outputs": pipe(input_prompt)}
