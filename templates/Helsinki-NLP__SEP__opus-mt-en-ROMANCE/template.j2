{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-ROMANCE") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import MarianMTModel, MarianTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = MarianTokenizer(vocab=vocab_path, source_spm=source_spm_path, target_spm=target_spm_path, tokenizer_file=None)
model = MarianMTModel.from_pretrained(repo_id, config=config_path, state_dict=torch.load(weights_path, map_location="cpu"), local_files_only=True)
model.to(device)
model.eval()

forced_bos_token_id = tokenizer.lang_code_to_id.get("fr_FR", 65000) if hasattr(tokenizer, "lang_code_to_id") else 65000
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, forced_bos_token_id=forced_bos_token_id, max_length=128)

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
