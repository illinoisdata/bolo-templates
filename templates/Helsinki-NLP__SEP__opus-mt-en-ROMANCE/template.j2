{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-en-ROMANCE" %}
{% set text = "The quick brown fox jumps over the lazy dog." %}
{% set target_lang = "fr" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
target_lang = {{ target_lang | tojson }}
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import os

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)

input_text = f">>{target_lang}<< {text}"
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

outputs = model.generate(**inputs)
translation = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
