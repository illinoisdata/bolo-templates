{% set repo_id = repo_id | default("castorini/doc2query-t5-base-msmarco") %}
{% set device = device | default("cuda:0") %}
{% set doc_text = doc_text | default("Document expansion generates helpful queries to improve retrieval quality.") %}
{% set num_return_sequences = num_return_sequences | default(3) %}
{% set num_beams = num_beams | default(4) %}
{% set max_length = max_length | default(64) %}
{% set temperature = temperature | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
doc_text = "{{ doc_text }}"
num_return_sequences = {{ num_return_sequences }}
num_beams = {{ num_beams }}
max_length = {{ max_length }}
temperature = {{ temperature }}

import os
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(doc_text, return_tensors="pt", truncation=True, max_length=512)
for k, v in inputs.items():
    inputs[k] = v.to(device)

generated_tokens = model.generate(
    **inputs,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
    max_length=max_length,
    temperature=temperature,
    early_stopping=True,
)
generated_queries = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_queries": generated_queries}
