{% set repo_id = repo_id | default("tiiuae/falcon-mamba-7b-instruct-Q4_K_M-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("falcon-mamba-7B-instruct-Q4_K_M.gguf") %}
{% set prompt = prompt | default("Hello how are you?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if str(device).startswith("cuda") else 0,
    verbose=False,
)

out = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.9,
)
text = out["choices"][0]["text"]

RESULT = {"generated_text": text}
