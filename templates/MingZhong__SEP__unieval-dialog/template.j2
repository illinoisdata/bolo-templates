{% set repo_id = "MingZhong/unieval-dialog" %}
{% set device = "cuda:0" %}
{% set input_text = "Conversation: Hello, how are you? Response: I'm doing well." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/MingZhong__SEP__unieval-dialog" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
outputs = model.generate(**inputs)
evaluation = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]

RESULT = {"evaluation": evaluation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "evaluation.txt"), "w") as f:
        f.write(RESULT["evaluation"])