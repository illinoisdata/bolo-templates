{% set repo_id = repo_id | default("schmojo/evo2-exon-classifier") %}
{% set device = device | default("cuda:0") %}
{% set sequence = sequence | default('ACGTACGTACGTACGTACGT') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sequence = "{{ sequence }}"

import torch
from transformers import AutoConfig, AutoModel
import transformers.modeling_utils as modeling_utils
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

config = AutoConfig.from_pretrained(repo_id, trust_remote_code=True)
from transformers.modeling_utils import PreTrainedModel
if not hasattr(PreTrainedModel, "all_tied_weights_keys"):
    PreTrainedModel.all_tied_weights_keys = property(lambda self: {})
model = AutoModel.from_pretrained(
    repo_id,
    config=config,
    trust_remote_code=True,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=False,
)
model = model.to(device)
model.eval()


# Create a minimal embeddings tensor matching the model's expected interface.
seq_len = len(sequence)
inputs_embeds = torch.zeros((1, seq_len, config.embedding_dim), dtype=torch.float32, device=device)
with torch.no_grad():
    output = model(inputs_embeds=inputs_embeds)

if isinstance(output, torch.Tensor):
    output = output.detach().cpu().tolist()
elif hasattr(output, "detach"):
    output = output.detach().cpu().tolist()

RESULT = {"output": output}
