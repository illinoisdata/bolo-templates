{% set text = text | default("Le 0ctobre 1894, [START] Dreyfvs [END] est arrêté à Paris, accusé d'espionnage pour l'Allemagne — un événement qui déch1ra la société fr4nçaise pendant des années.") %}
{% set max_length = max_length | default(32) %}
{% set num_beams = num_beams | default(5) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("impresso-project/nel-mgenre-multilingual") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import sys
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM, pipeline

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

repo_dir = os.path.dirname(model_path)
script_path = hf_hub_download(repo_id=repo_id, filename="generic_nel.py")

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False, tokenizer_file=None)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

from importlib.util import spec_from_file_location, module_from_spec
spec = spec_from_file_location("generic_nel", script_path)
generic_nel = module_from_spec(spec)
spec.loader.exec_module(generic_nel)
NelPipeline = generic_nel.NelPipeline

nel_pipeline = NelPipeline(model=model, tokenizer=tokenizer, device=0 if str(device).startswith("cuda") else -1)
output = nel_pipeline(text, max_length=max_length, num_beams=num_beams)

RESULT = {"output": output}
