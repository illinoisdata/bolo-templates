{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("impresso-project/nel-mgenre-multilingual") %}
{% set input_strings = input_strings | default(["Le 0ctobre 1894, [START] Dreyfvs [END] est arrêté à Paris, accusé d'espionnage pour l'Allemagne — un événement qui déchira la société française pendant des années."]) %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_strings = {{ input_strings }}
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
import json
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

if isinstance(input_strings, str):
    input_strings = [input_strings]

encoded_inputs = tokenizer(
    input_strings,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(
    **encoded_inputs,
    max_new_tokens=max_new_tokens,
)

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
