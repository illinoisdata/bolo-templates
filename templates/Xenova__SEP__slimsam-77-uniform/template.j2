{% set repo_id = repo_id | default("Xenova/slimsam-77-uniform") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('a cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import numpy as np
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import SamModel, SamProcessor

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="onnx/vision_encoder.onnx")
_ = hf_hub_download(repo_id=repo_id, filename="onnx/prompt_encoder_mask_decoder.onnx")

if str(image_path).startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = SamProcessor.from_pretrained(repo_id)
model = SamModel.from_pretrained("nielsr/slimsam-77-uniform")
model.to(device)
model.eval()
inputs = processor(image, input_points=[[[[image.width // 2, image.height // 2]]]], input_labels=[[[1]]], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items() if hasattr(v, 'to')}
with torch.no_grad():
    outputs = model(**inputs)
mask = outputs.pred_masks[0, 0].detach().float().cpu().numpy()
RESULT = {"mask": mask, "text_prompt": text_prompt}
