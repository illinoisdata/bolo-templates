{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("facebook/mms-tts-eng") %}
{% set text = text | default("The quick brown fox jumps over the lazy dog.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from pathlib import Path

import torch
from scipy.io import wavfile
from transformers import AutoTokenizer, VitsModel

model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(text, return_tensors="pt")
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.inference_mode():
    model_output = model(**encoded_inputs)
waveform_tensor = model_output.waveform
waveform = waveform_tensor.squeeze(0).cpu().float().numpy()

RESULT = {
    "waveform": waveform,
    "sampling_rate": model.config.sampling_rate,
}
