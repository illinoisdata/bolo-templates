{% set repo_id = repo_id | default("facebook/mms-tts-eng") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("some example text in the English language") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, VitsModel
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")

model = VitsModel.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float32,
).to(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs).waveform

RESULT = {"waveform": waveform.detach().cpu(), "sampling_rate": model.config.sampling_rate}
