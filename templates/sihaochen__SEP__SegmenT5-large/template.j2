{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sihaochen/SegmenT5-large") %}
{% set input_sentence = input_sentence | default("Dracula is a novel by Bram Stoker featuring Count Dracula as the protagonist.") %}
{% set prompt_template = prompt_template | default("segment sentence: {}") %}
{% set sep_token = sep_token | default("[sep]") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set length_penalty = length_penalty | default(0) %}
{% set min_length = min_length | default(10) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(0) %}
{% set num_beams = num_beams | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sentence = {{ input_sentence | tojson }}
prompt_template = {{ prompt_template | tojson }}
sep_token = {{ sep_token | tojson }}
max_new_tokens = {{ max_new_tokens }}
length_penalty = {{ length_penalty }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

prompt = prompt_template.format(input_sentence)
encoding = tokenizer(
    prompt,
    return_tensors="pt",
    padding="max_length",
    max_length=512,
    truncation=True,
)
encoding = encoding.to(device)

generation_kwargs = {
    "max_new_tokens": max_new_tokens,
    "length_penalty": length_penalty,
    "min_length": min_length,
    "no_repeat_ngram_size": no_repeat_ngram_size,
    "num_beams": num_beams,
}

generated_ids = model.generate(**encoding, **generation_kwargs)
decoded_output = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
propositions = [
    segment.strip()
    for segment in decoded_output[0].split(sep_token)
    if segment.strip()
]

RESULT = {"propositions": propositions}
