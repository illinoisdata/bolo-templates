{% set repo_id = repo_id | default("MaziyarPanahi/Qwen3-1.7B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen3-1.7B.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short, friendly greeting.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(
    model_path=model_path,
    n_ctx=256,
    n_threads=1,
    n_gpu_layers=0,
    verbose=False,
)

result = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.95,
)

output_text = result["choices"][0]["text"]
RESULT = {"output": output_text}
