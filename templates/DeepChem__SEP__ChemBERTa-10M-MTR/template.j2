{% set text_input = "The molecule exhibits hydrogen bonding and interacts with solvents." %}
{% set max_length = 256 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/DeepChem__SEP__ChemBERTa-10M-MTR" %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text_input = {{ text_input | tojson }}
max_length = {{ max_length }}
output_dir = {{ output_dir | tojson }}
from transformers import AutoTokenizer, AutoModelForSequenceClassification
import torch
import os
import json

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model = model.to(device)
model.eval()
input_texts = text_input if isinstance(text_input, (list, tuple)) else [text_input]
encoded_inputs = tokenizer(
    input_texts,
    return_tensors="pt",
    truncation=True,
    padding=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}
with torch.no_grad():
    outputs = model(**encoded_inputs)
logits = outputs.logits
id2label = model.config.id2label or {}

def _label_name(index):
    return id2label.get(index) or id2label.get(str(index)) or f"label_{index}"

batch_predictions = []
for logits_per_example in logits:
    prediction = {
        _label_name(idx): float(value)
        for idx, value in enumerate(logits_per_example)
    }
    batch_predictions.append(prediction)

RESULT = {"predictions": batch_predictions}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    results_path = os.path.join(output_dir, "predictions.json")
    with open(results_path, "w") as results_file:
        json.dump(RESULT["predictions"], results_file, indent=2)