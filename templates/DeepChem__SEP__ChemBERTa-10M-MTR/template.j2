{% set repo_id = repo_id | default("DeepChem/ChemBERTa-10M-MTR") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('CCO') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

_tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
_model = AutoModelForSequenceClassification.from_pretrained(repo_id)
_model.to(device)
_model.eval()

inputs = _tokenizer(text_input, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = _model(**inputs)

logits = outputs.logits
predicted_index = int(torch.argmax(logits, dim=-1).item())
predicted_score = float(torch.max(logits, dim=-1).values.item())

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "predicted_index": predicted_index,
    "predicted_score": predicted_score,
}
