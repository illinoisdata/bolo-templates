{% set repo_id = repo_id | default("mlx-community/Qwen2.5-3B-Instruct-4bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello! Write a short friendly greeting.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id, trust_remote_code=True, device_map='cpu', low_cpu_mem_usage=True, ignore_mismatched_sizes=True)
inputs = tokenizer(prompt, return_tensors='pt').to('cpu')
output_ids = model.generate(**inputs, max_new_tokens=32, do_sample=False)
output = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output}
