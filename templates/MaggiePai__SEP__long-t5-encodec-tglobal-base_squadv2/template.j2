{% set repo_id = repo_id | default("MaggiePai/long-t5-encodec-tglobal-base_squadv2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the model repository name?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import json
import os
from pathlib import Path

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

with open(config_file, 'r') as f:
    cfg = json.load(f)
max_length = int(cfg.get('n_positions', 4096))
input_max_length = min(max_length, 4096)

model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    device_map=None,
    low_cpu_mem_usage=False,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

inputs = tokenizer(
    question,
    return_tensors='pt',
    truncation=True,
    max_length=input_max_length,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=1,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
