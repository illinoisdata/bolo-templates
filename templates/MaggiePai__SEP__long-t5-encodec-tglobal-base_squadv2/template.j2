{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("MaggiePai/long-t5-encodec-tglobal-base_squadv2") %}
{% set input_text = input_text | default("Context: The Eiffel Tower is located in Paris, France. Question: What is the capital city of France?") %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
primary_text = decoded_texts[0]

RESULT = {"generated_text": primary_text, "decoded_texts": decoded_texts}
