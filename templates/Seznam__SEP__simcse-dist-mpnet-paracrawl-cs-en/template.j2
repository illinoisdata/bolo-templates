{% set repo_id = "Seznam/simcse-dist-mpnet-paracrawl-cs-en" %}
{% set device = "cuda:0" %}
{% set sentence_a = "Dnes je výborné počasí na procházku po parku." %}
{% set sentence_b = "Večer si oblíbím dobrý film a uvařím si čaj." %}
{% set max_length = 512 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence_a = "{{ sentence_a }}"
sentence_b = "{{ sentence_b }}"
max_length = {{ max_length }}

from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(torch_device)
model.eval()

text_inputs = [sentence_a, sentence_b]
encoded_input = tokenizer(
    text_inputs,
    padding=True,
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
encoded_input = {key: value.to(torch_device) for key, value in encoded_input.items()}

with torch.no_grad():
    outputs = model(**encoded_input)

embeddings = outputs.last_hidden_state[:, 0]
similarity = torch.nn.functional.cosine_similarity(embeddings[0], embeddings[1], dim=0)
similarity_score = similarity.item()

RESULT = {"similarity_score": similarity_score}
