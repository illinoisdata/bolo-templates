repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
audio_path2 = "{{ audio_path2 }}"
max_size = {{ max_size }}

import tempfile
from pathlib import Path
from urllib.parse import urlparse

import numpy as np
import torch
import soundfile as sf
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2FeatureExtractor, WavLMModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
repo_dir = str(Path(config_path).parent)

feature_extractor = Wav2Vec2FeatureExtractor(
    feature_size=1,
    sampling_rate=16000,
    padding_value=0.0,
    do_normalize=True,
    return_attention_mask=True,
)
model = WavLMModel.from_pretrained(repo_dir, local_files_only=True).to(device)
model.eval()


def load_audio(path_or_url):
    if isinstance(path_or_url, str) and path_or_url.startswith(("http://", "https://")):
        import requests
        r = requests.get(path_or_url, timeout=30)
        r.raise_for_status()
        suffix = Path(urlparse(path_or_url).path).suffix or ".wav"
        with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as f:
            f.write(r.content)
            local_path = f.name
        wav, sr = sf.read(local_path)
    else:
        wav, sr = sf.read(path_or_url)
    if wav.ndim > 1:
        wav = wav.mean(axis=1)
    if sr != 16000:
        import librosa
        wav = librosa.resample(wav.astype(np.float32), orig_sr=sr, target_sr=16000)
        sr = 16000
    return wav.astype(np.float32), sr


def compute_embedding(path_or_url):
    wav, sr = load_audio(path_or_url)
    inputs = feature_extractor(wav, sampling_rate=sr, return_tensors="pt", padding=True)
    input_values = inputs.input_values.to(device)
    attention_mask = inputs.attention_mask.to(device) if inputs.attention_mask is not None else None
    with torch.no_grad():
        outputs = model(input_values, attention_mask=attention_mask, output_hidden_states=True, return_dict=True)
        hidden = outputs.last_hidden_state
        emb = hidden.mean(dim=1)
        emb = torch.nn.functional.normalize(emb, p=2, dim=-1)
    return emb

embedding1 = compute_embedding(audio_path)
embedding2 = compute_embedding(audio_path2)
similarity = float(torch.matmul(embedding1, embedding2.t()).item())

RESULT = {"embedding1": embedding1.detach().cpu().numpy(), "embedding2": embedding2.detach().cpu().numpy(), "cosine_similarity": similarity}
