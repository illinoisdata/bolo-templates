{% set repo_id = "Helsinki-NLP/opus-mt-fr-ro" %}
{% set device = "cuda:0" %}
{% set input_text = input_text | default("Bonjour, comment allez-vous aujourd'hui ?") -%}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import torch
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

if isinstance(input_text, (list, tuple)):
    texts = list(input_text)
else:
    texts = [input_text]
encoded_inputs = tokenizer(
    texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**encoded_inputs)

translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
if isinstance(input_text, (list, tuple)):
    translation_result = translations
else:
    translation_result = translations[0]

RESULT = {"translated_text": translation_result}
