{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("chentong00/propositionizer-wiki-flan-t5-large") %}
{% set title = title | default("Leaning Tower of Pisa") %}
{% set section = section | default("") %}
{% set content = content | default("Prior to restoration work performed between 1990 and 2001, Leaning Tower of Pisa leaned at an angle of 5.5 degrees, but the tower now leans at about 3.99 degrees. This means the top of the tower is displaced horizontally 3.9 meters (12 ft 10 in) from the center.") %}
{% set max_new_tokens = max_new_tokens | default(512) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
title = {{ title | tojson }}
section = {{ section | tojson }}
content = {{ content | tojson }}
max_new_tokens = {{ max_new_tokens }}

import json
import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

prompt = f"Title: {title}. Section: {section}. Content: {content}"
encoding = tokenizer(prompt, return_tensors="pt")
input_ids = encoding.input_ids.to(device)
attention_mask = encoding.attention_mask.to(device)

generated_ids = model.generate(input_ids, attention_mask=attention_mask, max_new_tokens=max_new_tokens)
generated_ids = generated_ids.cpu()

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
propositions = json.loads(generated_text)

RESULT = {"propositions": propositions}
