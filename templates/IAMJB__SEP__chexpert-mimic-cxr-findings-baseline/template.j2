{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(2) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
import requests
from PIL import Image
from transformers import BertTokenizer, ViTImageProcessor, VisionEncoderDecoderModel, GenerationConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
gen_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB") if str(image_path).startswith(("http://", "https://")) else Image.open(image_path).convert("RGB")

model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(device).eval()
tokenizer = BertTokenizer.from_pretrained(repo_id)
image_processor = ViTImageProcessor.from_pretrained(repo_id)

pixel_values = image_processor(images=image, return_tensors="pt").pixel_values.to(device)

generation_config = GenerationConfig.from_pretrained(repo_id)
generation_config.max_length = max_length
generation_config.num_beams = num_beams
generation_config.decoder_start_token_id = model.config.decoder_start_token_id

generated_ids = model.generate(pixel_values=pixel_values, generation_config=generation_config)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": output_text}
