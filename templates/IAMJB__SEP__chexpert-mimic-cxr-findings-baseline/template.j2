{% set device = "cuda:0" %}
{% set repo_id = "IAMJB/chexpert-mimic-cxr-findings-baseline" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set generation_max_length = 128 %}
{% set generation_num_beams = 2 %}
{% set generation_num_return_sequences = 1 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
generation_max_length = {{ generation_max_length }}
generation_num_beams = {{ generation_num_beams }}
generation_num_return_sequences = {{ generation_num_return_sequences }}

import os
from PIL import Image
import requests
import torch
from transformers import BertTokenizer, GenerationConfig, ViTImageProcessor, VisionEncoderDecoderModel

torch_device = torch.device(device)

model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model = model.to(torch_device)
model.eval()

tokenizer = BertTokenizer.from_pretrained(repo_id)
image_processor = ViTImageProcessor.from_pretrained(repo_id)

if image_path.startswith("http://") or image_path.startswith("https://"):
    raw_image = Image.open(requests.get(image_path, stream=True).raw)
else:
    raw_image = Image.open(image_path)

image = raw_image.convert("RGB")
pixel_values = image_processor(image, return_tensors="pt").pixel_values.to(torch_device)

generation_config = GenerationConfig(
    max_length=generation_max_length,
    num_beams=generation_num_beams,
    num_return_sequences=generation_num_return_sequences,
    use_cache=True,
    decoder_start_token_id=tokenizer.cls_token_id,
)

with torch.no_grad():
    generated_ids = model.generate(
        pixel_values,
        generation_config=generation_config,
    )

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"findings": generated_texts}
