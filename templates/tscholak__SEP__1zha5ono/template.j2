{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("tscholak/1zha5ono") %}
{% set text_input = text_input | default("How many singers do we have? | concert_singer | stadium : stadium_id, location, name, capacity, highest, lowest, average | singer : singer_id, name, country, song_name, song_release_year, age, is_male | concert : concert_id, concert_name, theme, stadium_id, year | singer_in_concert : concert_id, singer_id") %}
{% set num_beams = num_beams | default(4) %}
{% set max_length = max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
)
generated_sql = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_sql": generated_sql}
