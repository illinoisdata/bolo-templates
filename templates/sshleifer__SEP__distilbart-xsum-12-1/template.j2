{% set repo_id = repo_id | default("sshleifer/distilbart-xsum-12-1") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The Eiffel Tower is located in Paris and is one of the most famous landmarks in the world.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
outputs = model.generate(**inputs)

summary = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]
RESULT = {"summary_text": summary}
