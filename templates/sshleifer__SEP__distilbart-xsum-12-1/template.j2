{% set repo_id = repo_id | default("sshleifer/distilbart-xsum-12-1") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('The quick brown fox jumps over the lazy dog. Artificial intelligence is transforming many industries, from healthcare to finance. Researchers are also exploring its limitations and risks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import AutoTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
# tokenizer files
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Pre-process input & load model

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = BartForConditionalGeneration.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=6,
        max_length=62,
        min_length=11,
        no_repeat_ngram_size=3,
        length_penalty=0.5,
        early_stopping=True,
    )
summary_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

# Post-process & build RESULT dict
RESULT = {"summary_text": summary_text}
