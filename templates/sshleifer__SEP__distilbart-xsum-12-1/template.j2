{% set repo_id = "sshleifer/distilbart-xsum-12-1" %}
{% set device = "cuda:0" %}
{% set input_text = "The Eiffel Tower is located in Paris and is one of the most famous landmarks in the world." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
outputs = model.generate(**inputs)

summary = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]
RESULT = {"summary_text": summary}
