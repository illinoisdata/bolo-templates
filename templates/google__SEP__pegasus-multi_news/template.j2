{% set repo_id = repo_id | default("google/pegasus-multi_news") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('The Senate passed a bill after hours of debate. Meanwhile, markets reacted cautiously to inflation data. Analysts said the decision could shape policy in the coming months.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import PegasusTokenizer, PegasusForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

model = PegasusForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()
tokenizer = PegasusTokenizer.from_pretrained(repo_id, use_fast=False)

inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=256,
        min_length=32,
        num_beams=8,
        length_penalty=0.8,
        early_stopping=True,
    )

summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
