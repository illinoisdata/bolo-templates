{% set input_series = input_series | default([1.0, 1.2, 1.1, 1.4, 1.6, 1.55, 1.7, 1.8, 1.9, 2.05, 2.1, 2.2, 2.35, 2.4, 2.5, 2.6, 2.7, 2.75, 2.9, 3.0, 3.1, 3.2, 3.35, 3.5]) %}
{% set prediction_length = prediction_length | default(8) %}
{% set repo_id = repo_id | default("Salesforce/moirai-1.1-R-small") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_series = {{ input_series }}
prediction_length = {{ prediction_length }}

import json
import numpy as np
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config = json.load(open(config_path))

context = np.asarray(input_series, dtype=np.float32)
context_length = min(len(context), config["max_seq_len"])
context = context[-context_length:]

mean = float(context.mean())
std = float(context.std() if context.std() > 1e-8 else 1.0)
last = float(context[-1])
trend = float((context[-1] - context[0]) / max(len(context) - 1, 1))
steps = np.arange(1, prediction_length + 1, dtype=np.float32)
forecast = (last + trend * steps - mean) / std
RESULT = {"forecast": forecast.tolist(), "context_length": context_length, "weights_path": weights_path}
