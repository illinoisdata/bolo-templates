{% set device = "cuda:0" %}
{% set repo_id = "valhalla/t5-small-qa-qg-hl" %}
{% set input_text = "generate question:  42  is the answer to life, the universe and everything. " %}
{% set max_new_tokens = 64 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

tokenized_inputs = tokenizer(input_text, return_tensors="pt")
tokenized_inputs = {key: value.to(torch_device) for key, value in tokenized_inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**tokenized_inputs, max_new_tokens=max_new_tokens)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
