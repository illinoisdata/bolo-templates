{% set prompt = prompt | default('What is the range of the numeric output of a sigmoid node in a neural network?') %}
{% set response1 = response1 | default('The output of a sigmoid node is bounded between -1 and 1.') %}
{% set response2 = response2 | default('The output of a sigmoid node is bounded between 0 and 1.') %}
{% set repo_id = repo_id | default("LxzGordon/URM-LLaMa-3.1-8B") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
response1 = "{{ response1 }}"
response2 = "{{ response2 }}"

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
modeling_path = hf_hub_download(repo_id=repo_id, filename="modeling_custom.py")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

model = AutoModelForSequenceClassification.from_pretrained(
    repo_id,
    trust_remote_code=True,
    torch_dtype=torch.float16,
    device_map=None,
)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

resp1_messages = [{"role": "user", "content": prompt}, {"role": "assistant", "content": response1}]
resp2_messages = [{"role": "user", "content": prompt}, {"role": "assistant", "content": response2}]
resp1_text = tokenizer.apply_chat_template(resp1_messages, tokenize=False)
resp2_text = tokenizer.apply_chat_template(resp2_messages, tokenize=False)
resp1_inputs = tokenizer(resp1_text, return_tensors="pt").to(device)
resp2_inputs = tokenizer(resp2_text, return_tensors="pt").to(device)

with torch.no_grad():
    score1 = model(resp1_inputs["input_ids"], attention_mask=resp1_inputs["attention_mask"]).logits[0][0].item()
    score2 = model(resp2_inputs["input_ids"], attention_mask=resp2_inputs["attention_mask"]).logits[0][0].item()

RESULT = {"score1": score1, "score2": score2}
