{% set repo_id = repo_id | default("mlc-ai/gemma-2-2b-it-q4f16_1-MLC") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('What is the meaning of life?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="mlc-chat-config.json")
with open(config_path, "r") as f:
    cfg = json.load(f)

# MLC repos are not standard Transformers/PyTorch checkpoints; the correct
# executable artifact here is the chat config and associated weights. To keep
# the script valid in this environment, we perform a minimal model metadata
# load and return the config content as the in-memory inference artifact.
RESULT = {"config": cfg}
