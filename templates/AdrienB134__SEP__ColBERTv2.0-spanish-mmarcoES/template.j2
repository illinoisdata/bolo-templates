{% set query = query | default('¿Cuál es la capital de España?') %}
{% set passage = passage | default('Madrid es la capital y la ciudad más poblada de España.') %}
{% set max_length = max_length | default(128) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("AdrienB134/ColBERTv2.0-spanish-mmarcoES") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = {{ query | tojson }}
passage = {{ passage | tojson }}
max_length = {{ max_length }}

import os
import torch
from transformers import AutoTokenizer, AutoModel, AutoConfig
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

repo_dir = os.path.dirname(config_path)
tokenizer_dir = os.path.dirname(tokenizer_config_path)
config = AutoConfig.from_pretrained(repo_dir)
tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=True)
model = AutoModel.from_pretrained(repo_dir, torch_dtype=torch.float32)
model = model.to(device)
model.eval()

def encode(text):
    inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=max_length)
    return {k: v.to(device) for k, v in inputs.items()}

query_inputs = encode(query)
passage_inputs = encode(passage)

with torch.no_grad():
    query_outputs = model(**query_inputs)
    passage_outputs = model(**passage_inputs)

query_cls = query_outputs.last_hidden_state[:, 0, :]
passage_cls = passage_outputs.last_hidden_state[:, 0, :]
similarity = torch.nn.functional.cosine_similarity(query_cls, passage_cls).item()

RESULT = {"similarity": similarity}
