{% set device = "cuda:0" %}
{% set repo_id = "Kyle1668/imdb-t5-large" %}
{% set input_text = 'The movie was fantastic and had a thrilling plot.' %}
{% set prefix = 'summarize: ' %}
{% set max_length = 200 %}
{% set min_length = 30 %}
{% set length_penalty = 2.0 %}
{% set num_beams = 4 %}
{% set no_repeat_ngram_size = 3 %}
{% set early_stopping = True %}

repo_id = '{{ repo_id }}'
device = '{{ device }}'
input_text = '{{ input_text }}'
prefix = '{{ prefix }}'
max_length = {{ max_length }}
min_length = {{ min_length }}
length_penalty = {{ length_penalty }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

text = prefix + input_text
inputs = tokenizer(text, return_tensors='pt').to(device)
outputs = model.generate(**inputs, max_length=max_length, min_length=min_length, length_penalty=length_penalty, no_repeat_ngram_size=no_repeat_ngram_size, num_beams=num_beams, early_stopping=early_stopping)
decoded = tokenizer.batch_decode(outputs, skip_special_tokens=True)
summary_text = decoded[0]

RESULT = {'summary_text': summary_text}
