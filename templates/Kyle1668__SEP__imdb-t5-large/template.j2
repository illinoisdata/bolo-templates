{% set repo_id = repo_id | default("Kyle1668/imdb-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('summarize: An overwhelmingly positive review with vivid praise and detailed appreciation of the film’s acting, direction, pacing, and emotional impact.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

_ = config_path
_ = tokenizer_config_path
_ = special_tokens_map_path
_ = spiece_path
_ = generation_config_path

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_new_tokens=64,
        num_beams=4,
        early_stopping=True,
        no_repeat_ngram_size=3,
        length_penalty=2.0,
    )

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]
RESULT = {"text": decoded}
