{% set repo_id = repo_id | default("unsloth/llama-3-8b-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.6) %}
{% set top_p = top_p | default(0.9) %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}
temperature = {{ temperature | tojson }}
top_p = {{ top_p | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
inputs = input_prompt
outputs = pipe(
    inputs,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    top_p=top_p,
)
RESULT = {"outputs": outputs}
