{% set repo_id = repo_id | default("facebook/deformable-detr-box-supervised") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("object-detection") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set dilation_override = dilation_override | default(False) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
dilation_override = {{ dilation_override }}

from transformers import (
    DeformableDetrConfig,
    DeformableDetrForObjectDetection,
    AutoImageProcessor,
    pipeline,
)
from huggingface_hub import hf_hub_download
import json as _json
import torch

# Load and patch config to override invalid 'dilation' field
_config_file = hf_hub_download(repo_id, filename="config.json")
_config_dict = _json.load(open(_config_file, "r"))
_config_dict["dilation"] = dilation_override
config = DeformableDetrConfig.from_dict(_config_dict)

# Load model and processor
model = DeformableDetrForObjectDetection.from_pretrained(repo_id, config=config)
model.to(device)
processor = AutoImageProcessor.from_pretrained(repo_id)

# Create pipeline with the patched model
pipe = pipeline(task=task, model=model, feature_extractor=processor, device=device)
RESULT = pipe(input_image)
