{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set repo_id = repo_id | default("maurice-fp/ModelReuse-pretrain.resnet18.imagenet-1k-transfer.Flower102.0_1") %}
{% set device = device | default("cuda:0") %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
from PIL import Image
from huggingface_hub import hf_hub_download
import torch
from safetensors.torch import load_file
from timm import create_model
from timm.data import resolve_data_config, create_transform

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    cfg = json.load(f)

if image_path.startswith(("http://", "https://")):
    raise ValueError("image_path must be a local file path for this validation run")
image = Image.open(image_path).convert("RGB")

model = create_model(
    cfg["architecture"],
    pretrained=False,
    num_classes=cfg["num_classes"],
)
state_dict = load_file(weights_path, device="cpu")
model.load_state_dict(state_dict)
model.eval()
model.to(device)

pretrained_cfg = cfg.get("pretrained_cfg", {})
data_cfg = resolve_data_config(
    {
        "input_size": tuple(pretrained_cfg.get("input_size", [3, 224, 224])),
        "mean": tuple(pretrained_cfg.get("mean", [0.485, 0.456, 0.406])),
        "std": tuple(pretrained_cfg.get("std", [0.229, 0.224, 0.225])),
        "interpolation": "bilinear",
        "crop_pct": 1.0,
    },
    model=model,
)
transform = create_transform(**data_cfg, is_training=False)
input_tensor = transform(image).unsqueeze(0).to(device)

with torch.no_grad():
    logits = model(input_tensor)
    probs = torch.softmax(logits, dim=-1)[0]
    values, indices = torch.topk(probs, k=min(topk, probs.shape[-1]))

RESULT = {
    "logits": logits.detach().cpu(),
    "probs_topk": values.detach().cpu(),
    "indices_topk": indices.detach().cpu(),
}
