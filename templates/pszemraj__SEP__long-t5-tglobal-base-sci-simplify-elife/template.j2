{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "large earthquakes along a given fault segment do not occur at random intervals because it takes time to accumulate the strain energy for the rupture. The rates at which tectonic plates move and accumulate strain at their boundaries are approximately uniform. Therefore, in first approximation, one may expect that large ruptures of the same fault segment will occur at approximately constant time intervals." %}
{% set max_length = 64 %}
{% set min_length = 8 %}
{% set no_repeat_ngram_size = 3 %}
{% set early_stopping = true %}
{% set repetition_penalty = 3.5 %}
{% set encoder_no_repeat_ngram_size = 4 %}
{% set length_penalty = 0.4 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/pszemraj__SEP__long-t5-tglobal-base-sci-simplify-elife" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}
repetition_penalty = {{ repetition_penalty }}
encoder_no_repeat_ngram_size = {{ encoder_no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_ids = model.generate(
    inputs["input_ids"],
    attention_mask=inputs["attention_mask"],
    max_length=max_length,
    min_length=min_length,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
    repetition_penalty=repetition_penalty,
    encoder_no_repeat_ngram_size=encoder_no_repeat_ngram_size,
    length_penalty=length_penalty,
    num_beams=num_beams,
)

summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary_text": summary}

if __name__ == "__main__":
    directory = Path(output_dir)
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "summary_text.txt").write_text(RESULT["summary_text"], encoding="utf-8")