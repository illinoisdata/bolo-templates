{% set sentence1 = sentence1 | default('Earth observation satellites provide valuable data for climate monitoring.') %}
{% set sentence2 = sentence2 | default('Satellite imagery can help track changes in global weather patterns.') %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("nasa-impact/indus-sde-st-v0.2") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = "{{ sentence1 }}"
sentence2 = "{{ sentence2 }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")

os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_file), use_fast=True)
model = AutoModel.from_pretrained(repo_id, torch_dtype=torch.bfloat16 if torch.cuda.is_available() and "cuda" in device else None)
model.to(device)
model.eval()

inputs = tokenizer([sentence1, sentence2], padding=True, truncation=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden = outputs.last_hidden_state.float()
    attention_mask = inputs["attention_mask"].unsqueeze(-1).float()
    masked = last_hidden * attention_mask
    embeddings = masked.sum(dim=1) / attention_mask.sum(dim=1).clamp(min=1)
    embeddings = torch.nn.functional.normalize(embeddings, p=2, dim=1)
    similarity = torch.nn.functional.cosine_similarity(embeddings[0], embeddings[1], dim=0)

RESULT = {
    "embeddings": embeddings.detach().cpu().numpy(),
    "similarity": similarity.detach().cpu().item(),
}
