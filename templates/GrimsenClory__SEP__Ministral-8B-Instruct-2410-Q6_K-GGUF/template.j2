{% set repo_id = repo_id | default("GrimsenClory/Ministral-8B-Instruct-2410-Q6_K-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("ministral-8b-instruct-2410-q6_k.gguf") %}
{% set prompt = prompt | default("The meaning to life and the universe is") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    verbose=False,
)

result = llm(prompt, max_tokens=64, stop=["</s>", "<|im_end|>"])
output_text = result["choices"][0]["text"]

RESULT = {"text": output_text}
