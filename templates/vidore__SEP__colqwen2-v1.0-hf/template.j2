{% set repo_id = "vidore/colqwen2-v1.0-hf" %}
{% set device = "cuda:0" %}
{% set image1_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set image2_path = "/u/yli77/projects/ML-code-generation/data/image2.jpeg" %}
{% set queries = ["When was the United States Declaration of Independence proclaimed?", "Who printed the edition of Romeo and Juliet?"] %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image1_path = "{{ image1_path }}"
image2_path = "{{ image2_path }}"
queries = {{ queries }}

import json
from pathlib import Path

import requests
import torch
from PIL import Image
from transformers import ColQwen2ForRetrieval, ColQwen2Processor

device = torch.device(device)

processor = ColQwen2Processor.from_pretrained(repo_id)
model = ColQwen2ForRetrieval.from_pretrained(repo_id)
model = model.to(device)
model.eval()

def _load_image(path: str) -> Image.Image:
    normalized = path.strip()
    if normalized.lower().startswith(("http://", "https://")):
        response = requests.get(normalized, stream=True)
        response.raise_for_status()
        return Image.open(response.raw).convert("RGB")
    return Image.open(normalized).convert("RGB")

image_paths = [image1_path, image2_path]
images = [_load_image(path) for path in image_paths]

inputs_images = processor(images=images, return_tensors="pt").to(device)
inputs_queries = processor(text=queries, return_tensors="pt").to(device)

with torch.no_grad():
    image_embeddings = model(**inputs_images).embeddings
    query_embeddings = model(**inputs_queries).embeddings
    scores = processor.score_retrieval(query_embeddings, image_embeddings)

retrieval_scores = scores.detach().cpu().tolist()
RESULT = {"retrieval_scores": retrieval_scores}
