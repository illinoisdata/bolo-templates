{% set repo_id = repo_id | default("vidore/colqwen2-v1.0-hf") %}
{% set device = device | default("cuda:0") %}
{% set queries = queries | default(["When was the United States Declaration of Independence proclaimed?", "Who printed the edition of Romeo and Juliet?"]) %}
{% set image_paths = image_paths | default(["/u/yunqili4/projects/ML-code-generation/data/image1.jpeg", "/u/yunqili4/projects/ML-code-generation/data/image2.jpeg"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
queries = {{ queries }}
image_paths = {{ image_paths }}

import os
import requests
import torch
from PIL import Image
from transformers import ColQwen2ForRetrieval, ColQwen2Processor
from transformers.utils.import_utils import is_flash_attn_2_available
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

def load_image(path_or_url):
    if isinstance(path_or_url, str) and path_or_url.startswith(("http://", "https://")):
        return Image.open(requests.get(path_or_url, stream=True).raw).convert("RGB")
    return Image.open(path_or_url).convert("RGB")

images = [load_image(p) for p in image_paths]

processor = ColQwen2Processor.from_pretrained(repo_id)
model = ColQwen2ForRetrieval.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    attn_implementation="flash_attention_2" if is_flash_attn_2_available() else "sdpa",
)
model = model.to(device)
model.eval()

inputs_images = processor(images=images).to(device)
inputs_text = processor(text=queries).to(device)

with torch.no_grad():
    image_embeddings = model(**inputs_images).embeddings
    query_embeddings = model(**inputs_text).embeddings
    scores = processor.score_retrieval(query_embeddings, image_embeddings)

RESULT = {"scores": scores}
