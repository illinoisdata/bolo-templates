{% set repo_id = repo_id | default("facebook/vit-mae-huge") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set mask_ratio = mask_ratio | default(0.75) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
mask_ratio = {{ mask_ratio }}

import os
import requests
from PIL import Image
import torch
from transformers import AutoImageProcessor, ViTMAEForPreTraining
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

if image.startswith("http://") or image.startswith("https://"):
    image_obj = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

processor = AutoImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = ViTMAEForPreTraining.from_pretrained(os.path.dirname(weights_path))
model = model.to(device)
model.eval()

inputs = processor(images=image_obj, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs, mask_ratio=mask_ratio)

RESULT = {
    "loss": outputs.loss,
    "mask": outputs.mask,
    "ids_restore": outputs.ids_restore,
}
