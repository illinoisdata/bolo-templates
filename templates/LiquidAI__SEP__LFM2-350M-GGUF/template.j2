{% set repo_id = repo_id | default("LiquidAI/LFM2-350M-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('LFM2-350M-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short haiku about edge AI.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=4,
    n_gpu_layers=0,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.95,
    stop=["</s>"],
)

RESULT = {"text": output["choices"][0]["text"]}
