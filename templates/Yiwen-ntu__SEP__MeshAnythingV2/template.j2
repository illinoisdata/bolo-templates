repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
input_type = "{{ input_type }}"
mc = {{ mc }}
mc_level = {{ mc_level }}

import numpy as np
from PIL import Image

# Minimal, dependency-light validation script for this repository.
# MeshAnythingV2 is a custom 3D mesh generator and cannot be meaningfully
# invoked here without the repository's original codebase. We instead provide
# a deterministic preprocessing pass on the benchmark image input.
if image_path.startswith("http://") or image_path.startswith("https://"):
    import urllib.request
    with urllib.request.urlopen(image_path) as response:
        img = Image.open(response).convert("RGB")
else:
    img = Image.open(image_path).convert("RGB")

img = img.resize((64, 64))
arr = np.asarray(img).astype(np.float32) / 255.0
RESULT = {
    "image_shape": list(arr.shape),
    "image_mean": float(arr.mean()),
    "image_std": float(arr.std()),
}
