{% set repo_id = repo_id | default("sociocom/MedNER-CR-JA") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set tokenizer = tokenizer | default("cl-tohoku/bert-base-japanese-whole-word-masking") %}
{% set input_prompt = input_prompt | default("肥大型心筋症、心房細動に対してＷＦ投与が開始となった。\n治療経過中に非持続性心室頻拍が認められたためアミオダロンが併用となった。") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
tokenizer = {{ tokenizer | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt)
