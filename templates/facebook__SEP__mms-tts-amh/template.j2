{% set text = "some example text in the Amharic language" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mms-tts-amh" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import VitsModel, AutoTokenizer
import scipy.io.wavfile as wavfile

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input (the text should be romanized using an external tool such as uroman)
inputs = tokenizer(text, return_tensors="pt").to(device)

# Run inference
with torch.no_grad():
    output = model(**inputs).waveform

# Post-process & build RESULT dict
waveform = output[0].cpu().numpy()
RESULT = {
    "waveform": waveform,
    "sampling_rate": model.config.sampling_rate,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    wavfile.write(os.path.join(output_dir, "output.wav"), RESULT["sampling_rate"], RESULT["waveform"])