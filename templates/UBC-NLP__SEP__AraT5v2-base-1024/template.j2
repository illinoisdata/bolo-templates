{% set repo_id = repo_id | default("UBC-NLP/AraT5v2-base-1024") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('عاصمة ألمانيا هي <extra_id_0>') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import T5Tokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    local_files_only=True,
)
model.to(device)
model.eval()

tokenizer = T5Tokenizer(vocab_file=spiece_path)

inputs = tokenizer(prompt, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

with torch.no_grad():
    output_ids = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        max_new_tokens=16,
    )

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {
    "prompt": prompt,
    "generated_text": output_text,
}
