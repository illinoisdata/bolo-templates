{% set repo_id = repo_id | default("dmis-lab/bern2-ner") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Aspirin inhibits cyclooxygenase and is used to treat pain and inflammation.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, RobertaConfig, RobertaModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
labels_path = hf_hub_download(repo_id=repo_id, filename="labels.txt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

config = RobertaConfig.from_json_file(config_path)
model = RobertaModel(config)
state_dict = torch.load(model_path, map_location="cpu", weights_only=False)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
with open(labels_path, "r") as f:
    labels = [line.strip() for line in f if line.strip()]

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {"last_hidden_state_shape": list(outputs.last_hidden_state.shape), "labels": labels}
