{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("OpenVINO/bert-base-uncased-sst2-unstructured80-int8-ov") %}
{% set input_text = input_text | default("The movie was absolutely wonderful and the performances were brilliant.") %}
{% set top_k = top_k | default(2) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
top_k = {{ top_k }}

import json
import os

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded_inputs = tokenizer(
    input_text,
    truncation=True,
    padding=True,
    return_tensors="pt",
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

logits = outputs.logits
probabilities = torch.softmax(logits, dim=-1)
logits = logits.cpu()
probabilities = probabilities.cpu()
num_labels = logits.size(-1)
topk = min(max(1, top_k), num_labels)
scores, indices = torch.topk(probabilities, k=topk, dim=-1)
label_mapping = model.config.id2label
top_k_predictions = []
for score, index in zip(scores[0], indices[0]):
    idx_value = int(index.item())
    label = label_mapping.get(str(idx_value), label_mapping.get(idx_value, str(idx_value)))
    top_k_predictions.append(
        {"label": label, "score": score.item()}
    )

RESULT = {
    "logits": logits.tolist(),
    "probabilities": probabilities.tolist(),
    "top_k_predictions": top_k_predictions,
}
