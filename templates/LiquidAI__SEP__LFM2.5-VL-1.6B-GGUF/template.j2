{% set repo_id = repo_id | default("LiquidAI/LFM2.5-VL-1.6B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('LFM2.5-VL-1.6B-Q4_0.gguf') %}
{% set mmproj_filename = mmproj_filename | default('mmproj-LFM2.5-VL-1.6b-Q8_0.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe this image in detail.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
mmproj_filename = "{{ mmproj_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from PIL import Image
import requests
from io import BytesIO
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id, filename=mmproj_filename)

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

llm = Llama(
    model_path=weights_path,
    mmproj_path=mmproj_path,
    n_ctx=4096,
    n_gpu_layers=0,
    verbose=False,
)

messages = [
    {"role": "user", "content": [{"type": "image_url", "image_url": {"url": image_path}}, {"type": "text", "text": prompt}]},
]

output = llm.create_chat_completion(
    messages=messages,
    temperature=0.2,
    top_p=0.95,
)

RESULT = {"output": output}
