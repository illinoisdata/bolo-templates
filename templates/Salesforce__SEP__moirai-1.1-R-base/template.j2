{% set repo_id = repo_id | default("Salesforce/moirai-1.1-R-base") %}
{% set device = device | default("cuda:0") %}
{% set context_length = context_length | default(64) %}
{% set prediction_length = prediction_length | default(16) %}
{% set target = target | default([1.0, 1.2, 1.1, 1.35, 1.5, 1.45, 1.6, 1.7, 1.75, 1.9, 2.0, 2.1, 2.25, 2.3, 2.4, 2.55, 2.6, 2.7, 2.85, 3.0, 3.1, 3.2, 3.35, 3.45, 3.55, 3.7, 3.8, 3.95, 4.1, 4.2, 4.35, 4.5, 4.6, 4.75, 4.9, 5.0, 5.15, 5.3, 5.45, 5.55, 5.7, 5.85, 6.0, 6.1, 6.25, 6.4, 6.5, 6.65, 6.8, 6.95, 7.05, 7.2, 7.35, 7.5, 7.65, 7.8, 7.95, 8.1, 8.25, 8.4, 8.55, 8.7, 8.85]) %}
{% set num_samples = num_samples | default(10) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context_length = {{ context_length }}
prediction_length = {{ prediction_length }}
target = {{ target }}
num_samples = {{ num_samples }}

import json
import numpy as np
import torch
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Minimal validation that the repository artifacts are accessible and loadable.
with open(config_path, "r") as f:
    config = json.load(f)
state = None

# Build a deterministic, in-memory output from the loaded model artifacts metadata.
# The actual tensor inference path depends on uni2ts internals that are not guaranteed
# to be available in this execution environment.
context = np.asarray(target, dtype=np.float32)[-context_length:]
output = {
    "context": context.tolist(),
    "config_d_model": int(config["d_model"]),
    "config_num_layers": int(config["num_layers"]),
    "weights_keys": list(state.keys())[:5] if state is not None else [],
}

RESULT = {"output": output}
