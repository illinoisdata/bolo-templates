{% set repo_id = "dmis-lab/biobert-large-cased-v1.1" %}
{% set device = "cuda:0" %}
{% set input_text = "BioBERT has demonstrated strong performance on biomedical <mask> tasks." %}
{% set top_k = 5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
top_k = {{ top_k }}

import json
import os
from pathlib import Path

import torch
import torch.nn.functional as F
from transformers import BertForMaskedLM, BertTokenizer

tokenizer = BertTokenizer.from_pretrained(repo_id)
model = BertForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

raw_inputs = tokenizer(input_text, return_tensors="pt")
mask_token_id = tokenizer.mask_token_id
mask_indices = (
    raw_inputs["input_ids"] == mask_token_id
).nonzero(as_tuple=False) if mask_token_id is not None else torch.empty(0, 2, dtype=torch.long)

inputs = {key: value.to(device) for key, value in raw_inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits

mask_predictions = []
if mask_indices.numel() > 0:
    for position in mask_indices.tolist():
        batch_index, token_index = position
        logits_for_token = logits[batch_index, token_index]
        probabilities = F.softmax(logits_for_token, dim=-1)
        k = min(top_k, probabilities.size(-1))
        topk = torch.topk(probabilities, k=k)
        token_ids = topk.indices.tolist()
        token_scores = topk.values.tolist()
        token_strings = tokenizer.convert_ids_to_tokens(token_ids)
        mask_predictions.append(
            {
                "position": token_index,
                "predictions": [
                    {"token": token_str, "score": score}
                    for token_str, score in zip(token_strings, token_scores)
                ],
            }
        )

RESULT = {"mask_predictions": mask_predictions}
