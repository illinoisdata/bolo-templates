{% set repo_id = repo_id | default("dmis-lab/biobert-large-cased-v1.1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Biobert is a biomedical language model used for text encoding.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import BertTokenizer, BertModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
model_dir = os.path.dirname(weights_path)

device_obj = torch.device(device if (device.startswith('cuda') and torch.cuda.is_available()) or device == 'cpu' else 'cpu')

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=False)
model = BertModel.from_pretrained(model_dir, local_files_only=True)
model.to(device_obj)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device_obj) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()
pooled_output = outputs.pooler_output.detach().cpu() if outputs.pooler_output is not None else None

RESULT = {"last_hidden_state": last_hidden_state, "pooled_output": pooled_output}
