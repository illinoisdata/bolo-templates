{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("LIA-AvignonUniversity/IWSLT2022-tamasheq-only") %}
{% set audio_file = audio_file | default("/u/yli77/projects/ML-code-generation/data/audio.wav") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_file = "{{ audio_file }}"

import os
from io import BytesIO
from pathlib import Path
from urllib.parse import urlparse

import requests
import soundfile as sf
import torch
import torchaudio
from transformers import AutoFeatureExtractor, AutoModelForPreTraining

def _is_url(source: str) -> bool:
    parsed = urlparse(source)
    return parsed.scheme in {"http", "https"}

def _load_audio(source: str):
    if _is_url(source):
        response = requests.get(source)
        response.raise_for_status()
        buffer = BytesIO(response.content)
        waveform, sample_rate = sf.read(buffer, dtype="float32")
    else:
        waveform, sample_rate = sf.read(source, dtype="float32")
    if waveform.ndim > 1:
        waveform = waveform.mean(axis=1)
    return waveform, sample_rate

def _resample_audio(waveform, orig_sr: int, target_sr: int):
    tensor = torch.from_numpy(waveform).float()
    if tensor.dim() == 1:
        tensor = tensor.unsqueeze(0)
    resampler = torchaudio.transforms.Resample(orig_sr, target_sr)
    resampled = resampler(tensor)
    return resampled.squeeze(0).numpy()

_feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
_model = AutoModelForPreTraining.from_pretrained(repo_id)
_model.to(device)
_model.eval()

_audio_samples, _sampling_rate = _load_audio(audio_file)
_expected_sampling_rate = _feature_extractor.sampling_rate
if _sampling_rate != _expected_sampling_rate:
    _audio_samples = _resample_audio(_audio_samples, _sampling_rate, _expected_sampling_rate)
    _sampling_rate = _expected_sampling_rate

_inputs = _feature_extractor(
    _audio_samples,
    sampling_rate=_sampling_rate,
    return_tensors="pt",
)
_inputs = {key: tensor.to(device) for key, tensor in _inputs.items()}

with torch.no_grad():
    _outputs = _model(**_inputs)

_result_items = {}
for _attr in ("projected_states", "projected_quantized_states", "quantized_states"):
    _value = getattr(_outputs, _attr, None)
    if _value is not None:
        _result_items[_attr] = _value.detach().cpu()

RESULT = _result_items
