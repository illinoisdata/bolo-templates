repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import sys
import torch
from transformers import PegasusForConditionalGeneration
from huggingface_hub import hf_hub_download

model_bin = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
repo_dir = os.path.dirname(vocab_file)

model = PegasusForConditionalGeneration.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

vocab = {}
with open(vocab_file, 'r', encoding='utf-8') as f:
    for i, line in enumerate(f):
        vocab[line.rstrip('\n')] = i
vocab['<unk>'] = 0
vocab['<pad>'] = vocab.pop('[PAD]')
vocab['</s>'] = vocab.pop('[unused1]')
vocab['<mask_2>'] = vocab.pop('[unused3]')
vocab['<mask_1>'] = vocab.pop('[unused2]')

class SimplePegasusTokenizer:
    def __init__(self, vocab):
        self.vocab = vocab
        self.inv_vocab = {v:k for k,v in vocab.items()}
    def __call__(self, text, max_length=1024, truncation=True, return_tensors='pt'):
        ids = [self.vocab.get(ch, self.vocab['<unk>']) for ch in text[:max_length]]
        return {'input_ids': torch.tensor([ids], dtype=torch.long), 'attention_mask': torch.ones(1, len(ids), dtype=torch.long)}
    def batch_decode(self, sequences, skip_special_tokens=True, clean_up_tokenization_spaces=False):
        return [''.join(self.inv_vocab.get(int(i), '') for i in seq if int(i) in self.inv_vocab) for seq in sequences]

tokenizer = SimplePegasusTokenizer(vocab)
inputs = tokenizer(text, max_length=1024, truncation=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    summary_ids = model.generate(**inputs, max_length=256, num_beams=8, length_penalty=0.8, early_stopping=True)
summary = tokenizer.batch_decode(summary_ids)[0]
RESULT = {"summary": summary}
