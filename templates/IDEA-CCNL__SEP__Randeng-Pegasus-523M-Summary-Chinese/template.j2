{% set repo_id = repo_id | default("IDEA-CCNL/Randeng-Pegasus-523M-Summary-Chinese") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("据微信公众号“界面”报道，4日上午10点左右，中国发改委反垄断调查小组突击查访奔驰上海办事处，调取数据材料，并对多名奔驰高管进行了约谈。截止昨日晚9点，包括北京梅赛德斯-奔驰销售服务有限公司东区总经理在内的多名管理人员仍留在上海办公室内") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/IDEA-CCNL__SEP__Randeng-Pegasus-523M-Summary-Chinese") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_new_tokens = {{ max_new_tokens }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
import collections
import importlib.util
import sys

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoModelForSeq2SeqLM

helper_dir = Path(hf_hub_download(repo_id, "tokenizers_pegasus.py")).parent
_ = Path(hf_hub_download(repo_id, "data_utils.py"))
vocab_path = Path(hf_hub_download(repo_id, "vocab.txt"))
sys.path.insert(0, str(helper_dir))
spec = importlib.util.spec_from_file_location("tokenizers_pegasus", helper_dir / "tokenizers_pegasus.py")
tokenizers_module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(tokenizers_module)
PegasusTokenizer = getattr(tokenizers_module, "PegasusTokenizer")
PeTokenClass = PegasusTokenizer
PeTokenClass.vocab = collections.OrderedDict()
PeTokenClass.ids_to_tokens = collections.OrderedDict()
tokenizer = PeTokenClass(vocab_file=str(vocab_path))
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=1024,
    padding=False,
)
inputs = {key: tensor.to(device) for key, tensor in inputs.items()}

with torch.no_grad():
    summary_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        min_length=min_length,
        num_beams=num_beams,
    )

summary_text = tokenizer.batch_decode(
    summary_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=False,
)[0]

RESULT = {"summary": summary_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")