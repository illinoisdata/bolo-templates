{% set repo_id = repo_id | default("ggml-org/SmolLM3-3B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('SmolLM3-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short explanation of gravity.') %}
{% set max_tokens = max_tokens | default(64) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
max_tokens = {{ max_tokens }}

from pathlib import Path
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

# Load tokenizer metadata if available; not required for generation, but kept for repo consistency.
_ = AutoTokenizer

llm = Llama(model_path=weights_path, n_ctx=4096, n_threads=4, n_gpu_layers=0, verbose=False)
response = llm(
    prompt,
    max_tokens=max_tokens,
    temperature=0.7,
    stop=[]
)
output_text = response["choices"][0]["text"]

RESULT = {"text": output_text}
