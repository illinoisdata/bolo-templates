{% set repo_id = repo_id | default("idb-ita/gilberto-uncased-from-camembert") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("fill-mask") %}
{% set masked_prompt = masked_prompt | default("Paris is the {mask} of France.") %}
{% set tokenizer_repo = tokenizer_repo | default("camembert-base") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
masked_prompt = {{ masked_prompt | tojson }}
tokenizer_repo = {{ tokenizer_repo | tojson }}

from transformers import CamembertTokenizerFast, pipeline

tokenizer = CamembertTokenizerFast.from_pretrained(tokenizer_repo)
pipe = pipeline(task=task, model=repo_id, tokenizer=tokenizer, device=device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
RESULT = pipe(text)
