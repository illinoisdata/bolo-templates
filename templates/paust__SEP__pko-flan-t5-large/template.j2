{% set repo_id = repo_id | default("paust/pko-flan-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set tokenizer = tokenizer | default("t5-large") %}
{% set input_prompt = input_prompt | default("한국의 수도는 무엇입니까?") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
tokenizer = {{ tokenizer | tojson }}
input_prompt = {{ input_prompt | tojson }}
model = repo_id

from transformers import pipeline

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt)
