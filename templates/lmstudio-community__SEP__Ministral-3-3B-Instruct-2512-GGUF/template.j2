{% set repo_id = repo_id | default("lmstudio-community/Ministral-3-3B-Instruct-2512-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Ministral-3-3B-Instruct-2512-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short helpful reply about why GGUF models are useful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = {{ prompt | tojson }}

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if str(device).startswith("cuda") else 0,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

output = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    top_p=0.95,
    max_tokens=128,
)

text = output["choices"][0]["message"]["content"]
RESULT = {"text": text}
