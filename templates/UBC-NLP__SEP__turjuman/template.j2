{% set repo_id = repo_id | default("UBC-NLP/turjuman") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Translate the following sentence to Modern Standard Arabic: The weather is nice today.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_model_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model_dir = "/".join(config_path.split("/")[:-1])

tokenizer = T5Tokenizer(vocab_file=spiece_model_path)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=64, num_beams=4)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"translation": output_text}
