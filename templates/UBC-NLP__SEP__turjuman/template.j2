{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("UBC-NLP/turjuman") %}
{% set src_text = src_text | default("Translate into Arabic: The weather is nice today.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = """{{ src_text }}"""
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

if isinstance(src_text, str):
    input_texts = [src_text]
else:
    input_texts = list(src_text)

encoded_inputs = tokenizer(
    input_texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
