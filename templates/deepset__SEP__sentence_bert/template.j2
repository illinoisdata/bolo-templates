{% set repo_id = "deepset/sentence_bert" %}
{% set device = "cuda:0" %}
{% set sentences = ["This is an example sentence for embedding.", "Here is another sentence to embed."] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/deepset__SEP__sentence_bert" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences }}
output_dir = "{{ output_dir }}"

import os
from pathlib import Path
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(sentences, padding=True, truncation=True, return_tensors="pt")
encoded = {k: v.to(device) for k, v in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)

last_hidden = outputs.last_hidden_state
attention_mask = encoded["attention_mask"]
mask = attention_mask.unsqueeze(-1)
sum_embeddings = (last_hidden * mask).sum(1)
lengths = mask.sum(1)
embeddings = sum_embeddings / lengths
embeddings = embeddings.cpu().numpy()

RESULT = {"embeddings": embeddings}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    np.save(Path(output_dir) / "embeddings.npy", RESULT["embeddings"])