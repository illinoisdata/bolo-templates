{% set repo_id = repo_id | default("lighthouse/mdeberta-v3-base-kor-further") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('한국어 문장을 입력받아 문장 임베딩을 생성합니다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel, DebertaV2Tokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="spm.model")

_ = (weights_path, config_path, tokenizer_config_path, special_tokens_map_path)

tokenizer = DebertaV2Tokenizer(vocab_file=spm_path)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=False)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden_state = outputs.last_hidden_state
    attention_mask = inputs.get("attention_mask")
    if attention_mask is None:
        sentence_embedding = last_hidden_state[:, 0, :]
    else:
        mask = attention_mask.unsqueeze(-1).type_as(last_hidden_state)
        summed = (last_hidden_state * mask).sum(dim=1)
        counts = mask.sum(dim=1).clamp(min=1e-9)
        sentence_embedding = summed / counts

RESULT = {
    "last_hidden_state": last_hidden_state.detach().cpu(),
    "sentence_embedding": sentence_embedding.detach().cpu(),
}
