{% set repo_id = "kabita-choudhary/finetuned-bart-for-conversation-summary" %}
{% set device = "cuda:0" %}
{% set text = "John: Hi Jane, did you complete the report? Jane: Yes, I sent it yesterday. John: Great, thanks!" %}
{% set num_beams = 4 %}
{% set max_length = 142 %}
{% set min_length = 56 %}
{% set no_repeat_ngram_size = 3 %}
{% set length_penalty = 2.0 %}
{% set early_stopping = True %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt", truncation=True).to(device)

# Inference parameters
summarization_kwargs = {
    "num_beams": num_beams,
    "max_length": max_length,
    "min_length": min_length,
    "no_repeat_ngram_size": no_repeat_ngram_size,
    "length_penalty": length_penalty,
    "early_stopping": early_stopping,
}

# Run inference
output_ids = model.generate(**inputs, **summarization_kwargs)

# Post-process output
summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

# Build RESULT dict
RESULT = {"summary": summary}
