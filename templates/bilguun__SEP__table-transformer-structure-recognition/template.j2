{% set repo_id = repo_id | default("bilguun/table-transformer-structure-recognition") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("object-detection") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

import huggingface_hub.dataclasses as dcs
# disable strict type validation to allow None for optional config fields
dcs._validate_simple_type = lambda name, value, expected_type: None

from transformers import DetrImageProcessor, pipeline

image_processor = DetrImageProcessor.from_pretrained(repo_id)
pipe = pipeline(task=task, model=repo_id, device=device, image_processor=image_processor)
RESULT = pipe(input_image)
