{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/bigbird-pegasus-large-pubmed") %}
{% set input_text = input_text | default("Summarize the following biomedical abstract that describes a long clinical study with complex findings.") %}
{% set max_length = max_length | default(256) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}

import os
from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=4096,
)
inputs = {key: value.to(device) for key, value in encoded.items()}

generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    early_stopping=True,
)

summary_text = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0]

RESULT = {"summary": summary_text}
