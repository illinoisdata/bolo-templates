{% set repo_id = repo_id | default("google/bigbird-pegasus-large-pubmed") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Clinical trial participants with metastatic melanoma received an experimental combination therapy. The study assessed progression-free survival, overall response rate, and safety outcomes over 24 weeks. Adverse events were monitored, and exploratory biomarkers were analyzed to understand treatment response.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, BigBirdPegasusForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from local files downloaded from the Hub.
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path), use_fast=False)
model = BigBirdPegasusForConditionalGeneration.from_pretrained(
    os.path.dirname(weights_path),
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=4096)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=256,
        num_beams=5,
        length_penalty=0.8,
    )

summary = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary}
