{% set repo_id = repo_id | default("ivrit-ai/whisper-large-v3-turbo-ct2") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('he') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"

import os
from pathlib import Path
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

if audio_path.startswith('http://') or audio_path.startswith('https://'):
    import tempfile
    import urllib.request
    tmp_dir = tempfile.mkdtemp()
    local_audio_path = os.path.join(tmp_dir, Path(audio_path).name)
    urllib.request.urlretrieve(audio_path, local_audio_path)
else:
    local_audio_path = audio_path

weights_path = hf_hub_download(repo_id=repo_id, filename='model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
preprocessor_path = hf_hub_download(repo_id=repo_id, filename='preprocessor_config.json')
tokenizer_path = hf_hub_download(repo_id=repo_id, filename='tokenizer.json')
vocabulary_path = hf_hub_download(repo_id=repo_id, filename='vocabulary.json')
model_dir = str(Path(weights_path).parent)
compute_type = 'int8'
whisper_device = 'cpu'
model = WhisperModel(model_dir, device=whisper_device, compute_type=compute_type)
segments, info = model.transcribe(local_audio_path, language=language)
output_text = ' '.join(segment.text for segment in segments)

RESULT = {'transcribed_text': output_text, 'language': info.language, 'language_probability': info.language_probability}
