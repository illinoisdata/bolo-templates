{% set repo_id = repo_id | default("facebook/flava-full") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is happening in the image?') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
image_path = "{{ image_path }}"

import os
import torch
from PIL import Image
import requests
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import FlavaProcessor, FlavaForPreTraining

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

if image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = FlavaProcessor.from_pretrained(os.path.dirname(processor_path))
model = FlavaForPreTraining.from_pretrained(os.path.dirname(weights_path))
model.to(device)
model.eval()

inputs = processor(text=[question], images=[image], return_tensors="pt", padding=True, return_codebook_pixels=True)
inputs = {k: v.to(device) if hasattr(v, "to") else v for k, v in inputs.items()}
inputs["bool_masked_pos"] = torch.zeros((inputs["pixel_values"].shape[0], 196), dtype=torch.bool, device=device)

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "loss": outputs.loss.detach().cpu().item() if outputs.loss is not None else None,
    "output": outputs.to_tuple(),
}
