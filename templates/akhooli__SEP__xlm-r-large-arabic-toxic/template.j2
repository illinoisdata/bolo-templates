{% set repo_id = repo_id | default("akhooli/xlm-r-large-arabic-toxic") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-classification") %}
{% set input_prompt = input_prompt | default("I appreciate the collaborative and inclusive learning environment at university.") %}

task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
