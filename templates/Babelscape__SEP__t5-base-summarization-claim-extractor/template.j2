{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Babelscape__SEP__t5-base-summarization-claim-extractor" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
summary_text = """Simone Biles made a triumphant return to the Olympic stage at the Paris 2024 Games, competing in the women's gymnastics qualifications. Overcoming a previous struggle with the 'twisties' that led to her withdrawal from events at the Tokyo 2020 Olympics, Biles dazzled with strong performances on all apparatus, helping the U.S. team secure a commanding lead in the qualifications. Her routines showcased her resilience and skill, drawing enthusiastic support from a star-studded audience."""
output_dir = "{{ output_dir }}"
from pathlib import Path
import re
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    summary_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=4,
    max_length=200,
    min_length=30,
    no_repeat_ngram_size=3,
    early_stopping=True,
)

decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
claims_text = decoded_outputs[0].strip()
claims_list = [
    segment.strip()
    for segment in re.split(r"\n+|(?<=[.!?])\s+", claims_text)
    if segment.strip()
]

RESULT = {"claims_text": claims_text, "claims": claims_list}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "claims.txt").write_text(claims_text, encoding="utf-8")
    (output_path / "claims_list.txt").write_text("\n".join(claims_list), encoding="utf-8")