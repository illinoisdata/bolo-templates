{% set repo_id = repo_id | default("facebook/wav2vec2-lv-60-espeak-cv-ft") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("automatic-speech-recognition") %}
{% set model = model | default(repo_id) %}
{% set input_audio = input_audio | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_audio = {{ input_audio | tojson }}

from transformers import pipeline, Wav2Vec2PhonemeCTCTokenizer

tokenizer = Wav2Vec2PhonemeCTCTokenizer.from_pretrained(model, do_phonemize=False)
pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_audio)
