{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-it-de") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Ciao, come stai?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True).to(device)
with torch.no_grad():
    generated_tokens = model.generate(**inputs)
output_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": output_text}
