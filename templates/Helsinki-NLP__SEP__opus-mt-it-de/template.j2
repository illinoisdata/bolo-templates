{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-it-de") %}
{% set src_text = src_text | default("Il gatto dorme sul tappeto.") %}
{% set num_beams = num_beams | default(4) %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(
    src_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
tokenized_inputs = {name: tensor.to(device) for name, tensor in tokenized_inputs.items()}

generated_tokens = model.generate(
    **tokenized_inputs,
    num_beams=num_beams,
    max_length=max_length,
)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
