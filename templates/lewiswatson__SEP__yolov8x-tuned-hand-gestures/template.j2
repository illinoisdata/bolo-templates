{% set repo_id = repo_id | default("lewiswatson/yolov8x-tuned-hand-gestures") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set imgsz = imgsz | default(640) %}
{% set max_det = max_det | default(300) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
imgsz = {{ imgsz }}
max_det = {{ max_det }}

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO
from urllib.parse import urlparse
import requests
from io import BytesIO

weights_path = hf_hub_download(repo_id=repo_id, filename="weights/best.pt")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = YOLO(weights_path)
results = model.predict(source=image, conf=conf, imgsz=imgsz, device=device, max_det=max_det, verbose=False)
result = results[0]

boxes = result.boxes
if boxes is not None and len(boxes) > 0:
    xyxy = boxes.xyxy.detach().cpu().tolist()
    cls = boxes.cls.detach().cpu().tolist()
    score = boxes.conf.detach().cpu().tolist()
    names = result.names
    detections = [
        {"box": b, "class_id": int(c), "label": names[int(c)], "confidence": float(s)}
        for b, c, s in zip(xyxy, cls, score)
    ]
else:
    detections = []

RESULT = {"detections": detections}
