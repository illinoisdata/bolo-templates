{% set repo_id = "patrickvonplaten/t5-tiny-random" %}
{% set device = "cuda:0" %}
{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/patrickvonplaten__SEP__t5-tiny-random" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(input_text, return_tensors="pt").to(device)

# Run inference
generated_ids = model.generate(**inputs)

# Post-process output
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

# Build result dict
RESULT = {"generated_text": output_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "generated_text.txt"), "w", encoding="utf-8") as f:
        f.write(RESULT["generated_text"])