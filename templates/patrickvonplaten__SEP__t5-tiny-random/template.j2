{% set repo_id = repo_id | default("patrickvonplaten/t5-tiny-random") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(input_text, return_tensors="pt").to(device)

# Run inference
generated_ids = model.generate(**inputs)

# Post-process output
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

# Build result dict
RESULT = {"generated_text": output_text}
