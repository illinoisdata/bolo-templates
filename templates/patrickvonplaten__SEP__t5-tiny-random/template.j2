{% set repo_id = repo_id | default("patrickvonplaten/t5-tiny-random") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('summarize: The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Load tokenizer and model
_tokenizer_kwargs = {}
if tokenizer_path:
    _tokenizer_kwargs["tokenizer_file"] = tokenizer_path
if spm_path:
    _tokenizer_kwargs["use_fast"] = True

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    **_tokenizer_kwargs,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=16,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"text": output_text}
