{% set repo_id = repo_id | default("RedHatAI/Llama-3.2-3B-Instruct-FP8") %}
{% set device = device | default("cuda:0") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set temperature = temperature | default(0.7) %}
{% set top_p = top_p | default(0.9) %}
{% set system_prompt = system_prompt | default('You are a helpful assistant.') %}
{% set user_prompt = user_prompt | default('Write a short haiku about machine learning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
system_prompt = "{{ system_prompt }}"
user_prompt = "{{ user_prompt }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForCausalLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")


tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    tokenizer_file=tokenizer_json_path,
    tokenizer_config_file=tokenizer_config_path,
    special_tokens_map_file=special_tokens_map_path,
    use_fast=True,
)

model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    config=config_path,
    torch_dtype=torch.bfloat16,
    low_cpu_mem_usage=True,
)
model.to("cpu")
model.eval()

messages = [
    {"role": "system", "content": system_prompt},
    {"role": "user", "content": user_prompt},
]
input_ids = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False, return_tensors="pt")
input_ids = tokenizer(input_ids, return_tensors="pt").input_ids.to("cpu")

with torch.inference_mode():
    generated = model.generate(
        input_ids=input_ids,
        max_new_tokens=max_new_tokens,
        do_sample=True,
        temperature=temperature,
        top_p=top_p,
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.eos_token_id,
    )

output_text = tokenizer.decode(generated[0][input_ids.shape[-1]:], skip_special_tokens=True)

RESULT = {"text": output_text}
