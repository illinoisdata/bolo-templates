{% set repo_id = repo_id | default("prajjwal1/bert-small") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertConfig, BertForPreTraining

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = BertConfig.from_json_file(config_file)
tokenizer = BertTokenizer(vocab_file=vocab_file, do_lower_case=True)
model = BertForPreTraining(config)
state_dict = torch.load(model_file, map_location="cpu")
state_dict.pop("bert.embeddings.position_ids", None)
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

prediction_logits = outputs.prediction_logits.detach().cpu().tolist()
seq_relationship_logits = outputs.seq_relationship_logits.detach().cpu().tolist()

RESULT = {"prediction_logits": prediction_logits, "seq_relationship_logits": seq_relationship_logits}
