{% set repo_id = repo_id | default("allenai/led-base-16384") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The Longformer Encoder-Decoder (LED) can handle very long documents. Summarize the following passage in a concise paragraph: Allenai\'s LED-base-16384 was initialized from bart-base and adapted to process up to 16K tokens by copying position embeddings. It is especially useful for long-range summarization and question answering. The model shares architecture with BART and can be fine-tuned for downstream tasks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, LEDForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = LEDForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=16384)
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

# LED requires global attention on at least the first token for generation tasks.
global_attention_mask = torch.zeros_like(attention_mask)
global_attention_mask[:, 0] = 1

with torch.no_grad():
    generated_ids = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        global_attention_mask=global_attention_mask,
        max_new_tokens=64,
        num_beams=4,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
