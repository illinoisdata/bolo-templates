{% set repo_id = "allenai/led-base-16384" %}
{% set device = "cuda:0" %}
{% set input_text = "LED excels at long-document summarization by mixing global and local attention patterns, enabling efficient reasoning over sequences of up to 16,384 tokens." %}
{% set max_input_length = 4096 %}
{% set max_new_tokens = 256 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/allenai__SEP__led-base-16384" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_input_length = {{ max_input_length }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"
from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_input_length,
).to(device)
with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        early_stopping=True,
    )
summary = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"summary": summary}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    summary_path = output_path / "summary.txt"
    summary_path.write_text(RESULT["summary"], encoding="utf-8")