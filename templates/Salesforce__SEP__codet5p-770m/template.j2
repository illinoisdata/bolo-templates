{% set repo_id = repo_id %}
{% set device = device %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"

from huggingface_hub import hf_hub_download
import json, os

config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
with open(config_path, "r") as f:
    tokenizer_config = json.load(f)

RESULT = {"tokenizer_config": tokenizer_config}

if __name__ == "__main__":
    output_dir = os.getcwd()
    output_path = os.path.join(output_dir, "tokenizer_config.json")
    with open(output_path, "w") as f:
        json.dump(RESULT["tokenizer_config"], f)