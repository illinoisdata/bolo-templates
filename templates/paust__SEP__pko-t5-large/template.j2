{% set repo_id = repo_id | default("paust/pko-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set max_length = max_length | default(32) %}
{% set num_beams = num_beams | default(1) %}
{% set input_text = input_text | default('qa question: 당신의 이름은 무엇인가요?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
input_text = "{{ input_text }}"

import torch
from transformers import PreTrainedTokenizerFast, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
# Downloads to satisfy the repository file usage requirement.
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Build tokenizer directly from the repo files.
tokenizer = PreTrainedTokenizerFast.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id, config=config_path, use_safetensors=True)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
