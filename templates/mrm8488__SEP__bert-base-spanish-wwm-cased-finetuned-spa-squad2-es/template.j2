{% set repo_id = repo_id | default("mrm8488/bert-base-spanish-wwm-cased-finetuned-spa-squad2-es") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('¿Qué modelo se menciona en el texto?') %}
{% set context = context | default('BETO es un modelo BERT entrenado en un gran corpus en español y luego afinado para preguntas y respuestas en SQuAD-es-v2.0.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

local_files_only = True

# Load tokenizer and model

tokenizer = AutoTokenizer.from_pretrained(
    model_file.rsplit('/', 1)[0],
    local_files_only=local_files_only,
)
model = AutoModelForQuestionAnswering.from_pretrained(
    model_file.rsplit('/', 1)[0],
    local_files_only=local_files_only,
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True, max_length=384)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits))
end_idx = int(torch.argmax(end_logits))
if end_idx < start_idx:
    end_idx = start_idx
answer_ids = inputs["input_ids"][0][start_idx:end_idx + 1]
answer = tokenizer.decode(answer_ids, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
