{% set repo_id = repo_id | default("timm/ViT-B-16-SigLIP-512") %}
{% set device = device | default("cuda:0") %}
{% set labels_list = labels_list | default(['a dog', 'a cat', 'a donut', 'a beignet']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
labels_list = {{ labels_list }}

import torch
import torch.nn.functional as F
from PIL import Image
from open_clip import create_model_from_pretrained, get_tokenizer

image_path = "/u/yunqili4/projects/ML-code-generation/data/image1.jpeg"
if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model, preprocess = create_model_from_pretrained("ViT-B-16-SigLIP-512", pretrained="webli")
model = model.to(device).eval()
tokenizer = get_tokenizer("ViT-B-16-SigLIP-512")

image_tensor = preprocess(image).unsqueeze(0).to(device)
text = tokenizer(labels_list, context_length=model.context_length).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text)
    image_features = F.normalize(image_features, dim=-1)
    text_features = F.normalize(text_features, dim=-1)
    logits = image_features @ text_features.T * model.logit_scale.exp()
    if getattr(model, 'logit_bias', None) is not None:
        logits = logits + model.logit_bias
    text_probs = torch.sigmoid(logits)

RESULT = {"labels": labels_list, "text_probs": text_probs[0].detach().cpu().tolist()}
