{% set device = device | default("cuda:0") %}
{% set text_samples = text_samples | default(["Sports is a popular domain", "Politics is a popular domain"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_samples = {{ text_samples | tojson }}

import torch
from torch import nn
from transformers import AutoModel, AutoTokenizer, AutoConfig
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
_ = hf_hub_download(repo_id=repo_id, filename="spm.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

config = AutoConfig.from_pretrained(config_path)
id2label = {int(k): v for k, v in config.id2label.items()}

class CustomModel(nn.Module):
    def __init__(self, hf_config):
        super().__init__()
        self.model = AutoModel.from_pretrained(hf_config.base_model)
        self.dropout = nn.Dropout(hf_config.fc_dropout)
        self.fc = nn.Linear(self.model.config.hidden_size, len(hf_config.id2label))

    def forward(self, input_ids, attention_mask):
        features = self.model(input_ids=input_ids, attention_mask=attention_mask).last_hidden_state
        dropped = self.dropout(features)
        dropped = dropped.to(self.fc.weight.dtype)
        outputs = self.fc(dropped)
        return torch.softmax(outputs[:, 0, :], dim=1)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = CustomModel(config)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text_samples, return_tensors="pt", padding="longest", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(inputs["input_ids"], inputs["attention_mask"])

predicted_classes = torch.argmax(outputs, dim=1)
predicted_domains = [id2label[class_idx.item()] for class_idx in predicted_classes.cpu().numpy()]

RESULT = {"predicted_domains": predicted_domains, "probabilities": outputs.detach().cpu().tolist()}
