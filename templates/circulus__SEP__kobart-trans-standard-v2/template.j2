{% set device = "cuda:0" %}
{% set repo_id = "circulus/kobart-trans-standard-v2" %}
{% set text = "안녕하세요. 이 문장을 영어로 번역해주세요." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

with torch.no_grad():
    inputs = tokenizer(text, return_tensors="pt").to(device)
    generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
    translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
