{% set repo_id = repo_id | default("edbeeching/decision-transformer-gym-hopper-medium") %}
{% set device = device | default("cuda:0") %}
{% set target_return = target_return | default(3600.0) %}
{% set timesteps = timesteps | default([0, 1, 2, 3, 4]) %}
{% set num_steps = num_steps | default(5) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
target_return = {{ target_return }}
timesteps = {{ timesteps }}
num_steps = {{ num_steps }}

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import DecisionTransformerModel

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

state_mean = np.array([1.311279, -0.08469521, -0.5382719, -0.07201576, 0.04932366, 2.1066856, -0.15017354, 0.00878345, -0.2848186, -0.18540096, -0.28461286], dtype=np.float32)
state_std = np.array([0.17790751, 0.05444621, 0.21297139, 0.14530419, 0.6124444, 0.85174465, 1.4515252, 0.6751696, 1.536239, 1.6160746, 5.6072536], dtype=np.float32)

model = DecisionTransformerModel.from_pretrained(repo_id, device_map=None, torch_dtype=torch.float32)
model.to(device)
model.eval()

state_dim = model.config.state_dim
action_dim = model.config.act_dim

states = torch.tensor(np.zeros((1, num_steps, state_dim), dtype=np.float32), device=device)
actions = torch.tensor(np.zeros((1, num_steps, action_dim), dtype=np.float32), device=device)
rewards = torch.tensor(np.zeros((1, num_steps, 1), dtype=np.float32), device=device)
returns_to_go = torch.tensor(np.full((1, num_steps, 1), target_return, dtype=np.float32), device=device)

timestep_tensor = torch.tensor(np.array([timesteps[:num_steps] + [timesteps[-1]] * max(0, num_steps - len(timesteps))], dtype=np.int64), device=device)
attention_mask = torch.ones((1, num_steps), dtype=torch.long, device=device)

with torch.no_grad():
    outputs = model(
        states=states,
        actions=actions,
        rewards=rewards,
        returns_to_go=returns_to_go,
        timesteps=timestep_tensor,
        attention_mask=attention_mask,
    )

predicted_actions = outputs.action_preds[0].detach().cpu().numpy()
RESULT = {"predicted_actions": predicted_actions}
