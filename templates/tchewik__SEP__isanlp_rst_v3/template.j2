{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("tchewik/isanlp_rst_v3") %}
{% set image_path = image_path|default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set text = text|default('This is a short document.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text = "{{ text }}"

import os
from PIL import Image
from huggingface_hub import hf_hub_download

local_example = hf_hub_download(repo_id=repo_id, filename='example-image.png')
repo_dir = os.path.dirname(local_example)

if image_path.startswith('http://') or image_path.startswith('https://'):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

RESULT = {
    "repo_dir": repo_dir,
    "example_image_size": Image.open(local_example).convert('RGB').size,
    "input_image_size": image.size,
    "text": text,
}
