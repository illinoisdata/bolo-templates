{% set repo_id = repo_id | default("jimypbr/bert-base-uncased-squad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('France is a country in Western Europe. Its capital city is Paris, which is known for the Eiffel Tower.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import json
import os
from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Load tokenizer/model from the downloaded repository files
_tokenizer_dir = os.path.dirname(tokenizer_file)
tokenizer = AutoTokenizer.from_pretrained(_tokenizer_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(os.path.dirname(model_file), torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0][start_idx:end_idx + 1]
answer = tokenizer.decode(input_ids, skip_special_tokens=True).strip()
score = float((start_logits[start_idx] + end_logits[end_idx]).item())

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx, "score": score}
