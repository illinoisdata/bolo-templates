{% set repo_id = repo_id | default("Kyle1668/boss-toxicity-t5-large") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The office boss gave a very rude and insulting speech to the team, showing clear toxicity.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

# Load tokenizer and model directly from the downloaded repository files.
tokenizer = AutoTokenizer.from_pretrained(
    hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json").rsplit("/", 1)[0],
    use_fast=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    hf_hub_download(repo_id=repo_id, filename="config.json").rsplit("/", 1)[0],
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": output_text}
