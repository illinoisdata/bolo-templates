{% set repo_id = repo_id | default("google/bert_uncased_L-2_H-256_A-4") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, my dog is cute') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModel

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
pooler_output = outputs.pooler_output.detach().cpu().numpy() if outputs.pooler_output is not None else None

RESULT = {"last_hidden_state": last_hidden_state, "pooler_output": pooler_output}
