{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__bert_uncased_L-2_H-256_A-4" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
)
encoded_input = {k: v.to(device) for k, v in encoded_input.items()}

with torch.no_grad():
    model_outputs = model(**encoded_input)

last_hidden_state = model_outputs.last_hidden_state.detach().cpu()
pooler_output = model_outputs.pooler_output.detach().cpu()

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    torch.save(RESULT["last_hidden_state"], os.path.join(output_dir, "last_hidden_state.pt"))
    torch.save(RESULT["pooler_output"], os.path.join(output_dir, "pooler_output.pt"))