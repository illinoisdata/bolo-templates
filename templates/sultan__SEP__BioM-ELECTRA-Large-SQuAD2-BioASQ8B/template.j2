{% set repo_id = repo_id | default("sultan/BioM-ELECTRA-Large-SQuAD2-BioASQ8B") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the role of ELECTRA in biomedical question answering?') %}
{% set context = context | default('ELECTRA models can be fine-tuned for question answering tasks in the biomedical domain, including SQuAD2.0 and BioASQ factoid datasets.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import ElectraTokenizer, ElectraForQuestionAnswering, ElectraConfig

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = ElectraConfig.from_json_file(config_path)
model = ElectraForQuestionAnswering(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("electra.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=True)
tokenizer = ElectraTokenizer(vocab_file=vocab_path, do_lower_case=True)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0].detach().cpu()
answer = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
