repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
code_input = {{ code_input | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ "True" if early_stopping else "False" }}
tokenizer_repo_id = {{ tokenizer_repo_id | tojson }}

from pathlib import Path

import torch
from huggingface_hub import hf_hub_download
from transformers import RobertaTokenizer, AutoModelForSeq2SeqLM

vocab_path = hf_hub_download(repo_id=tokenizer_repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=tokenizer_repo_id, filename="merges.txt")
tokenizer = RobertaTokenizer(vocab_file=vocab_path, merges_file=merges_path)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)

device = torch.device(device)
model = model.to(device)
inputs = tokenizer(code_input, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}
generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"summary": summary}
