{% set repo_id = repo_id | default("OpenMed/OpenMed-ZeroShot-NER-BloodCancer-Multi-209M") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The patient presented with chronic lymphocytic leukemia symptoms.') %}
{% set labels = labels | default(['CL']) %}
{% set threshold = threshold | default(0.5) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
labels = {{ labels | tojson }}
threshold = {{ threshold }}

from huggingface_hub import hf_hub_download
from gliner import GLiNER

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_cfg_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="spm.model")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model = GLiNER.from_pretrained(repo_id)
model = model.to(device)
entities = model.predict_entities(text, labels, flat_ner=True, threshold=threshold)
RESULT = {"entities": entities}
