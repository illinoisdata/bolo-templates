{% set repo_id = repo_id | default("ibm-granite/granite-4.0-micro") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set use_cache = use_cache | default(false) %}

task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
use_cache = {{ 'True' if use_cache else 'False' }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt, use_cache=use_cache)
