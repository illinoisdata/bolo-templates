repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
input_size = {{ input_size }}

import json
import torch
import torch.nn.functional as F
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from torchvision import transforms

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

state_dict = load_file(weights_path, device="cpu")

image = Image.open(image_path).convert("RGB") if not str(image_path).startswith(("http://", "https://")) else Image.open(__import__("io").BytesIO(__import__("requests").get(image_path, timeout=30).content)).convert("RGB")

preprocess = transforms.Compose([
    transforms.Resize(input_size, interpolation=transforms.InterpolationMode.BICUBIC),
    transforms.CenterCrop(input_size),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5]),
])

x = preprocess(image).unsqueeze(0).to(device)

class SimpleTiTokTokenizer(torch.nn.Module):
    def __init__(self, codebook_size, token_size, num_latent_tokens):
        super().__init__()
        self.encoder = torch.nn.Sequential(
            torch.nn.Conv2d(3, 64, kernel_size=4, stride=2, padding=1),
            torch.nn.ReLU(),
            torch.nn.Conv2d(64, 128, kernel_size=4, stride=2, padding=1),
            torch.nn.ReLU(),
            torch.nn.Conv2d(128, token_size, kernel_size=3, stride=1, padding=1),
        )
        self.codebook = torch.nn.Parameter(torch.empty(codebook_size, token_size))
        self.num_latent_tokens = num_latent_tokens

    def encode(self, x):
        z = self.encoder(x)
        z = F.adaptive_avg_pool2d(z, (int(self.num_latent_tokens ** 0.5), int(self.num_latent_tokens ** 0.5)))
        z = z.flatten(2).transpose(1, 2)
        codebook = F.normalize(self.codebook, dim=-1)
        z = F.normalize(z, dim=-1)
        logits = torch.matmul(z, codebook.t())
        tokens = logits.argmax(dim=-1)
        return tokens, logits

model = SimpleTiTokTokenizer(
    codebook_size=config["model"]["vq_model"]["codebook_size"],
    token_size=config["model"]["vq_model"]["token_size"],
    num_latent_tokens=config["model"]["vq_model"]["num_latent_tokens"],
).to(device)

missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.eval()

with torch.no_grad():
    tokens, logits = model.encode(x)

RESULT = {
    "tokens": tokens.detach().cpu(),
    "logits": logits.detach().cpu(),
    "config": config,
}
