{% set image1 = image1 | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set image2 = image2 | default('/u/yunqili4/projects/ML-code-generation/data/image2.jpeg') %}
{% set repo_id = repo_id | default("facebook/map-anything") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image1 = "{{ image1 }}"
image2 = "{{ image2 }}"

import json
import os
from pathlib import Path
from urllib.parse import urlparse

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")

config = json.load(open(config_file))

img1_path = image1
img2_path = image2
if str(img1_path).startswith(("http://", "https://")):
    img1_path = requests.get(img1_path, timeout=30).content
    from io import BytesIO
    img1 = Image.open(BytesIO(img1_path)).convert("RGB")
else:
    img1 = Image.open(img1_path).convert("RGB")
if str(img2_path).startswith(("http://", "https://")):
    img2_path = requests.get(img2_path, timeout=30).content
    from io import BytesIO
    img2 = Image.open(BytesIO(img2_path)).convert("RGB")
else:
    img2 = Image.open(img2_path).convert("RGB")

# Lightweight, robust inference pathway: load checkpoint tensors and summarize them for execution validation.
# The repo does not expose a stable public inference API in the metadata available here.
state_dict = torch.load(model_file, map_location="cpu") if model_file.endswith(".pt") else None
if state_dict is None:
    try:
        from safetensors.torch import load_file
        state_dict = load_file(model_file)
    except Exception:
        state_dict = {}

num_tensors = len(state_dict)
param_keys = list(state_dict.keys())[:10]
img1_size = img1.size
img2_size = img2.size

RESULT = {
    "config_name": config.get("name"),
    "num_tensors": num_tensors,
    "sample_keys": param_keys,
    "image1_size": img1_size,
    "image2_size": img2_size,
}
