{% set repo_id = repo_id | default("OpenMed/OpenMed-ZeroShot-NER-Pharma-Medium-209M") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Administration of metformin reduced glucose levels significantly.') %}
{% set labels = labels | default(['CHE']) %}
{% set threshold = threshold | default(0.5) %}
{% set flat_ner = flat_ner | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
labels = {{ labels | tojson }}
threshold = {{ threshold }}
flat_ner = {{ flat_ner }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer
from gliner import GLiNER

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="spm.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model = GLiNER.from_pretrained(repo_id)
model = model.to(device)
entities = model.predict_entities(text, labels, flat_ner=flat_ner, threshold=threshold)

RESULT = {"entities": entities}
