{% set repo_id = "prajjwal1/bert-medium" %}
{% set device = "cuda:0" %}
{% set text_input = "The quick brown fox jumps over the lazy dog." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""

import torch
from pathlib import Path
from transformers import AutoModel, BertConfig, BertTokenizer

config = BertConfig.from_pretrained(repo_id)
tokenizer = BertTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id, config=config).to(device)
model.eval()

encoded_inputs = tokenizer(text_input, return_tensors="pt", truncation=True, padding=True)
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

sequence_output = outputs.last_hidden_state.cpu()
pooled_output = outputs.pooler_output.cpu() if outputs.pooler_output is not None else None

RESULT = {"sequence_output": sequence_output}
if pooled_output is not None:
    RESULT["pooled_output"] = pooled_output
