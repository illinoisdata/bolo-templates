{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("liam168/trans-opus-mt-zh-en") %}
{% set input_text = input_text | default("我喜欢学习数据科学和机器学习。") %}
{% set max_length = max_length | default(400) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device_obj = torch.device(device)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device_obj)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
inputs = {key: value.to(device_obj) for key, value in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation_text}
