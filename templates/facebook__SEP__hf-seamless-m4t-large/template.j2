{% set repo_id = repo_id | default("facebook/hf-seamless-m4t-large") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Hello, my dog is cute") %}
{% set src_lang = src_lang | default("eng") %}
{% set tgt_lang = tgt_lang | default("rus") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"

import os
import numpy as np
import soundfile as sf
import torch
from transformers import AutoProcessor, SeamlessM4TModel

processor = AutoProcessor.from_pretrained(repo_id)
model = SeamlessM4TModel.from_pretrained(repo_id).to(device)

inputs = processor(text=input_text, src_lang=src_lang, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

audio_array = model.generate(**inputs, tgt_lang=tgt_lang)[0].cpu().numpy().squeeze()

RESULT = {"audio": audio_array}
