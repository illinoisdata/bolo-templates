repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"

import os

_cuda_lib_path = "/workspace/.pip/nvidia/cu13/lib"
_ld_path = os.environ.get("LD_LIBRARY_PATH")
if _ld_path:
    if _cuda_lib_path not in _ld_path.split(os.pathsep):
        os.environ["LD_LIBRARY_PATH"] = _cuda_lib_path + os.pathsep + _ld_path
else:
    os.environ["LD_LIBRARY_PATH"] = _cuda_lib_path

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(input_image)
