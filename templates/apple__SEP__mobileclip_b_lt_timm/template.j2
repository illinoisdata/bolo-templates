repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import json
import os
from pathlib import Path

import torch
import timm
import requests
from PIL import Image
from transformers import AutoTokenizer
from huggingface_hub import hf_hub_download
from timm.data import resolve_data_config, create_transform

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    cfg = json.load(f)

model = timm.create_model(cfg["architecture"], pretrained=False, num_classes=cfg["num_classes"])
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.eval()
model.to(device)

if str(image_path).startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True, timeout=30).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pretrained_cfg = cfg.get("pretrained_cfg", {})
data_config = resolve_data_config(pretrained_cfg, model=model)
transform = create_transform(**data_config, is_training=False)
input_tensor = transform(image).unsqueeze(0).to(device)

with torch.no_grad():
    image_features = model(input_tensor)
    image_features = torch.nn.functional.normalize(image_features, dim=-1)

RESULT = {"image_features": image_features.detach().cpu().numpy()}
