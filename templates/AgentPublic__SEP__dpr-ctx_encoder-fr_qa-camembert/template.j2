{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("AgentPublic/dpr-ctx_encoder-fr_qa-camembert") %}
{% set query_text = query_text | default("Quelle ville abrite la Tour Eiffel ?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query_text = "{{ query_text }}"

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)

encoding = tokenizer(query_text, return_tensors="pt")
encoding = {k: v.to(device) for k, v in encoding.items()}

with torch.no_grad():
    outputs = model(**encoding)
    embeddings_tensor = outputs.pooler_output

embeddings = embeddings_tensor.detach().cpu().numpy()

RESULT = {"embeddings": embeddings}
