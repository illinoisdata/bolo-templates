{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-gl") %}
{% set device = device | default("cuda:0") %}
{% set text_inputs = text_inputs | default(text_inputs if text_inputs is defined else ["The weather is nice today."]) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text_inputs = {{ text_inputs | tojson }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
max_length = getattr(model.config, "max_length", None)
if max_length is None:
    max_length = 512
else:
    max_length = int(max_length)

encoder_inputs = tokenizer(
    text_inputs,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
).to(device)

generated_tokens = model.generate(
    **encoder_inputs,
    max_length=max_length,
    num_beams=4,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {
    "translations": translations,
}
