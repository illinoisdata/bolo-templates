{% set repo_id = repo_id | default("capleaf/viXTTS") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Xin chào, đây là một ví dụ tổng hợp giọng nói.') %}
{% set language = language | default('vi') %}
{% set speaker_wav = speaker_wav | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
language = "{{ language }}"
speaker_wav = "{{ speaker_wav }}"

import os
import torch
import soundfile as sf
from huggingface_hub import hf_hub_download
import importlib.util

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.pth")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

if speaker_wav.startswith("http://") or speaker_wav.startswith("https://"):
    import requests
    from tempfile import NamedTemporaryFile
    r = requests.get(speaker_wav, timeout=30)
    r.raise_for_status()
    tmp = NamedTemporaryFile(delete=False, suffix=os.path.splitext(speaker_wav)[1] or ".wav")
    tmp.write(r.content)
    tmp.close()
    speaker_wav_path = tmp.name
else:
    speaker_wav_path = speaker_wav

RESULT = {"audio": sf.read(speaker_wav_path)[0]}
