{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-uk-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Привіт, як справи?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

tokenizer_dir = os.path.dirname(source_spm_path)

model = MarianMTModel.from_pretrained(tokenizer_dir).to(device)
tokenizer = MarianTokenizer.from_pretrained(tokenizer_dir)

inputs = tokenizer([text], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6)

decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translation": decoded[0]}
