{% set source_text = "欢迎使用翻译模型。" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-zh-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(source_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0] if translations else ""
RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")