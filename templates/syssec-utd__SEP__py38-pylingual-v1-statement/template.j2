{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("syssec-utd/py38-pylingual-v1-statement") %}
{% set input_text = input_text | default("summarize: The pylingual statement model rewrites technical content with an emphasis on clarity for multilingual audiences.") %}
{% set max_new_tokens = max_new_tokens | default(200) %}
{% set num_beams = num_beams | default(4) %}
{% set temperature = temperature | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
temperature = {{ temperature }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
    temperature=temperature,
    early_stopping=True,
)

generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
