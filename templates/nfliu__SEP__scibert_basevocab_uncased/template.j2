{% set text = 'Hello, world!' %}
repo_id = '{{ repo_id }}'
device = '{{ device }}'
text = '{{ text }}'

import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model(**inputs)
last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()

RESULT = {'last_hidden_state': last_hidden_state}

if __name__ == '__main__':
    import os
    import numpy as np
    output_dir = '/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/nfliu__SEP__scibert_basevocab_uncased'
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, 'last_hidden_state.npy'), RESULT['last_hidden_state'])