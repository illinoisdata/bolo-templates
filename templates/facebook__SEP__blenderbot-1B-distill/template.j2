{% set device = "cuda:0" %}
{% set repo_id = "facebook/blenderbot-1B-distill" %}
{% set user_text = "Hello there! What would you like to discuss today?" %}
{% set max_new_tokens = 60 %}
{% set temperature = 0.7 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
user_text = "{{ user_text }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
num_beams = {{ num_beams }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(user_text, return_tensors="pt", truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

generate_kwargs = {
    "max_new_tokens": max_new_tokens,
    "num_beams": num_beams,
    "temperature": temperature,
    "early_stopping": True,
    "pad_token_id": tokenizer.pad_token_id,
}

generated_tokens = model.generate(**inputs, **generate_kwargs)
generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
