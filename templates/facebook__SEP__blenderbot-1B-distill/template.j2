{% set repo_id = repo_id | default("facebook/blenderbot-1B-distill") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello! How are you doing today?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from transformers import BlenderbotTokenizer, BlenderbotForConditionalGeneration
from huggingface_hub import hf_hub_download

repo_dir = hf_hub_download(repo_id=repo_id, filename='config.json').rsplit('/', 1)[0]
_ = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
_ = hf_hub_download(repo_id=repo_id, filename='tokenizer.json')
_ = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
_ = hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
_ = hf_hub_download(repo_id=repo_id, filename='vocab.json')
_ = hf_hub_download(repo_id=repo_id, filename='merges.txt')
_ = hf_hub_download(repo_id=repo_id, filename='added_tokens.json')
_ = hf_hub_download(repo_id=repo_id, filename='generation_config.json')

tokenizer = BlenderbotTokenizer.from_pretrained(repo_dir)
model = BlenderbotForConditionalGeneration.from_pretrained(
    repo_dir,
    torch_dtype=torch.float16 if device.startswith('cuda') else torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

inputs = tokenizer([prompt], return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=60,
        num_beams=10,
        do_sample=False,
        length_penalty=0.65,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
