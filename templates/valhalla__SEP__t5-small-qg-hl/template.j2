{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("valhalla/t5-small-qg-hl") %}
{% set input_text = input_text | default(" 42 <hl> is the answer to life, the universe and everything. </s>") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

generated_question = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"generated_question": generated_question}
