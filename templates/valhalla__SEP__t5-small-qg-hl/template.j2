{% set input_text = " 42 <hl> is the answer to life, the universe and everything. </s>" %}
{% set max_length = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/valhalla__SEP__t5-small-qg-hl" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

generated_question = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"generated_question": generated_question}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    question_file = output_path / "generated_question.txt"
    question_file.write_text(RESULT["generated_question"], encoding="utf-8")