{% set repo_id = repo_id | default("microsoft/trocr-small-handwritten") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default("/u/yli77/projects/ML-code-generation/data/image1.jpeg") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import torch
from PIL import Image
import requests
from transformers import TrOCRProcessor, VisionEncoderDecoderModel

# Load processor and model
processor = TrOCRProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model.to(device)

# Pre-process input
if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
pixel_values = inputs.pixel_values.to(device)

# Run inference
generated_ids = model.generate(pixel_values)

# Post-process & build RESULT dict
generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"generated_text": generated_text}
