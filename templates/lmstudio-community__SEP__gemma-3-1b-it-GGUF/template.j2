{% set repo_id = repo_id | default("lmstudio-community/gemma-3-1b-it-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-3-1b-it-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short helpful answer about the benefits of quantized language models.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=4,
    n_gpu_layers=-1 if str(device).startswith('cuda') else 0,
    verbose=False,
)

output = llm.create_chat_completion(
    messages=[{"role": "user", "content": prompt}],
    temperature=0.2,
    top_p=0.9,
    max_tokens=128,
)

RESULT = {"output": output["choices"][0]["message"]["content"]}
