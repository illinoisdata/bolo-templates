{% set repo_id = repo_id | default("mrm8488/t5-base-finetuned-sarcasm-twitter") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("As everybody knows Trump is by far the best USA president... XD") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text + tokenizer.eos_token, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

# Run inference
outputs = model.generate(input_ids=input_ids, attention_mask=attention_mask)

# Post-process & build RESULT dict
decoded = tokenizer.batch_decode(outputs, skip_special_tokens=True)
label = decoded[0]

RESULT = {"label": label}
