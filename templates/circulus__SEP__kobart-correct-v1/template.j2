{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("circulus/kobart-correct-v1") %}
{% set text = text | default("This is a test sentence.") %}
device = "{{ device }}"
repo_id = "{{ repo_id }}"
text = "{{ text }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt").to(device)
generated_ids = model.generate(**inputs)
corrected_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"corrected_text": corrected_text}
