{% set repo_id = repo_id | default("NHNDQ/nllb-finetuned-en2ko") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The weather is nice today.') %}
{% set src_lang = src_lang | default('eng_Latn') %}
{% set tgt_lang = tgt_lang | default('kor_Hang') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
src_lang = {{ src_lang | tojson }}
tgt_lang = {{ tgt_lang | tojson }}
max_new_tokens = {{ max_new_tokens }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

repo_dir = weights_path.rsplit('/', 1)[0]
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

tokenizer.src_lang = src_lang
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
forced_bos_token_id = tokenizer.convert_tokens_to_ids(tgt_lang)

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        forced_bos_token_id=forced_bos_token_id,
        max_new_tokens=max_new_tokens,
    )
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
