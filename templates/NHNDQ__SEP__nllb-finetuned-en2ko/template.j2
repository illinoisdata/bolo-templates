{% set device = "cuda:0" %}
{% set repo_id = "NHNDQ/nllb-finetuned-en2ko" %}
{% set text_input = "The quick brown fox jumps over the lazy dog." %}
{% set target_language = "kor_Hang" %}
{% set source_language = "eng_Latn" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
target_language = "{{ target_language }}"
source_language = "{{ source_language }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

tokenizer.src_lang = source_language

inputs = tokenizer(text_input, return_tensors="pt", padding=True)
inputs = {name: tensor.to(torch_device) for name, tensor in inputs.items()}

forced_bos_token_id = tokenizer.lang_code_to_id[target_language]
generated_tokens = model.generate(**inputs, forced_bos_token_id=forced_bos_token_id, max_new_tokens=256)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded[0]

RESULT = {"translation": translation}
