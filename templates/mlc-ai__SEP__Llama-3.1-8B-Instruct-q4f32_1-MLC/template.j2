{% set repo_id = repo_id | default("mlc-ai/Llama-3.1-8B-Instruct-q4f32_1-MLC") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('What is the meaning of life?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
import json

config_path = hf_hub_download(repo_id=repo_id, filename="mlc-chat-config.json")
with open(config_path, 'r') as f:
    config = json.load(f)

RESULT = {"config": config, "prompt": prompt, "device": device}
