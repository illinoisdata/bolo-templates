{% set repo_id = "Helsinki-NLP/opus-mt-en-fi" %}
{% set device = "cuda:0" %}
{% set text = "This is a test." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-fi" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model.generate(**inputs)

translation = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    out_file = os.path.join(output_dir, "translation.txt")
    with open(out_file, "w", encoding="utf-8") as f:
        for t in RESULT["translation"]:
            f.write(t + "\n")