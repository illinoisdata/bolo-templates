{% set repo_id = "google/rembert" %}
{% set device = "cuda:0" %}
{% set text = "This is a sample input text for RemBERT." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import AutoTokenizer, AutoModel
import torch
import numpy as np
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
inputs = tokenizer(text, return_tensors="pt").to(device)
outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)

last_hidden_state = last_hidden_state.detach().cpu().numpy()
if pooler_output is not None:
    pooler_output = pooler_output.detach().cpu().numpy()

RESULT = {"last_hidden_state": last_hidden_state}
if pooler_output is not None:
    RESULT["pooler_output"] = pooler_output

if __name__ == "__main__":
    output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__rembert"
    os.makedirs(output_dir, exist_ok=True)
    for key, value in RESULT.items():
        np.save(os.path.join(output_dir, f"{key}.npy"), value)