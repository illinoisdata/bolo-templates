{% set repo_id = repo_id | default("dbmdz/bert-base-turkish-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Merhaba dünya!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel
import torch

vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(repo_id, vocab_file=vocab_path)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooled_output = outputs.pooler_output
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooled_output": pooled_output,
}
