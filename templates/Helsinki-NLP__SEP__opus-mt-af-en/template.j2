{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-af-en" %}
{% set source_text = "Dit is 'n voorbeeldsin in Afrikaans." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(source_text, return_tensors="pt").to(device)

translated_tokens = model.generate(**inputs)
decoded_texts = tokenizer.batch_decode(translated_tokens, skip_special_tokens=True)
translation = decoded_texts[0]
added_token_ids = translated_tokens[0].cpu().tolist()

RESULT = {
    "translation": translation,
    "token_ids": added_token_ids,
}
