{% set source_text = "Dit is 'n voorbeeldsin in Afrikaans." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-af-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
output_dir = "{{ output_dir }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(source_text, return_tensors="pt").to(device)

translated_tokens = model.generate(**inputs)
decoded_texts = tokenizer.batch_decode(translated_tokens, skip_special_tokens=True)
translation = decoded_texts[0]
added_token_ids = translated_tokens[0].cpu().tolist()

RESULT = {
    "translation": translation,
    "token_ids": added_token_ids,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")
    (output_path / "token_ids.json").write_text(json.dumps(RESULT["token_ids"], ensure_ascii=False))