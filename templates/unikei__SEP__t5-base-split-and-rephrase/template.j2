{% set repo_id = repo_id | default("unikei/t5-base-split-and-rephrase") %}
{% set device = device | default("cuda:0") %}
{% set max_input_length = max_input_length | default(256) %}
{% set max_output_length = max_output_length | default(256) %}
{% set num_beams = num_beams | default(5) %}
{% set complex_sentence = complex_sentence | default("Cystic Fibrosis (CF) is an autosomal recessive disorder that affects multiple organs, which is common in the Caucasian population, symptomatically affecting 1 in 2500 newborns in the UK, and more than 80,000 individuals globally.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_input_length = {{ max_input_length }}
max_output_length = {{ max_output_length }}
num_beams = {{ num_beams }}
complex_sentence = "{{ complex_sentence }}"

from pathlib import Path
from huggingface_hub import hf_hub_download
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

tokenizer = T5Tokenizer.from_pretrained(Path(tokenizer_config_path).parent)
model = T5ForConditionalGeneration.from_pretrained(Path(config_path).parent, torch_dtype=torch.float32)
model.load_state_dict(torch.load(weights_path, map_location="cpu"))
model.to(device)
model.eval()

inputs = tokenizer(
    complex_sentence,
    padding="max_length",
    truncation=True,
    max_length=max_input_length,
    return_tensors="pt",
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        input_ids=inputs["input_ids"],
        attention_mask=inputs["attention_mask"],
        max_length=max_output_length,
        num_beams=num_beams,
    )

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"output_text": output_text}
