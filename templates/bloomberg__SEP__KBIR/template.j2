{% set repo_id = repo_id | default("bloomberg/KBIR") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The keyphrase boundary infilling model is useful for extracting important phrases from scientific articles and finance news.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import json
import torch
from tokenizers import ByteLevelBPETokenizer
from transformers import RobertaConfig, RobertaForMaskedLM, RobertaTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
model_dir = os.path.dirname(model_path)

tokenizer = RobertaTokenizer(vocab_file=vocab_path, merges_file=merges_path, tokenizer_file=None)
model = RobertaForMaskedLM.from_pretrained(model_dir, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits[0, -1], dim=-1)
    topk = torch.topk(probs, k=5)
    top_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
    top_scores = topk.values.detach().cpu().tolist()

RESULT = {"top_tokens": top_tokens, "top_scores": top_scores}
