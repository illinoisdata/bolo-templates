{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/bloomberg__SEP__KBIR" %}
{% set input_text = "The capital of France is <mask>." %}
{% set top_k = 5 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = "{{ input_text }}"
top_k = {{ top_k }}

import json
from pathlib import Path

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}
mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None:
    mask_indices = torch.where(inputs["input_ids"][0] == mask_token_id)[0]
else:
    mask_indices = torch.empty(0, dtype=torch.long, device=device)

with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
predictions = []
for mask_index in mask_indices.tolist():
    mask_logits = logits[0, mask_index]
    distribution = mask_logits.softmax(dim=-1)
    k = min(top_k, distribution.shape[-1])
    topk = torch.topk(distribution, k=k)
    token_ids = topk.indices.tolist()
    scores = topk.values.tolist()
    tokens = tokenizer.convert_ids_to_tokens(token_ids)
    top_tokens = []
    for token, score in zip(tokens, scores):
        top_tokens.append({"token": token, "score": float(score)})
    predictions.append({"mask_index": int(mask_index), "top_tokens": top_tokens})

RESULT = {"mask_predictions": predictions}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    with (output_path / "mask_predictions.json").open("w", encoding="utf-8") as output_file:
        json.dump(RESULT["mask_predictions"], output_file, ensure_ascii=False, indent=2)