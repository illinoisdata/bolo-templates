{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-hu-en") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Ez egy egyszerű teszt.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model_inputs = tokenizer(source_text, return_tensors="pt", padding=True)
model_inputs = {key: value.to(device) for key, value in model_inputs.items()}

generated_tokens = model.generate(**model_inputs)

decoded_translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_text = decoded_translations[0] if decoded_translations else ""

RESULT = {"translation": translation_text}
