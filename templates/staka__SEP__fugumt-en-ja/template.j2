{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "This is a cat." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/staka__SEP__fugumt-en-ja" %}

repo_id = """{{ repo_id }}"""
device = """{{ device }}"""
input_text = """{{ input_text }}"""
output_dir = """{{ output_dir }}"""

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}

if __name__ == "__main__":
    path = Path(output_dir)
    path.mkdir(parents=True, exist_ok=True)
    file_path = path / "translations.txt"
    file_path.write_text("\n".join(RESULT["translations"]), encoding="utf-8")