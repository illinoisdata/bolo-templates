{% set repo_id = repo_id | default("kuprel/min-dalle") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('an oil painting of a futuristic city at sunset') %}
{% set seed = seed | default(-1) %}
{% set grid_size = grid_size | default(3) %}
{% set is_seamless = is_seamless | default(False) %}
{% set temperature = temperature | default(1.0) %}
{% set top_k = top_k | default(256) %}
{% set supercondition_factor = supercondition_factor | default(16) %}
{% set is_verbose = is_verbose | default(False) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
seed = {{ seed }}
grid_size = {{ grid_size }}
is_seamless = {{ is_seamless }}
temperature = {{ temperature }}
top_k = {{ top_k }}
supercondition_factor = {{ supercondition_factor }}
is_verbose = {{ is_verbose }}

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from min_dalle import MinDalle

# Download model files
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
encoder_path = hf_hub_download(repo_id=repo_id, filename="encoder.pt")
decoder_path = hf_hub_download(repo_id=repo_id, filename="decoder.pt")
detoker_path = hf_hub_download(repo_id=repo_id, filename="detoker.pt")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
models_root = os.path.dirname(config_path)

# Load model and run inference
model = MinDalle(
    models_root=models_root,
    device=device,
    dtype=torch.float32,
    is_mega=True,
    is_reusable=False,
)

image = model.generate_image(
    text=text,
    seed=seed,
    grid_size=grid_size,
    is_seamless=is_seamless,
    temperature=temperature,
    top_k=top_k,
    supercondition_factor=supercondition_factor,
    is_verbose=is_verbose,
)

RESULT = {"image": image}
