{% set prompt = prompt | default("A serene digital painting of a futuristic city skyline at sunset") %}
{% set grid_size = grid_size | default(4) %}
{% set temperature = temperature | default(1.0) %}
{% set top_k = top_k | default(256) %}
{% set supercondition_factor = supercondition_factor | default(32) %}
{% set seed = seed | default(-1) %}
{% set is_seamless = is_seamless | default(False) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("kuprel/min-dalle") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
grid_size = {{ grid_size }}
temperature = {{ temperature }}
top_k = {{ top_k }}
supercondition_factor = {{ supercondition_factor }}
seed = {{ seed }}
is_seamless = {{ "True" if is_seamless else "False" }}
models_root_dir = "./" + repo_id.replace("/", "_") + "_models"

from pathlib import Path

import torch
from min_dalle import MinDalle

min_dalle_device = "cuda" if device.startswith("cuda") else "cpu"
models_root_path = Path(models_root_dir)
models_root_path.mkdir(parents=True, exist_ok=True)

model = MinDalle(
    models_root=str(models_root_path),
    dtype=torch.float32,
    device=min_dalle_device,
    is_mega=True,
    is_reusable=True,
)

image = model.generate_image(
    text=prompt,
    seed=seed,
    grid_size=grid_size,
    is_seamless=is_seamless,
    temperature=temperature,
    top_k=top_k,
    supercondition_factor=supercondition_factor,
    is_verbose=False,
)

RESULT = {"image": image}
