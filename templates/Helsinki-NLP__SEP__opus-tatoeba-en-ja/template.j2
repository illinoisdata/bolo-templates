{% set repo_id = repo_id | default("Helsinki-NLP/opus-tatoeba-en-ja") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Hello, how are you today?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load tokenizer and model weights onto the specified device
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)

# Pre-process the input text
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(torch_device) for k, v in inputs.items()}

# Run inference
generated_tokens = model.generate(**inputs)

# Post-process the predictions
decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded[0].strip()

RESULT = {"translation": translation}
