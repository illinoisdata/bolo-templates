{% set device = "cuda:0" %}
{% set repo_id = "emanjavacas/MacBERTh" %}
{% set input_text = "The quick brown [MASK] jumps over the lazy dog." %}
{% set top_k = 5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
top_k = {{ top_k }}

from pathlib import Path

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}
with torch.no_grad():
    logits = model(**encoded_inputs).logits

mask_token_id = tokenizer.mask_token_id
mask_positions = (encoded_inputs["input_ids"] == mask_token_id).nonzero(as_tuple=True)
mask_index = mask_positions[1][0]

mask_logits = logits[0, mask_index]
topk = torch.topk(mask_logits, top_k)
candidate_token_ids = topk.indices.tolist()
candidate_scores = torch.softmax(mask_logits, dim=-1)[topk.indices].tolist()
candidate_tokens = tokenizer.convert_ids_to_tokens(candidate_token_ids)

RESULT = {
    "mask_candidates": [
        {"token": token, "score": float(score)}
        for token, score in zip(candidate_tokens, candidate_scores)
    ]
}
