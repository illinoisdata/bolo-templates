{% set repo_id = repo_id | default("emanjavacas/MacBERTh") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    token_ids = inputs["input_ids"]
    preds = torch.argmax(logits, dim=-1)
    tokens = tokenizer.convert_ids_to_tokens(token_ids[0].tolist())
    predicted_tokens = tokenizer.convert_ids_to_tokens(preds[0].tolist())

RESULT = {"tokens": tokens, "predicted_tokens": predicted_tokens, "logits": logits}
