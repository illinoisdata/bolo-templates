{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-it-en" %}
{% set input_text = "Ciao, come stai?" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path
import json
from transformers import MarianTokenizer, MarianMTModel

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = [input_text]
encoded_inputs = tokenizer(inputs, return_tensors="pt", padding=True, truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
