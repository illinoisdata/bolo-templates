{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-bg") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default(["2001 is the year when the 21st century begins.", "This is Copacabana!"]) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = inputs.to(device)

translated_tokens = model.generate(**inputs, num_beams=num_beams)

translations = tokenizer.batch_decode(translated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}
