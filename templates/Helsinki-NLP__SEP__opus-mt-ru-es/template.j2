{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ru-es") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Привет, как дела?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
vocab_path = hf_hub_download(repo_id=repo_id, filename='vocab.json')
source_spm_path = hf_hub_download(repo_id=repo_id, filename='source.spm')
target_spm_path = hf_hub_download(repo_id=repo_id, filename='target.spm')
gen_config_path = hf_hub_download(repo_id=repo_id, filename='generation_config.json')

# tokenizer / model load
_tokenizer_kwargs = {}
if tokenizer_config_path:
    _tokenizer_kwargs['tokenizer_file'] = None
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    source_spm=source_spm_path,
    target_spm=target_spm_path,
    vocab=vocab_path,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6, max_length=512)
output = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output}
