{% set text_input = "Привет, как вы?" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-ru-es" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

model_name_or_path = repo_id

tokenizer = MarianTokenizer.from_pretrained(model_name_or_path)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name_or_path)
model = model.to(device)

encoded_inputs = tokenizer([text_input], return_tensors="pt", padding=True, truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=256, num_beams=4)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(translation, encoding="utf-8")