{% set repo_id = repo_id | default("inceptionai/jais-family-590m") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('The capital of UAE is') %}
{% set max_new_tokens = max_new_tokens | default(20) %}
{% set do_sample = do_sample | default(true) %}
{% set temperature = temperature | default(0.3) %}
{% set top_p = top_p | default(0.9) %}
{% set repetition_penalty = repetition_penalty | default(1.2) %}
{% set trust_remote_code = trust_remote_code | default(true) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}
top_p = {{ top_p }}
repetition_penalty = {{ repetition_penalty }}
trust_remote_code = {{ trust_remote_code }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="configuration_jais.py")
_ = hf_hub_download(repo_id=repo_id, filename="modeling_jais.py")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=trust_remote_code)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    trust_remote_code=trust_remote_code,
    dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
input_len = inputs["input_ids"].shape[-1]
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=do_sample,
        top_p=top_p,
        temperature=temperature,
        repetition_penalty=repetition_penalty,
        pad_token_id=tokenizer.eos_token_id,
        eos_token_id=tokenizer.eos_token_id,
    )
output_text = tokenizer.decode(generated_ids[0][input_len:], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
