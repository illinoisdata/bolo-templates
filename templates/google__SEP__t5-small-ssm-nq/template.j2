{% set repo_id = repo_id | default("google/t5-small-ssm-nq") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("What is the capital of France?") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import AutoTokenizer, pipeline
from transformers.models.t5 import T5ForConditionalGeneration

class Gemma3ForConditionalGeneration(T5ForConditionalGeneration):
    pass

tokenizer = AutoTokenizer.from_pretrained(model)
model = Gemma3ForConditionalGeneration.from_pretrained(model)
model = model.to(device)

prompt = input_prompt

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(prompt)
