{% set repo_id = repo_id | default("OpenRLHF/Llama-3-8b-rm-mixture") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Transformers are amazing!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    logits = logits.detach().cpu()
    if logits.shape[-1] == 1:
        reward_values = logits.squeeze(-1).tolist()
    else:
        reward_values = logits.tolist()

RESULT = {"reward_scores": reward_values}
