{% set repo_id = repo_id | default("facebook/dpr-ctx_encoder-single-nq-base") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Hello, is my dog cute ?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import os
import torch
from transformers import DPRContextEncoder, DPRContextEncoderTokenizer
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
model_dir = os.path.dirname(model_file)

tokenizer = DPRContextEncoderTokenizer.from_pretrained(model_dir)
model = DPRContextEncoder.from_pretrained(model_dir)
model = model.to(device)
model.eval()

inputs = tokenizer(question, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

embedding = outputs.pooler_output.detach().cpu().numpy()

RESULT = {"embedding": embedding}
