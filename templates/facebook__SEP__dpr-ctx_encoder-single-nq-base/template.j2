{% set repo_id = repo_id | default("facebook/dpr-ctx_encoder-single-nq-base") %}
{% set device = device | default("cuda:0") %}
{% set context_text = context_text | default("The Eiffel Tower is located in Paris and is one of the most popular tourist attractions in the world.") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
context_text = {{ context_text | tojson }}

import os

import torch
from transformers import AutoModel, AutoTokenizer

model = AutoModel.from_pretrained(repo_id)
model = model.to(torch.device(device))
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_input = tokenizer(context_text, return_tensors="pt", truncation=True, padding=True)
encoded_input = {key: value.to(torch.device(device)) for key, value in encoded_input.items()}

with torch.no_grad():
    outputs = model(**encoded_input)

context_embedding = outputs.pooler_output.detach().cpu()

RESULT = {"context_embedding": context_embedding}
