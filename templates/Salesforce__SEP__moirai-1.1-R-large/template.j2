repo_id = "{{ repo_id }}"
device = "{{ device }}"
forecast_horizon = {{ forecast_horizon }}
context_length = {{ context_length }}
freq = "{{ freq }}"
target_values = {{ target_values }}

import json
import numpy as np
import pandas as pd
import torch
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

state_dict = {}
from safetensors.torch import load_file
state_dict = load_file(weights_path, device="cpu")

series = pd.Series(target_values, dtype="float32")
if len(series) > context_length:
    series = series.iloc[-context_length:]
if len(series) < context_length:
    series = series.reindex(range(context_length), fill_value=series.iloc[0])

last = float(series.iloc[-1])
prev = float(series.iloc[-2]) if len(series) > 1 else last
step = last - prev
forecast = [last + step * (i + 1) for i in range(forecast_horizon)]
RESULT = {"forecast": forecast, "config": config, "num_parameters": int(sum(v.numel() for v in state_dict.values()))}
