{% set repo_id = "noamrot/FuseCap_Image_Captioning" %}
{% set device = "cuda:0" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set prompt = "a picture of " %}
{% set num_beams = 3 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"
num_beams = {{ num_beams }}

from transformers import BlipProcessor, BlipForConditionalGeneration
import torch
import requests
from PIL import Image
import os

processor = BlipProcessor.from_pretrained(repo_id)
model = BlipForConditionalGeneration.from_pretrained(repo_id).to(device)

if image_path.startswith("http"):
    raw_image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    raw_image = Image.open(image_path).convert("RGB")

inputs = processor(raw_image, prompt, return_tensors="pt").to(device)
generated_ids = model.generate(**inputs, num_beams=num_beams)
caption = processor.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": caption}
