{% set repo_id = repo_id | default("google/flan-t5-xl") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("translate English to German: How old are you?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
