{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-da-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hej verden!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import MarianMTModel, MarianTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spm_source_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
spm_target_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = MarianMTModel.from_pretrained(repo_id)
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=128)

translated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
