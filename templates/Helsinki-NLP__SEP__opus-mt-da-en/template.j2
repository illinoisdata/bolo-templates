{% set input_text = "Godmorgen, hvordan har du det i dag?" %}
{% set num_beams = 4 %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-da-en" %}
{% set output_file_name = "translation.txt" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"
output_file_name = "{{ output_file_name }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

output_dir = Path(output_dir)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_length,
    early_stopping=True,
)
decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_text = decoded_outputs[0]

RESULT = {"translation": translation_text}

if __name__ == "__main__":
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / output_file_name).write_text(RESULT["translation"], encoding="utf-8")