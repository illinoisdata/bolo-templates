{% set repo_id = repo_id | default("facebook/wav2vec2-large-robust") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set target_sampling_rate = target_sampling_rate | default(16000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_sampling_rate = {{ target_sampling_rate }}

import os
import numpy as np
import torch
import soundfile as sf
import librosa
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2FeatureExtractor, Wav2Vec2ForPreTraining

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
repo_dir = os.path.dirname(preprocessor_path)

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(repo_dir, local_files_only=True)
model = Wav2Vec2ForPreTraining.from_pretrained(repo_dir, local_files_only=True)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

if audio_path.startswith(("http://", "https://")):
    audio, sr = librosa.load(audio_path, sr=target_sampling_rate, mono=True)
else:
    audio, sr = sf.read(audio_path)
    if audio.ndim > 1:
        audio = np.mean(audio, axis=1)
    if sr != target_sampling_rate:
        audio = librosa.resample(audio.astype(np.float32), orig_sr=sr, target_sr=target_sampling_rate)
        sr = target_sampling_rate

inputs = feature_extractor(audio, sampling_rate=sr, return_tensors="pt")
input_values = inputs.input_values.to(device)
with torch.no_grad():
    outputs = model(input_values=input_values)

RESULT = {"projected_states": outputs.projected_states.detach().cpu().numpy(), "hidden_states": outputs.hidden_states.detach().cpu().numpy() if outputs.hidden_states is not None else None}
