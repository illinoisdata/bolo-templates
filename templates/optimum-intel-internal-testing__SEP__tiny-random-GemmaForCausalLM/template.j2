{% set repo_id = repo_id | default("optimum-intel-internal-testing/tiny-random-GemmaForCausalLM") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.model")

from transformers import AutoConfig
config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=8, do_sample=False)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": output_text}
