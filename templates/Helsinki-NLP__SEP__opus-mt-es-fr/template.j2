{% set text = "¿Cómo estás?" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-es-fr" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch.device(device))
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(torch.device(device)) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    translation_file = output_path / "translation.txt"
    translation_file.write_text("\n".join(RESULT["translations"]), encoding="utf-8")