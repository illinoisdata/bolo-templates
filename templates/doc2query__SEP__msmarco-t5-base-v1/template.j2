{% set repo_id = repo_id | default("doc2query/msmarco-t5-base-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Python is an interpreted, high-level and general-purpose programming language. Python's design philosophy emphasizes code readability with its notable use of significant whitespace. Its language constructs and object-oriented approach aim to help programmers write clear, logical code for small and large-scale projects.") %}
{% set max_length = max_length | default(64) %}
{% set do_sample = do_sample | default(true) %}
{% set top_p = top_p | default(0.95) %}
{% set num_return_sequences = num_return_sequences | default(5) %}
{% set input_max_length = input_max_length | default(320) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
max_length = {{ max_length }}
do_sample = {{ 'True' if do_sample else 'False' }}
top_p = {{ top_p }}
num_return_sequences = {{ num_return_sequences }}
input_max_length = {{ input_max_length }}

import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = T5Tokenizer.from_pretrained(repo_id, vocab_file=spiece_path)
model = T5ForConditionalGeneration.from_pretrained(repo_id)
state = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state)
model = model.to(device)
model.eval()

inputs = tokenizer(text, max_length=input_max_length, truncation=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(
        input_ids=inputs["input_ids"],
        attention_mask=inputs.get("attention_mask"),
        max_length=max_length,
        do_sample=do_sample,
        top_p=top_p,
        num_return_sequences=num_return_sequences,
    )
queries = [tokenizer.decode(ids, skip_special_tokens=True) for ids in output_ids]

RESULT = {"queries": queries}
