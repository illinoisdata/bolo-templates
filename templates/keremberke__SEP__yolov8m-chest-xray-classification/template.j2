{% set repo_id = repo_id | default("keremberke/yolov8m-chest-xray-classification") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}

import os
from urllib.parse import urlparse
import requests
from PIL import Image
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if image.startswith(("http://", "https://")):
    image = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image = Image.open(image).convert("RGB")

model = YOLO(weights_path)
results = model.predict(image, conf=conf, device=device)
probs = results[0].probs
class_names = results[0].names
predictions = {class_names[i]: float(probs.data[i]) for i in range(len(class_names))}

RESULT = {"predictions": predictions, "top1": int(probs.top1), "top5": [int(i) for i in probs.top5]}
