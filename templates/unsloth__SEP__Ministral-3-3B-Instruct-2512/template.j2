{% set repo_id = repo_id | default("unsloth/Ministral-3-3B-Instruct-2512") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What do you see in the image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import json
import os
from pathlib import Path

import torch
from PIL import Image
from transformers import AutoProcessor, Mistral3ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="processor_config.json")
model_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")

def _load_image(image_path_or_url):
    if str(image_path_or_url).startswith(("http://", "https://")):
        from requests import get
        from io import BytesIO
        return Image.open(BytesIO(get(image_path_or_url, timeout=30).content)).convert("RGB")
    return Image.open(image_path_or_url).convert("RGB")

processor = AutoProcessor.from_pretrained(repo_id)
model = Mistral3ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
)
model.to(device)
model.eval()

image = _load_image("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg")
messages = [
    {
        "role": "user",
        "content": [
            {"type": "text", "text": question},
            {"type": "image", "image": image},
        ],
    }
]

inputs = processor.apply_chat_template(messages, add_generation_prompt=True, return_tensors="pt", tokenize=True)
if isinstance(inputs, dict):
    input_ids = inputs["input_ids"].to(device)
    attention_mask = inputs.get("attention_mask")
    if attention_mask is not None:
        attention_mask = attention_mask.to(device)
    pixel_values = inputs.get("pixel_values")
    if pixel_values is not None:
        pixel_values = pixel_values.to(device=device, dtype=torch.bfloat16)
    image_sizes = inputs.get("image_sizes")
else:
    input_ids = inputs.to(device)
    attention_mask = None
    pixel_values = None
    image_sizes = None

model_inputs = {"input_ids": input_ids}
if attention_mask is not None:
    model_inputs["attention_mask"] = attention_mask
if pixel_values is not None:
    model_inputs["pixel_values"] = pixel_values
if image_sizes is not None:
    model_inputs["image_sizes"] = image_sizes

with torch.no_grad():
    generated = model.generate(**model_inputs, max_new_tokens=64)

decoded = processor.tokenizer.decode(generated[0, input_ids.shape[1]:], skip_special_tokens=True)

RESULT = {"generated_text": decoded}
