{% set repo_id = repo_id | default("mozilla-ai/Llama-3.2-3B-Instruct-llamafile") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Write a short haiku about modular robots.') %}
{% set quant_filename = quant_filename | default('Llama-3.2-3B-Instruct.Q6_K.llamafile') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
quant_filename = "{{ quant_filename }}"

import os
import subprocess
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
os.chmod(model_path, os.stat(model_path).st_mode | 0o111)

cmd = ["bash", model_path, "--cli", "-p", prompt, "--log-disable"]
if device.startswith("cuda"):
    cmd.extend(["-ngl", "999"])

proc = subprocess.run(cmd, check=True, capture_output=True, text=True)
output_text = proc.stdout.strip()

RESULT = {"text": output_text}
