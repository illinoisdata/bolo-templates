{% set device = "cuda:0" %}
{% set repo_id = "google/bigbird-pegasus-large-bigpatent" %}
{% set text_input = "Replace me by any text you'd like." %}
{% set max_length = 256 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
summary = decoded_texts[0].strip()

RESULT = {"summary": summary}
