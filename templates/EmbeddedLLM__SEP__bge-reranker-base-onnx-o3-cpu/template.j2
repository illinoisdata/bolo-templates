{% set provider = "CPUExecutionProvider" %}
{% set sentences = [
    "The llama (/ˈlɑːmə/) (Lama glama) is a domesticated South American camelid.",
    "The alpaca (Lama pacos) is a species of South American camelid mammal.",
    "The vicuña (Lama vicugna) (/vɪˈkuːnjə/) is one of the two wild South American camelids."
] %}
{% set queries = [
    "What is a llama?",
    "What is a harimau?",
    "How to fly a kite?"
] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/EmbeddedLLM__SEP__bge-reranker-base-onnx-o3-cpu" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
provider = "{{ provider }}"
sentences = {{ sentences }}
queries = {{ queries }}
output_dir = "{{ output_dir }}"

from itertools import product
import os
import torch
from transformers import AutoTokenizer
from optimum.onnxruntime import ORTModelForSequenceClassification

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = ORTModelForSequenceClassification.from_pretrained(
    repo_id,
    provider=provider,
)

inference_device = torch.device(device)
if inference_device.type == "cuda" and not torch.cuda.is_available():
    inference_device = torch.device("cpu")

pairs = list(product(queries, sentences))
inputs = tokenizer(
    pairs,
    padding=True,
    truncation=True,
    return_tensors="pt",
    max_length=model.config.max_position_embeddings,
)
inputs = inputs.to(inference_device)

outputs = model(**inputs)
logits = outputs.logits
scores = logits.view(-1).cpu().numpy()

sorted_pairs = sorted(zip(pairs, scores), key=lambda x: x[1], reverse=True)
RESULT = {"pairs_with_scores": sorted_pairs}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(f"{output_dir}/pairs_with_scores.txt", "w") as f:
        for pair, score in RESULT["pairs_with_scores"]:
            f.write(f"{pair}\t{score}\n")