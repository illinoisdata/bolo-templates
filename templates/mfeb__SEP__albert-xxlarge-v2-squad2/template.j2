{% set repo_id = repo_id | default("mfeb/albert-xxlarge-v2-squad2") %}
{% set device = device | default("cuda:0") %}
{% set context = context | default('Albert XXLarge V2 model, fine-tuned for SQuAD V2.') %}
{% set question = question | default('What model is this?') %}
{% set max_length = max_length | default(384) %}
{% set doc_stride = doc_stride | default(128) %}
{% set max_answer_length = max_answer_length | default(30) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = {{ context | tojson }}
question = {{ question | tojson }}
max_length = {{ max_length }}
doc_stride = {{ doc_stride }}
max_answer_length = {{ max_answer_length }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

import os
from pathlib import Path
model_dir = str(Path(weights_path).parent)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(
    question,
    context,
    return_tensors="pt",
    truncation="only_second",
    max_length=max_length,
    stride=doc_stride,
    return_overflowing_tokens=False,
    return_offsets_mapping=True,
)

offset_mapping = inputs.pop("offset_mapping")[0]
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_index = int(torch.argmax(start_logits))
end_index = int(torch.argmax(end_logits))
if end_index < start_index:
    end_index = start_index
if end_index - start_index + 1 > max_answer_length:
    end_index = start_index + max_answer_length - 1
answer_tokens = inputs["input_ids"][0, start_index:end_index + 1]
answer_text = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()

RESULT = {
    "answer": answer_text,
    "start_index": start_index,
    "end_index": end_index,
    "start_logit": float(start_logits[start_index].item()),
    "end_logit": float(end_logits[end_index].item()),
}
