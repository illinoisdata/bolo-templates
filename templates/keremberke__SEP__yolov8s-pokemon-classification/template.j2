{% set repo_id = repo_id | default("keremberke/yolov8s-pokemon-classification") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
topk = {{ topk }}

from urllib.parse import urlparse

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if urlparse(image_path).scheme in ("http", "https"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = YOLO(weights_path)
model.overrides["conf"] = conf

results = model.predict(source=image, device=device, verbose=False)
probs = results[0].probs
names = results[0].names
indices = probs.top5[:topk]
output = {names[i]: float(probs.data[i]) for i in indices}

RESULT = {"output": output}
