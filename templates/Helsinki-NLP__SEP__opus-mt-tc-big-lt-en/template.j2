{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-lt-en") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default(["Katė sedėjo ant kėdės.", "Jukiko mėgsta bulves."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import MarianMTModel, MarianTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

_tokenizer = MarianTokenizer(vocab=vocab_path, source_spm=source_spm_path, target_spm=target_spm_path)
model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = _tokenizer(src_text, return_tensors="pt", padding=True, truncation=True).to(device)
with torch.no_grad():
    generated_tokens = model.generate(**inputs)
translated_texts = [_tokenizer.decode(t, skip_special_tokens=True) for t in generated_tokens]

RESULT = {"translations": translated_texts}
