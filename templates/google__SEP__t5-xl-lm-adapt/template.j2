{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/t5-xl-lm-adapt") %}
{% set prompt = prompt | default("Translate English to German: The house is wonderful.") %}
{% set max_length = max_length | default(128) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_return_sequences = {{ num_return_sequences }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(prompt, return_tensors="pt").to(device)
generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    num_return_sequences=num_return_sequences,
)
generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"generated_text": generated_texts}
