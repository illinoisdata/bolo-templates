{% set repo_id = repo_id | default("yosshstd/vit-fer2013") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set image_processor = image_processor | default("google/vit-base-patch16-224-in21k") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}
image_processor = {{ image_processor | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, image_processor=image_processor, device=device)
RESULT = pipe(input_data)
