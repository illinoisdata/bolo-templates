{% set repo_id = repo_id | default("staka/fugumt-ja-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('猫はかわいいです。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

# Load tokenizer/model from downloaded repository files.
tokenizer = MarianTokenizer(
    vocab=hf_hub_download(repo_id=repo_id, filename="vocab.json"),
    source_spm=hf_hub_download(repo_id=repo_id, filename="source.spm"),
    target_spm=hf_hub_download(repo_id=repo_id, filename="target.spm"),
    tokenizer_file=None,
)
model = MarianMTModel.from_pretrained(repo_id, torch_dtype=torch.float16 if "cuda" in device and torch.cuda.is_available() else torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated = model.generate(**inputs, num_beams=12, max_length=512)
output_text = tokenizer.batch_decode(generated, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
