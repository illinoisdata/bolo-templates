{% set device = "cuda:0" %}
{% set repo_id = "staka/fugumt-ja-en" %}
{% set input_text = "猫はかわいいです。" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = '{{ input_text }}'

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**encoded_inputs, max_length=512)

decoded_translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_translations[0]

RESULT = {"translation": translation}
