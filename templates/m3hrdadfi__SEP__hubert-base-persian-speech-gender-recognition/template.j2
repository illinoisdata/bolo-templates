{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/m3hrdadfi__SEP__hubert-base-persian-speech-gender-recognition/outputs" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
output_dir = "{{ output_dir }}"

import io
import json
from pathlib import Path

import librosa
import requests
import torch
from transformers import AutoFeatureExtractor, AutoModelForAudioClassification

feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
model = AutoModelForAudioClassification.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model.eval()
sampling_rate = feature_extractor.sampling_rate


def load_audio(path: str, target_sampling_rate: int):
    if path.startswith("http://") or path.startswith("https://"):
        response = requests.get(path)
        response.raise_for_status()
        source = io.BytesIO(response.content)
    else:
        source = path
    waveform, source_sampling_rate = librosa.load(source, sr=target_sampling_rate, mono=True)
    return waveform, source_sampling_rate


waveform, recorded_sampling_rate = load_audio(audio_path, sampling_rate)
inputs = feature_extractor(waveform, sampling_rate=recorded_sampling_rate, return_tensors="pt", padding=True)
inputs = {key: value.to(torch_device) for key, value in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
probabilities = torch.softmax(logits, dim=-1)[0].cpu()

label_map = model.config.id2label
scores = []
for index, score in enumerate(probabilities.tolist()):
    label = label_map.get(index, label_map.get(str(index), str(index)))
    scores.append({"label": label, "score": score})

RESULT = {"gender_scores": scores}


if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    output_path = Path(output_dir) / "gender_scores.json"
    with output_path.open("w", encoding="utf-8") as output_file:
        json.dump(RESULT["gender_scores"], output_file, ensure_ascii=False, indent=2)