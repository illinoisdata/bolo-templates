{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-es-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("¿Cómo estás?") %}
{% set num_beams = num_beams | default(4) %}
{% set max_length = max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = inputs.to(device)

generated_tokens = model.generate(
    **inputs,
    num_beams=num_beams,
    max_length=max_length,
)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation_text": translation}
