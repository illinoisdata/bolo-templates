{% set repo_id = repo_id | default("Systran/faster-whisper-medium.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(5) %}
{% set vad_filter = vad_filter | default(false) %}
{% set word_timestamps = word_timestamps | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
vad_filter = {{ vad_filter }}
word_timestamps = {{ word_timestamps }}

import os
import torch
from faster_whisper import WhisperModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")
model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
model_dir = os.path.dirname(model_path)

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_input = audio_path
else:
    audio_input = audio_path

use_cuda = device.startswith("cuda") and torch.cuda.is_available()
device_for_model = "cuda" if use_cuda else "cpu"
compute_type = "float16" if use_cuda else "int8"
model = WhisperModel(model_dir, device=device_for_model, compute_type=compute_type)
segments, info = model.transcribe(
    audio_input,
    task=task,
    language=language,
    beam_size=beam_size,
    vad_filter=vad_filter,
    word_timestamps=word_timestamps,
)

output_segments = []
for segment in segments:
    output_segments.append({
        "start": float(segment.start),
        "end": float(segment.end),
        "text": segment.text,
    })

RESULT = {
    "language": info.language,
    "language_probability": float(info.language_probability),
    "duration": float(info.duration),
    "segments": output_segments,
}
