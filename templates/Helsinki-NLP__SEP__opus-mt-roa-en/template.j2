{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-roa-en") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Ciao, come stai?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

from pathlib import Path
from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(source_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
