{% set repo_id = repo_id | default("ClueAI/PromptCLUE-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('翻译成中文：\nThis is a dialogue robot that can talk to people.\n答案：') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="spiece.model")
hf_hub_download(repo_id=repo_id, filename="spiece.vocab")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=768).to(device)
with torch.no_grad():
    output_ids = model.generate(**inputs, max_length=128, num_beams=4, length_penalty=0.6)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
