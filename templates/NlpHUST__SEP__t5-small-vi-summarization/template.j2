{% set repo_id = repo_id | default("NlpHUST/t5-small-vi-summarization") %}
{% set device = device | default("cuda:0") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
{% set input_text = input_text | default("Việt Nam đã đạt được nhiều thành tựu đáng kể trong phát triển kinh tế - xã hội trong những năm gần đây. Tuy nhiên, vẫn còn nhiều thách thức cần giải quyết để đảm bảo tăng trưởng bền vững và nâng cao chất lượng cuộc sống cho người dân.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
input_text = {{ input_text | tojson }}

import torch
from transformers import T5Tokenizer, AutoModelForSeq2SeqLM
from pathlib import Path
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
model.load_state_dict(torch.load(weights_path, map_location="cpu"))
model.to(device)
model.eval()

tokenizer = T5Tokenizer(vocab_file=spiece_path)
inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": output_text}
