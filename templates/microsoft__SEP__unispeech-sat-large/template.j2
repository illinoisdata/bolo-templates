{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set sample_rate = sample_rate | default(16000) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("microsoft/unispeech-sat-large") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}

import io
import json
import math
import os
import numpy as np
import torch
import soundfile as sf
import torch.nn.functional as F
from transformers import AutoModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

with open(config_path, "r") as f:
    config = json.load(f)

with open(preprocessor_path, "r") as f:
    preprocessor_config = json.load(f)

if audio_path.startswith(("http://", "https://")):
    import requests
    audio_bytes = requests.get(audio_path).content
    waveform, file_sr = sf.read(io.BytesIO(audio_bytes))
else:
    waveform, file_sr = sf.read(audio_path)

if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)

waveform = waveform.astype(np.float32)
if file_sr != sample_rate:
    ratio = sample_rate / file_sr
    new_length = max(1, int(math.floor(len(waveform) * ratio)))
    x_old = np.linspace(0, 1, num=len(waveform), endpoint=False)
    x_new = np.linspace(0, 1, num=new_length, endpoint=False)
    waveform = np.interp(x_new, x_old, waveform).astype(np.float32)

input_values = torch.tensor(waveform, dtype=torch.float32).unsqueeze(0).to(device)

model = AutoModel.from_pretrained(repo_id, local_files_only=True).to(device)
model.eval()

with torch.no_grad():
    outputs = model(input_values=input_values)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state.detach().cpu().numpy(),
    "hidden_states": outputs.hidden_states,
}
