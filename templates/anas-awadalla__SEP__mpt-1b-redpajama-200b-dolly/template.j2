{% set repo_id = repo_id | default("anas-awadalla/mpt-1b-redpajama-200b-dolly") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = {{ task | tojson }}
model = repo_id
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline, modeling_utils

if not hasattr(modeling_utils.PreTrainedModel, "all_tied_weights_keys"):
    def _all_tied_weights_keys(self):
        tied = getattr(self, "_tied_weights_keys", None)
        if tied is None:
            tied = {}
        return tied

    modeling_utils.PreTrainedModel.all_tied_weights_keys = property(
        _all_tied_weights_keys
    )

pipe = pipeline(task=task, model=model, device=device, trust_remote_code=True)

prompt = input_prompt
RESULT = pipe(prompt)
