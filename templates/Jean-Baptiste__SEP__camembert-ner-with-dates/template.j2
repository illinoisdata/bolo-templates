{% set repo_id = repo_id | default("Jean-Baptiste/camembert-ner-with-dates") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Je m'appelle Jean-Baptiste et j'habite à Montréal depuis février 2012.") %}
{% set aggregation_strategy = aggregation_strategy | default("simple") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
aggregation_strategy = {{ aggregation_strategy | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, aggregation_strategy=aggregation_strategy)

preprocessed_input = input_prompt

RESULT = pipe(preprocessed_input)
