{% set repo_id = repo_id | default("sshleifer/distilbart-cnn-6-6") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('The city council approved a new plan to expand public transit, including more bus lanes and extended subway service. Supporters say the changes will reduce commute times and lower pollution, while critics worry about construction delays and costs.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_file.rsplit('/', 1)[0],
    local_files_only=True,
)
model = BartForConditionalGeneration.from_pretrained(
    model_file.rsplit('/', 1)[0],
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=4,
        max_length=142,
        min_length=56,
        no_repeat_ngram_size=3,
        length_penalty=2.0,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
