{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sshleifer/distilbart-cnn-6-6") %}
{% set input_text = input_text | default("The Apollo 11 mission launched on July 16, 1969, and carried astronauts Neil Armstrong, Buzz Aldrin, and Michael Collins toward the moon") %}
{% set max_length = max_length | default(142) %}
{% set min_length = min_length | default(56) %}
{% set num_beams = num_beams | default(4) %}
{% set length_penalty = length_penalty | default(2.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    max_length=max_length,
    truncation=True,
)
encoded_inputs = {k: v.to(torch_device) for k, v in encoded_inputs.items()}

generated_ids = model.generate(
    **encoded_inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    early_stopping=True,
)

summary_text = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0]

RESULT = {"summary": summary_text}
