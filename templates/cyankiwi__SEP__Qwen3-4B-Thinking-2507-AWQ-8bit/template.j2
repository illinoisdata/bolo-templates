{% set repo_id = repo_id | default("cyankiwi/Qwen3-4B-Thinking-2507-AWQ-8bit") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
model = {{ model | tojson }}
input_prompt = {{ input_prompt | tojson }}

import torch

from transformers import pipeline


def _torch_compile_noop(func=None, **kwargs):
    if func is None:
        return lambda f: f
    return func

torch.compile = _torch_compile_noop

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
