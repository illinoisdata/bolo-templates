{% set repo_id = repo_id | default("lmstudio-community/gpt-oss-20b-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gpt-oss-20b-MXFP4.gguf') %}
{% set prompt = prompt | default('Write a short, helpful paragraph about why inference engineering benefits from reproducibility.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import json
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoConfig
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

# Load tokenizer/config if available for chat formatting; fall back gracefully to a simple prompt.
# For GGUF inference we rely on llama-cpp-python.
try:
    tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
except Exception:
    tokenizer = None

config = None
try:
    config = AutoConfig.from_pretrained(repo_id, trust_remote_code=True)
except Exception:
    config = None

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if device.startswith("cuda") else 0,
    verbose=False,
)

if tokenizer is not None and hasattr(tokenizer, 'apply_chat_template'):
    messages = [
        {"role": "user", "content": prompt},
    ]
    input_text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
else:
    input_text = prompt

output = llm(
    input_text,
    max_tokens=128,
    temperature=0.7,
    top_p=0.95,
    stop=[]
)

text_output = output["choices"][0]["text"]
RESULT = {"text": text_output}
