{% set repo_id = repo_id | default("timm/resnet50.a3_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
task = {{ task | tojson }}
device = "{{ device }}"
input_image = {{ input_image | tojson }}

from transformers import pipeline
from PIL import Image

if device.lower().startswith("cuda") and ":" in device:
    pipeline_device = int(device.split(":")[-1])
elif device.lower() == "cpu":
    pipeline_device = -1
else:
    pipeline_device = -1

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)

image = Image.open(input_image).convert("RGB")
RESULT = pipe(image)
