{% set repo_id = repo_id | default("abhigoyal/vllm-medusa-llama-68m-random") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import json
import torch
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

config = json.load(open(config_path))
state_dict = load_file(weights_path)

vocab_size = int(config["vocab_size"])
input_ids = torch.arange(min(8, vocab_size), dtype=torch.long, device=device).unsqueeze(0)

# Minimal inference-compatible inspection of the checkpoint tensors.
param_shapes = {k: tuple(v.shape) for k, v in state_dict.items()}
num_tensors = len(state_dict)
num_parameters = int(sum(v.numel() for v in state_dict.values()))

RESULT = {
    "input_ids": input_ids,
    "num_tensors": num_tensors,
    "num_parameters": num_parameters,
    "param_shapes": param_shapes,
    "text": text,
}
