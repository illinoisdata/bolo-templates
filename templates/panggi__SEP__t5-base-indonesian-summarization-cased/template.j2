{% set device = "cuda:0" %}
{% set repo_id = "panggi/t5-base-indonesian-summarization-cased" %}
{% set text_to_summarize = "Indonesia terus memperkuat ekonomi digital guna mendukung UMKM dan mendorong inklusi keuangan bagi masyarakat di daerah terpencil." %}
{% set max_summary_length = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_to_summarize = "{{ text_to_summarize }}"
max_summary_length = {{ max_summary_length }}
num_beams = {{ num_beams }}
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(text_to_summarize, return_tensors="pt", truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(
    **encoded_inputs,
    max_length=max_summary_length,
    num_beams=num_beams,
    early_stopping=True,
    length_penalty=1.0,
    no_repeat_ngram_size=2,
)

summary_text = tokenizer.decode(
    generated_ids[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
).strip()

RESULT = {"summary": summary_text}
