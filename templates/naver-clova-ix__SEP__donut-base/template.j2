{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("naver-clova-ix/donut-base") %}
{% set image_path = image_path | default("/u/yli77/projects/ML-code-generation/data/doc.jpeg") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import io
import os
from pathlib import Path

import requests
import torch
from PIL import Image
from transformers import AutoProcessor, VisionEncoderDecoderModel

processor = AutoProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(device)
model.eval()

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path)
    response.raise_for_status()
    image = Image.open(io.BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = None
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        decoder_start_token_id=processor.tokenizer.cls_token_id,
        eos_token_id=processor.tokenizer.sep_token_id,
        max_length=1024,
    )

generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0].strip()
RESULT = {"generated_text": generated_text}
