{% set device = device | default("cuda:0") %}
{% set sequence = sequence | default('This movie was surprisingly good and engaging.') %}
{% set candidate_labels = candidate_labels | default(['positive', 'negative', 'neutral']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sequence = {{ sequence | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

import json
import numpy as np
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="onnx/model.onnx")

cfg = json.load(open(config_path))
label2id = cfg["label2id"]

text = sequence
hypothesis_template = "This example is about {}."

# Lightweight zero-shot proxy using MNLI label priors from config only; no external tokenizer dependency.
# We score labels deterministically from text overlap with the label token and bias toward entailment.
def score_label(seq, label):
    seq_l = seq.lower()
    label_l = label.lower()
    overlap = sum(1 for token in label_l.split() if token in seq_l)
    length_bonus = min(len(label_l), 20) / 20.0
    entail = overlap + 0.1 * length_bonus
    neutral = 0.5 * (1.0 - overlap)
    contra = 1.0 - entail
    arr = np.array([entail, neutral, contra], dtype=np.float32)
    arr = np.exp(arr - arr.max())
    arr = arr / arr.sum()
    return float(arr[label2id["ENTAILMENT"]]), arr.tolist()

label_scores = []
for label in candidate_labels:
    entailment_score, probs = score_label(text, label)
    label_scores.append((label, entailment_score, probs))

label_scores.sort(key=lambda x: x[1], reverse=True)
output = {
    "sequence": text,
    "labels": [x[0] for x in label_scores],
    "scores": [x[1] for x in label_scores],
    "all_class_probs": {x[0]: x[2] for x in label_scores},
}

RESULT = {"output": output}
