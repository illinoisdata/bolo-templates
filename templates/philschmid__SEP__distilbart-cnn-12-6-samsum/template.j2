{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/philschmid__SEP__distilbart-cnn-12-6-samsum" %}
{% set summary_max_length = 142 %}
{% set summary_min_length = 56 %}
{% set beam_count = 4 %}
{% set length_penalty = 2.0 %}
{% set no_repeat_ngram_size = 3 %}
{% set early_stopping = true %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
summary_input = """{{ summary_input | trim }}"""
output_dir = "{{ output_dir }}"
summary_max_length = {{ summary_max_length }}
summary_min_length = {{ summary_min_length }}
beam_count = {{ beam_count }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ "True" if early_stopping else "False" }}

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(
    summary_input,
    return_tensors="pt",
    truncation=True,
    max_length=summary_max_length,
)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=summary_max_length,
    min_length=summary_min_length,
    num_beams=beam_count,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)

decoded_summary = tokenizer.decode(
    generated_tokens[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"summary": decoded_summary}

if __name__ == "__main__":
    from pathlib import Path

    target_dir = Path(output_dir)
    target_dir.mkdir(parents=True, exist_ok=True)
    summary_path = target_dir / "summary.txt"
    summary_path.write_text(RESULT["summary"], encoding="utf-8")