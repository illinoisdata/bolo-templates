repo_id = "{{ repo_id }}"
device = "{{ device }}"
summary_input = """{{ summary_input | trim }}"""
summary_max_length = {{ summary_max_length }}
summary_min_length = {{ summary_min_length }}
beam_count = {{ beam_count }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ "True" if early_stopping else "False" }}

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(
    summary_input,
    return_tensors="pt",
    truncation=True,
    max_length=summary_max_length,
)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=summary_max_length,
    min_length=summary_min_length,
    num_beams=beam_count,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)

decoded_summary = tokenizer.decode(
    generated_tokens[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"summary": decoded_summary}
