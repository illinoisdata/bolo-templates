{% set repo_id = repo_id | default("fxmarty/resnet-tiny-mnist") %}
{% set device = device | default("cuda:0") %}
{%- set task = task | default("image-classification") -%}
{%- set model = model | default(repo_id) -%}
{%- set pipeline_device = pipeline_device | default(device) -%}
{%- set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ pipeline_device | tojson }}
image_path = {{ image_path | tojson }}

from PIL import Image
import numpy as np
from transformers import AutoImageProcessor, pipeline

image_processor = AutoImageProcessor.from_pretrained(model)
image_processor.do_convert_rgb = False

input_image = Image.open(image_path).convert("L")
input_array = np.array(input_image, dtype=np.uint8)[..., None].copy()

pipe = pipeline(task=task, model=model, device=device, image_processor=image_processor)
RESULT = pipe(input_array)
