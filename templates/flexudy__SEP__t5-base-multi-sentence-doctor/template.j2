{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("flexudy/t5-base-multi-sentence-doctor") %}
{% set input_text = input_text | default("repair_sentence: m a medical doct context: {That is my job I a}{or I save lives} </s>") %}
{% set max_length = max_length | default(32) %}
{% set num_beams = num_beams | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import torch

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

inputs = tokenizer(input_text, return_tensors="pt")
for key, value in inputs.items():
    inputs[key] = value.to(torch_device)

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
corrected_sentence = tokenizer.decode(generated_tokens[0], skip_special_tokens=True, clean_up_tokenization_spaces=True)

RESULT = {"corrected_sentence": corrected_sentence}
