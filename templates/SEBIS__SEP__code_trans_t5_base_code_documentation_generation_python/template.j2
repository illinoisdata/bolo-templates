{% set repo_id = repo_id | default("SEBIS/code_trans_t5_base_code_documentation_generation_python") %}
{% set device = device | default("cuda:0") %}
{% set code_text = code_text | default("def e ( message , exit_code = None ) : print_log ( message , YELLOW , BOLD ) if exit_code is not None : sys . exit ( exit_code )") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
code_text = "{{ code_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)

model.to(device)
model.eval()

inputs = tokenizer(
    "function documentation generation python: " + code_text,
    return_tensors="pt",
    truncation=True,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=64,
        num_beams=4,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
