{% set repo_id = repo_id | default("utter-project/mHuBERT-147") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("automatic-speech-recognition") %}
{% set audio_path = audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set model = model | default(repo_id) %}

task = "{{ task }}"
model = "{{ model }}"
audio_path = "{{ audio_path }}"
device = "{{ device }}"

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    tokenizer="facebook/wav2vec2-base-960h",
    feature_extractor=model,
    device=device,
)

RESULT = pipe(audio_path)
