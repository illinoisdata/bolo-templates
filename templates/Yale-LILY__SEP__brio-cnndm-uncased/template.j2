{% set repo_id = repo_id | default("Yale-LILY/brio-cnndm-uncased") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog. The lazy dog stays asleep, ignoring the energetic fox.") %}
{% set max_length = max_length | default(142) %}
{% set min_length = min_length | default(56) %}
{% set num_beams = num_beams | default(4) %}
{% set output_file_name = output_file_name | default("summary.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
output_file_name = "{{ output_file_name }}"

import os

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

device_obj = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device_obj)

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
)
inputs = {key: tensor.to(device_obj) for key, tensor in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    early_stopping=True,
)
decoded = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
summary = decoded[0]

RESULT = {"summary": summary}
