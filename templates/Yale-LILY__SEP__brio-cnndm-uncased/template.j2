{% set repo_id = repo_id | default("Yale-LILY/brio-cnndm-uncased") %}
{% set device = device | default("cuda:0") %}
{% set article = article | default('The United Nations said on Tuesday that climate change is accelerating and called for stronger international cooperation to reduce emissions. Scientists warned that extreme weather events are becoming more frequent and more intense, threatening coastal cities, agriculture, and public health. Leaders meeting this week are expected to discuss policy measures, including renewable energy investment and methane reduction efforts.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article = "{{ article }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_files = [
    hf_hub_download(repo_id=repo_id, filename="vocab.json"),
    hf_hub_download(repo_id=repo_id, filename="merges.txt"),
    hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json"),
    hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json"),
]

model_dir = "/".join(model_path.split("/")[:-1])

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(article, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=num_beams,
        max_new_tokens=max_new_tokens,
        length_penalty=2.0,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
