{% set repo_id = repo_id | default("nvidia/segformer-b5-finetuned-ade-640-640") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-segmentation") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
image_path = "{{ image_path }}"

from transformers import (
    pipeline,
    SegformerForSemanticSegmentation,
    SegformerImageProcessor,
)

image_processor = SegformerImageProcessor.from_pretrained(repo_id)
model = SegformerForSemanticSegmentation.from_pretrained(repo_id)
model.to(device)

pipe = pipeline(
    task=task,
    model=model,
    image_processor=image_processor,
    device=device,
)
RESULT = pipe(image_path)
