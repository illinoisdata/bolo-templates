{% set repo_id = repo_id | default("monologg/koelectra-small-v2-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("안녕하세요! 이것은 테스트 입력입니다.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits.detach().cpu().tolist()

RESULT = {"discriminator_logits": logits}
