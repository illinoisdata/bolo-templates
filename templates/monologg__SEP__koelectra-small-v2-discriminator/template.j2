{% set repo_id = repo_id | default("monologg/koelectra-small-v2-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('이 문장은 자연어 판별을 위한 예시입니다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import ElectraForPreTraining, ElectraTokenizerFast

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model = ElectraForPreTraining.from_pretrained(
    pretrained_model_name_or_path=None,
    config=config_path,
    state_dict=torch.load(weights_path, map_location="cpu"),
)

tokenizer = ElectraTokenizerFast(vocab_file=vocab_path, tokenizer_file=None)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
model = model.to(device)
model.eval()

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probabilities = torch.sigmoid(logits)

RESULT = {"logits": logits.detach().cpu().tolist(), "probabilities": probabilities.detach().cpu().tolist()}
