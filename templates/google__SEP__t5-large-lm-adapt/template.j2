{% set repo_id = repo_id | default("google/t5-large-lm-adapt") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("translate English to German: Hello, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = """{{ prompt }}"""
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_new_tokens=max_new_tokens)
decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
generated_text = decoded[0].strip() if decoded else ""

RESULT = {"generated_text": generated_text}
