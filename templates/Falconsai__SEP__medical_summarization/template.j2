{% set repo_id = repo_id | default("Falconsai/medical_summarization") %}
{% set device = device | default("cuda:0") %}
{% set text_to_summarize = text_to_summarize | default("Medical text to summarize.") %}
{% set prefix = prefix | default("summarize: ") %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_to_summarize = "{{ text_to_summarize }}"
prefix = "{{ prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_input = tokenizer(prefix + text_to_summarize, return_tensors="pt")
encoded_input = {k: v.to(device) for k, v in encoded_input.items()}

output_ids = model.generate(
    **encoded_input,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
)

summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"summary_text": summary}
