{% set repo_id = repo_id %}
{% set device = device %}
{% set text_to_summarize = "Medical text to summarize." %}
{% set prefix = "summarize: " %}
{% set max_length = 200 %}
{% set min_length = 30 %}
{% set num_beams = 4 %}
{% set no_repeat_ngram_size = 3 %}
{% set length_penalty = 2.0 %}
{% set early_stopping = true %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Falconsai__SEP__medical_summarization" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_to_summarize = "{{ text_to_summarize }}"
prefix = "{{ prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_input = tokenizer(prefix + text_to_summarize, return_tensors="pt")
encoded_input = {k: v.to(device) for k, v in encoded_input.items()}

output_ids = model.generate(
    **encoded_input,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
)

summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"summary_text": summary}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "summary.txt"), "w") as f:
        f.write(RESULT["summary_text"])