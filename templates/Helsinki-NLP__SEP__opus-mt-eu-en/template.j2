{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = input_text | default("Kaixo, nola zaude?") %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-eu-en") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load model and tokenizer
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input text
inputs = tokenizer(input_text, return_tensors="pt").to(device)

# Run inference
outputs = model.generate(**inputs)

# Post-process outputs
translation = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]

# Build output dictionary
RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translation.txt"), "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])