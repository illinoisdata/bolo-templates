{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-fr-en") %}
{% set source_text = source_text | default("Bonjour, comment allez-vous aujourd'hui ?") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenizer_inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True, max_length=max_length)
tokenizer_inputs = {k: v.to(device) for k, v in tokenizer_inputs.items()}

generated_ids = model.generate(**tokenizer_inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
