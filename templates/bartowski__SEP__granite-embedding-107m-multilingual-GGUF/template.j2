{% set repo_id = repo_id | default("bartowski/granite-embedding-107m-multilingual-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('granite-embedding-107m-multilingual-Q4_K_M.gguf') %}
{% set text = text | default('Hello world') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
text = "{{ text }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(
    model_path=model_path,
    embedding=True,
    n_ctx=512,
    n_threads=max(1, os.cpu_count() or 1),
    n_batch=512,
    verbose=False,
)

embeddings = llm.create_embedding(input=[text])
output = embeddings["data"][0]["embedding"]
RESULT = {"embedding": output}
