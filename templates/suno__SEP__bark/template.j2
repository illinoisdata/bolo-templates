{% set device = "cuda:0" %}
{% set repo_id = "suno/bark" %}
{% set text_prompt = "Hello, my name is Suno. Bark is speaking to demonstrate text-to-audio inference." %}
{% set do_sample = true %}
{% set temperature = 1.0 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"
do_sample = {{ "True" if do_sample else "False" }}
temperature = {{ temperature }}

import torch
from pathlib import Path
from transformers import AutoModel, AutoProcessor
from scipy.io.wavfile import write as write_wav

torch_device = torch.device(device)
processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(torch_device)

inputs = processor(text=[text_prompt], return_tensors="pt")
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

generation_kwargs = {"do_sample": do_sample, "temperature": temperature}
speech_values = model.generate(**inputs, **generation_kwargs)

speech_tensor = speech_values.cpu().float().squeeze()
audio_array = speech_tensor.numpy()

sampling_rate_value = getattr(model.generation_config, "sample_rate", None)
if sampling_rate_value is None:
    sampling_rate_value = getattr(model.config, "sample_rate", 24000)
sampling_rate = int(sampling_rate_value)

RESULT = {"sampling_rate": sampling_rate, "audio": audio_array}
