{% set repo_id = repo_id %}
{% set device = device %}
{% set context_text = "A passage describing the Retriever context for Natural Questions" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/soheeyang__SEP__rdr-ctx_encoder-single-nq-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
context_text = "{{ context_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import numpy as np
import torch
from transformers import DPRContextEncoder, AutoTokenizer

model_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = DPRContextEncoder.from_pretrained(repo_id)
model = model.to(model_device)
model.eval()

tokenized_inputs = tokenizer(context_text, return_tensors="pt", truncation=True, padding=True)
inputs = {key: value.to(model_device) for key, value in tokenized_inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

context_embedding = outputs.pooler_output.detach().cpu()

RESULT = {"context_embedding": context_embedding}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    embedding_path = output_path / "context_embedding.npy"
    np.save(embedding_path, RESULT["context_embedding"].numpy())