{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-tr-en") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default(["Allahsızlığı Yayma Kürsüsü başkanıydı.", "Tom'a ne olduğunu öğrenin."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spm_source_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
spm_target_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from the repo files downloaded above.
tokenizer = MarianTokenizer.from_pretrained(repo_id, local_files_only=True)
model = MarianMTModel.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs)

translated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translations": translated_texts}
