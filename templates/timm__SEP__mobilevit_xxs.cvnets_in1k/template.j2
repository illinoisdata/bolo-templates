{% set repo_id = repo_id | default("timm/mobilevit_xxs.cvnets_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}
{% set device_str = device_str | default(device|string) -%}
{% if device_str.startswith("cuda") -%}
{% if ":" in device_str -%}
{% set pipeline_device = (device_str.split(":")[-1] | int) -%}
{% else -%}
{% set pipeline_device = 0 -%}
{% endif -%}
{% else -%}
{% set pipeline_device = -1 -%}
{% endif %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
pipeline_device = {{ pipeline_device }}
image_path = {{ image_path | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)

input_image_path = image_path

raw_outputs = pipe(input_image_path)

RESULT = {"predictions": raw_outputs}
