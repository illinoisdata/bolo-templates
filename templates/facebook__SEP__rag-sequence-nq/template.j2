{% set device = "cuda:0" %}
{% set repo_id = "facebook/rag-sequence-nq" %}
{% set question = "how many countries are in europe" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
from pathlib import Path
from transformers import RagRetriever, RagSequenceForGeneration, RagTokenizer

# Load tokenizer, retriever, and generative model
tokenizer = RagTokenizer.from_pretrained(repo_id)
retriever = RagRetriever.from_pretrained(repo_id, index_name="exact", use_dummy_dataset=True)
model = RagSequenceForGeneration.from_pretrained(repo_id, retriever=retriever).to(device)

# Preprocess the input text prompt
raw_inputs = tokenizer(question, return_tensors="pt")
filtered_inputs = {key: tensor for key, tensor in raw_inputs.items() if key in {"input_ids", "attention_mask"}}
inputs = {key: tensor.to(device) for key, tensor in filtered_inputs.items()}

# Run inference to generate an answer
generated_ids = model.generate(**inputs, num_beams=1, num_return_sequences=1).cpu()
answer = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

# Inference results are stored in this dict for downstream evaluation
RESULT = {"answer": answer}
