{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ar-fr") %}
{% set source_text = source_text | default("السلام عليكم") %}
{% set max_length = max_length | default(512) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))
encoding = tokenizer(source_text, return_tensors="pt", padding=True)
encoding = {key: tensor.to(torch.device(device)) for key, tensor in encoding.items()}
generated_ids = model.generate(**encoding, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"translation": translation}
