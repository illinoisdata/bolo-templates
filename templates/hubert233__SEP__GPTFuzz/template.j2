{% set repo_id = repo_id | default("hubert233/GPTFuzz") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-classification") %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}
{% set id2label_values = id2label_values | default({"0": "non-toxic", "1": "toxic"}) %}
{% set label2id_values = label2id_values | default({"non-toxic": 0, "toxic": 1}) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
id2label_values = {{ id2label_values | tojson }}
label2id_values = {{ label2id_values | tojson }}

import json
import os
from huggingface_hub import snapshot_download
from transformers import pipeline

model_path = snapshot_download(repo_id=repo_id)
config_path = os.path.join(model_path, "config.json")
with open(config_path, "r", encoding="utf-8") as config_file:
    config_dict = json.load(config_file)
config_dict["id2label"] = id2label_values
config_dict["label2id"] = label2id_values
with open(config_path, "w", encoding="utf-8") as config_file:
    json.dump(config_dict, config_file)

pipe = pipeline(task=task, model=model_path, device=device)
RESULT = pipe(input_prompt)
