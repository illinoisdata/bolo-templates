{% set repo_id = repo_id | default("h2oai/h2ogpt-oig-oasst1-512-6_9b") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set device_arg = device_arg | default(device) %}
{% set input_prompt = input_prompt | default("Please provide a brief, considerate explanation on the importance of staying well hydrated.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set temperature = temperature | default(0.4) %}
{% set top_p = top_p | default(0.9) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device_arg | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}

from transformers import AutoConfig, pipeline

config = AutoConfig.from_pretrained(model)
config.custom_pipelines = {}
pipe = pipeline(task=task, model=model, config=config, device=device)

generation_kwargs = {
    "max_new_tokens": max_new_tokens,
    "temperature": temperature,
    "top_p": top_p,
}

pipeline_output = pipe(input_prompt, **generation_kwargs)
RESULT = {"outputs": pipeline_output}
