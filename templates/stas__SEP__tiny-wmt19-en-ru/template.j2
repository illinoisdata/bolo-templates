{% set repo_id = repo_id | default("stas/tiny-wmt19-en-ru") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('Hello world!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_src_path = hf_hub_download(repo_id=repo_id, filename="vocab-src.json")
vocab_tgt_path = hf_hub_download(repo_id=repo_id, filename="vocab-tgt.json")

# Use the downloaded file paths directly; tokenizer/model loaders resolve the directory from a cached file path.
model_dir = os.path.dirname(model_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(**inputs, max_length=20, num_beams=5)
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)

RESULT = {"output_text": output_text}
