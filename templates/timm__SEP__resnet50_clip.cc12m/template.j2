repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import os
import json
import torch
import timm
import requests
import numpy as np
from PIL import Image
from io import BytesIO
from torchvision import transforms
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, 'r') as f:
    cfg = json.load(f)

pretrained_cfg = cfg.get('pretrained_cfg', {})
mean = pretrained_cfg.get('mean', [0.48145466, 0.4578275, 0.40821073])
std = pretrained_cfg.get('std', [0.26862954, 0.26130258, 0.27577711])
input_size = pretrained_cfg.get('input_size', [3, 224, 224])[1:]

if image_path.startswith('http://') or image_path.startswith('https://'):
    response = requests.get(image_path, timeout=30)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

transform = transforms.Compose([
    transforms.Resize(int(round(input_size[0] / 0.9))),
    transforms.CenterCrop(input_size),
    transforms.ToTensor(),
    transforms.Normalize(mean=mean, std=std),
])

x = transform(image).unsqueeze(0).to(device)

model = timm.create_model('resnet50_clip', pretrained=False, num_classes=1024)
state_dict = torch.load(model_path, map_location='cpu')
model.load_state_dict(state_dict)
model.eval()
model.to(device)

with torch.no_grad():
    logits = model(x)
    probs = torch.softmax(logits, dim=-1)
    topk = torch.topk(probs, k=5, dim=-1)

RESULT = {
    'logits': logits.squeeze(0).detach().cpu().numpy(),
    'probabilities': probs.squeeze(0).detach().cpu().numpy(),
    'top_indices': topk.indices.squeeze(0).detach().cpu().tolist(),
    'top_scores': topk.values.squeeze(0).detach().cpu().tolist(),
}
