{% set repo_id = repo_id | default("Wguy/t5_typo_correction_V3") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Ths is a smple sentence with typoes to corect.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Derive cache directory from a downloaded file path, as required.
import os
repo_dir = os.path.dirname(model_path)

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=64)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
