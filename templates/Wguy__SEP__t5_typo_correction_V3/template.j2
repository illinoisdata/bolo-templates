{% set device = "cuda:0" %}
{% set repo_id = "Wguy/t5_typo_correction_V3" %}
{% set input_text = "Ths is a smaple text with typos for correction." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
model_inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**model_inputs)
decoded_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"correction": decoded_texts[0]}
