{% set repo_id = repo_id | default("EMBO/BioMegatron345mUncased") %}
{% set device = device | default("cuda:0") %}
{% set mask_text = mask_text | default('The capital of France is [MASK]') %}
{% set label_text = label_text | default('The capital of France is Paris') %}
{% set batch_size = batch_size | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
mask_text = "{{ mask_text }}"
label_text = "{{ label_text }}"
batch_size = {{ batch_size }}

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([mask_text] * batch_size, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
labels = tokenizer([label_text] * batch_size, return_tensors="pt", padding=True)["input_ids"].to(device)

with torch.no_grad():
    output = model(**inputs, labels=labels)

RESULT = {
    "loss": output.loss.detach().cpu(),
    "logits": output.logits.detach().cpu(),
    "input_ids": inputs["input_ids"].detach().cpu(),
    "labels": labels.detach().cpu(),
}
