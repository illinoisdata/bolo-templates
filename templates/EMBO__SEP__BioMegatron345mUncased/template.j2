{% set device = "cuda:0" %}
{% set repo_id = "EMBO/BioMegatron345mUncased" %}
{% set input_text = "The capital of France is [MASK]." %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}

import torch
from pathlib import Path
from transformers import AutoModelForMaskedLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
predicted_token_ids = logits.argmax(dim=-1)

mask_token_id = tokenizer.mask_token_id
if mask_token_id is None:
    mask_positions = []
    predicted_mask_token_ids = []
    predicted_mask_tokens = []
else:
    input_ids = inputs["input_ids"]
    mask_indices = input_ids == mask_token_id
    mask_positions = mask_indices[0].to("cpu").nonzero(as_tuple=True)[0].tolist()
    predicted_mask_token_ids = predicted_token_ids[0, mask_indices[0]].detach().cpu().tolist()
    predicted_mask_tokens = tokenizer.convert_ids_to_tokens(predicted_mask_token_ids)

RESULT = {
    "predicted_mask_tokens": predicted_mask_tokens,
    "predicted_mask_token_ids": predicted_mask_token_ids,
    "mask_positions": mask_positions,
}
