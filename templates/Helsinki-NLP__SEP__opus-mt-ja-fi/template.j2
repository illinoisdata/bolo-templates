{% set repo_id = "Helsinki-NLP/opus-mt-ja-fi" %}
{% set device = "cuda:0" %}
{% set input_text = "これはテストです。" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from transformers import AutoModelForSeq2SeqLM, MarianTokenizer
import os

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer([input_text], return_tensors="pt", padding=True).to(device)
generated_ids = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
