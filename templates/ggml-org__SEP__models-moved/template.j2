{% set repo_id = repo_id | default("ggml-org/models-moved") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("tinyllamas/stories15M.gguf") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"

import os
from huggingface_hub import hf_hub_download
import numpy as np
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(model_path=model_path, n_ctx=64, n_threads=2, n_gpu_layers=0, verbose=False)

prompt = "Write a one-sentence story about a tiny llama."
output = llm(prompt, max_tokens=32, temperature=0.0, top_p=1.0, stop=["</s>"])
text = output["choices"][0]["text"]

RESULT = {"text": text}
