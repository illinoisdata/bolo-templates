{% set repo_id = repo_id | default("Qwen/Qwen3-Embedding-0.6B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen3-Embedding-0.6B-Q8_0.gguf') %}
{% set query_text = query_text | default('What is the capital of France?') %}
{% set document_text = document_text | default('Paris is the capital and most populous city of France.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
query_text = "{{ query_text }}"
document_text = "{{ document_text }}"

import os
import numpy as np
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=weights_path,
    embedding=True,
    n_ctx=512,
    n_threads=max(1, os.cpu_count() or 1),
    verbose=False,
)

query_result = llm.create_embedding(query_text)
doc_result = llm.create_embedding(document_text)
query_embedding = np.array(query_result["data"][0]["embedding"], dtype=np.float32)
document_embedding = np.array(doc_result["data"][0]["embedding"], dtype=np.float32)

similarity = float(np.dot(query_embedding, document_embedding) / (np.linalg.norm(query_embedding) * np.linalg.norm(document_embedding)))

RESULT = {
    "query_embedding": query_embedding,
    "document_embedding": document_embedding,
    "similarity": similarity,
}
