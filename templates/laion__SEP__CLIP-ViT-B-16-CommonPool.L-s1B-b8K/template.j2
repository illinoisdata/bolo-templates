{% set repo_id = repo_id | default("laion/CLIP-ViT-B-16-CommonPool.L-s1B-b8K") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_queries = text_queries | default(['a cat', 'a dog', 'a car', 'an airplane']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_queries = {{ text_queries }}

import json
import torch
import open_clip
from PIL import Image
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")

with open(config_path, 'r') as f:
    config = json.load(f)

if isinstance(image_path, str) and urlparse(image_path).scheme in ('http', 'https'):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

model = open_clip.create_model('ViT-B-16', pretrained=None, precision='fp32')
state_dict = torch.load(weights_path, map_location='cpu')
if 'state_dict' in state_dict:
    state_dict = state_dict['state_dict']
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

preprocess = open_clip.image_transform(
    image_size=config['preprocess_cfg'].get('image_size', 224),
    is_train=False,
    mean=tuple(config['preprocess_cfg']['mean']),
    std=tuple(config['preprocess_cfg']['std']),
)
image_tensor = preprocess(image).unsqueeze(0).to(device)

tokenizer = open_clip.get_tokenizer('ViT-B-16')
text_tokens = tokenizer(text_queries).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logits = (100.0 * image_features @ text_features.T).softmax(dim=-1)
    probs = logits.squeeze(0).detach().cpu().tolist()

RESULT = {"text_queries": text_queries, "probabilities": probs}
