{% set sentence = "I like to swimming" %}
{% set max_length = 128 %}
{% set num_beams = 5 %}
{% set early_stopping = True %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Unbabel__SEP__gec-t5_small" %}

sentence = "{{ sentence }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
early_stopping = {{ early_stopping }}
output_dir = "{{ output_dir }}"
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import os
from transformers import T5ForConditionalGeneration, T5Tokenizer

model = T5ForConditionalGeneration.from_pretrained(repo_id)
tokenizer = T5Tokenizer.from_pretrained("t5-small")
model.to(device)

inputs = tokenizer("gec: " + sentence, max_length=max_length, truncation=True, padding="max_length", return_tensors="pt")
input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)

generated_ids = model.generate(input_ids=input_ids, attention_mask=attention_mask, max_length=max_length, num_beams=num_beams, early_stopping=early_stopping)[0]
corrected_sentence = tokenizer.decode(generated_ids, skip_special_tokens=True, clean_up_tokenization_spaces=True)

RESULT = {"corrected_sentence": corrected_sentence}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "corrected_sentence.txt")
    with open(output_path, "w") as f:
        f.write(RESULT["corrected_sentence"])