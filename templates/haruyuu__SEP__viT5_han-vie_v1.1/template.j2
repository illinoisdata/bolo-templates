{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("haruyuu/viT5_han-vie_v1.1") %}
{% set mapping_file = mapping_file | default("map.json") %}
{% set input_text = input_text | default('谁知道 “ 你三更半夜回家发现自己忘记带钥匙，家里又没有其他人在，这时你最大的愿望是什么？ ” 的正确答案是什么呀？') %}
device = "{{ device }}"
repo_id = "{{ repo_id }}"
mapping_file = "{{ mapping_file }}"
input_text = "{{ input_text }}"

import os
# Disable fast tokenizer to avoid tokenizers Unigram parsing issues
os.environ.setdefault("TRANSFORMERS_NO_FAST_TOKENIZER", "1")
import json
import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer

# Load tokenizer and model
tokenizer = T5Tokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id).to(device)

# Pre-process input
mapping_dict = {}
if os.path.isfile(mapping_file):
    with open(mapping_file, encoding="utf-8") as f:
        mapping_dict = json.load(f)
def mapping(text):
    for k, v in mapping_dict.items():
        text = text.replace(k, f" {v} ")
    return text.strip()
processed_text = mapping(input_text)
input_ids = tokenizer.encode(processed_text, return_tensors="pt").to(device)

# Run inference
translated_ids = model.generate(input_ids)
translated_text = tokenizer.decode(translated_ids[0], skip_special_tokens=True)

# Post-process & build RESULT dict
RESULT = {"translation": translated_text}
