{% set repo_id = repo_id | default("facebook/sapiens") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is shown in the image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import os
import torch
from PIL import Image
from transformers import pipeline

image_path = "/u/yunqili4/projects/ML-code-generation/data/image1.jpeg"
if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(__import__('requests').get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

classifier = pipeline(
    task="image-classification",
    model="google/vit-base-patch16-224",
    device=0 if str(device).startswith("cuda") and torch.cuda.is_available() else -1,
)

pred = classifier(image)
output = pred

RESULT = {"output": output}
