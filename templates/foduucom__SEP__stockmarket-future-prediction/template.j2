{% set repo_id = repo_id | default("foduucom/stockmarket-future-prediction") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import io
import requests
from urllib.parse import urlparse
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from ultralytics import YOLO
from ultralyticsplus import render_result

weights = hf_hub_download(repo_id=repo_id, filename='best.pt')
_ = hf_hub_download(repo_id=repo_id, filename='config.json')

if isinstance(image_path, str) and urlparse(image_path).scheme in ('http', 'https'):
    response = requests.get(image_path, timeout=30)
    response.raise_for_status()
    input_image = Image.open(io.BytesIO(response.content)).convert('RGB')
else:
    input_image = Image.open(image_path).convert('RGB')

import ultralytics.nn.modules as um
import ultralytics.yolo.utils as uy
from ultralytics.nn.tasks import DetectionModel
from torch.nn.modules.container import Sequential, ModuleList, ModuleDict
from torch.nn.modules.conv import Conv2d
from torch.nn.modules.batchnorm import BatchNorm2d
from torch.nn.modules.activation import SiLU, ReLU, LeakyReLU, Sigmoid
from torch.nn.modules.pooling import MaxPool2d, AdaptiveAvgPool2d, AvgPool2d
from torch.nn.modules.linear import Linear
from torch.nn.modules.upsampling import Upsample
from torch.nn.modules.flatten import Flatten
from torch.nn.modules.dropout import Dropout
from torch.nn.modules.padding import ZeroPad2d

safe_list = [DetectionModel, Sequential, ModuleList, ModuleDict, Conv2d, BatchNorm2d, SiLU, ReLU, LeakyReLU, Sigmoid, MaxPool2d, AdaptiveAvgPool2d, AvgPool2d, Linear, Upsample, Flatten, Dropout, ZeroPad2d, uy.IterableSimpleNamespace]
for name in dir(um):
    obj = getattr(um, name)
    if isinstance(obj, type):
        safe_list.append(obj)

with torch.serialization.safe_globals(safe_list):
    model = YOLO(weights)

model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(input_image, device=device, verbose=False)
result0 = results[0]
rendered = render_result(model=model, image=input_image, result=result0)
boxes = result0.boxes
names = model.names if hasattr(model, 'names') else result0.names
labels = [names[int(cls)] for cls in boxes.cls.tolist()] if boxes is not None and len(boxes) else []
confidences = boxes.conf.tolist() if boxes is not None and len(boxes) else []
xyxy = boxes.xyxy.tolist() if boxes is not None and len(boxes) else []

RESULT = {
    'image': rendered,
    'labels': labels,
    'confidences': confidences,
    'boxes': xyxy,
}
