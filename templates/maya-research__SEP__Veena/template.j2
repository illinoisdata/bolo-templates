{% set repo_id = repo_id | default("maya-research/Veena") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("आज मैंने एक नई तकनीक के बारे में सीखा जो कृत्रिम बुद्धिमत्ता का उपयोग करके मानव जैसी आवाज़ उत्पन्न कर सकती है।") %}
{% set speaker = speaker | default("kavya") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
speaker = "{{ speaker }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForCausalLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")
with open(index_path, "r", encoding="utf-8") as f:
    import json
    weight_map = json.load(f)["weight_map"]
first_weight_file = sorted(set(weight_map.values()))[0]
model_weight_path = hf_hub_download(repo_id=repo_id, filename=first_weight_file)
tokenizer_dir = hf_hub_download(repo_id=repo_id, filename="tokenizer.json").rsplit("/", 1)[0]
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=True, local_files_only=True)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
)
model.to(device)
model.eval()

START_OF_SPEECH_TOKEN = 128257
END_OF_SPEECH_TOKEN = 128258
START_OF_HUMAN_TOKEN = 128259
END_OF_HUMAN_TOKEN = 128260
START_OF_AI_TOKEN = 128261
END_OF_AI_TOKEN = 128262
AUDIO_CODE_BASE_OFFSET = 128266

prompt = f"<spk_{speaker}> {text}"
prompt_tokens = tokenizer.encode(prompt, add_special_tokens=False)
input_tokens = [START_OF_HUMAN_TOKEN, *prompt_tokens, END_OF_HUMAN_TOKEN, START_OF_AI_TOKEN, START_OF_SPEECH_TOKEN]
input_ids = torch.tensor([input_tokens], device=device)

with torch.no_grad():
    output = model.generate(
        input_ids,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        pad_token_id=tokenizer.eos_token_id,
        eos_token_id=[END_OF_SPEECH_TOKEN, END_OF_AI_TOKEN],
    )

generated_ids = output[0][len(input_tokens):].tolist()
RESULT = {"generated_token_ids": generated_ids, "input_token_count": len(input_tokens)}
