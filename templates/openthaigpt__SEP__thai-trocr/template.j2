{% set repo_id = repo_id | default("openthaigpt/thai-trocr") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set max_new_tokens = max_new_tokens | default(64) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
max_new_tokens = {{ max_new_tokens }}

import os
import requests
import torch
from PIL import Image
from transformers import TrOCRProcessor, VisionEncoderDecoderModel
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = TrOCRProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model.to(device)
model.eval()

if isinstance(image, str) and image.startswith(("http://", "https://")):
    image_obj = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

pixel_values = processor(images=image_obj, return_tensors="pt").pixel_values.to(device)
with torch.no_grad():
    generated_ids = model.generate(pixel_values, max_new_tokens=max_new_tokens)
text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": text}
