{% set repo_id = repo_id | default("timm/deit_tiny_distilled_patch16_224.fb_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set top_k = top_k | default(5) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"
top_k = {{ top_k }}

from transformers import pipeline
from PIL import Image

# Load pipeline
pipe = pipeline(task=task, model=repo_id, device=device)

# Pre-process input
img = Image.open(input_image)

# Run inference
_raw_result = pipe(img, top_k=top_k)

# Post-process & build RESULT dict
RESULT = {"predictions": _raw_result}
