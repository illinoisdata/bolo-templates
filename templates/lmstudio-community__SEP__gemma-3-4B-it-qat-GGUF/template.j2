{% set repo_id = repo_id | default("lmstudio-community/gemma-3-4B-it-qat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe the image in a concise but detailed way.') %}
{% set quant_filename = quant_filename | default('gemma-3-4B-it-QAT-Q4_0.gguf') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"
quant_filename = "{{ quant_filename }}"

import requests
from io import BytesIO
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename='mmproj-model-f16.gguf')

if isinstance(image_path, str) and image_path.startswith(('http://', 'https://')):
    image = Image.open(BytesIO(requests.get(image_path, stream=True).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

llm = Llama(
    model_path=weights_path,
    mmproj_path=mmproj_path,
    n_ctx=4096,
    n_gpu_layers=0 if device.startswith('cpu') else -1,
    verbose=False,
)

messages = [
    {
        'role': 'user',
        'content': [
            {'type': 'image', 'image': image},
            {'type': 'text', 'text': prompt},
        ],
    }
]
output = llm.create_chat_completion(
    messages=messages,
    temperature=0.2,
    top_p=0.95,
    max_tokens=128,
)
text_output = output['choices'][0]['message']['content']

RESULT = {'output': text_output}
