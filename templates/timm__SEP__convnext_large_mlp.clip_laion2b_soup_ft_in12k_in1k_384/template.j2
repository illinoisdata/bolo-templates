{% set repo_id = repo_id | default("timm/convnext_large_mlp.clip_laion2b_soup_ft_in12k_in1k_384") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_image = {{ input_image | tojson }}

if isinstance(device, str):
    if device.startswith("cuda"):
        gpu_part = device.split(":", 1)[1] if ":" in device else "0"
        try:
            pipeline_device = int(gpu_part)
        except ValueError:
            pipeline_device = 0
    elif device == "cpu":
        pipeline_device = -1
    else:
        pipeline_device = int(device)
else:
    pipeline_device = device

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)

image_input = input_image

inference_output = pipe(image_input)

RESULT = {"predictions": inference_output}
