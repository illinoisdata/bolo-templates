{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("microsoft/layoutlm-base-cased") %}
{% set document_words = document_words | default(["Hello", "world"]) %}
{% set bounding_boxes = bounding_boxes | default([[0, 0, 0, 0], [0, 0, 0, 0]]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
document_words = {{ document_words }}
bounding_boxes = {{ bounding_boxes }}

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    document_words,
    boxes=bounding_boxes,
    return_tensors="pt",
    is_split_into_words=True,
)
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state
RESULT = {"last_hidden_state": last_hidden_state.detach().cpu()}
