{% set repo_id = repo_id | default("MaziyarPanahi/gemma-3-1b-it-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-3-1b-it.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short, helpful response about why open-source models are useful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from gguf import GGUFReader

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
reader = GGUFReader(model_path)
num_tensors = len(reader.tensors)
num_kv = len(reader.fields)

RESULT = {"num_tensors": num_tensors, "num_kv": num_kv}
