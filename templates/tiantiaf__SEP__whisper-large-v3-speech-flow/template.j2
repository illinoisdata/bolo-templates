{% set repo_id = repo_id | default("tiantiaf/whisper-large-v3-speech-flow") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set disfluency_type_labels = disfluency_type_labels | default(['Block', 'Prolongation', 'Sound Repetition', 'Word Repetition', 'Interjection']) %}
{% set threshold = threshold | default(0.7) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
disfluency_type_labels = {{ disfluency_type_labels }}
threshold = {{ threshold }}

import json
import io
import torch
import torch.nn.functional as F
import torch.nn as nn
import soundfile as sf
import requests
from huggingface_hub import hf_hub_download
from transformers import WhisperForAudioClassification, WhisperFeatureExtractor

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
with open(config_file, "r") as f:
    model_config = json.load(f)

model = WhisperForAudioClassification.from_pretrained("openai/whisper-large-v3").to(device)
model.eval()
feature_extractor = WhisperFeatureExtractor.from_pretrained("openai/whisper-large-v3")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_bytes = requests.get(audio_path, timeout=30).content
    audio, sample_rate = sf.read(io.BytesIO(audio_bytes))
else:
    audio, sample_rate = sf.read(audio_path)

if audio.ndim > 1:
    audio = audio.mean(axis=1)

if sample_rate != 16000:
    import torchaudio
    audio_tensor = torch.tensor(audio, dtype=torch.float32)
    audio_tensor = torchaudio.functional.resample(audio_tensor.unsqueeze(0), sample_rate, 16000).squeeze(0)
    audio = audio_tensor.numpy()
    sample_rate = 16000

inputs = feature_extractor(audio, sampling_rate=sample_rate, return_tensors="pt")
inputs = {k: v.to(device=device, dtype=next(model.parameters()).dtype) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probs = F.softmax(logits, dim=-1).detach().cpu().numpy().astype(float).tolist()
labels = model.config.id2label
pred_ids = torch.argmax(logits, dim=-1).detach().cpu().tolist()
predicted_label = [labels[i] for i in pred_ids]

RESULT = {
    "label": predicted_label,
    "probabilities": probs,
}
