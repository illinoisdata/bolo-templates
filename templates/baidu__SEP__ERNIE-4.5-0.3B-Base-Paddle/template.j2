{% set repo_id = repo_id | default("baidu/ERNIE-4.5-0.3B-Base-Paddle") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Large language model is') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.model")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
generation_config_file = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

try:
    torch_dtype = torch.bfloat16
except AttributeError:
    torch_dtype = torch.float32

local_dir = model_file.rsplit('/', 1)[0]
tokenizer = AutoTokenizer.from_pretrained(local_dir, trust_remote_code=True, use_fast=False, legacy=False)
model = AutoModelForCausalLM.from_pretrained(
    local_dir,
    trust_remote_code=True,
    torch_dtype=torch_dtype,
    device_map=None,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

inputs = tokenizer([prompt], add_special_tokens=False, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=64,
        do_sample=False,
    )

output_text = tokenizer.decode(generated_ids[0].tolist(), skip_special_tokens=True)

RESULT = {"text": output_text}
