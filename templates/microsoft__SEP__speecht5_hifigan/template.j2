{% set repo_id = repo_id | default("microsoft/speecht5_hifigan") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import SpeechT5HifiGan

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = SpeechT5HifiGan.from_pretrained(repo_id)
model.to(device)
model.eval()

mel = np.zeros((1, 10, 80), dtype=np.float32)
inputs = torch.tensor(mel, dtype=torch.float32, device=device)
with torch.no_grad():
    waveform = model(inputs)

RESULT = {"audio": waveform.detach().cpu().numpy()}
