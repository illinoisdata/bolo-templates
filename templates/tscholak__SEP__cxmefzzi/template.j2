{% set repo_id = repo_id | default("tscholak/cxmefzzi") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('How many singers do we have?') %}
{% set db_id = db_id | default('concert_singer') %}
{% set schema = schema | default('stadium : stadium_id, location, name, capacity, highest, lowest, average | singer : singer_id, name, country, song_name, song_release_year, age, is_male | concert : concert_id, concert_name, theme, stadium_id, year | singer_in_concert : concert_id, singer_id') %}
{% set max_new_tokens = max_new_tokens | default(64) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
db_id = "{{ db_id }}"
schema = "{{ schema }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

prompt = f"{question} | {db_id} | {schema}"

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location='cpu')
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"prompt": prompt, "output": output_text}
