{% set repo_id = "tscholak/cxmefzzi" %}
{% set device = "cuda:0" %}
{% set question = "How many singers do we have?" %}
{% set db_id = "concert_singer" %}
{% set schema = "stadium : stadium_id, location, name, capacity, highest, lowest, average | singer : singer_id, name, country, song_name, song_release_year, age, is_male | concert : concert_id, concert_name, theme, stadium_id, year | singer_in_concert : concert_id, singer_id" %}
{% set max_length = 512 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
db_id = "{{ db_id }}"
schema = "{{ schema }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_text = f"{question} | {db_id} | {schema}"
inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
generated = decoded[0].strip()

parts = generated.split("|", 1)
db_out = parts[0].strip() if len(parts) > 0 else ""
sql_out = parts[1].strip() if len(parts) > 1 else ""

RESULT = {"db_id": db_out, "sql": sql_out}
