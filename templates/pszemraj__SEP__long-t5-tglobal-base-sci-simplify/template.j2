{% set repo_id = repo_id | default("pszemraj/long-t5-tglobal-base-sci-simplify") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Large earthquakes along a given fault segment do not occur at random intervals because it takes time to accumulate strain energy. This model explains that recurrence intervals depend on slip and strain accumulation, and therefore large ruptures on the same fault segment may occur at roughly regular intervals, though variations can happen.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    tokenizer_file=tokenizer_json_path,
    tokenizer_config=tokenizer_config_path,
    special_tokens_map_file=special_tokens_map_path,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, config=config_path, torch_dtype=torch.float32)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=4096)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=64,
        min_length=8,
        num_beams=4,
        no_repeat_ngram_size=3,
        encoder_no_repeat_ngram_size=4,
        repetition_penalty=3.5,
        length_penalty=0.4,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
