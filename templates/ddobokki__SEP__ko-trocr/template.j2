{% set device = "cuda:0" %}
{% set repo_id = "ddobokki/ko-trocr" %}
{% set image_path = image_path | default('/u/yli77/projects/ML-code-generation/data/image1.jpeg') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
from io import BytesIO
from pathlib import Path

import requests
import torch
import unicodedata
from PIL import Image
from transformers import AutoProcessor, AutoTokenizer, VisionEncoderDecoderModel

torch_device = torch.device(device)

processor = AutoProcessor.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model = model.to(torch_device)
model.eval()

if image_path.startswith(("http://", "https://")):
    response = requests.get(image_path)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pixel_values = processor(image, return_tensors="pt").pixel_values.to(torch_device)
generated_ids = model.generate(pixel_values, max_length=64)
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
generated_text = unicodedata.normalize("NFC", generated_text)

RESULT = {"generated_text": generated_text}
