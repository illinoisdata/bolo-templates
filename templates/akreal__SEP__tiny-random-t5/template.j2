{% set repo_id = repo_id | default("akreal/tiny-random-t5") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('translate English to German: The house is wonderful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import T5ForConditionalGeneration, T5TokenizerFast

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

# Load tokenizer from the model repo if available; fallback to a standard tiny T5 tokenizer vocab via config-compatible defaults.
# For this repo, use a basic T5 tokenizer initialization from pretrained tiny-random-t5 files if present.
try:
    tokenizer = T5TokenizerFast.from_pretrained(repo_id)
except Exception:
    tokenizer = T5TokenizerFast.from_pretrained("t5-small")

model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=16)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)

RESULT = {"generated_text": decoded}
