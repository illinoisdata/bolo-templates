{% set repo_id = "uer/t5-small-chinese-cluecorpussmall" %}
{% set device = "cuda:0" %}
{% set input_text = "作为电子extra0的平台，京东绝对是领先者。如今的刘强extra1已经是身价过extra2的老板。" %}
{% set max_length = 50 %}
{% set do_sample = false %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/uer__SEP__t5-small-chinese-cluecorpussmall" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
do_sample = {{ do_sample }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs.pop("token_type_ids", None)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}
outputs = model.generate(**inputs, max_length=max_length, do_sample=do_sample)
generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_text.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["generated_text"])