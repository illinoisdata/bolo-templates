{% set repo_id = repo_id | default("uer/t5-small-chinese-cluecorpussmall") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("作为电子extra0的平台，京东绝对是领先者。如今的刘强extra1已经是身价过extra2的老板。") %}
{% set max_length = max_length | default(50) %}
{% set do_sample = do_sample | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
do_sample = {{ do_sample }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs.pop("token_type_ids", None)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}
outputs = model.generate(**inputs, max_length=max_length, do_sample=do_sample)
generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
