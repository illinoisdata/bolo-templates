{% set repo_id = repo_id | default("facebook/mms-tts-ara") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('مرحبا، هذا اختبار لتحويل النص إلى كلام باللغة العربية.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import VitsModel, AutoTokenizer

model = VitsModel.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs).waveform

RESULT = {"waveform": waveform.cpu().numpy(), "sampling_rate": model.config.sampling_rate}
