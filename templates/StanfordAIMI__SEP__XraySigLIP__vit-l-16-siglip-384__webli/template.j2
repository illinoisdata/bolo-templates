{% set repo_id = repo_id | default("StanfordAIMI/XraySigLIP__vit-l-16-siglip-384__webli") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-image-classification") %}
{% set input_path = input_path | default("/u/yunqili4/projects/ML-code-generation/data/image2.jpeg") %}
{% set candidate_labels = candidate_labels | default(["cardiomegaly", "pneumonia", "normal", "effusion"]) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"

task = {{ task | tojson }}
input_path = {{ input_path | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

input_data = input_path

RESULT = pipe(input_data, candidate_labels=candidate_labels)
RESULT = {"predictions": RESULT}
