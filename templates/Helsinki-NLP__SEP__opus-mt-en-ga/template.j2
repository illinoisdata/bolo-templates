{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-ga") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('The house is wonderful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"

import os
import torch
from transformers import MarianMTModel, MarianTokenizer, MarianConfig
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
src_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
tgt_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

config = MarianConfig.from_json_file(config_path)
tokenizer = MarianTokenizer(vocab=vocab_path, source_spm=src_spm_path, target_spm=tgt_spm_path)
model = MarianMTModel(config)
state_dict = torch.load(model_path, map_location="cpu")
model.model.load_state_dict({k.replace('model.', ''): v for k, v in state_dict.items() if k.startswith('model.')}, strict=False)
model.final_logits_bias.data.zero_()
model.to(device)
model.eval()

inputs = tokenizer([src_text], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=4, max_length=128)
output_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
