{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ramsrigouthamg/t5_squad_v1") %}
{% set question = question | default("What is the capital of France?") %}
{% set context = context | default("Paris is the capital of France, known for its art, cuisine, and fashion.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_text = f"question: {question}  context: {context}"
inputs = tokenizer(input_text, return_tensors="pt", truncation=True).to(device)

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
answer = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"answer": answer}
