{% set repo_id = repo_id | default("openai/imagegpt-small") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import ImageGPTImageProcessor, ImageGPTForCausalImageModeling

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
repo_dir = os.path.dirname(weights_path)

if image_path.startswith(("http://", "https://")):
    from requests import get
    from io import BytesIO
    image = Image.open(BytesIO(get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = ImageGPTImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = ImageGPTForCausalImageModeling.from_pretrained(repo_dir)
model.load_state_dict(torch.load(weights_path, map_location="cpu"), strict=False)
model.to(device)
model.eval()

inputs = processor(image, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
with torch.no_grad():
    outputs = model(input_ids=input_ids)

pred_ids = torch.argmax(outputs.logits, dim=-1)
RESULT = {"predicted_token_ids": pred_ids.detach().cpu().tolist(), "logits_shape": list(outputs.logits.shape)}
