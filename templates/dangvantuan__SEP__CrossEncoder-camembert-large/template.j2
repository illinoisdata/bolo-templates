{% set repo_id = repo_id | default("dangvantuan/CrossEncoder-camembert-large") %}
{% set device = device | default("cuda:0") %}
{% set sentence1 = sentence1 | default("Un avion est en train de décoller.") %}
{% set sentence2 = sentence2 | default("Un homme joue d'une grande flûte.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = {{ sentence1 | tojson }}
sentence2 = {{ sentence2 | tojson }}
max_length = {{ max_length }}

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

_tokenizer_dir = __import__('os').path.dirname(tokenizer_path)
model = AutoModelForSequenceClassification.from_pretrained(
    _tokenizer_dir,
    local_files_only=True,
    torch_dtype=torch.float32,
).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(_tokenizer_dir, local_files_only=True)

inputs = tokenizer(
    sentence1,
    sentence2,
    padding=True,
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
score = torch.sigmoid(logits).squeeze().item()

RESULT = {"score": score}
