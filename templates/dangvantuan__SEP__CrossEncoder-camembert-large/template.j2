{% set device = "cuda:0" %}
{% set repo_id = "dangvantuan/CrossEncoder-camembert-large" %}
{% set sentence_pairs = [
    ("Un avion est en train de décoller.", "Un homme joue d'une grande flûte."),
    ("Un homme étale du fromage râpé sur une pizza.", "Une personne jette un chat au plafond")
] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence_pairs = {{ sentence_pairs }}

from pathlib import Path
import json

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

model_tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id).to(device)
model.eval()

sentences_left = [pair[0] for pair in sentence_pairs]
sentences_right = [pair[1] for pair in sentence_pairs]
inputs = model_tokenizer(
    sentences_left,
    sentences_right,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    scores_tensor = logits.squeeze(-1)
    if scores_tensor.dim() == 0:
        scores_tensor = scores_tensor.unsqueeze(0)
    similarity_scores = scores_tensor.cpu().tolist()

RESULT = {"similarity_scores": similarity_scores}
