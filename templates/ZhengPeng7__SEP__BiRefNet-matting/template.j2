{% set repo_id = repo_id | default("ZhengPeng7/BiRefNet-matting") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import json
import sys
import types
import requests
import numpy as np
import torch
from io import BytesIO
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file as safe_load_file

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
config_py_path = hf_hub_download(repo_id=repo_id, filename="BiRefNet_config.py")
birefnet_py_path = hf_hub_download(repo_id=repo_id, filename="birefnet.py")

repo_dir = os.path.dirname(model_path)
if repo_dir not in sys.path:
    sys.path.insert(0, repo_dir)

pkg_name = "birefnet_hf_pkg"
pkg = types.ModuleType(pkg_name)
pkg.__path__ = [repo_dir]
sys.modules[pkg_name] = pkg

import importlib.util
spec = importlib.util.spec_from_file_location(f"{pkg_name}.BiRefNet_config", config_py_path)
config_mod = importlib.util.module_from_spec(spec)
sys.modules[f"{pkg_name}.BiRefNet_config"] = config_mod
spec.loader.exec_module(config_mod)

spec = importlib.util.spec_from_file_location(f"{pkg_name}.birefnet", birefnet_py_path)
module = importlib.util.module_from_spec(spec)
sys.modules[f"{pkg_name}.birefnet"] = module
spec.loader.exec_module(module)
BiRefNet = module.BiRefNet

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

with open(config_path, "r") as f:
    cfg = json.load(f)

model = BiRefNet(**cfg.get("model_kwargs", {})) if isinstance(cfg, dict) else BiRefNet()
state_dict = safe_load_file(model_path)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

img = np.array(image).astype(np.float32) / 255.0
img = torch.from_numpy(img).permute(2, 0, 1).unsqueeze(0).to(device)
mean = torch.tensor([0.485, 0.456, 0.406], device=device).view(1, 3, 1, 1)
std = torch.tensor([0.229, 0.224, 0.225], device=device).view(1, 3, 1, 1)
img = (img - mean) / std

with torch.no_grad():
    out = model(img)

if isinstance(out, (tuple, list)):
    out = out[0]
if out.dim() == 4:
    out = out[0, 0]
elif out.dim() == 3:
    out = out[0]
alpha = out.detach().float().cpu().numpy()
alpha = alpha - alpha.min()
if alpha.max() > 0:
    alpha = alpha / alpha.max()
alpha = (alpha * 255).astype(np.uint8)
alpha_image = Image.fromarray(alpha, mode="L")

RESULT = {"alpha_matte": alpha_image}
