{% set repo_id = repo_id | default("sshleifer/tinier_bart") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog while keeping a watchful eye on the distant hills.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(**inputs)
summary = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary}
