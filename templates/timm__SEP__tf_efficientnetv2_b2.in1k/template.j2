{% set repo_id = repo_id | default("timm/tf_efficientnetv2_b2.in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

img = Image.open(input_image).convert("RGB")

pipe_result = pipe(img)

RESULT = {"predictions": pipe_result}
