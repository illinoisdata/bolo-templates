{% set repo_id = repo_id | default("VlSav/Vikhr-Nemo-12B-Instruct-R-21-09-24-Q4_K_M-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('vikhr-nemo-12b-instruct-r-21-09-24-q4_k_m.gguf') %}
{% set prompt = prompt | default('Write a short, helpful answer to: What is the capital of France?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=4,
    n_gpu_layers=-1 if device.startswith('cuda') else 0,
    verbose=False,
)

result = llm(prompt, max_tokens=64, temperature=0.2, top_p=0.95)
output_text = result["choices"][0]["text"]

RESULT = {"text": output_text}
