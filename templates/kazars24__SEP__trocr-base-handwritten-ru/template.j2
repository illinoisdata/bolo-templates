{% set repo_id = repo_id | default("kazars24/trocr-base-handwritten-ru") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yli77/projects/ML-code-generation/data/doc.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

from transformers import TrOCRProcessor, VisionEncoderDecoderModel
from PIL import Image
import requests
from io import BytesIO
import torch
import os

processor = TrOCRProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(device)

if image_path.startswith("http"):
    response = requests.get(image_path)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(device)
generated_ids = model.generate(pixel_values)
generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
