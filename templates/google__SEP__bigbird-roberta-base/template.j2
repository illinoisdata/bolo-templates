{% set input_text = "Replace me by any text you'd like." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = "{{ input_text }}"

from pathlib import Path
import json

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(input_text, return_tensors="pt")
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

outputs = model(**encoded_input)
masked_lm_logits = outputs.prediction_logits
next_sentence_logits = outputs.seq_relationship_logits

prediction_ids = masked_lm_logits.argmax(dim=-1)
prediction_ids_cpu = prediction_ids[0].detach().cpu().tolist()
masked_lm_tokens = tokenizer.convert_ids_to_tokens(prediction_ids_cpu)
masked_lm_text = tokenizer.decode(prediction_ids_cpu, skip_special_tokens=True)
next_sentence_label = int(next_sentence_logits.argmax(dim=-1).item())
next_sentence_logits_cpu = next_sentence_logits[0].detach().cpu().tolist()

RESULT = {
    "masked_lm_tokens": masked_lm_tokens,
    "masked_lm_text": masked_lm_text,
    "next_sentence_label": next_sentence_label,
    "next_sentence_logits": next_sentence_logits_cpu,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "masked_lm_text.txt").write_text(RESULT["masked_lm_text"], encoding="utf-8")
    (output_path / "masked_lm_tokens.json").write_text(
        json.dumps(RESULT["masked_lm_tokens"], ensure_ascii=False), encoding="utf-8"
    )
    (output_path / "next_sentence_label.txt").write_text(str(RESULT["next_sentence_label"]), encoding="utf-8")
    (output_path / "next_sentence_logits.json").write_text(
        json.dumps(RESULT["next_sentence_logits"], ensure_ascii=False), encoding="utf-8"
    )