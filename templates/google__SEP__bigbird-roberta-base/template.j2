{% set repo_id = repo_id | default("google/bigbird-roberta-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

_ = config_path, weights_path

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, vocab_file=spiece_path)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
predicted_token_ids = torch.argmax(logits, dim=-1)
predicted_tokens = tokenizer.convert_ids_to_tokens(predicted_token_ids[0].tolist())

RESULT = {"logits": logits.detach().cpu().tolist(), "predicted_token_ids": predicted_token_ids.detach().cpu().tolist(), "predicted_tokens": predicted_tokens}
