{% set repo_id = repo_id | default("google/switch-base-64") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('A <extra_id_0> walks into a bar and orders a <extra_id_1> with <extra_id_2> pinch of <extra_id_3>.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, SwitchTransformersForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_1 = hf_hub_download(repo_id=repo_id, filename="pytorch_model-00001-of-00002.bin")
weights_2 = hf_hub_download(repo_id=repo_id, filename="pytorch_model-00002-of-00002.bin")
index_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin.index.json")
tokenizer_json = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_cfg_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
gen_cfg_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

local_dir = os.path.dirname(spiece_path)
tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=True)
model = SwitchTransformersForConditionalGeneration.from_pretrained(local_dir, torch_dtype=torch.float32, use_safetensors=False)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=32)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=False)

RESULT = {"output_text": output_text}
