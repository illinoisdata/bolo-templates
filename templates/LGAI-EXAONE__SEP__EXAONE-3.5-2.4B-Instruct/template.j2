{% set repo_id = repo_id | default("LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}

import importlib.util
import json
import os
import sys
import types

import transformers.masking_utils as masking_utils
from huggingface_hub import snapshot_download
from transformers import PreTrainedTokenizerFast, pipeline

_original_create_causal_mask = masking_utils.create_causal_mask

def _create_causal_mask(*args, **kwargs):
    if "input_embeds" in kwargs and "inputs_embeds" not in kwargs:
        kwargs["inputs_embeds"] = kwargs.pop("input_embeds")
    kwargs.pop("cache_position", None)
    return _original_create_causal_mask(*args, **kwargs)

masking_utils.create_causal_mask = _create_causal_mask

repo_path = snapshot_download(repo_id)
package_name = "exaone"
package = types.ModuleType(package_name)
package.__path__ = [repo_path]
sys.modules[package_name] = package

config_spec = importlib.util.spec_from_file_location(
    f"{package_name}.configuration_exaone",
    os.path.join(repo_path, "configuration_exaone.py"),
    submodule_search_locations=package.__path__,
)
configuration_module = importlib.util.module_from_spec(config_spec)
sys.modules[config_spec.name] = configuration_module
config_spec.loader.exec_module(configuration_module)

model_spec = importlib.util.spec_from_file_location(
    f"{package_name}.modeling_exaone",
    os.path.join(repo_path, "modeling_exaone.py"),
    submodule_search_locations=package.__path__,
)
modeling_module = importlib.util.module_from_spec(model_spec)
sys.modules[model_spec.name] = modeling_module
model_spec.loader.exec_module(modeling_module)

ExaoneConfig = configuration_module.ExaoneConfig
ExaoneForCausalLM = modeling_module.ExaoneForCausalLM

config = ExaoneConfig.from_pretrained(repo_path)
model = ExaoneForCausalLM.from_pretrained(repo_path, config=config)
model = model.to(device)

with open(os.path.join(repo_path, "tokenizer_config.json"), "r") as f:
    tokenizer_cfg = json.load(f)
with open(os.path.join(repo_path, "special_tokens_map.json"), "r") as f:
    special_tokens_map = json.load(f)

const_special_tokens = {
    token_name: token_info["content"]
    for token_name, token_info in special_tokens_map.items()
    if isinstance(token_info, dict) and "content" in token_info
}

tokenizer = PreTrainedTokenizerFast(
    tokenizer_file=os.path.join(repo_path, "tokenizer.json"),
    **const_special_tokens,
    clean_up_tokenization_spaces=tokenizer_cfg.get("clean_up_tokenization_spaces", True),
    add_prefix_space=tokenizer_cfg.get("add_prefix_space", False),
    model_max_length=tokenizer_cfg.get("model_max_length"),
)

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)

inputs = input_prompt
outputs = pipe(inputs)
RESULT = {"outputs": outputs}
