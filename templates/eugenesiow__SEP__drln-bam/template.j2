{% set device = device | default("cuda:0") %}
{% set scale = scale | default(2) %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set model_filename = model_filename | default('pytorch_model_2x.pt') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
scale = {{ scale }}
image_path = "{{ image_path }}"
model_filename = "{{ model_filename }}"

import os
import requests
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from super_image import DrlnModel, ImageLoader

model_path = hf_hub_download(repo_id=repo_id, filename=model_filename)

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

model = DrlnModel.from_pretrained(repo_id, scale=scale)
state_dict = torch.load(model_path, map_location='cpu')
if isinstance(state_dict, dict) and 'state_dict' in state_dict:
    state_dict = state_dict['state_dict']
model.load_state_dict(state_dict)
model = model.to(device)
model.eval()

inputs = ImageLoader.load_image(image).to(device)
with torch.no_grad():
    preds = model(inputs)

RESULT = {"output": preds}
