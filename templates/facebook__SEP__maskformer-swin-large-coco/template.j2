{% set repo_id = repo_id | default("facebook/maskformer-swin-large-coco") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-segmentation") -%}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
image = Image.open(input_image)
segmentation_output = pipe(image)
RESULT = {"output": segmentation_output}
