{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "A man playing guitar on a stage." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/lizhuang144__SEP__flan-t5-base-VG-factual-sg" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

# Post-process & build RESULT dict
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "generated_text.txt"), "w") as f:
        f.write(RESULT["generated_text"])