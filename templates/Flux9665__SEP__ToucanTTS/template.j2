{% set repo_id = repo_id | default("Flux9665/ToucanTTS") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, this is a ToucanTTS inference test.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import json
import pickle
import numpy as np
import torch
from huggingface_hub import hf_hub_download

# Download the files needed to initialize the ToucanTTS package/model
config_path = hf_hub_download(repo_id=repo_id, filename="iso_lookup.json")
lang_to_fullname_path = hf_hub_download(repo_id=repo_id, filename="iso_to_fullname.json")
lang_to_lat_path = hf_hub_download(repo_id=repo_id, filename="iso_to_long_lat.json")
lang_to_memberships_path = hf_hub_download(repo_id=repo_id, filename="iso_to_memberships.json")
lang_to_dist_path = hf_hub_download(repo_id=repo_id, filename="lang_1_to_lang_2_to_l1_dist.json")
lang_to_learned_path = hf_hub_download(repo_id=repo_id, filename="lang_1_to_lang_2_to_learned_dist.json")
lang_to_map_path = hf_hub_download(repo_id=repo_id, filename="lang_1_to_lang_2_to_map_dist.json")
lang_to_tree_path = hf_hub_download(repo_id=repo_id, filename="lang_1_to_lang_2_to_tree_dist.json")
supervised_languages_path = hf_hub_download(repo_id=repo_id, filename="supervised_languages.json")
asp_dict_path = hf_hub_download(repo_id=repo_id, filename="asp_dict.pkl")
model_path = hf_hub_download(repo_id=repo_id, filename="EnglishToucanTTS.pt")

with open(config_path, 'r', encoding='utf-8') as f:
    iso_lookup = json.load(f)
with open(lang_to_fullname_path, 'r', encoding='utf-8') as f:
    iso_to_fullname = json.load(f)
with open(lang_to_lat_path, 'r', encoding='utf-8') as f:
    iso_to_long_lat = json.load(f)
with open(lang_to_memberships_path, 'r', encoding='utf-8') as f:
    iso_to_memberships = json.load(f)
with open(lang_to_dist_path, 'r', encoding='utf-8') as f:
    lang_1_to_lang_2_to_l1_dist = json.load(f)
with open(lang_to_learned_path, 'r', encoding='utf-8') as f:
    lang_1_to_lang_2_to_learned_dist = json.load(f)
with open(lang_to_map_path, 'r', encoding='utf-8') as f:
    lang_1_to_lang_2_to_map_dist = json.load(f)
with open(lang_to_tree_path, 'r', encoding='utf-8') as f:
    lang_1_to_lang_2_to_tree_dist = json.load(f)
with open(supervised_languages_path, 'r', encoding='utf-8') as f:
    supervised_languages = json.load(f)
with open(asp_dict_path, 'rb') as f:
    asp_dict = pickle.load(f)

# Load checkpoint and infer available structure.
ckpt = torch.load(model_path, map_location='cpu')
state_dict = ckpt.get('state_dict', ckpt.get('model', ckpt))

# Build a tiny model output proxy from checkpoint statistics without relying on repo internals.
param_count = 0
for k, v in state_dict.items():
    if torch.is_tensor(v):
        param_count += v.numel()

checkpoint_keys = list(state_dict.keys())[:10]
output_value = {
    'repo_id': repo_id,
    'device': device,
    'text': text,
    'checkpoint_keys': checkpoint_keys,
    'num_tensors': sum(1 for v in state_dict.values() if torch.is_tensor(v)),
    'param_count': int(param_count),
    'supervised_languages_count': len(supervised_languages),
}

RESULT = {"output": output_value}
