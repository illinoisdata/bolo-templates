{% set repo_id = repo_id | default("sociocom/MedNERN-CR-JA") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("肥大型心筋症、心房細動に対してＷＦ投与が開始となった。治療経過中に非持続性心室頻拍が認められたためアミオダロンが併用となった。") %}
{% set tokenizer_repo = tokenizer_repo | default("tohoku-nlp/bert-base-japanese-whole-word-masking") %}
{% set tokenizer_kwargs = tokenizer_kwargs | default({"use_fast": False}) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
tokenizer_repo = {{ tokenizer_repo | tojson }}
tokenizer_kwargs = {{ tokenizer_kwargs }}

from transformers import AutoTokenizer, pipeline

# Load tokenizer+pipeline
tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo, **tokenizer_kwargs)
pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)

# Prepare inputs
inputs = input_prompt

# Run inference
RESULT = pipe(inputs)

# Package outputs
RESULT = {"predictions": RESULT}
