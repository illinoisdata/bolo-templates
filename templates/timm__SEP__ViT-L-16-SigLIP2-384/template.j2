{% set repo_id = repo_id | default("timm/ViT-L-16-SigLIP2-384") %}
{% set device = device | default("cuda:0") %}
{% set labels_list = labels_list | default(["a dog", "a cat", "a donut", "a beignet"]) %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
labels_list = {{ labels_list }}
image_path = "{{ image_path }}"

import json
from urllib.parse import urlparse
from urllib.request import urlopen

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from open_clip import create_model_from_pretrained, get_tokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_model.safetensors")
with open(config_path, "r") as f:
    _config = json.load(f)

is_url = urlparse(image_path).scheme in ("http", "https")
if is_url:
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model, preprocess = create_model_from_pretrained("hf-hub:" + repo_id)
model = model.to(device)
model.eval()
tokenizer = get_tokenizer("hf-hub:" + repo_id)

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer(labels_list, context_length=model.context_length).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor, normalize=True)
    text_features = model.encode_text(text_tokens, normalize=True)
    logits = image_features @ text_features.T * model.logit_scale.exp() + model.logit_bias
    text_probs = torch.sigmoid(logits)

scores = text_probs[0].detach().cpu().tolist()
RESULT = {"labels": labels_list, "scores": scores}
