{% set repo_id = repo_id | default("IDEA-CCNL/Randeng-Pegasus-238M-Summary-Chinese") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("在北京冬奥会自由式滑雪女子坡面障碍技巧决赛中，中国选手谷爱凌夺得银牌。祝贺谷爱凌！今天上午，自由式滑雪女子坡面障碍技巧决赛举行。决赛分三轮进行，取选手最佳成绩排名决出奖牌。第一跳，中国选手谷爱凌获得69.90分。在12位选手中排名第三。完成动作后，谷爱凌又扮了个鬼脸，甚是可爱。第二轮中，谷爱凌在道具区第三个障碍处失误，落地时摔倒。获得16.98分。网友：摔倒了也没关系，继续加油！在第二跳失误摔倒的情况下，谷爱凌顶住压力，第三跳稳稳发挥，流畅落地！获得86.23分！此轮比赛，共12位选手参赛，谷爱凌第10位出场。网友：看比赛时我比谷爱凌紧张，加油！") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}

import os
import sys
import types
import torch
from transformers import PegasusForConditionalGeneration, BertTokenizer
from huggingface_hub import hf_hub_download

repo_files = {}
for filename in ["config.json", "pytorch_model.bin", "vocab.txt", "special_tokens_map.json", "tokenizers_pegasus.py", "data_utils.py"]:
    repo_files[filename] = hf_hub_download(repo_id=repo_id, filename=filename)

repo_dir = os.path.dirname(repo_files["config.json"])

# Satisfy tokenizers_pegasus.py imports without depending on the external Fengshenbang package.
fengshen_mod = types.ModuleType("fengshen")
examples_mod = types.ModuleType("fengshen.examples")
pegasus_mod = types.ModuleType("fengshen.examples.pegasus")
sys.modules.setdefault("fengshen", fengshen_mod)
sys.modules.setdefault("fengshen.examples", examples_mod)
sys.modules.setdefault("fengshen.examples.pegasus", pegasus_mod)
sys.path.insert(0, repo_dir)

import data_utils  # noqa: E402
sys.modules["fengshen.examples.pegasus.data_utils"] = data_utils
import tokenizers_pegasus  # noqa: E402

# Use a standard tokenizer with the model's vocab to avoid custom-tokenizer compatibility issues.
tokenizer = BertTokenizer(vocab_file=repo_files["vocab.txt"])
model = PegasusForConditionalGeneration.from_pretrained(repo_dir, torch_dtype=torch.float16 if "cuda" in device else torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items() if k != "token_type_ids"}

with torch.no_grad():
    summary_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=4,
        length_penalty=0.8,
        early_stopping=True,
    )
summary = tokenizer.batch_decode(summary_ids, skip_special_tokens=True, clean_up_tokenization_spaces=False)[0]

RESULT = {"summary": summary}
