{% set repo_id = repo_id | default("Xenova/gte-small") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Represent this sentence for searching relevant passages: The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, BertModel, BertConfig

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_hf_tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Download ONNX weights as specified by the repo structure.
onnx_weights_path = hf_hub_download(repo_id=repo_id, filename="onnx/model.onnx")

# Load tokenizer and PyTorch model from the original base model referenced in config.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
config = BertConfig.from_pretrained(repo_id)
model = BertModel(config)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
attention_mask = inputs["attention_mask"].unsqueeze(-1).type_as(last_hidden_state)
summed = (last_hidden_state * attention_mask).sum(dim=1)
counts = attention_mask.sum(dim=1).clamp(min=1e-9)
embedding = summed / counts
embedding = torch.nn.functional.normalize(embedding, p=2, dim=1)

RESULT = {"embedding": embedding.detach().cpu().numpy(), "onnx_weights_path": onnx_weights_path, "config_path": config_path}
