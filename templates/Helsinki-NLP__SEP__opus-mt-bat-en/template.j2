{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-bat-en" %}
{% set input_text = "Baltic languages are beautiful and unique." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(input_text, return_tensors="pt", padding=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
