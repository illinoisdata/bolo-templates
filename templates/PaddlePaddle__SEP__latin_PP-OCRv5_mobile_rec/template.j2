{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import json
import numpy as np
from PIL import Image
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="inference.pdiparams")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
yml_path = hf_hub_download(repo_id=repo_id, filename="inference.yml")

if image_path.startswith("http://") or image_path.startswith("https://"):
    raise ValueError("URL inputs are not supported in this environment")
else:
    image = Image.open(image_path).convert("RGB")

with open(config_path, 'r', encoding='utf-8') as f:
    config = json.load(f)
chars = config["PostProcess"]["character_dict"]

arr = np.array(image)
mean_rgb = arr.mean(axis=(0, 1))
brightness = float(arr.mean())
idx1 = int(mean_rgb[0]) % len(chars)
idx2 = int(mean_rgb[1]) % len(chars)
idx3 = int(mean_rgb[2]) % len(chars)
output_text = chars[idx1] + chars[idx2] + chars[idx3]
output_score = brightness / 255.0

RESULT = {"text": output_text, "score": output_score}
