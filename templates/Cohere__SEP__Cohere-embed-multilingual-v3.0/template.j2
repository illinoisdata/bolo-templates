{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Cohere/Cohere-embed-multilingual-v3.0") %}
{% set texts = texts | default(["The capital of France is Paris", "PyTorch is a flexible deep learning framework", "Multilingual embeddings unlock powerful search"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
texts = {{ texts | tojson }}

import json
import os

from transformers import AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
encoded_inputs = tokenizer(texts, padding=True, truncation=True)
input_ids = encoded_inputs["input_ids"]
attention_mask = encoded_inputs["attention_mask"]
tokens = [tokenizer.convert_ids_to_tokens(sequence) for sequence in input_ids]

RESULT = {"input_ids": input_ids, "attention_mask": attention_mask, "tokens": tokens}
