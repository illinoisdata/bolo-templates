{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-en-ml" %}
{% set translation_input = "Hello, world!" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_filename = "translations.json" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
translation_input = "{{ translation_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_filename = "{{ output_filename }}"

from pathlib import Path
import json

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_texts = translation_input if isinstance(translation_input, (list, tuple)) else [translation_input]
tokenized_inputs = tokenizer(
    input_texts,
    truncation=True,
    padding=True,
    return_tensors="pt",
    max_length=max_length,
)
tokenized_inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}

generated_tokens = model.generate(
    **tokenized_inputs,
    max_length=max_length,
    num_beams=num_beams,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}
