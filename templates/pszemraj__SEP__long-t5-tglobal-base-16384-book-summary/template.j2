{% set repo_id = repo_id | default("pszemraj/long-t5-tglobal-base-16384-book-summary") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Large earthquakes along a given fault segment do not occur at random intervals because it takes time to accumulate the strain energy for the rupture. The rates at which tectonic plates move and accumulate strain at their boundaries are approximately uniform. Therefore, in first approximation, one may expect that large ruptures of the same fault segment will occur at approximately constant time intervals. The smaller the standard deviation of the average recurrence interval, the more specific could be the long term prediction of a future mainshock.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length | default(64) }}
min_length = {{ min_length | default(8) }}
no_repeat_ngram_size = {{ no_repeat_ngram_size | default(3) }}
early_stopping = {{ early_stopping | default(true) }}
repetition_penalty = {{ repetition_penalty | default(3.5) }}
encoder_no_repeat_ngram_size = {{ encoder_no_repeat_ngram_size | default(4) }}
num_beams = {{ num_beams | default(3) }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
spiece_dir = __import__('os').path.dirname(spiece_path)

_tokenizer = AutoTokenizer.from_pretrained(spiece_dir, use_fast=False)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
_model.to(device)
_model.eval()

inputs = _tokenizer(text, return_tensors="pt", truncation=True, max_length=4096)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = _model.generate(
        **inputs,
        max_length=max_length,
        min_length=min_length,
        no_repeat_ngram_size=no_repeat_ngram_size,
        early_stopping=early_stopping,
        repetition_penalty=repetition_penalty,
        encoder_no_repeat_ngram_size=encoder_no_repeat_ngram_size,
        num_beams=num_beams,
    )

summary = _tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
