{% set repo_id = repo_id | default("timm/eva02_base_patch16_clip_224.merged2b") %}
{% set device = device | default("cuda:0") %}
{% set image1 = image1 | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set image2 = image2 | default('/u/yunqili4/projects/ML-code-generation/data/image2.jpeg') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image1 = "{{ image1 }}"
image2 = "{{ image2 }}"

import os
import json
import torch
import timm
import numpy as np
from PIL import Image
from io import BytesIO
from urllib.request import urlopen
from huggingface_hub import hf_hub_download
from timm.data import resolve_data_config, create_transform

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    cfg = json.load(f)

pretrained_cfg = cfg["pretrained_cfg"]
model = timm.create_model(
    cfg["architecture"],
    pretrained=False,
    num_classes=cfg["num_classes"],
)
state_dict = None
try:
    from safetensors.torch import load_file
    state_dict = load_file(weights_path, device="cpu")
except Exception:
    state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=True)
model.eval()
model.to(device)

if isinstance(image1, str) and image1.startswith(("http://", "https://")):
    img1 = Image.open(BytesIO(urlopen(image1).read())).convert("RGB")
else:
    img1 = Image.open(image1).convert("RGB")
if isinstance(image2, str) and image2.startswith(("http://", "https://")):
    img2 = Image.open(BytesIO(urlopen(image2).read())).convert("RGB")
else:
    img2 = Image.open(image2).convert("RGB")

config = resolve_data_config({}, model=model)
transform = create_transform(**config)

x1 = transform(img1).unsqueeze(0).to(device)
x2 = transform(img2).unsqueeze(0).to(device)

with torch.no_grad():
    out1 = model(x1)
    out2 = model(x2)
    sim = torch.nn.functional.cosine_similarity(out1, out2).item()

RESULT = {"image1_embedding": out1.squeeze(0).detach().cpu(), "image2_embedding": out2.squeeze(0).detach().cpu(), "cosine_similarity": sim}
