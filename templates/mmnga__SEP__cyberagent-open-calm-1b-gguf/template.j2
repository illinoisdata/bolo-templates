{% set repo_id = repo_id | default("mmnga/cyberagent-open-calm-1b-gguf") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('cyberagent-open-calm-1b-q4_0.gguf') %}
{% set prompt = prompt | default('吾輩は猫である。名前は実を言うと、') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = 0
if device.startswith("cuda"):
    n_gpu_layers = -1

llm = Llama(
    model_path=model_path,
    n_ctx=256,
    n_threads=os.cpu_count() or 1,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.9,
    repeat_penalty=1.1,
)

RESULT = {"output": output["choices"][0]["text"]}
