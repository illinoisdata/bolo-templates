{% set repo_id = repo_id | default("keremberke/yolov8n-valorant-detection") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
iou = {{ iou }}
max_det = {{ max_det }}

import requests
from io import BytesIO
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = YOLO(weights_path)
model.to(device)
results = model.predict(source=image, conf=conf, iou=iou, max_det=max_det, device=device, verbose=False)

boxes = results[0].boxes
xyxy = boxes.xyxy.cpu().numpy() if boxes is not None else None
cls = boxes.cls.cpu().numpy() if boxes is not None else None
confidences = boxes.conf.cpu().numpy() if boxes is not None else None
names = [model.names[int(i)] for i in cls.tolist()] if cls is not None else []

RESULT = {"xyxy": xyxy, "cls": cls, "conf": confidences, "names": names}
