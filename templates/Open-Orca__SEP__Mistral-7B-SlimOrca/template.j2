{% set repo_id = repo_id | default("Open-Orca/Mistral-7B-SlimOrca") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set runtime_device = runtime_device | default(device) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you today?") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ runtime_device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

prompt = input_prompt

RESULT = pipe(prompt)
