{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set batch_size = batch_size | default(1) %}
{% set threshold = threshold | default(0.5) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("philschmid/pyannote-segmentation") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
batch_size = {{ batch_size }}
threshold = {{ threshold }}

import os
from pathlib import Path
from urllib.parse import urlparse

import torch
import torchaudio
from huggingface_hub import hf_hub_download
from pyannote.audio import Model
from pyannote.audio.pipelines import VoiceActivityDetection

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.yaml")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    audio_local_path = Path("/tmp") / Path(urlparse(audio_path).path).name
    audio_local_path.write_bytes(requests.get(audio_path, timeout=30).content)
    audio_path = str(audio_local_path)

waveform, sample_rate = torchaudio.load(audio_path)
file = {"waveform": waveform, "sample_rate": sample_rate}

model = Model.from_pretrained(weights_path, map_location=torch.device(device))
pipeline = VoiceActivityDetection(segmentation=model)
pipeline.instantiate({"onset": threshold, "offset": threshold, "min_duration_on": 0.0, "min_duration_off": 0.0})
output = pipeline(file)

RESULT = {"output": output}
