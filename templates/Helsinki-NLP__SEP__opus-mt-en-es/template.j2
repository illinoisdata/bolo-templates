{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-en-es" %}
{% set src_text = "Hello, how are you?" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = {key: value.to(device) for key, value in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded_translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_translations[0].strip()

RESULT = {"translation": translation}
