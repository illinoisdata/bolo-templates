{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/tmp" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}
output_dir = {{ output_dir | tojson }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

tokenized = tokenizer(input_text, return_tensors="pt", padding=True, truncation=True).to(device)

generated_tokens = model.generate(**tokenized)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0] if translations else ""

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")