{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-cs") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('Hello, world!') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}
max_new_tokens = {{ max_new_tokens }}

import torch
from huggingface_hub import hf_hub_download
from transformers import MarianMTModel, MarianTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from the downloaded files' directory.
import os
model_dir = os.path.dirname(weights_path)
tokenizer = MarianTokenizer.from_pretrained(model_dir)
model = MarianMTModel.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer([src_text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
translated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
