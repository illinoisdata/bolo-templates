{% set repo_id = repo_id | default("google/pegasus-newsroom") %}
{% set device = device | default("cuda:0") %}
{% set max_input_length = max_input_length | default(1024) %}
{% set num_beams = num_beams | default(8) %}
{% set text = text | default("The stock market rallied today after a new economic report showed stronger-than-expected growth in consumer spending. Analysts said the report eased recession fears and boosted investor confidence across major indices.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_input_length = {{ max_input_length }}
num_beams = {{ num_beams }}
text = {{ text | tojson }}

import torch
from transformers import PegasusTokenizer, PegasusForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = PegasusTokenizer.from_pretrained(repo_id, use_fast=False, local_files_only=True)
model = PegasusForConditionalGeneration.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(
    text,
    return_tensors="pt",
    truncation=True,
    max_length=max_input_length,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_length=64,
        num_beams=num_beams,
        length_penalty=0.8,
        early_stopping=True,
    )
summary = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"summary": summary}
