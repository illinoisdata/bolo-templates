{% set repo_id = repo_id | default("monologg/koelectra-small-v3-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('이 영화는 정말 재미있고 감동적이었다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForPreTraining, ElectraConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = ElectraConfig.from_json_file(config_path)
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    tokenizer_config_file=tokenizer_config_path,
    vocab_file=vocab_path,
    use_fast=False,
)
model = AutoModelForPreTraining.from_config(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("electra.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.softmax(logits, dim=-1)
prediction = int(torch.argmax(probabilities, dim=-1).item())
score = float(probabilities[0, prediction].item())

RESULT = {"prediction": prediction, "score": score, "logits": logits.detach().cpu().tolist()}
