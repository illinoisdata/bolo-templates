{% set repo_id = repo_id | default("monologg/koelectra-small-v3-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("이 문장은 KoELECTRA 사전학습 모델 테스트용 예시입니다.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import json
import os

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

prediction_ids = outputs.logits.argmax(dim=-1)
prediction_tokens = tokenizer.batch_decode(prediction_ids.detach().cpu(), skip_special_tokens=True)
logits = outputs.logits.detach().cpu().tolist()

RESULT = {
    "predicted_tokens": prediction_tokens,
    "logits": logits,
}
