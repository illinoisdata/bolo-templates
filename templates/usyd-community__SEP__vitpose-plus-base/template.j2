{% set person_threshold = person_threshold | default(0.3) %}
{% set pose_threshold = pose_threshold | default(0.3) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("usyd-community/vitpose-plus-base") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
person_threshold = {{ person_threshold }}
pose_threshold = {{ pose_threshold }}

import os
import requests
import torch
from PIL import Image
from transformers import AutoProcessor, VitPoseForPoseEstimation
from huggingface_hub import hf_hub_download

import transformers.models.vitpose.image_processing_vitpose as vitpose_ip
from scipy.linalg import inv as scipy_inv
vitpose_ip.inv = scipy_inv

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

if image.startswith("http://") or image.startswith("https://"):
    image_obj = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

processor = AutoProcessor.from_pretrained(os.path.dirname(processor_path))
model = VitPoseForPoseEstimation.from_pretrained(os.path.dirname(weights_path), torch_dtype=torch.float32)
model = model.to(device)
model.eval()

person_boxes = torch.tensor([[0.0, 0.0, float(image_obj.width), float(image_obj.height)]], device=device).cpu().numpy()
inputs = processor(image_obj, boxes=[person_boxes], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
inputs["dataset_index"] = torch.tensor([0], device=device)

with torch.no_grad():
    outputs = model(**inputs)

pose_results = processor.post_process_pose_estimation(outputs, boxes=[person_boxes], threshold=pose_threshold)
image_pose_result = pose_results[0]

RESULT = {"poses": image_pose_result}
