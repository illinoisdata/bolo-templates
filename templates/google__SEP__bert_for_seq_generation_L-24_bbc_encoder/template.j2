{% set repo_id = repo_id | default("google/bert_for_seq_generation_L-24_bbc_encoder") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hello, world!") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import numpy as np
import torch
from transformers import AutoModel, BertTokenizer

tokenizer = BertTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt").to(device)

with torch.no_grad():
    outputs = model(**inputs)
    hidden_states = outputs.last_hidden_state

embeddings = hidden_states.cpu().numpy()

RESULT = {"embeddings": embeddings}
