{% set repo_id = repo_id | default("ramsrigouthamg/t5_boolean_questions") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('question: Is the sky blue?') %}
{% set max_new_tokens = max_new_tokens | default(8) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

repo_dir = os.path.dirname(weights_path)

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False, legacy=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
