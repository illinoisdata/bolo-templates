{% set question_text = "Is it true that the Earth is flat?" %}
{% set max_length = 32 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/ramsrigouthamg__SEP__t5_boolean_questions" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question_text = "{{ question_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(torch_device)

encoded_inputs = tokenizer(question_text, return_tensors="pt")
encoded_inputs = {key: tensor.to(torch_device) for key, tensor in encoded_inputs.items()}

generated_ids = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    text_output_path = os.path.join(output_dir, "generated_text.txt")
    with open(text_output_path, "w", encoding="utf-8") as handle:
        handle.write(RESULT["generated_text"])