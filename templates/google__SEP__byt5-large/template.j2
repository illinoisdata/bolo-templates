{% set repo_id = repo_id | default("google/byt5-large") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Translate English to French: Life is like a box of chocolates.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

device_t = torch.device(device if torch.cuda.is_available() or str(device) == "cpu" else "cpu")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float16 if device_t.type == "cuda" else torch.float32)
model.to(device_t)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device_t) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=64)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
