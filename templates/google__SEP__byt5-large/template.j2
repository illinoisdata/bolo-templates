{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/byt5-large") %}
{% set prompt = prompt | default("Translate English to French: The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(prompt, return_tensors="pt").to(device)

generated_ids = model.generate(**inputs, max_length=max_length)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
