{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-lv-en") %}
{% set source_texts = source_texts | default(["Labdien, kā jums klājas?"]) %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_texts = {{ source_texts | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

batch_inputs = source_texts if isinstance(source_texts, (list, tuple)) else [source_texts]
encoded_inputs = tokenizer(batch_inputs, return_tensors="pt", padding=True, truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
