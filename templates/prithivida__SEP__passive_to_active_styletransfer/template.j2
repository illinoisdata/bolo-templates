{% set repo_id = repo_id | default("prithivida/passive_to_active_styletransfer") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('The ball was kicked by the boy.') %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

prefix = "active: "
inputs = tokenizer(prefix + input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
        do_sample=do_sample,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
