{% set text = "Сегодня [MASK] хорошая погода." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/IlyaGusev__SEP__news_tg_rubert" %}
{% set top_k = 5 %}

text = "{{ text }}"
output_dir = "{{ output_dir }}"
top_k = {{ top_k }}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

from pathlib import Path
import json

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(torch_device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(torch_device) for k, v in inputs.items()}

with torch.inference_mode():
    outputs = model(**inputs)

logits = outputs.logits
input_ids = inputs["input_ids"]
mask_indices = torch.nonzero(input_ids == tokenizer.mask_token_id, as_tuple=False)

predictions = []
if mask_indices.shape[0] > 0:
    for batch_idx, seq_pos in mask_indices.tolist():
        logits_at_pos = logits[batch_idx, seq_pos]
        probs = torch.softmax(logits_at_pos, dim=-1)
        topk = torch.topk(probs, k=min(top_k, probs.shape[-1]))
        token_ids = topk.indices.tolist()
        token_scores = topk.values.tolist()
        tokens = tokenizer.convert_ids_to_tokens(token_ids)
        predictions.append({
            "batch_index": batch_idx,
            "sequence_position": seq_pos,
            "tokens": tokens,
            "scores": token_scores,
        })

RESULT = {"predictions": predictions}

if __name__ == "__main__":
    output_path = Path(output_dir) / "predictions.json"
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(RESULT, ensure_ascii=False, indent=2), encoding="utf-8")