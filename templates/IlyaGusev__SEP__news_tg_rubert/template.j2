{% set repo_id = repo_id | default("IlyaGusev/news_tg_rubert") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Первые новости о запуске нового спутника вызвали большой интерес.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoConfig, BertForMaskedLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = AutoConfig.from_pretrained(os.path.dirname(config_path))
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(vocab_path), use_fast=False)
model = BertForMaskedLM(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("bert.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits

mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None and (inputs["input_ids"] == mask_token_id).any():
    mask_positions = (inputs["input_ids"] == mask_token_id).nonzero(as_tuple=False)
    predictions = []
    for pos in mask_positions:
        batch_idx, token_idx = pos.tolist()
        topk = torch.topk(logits[batch_idx, token_idx], k=5)
        tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
        predictions.append({"position": token_idx, "tokens": tokens, "scores": topk.values.tolist()})
    output = {"masked_predictions": predictions}
else:
    pooled = logits.mean(dim=1)
    topk = torch.topk(pooled[0], k=min(5, pooled.shape[-1]))
    output = {"top_logits": topk.values.tolist(), "top_indices": topk.indices.tolist()}

RESULT = {"output": output}
