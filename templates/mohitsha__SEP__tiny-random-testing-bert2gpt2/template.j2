{% set prompt = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/mohitsha__SEP__tiny-random-testing-bert2gpt2" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {key: tensor.to(device) for key, tensor in inputs.items()}

generated_ids = model.generate(**inputs, max_new_tokens=50)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_text = generated_text[0]

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_dir_path = Path(output_dir)
    output_dir_path.mkdir(parents=True, exist_ok=True)
    (output_dir_path / "generated_text.txt").write_text(RESULT["generated_text"], encoding="utf-8")