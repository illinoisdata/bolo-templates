{% set repo_id = "readerbench/RoBERT-base" %}
{% set device = "cuda:0" %}
{% set input_text = "Acesta este un exemplu de propoziție în limba română." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}
outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()
pooler_output = (
    outputs.pooler_output.detach().cpu()
    if outputs.pooler_output is not None
    else None
)

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
