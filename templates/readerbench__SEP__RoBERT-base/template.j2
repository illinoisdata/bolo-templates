{% set repo_id = repo_id | default("readerbench/RoBERT-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('exemplu de propoziție') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
vocab_path = hf_hub_download(repo_id=repo_id, filename='vocab.txt')
repo_dir = os.path.dirname(model_path)

_ = tokenizer_config_path, special_tokens_map_path, vocab_path

run_device = device if (device.startswith('cuda') and torch.cuda.is_available()) else 'cpu'

tokenizer = AutoTokenizer.from_pretrained(repo_dir, local_files_only=True)
model = AutoModel.from_pretrained(repo_dir, local_files_only=True)
model = model.to(run_device)
model.eval()

inputs = tokenizer(text, return_tensors='pt')
inputs = {k: v.to(run_device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state.detach().cpu().numpy(),
    "pooler_output": outputs.pooler_output.detach().cpu().numpy() if outputs.pooler_output is not None else None,
}
