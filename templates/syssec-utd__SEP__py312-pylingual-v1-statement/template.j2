{% set prompt = "summarize: The Transformers library allows developers to build powerful text generation models for natural language tasks." %}
{% set max_length = 256 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/syssec-utd__SEP__py312-pylingual-v1-statement" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch.device(device))
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
input_ids = inputs.input_ids.to(torch.device(device))
attention_mask = inputs.attention_mask.to(torch.device(device)) if inputs.attention_mask is not None else None

with torch.inference_mode():
    generation_kwargs = {
        "max_length": max_length,
        "num_beams": num_beams,
        "early_stopping": True,
    }
    outputs = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        **generation_kwargs,
    )

generated_texts = tokenizer.batch_decode(outputs, skip_special_tokens=True)
generated_text = generated_texts[0] if generated_texts else ""

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "generated_text.txt").write_text(generated_text, encoding="utf-8")