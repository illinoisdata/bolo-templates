{% set repo_id = repo_id | default("MaziyarPanahi/Sailor2-1B-Chat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Sailor2-1B-Chat.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short greeting from a helpful assistant.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=max(1, (os.cpu_count() or 1) // 2),
    n_gpu_layers=-1 if str(device).startswith('cuda') else 0,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

chat_prompt = llm.create_chat_completion(messages=messages, max_tokens=64, temperature=0.7)["choices"][0]["message"]["content"]

RESULT = {"output": chat_prompt}
