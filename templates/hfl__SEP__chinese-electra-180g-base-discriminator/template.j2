{% set repo_id = repo_id | default("hfl/chinese-electra-180g-base-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('今天天气很好，适合出去散步。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, ElectraForPreTraining

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")

if device.startswith("cuda") and torch.cuda.is_available():
    torch_device = torch.device(device)
else:
    torch_device = torch.device("cpu")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = ElectraForPreTraining.from_pretrained(repo_id)
model.to(torch_device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(torch_device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.sigmoid(logits)
    token_scores = probs[0].detach().cpu().tolist()

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "token_scores": token_scores,
}
