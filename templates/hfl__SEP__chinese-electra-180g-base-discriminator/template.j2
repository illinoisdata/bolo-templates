{% set repo_id = "hfl/chinese-electra-180g-base-discriminator" %}
{% set device = "cuda:0" %}
{% set input_text = "今天天气很好。我今天心情不错。" %}
{% set max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}

from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

encoding = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
input_tensors = {key: tensor.to(device) for key, tensor in encoding.items()}

with torch.no_grad():
    model_outputs = model(**input_tensors)

logits = model_outputs.logits
probabilities = torch.sigmoid(logits)

result_logits = logits.cpu()
result_probabilities = probabilities.cpu()

RESULT = {
    "replaced_token_logits": result_logits,
    "replaced_token_probabilities": result_probabilities,
}
