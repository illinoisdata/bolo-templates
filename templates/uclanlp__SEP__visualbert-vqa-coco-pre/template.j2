{% set repo_id = "uclanlp/visualbert-vqa-coco-pre" %}
{% set device = "cuda:0" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set question = "What object is the focus of the image?" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
image_path = {{ image_path | tojson }}
question = {{ question | tojson }}

import json
import os
from io import BytesIO

import requests
import torch
from PIL import Image
from transformers import AutoModelForPreTraining, AutoProcessor

processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, text=question, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

outputs = model(**inputs)

prediction_logits = outputs.prediction_logits.detach().cpu()
sequence_relationship_logits = outputs.seq_relationship_logits.detach().cpu()

RESULT = {
    "prediction_logits": prediction_logits.tolist(),
    "sequence_relationship_logits": sequence_relationship_logits.tolist(),
}
