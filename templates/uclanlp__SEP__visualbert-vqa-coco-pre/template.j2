{% set repo_id = repo_id | default("uclanlp/visualbert-vqa-coco-pre") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set question = question | default('What is in the image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
question = "{{ question }}"

import os
import torch
import requests
from PIL import Image
from io import BytesIO
from transformers import AutoTokenizer, VisualBertForPreTraining
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

model = VisualBertForPreTraining.from_pretrained(os.path.dirname(weights_path), local_files_only=True)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, local_files_only=True)

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path, timeout=30)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = tokenizer(question, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "output": outputs.to_tuple(),
}
