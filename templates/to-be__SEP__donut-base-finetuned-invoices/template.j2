{% set repo_id = repo_id | default("to-be/donut-base-finetuned-invoices") %}
{% set device = device | default("cuda:0") %}
{% set document_image_path = document_image_path | default("/u/yli77/projects/ML-code-generation/data/doc.jpeg") %}
{% set max_length = max_length | default(768) %}
{% set num_beams = num_beams | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
document_image_path = "{{ document_image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from io import BytesIO
from pathlib import Path

import requests
import torch
from PIL import Image
from transformers import DonutProcessor, VisionEncoderDecoderModel

torch_device = torch.device(device)
processor = DonutProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(torch_device)
model.eval()

if document_image_path.startswith("http://") or document_image_path.startswith("https://"):
    response = requests.get(document_image_path, timeout=30)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(document_image_path).convert("RGB")

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(torch_device)

with torch.no_grad():
    generated_ids = model.generate(
        pixel_values,
        max_length=max_length,
        num_beams=num_beams,
    )

generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
