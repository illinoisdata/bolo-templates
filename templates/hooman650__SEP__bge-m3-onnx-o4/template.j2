{% set repo_id = repo_id | default("hooman650/bge-m3-onnx-o4") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("feature-extraction") %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}
{% set model_cache_dir = model_cache_dir | default("bge-m3-onnx") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
model_cache_dir = {{ model_cache_dir | tojson }}
input_prompt = {{ input_prompt | tojson }}

from huggingface_hub import snapshot_download
from optimum.onnxruntime import ORTModelForFeatureExtraction
from transformers import AutoTokenizer, pipeline

model_cache_path = snapshot_download(repo_id=repo_id, local_dir=model_cache_dir, resume_download=True)

lower_device = device.lower()
provider = "CPUExecutionProvider"
pipeline_device = -1
if lower_device.startswith("cuda"):
    provider = "CUDAExecutionProvider"
    cuda_parts = lower_device.split(":", 1)
    if len(cuda_parts) == 2:
        try:
            pipeline_device = int(cuda_parts[1])
        except ValueError:
            pipeline_device = 0
    else:
        pipeline_device = 0

ort_model = ORTModelForFeatureExtraction.from_pretrained(model_cache_path, provider=provider)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

pipe = pipeline(task=task, model=ort_model, tokenizer=tokenizer, device=pipeline_device)
RESULT = pipe(input_prompt)
