{% set repo_id = repo_id | default("tim1900/bert-chunker-3") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("The causes and effects of dropouts in vocational and professional education are more pressing than ever. A decreasing attractiveness of vocational education, particularly in payment and quality, causes higher dropout rates while hitting ongoing demographic changes resulting in extensive skill shortages for many regions.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import math
from pathlib import Path

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, BertForTokenClassification

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

local_model_dir = str(Path(model_file).parent)

tokenizer = AutoTokenizer.from_pretrained(
    local_model_dir,
    padding_side="right",
    model_max_length=255,
    trust_remote_code=True,
)
model = BertForTokenClassification.from_pretrained(local_model_dir).to(device)
model.eval()


def chunk_text(model, text, tokenizer, prob_threshold=0.50543):
    MAX_TOKENS = 255
    tokens = tokenizer(text, return_tensors="pt", truncation=False)
    input_ids = tokens["input_ids"]
    CLS = input_ids[:, 0].unsqueeze(0)
    SEP = input_ids[:, -1].unsqueeze(0)
    input_ids = input_ids[:, 1:-1]
    split_str_poses = []
    token_pos = []
    windows_start = 0
    logits_threshold = math.log(1 / prob_threshold - 1)
    while windows_start < input_ids.shape[1]:
        windows_end = min(windows_start + MAX_TOKENS - 2, input_ids.shape[1])
        ids = torch.cat((CLS, input_ids[:, windows_start:windows_end], SEP), 1).to(device)
        output = model(input_ids=ids, attention_mask=torch.ones(1, ids.shape[1], device=device))
        logits = output.logits[:, 1:-1, :]
        chunk_decision = logits[:, :, 1] > (logits[:, :, 0] - logits_threshold)
        greater_rows_indices = torch.where(chunk_decision)[1].tolist()
        if len(greater_rows_indices) > 0 and not (greater_rows_indices[0] == 0 and len(greater_rows_indices) == 1):
            split_str_pos = [tokens.token_to_chars(sp + windows_start + 1).start for sp in greater_rows_indices if sp > 0]
            token_pos += [sp + windows_start for sp in greater_rows_indices if sp > 0]
            split_str_poses += split_str_pos
            windows_start = greater_rows_indices[-1] + windows_start
        else:
            windows_start = windows_end
    substrings = [text[i:j] for i, j in zip([0] + split_str_poses, split_str_poses + [len(text)])]
    token_pos = [0] + token_pos
    return substrings, token_pos

chunks, token_pos = chunk_text(model, text, tokenizer, prob_threshold=0.50543)
RESULT = {"chunks": chunks, "token_pos": token_pos}
