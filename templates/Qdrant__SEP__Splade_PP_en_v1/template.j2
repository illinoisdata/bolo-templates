{% set repo_id = repo_id | default("Qdrant/Splade_PP_en_v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('query: neural sparse retrieval') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import json
import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer

model_path = hf_hub_download(repo_id=repo_id, filename="model.onnx")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

with open(config_path, "r") as f:
    tokenizer_config = json.load(f)

# Load tokenizer using the repo files already downloaded locally.
tokenizer = AutoTokenizer.from_pretrained(
    os.path.dirname(tokenizer_path),
    use_fast=True,
)

def _torch_device(dev):
    return torch.device(dev if torch.cuda.is_available() or dev == "cpu" else "cpu")

device_obj = _torch_device(device)

import onnxruntime as ort
providers = ["CUDAExecutionProvider", "CPUExecutionProvider"] if device_obj.type == "cuda" else ["CPUExecutionProvider"]
session = ort.InferenceSession(model_path, providers=providers)

inputs = tokenizer(text, return_tensors="np", truncation=True, padding=True)
onnx_inputs = {k: v for k, v in inputs.items() if k in {i.name for i in session.get_inputs()}}
outputs = session.run(None, onnx_inputs)

# SPLADE-style sparse representation: logits -> relu -> log1p -> max over tokens
logits = outputs[0]
if logits.ndim == 3:
    token_scores = np.log1p(np.maximum(logits, 0.0))
    sparse_vector = token_scores.max(axis=1).squeeze(0)
else:
    sparse_vector = logits.squeeze(0)

# Return top token weights as a compact in-memory result.
token_ids = np.argsort(-sparse_vector)[:10]
result_tokens = tokenizer.convert_ids_to_tokens(token_ids.tolist())
result_scores = sparse_vector[token_ids].tolist()

RESULT = {"tokens": result_tokens, "scores": result_scores}
