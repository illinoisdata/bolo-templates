{% set repo_id = "Qdrant/Splade_PP_en_v1" %}
{% set device = "cuda:0" %}
{% set input_texts = ["A curious cat is resting on the windowsill.", "A dog is running through the park on a sunny day."] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Qdrant__SEP__Splade_PP_en_v1" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_texts = {{ input_texts }}
output_dir = "{{ output_dir }}"

import json
import os

import onnxruntime as ort
import torch
from optimum.onnxruntime import ORTModelForMaskedLM
from transformers import AutoTokenizer

device = torch.device(device)
available_providers = ort.get_available_providers()
provider = "CUDAExecutionProvider" if "CUDAExecutionProvider" in available_providers else "CPUExecutionProvider"
if provider == "CPUExecutionProvider":
    device = torch.device("cpu")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = ORTModelForMaskedLM.from_pretrained(repo_id, provider=provider)

encoded_inputs = tokenizer(
    input_texts,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

logits = outputs.logits
logits = logits.detach().cpu().tolist()

RESULT = {"logits": logits}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "logits.json")
    with open(output_path, "w", encoding="utf-8") as output_file:
        json.dump(
            {
                "input_texts": input_texts,
                "logits": logits,
            },
            output_file,
        )