{% set repo_id = repo_id | default("hallisky/bart-base-toxic-antiexpert") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("The discussion reinforced how essential accountability and transparency are when confronting toxic behavior.") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(prompt, return_tensors="pt", truncation=True, padding=False)
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(
    **tokenized_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
    early_stopping=True,
)

generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
