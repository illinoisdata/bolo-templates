{% set repo_id = repo_id | default("hallisky/bart-base-toxic-antiexpert") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The movie was surprisingly good, with strong acting and a thoughtful plot.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = BartForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        early_stopping=True,
    )
output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
