{% set repo_id = repo_id | default("fushh7/llmdet_swin_large_hf") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text = text | default('person, bicycle, car, dog, cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text = "{{ text }}"

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor, GroundingDinoForObjectDetection

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = AutoProcessor.from_pretrained(repo_id)
model = GroundingDinoForObjectDetection.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, text=text, return_tensors="pt")
inputs = {k: v.to(device) if hasattr(v, "to") else v for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

target_sizes = torch.tensor([image.size[::-1]], device=device)
results = processor.post_process_grounded_object_detection(
    outputs,
    inputs["input_ids"],
    text_threshold=0.25,
    target_sizes=target_sizes,
)

RESULT = {"detections": results[0]}
