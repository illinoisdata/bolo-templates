{% set repo_id = repo_id | default("deep-learning-analytics/automatic-title-generation") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Deep learning has transformed natural language processing and computer vision.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)

inputs = tokenizer("summarize: " + text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=20,
        num_beams=4,
        early_stopping=True,
    )

title = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"title": title}
