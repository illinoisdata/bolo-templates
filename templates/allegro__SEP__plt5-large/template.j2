{% set repo_id = "allegro/plt5-large" %}
{% set device = "cuda:0" %}
{% set text = "To jest test." %}
{% set max_new_tokens = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input
encoded = tokenizer(text, return_tensors="pt").to(device)

# Run inference
with torch.inference_mode():
    generated_ids = model.generate(**encoded, max_new_tokens=max_new_tokens)

# Post-process & build RESULT dict
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    with open("generated_text.txt", "w", encoding="utf-8") as f:
        f.write(RESULT["generated_text"])