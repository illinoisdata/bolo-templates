{% set repo_id = repo_id | default("adasnew/t5-small-xsum") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("The Tower of London is a historic castle located on the north bank of the River Thames in central London. It has served historically as a prison, royal palace, and fortress.") %}
{% set summarization_prefix = summarization_prefix | default("summarize: ") %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
summarization_prefix = "{{ summarization_prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Preprocess input
input_text = summarization_prefix + text
encoded = tokenizer(input_text, return_tensors="pt")
input_ids = encoded.input_ids.to(device)
attention_mask = encoded.attention_mask.to(device)

# Inference
outputs = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
)

# Postprocess and prepare RESULT
decoded = tokenizer.decode(outputs[0], skip_special_tokens=True)
RESULT = {"summary_text": decoded}
