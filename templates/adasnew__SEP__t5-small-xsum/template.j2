{% set repo_id = "adasnew/t5-small-xsum" %}
{% set device = "cuda:0" %}
{% set text = "The Tower of London is a historic castle located on the north bank of the River Thames in central London. It has served historically as a prison, royal palace, and fortress." %}
{% set summarization_prefix = "summarize: " %}
{% set max_length = 200 %}
{% set min_length = 30 %}
{% set num_beams = 4 %}
{% set no_repeat_ngram_size = 3 %}
{% set length_penalty = 2.0 %}
{% set early_stopping = true %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/adasnew__SEP__t5-small-xsum" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
summarization_prefix = "{{ summarization_prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Preprocess input
input_text = summarization_prefix + text
encoded = tokenizer(input_text, return_tensors="pt")
input_ids = encoded.input_ids.to(device)
attention_mask = encoded.attention_mask.to(device)

# Inference
outputs = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
)

# Postprocess and prepare RESULT
decoded = tokenizer.decode(outputs[0], skip_special_tokens=True)
RESULT = {"summary_text": decoded}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "summary.txt"), "w") as f:
        f.write(RESULT["summary_text"])