{% set input_text = input_text | default('The city council approved a new plan to expand bike lanes, reduce traffic congestion, and improve air quality over the next three years.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}
{% set repo_id = repo_id | default("adasnew/t5-small-xsum") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import T5Tokenizer, T5ForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model_dir = os.path.dirname(model_path)
tokenizer = T5Tokenizer.from_pretrained(model_dir)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model = model.to(device)
model.eval()

prefix = "summarize: "
inputs = tokenizer(prefix + input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        do_sample=do_sample,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
