{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("castorini/monot5-base-msmarco-10k") %}
{% set query = query | default("What is the role of monot5 reranker?") %}
{% set passage = passage | default("Monot5 reranker is fine-tuned on MS MARCO to produce accurate rankings for passages.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = {{ query | tojson }}
passage = {{ passage | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_text = f"query: {query} passage: {passage}"
inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
