{% set repo_id = repo_id | default("pysentimiento/robertuito-emotion-analysis") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Estoy muy feliz hoy, pero un poco nervioso.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoConfig, AutoTokenizer, AutoModelForSequenceClassification
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_json_path), use_fast=True)
model = AutoModelForSequenceClassification.from_pretrained(os.path.dirname(weights_path), config=config)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)
    pred_id = int(torch.argmax(probs, dim=-1).item())
    pred_label = model.config.id2label[pred_id]
    scores = {model.config.id2label[i]: float(probs[0, i].item()) for i in range(probs.shape[-1])}

RESULT = {"text": text, "label": pred_label, "scores": scores}
