{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-sh-en") %}
{% set src_text = src_text | default(["Ispostavilo se da je istina.", "Ovaj vikend imamo besplatne pozive."]) %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(
    src_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **tokenized_inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        early_stopping=True,
    )

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}
