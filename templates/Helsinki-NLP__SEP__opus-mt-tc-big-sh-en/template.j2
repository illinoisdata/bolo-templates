{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-sh-en") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default(["Ispostavilo se da je istina.", "Ovaj vikend imamo besplatne pozive."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import MarianMTModel, MarianTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = MarianTokenizer.from_pretrained(os.path.dirname(source_spm_path))
model = MarianMTModel.from_pretrained(os.path.dirname(model_path)).to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt", padding=True, truncation=True).to(device)
with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=4)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
