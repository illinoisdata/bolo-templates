{% set text = text | default('пр+ивет, как д+ела? всё +очень хорош+о! а у тебя как?') %}
{% set speaker = speaker | default(0) %}
{% set repo_id = repo_id | default("utrobinmv/tts_ru_free_hf_vits_low_multispeaker") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
speaker = {{ speaker }}

import torch
from huggingface_hub import hf_hub_download
from transformers import VitsModel, AutoTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

model = VitsModel.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs, speaker_id=speaker).waveform

output = waveform.detach().cpu().numpy()[0]
RESULT = {"audio": output, "sampling_rate": model.config.sampling_rate}
