import torch
from transformers import pipeline

class SimpleTokenizer:
    def __init__(self, vocab_size=1024, bos_token_id=11, eos_token_id=11, pad_token_id=0):
        self.vocab_size = vocab_size
        self.bos_token_id = bos_token_id
        self.eos_token_id = eos_token_id
        self.pad_token_id = pad_token_id
        self.padding_side = "right"

    def _encode(self, text):
        return [ord(char) % self.vocab_size for char in text]

    def __call__(self, texts, return_tensors=None, padding=True, truncation=True):
        if isinstance(texts, str):
            texts = [texts]
        tokenized = []
        for text in texts:
            ids = [self.bos_token_id] + self._encode(text) + [self.eos_token_id]
            tokenized.append(ids)
        max_length = max(len(ids) for ids in tokenized)
        input_ids = []
        attention_mask = []
        for ids in tokenized:
            padding_length = max_length - len(ids)
            input_ids.append(ids + [self.pad_token_id] * padding_length)
            attention_mask.append([1] * len(ids) + [0] * padding_length)
        if return_tensors == "pt":
            input_ids = torch.tensor(input_ids, dtype=torch.long)
            attention_mask = torch.tensor(attention_mask, dtype=torch.long)
        return {"input_ids": input_ids, "attention_mask": attention_mask}

    def decode(self, token_ids, skip_special_tokens=True, clean_up_tokenization_spaces=True):
        if isinstance(token_ids, torch.Tensor):
            token_ids = token_ids.tolist()
        decoded_chars = []
        for token in token_ids:
            if skip_special_tokens and token in {self.bos_token_id, self.eos_token_id, self.pad_token_id}:
                continue
            decoded_chars.append(chr(token % 256))
        return "".join(decoded_chars)

tokenizer = SimpleTokenizer(vocab_size=1024, bos_token_id=11, eos_token_id=11, pad_token_id=0)
pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt, max_new_tokens=max_new_tokens, do_sample=do_sample)
