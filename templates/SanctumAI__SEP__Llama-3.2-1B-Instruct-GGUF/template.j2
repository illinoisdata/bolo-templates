{% set repo_id = repo_id | default("SanctumAI/Llama-3.2-1B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('llama-3.2-1b-instruct.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short welcome message for a multilingual assistant.') %}
{% set system_prompt = system_prompt | default('You are a helpful, concise assistant.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set temperature = temperature | default(0.7) %}
{% set top_p = top_p | default(0.9) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
system_prompt = "{{ system_prompt }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}

import os
from llama_cpp import Llama
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if device.startswith("cuda") else 0,
    verbose=False,
)

prompt_text = f"<|begin_of_text|><|start_header_id|>system<|end_header_id|>\n\n{system_prompt}<|eot_id|><|start_header_id|>user<|end_header_id|>\n\n{prompt}<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n"
result = llm(prompt_text, max_tokens=max_new_tokens, temperature=temperature, top_p=top_p, stop=["<|eot_id|>", "<|end_of_text|>"])
output_text = result["choices"][0]["text"]

RESULT = {"text": output_text}
