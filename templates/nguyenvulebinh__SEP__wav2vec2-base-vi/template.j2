{% set repo_id = repo_id | default("nguyenvulebinh/wav2vec2-base-vi") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import io
import torch
import requests
import numpy as np
from scipy.io import wavfile
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2ForPreTraining, Wav2Vec2Processor

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
processor_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
for fname in ["config.json", "vocab.json", "tokenizer_config.json", "special_tokens_map.json", "added_tokens.json"]:
    hf_hub_download(repo_id=repo_id, filename=fname)

processor = Wav2Vec2Processor.from_pretrained(os.path.dirname(processor_file))
model = Wav2Vec2ForPreTraining.from_pretrained(os.path.dirname(model_file))
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_bytes = requests.get(audio_path, timeout=30).content
    sr, audio = wavfile.read(io.BytesIO(audio_bytes))
else:
    sr, audio = wavfile.read(audio_path)

if audio.dtype != np.float32:
    if np.issubdtype(audio.dtype, np.integer):
        audio = audio.astype(np.float32) / max(1, np.iinfo(audio.dtype).max)
    else:
        audio = audio.astype(np.float32)

if audio.ndim > 1:
    audio = audio.mean(axis=1)

inputs = processor(audio, sampling_rate=16000, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "loss": outputs.loss.detach().cpu().item() if outputs.loss is not None else None,
    "projected_states_shape": tuple(outputs.projected_states.shape) if outputs.projected_states is not None else None,
    "codevector_perplexity": outputs.codevector_perplexity.detach().cpu().item() if outputs.codevector_perplexity is not None else None,
}
