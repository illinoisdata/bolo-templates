{% set text_prompt = text_prompt | default('Hello, my name is Suno. And, uh — and I like pizza. [laughs] But I also have other interests such as playing tic tac toe.') %}
{% set history_prompt = history_prompt | default('en_speaker_1') %}
{% set repo_id = repo_id | default("ylacombe/bark-small") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"
history_prompt = "{{ history_prompt }}"

import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor, AutoModel

config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
processor_path = hf_hub_download(repo_id=repo_id, filename='tokenizer.json')
_ = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
_ = hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
_ = hf_hub_download(repo_id=repo_id, filename='vocab.txt')

processor = AutoProcessor.from_pretrained(os.path.dirname(processor_path))
model = AutoModel.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = processor(text=[text_prompt], return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    speech_values = model.generate(**inputs, do_sample=True)

sampling_rate = model.generation_config.sample_rate
output_audio = speech_values.detach().cpu().numpy().squeeze()

RESULT = {"audio": output_audio, "sampling_rate": sampling_rate}
