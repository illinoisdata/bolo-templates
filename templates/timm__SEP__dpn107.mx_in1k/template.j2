{% set repo_id = repo_id | default("timm/dpn107.mx_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set cuda_lib_dirs = cuda_lib_dirs | default(["/workspace/.pip/nvidia/cu13/lib", "/workspace"]) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
image_path = {{ image_path | tojson }}
cuda_lib_dirs = {{ cuda_lib_dirs | tojson }}

import os

ld_paths = [d for d in cuda_lib_dirs if d]
if ld_paths:
    existing = os.environ.get("LD_LIBRARY_PATH", "")
    prefix = ":".join(ld_paths)
    os.environ["LD_LIBRARY_PATH"] = prefix + (":" + existing if existing else "")

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(image_path)
