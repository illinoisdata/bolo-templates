{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("OpenMOSS-Team/bart-base-chinese") %}
{% set prompt = prompt | default("北京是[MASK]的首都") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model = model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
input_ids = inputs["input_ids"].to(torch_device)
attention_mask = inputs.get("attention_mask")
if attention_mask is not None:
    attention_mask = attention_mask.to(torch_device)

generation_kwargs = {
    "input_ids": input_ids,
    "max_length": max_length,
    "num_beams": num_beams,
    "early_stopping": True,
}
if attention_mask is not None:
    generation_kwargs["attention_mask"] = attention_mask

generated_tokens = model.generate(**generation_kwargs)

generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"generated_text": generated_texts[0]}
