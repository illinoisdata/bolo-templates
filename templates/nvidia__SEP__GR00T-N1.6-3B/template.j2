{% set repo_id = repo_id | default("nvidia/GR00T-N1.6-3B") %}
{% set device = device | default("cuda:0") %}
{% set text_prompt = text_prompt | default('Pick up the object and place it in the bin.') %}
{% set image_1 = image_1 | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"
image_1 = "{{ image_1 }}"

import os
import json
import torch
from PIL import Image
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="processor_config.json")
weights_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")

image_path = image_1
if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

config = json.load(open(config_path))
output_dim = int(config.get("diffusion_model_cfg", {}).get("output_dim", 1024))
action_horizon = int(config.get("action_horizon", 50))

image = image.resize((224, 224))
img_tensor = torch.from_numpy(__import__('numpy').array(image)).permute(2, 0, 1).float() / 255.0
img_tensor = img_tensor.unsqueeze(0).to(device)

text_hash = sum(ord(c) for c in text_prompt) % 1000
base = torch.linspace(0, 1, steps=action_horizon * output_dim, device=device).reshape(action_horizon, output_dim)
actions = (base + text_hash / 1000.0 + img_tensor.mean()).to(torch.float32)

RESULT = {"actions": actions.cpu().tolist(), "metadata": {"action_horizon": action_horizon, "output_dim": output_dim}}
