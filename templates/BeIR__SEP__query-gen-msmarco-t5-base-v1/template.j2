{% set repo_id = repo_id | default("BeIR/query-gen-msmarco-t5-base-v1") %}
{% set device = device | default("cuda:0") %}
{% set paragraph = paragraph | default('Python is an interpreted, high-level and general-purpose programming language. Python\'s design philosophy emphasizes code readability with its notable use of significant whitespace. Its language constructs and object-oriented approach aim to help programmers write clear, logical code for small and large-scale projects.') %}
{% set max_length = max_length | default(64) %}
{% set do_sample = do_sample | default(true) %}
{% set top_p = top_p | default(0.95) %}
{% set num_return_sequences = num_return_sequences | default(3) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
paragraph = "{{ paragraph }}"
max_length = {{ max_length }}
do_sample = {{ do_sample }}
top_p = {{ top_p }}
num_return_sequences = {{ num_return_sequences }}

import os
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

model = T5ForConditionalGeneration.from_pretrained(os.path.dirname(weights_path), local_files_only=True)
model.to(device)
model.eval()

tokenizer = T5Tokenizer(vocab_file=tokenizer_path)

input_ids = tokenizer.encode(paragraph, return_tensors="pt").to(device)
with torch.no_grad():
    outputs = model.generate(
        input_ids=input_ids,
        max_length=max_length,
        do_sample=do_sample,
        top_p=top_p,
        num_return_sequences=num_return_sequences,
    )

queries = [tokenizer.decode(output, skip_special_tokens=True) for output in outputs]
RESULT = {"paragraph": paragraph, "queries": queries}
