{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('Describe the image in detail.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import os
import torch
from PIL import Image
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download
weights_path = hf_hub_download(repo_id=repo_id, filename="PE-Lang-G14-448.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.yaml")

if urlparse(image_path).scheme in ("http", "https"):
    from io import BytesIO
    import requests
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image_tensor = torch.tensor(__import__("numpy").array(image)).permute(2,0,1).float().unsqueeze(0) / 255.0
image_tensor = image_tensor.to(device)
output = {"weights_path": weights_path, "config_path": config_path, "image_size": image.size, "image_tensor_shape": tuple(image_tensor.shape)}

RESULT = {"output": output}
