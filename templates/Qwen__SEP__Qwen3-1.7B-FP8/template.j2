{% set repo_id = repo_id | default("Qwen/Qwen3-1.7B-FP8") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set quantization_config = quantization_config | default(None) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
{% if quantization_config is none %}
quantization_config = None
{% else %}
quantization_config = {{ quantization_config | tojson }}
{% endif %}

from transformers.integrations.finegrained_fp8 import FP8Experts
from transformers import pipeline

FP8Experts._impl_tp_layer_overrides.setdefault(None, {})

pipe = pipeline(task=task, model=model, device=device, quantization_config=quantization_config)
RESULT = pipe(input_prompt)
