{% set repo_id = repo_id | default("microsoft/unispeech-large-1500h-cv") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import numpy as np
import torch
import soundfile as sf
import requests
from transformers import AutoConfig, AutoFeatureExtractor, AutoModelForPreTraining
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
feature_extractor_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

config_dir = os.path.dirname(config_file)
model_dir = os.path.dirname(model_file)
fe_dir = os.path.dirname(feature_extractor_file)

config = AutoConfig.from_pretrained(config_dir)
feature_extractor = AutoFeatureExtractor.from_pretrained(fe_dir)
model = AutoModelForPreTraining.from_pretrained(model_dir, config=config)
model.to(device)
model.eval()

if str(audio_path).startswith(("http://", "https://")):
    audio_bytes = requests.get(audio_path, timeout=30).content
    import io
    speech, sampling_rate = sf.read(io.BytesIO(audio_bytes))
else:
    speech, sampling_rate = sf.read(audio_path)

if speech.ndim > 1:
    speech = np.mean(speech, axis=1)
if sampling_rate != 16000:
    import librosa
    speech = librosa.resample(speech.astype(np.float32), orig_sr=sampling_rate, target_sr=16000)
    sampling_rate = 16000

inputs = feature_extractor(speech, sampling_rate=sampling_rate, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "output": outputs
}
