repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_sample_rate = {{ target_sample_rate }}

import io
from pathlib import Path

import requests
import soundfile as sf
import torch
import torchaudio.functional as F
from transformers import AutoFeatureExtractor, AutoModelForPreTraining

feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

def _is_url(source: str) -> bool:
    lowered = str(source).lower()
    return lowered.startswith("http://") or lowered.startswith("https://")

def _load_audio(source: str):
    if _is_url(source):
        response = requests.get(source)
        response.raise_for_status()
        file_like = io.BytesIO(response.content)
        waveform, sampling_rate = sf.read(file_like, dtype="float32")
    else:
        waveform, sampling_rate = sf.read(source, dtype="float32")
    if waveform.ndim > 1:
        waveform = waveform.mean(axis=1)
    return waveform, sampling_rate

def _resample_audio(waveform, current_rate):
    if current_rate == target_sample_rate:
        return waveform
    tensor_waveform = torch.from_numpy(waveform)
    resampled_waveform = F.resample(tensor_waveform, current_rate, target_sample_rate)
    return resampled_waveform.numpy()

waveform, sampling_rate = _load_audio(audio_path)
waveform = _resample_audio(waveform, sampling_rate)
sampling_rate = target_sample_rate

inputs = feature_extractor(
    waveform,
    sampling_rate=sampling_rate,
    return_tensors="pt"
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

def _move_to_cpu(obj):
    if isinstance(obj, torch.Tensor):
        return obj.detach().cpu()
    if isinstance(obj, dict):
        return {key: _move_to_cpu(value) for key, value in obj.items()}
    if isinstance(obj, list):
        return [_move_to_cpu(value) for value in obj]
    if isinstance(obj, tuple):
        return tuple(_move_to_cpu(value) for value in obj)
    return obj

RESULT = {key: _move_to_cpu(value) for key, value in outputs.items()}
