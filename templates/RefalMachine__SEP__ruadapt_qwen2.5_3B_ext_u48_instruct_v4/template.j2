{% set repo_id = repo_id | default("RefalMachine/ruadapt_qwen2.5_3B_ext_u48_instruct_v4") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Привет! Кратко объясни, что такое машинное обучение.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
model_dir = os.path.dirname(config_file)

# Download tokenizer assets explicitly to ensure local loading works.
for fname in ["tokenizer.json", "tokenizer_config.json", "special_tokens_map.json", "added_tokens.json", "vocab.json", "merges.txt"]:
    try:
        hf_hub_download(repo_id=repo_id, filename=fname)
    except Exception:
        pass

tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
    trust_remote_code=True,
)
model.to(device)
model.eval()

messages = [
    {"role": "system", "content": "Ты полезный ассистент, отвечай кратко и по делу."},
    {"role": "user", "content": prompt},
]
input_ids = tokenizer.apply_chat_template(messages, return_tensors="pt", add_generation_prompt=True)
input_ids = input_ids.to(device)

with torch.no_grad():
    generated = model.generate(
        input_ids=input_ids,
        max_new_tokens=64,
        do_sample=False,
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.eos_token_id,
    )

output_text = tokenizer.decode(generated[0][input_ids.shape[-1]:], skip_special_tokens=True)

RESULT = {"text": output_text}
