repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
prompt = {{ prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}

import torch
from transformers import pipeline

class ReformerCharTokenizer:
    def __init__(self, pad_token_id=0, eos_token_id=2):
        self.pad_token_id = pad_token_id
        self.eos_token_id = eos_token_id
        self.model_max_length = 65536
        self.vocab_size = 258
        self.padding_side = "right"
        self.unk_token_id = 1
        self.pad_token = "<pad>"
        self.eos_token = "<eos>"
        self.bos_token = "<bos>"

    def __call__(self, inputs, return_tensors="pt", **kwargs):
        sequences = inputs if isinstance(inputs, (list, tuple)) else [inputs]
        encoded = self._encode_batch(sequences)
        if return_tensors == "pt":
            return encoded
        return {key: value.tolist() for key, value in encoded.items()}

    def _encode_batch(self, sequences):
        byte_sequences = []
        for seq in sequences:
            byte_sequences.append(seq if isinstance(seq, bytes) else str(seq).encode("utf-8"))
        max_length = max(len(seq) for seq in byte_sequences) if byte_sequences else 0
        input_ids = torch.full((len(byte_sequences), max_length), self.pad_token_id, dtype=torch.long)
        attention_mask = torch.zeros_like(input_ids)
        for idx, seq in enumerate(byte_sequences):
            token_ids = torch.tensor([b + 2 for b in seq], dtype=torch.long)
            input_ids[idx, : token_ids.size(0)] = token_ids
            attention_mask[idx, : token_ids.size(0)] = 1
        return {"input_ids": input_ids, "attention_mask": attention_mask}

    def _decode_single(self, token_ids, **kwargs):
        if isinstance(token_ids, torch.Tensor):
            token_ids = token_ids.tolist()
        return "".join(chr(int(token) - 2) if token > 1 else "" for token in token_ids)

    def batch_decode(self, sequences, **kwargs):
        return [self._decode_single(seq, **kwargs) for seq in sequences]

    decode = _decode_single


tokenizer = ReformerCharTokenizer()
pipe = pipeline(task=task, model=repo_id, tokenizer=tokenizer, device=device)
RESULT = pipe(prompt, max_new_tokens=max_new_tokens)
