{% set repo_id = repo_id | default("MaziyarPanahi/SmolLM-1.7B-Instruct-v0.2-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("SmolLM-1.7B-Instruct-v0.2.Q4_K_M.gguf") %}
{% set prompt = prompt | default("Write a short greeting from a helpful assistant.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith("cuda") else 0
llm = Llama(
    model_path=model_path,
    n_ctx=256,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

messages = [
    {"role": "user", "content": prompt},
]

formatted_prompt = llm.tokenize(b"")
output = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    max_tokens=64,
)

RESULT = {"output": output["choices"][0]["message"]["content"]}
