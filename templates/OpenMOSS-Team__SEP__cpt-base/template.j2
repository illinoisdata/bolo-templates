{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("OpenMOSS-Team/cpt-base") %}
{% set input_text = input_text | default("北京是中国的首都") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
import os

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded = tokenizer(input_text, return_tensors="pt", truncation=True)
encoded = {key: value.to(device) for key, value in encoded.items()}
encoded.pop("token_type_ids", None)

generated_tokens = model.generate(**encoded, max_length=max_length, num_beams=num_beams)
generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
