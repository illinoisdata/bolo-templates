{% set repo_id = repo_id | default("OpenMOSS-Team/cpt-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('北京是[MASK]的首都。') %}
{% set max_length = max_length | default(32) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import BertTokenizer, BartForConditionalGeneration, BartConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Load tokenizer and model

tokenizer = BertTokenizer(vocab_file=vocab_path)
config = BartConfig.from_json_file(config_path)
model = BartForConditionalGeneration.from_pretrained(
    os.path.dirname(weights_path),
    local_files_only=True,
    ignore_mismatched_sizes=True,
    config=config,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items() if k != "token_type_ids"}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": decoded[0]}
