{% set repo_id = repo_id | default("mrm8488/bert-multi-cased-finetuned-xquadv1") %}
{% set device = device | default("cuda:0") %}
{% set context = context | default('कोरोनावायरस पश्चिम में आतंक बो रहा है क्योंकि यह इतनी तेजी से फैलता है।') %}
{% set question = question | default('कोरोनावायरस घबराहट कहां है?') %}
{% set max_seq_len = max_seq_len | default(384) %}
{% set doc_stride = doc_stride | default(128) %}
{% set max_answer_len = max_answer_len | default(30) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = "{{ context }}"
question = "{{ question }}"
max_seq_len = {{ max_seq_len }}
doc_stride = {{ doc_stride }}
max_answer_len = {{ max_answer_len }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

_ = (config_path, tokenizer_config_path, special_tokens_map_path, vocab_path)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(
    question,
    context,
    truncation="only_second",
    max_length=max_seq_len,
    stride=doc_stride,
    return_tensors="pt",
    return_offsets_mapping=True,
    return_overflowing_tokens=True,
    padding="max_length",
)

offset_mapping = inputs.pop("offset_mapping")[0].tolist()
inputs.pop("overflow_to_sample_mapping", None)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_index = int(torch.argmax(start_logits).item())
end_index = int(torch.argmax(end_logits).item())
if end_index < start_index:
    end_index = start_index
if end_index - start_index + 1 > max_answer_len:
    end_index = min(start_index + max_answer_len - 1, len(offset_mapping) - 1)

start_char, _ = offset_mapping[start_index]
_, end_char = offset_mapping[end_index]
answer = context[start_char:end_char] if start_char is not None and end_char is not None else ""
score = float(torch.softmax(start_logits, dim=-1)[start_index] * torch.softmax(end_logits, dim=-1)[end_index])

RESULT = {
    "answer": answer,
    "start": int(start_char) if start_char is not None else None,
    "end": int(end_char) if end_char is not None else None,
    "score": score,
}
