{% set repo_id = repo_id | default("benjamin/wtp-bert-mini") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}
{% set tokenizer_repo = tokenizer_repo | default("bert-base-uncased") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
tokenizer_repo = {{ tokenizer_repo | tojson }}

import json
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, BertConfig, BertForTokenClassification, pipeline

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
with open(config_path, "r", encoding="utf-8") as config_file:
    config_dict = json.load(config_file)

config_dict["model_type"] = "bert"
config_dict["architectures"] = ["BertForTokenClassification"]
label2id = config_dict.get("label2id", {})
if label2id:
    config_dict.setdefault("num_labels", len(label2id))

config = BertConfig(**config_dict)
model = BertForTokenClassification.from_pretrained(repo_id, config=config)
tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo)

model.to(device)

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt)
