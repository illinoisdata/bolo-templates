{% set repo_id = repo_id | default("uclanlp/visualbert-nlvr2-coco-pre") %}
{% set image_path = image_path | default("/u/yli77/projects/ML-code-generation/data/image1.jpeg") %}
{% set text_prompt = text_prompt | default("A single cat sits on a cozy rug.") %}
{% set max_length = max_length | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"
max_length = {{ max_length }}

import requests
from pathlib import Path
from PIL import Image

import numpy as np
import torch
from transformers import AutoModelForPreTraining, AutoProcessor

device = torch.device(device)

processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

def _load_image(source: str) -> Image.Image:
    if source.startswith("http://") or source.startswith("https://"):
        response = requests.get(source, stream=True)
        response.raise_for_status()
        return Image.open(response.raw).convert("RGB")
    return Image.open(source).convert("RGB")

image = _load_image(image_path)
inputs = processor(text=text_prompt, images=image, return_tensors="pt", padding="max_length", truncation=True, max_length=max_length)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

prediction_logits = outputs.prediction_logits.detach().cpu().numpy()
seq_relationship_logits = outputs.seq_relationship_logits.detach().cpu().numpy()

RESULT = {
    "prediction_logits": prediction_logits,
    "seq_relationship_logits": seq_relationship_logits,
}
