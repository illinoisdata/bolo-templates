{% set repo_id = "Helsinki-NLP/opus-mt-bg-it" %}
{% set device = "cuda:0" %}
{% set source_text = "Здравейте! Как сте?" %}
{% set max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}

import os

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(source_text, return_tensors="pt", padding=True)
model_inputs = {key: tensor.to(device) for key, tensor in tokenized_inputs.items()}

generated_tokens = model.generate(**model_inputs, max_length=max_length)
translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation}
