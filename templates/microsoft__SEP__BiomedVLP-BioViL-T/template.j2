{% set repo_id = repo_id | default("microsoft/BiomedVLP-BioViL-T") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("feature-extraction") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("No pleural effusion or pneumothorax is seen.") %}

# Set variables
task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

# Imports
from transformers import pipeline

# Create the pipeline with custom code enabled
pipe = pipeline(task=task, model=model, device=device, trust_remote_code=True)

# Inference
RESULT = {"outputs": pipe(input_prompt)}
