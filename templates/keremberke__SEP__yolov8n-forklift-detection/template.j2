{% set repo_id = repo_id | default("keremberke/yolov8n-forklift-detection") %}
{% set device = device | default("cuda:0") %}
{% set image_input = image_input | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf_threshold = conf_threshold | default(0.25) %}
{% set iou_threshold = iou_threshold | default(0.45) %}
{% set max_det = max_det | default(1000) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set repo_file = repo_file | default('best.pt') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_input = "{{ image_input }}"
conf_threshold = {{ conf_threshold }}
iou_threshold = {{ iou_threshold }}
max_det = {{ max_det }}
agnostic_nms = {{ agnostic_nms }}
repo_file = "{{ repo_file }}"

import os
from urllib.parse import urlparse
import torch
from PIL import Image
import requests
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weight_path = hf_hub_download(repo_id=repo_id, filename=repo_file)

if image_input.startswith("http://") or image_input.startswith("https://"):
    image = Image.open(requests.get(image_input, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_input).convert("RGB")

model = YOLO(weight_path)
model.to(device)
model.overrides["conf"] = conf_threshold
model.overrides["iou"] = iou_threshold
model.overrides["agnostic_nms"] = agnostic_nms
model.overrides["max_det"] = max_det

results = model.predict(source=image, verbose=False)
result = results[0]

boxes = result.boxes
output_boxes = []
if boxes is not None:
    for i in range(len(boxes)):
        cls_id = int(boxes.cls[i].item())
        output_boxes.append({
            "xyxy": boxes.xyxy[i].detach().cpu().tolist(),
            "confidence": float(boxes.conf[i].item()),
            "class_id": cls_id,
            "class_name": model.names.get(cls_id, str(cls_id)),
        })

RESULT = {"boxes": output_boxes}
