{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-de-ZH") %}
{% set source_text = source_text | default(">>zh<< Hello world, this is a translation test.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded_inputs = tokenizer(source_text, return_tensors="pt")
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"translation": translation}
