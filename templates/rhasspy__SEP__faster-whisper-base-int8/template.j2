{% set repo_id = repo_id | default("rhasspy/faster-whisper-base-int8") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(5) %}
{% set whisper_device = whisper_device | default("cpu") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
whisper_device = "{{ whisper_device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}

from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel
from pathlib import Path
import urllib.parse
import urllib.request

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if urllib.parse.urlparse(audio_path).scheme in ("http", "https"):
    local_audio_path = str(Path("/tmp") / Path(urllib.parse.urlparse(audio_path).path).name)
    urllib.request.urlretrieve(audio_path, local_audio_path)
else:
    local_audio_path = audio_path

compute_type = "int8"
model = WhisperModel(str(Path(model_path).parent), device=whisper_device, compute_type=compute_type)
segments, info = model.transcribe(local_audio_path, task=task, language=language, beam_size=beam_size)
transcript = "".join(segment.text for segment in segments).strip()

RESULT = {
    "text": transcript,
    "language": getattr(info, "language", None),
    "duration": getattr(info, "duration", None),
}
