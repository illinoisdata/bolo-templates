{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-zls-en") %}
{% set source_texts = source_texts | default(["Да не би случайно Том да остави Мери да кара колата?", "Какво е времето днес?"]) %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_texts = {{ source_texts }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

inputs = tokenizer(
    source_texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
).to(torch_device)

generated_ids = model.generate(
    **inputs,
    num_beams=num_beams,
    max_length=max_length,
)

translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translations": translations}
