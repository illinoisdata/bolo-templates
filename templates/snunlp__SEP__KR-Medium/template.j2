{% set repo_id = repo_id | default("snunlp/KR-Medium") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("오늘 기분이 어떠신가요?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(text_input, return_tensors="pt", truncation=True)
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

with torch.no_grad():
    outputs = model(**encoded_input)

cls_embedding = outputs.last_hidden_state[:, 0, :].squeeze(0).cpu().tolist()

RESULT = {"cls_embedding": cls_embedding}
