{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-de-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein Test.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
src_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
tgt_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=False,
    src_lang="de",
    tgt_lang="en",
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(**inputs, num_beams=4, max_length=128)

tokens = tokenizer.batch_decode(generated, skip_special_tokens=True)
output = tokens[0]

RESULT = {"translation": output}
