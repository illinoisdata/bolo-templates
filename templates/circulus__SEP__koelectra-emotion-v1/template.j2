{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("circulus/koelectra-emotion-v1") %}
{% set text_input = text_input | default("오늘 기분이 좋습니다. 날씨도 화창해요.") %}
{% set probability_threshold = probability_threshold | default(0.5) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text_input = {{ text_input | tojson }}
probability_threshold = {{ probability_threshold }}

import json
import os

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(torch_device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    padding=True,
)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)
logits = outputs.logits
probabilities = torch.sigmoid(logits)

probability_values = probabilities.squeeze(0).tolist()
raw_id2label = model.config.id2label
id2label = {int(key): value for key, value in raw_id2label.items()}

label_probabilities = [
    {"label": id2label.get(index, str(index)), "probability": prob}
    for index, prob in enumerate(probability_values)
]

predicted_labels = [
    entry["label"]
    for entry in label_probabilities
    if entry["probability"] >= probability_threshold
]

RESULT = {
    "label_probabilities": label_probabilities,
    "predicted_labels": predicted_labels,
}
