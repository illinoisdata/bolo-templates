{% set repo_id = repo_id | default("circulus/koelectra-emotion-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('오늘 하루가 너무 좋고 행복해요!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    logits = model(**inputs).logits
    probs = torch.sigmoid(logits).squeeze(0)

id2label = model.config.id2label
labels = [id2label[str(i)] if str(i) in id2label else id2label[i] for i in range(len(probs))]
output = {label: float(prob) for label, prob in zip(labels, probs.tolist())}
RESULT = {"output": output}
