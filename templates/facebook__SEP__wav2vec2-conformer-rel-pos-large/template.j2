{% set device = "cuda:0" %}
{% set repo_id = "facebook/wav2vec2-conformer-rel-pos-large" %}
{% set audio_path = "/u/yli77/projects/ML-code-generation/data/audio.wav" %}
{% set expected_sample_rate = 16000 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
expected_sample_rate = {{ expected_sample_rate }}

import io
from pathlib import Path

import requests
import soundfile as sf
import torch
import torchaudio.functional as F
from transformers import AutoFeatureExtractor, AutoModelForPreTraining

def _is_url(source: str) -> bool:
    return source.startswith("http://") or source.startswith("https://")

def _load_waveform(source: str) -> torch.Tensor:
    if _is_url(source):
        response = requests.get(source)
        response.raise_for_status()
        buffer = io.BytesIO(response.content)
        waveform, sample_rate = sf.read(buffer, dtype="float32")
    else:
        waveform, sample_rate = sf.read(source, dtype="float32")
    if waveform.ndim > 1:
        waveform = waveform.mean(axis=1)
    waveform_tensor = torch.from_numpy(waveform)
    if sample_rate != expected_sample_rate:
        shaped = waveform_tensor
        if shaped.dim() == 1:
            shaped = shaped.unsqueeze(0)
        waveform_tensor = F.resample(shaped, sample_rate, expected_sample_rate).squeeze(0)
    return waveform_tensor

feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

waveform = _load_waveform(audio_path)
inputs = feature_extractor(
    waveform,
    sampling_rate=expected_sample_rate,
    return_tensors="pt",
    padding="longest",
)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
RESULT = {
    name: value.detach().cpu() if isinstance(value, torch.Tensor) else value
    for name, value in outputs.items()
}
