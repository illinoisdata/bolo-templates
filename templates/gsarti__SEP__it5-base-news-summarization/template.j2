{% set device = "cuda:0" %}
{% set repo_id = "gsarti/it5-base-news-summarization" %}
{% set text_input = """Dal 31 maggio è infine partita la piattaforma ITsART, a più di un anno da quando – durante il primo lockdown – il ministro della Cultura Dario Franceschini ne aveva parlato come di «una sorta di Netflix della cultura», pensata per «offrire a tutto il mondo la cultura italiana a pagamento». È presto per dare giudizi definitivi sulla piattaforma, e di certo sarà difficile farlo anche più avanti senza numeri precisi. Al momento, l’unica cosa che si può fare è guardare com’è fatto il sito, contare quanti contenuti ci sono (circa 700 “titoli”, tra film, documentari, spettacoli teatrali e musicali e altri eventi) e provare a dare un giudizio sul loro valore e sulla loro varietà. Intanto, una cosa notata da più parti è che diversi contenuti di ITsART sono a pagamento sulla piattaforma sebbene altrove, per esempio su RaiPlay, siano invece disponibili gratuitamente.""" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

# Use config task_specific_params for summarization if available
task_params = getattr(model.config, "task_specific_params", None)
generation_kwargs = dict(task_params.get("summarization", {})) if isinstance(task_params, dict) else {}

generated_tokens = model.generate(**inputs, **generation_kwargs)
generated_summary = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0]

RESULT = {"summary": generated_summary}
