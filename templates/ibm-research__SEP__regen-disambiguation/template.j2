{% set device = "cuda:0" %}
{% set repo_id = "ibm-research/regen-disambiguation" %}
{% set input_text = "Explain the process of photosynthesis in simple terms." %}
{% set max_length = 200 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(input_text, return_tensors="pt").to(device)
generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
result_text = decoded_outputs[0].strip()
RESULT = {"generated_text": result_text}
