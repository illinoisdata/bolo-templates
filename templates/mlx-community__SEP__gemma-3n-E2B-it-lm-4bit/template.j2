{% set repo_id = repo_id | default("mlx-community/gemma-3n-E2B-it-lm-4bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('hello') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer

# MLX repos expose non-Transformers weights; this validation template returns the prompt-driven text path.
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
if tokenizer.chat_template is not None:
    messages = [{"role": "user", "content": prompt}]
    prompt = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)

RESULT = {"text": prompt}
