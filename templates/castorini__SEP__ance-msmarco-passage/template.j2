{% set repo_id = repo_id | default("castorini/ance-msmarco-passage") %}
{% set device = device | default("cuda:0") %}
{% set text_query = text_query | default('what is the capital of france?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_query = "{{ text_query }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

# Load tokenizer and model on the requested device
tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
model = AutoModel.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text_query, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    cls_embedding = outputs.last_hidden_state[:, 0, :].squeeze(0)
    pooled = cls_embedding.detach().cpu().tolist()

RESULT = {"embedding": pooled, "shape": list(cls_embedding.shape)}
