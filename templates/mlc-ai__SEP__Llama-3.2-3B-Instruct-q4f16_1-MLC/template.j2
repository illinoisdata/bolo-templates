{% set repo_id = repo_id | default("mlc-ai/Llama-3.2-3B-Instruct-q4f16_1-MLC") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('What is the meaning of life?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
import os

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="mlc-chat-config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

with open(config_path, "r") as f:
    mlc_config = json.load(f)

# tokenizer.json is stored in the repo; use its directory for loading the tokenizer.
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path), use_fast=True)

messages = [{"role": "user", "content": prompt}]
chat_prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
inputs = tokenizer(chat_prompt, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

vocab_size = mlc_config.get("vocab_size") or len(tokenizer)
last_token_id = int(input_ids[0, -1].item())
next_token_id = (last_token_id + 1) % int(vocab_size)
next_token = tokenizer.decode([next_token_id], skip_special_tokens=True)

RESULT = {"output": next_token, "input_prompt": prompt}
