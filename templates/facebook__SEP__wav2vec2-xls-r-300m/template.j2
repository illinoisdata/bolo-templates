{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set sampling_rate = sampling_rate | default(16000) %}
{% set repo_id = repo_id | default("facebook/wav2vec2-xls-r-300m") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sampling_rate = {{ sampling_rate }}

import os
import numpy as np
import torch
import soundfile as sf
import requests
from io import BytesIO
from scipy.signal import resample_poly
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2FeatureExtractor, Wav2Vec2ForPreTraining

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(os.path.dirname(preprocessor_path))
model = Wav2Vec2ForPreTraining.from_pretrained(os.path.dirname(config_path), torch_dtype=torch.float32)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_bytes = requests.get(audio_path, timeout=30).content
    waveform, sr = sf.read(BytesIO(audio_bytes))
else:
    waveform, sr = sf.read(audio_path)

if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)
if sr != sampling_rate:
    gcd = np.gcd(sr, sampling_rate)
    waveform = resample_poly(waveform, sampling_rate // gcd, sr // gcd)
    sr = sampling_rate

inputs = feature_extractor(waveform, sampling_rate=sr, return_tensors="pt")
input_values = inputs.input_values.to(device)
attention_mask = inputs.attention_mask.to(device) if inputs.attention_mask is not None else None

with torch.no_grad():
    outputs = model(input_values=input_values, attention_mask=attention_mask)

RESULT = {
    "projected_states": outputs.projected_states.detach().cpu().numpy(),
    "projected_quantized_states": outputs.projected_quantized_states.detach().cpu().numpy(),
    "codevector_perplexity": float(outputs.codevector_perplexity.detach().cpu().item()),
}
