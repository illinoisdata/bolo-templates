{% set repo_id = repo_id | default("Langboat/mengzi-t5-base-mt") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('“房间很一般，小，且让人感觉脏，隔音效果差，能听到走廊的人讲话，走廊光线昏暗，旁边没有什么可吃” 这条评论的态度是什么？') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import os
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_model_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
model_dir = os.path.dirname(weights_path)

tokenizer = T5Tokenizer.from_pretrained(model_dir)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(**inputs, max_new_tokens=32)

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)
RESULT = {"output": output_text}
