{% set repo_id = "vikp/surya_layout2" %}
{% set document_image_path = '/u/yli77/projects/ML-code-generation/data/doc.jpeg' %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
document_image_path = "{{ document_image_path }}"

import io
from pathlib import Path

import numpy as np
import requests
import torch
from PIL import Image
from transformers import AutoImageProcessor, AutoModelForSemanticSegmentation

torch_device = torch.device(device)
processor = AutoImageProcessor.from_pretrained(repo_id)
model = AutoModelForSemanticSegmentation.from_pretrained(repo_id, ignore_mismatched_sizes=True)
model.to(torch_device)
model.eval()

if document_image_path.lower().startswith(("http://", "https://")):
    response = requests.get(document_image_path)
    response.raise_for_status()
    document_image = Image.open(io.BytesIO(response.content))
else:
    document_image = Image.open(document_image_path)
document_image = document_image.convert("RGB")

inputs = processor(images=document_image, return_tensors="pt")
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

segmentation_mask = processor.post_process_semantic_segmentation(
    outputs,
    target_sizes=[document_image.size[::-1]],
)[0]
segmentation_mask = segmentation_mask.cpu().numpy()

RESULT = {"segmentation_mask": segmentation_mask}
