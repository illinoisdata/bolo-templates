{% set repo_id = repo_id | default("vikp/surya_layout2") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import requests
from io import BytesIO
from PIL import Image
import torch
from transformers import AutoImageProcessor, SegformerForSemanticSegmentation
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = AutoImageProcessor.from_pretrained(repo_id, local_files_only=True)
model = SegformerForSemanticSegmentation.from_pretrained(repo_id, local_files_only=True, ignore_mismatched_sizes=True).to(device)
model.eval()

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    seg = logits.argmax(dim=1)

RESULT = {"segmentation": seg.detach().cpu().tolist(), "logits_shape": list(logits.shape)}
