{% set repo_id = repo_id | default("akreal/tiny-random-mbart") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('translate English to French: Hello world!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

# Pre-process input & load model
_tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = _tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=8)

# Post-process & build RESULT dict
output_text = _tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"output_text": output_text}
