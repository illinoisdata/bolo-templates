{% set repo_id = repo_id | default("akreal/tiny-random-mbart") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("Hello, world!") %}
{% set src_lang = src_lang | default("en_XX") %}
{% set tgt_lang = tgt_lang | default("fr_XX") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load tokenizer and model onto the target device
tokenizer = AutoTokenizer.from_pretrained(repo_id, src_lang=src_lang, tgt_lang=tgt_lang)
tokenizer.src_lang = src_lang
tokenizer.tgt_lang = tgt_lang
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process the input text
encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}
forced_bos_token_id = tokenizer.lang_code_to_id[tgt_lang]

# Run inference
with torch.no_grad():
    generated_tokens = model.generate(**encoded_inputs, forced_bos_token_id=forced_bos_token_id)

# Post-process decoded translations
translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"translation": translation}
