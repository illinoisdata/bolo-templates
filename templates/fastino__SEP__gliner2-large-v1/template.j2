{% set repo_id = repo_id | default("fastino/gliner2-large-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Patient received 400mg ibuprofen for severe headache at 2 PM.") %}
{% set schema = schema | default({"medication": "Names of drugs, medications, or pharmaceutical substances", "dosage": "Specific amounts like '400mg', '2 tablets', or '5ml'", "symptom": "Medical symptoms, conditions, or patient complaints", "time": "Time references like '2 PM', 'morning', or 'after lunch'"}) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
schema = {{ schema | tojson }}

from huggingface_hub import hf_hub_download
from gliner2 import GLiNER2

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
model = GLiNER2.from_pretrained(repo_id)
model.to(device)
result = model.extract_entities(text, schema)
RESULT = {"output": result}
