{% set repo_id = repo_id | default("lmstudio-community/AMD-OLMo-1B-SFT-DPO-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('AMD-OLMo-1B-SFT-DPO-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short, helpful response about what a large language model is.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = {{ prompt | tojson }}

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(model_path=model_path, n_ctx=2048, n_threads=max(1, os.cpu_count() or 1), verbose=False)
output = llm(prompt, max_tokens=64, temperature=0.7, top_p=0.95, stop=["</s>"])
text = output["choices"][0]["text"]

RESULT = {"text": text, "raw": output}
