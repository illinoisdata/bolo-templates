{% set device = "cuda:0" %}
{% set repo_id = "syssec-utd/py311-pylingual-v1-statement" %}
{% set input_text = "summarize: Hello world!" %}
{% set max_length = 200 %}
{% set min_length = 30 %}
{% set num_beams = 4 %}
{% set length_penalty = 2.0 %}
{% set no_repeat_ngram_size = 3 %}
{% set early_stopping = True %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os
import json

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
outputs = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)
decoded = tokenizer.batch_decode(outputs, skip_special_tokens=True)
RESULT = {"generated_text": decoded}
