{% set input_text = "Willst du einen Kaffee trinken gehen mit mir?" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__bert2bert_L-24_wmt_de_en" %}
{% set max_new_tokens = 64 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    pad_token="<pad>",
    eos_token="</s>",
    bos_token="<s>",
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", add_special_tokens=False)
input_ids = inputs.input_ids.to(torch_device)

with torch.no_grad():
    generated_ids = model.generate(input_ids, max_new_tokens=max_new_tokens)

translation = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])