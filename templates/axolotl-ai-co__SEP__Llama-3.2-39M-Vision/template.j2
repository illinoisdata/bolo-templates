{% set repo_id = repo_id | default("axolotl-ai-co/Llama-3.2-39M-Vision") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe the image.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import torch
from PIL import Image
from transformers import AutoProcessor, AutoTokenizer, MllamaForConditionalGeneration
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

def load_image(image_input):
    if isinstance(image_input, str) and image_input.startswith(("http://", "https://")):
        from requests import get
        from io import BytesIO
        return Image.open(BytesIO(get(image_input, timeout=30).content)).convert("RGB")
    return Image.open(image_input).convert("RGB")

image = load_image(image_path)

processor = AutoProcessor.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = MllamaForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

messages = [
    {
        "role": "user",
        "content": [
            {"type": "image"},
            {"type": "text", "text": prompt},
        ],
    }
]
input_text = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)
input_text = input_text.replace("<|image|>", "<|image|>\n")
inputs = processor(images=image, text=input_text, return_tensors="pt")
inputs = {k: v.to(device) if hasattr(v, "to") else v for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(**inputs, max_new_tokens=20, do_sample=False)

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
