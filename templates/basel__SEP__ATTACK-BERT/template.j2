{% set repo_id = repo_id | default("basel/ATTACK-BERT") %}
{% set device = device | default("cuda:0") %}
{% set sentence1 = sentence1 | default('Attacker takes a screenshot') %}
{% set sentence2 = sentence2 | default('Attacker captures the screen') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = "{{ sentence1 }}"
sentence2 = "{{ sentence2 }}"

import os
import torch
from huggingface_hub import hf_hub_download
from sentence_transformers import SentenceTransformer
from sklearn.metrics.pairwise import cosine_similarity

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
module0_path = hf_hub_download(repo_id=repo_id, filename="modules.json") if False else None

model = SentenceTransformer(repo_id, device=device)
embeddings = model.encode([sentence1, sentence2], convert_to_numpy=True)
similarity = cosine_similarity([embeddings[0]], [embeddings[1]])

RESULT = {"embeddings": embeddings, "similarity": similarity}
