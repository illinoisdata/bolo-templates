{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tl-en") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Kamusta, kumusta ka?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import MarianMTModel, MarianTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer_dir = os.path.dirname(source_spm_path)
tokenizer = MarianTokenizer.from_pretrained(tokenizer_dir)
model = MarianMTModel.from_pretrained(tokenizer_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer([input_text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=6, max_length=128)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
