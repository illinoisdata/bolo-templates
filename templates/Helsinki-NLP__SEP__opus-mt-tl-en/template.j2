{% set repo_id = "Helsinki-NLP/opus-mt-tl-en" %}
{% set device = "cuda:0" %}
{% set texts = ["Kamusta ang iyong araw?"] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-tl-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
texts = {{ texts }}
output_dir = "{{ output_dir }}"

from transformers import MarianTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load tokenizer and model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(texts, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Inference
outputs = model.generate(**inputs)

# Post-process output
translations = tokenizer.batch_decode(outputs, skip_special_tokens=True)
RESULT = {"translations": translations}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translations.txt"), "w", encoding="utf-8") as f:
        for t in translations:
            f.write(t + "\n")