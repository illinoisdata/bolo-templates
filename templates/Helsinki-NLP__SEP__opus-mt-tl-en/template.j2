{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tl-en") %}
{% set device = device | default("cuda:0") %}
{% set texts = texts | default(["Kamusta ang iyong araw?"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
texts = {{ texts }}

from transformers import MarianTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load tokenizer and model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(texts, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Inference
outputs = model.generate(**inputs)

# Post-process output
translations = tokenizer.batch_decode(outputs, skip_special_tokens=True)
RESULT = {"translations": translations}
