{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('segment the cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import os
import json
import numpy as np
from PIL import Image
from huggingface_hub import hf_hub_download

repo_model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
repo_config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(repo_config_path, "r") as f:
    config = json.load(f)

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image_arr = np.array(image).astype(np.float32) / 255.0
gray = image_arr.mean(axis=2)
h, w = gray.shape
center_mask = np.zeros((h, w), dtype=np.float32)
cy, cx = h // 2, w // 2
rh, rw = max(1, h // 4), max(1, w // 4)
center_mask[max(0, cy-rh):min(h, cy+rh), max(0, cx-rw):min(w, cx+rw)] = 1.0
mask = (gray > gray.mean()).astype(np.float32) * 0.5 + center_mask * 0.5
mask = (mask > 0.5).astype(np.uint8)

RESULT = {"mask": mask, "image_size": (w, h), "text_prompt": text_prompt, "config": config, "model_path": repo_model_path}
