{% set device = "cuda:0" %}
{% set repo_id = "sonoisa/t5-base-japanese-v1.1" %}
{% set input_text = "これは日本語テキスト生成のサンプルです。続きの文章を生成してください。" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt", padding=True).to(device)
generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
