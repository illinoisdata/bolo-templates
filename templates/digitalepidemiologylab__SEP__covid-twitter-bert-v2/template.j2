{% set repo_id = repo_id | default("digitalepidemiologylab/covid-twitter-bert-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("In places with a lot of people, it\'s a good idea to wear a [MASK].") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM, AutoConfig
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = config_path.rsplit("/", 1)[0]
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True, local_files_only=True)
config = AutoConfig.from_pretrained(model_dir, local_files_only=True)
model = AutoModelForMaskedLM.from_config(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict = {k: v for k, v in state_dict.items() if not k.startswith("bert.pooler") and not k.startswith("cls.seq_relationship")}
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
mask_token_id = tokenizer.mask_token_id
mask_positions = (inputs["input_ids"] == mask_token_id).nonzero(as_tuple=False)
with torch.no_grad():
    logits = model(**inputs).logits

results = []
for pos in mask_positions:
    batch_idx, token_idx = pos.tolist()
    scores = logits[batch_idx, token_idx]
    probs = torch.softmax(scores, dim=-1)
    topk = torch.topk(probs, k=5)
    results.append({
        "masked_index": token_idx,
        "candidates": [
            {"token": int(tok), "token_str": tokenizer.decode([tok]).strip(), "score": float(score)}
            for score, tok in zip(topk.values.tolist(), topk.indices.tolist())
        ],
    })

RESULT = {"output": results}
