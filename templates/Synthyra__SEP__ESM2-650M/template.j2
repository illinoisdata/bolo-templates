{% set repo_id = repo_id | default("Synthyra/ESM2-650M") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("fill-mask") %}
{% set model = model | default(repo_id) %}
{% set masked_prompt = masked_prompt | default("MSTNPKPQRKTKR{mask}NT") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
model = {{ model | tojson }}
masked_prompt = {{ masked_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, trust_remote_code=True)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
RESULT = pipe(text)
