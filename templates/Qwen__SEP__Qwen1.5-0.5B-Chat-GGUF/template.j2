{% set repo_id = repo_id | default("Qwen/Qwen1.5-0.5B-Chat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('qwen1_5-0_5b-chat-q4_k_m.gguf') %}
{% set prompt = prompt | default('Explain the concept of quantization in one short paragraph.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=4,
    n_gpu_layers=0,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

output = llm.create_chat_completion(
    messages=messages,
    max_tokens=64,
    temperature=0.2,
    top_p=0.9,
)

RESULT = {"text": output["choices"][0]["message"]["content"]}
