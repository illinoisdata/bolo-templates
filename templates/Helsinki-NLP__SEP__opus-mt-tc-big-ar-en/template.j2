{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-ar-en" %}
{% set device = "cuda:0" %}
{% set src_text = ["اتبع قلبك فحسب.", "وين راهي دّوش؟"] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

import os
from transformers import MarianTokenizer, MarianMTModel
import torch

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True).to(device)
translated_tokens = model.generate(**inputs)

translations = [tokenizer.decode(t, skip_special_tokens=True) for t in translated_tokens]

RESULT = {"translations": translations}
