{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set speaker_embedding_path = speaker_embedding_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set repo_id = repo_id | default("microsoft/speecht5_vc") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
speaker_embedding_path = "{{ speaker_embedding_path }}"

import os
import requests
import numpy as np
import torch
import librosa
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import SpeechT5Processor, SpeechT5ForSpeechToSpeech, SpeechT5HifiGan

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="spm_char.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_source = audio_path
else:
    audio_source = audio_path

if speaker_embedding_path.startswith("http://") or speaker_embedding_path.startswith("https://"):
    response = requests.get(speaker_embedding_path)
    speaker_embedding_image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    speaker_embedding_image = Image.open(speaker_embedding_path).convert("RGB")

processor = SpeechT5Processor.from_pretrained(repo_id)
model = SpeechT5ForSpeechToSpeech.from_pretrained(repo_id).to(device)
vocoder = SpeechT5HifiGan.from_pretrained("microsoft/speecht5_hifigan").to(device)

speech_array, sampling_rate = librosa.load(audio_source, sr=16000)
inputs = processor(audio=speech_array, sampling_rate=sampling_rate, return_tensors="pt")
input_values = inputs["input_values"].to(device)

speaker_embedding = np.array(speaker_embedding_image.resize((1, 1))).astype(np.float32).reshape(-1)
if speaker_embedding.shape[0] < 512:
    speaker_embedding = np.pad(speaker_embedding, (0, 512 - speaker_embedding.shape[0]))
else:
    speaker_embedding = speaker_embedding[:512]
speaker_embeddings = torch.tensor(speaker_embedding, dtype=torch.float32).unsqueeze(0).to(device)

speech = model.generate_speech(input_values, speaker_embeddings, vocoder=vocoder)
RESULT = {"speech": speech.detach().cpu().numpy()}
