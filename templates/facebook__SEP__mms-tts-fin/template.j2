{% set device = "cuda:0" %}
{% set repo_id = "facebook/mms-tts-fin" %}
{% set text = "Tämä on esimerkki suomenkielisestä tekstistä puheeksi." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = """{{ text }}"""

from pathlib import Path

import torch
from scipy.io import wavfile
from transformers import AutoTokenizer, VitsModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt").to(device)

with torch.no_grad():
    waveform_tensor = model(**inputs).waveform

waveform_tensor = waveform_tensor.squeeze(0)
waveform_numpy = waveform_tensor.cpu().numpy()
if waveform_numpy.ndim == 2:
    waveform_numpy = waveform_numpy.T

sampling_rate = int(model.config.sampling_rate)
RESULT = {"waveform": waveform_numpy, "sampling_rate": sampling_rate}
