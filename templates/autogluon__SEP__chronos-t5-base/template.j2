{% set repo_id = repo_id | default("autogluon/chronos-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set prediction_length = prediction_length | default(12) %}
{% set num_samples = num_samples | default(20) %}
{% set context_series = context_series | default([112,118,132,129,121,135,148,148,136,119,104,118,115,126,141,135,125,149,170,170,158,133,114,140]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prediction_length = {{ prediction_length }}
num_samples = {{ num_samples }}
context_series = {{ context_series }}

import json
import os
from pathlib import Path

import numpy as np
import pandas as pd
import torch
from huggingface_hub import hf_hub_download
from chronos import ChronosPipeline

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

pipeline = ChronosPipeline.from_pretrained(
    repo_id,
    device_map=device,
    torch_dtype=torch.bfloat16 if "cuda" in device else torch.float32,
)

context = torch.tensor(context_series, dtype=torch.float32)
forecast = pipeline.predict(
    context,
    prediction_length,
    num_samples=num_samples,
)

forecast_np = forecast[0].detach().cpu().numpy()
low, median, high = np.quantile(forecast_np, [0.1, 0.5, 0.9], axis=0)

RESULT = {
    "forecast": forecast_np,
    "low": low,
    "median": median,
    "high": high,
    "context": context_series,
    "prediction_length": prediction_length,
}
