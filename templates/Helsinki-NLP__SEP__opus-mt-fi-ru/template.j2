{% set repo_id = "Helsinki-NLP/opus-mt-fi-ru" %}
{% set device = "cuda:0" %}
{% set input_text = input_text | default("Tämä on testi.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
encoded_input = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_input = encoded_input.to(device)
generated_tokens = model.generate(**encoded_input)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations}
