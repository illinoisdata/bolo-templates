{% set repo_id = repo_id | default("dbmdz/electra-base-italian-xxl-cased-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Ciao, questo è un test di linguaggio.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, ElectraForPreTraining

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(vocab_path.rsplit('/', 1)[0], use_fast=False)
model = ElectraForPreTraining.from_pretrained(vocab_path.rsplit('/', 1)[0])
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probs = torch.sigmoid(logits)
RESULT = {"logits": logits.detach().cpu().tolist(), "probs": probs.detach().cpu().tolist()}
