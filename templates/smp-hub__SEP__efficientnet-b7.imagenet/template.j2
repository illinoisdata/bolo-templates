{% set repo_id = repo_id | default("smp-hub/efficientnet-b7.imagenet") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
from io import BytesIO

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from timm import create_model
from timm.data import create_transform

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    cfg = json.load(f)

if str(image_path).startswith(("http://", "https://")):
    import requests
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = create_model("efficientnet_b7", pretrained=False, num_classes=1000)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

transform = create_transform(
    input_size=(3, 600, 600),
    interpolation="bicubic",
    mean=cfg["mean"],
    std=cfg["std"],
    crop_pct=1.0,
    is_training=False,
)

x = transform(image).unsqueeze(0).to(device)
with torch.inference_mode():
    logits = model(x)
    probs = torch.softmax(logits, dim=-1)[0]
    values, indices = torch.topk(probs, k=topk)

RESULT = {
    "topk_indices": indices.detach().cpu().tolist(),
    "topk_probs": values.detach().cpu().tolist(),
}
