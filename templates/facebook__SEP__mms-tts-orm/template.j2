{% set repo_id = "facebook/mms-tts-orm" %}
{% set device = "cuda:0" %}
{% set text_input = "Nagaa fi galatooma, jechoota Oromootti gargaaramuuf!" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mms-tts-orm" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
output_dir = "{{ output_dir }}"

import os

import torch
from scipy.io import wavfile
from transformers import AutoTokenizer, VitsModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu()
waveform_np = waveform.numpy().astype("float32")

RESULT = {"waveform": waveform_np}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    wavfile.write(
        os.path.join(output_dir, "waveform.wav"),
        rate=model.config.sampling_rate,
        data=waveform_np,
    )