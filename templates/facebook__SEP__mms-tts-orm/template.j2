{% set repo_id = repo_id | default("facebook/mms-tts-orm") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("Nagaa fi galatooma, jechoota Oromootti gargaaramuuf!") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import os

import torch
from scipy.io import wavfile
from transformers import AutoTokenizer, VitsModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu()
waveform_np = waveform.numpy().astype("float32")

RESULT = {"waveform": waveform_np}
