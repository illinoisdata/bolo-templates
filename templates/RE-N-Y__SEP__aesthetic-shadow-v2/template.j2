{% set repo_id = repo_id | default("RE-N-Y/aesthetic-shadow-v2") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set image_processor_size = image_processor_size | default(1024) %}
{% set image_processor_crop_size = image_processor_crop_size | default(1024) %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
image_processor_size = {{ image_processor_size | tojson }}
image_processor_crop_size = {{ image_processor_crop_size | tojson }}
input_data = {{ input_data | tojson }}
device = {{ device | tojson }}

from transformers import ViTImageProcessor, pipeline

image_processor = ViTImageProcessor(
    size=image_processor_size,
    crop_size=image_processor_crop_size,
)
pipe = pipeline(
    task=task,
    model=model,
    image_processor=image_processor,
    device=device,
)
RESULT = pipe(input_data)
