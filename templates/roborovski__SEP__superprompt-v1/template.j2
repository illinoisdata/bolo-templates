{% set repo_id = repo_id | default("roborovski/superprompt-v1") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Expand the following prompt to add more detail: A man in a suit walking down the street") %}
{% set max_new_tokens = max_new_tokens | default(77) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load model and tokenizer
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

# Pre-process input
inputs = tokenizer(input_text, return_tensors="pt").to(device)

# Run inference
outputs = model.generate(**inputs, max_new_tokens=max_new_tokens)

# Post-process output
generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)

# Build result dict
RESULT = {"generated_text": generated_text}
