{% set repo_id = repo_id | default("vidore/colpali-v1.2-hf") %}
{% set device = device | default("cuda:0") %}
{% set query = query | default('What information is shown in the document?') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"
image_path = "{{ image_path }}"

import os
from urllib.parse import urlparse

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import ColPaliForRetrieval, ColPaliProcessor

model_index = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = ColPaliProcessor.from_pretrained(repo_id)
model = ColPaliForRetrieval.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
).to(device).eval()

if urlparse(image_path).scheme in ("http", "https"):
    from io import BytesIO
    import requests
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

batch_images = processor(images=[image]).to(device)
batch_queries = processor(text=[query]).to(device)

with torch.no_grad():
    image_embeddings = model(**batch_images)
    query_embeddings = model(**batch_queries)
    scores = processor.score_retrieval(query_embeddings.embeddings, image_embeddings.embeddings)

RESULT = {
    "scores": scores,
    "image_embeddings": image_embeddings.embeddings,
    "query_embeddings": query_embeddings.embeddings,
}
