{% set device = "cuda:0" %}
{% set repo_id = "vidore/colpali-v1.2-hf" %}
{% set query_text = "Summarize the key focus of the document content." %}
{% set document_image = "/u/yli77/projects/ML-code-generation/data/doc.jpeg" %}
{% set results_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/vidore__SEP__colpali-v1.2-hf" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
query_text = "{{ query_text }}"
document_image = "{{ document_image }}"
results_dir = "{{ results_dir }}"

from io import BytesIO
from pathlib import Path

import numpy as np
import requests
import torch
from PIL import Image
from transformers import ColPaliForRetrieval, ColPaliProcessor

torch_device = torch.device(device)

def _load_image(source: str) -> Image.Image:
    if source.startswith(("http://", "https://")):
        response = requests.get(source, timeout=30)
        response.raise_for_status()
        return Image.open(BytesIO(response.content)).convert("RGB")
    return Image.open(Path(source)).convert("RGB")

processor = ColPaliProcessor.from_pretrained(repo_id)
model = ColPaliForRetrieval.from_pretrained(repo_id).to(torch_device).eval()

document_image_data = _load_image(document_image)

batch_images = processor(images=[document_image_data]).to(torch_device)
batch_queries = processor(text=[query_text]).to(torch_device)

with torch.no_grad():
    image_outputs = model(**batch_images)
    query_outputs = model(**batch_queries)

retrieval_scores = processor.score_retrieval(query_outputs.embeddings, image_outputs.embeddings)
query_embeddings_tensor = query_outputs.embeddings.to(torch.float32).detach().cpu()
image_embeddings_tensor = image_outputs.embeddings.to(torch.float32).detach().cpu()
retrieval_scores_tensor = retrieval_scores.to(torch.float32).detach().cpu()

RESULT = {
    "query_embeddings": query_embeddings_tensor,
    "image_embeddings": image_embeddings_tensor,
    "retrieval_scores": retrieval_scores_tensor,
}
