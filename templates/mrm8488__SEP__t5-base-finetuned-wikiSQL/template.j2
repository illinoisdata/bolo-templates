{% set repo_id = repo_id | default("mrm8488/t5-base-finetuned-wikiSQL") %}
{% set device = device | default("cuda:0") %}
{% set query = query | default('How many models were finetuned using BERT as base model?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="spiece.model")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
repo_dir = os.path.dirname(model_file)

# Use the full repository directory containing all tokenizer assets.
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir)
model.to(device)
model.eval()

input_text = f"translate English to SQL: {query} </s>"
features = tokenizer([input_text], return_tensors="pt")
features = {k: v.to(device) for k, v in features.items()}

with torch.no_grad():
    output_ids = model.generate(
        input_ids=features["input_ids"],
        attention_mask=features["attention_mask"],
        max_length=64,
        num_beams=4,
    )

sql = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"sql": sql}
