{% set device = "cuda:0" %}
{% set repo_id = "voidful/dpr-ctx_encoder-bert-base-multilingual" %}
{% set context_text = "The Eiffel Tower is located in Paris, and it is a famous landmark in France." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/voidful__SEP__dpr-ctx_encoder-bert-base-multilingual" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
context_text = """{{ context_text }}"""
output_dir = "{{ output_dir }}"

import os
import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(context_text, return_tensors="pt", truncation=True)
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

with torch.no_grad():
    outputs = model(**encoded_input)

embeddings = outputs.pooler_output
RESULT = {"embeddings": embeddings.detach().cpu()}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, "embeddings.npy"), RESULT["embeddings"].numpy())