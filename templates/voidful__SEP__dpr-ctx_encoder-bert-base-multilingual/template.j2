{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("voidful/dpr-ctx_encoder-bert-base-multilingual") %}
{% set context_text = context_text | default("The Eiffel Tower is located in Paris, and it is a famous landmark in France.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context_text = """{{ context_text }}"""

import os
import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(context_text, return_tensors="pt", truncation=True)
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

with torch.no_grad():
    outputs = model(**encoded_input)

embeddings = outputs.pooler_output
RESULT = {"embeddings": embeddings.detach().cpu()}
