{% set repo_id = repo_id | default("vjosap/moralBERT-predict-degradation-in-text") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('This sentence describes a harmful and degrading statement.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os

import torch
from huggingface_hub import hf_hub_download
from transformers import BertForSequenceClassification, AutoTokenizer

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(model_path)
tokenizer_dir = os.path.dirname(tokenizer_json_path)

tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir)
model = BertForSequenceClassification.from_pretrained(model_dir, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)
    predicted_class_id = int(torch.argmax(probs, dim=-1).item())
    predicted_probability = float(probs[0, predicted_class_id].item())

RESULT = {
    "text": text,
    "predicted_class_id": predicted_class_id,
    "predicted_probability": predicted_probability,
    "logits": logits.detach().cpu().tolist(),
    "probabilities": probs.detach().cpu().tolist(),
}
