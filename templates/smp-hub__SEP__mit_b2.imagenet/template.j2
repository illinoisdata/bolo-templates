{% set repo_id = repo_id | default("smp-hub/mit_b2.imagenet") %}
{% set device = device | default("cuda:0") %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
import requests
import torch
from PIL import Image
from io import BytesIO
import segmentation_models_pytorch as smp
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

if image_path.startswith(("http://", "https://")):
    response = requests.get(image_path, timeout=30)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert(config.get("input_space", "RGB"))
else:
    image = Image.open(image_path).convert(config.get("input_space", "RGB"))

image = image.resize((config["input_size"][2], config["input_size"][1]))

model = smp.Unet("mit_b2", encoder_weights="imagenet", classes=1000, activation=None)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model.eval()
model.to(device)

x = torch.tensor(list(image.getdata()), dtype=torch.float32)
x = x.view(image.size[1], image.size[0], 3).permute(2, 0, 1) / 255.0
mean = torch.tensor(config["mean"], dtype=torch.float32).view(3, 1, 1)
std = torch.tensor(config["std"], dtype=torch.float32).view(3, 1, 1)
x = (x - mean) / std
x = x.unsqueeze(0).to(device)

with torch.no_grad():
    logits = model(x)
    probs = torch.softmax(logits.flatten(1), dim=1)
    values, indices = torch.topk(probs, k=min(topk, probs.shape[1]), dim=1)

RESULT = {"logits_shape": list(logits.shape), "topk_indices": indices[0].detach().cpu().tolist(), "topk_scores": values[0].detach().cpu().tolist()}
