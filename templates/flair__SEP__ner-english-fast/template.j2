{% set repo_id = repo_id | default("flair/ner-english-fast") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('George Washington went to Washington') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from flair.data import Sentence
from flair.models import SequenceTagger

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tagger = SequenceTagger.load(weights_path)
if hasattr(tagger, 'to'):
    tagger.to(device)

sentence = Sentence(text)
tagger.predict(sentence)

entities = []
for span in sentence.get_spans('ner'):
    entities.append({
        'text': span.text,
        'label': span.get_label('ner').value,
        'score': float(span.get_label('ner').score),
        'start_pos': span.start_position,
        'end_pos': span.end_position,
    })

RESULT = {"entities": entities, "sentence": str(sentence)}
