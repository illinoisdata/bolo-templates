{% set repo_id = repo_id | default("ThomasNLG/t5-qg_squad1-en") %}
{% set device = device | default("cuda:0") %}
{% set answer_text = answer_text | default("Paris") %}
{% set context_text = context_text | default("Paris is the capital of France, known for the Eiffel Tower and the Seine River.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
answer_text = "{{ answer_text }}"
context_text = "{{ context_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

text_input = f"sv1  {answer_text}  {context_text}"
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

generated_question = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_question": generated_question}
