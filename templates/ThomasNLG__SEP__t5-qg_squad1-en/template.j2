{% set repo_id = repo_id %}
{% set device = device %}
{% set answer_text = "Paris" %}
{% set context_text = "Paris is the capital of France, known for the Eiffel Tower and the Seine River." %}
{% set max_length = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/ThomasNLG__SEP__t5-qg_squad1-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
answer_text = "{{ answer_text }}"
context_text = "{{ context_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

text_input = f"sv1  {answer_text}  {context_text}"
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

generated_question = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_question": generated_question}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_question.txt")
    with open(output_path, "w", encoding="utf-8") as out_f:
        out_f.write(generated_question)