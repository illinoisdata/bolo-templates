{% set repo_id = repo_id | default("allenai/wmt19-de-en-6-6-big") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Maschinelles Lernen ist großartig, nicht wahr?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import FSMTForConditionalGeneration, FSMTTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_src_path = hf_hub_download(repo_id=repo_id, filename="vocab-src.json")
vocab_tgt_path = hf_hub_download(repo_id=repo_id, filename="vocab-tgt.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = FSMTTokenizer.from_pretrained(repo_id)
model = FSMTForConditionalGeneration.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device) if "attention_mask" in inputs else None

with torch.no_grad():
    generated = model.generate(input_ids=input_ids, attention_mask=attention_mask)

translated_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"translation": translated_text}
