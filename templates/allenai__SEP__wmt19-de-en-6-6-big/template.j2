{% set device = "cuda:0" %}
{% set repo_id = "allenai/wmt19-de-en-6-6-big" %}
{% set source_text = "Maschinelles Lernen ist großartig, nicht wahr?" %}
{% set max_length = 128 %}
{% set num_beams = 5 %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
source_text = {{ source_text | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(source_text, return_tensors="pt", padding=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded[0]

RESULT = {"translation": translation}
