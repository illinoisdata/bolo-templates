{% set repo_id = repo_id | default("unc-nlp/lxmert-vqa-uncased") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set question = question | default('What is in the image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
question = "{{ question }}"

import os
import json
import torch
from PIL import Image
import os
from transformers import AutoTokenizer, AutoConfig, LxmertForQuestionAnswering
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

image = Image.open(image_path).convert("RGB") if not str(image_path).startswith(("http://", "https://")) else Image.open(__import__('requests').get(image_path, stream=True).raw).convert("RGB")

config = AutoConfig.from_pretrained(repo_id)
model = LxmertForQuestionAnswering.from_pretrained(repo_id, config=config)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
inputs = tokenizer(question, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

# Create simple dummy vision inputs compatible with LXMERT shape requirements.
# Use a full-image feature proxy via flattened RGB statistics repeated to feature size.
pixels = torch.tensor(list(image.resize((1,1)).getdata()[0]), dtype=torch.float32, device=device) / 255.0
feat = pixels.repeat(2048 // 3 + 1)[:2048].view(1, 1, 2048)
boxes = torch.tensor([[0.0, 0.0, 1.0, 1.0]], dtype=torch.float32, device=device).view(1, 1, 4)
visual_attention_mask = torch.ones((1, 1), dtype=torch.long, device=device)

with torch.no_grad():
    outputs = model(input_ids=input_ids, attention_mask=attention_mask, visual_feats=feat, visual_pos=boxes, visual_attention_mask=visual_attention_mask)

logits = outputs.question_answering_score
pred_idx = int(torch.argmax(logits, dim=-1).item())
num_labels = logits.shape[-1]
pred_label = str(pred_idx)

RESULT = {"predicted_answer": pred_label, "logits": logits.detach().cpu().tolist()}
