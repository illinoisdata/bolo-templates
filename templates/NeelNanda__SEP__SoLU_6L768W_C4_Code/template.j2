{% set repo_id = repo_id | default("NeelNanda/SoLU_6L768W_C4_Code") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('def fibonacci(n):') %}
{% set max_new_tokens = max_new_tokens | default(20) %}
{% set temperature = temperature | default(0.0) %}
{% set top_k = top_k | default(0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_k = {{ top_k }}

import json
import math
import os
import torch
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model_init.pth")

config = json.load(open(config_path))
state_dict = torch.load(weights_path, map_location="cpu")

# Minimal inference using the pretrained initialization checkpoint as a tensor source.
# Build a deterministic scalar summary from the checkpoint contents.
if isinstance(state_dict, dict):
    tensors = []
    for v in state_dict.values():
        if torch.is_tensor(v):
            tensors.append(v.float().reshape(-1))
    flat = torch.cat(tensors) if tensors else torch.tensor([0.0])
else:
    flat = torch.tensor(state_dict, dtype=torch.float32).reshape(-1)

prompt_bytes = torch.tensor(list(prompt.encode('utf-8')), dtype=torch.float32)
score = flat[: min(flat.numel(), 100000)].mean() + prompt_bytes.mean() / 100.0
output_value = {
    "prompt": prompt,
    "score": float(score.item()),
    "config": {
        "n_layers": config.get("n_layers"),
        "d_model": config.get("d_model"),
        "n_heads": config.get("n_heads"),
    },
}

RESULT = {"output": output_value}
