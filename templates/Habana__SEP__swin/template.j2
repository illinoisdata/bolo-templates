repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
label_name = "{{ label_name }}"

from huggingface_hub import hf_hub_download
from PIL import Image
import torch
from transformers import AutoModelForImageClassification

config_path = hf_hub_download(repo_id=repo_id, filename="gaudi_config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model_name = "microsoft/swin-base-patch4-window7-224-in22k"
model = AutoModelForImageClassification.from_pretrained(model_name)
model.to(device)
model.eval()

size = 224
image = image.resize((size, size))
import numpy as np
pixel_values = torch.tensor(np.array(image), dtype=torch.float32).permute(2, 0, 1).unsqueeze(0) / 255.0
mean = torch.tensor([0.485, 0.456, 0.406], dtype=torch.float32).view(1, 3, 1, 1)
std = torch.tensor([0.229, 0.224, 0.225], dtype=torch.float32).view(1, 3, 1, 1)
pixel_values = (pixel_values - mean) / std
pixel_values = pixel_values.to(device)
with torch.no_grad():
    outputs = model(pixel_values=pixel_values)
logits = outputs.logits
probs = torch.softmax(logits, dim=-1)[0]
topk = torch.topk(probs, k=5)
labels = model.config.id2label
predictions = [{"label": labels[int(idx)], "score": float(score)} for score, idx in zip(topk.values, topk.indices)]

RESULT = {"predictions": predictions, "config_path": config_path, "input_label": label_name}
