{% set device = "cuda:0" %}
{% set repo_id = "facebook/mms-tts-vie" %}
{% set text_input = "Xin chào! Đây là một ví dụ tạo giọng nói tiếng Việt." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from pathlib import Path

import numpy as np
import scipy.io.wavfile
import torch
from transformers import AutoTokenizer, VitsModel

model = VitsModel.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenized_inputs = tokenizer(text_input, return_tensors="pt")
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

with torch.no_grad():
    model_outputs = model(**tokenized_inputs)

waveform = model_outputs.waveform.squeeze(0).cpu().numpy()

RESULT = {"waveform": waveform}
