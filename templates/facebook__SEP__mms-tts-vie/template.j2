{% set repo_id = repo_id | default("facebook/mms-tts-vie") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Xin chào, đây là một ví dụ tổng hợp giọng nói tiếng Việt.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import VitsModel, AutoTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

model = VitsModel.from_pretrained(repo_id, local_files_only=True).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs).waveform

RESULT = {"waveform": waveform.detach().cpu().numpy(), "sampling_rate": model.config.sampling_rate}
