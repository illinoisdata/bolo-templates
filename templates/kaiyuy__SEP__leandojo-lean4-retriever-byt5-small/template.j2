{% set repo_id = repo_id | default("kaiyuy/leandojo-lean4-retriever-byt5-small") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('theorem') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, T5EncoderModel

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = T5EncoderModel.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

sequence_embedding = outputs.last_hidden_state.mean(dim=1).detach().cpu()
RESULT = {"sequence_embedding": sequence_embedding}
