{% set repo_id = repo_id | default("timm/efficientnet_b4.ra2_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set model = model | default(repo_id) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
image = Image.open(input_image).convert("RGB")
predictions = pipe(image)
RESULT = {"predictions": predictions}
