{% set repo_id = repo_id | default("deepset/xlm-roberta-large-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is model conversion important for?') %}
{% set context = context | default('The option to convert models between FARM and transformers gives freedom to the user and lets people easily switch between frameworks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

model = AutoModelForQuestionAnswering.from_pretrained(
    repo_id,
    local_files_only=True,
)
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx : end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
