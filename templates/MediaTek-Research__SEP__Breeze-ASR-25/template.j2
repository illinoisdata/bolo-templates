{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('zh') %}
{% set task = task | default('transcribe') %}
{% set repo_id = repo_id | default("MediaTek-Research/Breeze-ASR-25") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"

import os
import numpy as np
import torch
from scipy.io import wavfile
from huggingface_hub import hf_hub_download
from transformers import WhisperProcessor, WhisperForConditionalGeneration

_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = WhisperProcessor.from_pretrained(repo_id)
model = WhisperForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    raise ValueError("URL audio inputs are not supported in this inference script")
else:
    sample_rate, wav = wavfile.read(audio_path)

if wav.ndim > 1:
    wav = wav.mean(axis=1)

if wav.dtype != np.float32:
    if np.issubdtype(wav.dtype, np.integer):
        wav = wav.astype(np.float32) / np.iinfo(wav.dtype).max
    else:
        wav = wav.astype(np.float32)

if sample_rate != 16000:
    wav_tensor = torch.from_numpy(wav)
    wav_tensor = torch.nn.functional.interpolate(
        wav_tensor[None, None, :],
        size=int(round(wav_tensor.numel() * 16000 / sample_rate)),
        mode="linear",
        align_corners=False,
    ).squeeze(0).squeeze(0)
    wav = wav_tensor.numpy()
    sample_rate = 16000

inputs = processor(audio=wav, sampling_rate=sample_rate, return_tensors="pt")
input_features = inputs.input_features.to(device)
forced_decoder_ids = processor.get_decoder_prompt_ids(language=language, task=task)
with torch.no_grad():
    generated_ids = model.generate(
        input_features,
        forced_decoder_ids=forced_decoder_ids,
        max_new_tokens=256,
    )
text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": text}
