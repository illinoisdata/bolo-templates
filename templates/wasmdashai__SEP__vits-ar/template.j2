{% set text = "السلام عليكم ورحمة الله وبركاتة  ما الجديد ؟" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/wasmdashai__SEP__vits-ar" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = """{{ text }}"""
output_dir = "{{ output_dir }}"

import numpy as np
import torch
from pathlib import Path
from scipy.io import wavfile
from transformers import VitsModel, AutoTokenizer

model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

waveform = outputs.waveform.cpu().numpy().reshape(-1)
sampling_rate = model.config.sampling_rate

RESULT = {"waveform": waveform, "sampling_rate": sampling_rate}

if __name__ == "__main__":
    output_dir_path = Path(output_dir)
    output_dir_path.mkdir(parents=True, exist_ok=True)
    normalized_waveform = np.clip(waveform, -1.0, 1.0)
    wavfile.write(output_dir_path / "tts_waveform.wav", sampling_rate, (normalized_waveform * 32767).astype(np.int16))