{% set device = "cuda:0" %}
{% set repo_id = "wasmdashai/vits-ar" %}
{% set text = "السلام عليكم ورحمة الله وبركاتة  ما الجديد ؟" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = """{{ text }}"""

import numpy as np
import torch
from pathlib import Path
from scipy.io import wavfile
from transformers import VitsModel, AutoTokenizer

model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

waveform = outputs.waveform.cpu().numpy().reshape(-1)
sampling_rate = model.config.sampling_rate

RESULT = {"waveform": waveform, "sampling_rate": sampling_rate}
