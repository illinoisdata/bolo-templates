{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ga-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('Dia duit, conas atá tú?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download
import torch

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
src_spm_file = hf_hub_download(repo_id=repo_id, filename="source.spm")
tgt_spm_file = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = MarianTokenizer(vocab=vocab_file, source_spm=src_spm_file, target_spm=tgt_spm_file, target_lang="en")
model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
