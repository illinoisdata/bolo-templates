{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ga-en") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Dia dhuit! Conas atá tú inniu?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
max_new_tokens = {{ max_new_tokens }}

import os

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    source_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_text = translations[0] if translations else ""

RESULT = {"translation": translation_text}
