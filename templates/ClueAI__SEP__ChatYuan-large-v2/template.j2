{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ClueAI/ChatYuan-large-v2") %}
{% set text = text | default("你好") %}
{% set max_length = max_length | default(250) %}
{% set temperature = temperature | default(0.7) %}
{% set top_p = top_p | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
temperature = {{ temperature }}
top_p = {{ top_p }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(text, return_tensors="pt", truncation=True).to(device)
outputs = model.generate(**inputs, max_length=max_length, do_sample=True, temperature=temperature, top_p=top_p)
result_text = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]
RESULT = {"generated_text": result_text}
