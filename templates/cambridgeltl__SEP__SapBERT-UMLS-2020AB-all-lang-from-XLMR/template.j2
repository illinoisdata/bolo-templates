{% set repo_id = repo_id | default("cambridgeltl/SapBERT-UMLS-2020AB-all-lang-from-XLMR") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("feature-extraction") %}
{% set input_prompt = input_prompt | default(["covid-19", "Coronavirus infection", "high fever"]) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(input_prompt)
