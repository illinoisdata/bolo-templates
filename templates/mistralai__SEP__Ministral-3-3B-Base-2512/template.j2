{% set repo_id = repo_id | default("mistralai/Ministral-3-3B-Base-2512") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Describe the image in one concise sentence.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer
from transformers.models.mistral3.modeling_mistral3 import Mistral3ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="consolidated.safetensors")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = Mistral3ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    local_files_only=False,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=16, do_sample=False)

decoded = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"text": decoded}
