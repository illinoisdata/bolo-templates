{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/long-t5-tglobal-base") %}
{% set input_text = input_text | default("Summarize the following text about climate change mitigation in a few concise sentences.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

preprocessed_inputs = tokenizer(input_text, return_tensors="pt")
preprocessed_inputs = preprocessed_inputs.to(device)

generated_ids = model.generate(**preprocessed_inputs, max_new_tokens=max_new_tokens)

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_text = generated_texts[0].strip()

RESULT = {"generated_text": generated_text}
