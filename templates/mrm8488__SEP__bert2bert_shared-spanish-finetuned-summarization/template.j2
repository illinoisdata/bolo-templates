{% set text_input = "Al filo de las 22.00 horas del jueves, la Asamblea de Madrid vive un momento sorprendente: Vox decide no apoyar una propuesta del PP en favor del blindaje fiscal de la Comunidad." %}
{% set max_new_tokens = 60 %}
{% set num_beams = 4 %}
{% set max_input_length = 512 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/mrm8488__SEP__bert2bert_shared-spanish-finetuned-summarization" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = {{ text_input | tojson }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
max_input_length = {{ max_input_length }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=max_input_length,
)
model_inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **model_inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        no_repeat_ngram_size=3,
        length_penalty=2.0,
        early_stopping=True,
    )

summary = tokenizer.decode(
    generated_tokens[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"summary": summary}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")