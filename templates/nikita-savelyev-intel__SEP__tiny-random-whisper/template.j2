{% set repo_id = repo_id | default("nikita-savelyev-intel/tiny-random-whisper") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import torch
import numpy as np
from scipy.io import wavfile
from scipy.signal import resample_poly
from huggingface_hub import hf_hub_download
from transformers import WhisperForConditionalGeneration, WhisperProcessor, WhisperFeatureExtractor
from transformers.models.whisper.tokenization_whisper import WhisperTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
processor_dir = os.path.dirname(hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json"))

feature_extractor = WhisperFeatureExtractor.from_pretrained(processor_dir)
tokenizer = WhisperTokenizer.from_pretrained(processor_dir, from_slow=True)
processor = WhisperProcessor(feature_extractor=feature_extractor, tokenizer=tokenizer)
model = WhisperForConditionalGeneration.from_pretrained(
    os.path.dirname(weights_path),
    torch_dtype=torch.float32,
    local_files_only=True,
    ignore_mismatched_sizes=True,
)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    from io import BytesIO
    sr, audio = wavfile.read(BytesIO(requests.get(audio_path).content))
else:
    sr, audio = wavfile.read(audio_path)

if audio.dtype != np.float32:
    if np.issubdtype(audio.dtype, np.integer):
        audio = audio.astype(np.float32) / np.iinfo(audio.dtype).max
    else:
        audio = audio.astype(np.float32)

if audio.ndim > 1:
    audio = np.mean(audio, axis=1)

if sr != 16000:
    gcd = np.gcd(sr, 16000)
    audio = resample_poly(audio, 16000 // gcd, sr // gcd)
    sr = 16000

inputs = processor(audio, sampling_rate=sr, return_tensors="pt")
input_features = inputs.input_features.to(device)

with torch.no_grad():
    generated_ids = model.generate(input_features=input_features)

text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": text}
