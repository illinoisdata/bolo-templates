{% set repo_id = repo_id | default("lmstudio-community/gemma-3-4b-it-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-3-4b-it-Q4_K_M.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('What is happening in this image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import requests
from PIL import Image
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename='mmproj-model-f16.gguf')

if str(image_path).startswith(('http://', 'https://')):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

output = {
    'model_files': {
        'weights_path': weights_path,
        'mmproj_path': mmproj_path,
    },
    'device': device,
    'prompt': prompt,
    'image_size': image.size,
    'image_mode': image.mode,
}

RESULT = {'output': output}
