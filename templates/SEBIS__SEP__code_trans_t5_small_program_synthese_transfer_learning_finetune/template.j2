{% set repo_id = repo_id | default("SEBIS/code_trans_t5_small_program_synthese_transfer_learning_finetune") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("you are given an array of numbers a and a number b , compute the difference of elements in a and b") %}
{% set prefix = prefix | default("program synthesis: ") %}
{% set max_length = max_length | default(512) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
prefix = "{{ prefix }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device_obj = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device_obj)
model.eval()

input_text = prefix + prompt
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device_obj) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

generated_programs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"generated_programs": generated_programs}
