{% set repo_id = repo_id | default("SEBIS/code_trans_t5_small_program_synthese_transfer_learning_finetune") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("you are given an array of numbers a and a number b , compute the difference of elements in a and b") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

prefix = "program synthesis: "
full_input = prefix + input_text

# Load tokenizer/model from repo snapshot directory
repo_dir = tokenizer_file.rsplit("/", 1)[0]
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(full_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=128,
        num_beams=4,
        do_sample=False,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": output_text}
