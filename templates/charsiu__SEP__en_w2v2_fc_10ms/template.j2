repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import json
import torch
import numpy as np
from scipy.io import wavfile
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2ForCTC, Wav2Vec2Config

weight_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')

config = Wav2Vec2Config.from_json_file(config_path)
model = Wav2Vec2ForCTC(config)
state_dict = torch.load(weight_path, map_location='cpu')
model.load_state_dict(state_dict)
model.to(device)
model.eval()

if audio_path.startswith('http://') or audio_path.startswith('https://'):
    raise ValueError('URL audio inputs are not supported in this validation environment')

sample_rate, audio = wavfile.read(audio_path)
if audio.ndim > 1:
    audio = audio.mean(axis=1)
if np.issubdtype(audio.dtype, np.integer):
    audio = audio.astype(np.float32) / np.iinfo(audio.dtype).max
else:
    audio = audio.astype(np.float32)
input_values = torch.tensor(audio, dtype=torch.float32).unsqueeze(0).to(device)
attention_mask = torch.ones(input_values.shape[:2], dtype=torch.long, device=device)

with torch.no_grad():
    outputs = model(input_values=input_values, attention_mask=attention_mask)
    logits = outputs.logits
    frame_predictions = logits.argmax(dim=-1)

RESULT = {
    'logits': logits.detach().cpu().numpy(),
    'frame_predictions': frame_predictions.detach().cpu().numpy(),
    'sample_rate': sample_rate,
}
