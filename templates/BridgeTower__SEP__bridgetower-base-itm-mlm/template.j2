{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("BridgeTower/bridgetower-base-itm-mlm") %}
repo_id = "{{ repo_id }}"

import requests

info_url = f"https://huggingface.co/api/models/{repo_id}"
with requests.get(info_url, timeout=10) as response:
    response.raise_for_status()
    info = response.json()
for sibling in info.get("siblings", []):
    print(sibling)
