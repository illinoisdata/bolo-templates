{% set repo_id = repo_id | default("nboost/pt-tinybert-msmarco") %}
{% set device = device | default("cuda:0") %}
{% set text1 = text1 | default('query: what is bert? document: bert is a transformer model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text1 = "{{ text1 }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

device = torch.device(device if (str(device).startswith('cuda') and torch.cuda.is_available()) or str(device) == 'cpu' else 'cpu')

tokenizer = AutoTokenizer.from_pretrained(repo_id, vocab_file=vocab_path)
model = AutoModel.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location='cpu')
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text1, return_tensors='pt', truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
RESULT = {"last_hidden_state": last_hidden_state}
