{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("nboost/pt-tinybert-msmarco") %}
{% set text_input = text_input | default("Encode a sample Portuguese query with pt-tinybert-msmarco.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
).to(device)

outputs = model(**inputs)
cls_embedding = outputs.last_hidden_state[:, 0, :].squeeze(0).detach().cpu().tolist()

RESULT = {"cls_embedding": cls_embedding}
