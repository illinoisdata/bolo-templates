{% set repo_id = repo_id | default("airkingbd/dplm_650m") %}
{% set device = device | default("cuda:0") %}
{% set input_sequence = input_sequence | default('MKTIIALSYIFCLVFADYKDDDDK') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sequence = "{{ input_sequence }}"

import json
import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoConfig, AutoTokenizer, EsmForMaskedLM

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_hf_special_tokens = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_hf_tokenizer_config = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path), use_fast=False)
model = EsmForMaskedLM.from_pretrained(os.path.dirname(model_path), config=config, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(input_sequence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)
    token_ids = torch.argmax(probs, dim=-1)
    decoded = tokenizer.batch_decode(token_ids, skip_special_tokens=True)

RESULT = {
    "input_sequence": input_sequence,
    "logits_shape": list(logits.shape),
    "predicted_tokens": token_ids[0].detach().cpu().tolist(),
    "decoded_sequence": decoded[0],
}
