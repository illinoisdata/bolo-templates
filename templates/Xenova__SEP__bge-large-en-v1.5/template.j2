{% set repo_id = repo_id | default("Xenova/bge-large-en-v1.5") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Represent this sentence for searching relevant passages: The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoConfig, BertModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

local_device = torch.device(device if str(device).startswith("cuda") and torch.cuda.is_available() else "cpu")

tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path))
config = AutoConfig.from_pretrained(os.path.dirname(config_path))
model = BertModel(config)
model = model.to(local_device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", padding=True, truncation=True, max_length=512)
inputs = {k: v.to(local_device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden_state = outputs.last_hidden_state
    attention_mask = inputs["attention_mask"].unsqueeze(-1).type_as(last_hidden_state)
    summed = (last_hidden_state * attention_mask).sum(dim=1)
    counts = attention_mask.sum(dim=1).clamp(min=1e-9)
    embedding = summed / counts
    embedding = torch.nn.functional.normalize(embedding, p=2, dim=1)

output = embedding.squeeze(0).detach().cpu().numpy().astype(np.float32)

RESULT = {"embedding": output}
