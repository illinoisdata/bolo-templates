{% set repo_id = repo_id | default("Qwen/Qwen1.5-1.8B-Chat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('qwen1_5-1_8b-chat-q4_k_m.gguf') %}
{% set prompt = prompt | default('Write a short, friendly reply about why language models are useful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
model_dir = os.path.dirname(model_path)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if str(device).startswith('cuda') else 0,
    verbose=False,
)

output = llm.create_chat_completion(
    messages=[{"role": "user", "content": prompt}],
    temperature=0.0,
    top_p=1.0,
    max_tokens=64,
)

output_text = output["choices"][0]["message"]["content"].strip()

RESULT = {"text": output_text}
