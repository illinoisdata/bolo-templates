{% set input_text = "Correct this sentence: Thsi exampel contains errors to be fixed." %}
{% set max_new_tokens = 64 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/jxm__SEP__vec2text__openai_ada002__msmarco__msl128__corrector" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

import sys
import types
from pathlib import Path

import torch

dependency_module = types.ModuleType("transformers.dependency_versions_check")

def _require_version(*args, **kwargs):
    return None

def _dep_version_check(*args, **kwargs):
    return {}

dependency_module.require_version = _require_version
# also stub core and post_process if used
dependency_module.require_version_core = _require_version
dependency_module.require_version_post_process = _require_version
dependency_module.dep_version_check = _dep_version_check
# override both root and utils versions
sys.modules["transformers.dependency_versions_check"] = dependency_module
sys.modules["transformers.utils.dependency_versions_check"] = dependency_module

from transformers import T5Config, T5ForConditionalGeneration, T5Tokenizer

torch_device = torch.device(device)

config = T5Config.from_pretrained("t5-base")
tokenizer = T5Tokenizer.from_pretrained("t5-base")
model = T5ForConditionalGeneration.from_pretrained(repo_id, config=config).to(torch_device)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"corrected_text": generated_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "corrected_text.txt").write_text(RESULT["corrected_text"], encoding="utf-8")