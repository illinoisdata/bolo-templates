{% set repo_id = repo_id | default("utrobinmv/t5_translate_en_ru_zh_large_1024") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('translate to ru: The purpose of the development is to provide users with a personal synchronized interpreter.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"

import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer

model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()
tokenizer = T5Tokenizer.from_pretrained(repo_id, use_fast=False)

inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_tokens = model.generate(**inputs, max_new_tokens=64)
output_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": output_text}
