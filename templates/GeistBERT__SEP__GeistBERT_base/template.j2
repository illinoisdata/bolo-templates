{% set repo_id = repo_id | default("GeistBERT/GeistBERT_base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein einfacher Beispielsatz für die Maskierung.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    local_files_only=True,
    vocab_file=vocab_path,
    merges_file=merges_path,
)

model = AutoModelForMaskedLM.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    masked_positions = (inputs["input_ids"] == tokenizer.mask_token_id).nonzero(as_tuple=False)
    if masked_positions.numel() == 0:
        top_token_ids = torch.topk(logits[0, -1], k=5).indices
        output = tokenizer.convert_ids_to_tokens(top_token_ids.tolist())
    else:
        b, pos = masked_positions[0].tolist()
        top_token_ids = torch.topk(logits[b, pos], k=5).indices
        output = tokenizer.convert_ids_to_tokens(top_token_ids.tolist())

RESULT = {"output": output}
