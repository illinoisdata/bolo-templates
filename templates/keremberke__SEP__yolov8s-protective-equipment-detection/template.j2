{% set repo_id = repo_id | default("keremberke/yolov8s-protective-equipment-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

from urllib.parse import urlparse
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

model_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if urlparse(image).scheme in ("http", "https"):
    input_image = image
else:
    input_image = Image.open(image).convert("RGB")

model = YOLO(model_path)
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(source=input_image, device=device, verbose=False)
result0 = results[0]
boxes = result0.boxes.data.cpu().tolist() if result0.boxes is not None else []
names = result0.names

RESULT = {
    "boxes": boxes,
    "names": names,
}
