{% set repo_id = repo_id | default("lmstudio-community/Qwen2.5-0.5B-Instruct-MLX-4bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Write a short haiku about machine learning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoConfig, Qwen2ForCausalLM

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
merged_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
sp_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = AutoTokenizer.from_pretrained(model_file.rsplit('/', 1)[0], use_fast=True)
config = AutoConfig.from_pretrained(model_file.rsplit('/', 1)[0])
model = Qwen2ForCausalLM(config)
model.to(device)
model.eval()

messages = [{"role": "user", "content": prompt}]
chat_text = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)
inputs = tokenizer(chat_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(model.device)

with torch.no_grad():
    generated = model.generate(
        input_ids=input_ids,
        max_new_tokens=8,
        do_sample=False,
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.eos_token_id,
    )

output_text = tokenizer.decode(generated[0][input_ids.shape[-1]:], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
