{% set repo_id = repo_id | default("laion/larger_clap_music_and_speech") %}
{% set task = task | default("zero-shot-audio-classification") %}
{% set device = device | default("cuda:0") %}
{% set audio_file = audio_file | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set candidate_labels = candidate_labels | default(["Sound of a dog", "Sound of vaccum cleaner"]) %}

# Jinja2-rendered variable assignments
task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
audio_file = {{ audio_file | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(audio_file, candidate_labels=candidate_labels)
