{% set repo_id = repo_id | default("magic-leap-community/superglue_outdoor") %}
{% set device = device | default("cuda:0") %}
{% set image1 = image1 | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set image2 = image2 | default('/u/yunqili4/projects/ML-code-generation/data/image2.jpeg') %}
{% set threshold = threshold | default(0.2) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image1 = "{{ image1 }}"
image2 = "{{ image2 }}"
threshold = {{ threshold }}

import requests
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoImageProcessor, SuperGlueForKeypointMatching

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

if image1.startswith("http://") or image1.startswith("https://"):
    image_1 = Image.open(requests.get(image1, stream=True).raw).convert("RGB")
else:
    image_1 = Image.open(image1).convert("RGB")
if image2.startswith("http://") or image2.startswith("https://"):
    image_2 = Image.open(requests.get(image2, stream=True).raw).convert("RGB")
else:
    image_2 = Image.open(image2).convert("RGB")

images = [[image_1, image_2]]
processor = AutoImageProcessor.from_pretrained(repo_id)
model = SuperGlueForKeypointMatching.from_pretrained(repo_id).to(device)
model.eval()

inputs = processor(images, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

image_sizes = [[(img.height, img.width) for img in pair] for pair in images]
processed = processor.post_process_keypoint_matching(outputs, image_sizes, threshold=threshold)
output = processed[0]

RESULT = {"matches": output}
