{% set device = "cuda:0" %}
{% set repo_id = "KES/T5-KES" %}
{% set text_input = "I am lived with my parenmts " %}
{% set prefix = "grammar: " %}
{% set num_beams = 4 %}
{% set max_length = 512 %}

repo_id = "{{ repo_id }}"
device = {{ device | tojson }}
text_input = {{ text_input | tojson }}
prefix = {{ prefix | tojson }}
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

prefixed_input = prefix + text_input
encoded_input = tokenizer(prefixed_input, truncation=True, return_tensors="pt")
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

generated_ids = model.generate(
    **encoded_input,
    num_beams=num_beams,
    max_length=max_length,
    early_stopping=True,
)
decoded_outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
correction = decoded_outputs[0].strip() if decoded_outputs else ""

RESULT = {"correction": correction}
