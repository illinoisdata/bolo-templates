repo_id = "{{ repo_id }}"
device = "{{ device }}"
pred_length = {{ pred_length }}
context_length = {{ context_length }}
num_samples = {{ num_samples }}
batch_size = {{ batch_size }}
history_values = {{ history_values }}

import torch
import pandas as pd

index = pd.date_range("2020-01-01", periods=len(history_values), freq="D")
series = torch.tensor(history_values, dtype=torch.float32, device=device)
mean = series[-context_length:].mean()
std = series[-context_length:].std(unbiased=False).clamp_min(1e-6)
last = series[-1]
steps = torch.arange(1, pred_length + 1, device=device, dtype=torch.float32)
trend = (last - series[-context_length]) / max(context_length - 1, 1)
output = (last + trend * steps).cpu().tolist()

RESULT = {
    "forecast": output,
    "mean_level": float(mean.cpu().item()),
    "std_level": float(std.cpu().item()),
}
