{% set repo_id = repo_id | default("SmilingWolf/wd-vit-tagger-v3") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set threshold = threshold | default(0.35) %}
{% set top_k = top_k | default(20) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
threshold = {{ threshold }}
top_k = {{ top_k }}

import csv
import json
import requests
import torch
import timm
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from timm.data import create_transform

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
meta_file = hf_hub_download(repo_id=repo_id, filename="sw_jax_cv_config.json")

with open(config_file, "r") as f:
    cfg = json.load(f)
with open(meta_file, "r") as f:
    meta = json.load(f)

if image_path.startswith(("http://", "https://")):
    img = Image.open(requests.get(image_path, stream=True, timeout=30).raw).convert("RGB")
else:
    img = Image.open(image_path).convert("RGB")

img_size = cfg["model_args"].get("img_size", 448)
model = timm.create_model(cfg["architecture"], pretrained=False, num_classes=cfg["num_classes"], img_size=img_size)
state_dict = load_file(weights_file, device="cpu")
state_dict.pop("pos_embed", None)
state_dict.pop("cls_token", None)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

pretrained_cfg = cfg["pretrained_cfg"]
transform = create_transform(
    input_size=tuple(pretrained_cfg.get("input_size", [3, img_size, img_size]))[1:],
    mean=pretrained_cfg.get("mean", [0.5, 0.5, 0.5]),
    std=pretrained_cfg.get("std", [0.5, 0.5, 0.5]),
    crop_pct=pretrained_cfg.get("crop_pct", 1.0),
    interpolation=pretrained_cfg.get("interpolation", "bicubic"),
    is_training=False,
)
image_tensor = transform(img).unsqueeze(0).to(device)

with torch.inference_mode():
    logits = model(image_tensor)
    probs = torch.sigmoid(logits)[0].detach().cpu().tolist()

labels = meta.get("tagNames") or meta.get("tags") or meta.get("labels")
if labels is None:
    labels = []
    with open(hf_hub_download(repo_id=repo_id, filename="selected_tags.csv"), "r", encoding="utf-8") as f:
        reader = csv.reader(f)
        rows = list(reader)
    for row in rows[1:]:
        if row:
            labels.append(row[-1])

pairs = sorted(((labels[i], float(probs[i])) for i in range(min(len(labels), len(probs)))), key=lambda x: x[1], reverse=True)
RESULT = {"predictions": [{"tag": tag, "score": score} for tag, score in pairs[:top_k] if score >= threshold]}
