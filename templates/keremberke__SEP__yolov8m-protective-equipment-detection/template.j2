{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
{% set repo_id = repo_id | default("keremberke/yolov8m-protective-equipment-detection") %}
{% set device = device | default("cuda:0") %}
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import os
from pathlib import Path
import requests
from PIL import Image
from ultralytics import YOLO

# Download model files from Hub
from huggingface_hub import hf_hub_download
weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")

# Pre-process input & load model
if image.startswith(("http://", "https://")):
    image_input = Image.open(requests.get(image, stream=True, timeout=30).raw).convert("RGB")
else:
    image_input = Image.open(image).convert("RGB")

model = YOLO(weights_path)

# Run inference
results = model.predict(image_input, conf=conf, iou=iou, max_det=max_det, agnostic_nms=agnostic_nms, device=device, verbose=False)
boxes = results[0].boxes
rendered = Image.fromarray(results[0].plot()[:, :, ::-1])

# Post-process & build RESULT dict
RESULT = {"boxes": boxes, "rendered": rendered}
