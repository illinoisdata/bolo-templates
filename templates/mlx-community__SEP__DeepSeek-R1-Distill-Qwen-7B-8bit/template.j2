{% set repo_id = repo_id | default("mlx-community/DeepSeek-R1-Distill-Qwen-7B-8bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('hello') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer, AutoConfig
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")
config = AutoConfig.from_pretrained(repo_id, trust_remote_code=True)
if hasattr(config, "quantization_config"):
    delattr(config, "quantization_config")
tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
model = AutoModelForCausalLM.from_pretrained(repo_id, config=config, trust_remote_code=True, low_cpu_mem_usage=True, ignore_mismatched_sizes=True)
model.to(device)
model.eval()

if tokenizer.chat_template is not None:
    messages = [{"role": "user", "content": prompt}]
    prompt = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)

inputs = tokenizer(prompt, return_tensors="pt").to(device)
with torch.no_grad():
    generated = model.generate(**inputs, max_new_tokens=32, do_sample=False)
text = tokenizer.decode(generated[0], skip_special_tokens=True)
RESULT = {"text": text}
