{% set sample_text = "이것은 Electra 기반 모델 테스트 문장입니다." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/kykim__SEP__electra-kor-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sample_text = "{{ sample_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
import json

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

raw_inputs = tokenizer(
    sample_text,
    return_tensors="pt",
    truncation=True,
    padding="longest",
)
inputs = {key: value.to(device) for key, value in raw_inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

lm_logits = outputs.logits
softmax_probs = torch.softmax(lm_logits, dim=-1)
top_probs, top_indices = softmax_probs.topk(k=1, dim=-1)

input_token_ids = inputs["input_ids"].squeeze(0)
token_list = tokenizer.convert_ids_to_tokens(input_token_ids.tolist())
predicted_token_ids = top_indices.squeeze(-1).squeeze(0)
predicted_tokens = tokenizer.convert_ids_to_tokens(predicted_token_ids.tolist())
confidences = top_probs.squeeze(-1).squeeze(0).tolist()

RESULT = {
    "tokens": token_list,
    "masked_lm_predictions": predicted_tokens,
    "masked_lm_confidences": confidences,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "tokens.txt").write_text("\n".join(RESULT["tokens"]), encoding="utf-8")
    (output_path / "masked_lm_predictions.txt").write_text(
        "\n".join(RESULT["masked_lm_predictions"]),
        encoding="utf-8",
    )
    with (output_path / "masked_lm_confidences.json").open("w", encoding="utf-8") as confidence_file:
        json.dump(RESULT["masked_lm_confidences"], confidence_file, ensure_ascii=False, indent=2)