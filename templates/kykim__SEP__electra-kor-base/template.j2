{% set repo_id = repo_id | default("kykim/electra-kor-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('안녕하세요. 반갑습니다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import ElectraTokenizerFast, ElectraModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = ElectraTokenizerFast(vocab_file=vocab_path, tokenizer_file=None)
model = ElectraModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()

RESULT = {"last_hidden_state": last_hidden_state}
