{% set repo_id = repo_id | default("StanfordAIMI/SRR-BERT-Leaves-with-Statuses") %}
{% set device = device | default("cuda:0") %}
{% set sentence = sentence | default("Patchy consolidation in the left retrocardiac area, suggestive of atelectasis or early airspace disease.") %}
{% set max_length = max_length | default(128) %}
{% set threshold = threshold | default(0.5) %}
{% set mapping_url = mapping_url | default("https://raw.githubusercontent.com/jbdel/StructEval/refs/heads/main/structeval/leaves_with_statuses_mapping.json") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence = {{ sentence | tojson }}
max_length = {{ max_length }}
threshold = {{ threshold }}
mapping_url = {{ mapping_url | tojson }}

import json
import os
import requests
import torch
from transformers import BertTokenizer, BertForSequenceClassification
from huggingface_hub import hf_hub_download

mapping_resp = requests.get(mapping_url, timeout=30)
mapping_resp.raise_for_status()
label_map = mapping_resp.json()
idx2label = {v: k for k, v in label_map.items()}

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

with open(config_file, "r") as f:
    config = json.load(f)
num_labels = len(label_map)

model = BertForSequenceClassification.from_pretrained(
    os.path.dirname(model_file),
    config=os.path.dirname(config_file),
    local_files_only=True,
)
model.to(device).eval()

tokenizer = BertTokenizer.from_pretrained(os.path.dirname(tokenizer_file), local_files_only=True)

inputs = tokenizer(
    sentence,
    padding="max_length",
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    logits = model(**inputs).logits
    probs = torch.sigmoid(logits)[0].detach().cpu().tolist()

pred_labels = [idx2label[i] for i, p in enumerate(probs) if p > threshold]

RESULT = {
    "sentence": sentence,
    "predicted_labels": pred_labels,
    "probabilities": probs,
}
