{% set repo_id = repo_id | default("keremberke/yolov8m-blood-cell-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import requests
from io import BytesIO
from PIL import Image
from ultralytics import YOLO

model = YOLO('/workspace/model.pt')
model = YOLO(model.ckpt_path if hasattr(model, 'ckpt_path') else '/workspace/model.pt')
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

if image.startswith('http://') or image.startswith('https://'):
    image_input = Image.open(BytesIO(requests.get(image, timeout=30).content)).convert('RGB')
else:
    image_input = Image.open(image).convert('RGB')

results = model.predict(image_input, device=device)
output = {'boxes': results[0].boxes}
RESULT = output
