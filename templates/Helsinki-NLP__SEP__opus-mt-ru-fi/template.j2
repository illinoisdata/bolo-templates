{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ru-fi") %}
{% set input_text = input_text | default("Привет, мир!") %}
{% set max_length = max_length | default(512) %}
{% set num_beams = num_beams | default(6) %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
max_new_tokens = {{ max_new_tokens }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model.eval()
inputs = tokenizer(
    [input_text],
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
    )

decoded_translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": decoded_translations}
