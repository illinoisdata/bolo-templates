{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-sq-en") %}
{% set input_text = input_text | default("Përshëndetje botë!") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(6) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(
    [input_text],
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations}
