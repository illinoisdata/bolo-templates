repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
from huggingface_hub import hf_hub_download
from punctuators.models import PunctCapSegModelONNX

_onnx_path = hf_hub_download(repo_id=repo_id, filename="punct_cap_seg_en.onnx")
_spe_path = hf_hub_download(repo_id=repo_id, filename="spe_32k_lc_en.model")

model = PunctCapSegModelONNX.from_pretrained("pcs_en")
output = model.infer([text])[0]

RESULT = {"output": output}
