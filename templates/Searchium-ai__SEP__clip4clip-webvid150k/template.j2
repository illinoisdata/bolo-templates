{% set repo_id = repo_id | default("Searchium-ai/clip4clip-webvid150k") %}
{% set device = device | default("cuda:0") %}
{% set search_sentence = search_sentence | default('a basketball player performing a slam dunk') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
search_sentence = "{{ search_sentence }}"
image_path = "{{ image_path }}"

import requests
import torch
from PIL import Image
from io import BytesIO
from transformers import CLIPTokenizer, CLIPTextModelWithProjection
from huggingface_hub import snapshot_download

model_dir = snapshot_download(repo_id, allow_patterns=['config.json','model.safetensors','tokenizer.json','tokenizer_config.json','special_tokens_map.json','vocab.json','merges.txt','preprocessor_config.json'])

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path, timeout=30)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = CLIPTextModelWithProjection.from_pretrained(model_dir, local_files_only=True).to(device)
model.eval()
tokenizer = CLIPTokenizer.from_pretrained(model_dir, local_files_only=True)

inputs = tokenizer(text=search_sentence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(input_ids=inputs["input_ids"], attention_mask=inputs["attention_mask"])
    embeddings = outputs[0]
    embeddings = embeddings / embeddings.norm(dim=-1, keepdim=True)

RESULT = {"text_embedding": embeddings.detach().cpu().numpy(), "image": image}
