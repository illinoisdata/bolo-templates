{% set repo_id = repo_id | default("segment-any-text/sat-12l") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}

task = "{{ task }}"
model = "{{ model }}"
device = "{{ device }}"
input_prompt = "{{ input_prompt }}"

from transformers import (
    AutoConfig,
    AutoModelForTokenClassification,
    XLMRobertaConfig,
    XLMRobertaForTokenClassification,
    XLMRobertaTokenizerFast,
    pipeline,
)

class SubwordXLMConfig(XLMRobertaConfig):
    model_type = "xlm-token"


class SubwordXLMForTokenClassification(XLMRobertaForTokenClassification):
    config_class = SubwordXLMConfig


AutoConfig.register("xlm-token", SubwordXLMConfig, exist_ok=True)
AutoModelForTokenClassification.register(
    SubwordXLMConfig,
    SubwordXLMForTokenClassification,
    exist_ok=True,
)

tokenizer = XLMRobertaTokenizerFast.from_pretrained("xlm-roberta-base")
pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt)
