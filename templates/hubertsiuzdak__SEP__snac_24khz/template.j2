{% set repo_id = "hubertsiuzdak/snac_24khz" %}
{% set device = "cuda:0" %}
{% set audio_path = "/u/yli77/projects/ML-code-generation/data/audio.wav" %}
{% set sampling_rate = 24000 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/hubertsiuzdak__SEP__snac_24khz" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sampling_rate = {{ sampling_rate }}
output_dir = "{{ output_dir }}"

import os
import requests
from io import BytesIO
import torch
import torchaudio
from snac import SNAC
import json

model = SNAC.from_pretrained(repo_id).eval().to(device)

if audio_path.startswith("http"):
    response = requests.get(audio_path)
    response.raise_for_status()
    waveform, sr = torchaudio.load(BytesIO(response.content))
else:
    waveform, sr = torchaudio.load(audio_path)

if sr != sampling_rate:
    waveform = torchaudio.functional.resample(waveform, sr, sampling_rate)

waveform = waveform.to(device)
audio_input = waveform.unsqueeze(0)

with torch.inference_mode():
    codes = model.encode(audio_input)
    audio_hat = model.decode(codes)

audio_hat = audio_hat.squeeze(0).cpu()
codes = [code.cpu().numpy().tolist() for code in codes]

RESULT = {"audio_hat": audio_hat, "codes": codes}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    torchaudio.save(os.path.join(output_dir, "audio_hat.wav"), RESULT["audio_hat"], sampling_rate)
    with open(os.path.join(output_dir, "codes.json"), "w") as f:
        json.dump(RESULT["codes"], f)