{% set repo_id = repo_id | default("hubertsiuzdak/snac_24khz") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import json
import torch
from huggingface_hub import hf_hub_download
from snac import SNAC
from scipy.io import wavfile
import numpy as np

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    config = json.load(f)

sample_rate, audio = wavfile.read(audio_path)
if audio.ndim > 1:
    audio = audio[:, 0]

if audio.dtype.kind in {"i", "u"}:
    max_val = np.iinfo(audio.dtype).max
    audio = audio.astype(np.float32) / max_val
else:
    audio = audio.astype(np.float32)

audio_tensor = torch.from_numpy(audio).unsqueeze(0).unsqueeze(0)

model = SNAC.from_pretrained(repo_id)
model = model.to(device).eval()
audio_tensor = audio_tensor.to(device)

with torch.inference_mode():
    audio_hat, codes = model(audio_tensor)

RESULT = {
    "reconstructed_audio": audio_hat.detach().cpu(),
    "codes": [c.detach().cpu() for c in codes],
}
