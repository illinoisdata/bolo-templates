{% set repo_id = repo_id | default("deepset/bert-base-uncased-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Why is model conversion important?') %}
{% set context = context | default('The option to convert models between FARM and transformers gives freedom to the user and let people easily switch between frameworks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

model = AutoModelForQuestionAnswering.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0, start_idx:end_idx + 1]
answer = tokenizer.decode(input_ids, skip_special_tokens=True).strip()
score = float((start_logits[0, start_idx] + end_logits[0, end_idx]).item())

RESULT = {"answer": answer, "score": score}
