{% set repo_id = repo_id | default("RE-N-Y/t5-v1_1-xxl") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, T5EncoderModel

# Load tokenizer and model directly from the repository

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = T5EncoderModel.from_pretrained(repo_id, torch_dtype=torch.bfloat16)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = last_hidden_state[:, 0, :]
RESULT = {"last_hidden_state": last_hidden_state, "pooler_output": pooler_output}
