{% set repo_id = repo_id | default("RE-N-Y/t5-v1_1-xxl") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("This is a test sentence.") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from transformers import AutoTokenizer, T5EncoderModel
import torch
import numpy as np

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = T5EncoderModel.from_pretrained(repo_id).to(device)

# Pre-process input text
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
outputs = model(**inputs)
last_hidden_states = outputs.last_hidden_state

# Post-process to numpy array
embeddings = last_hidden_states.detach().to(torch.float32).cpu().numpy()

# Build result dict
RESULT = {"embeddings": embeddings}

if __name__ == "__main__":
    # Save embeddings to disk (saved in the current working directory)
    np.save("embeddings.npy", RESULT["embeddings"])