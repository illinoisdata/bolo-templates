{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set text_input = text_input | default('What is the document about?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_input = "{{ text_input }}"

import os
import io
import torch
from PIL import Image
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download
from transformers import LayoutLMv3Processor, LayoutLMv3ForSequenceClassification

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

if urlparse(image_path).scheme in ("http", "https"):
    import requests
    image = Image.open(io.BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

processor_dir = os.path.dirname(processor_path)
processor = LayoutLMv3Processor.from_pretrained(processor_dir)
model = LayoutLMv3ForSequenceClassification.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

encoding = processor(image, text_input, return_tensors='pt')
encoding = {k: v.to(device) for k, v in encoding.items()}
with torch.no_grad():
    outputs = model(**encoding)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)
    pred_idx = int(torch.argmax(probs, dim=-1).item())
    pred_label = model.config.id2label.get(pred_idx, str(pred_idx))
    confidence = float(probs[0, pred_idx].item())

RESULT = {
    "predicted_label": pred_label,
    "predicted_index": pred_idx,
    "confidence": confidence,
    "logits": logits.detach().cpu().tolist(),
}
