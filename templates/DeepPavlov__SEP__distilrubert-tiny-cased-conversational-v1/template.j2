{% set repo_id = repo_id | default("DeepPavlov/distilrubert-tiny-cased-conversational-v1") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Привет, как [MASK]?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import json
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

# Identify mask token position
mask_positions = (inputs["input_ids"][0] == tokenizer.mask_token_id).nonzero(as_tuple=True)[0]
mask_pos = mask_positions.item()

logits = outputs.logits
mask_logits = logits[0, mask_pos]
probs = torch.softmax(mask_logits, dim=-1)
topk = torch.topk(probs, k=5)
topk_indices = topk.indices.tolist()
topk_probs = topk.values.tolist()
topk_tokens = tokenizer.convert_ids_to_tokens(topk_indices)

RESULT = {"tokens": topk_tokens, "scores": topk_probs}
