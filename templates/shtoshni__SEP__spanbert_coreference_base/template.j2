{% set device = "cuda:0" %}
{% set repo_id = "shtoshni/spanbert_coreference_base" %}
{% set text = "The quick brown fox jumps over the lazy dog." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import json
import os
import torch

from transformers import BertModel, BertTokenizerFast

tokenizer = BertTokenizerFast.from_pretrained(repo_id)
model = BertModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

pooled_output = outputs.pooler_output
if pooled_output is not None:
    pooled_output = pooled_output[0].cpu().tolist()

first_token_hidden_state = outputs.last_hidden_state[0, 0].cpu().tolist()

RESULT = {
    "pooled_output": pooled_output,
    "first_token_hidden_state": first_token_hidden_state,
}
