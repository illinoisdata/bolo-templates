{% set repo_id = repo_id | default("dbmdz/bert-base-turkish-uncased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Merhaba dünya") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
outputs = model(**inputs)
last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()

RESULT = {"last_hidden_state": last_hidden_state}
