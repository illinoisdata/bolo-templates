{% set repo_id = repo_id | default("ai-forever/RuM2M100-418M") %}
{% set device = device | default("cuda:0") %}
{% set sentence = sentence | default('прийдя в МГТУ я был удивлен никого необноружив там…') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence = "{{ sentence }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import M2M100ForConditionalGeneration, M2M100Tokenizer

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

model = M2M100ForConditionalGeneration.from_pretrained(repo_id, local_files_only=True)
tokenizer = M2M100Tokenizer.from_pretrained(
    repo_id,
    src_lang="ru",
    tgt_lang="ru",
    local_files_only=True,
)

inputs = tokenizer(sentence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
model = model.to(device)
model.eval()

with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        forced_bos_token_id=tokenizer.get_lang_id("ru"),
        max_length=200,
        num_beams=5,
    )

output = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"output": output}
