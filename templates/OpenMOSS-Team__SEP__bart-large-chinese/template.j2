{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("OpenMOSS-Team/bart-large-chinese") %}
{% set text_input = text_input | default("北京是[MASK]的首都") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}
{% set output_filename = output_filename | default("generated_text.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ "True" if do_sample else "False" }}
output_filename = "{{ output_filename }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
# Only input_ids and attention_mask are supported for generation
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items() if k in ["input_ids", "attention_mask"]}

with torch.no_grad():
    generated_ids = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_beams=num_beams,
        do_sample=do_sample,
    )

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
primary_generated_text = generated_texts[0] if generated_texts else ""

RESULT = {"generated_text": primary_generated_text}
