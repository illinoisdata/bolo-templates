{% set repo_id = repo_id | default("OpenMOSS-Team/bart-large-chinese") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("北京是[MASK]的首都") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import BertTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

_tokenizer = BertTokenizer.from_pretrained(os.path.dirname(vocab_path), local_files_only=True)
_model = BartForConditionalGeneration.from_pretrained(os.path.dirname(weights_path), local_files_only=True)
_model = _model.to(device)
_model.eval()

inputs = _tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items() if k != "token_type_ids"}
with torch.no_grad():
    generated = _model.generate(**inputs, max_length=50, do_sample=False)
output = _tokenizer.batch_decode(generated, skip_special_tokens=True)

RESULT = {"output": output}
