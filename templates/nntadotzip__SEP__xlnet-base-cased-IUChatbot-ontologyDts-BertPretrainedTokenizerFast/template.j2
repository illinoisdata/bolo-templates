{% set repo_id = repo_id | default("nntadotzip/xlnet-base-cased-IUChatbot-ontologyDts-BertPretrainedTokenizerFast") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the answer?') %}
{% set context = context | default('') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, XLNetForQuestionAnsweringSimple, XLNetConfig
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = XLNetConfig.from_json_file(config_file)

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
    tokenizer_file=tokenizer_file,
    tokenizer_config_file=tokenizer_config_file,
    special_tokens_map_file=special_tokens_map_file,
    vocab_file=vocab_file,
)
model = XLNetForQuestionAnsweringSimple(config)
state_dict = torch.load(model_file, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

if context:
    inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
else:
    inputs = tokenizer(question, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx:end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True)

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
