{% set text = text | default("George returned to Berlin to return his hat.") %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("flair/frame-english-fast") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from flair.data import Sentence
from flair.models import SequenceTagger

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tagger = SequenceTagger.load(weights_path)
tagger = tagger.to(torch.device(device))

sentence = Sentence(text)
tagger.predict(sentence)

spans = []
for span in sentence.get_spans("frame"):
    spans.append({
        "text": span.text,
        "tag": span.get_label("frame").value,
        "score": float(span.get_label("frame").score),
        "start_pos": span.start_position,
        "end_pos": span.end_position,
    })

RESULT = {"spans": spans, "sentence": sentence.to_tokenized_string()}
