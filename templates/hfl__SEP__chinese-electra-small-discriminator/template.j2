{% set repo_id = "hfl/chinese-electra-small-discriminator" %}
{% set device = "cuda:0" %}
{% set text = text if text is defined else "我爱自然语言处理。" %}
{% set threshold = threshold if threshold is defined else 0.5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
threshold = {{ threshold }}

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForPreTraining

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
probabilities = torch.sigmoid(logits)
predictions = probabilities > threshold

RESULT = {
    "logits": logits.cpu().tolist(),
    "probabilities": probabilities.cpu().tolist(),
    "predictions": predictions.cpu().tolist(),
}
