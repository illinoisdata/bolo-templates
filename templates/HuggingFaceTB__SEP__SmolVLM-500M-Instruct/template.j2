{% set repo_id = repo_id | default("HuggingFaceTB/SmolVLM-500M-Instruct") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-text-to-text") %}
{% set model = model | default(repo_id) %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set input_prompt = input_prompt | default("Describe this image") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
input_prompt = {{ input_prompt | tojson }}

import torch
if not torch.cuda.is_available():
    device = "cpu"

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

processor = pipe.processor if pipe.processor is not None else pipe.tokenizer
chat_template = getattr(processor, "chat_template", None)
if chat_template is None and hasattr(processor, "tokenizer"):
    chat_template = getattr(processor.tokenizer, "chat_template", None)

if chat_template is not None:
    messages = [
        {
            "role": "user",
            "content": [
                {"type": "image", "image": input_image},
                {"type": "text", "text": input_prompt},
            ],
        },
    ]
    pipeline_output = pipe(text=messages)
else:
    pipeline_output = pipe(input_image, text=input_prompt)

RESULT = {"outputs": pipeline_output}
