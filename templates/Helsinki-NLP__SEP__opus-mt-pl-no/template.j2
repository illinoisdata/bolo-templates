{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-pl-no") %}
{% set text_input = text_input | default("Cześć, jak się masz?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}
generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations}
