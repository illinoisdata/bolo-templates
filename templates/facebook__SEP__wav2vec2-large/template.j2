{% set repo_id = repo_id | default("facebook/wav2vec2-large") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import io
import numpy as np
import torch
import soundfile as sf
from transformers import AutoModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = AutoModel.from_pretrained(os.path.dirname(weights_path), local_files_only=True)
model.to(device)
model.eval()

if audio_path.startswith(("http://", "https://")):
    import requests
    audio_bytes = requests.get(audio_path).content
    waveform, sample_rate = sf.read(io.BytesIO(audio_bytes))
else:
    waveform, sample_rate = sf.read(audio_path)

if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)
if sample_rate != 16000:
    import librosa
    waveform = librosa.resample(waveform.astype(np.float32), orig_sr=sample_rate, target_sr=16000)
    sample_rate = 16000

input_values = torch.tensor(waveform, dtype=torch.float32, device=device).unsqueeze(0)
with torch.no_grad():
    outputs = model(input_values=input_values)
last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
mean_hidden_state = last_hidden_state.mean(axis=1)

RESULT = {"last_hidden_state": last_hidden_state, "mean_hidden_state": mean_hidden_state}
