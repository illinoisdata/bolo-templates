{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("alicekyting/Qwen2-Audio-7B-Instruct-4bit") %}
{% set audio_path = audio_path | default('/u/yli77/projects/ML-code-generation/data/audio.wav') %}
{% set output_path = output_path | default('/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/alicekyting__SEP__Qwen2-Audio-7B-Instruct-4bit/response.txt') %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set user_instruction = user_instruction | default('Please describe the sound you hear and any context you can infer.') %}
{% set system_prompt = system_prompt | default('You are a helpful assistant specializing in understanding and describing short audio clips.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
output_path = "{{ output_path }}"
max_new_tokens = {{ max_new_tokens }}
user_instruction = "{{ user_instruction }}"
system_prompt = "{{ system_prompt }}"

from io import BytesIO
from pathlib import Path
from urllib.request import urlopen

import librosa
import torch
from transformers import (
    AutoProcessor,
    BitsAndBytesConfig,
    Qwen2AudioForConditionalGeneration,
)

bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_compute_dtype=torch.float16,
)
processor = AutoProcessor.from_pretrained(repo_id)
model = Qwen2AudioForConditionalGeneration.from_pretrained(
    repo_id,
    quantization_config=bnb_config,
)
model = model.to(device)

sampling_rate = processor.feature_extractor.sampling_rate

def _load_audio_file(path: str, sr: int):
    if path.lower().startswith(("http://", "https://")):
        with urlopen(path) as response:
            return librosa.load(BytesIO(response.read()), sr=sr, mono=True)[0]
    return librosa.load(path, sr=sr, mono=True)[0]

conversation = [
    {"role": "system", "content": system_prompt},
    {
        "role": "user",
        "content": [
            {"type": "audio", "audio_url": audio_path},
            {"type": "text", "text": user_instruction},
        ],
    },
]

text = processor.apply_chat_template(conversation, add_generation_prompt=True, tokenize=False)
audios = []
for message in conversation:
    content = message.get("content")
    if isinstance(content, list):
        for element in content:
            if element.get("type") == "audio":
                audios.append(_load_audio_file(element["audio_url"], sampling_rate))

inputs = processor(text=text, audios=audios, return_tensors="pt", padding=True)
inputs = {name: value.to(device) for name, value in inputs.items()}

generate_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
context_length = inputs["input_ids"].size(1)
generate_ids = generate_ids[:, context_length:]
response = processor.batch_decode(
    generate_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=False,
)[0]

RESULT = {"response": response}
