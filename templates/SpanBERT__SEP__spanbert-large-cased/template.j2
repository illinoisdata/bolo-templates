{% set repo_id = repo_id | default("SpanBERT/spanbert-large-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('SpanBERT is a strong baseline for contextual embeddings and sentence understanding.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
vocab_path = hf_hub_download(repo_id=repo_id, filename='vocab.txt')
repo_dir = weights_path.rsplit('/', 1)[0]

_tokenizer_dir = vocab_path.rsplit('/', 1)[0]
tokenizer = AutoTokenizer.from_pretrained(_tokenizer_dir, use_fast=False)
model = AutoModel.from_pretrained(repo_dir, config=config_path, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    'last_hidden_state': outputs.last_hidden_state.detach().cpu(),
    'pooler_output': outputs.pooler_output.detach().cpu() if getattr(outputs, 'pooler_output', None) is not None else None,
}
