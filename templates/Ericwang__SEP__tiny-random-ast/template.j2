{% set repo_id = repo_id | default("Ericwang/tiny-random-ast") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("audio-classification") %}
{% set audio_path = audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

task = {{ task | tojson }}
audio_path = {{ audio_path | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

prepared_audio = audio_path

RESULT = pipe(prepared_audio)
