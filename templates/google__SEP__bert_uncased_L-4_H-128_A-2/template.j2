{% set repo_id = repo_id | default("google/bert_uncased_L-4_H-128_A-2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, my dog is cute') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

repo_dir = os.path.dirname(vocab_file)
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=True)
model = AutoModelForMaskedLM.from_pretrained(repo_dir)
model.to(device)
model.eval()

if tokenizer.mask_token not in text:
    text = text + " " + tokenizer.mask_token

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    mask_index = (inputs["input_ids"][0] == tokenizer.mask_token_id).nonzero(as_tuple=False).item()
    mask_logits = logits[0, mask_index]
    topk = torch.topk(mask_logits, k=5)
    top_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
    top_scores = topk.values.tolist()

RESULT = {"masked_text": text, "top_tokens": top_tokens, "top_scores": top_scores}
