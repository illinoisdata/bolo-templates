{% set repo_id = repo_id | default("guillaumekln/faster-whisper-small.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(5) %}
{% set compute_type = compute_type | default('int8') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
compute_type = "{{ compute_type }}"

from pathlib import Path
import urllib.request
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_bin = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")
model_dir = str(Path(model_bin).parent)

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    local_audio = "/tmp/audio_input" + Path(urlparse(audio_path).path).suffix
    urllib.request.urlretrieve(audio_path, local_audio)
    audio_path = local_audio

fw_device = "cpu"
model = WhisperModel(model_dir, device=fw_device, compute_type=compute_type)
segments, info = model.transcribe(audio_path, language=language, beam_size=beam_size)
transcript = "".join(segment.text for segment in segments).strip()

RESULT = {"transcript": transcript, "language": info.language, "duration": info.duration}
