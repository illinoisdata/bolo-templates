{% set text = text | default('passage: The Eiffel Tower is located in Paris and is one of the most famous landmarks in the world. query: Where is the Eiffel Tower located?') %}
{% set max_new_tokens = max_new_tokens | default(8) %}
{% set num_beams = num_beams | default(1) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("castorini/monot5-3b-msmarco-10k") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import T5Tokenizer, T5ForConditionalGeneration

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model_dir = os.path.dirname(model_file)

tokenizer = T5Tokenizer(vocab_file=tokenizer_file)
model = T5ForConditionalGeneration.from_pretrained(model_dir, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        do_sample=False,
    )

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
