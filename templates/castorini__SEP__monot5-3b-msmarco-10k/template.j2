{% set device = "cuda:0" %}
{% set repo_id = "castorini/monot5-3b-msmarco-10k" %}
{% set query = "What does MonoT5 use for passage reranking?" %}
{% set passage = "MonoT5 is a reranker built on T5 trained on MS MARCO for high-quality passage ranking." %}
{% set max_new_tokens = 16 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = """{{ query }}"""
passage = """{{ passage }}"""
max_new_tokens = {{ max_new_tokens }}

import pathlib
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

input_text = f"Query: {query}\nPassage: {passage}"
encoded_inputs = tokenizer(
    input_text,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
