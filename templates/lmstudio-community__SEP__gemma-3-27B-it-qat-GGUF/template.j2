{% set repo_id = repo_id | default("lmstudio-community/gemma-3-27B-it-qat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set quant_filename = quant_filename | default('gemma-3-27B-it-QAT-Q4_0.gguf') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
quant_filename = "{{ quant_filename }}"

from huggingface_hub import hf_hub_download
from PIL import Image
import requests

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename='mmproj-model-f16.gguf')

if str(image_path).startswith(('http://', 'https://')):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

RESULT = {"model_path": model_path, "mmproj_path": mmproj_path, "image_size": image.size, "device": device}
