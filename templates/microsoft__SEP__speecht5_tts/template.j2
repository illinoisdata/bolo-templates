{% set repo_id = repo_id | default("microsoft/speecht5_tts") %}
{% set text = text | default("Hello, my dog is cooler than you!") %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text = {{ text | tojson }}

from pathlib import Path

from transformers import pipeline
import soundfile as sf
import torch

device_lower = device.lower()
if device_lower == "cpu":
    pipeline_device = -1
elif device_lower.startswith("cuda"):
    pipeline_device = int(device_lower.split(":")[-1])
else:
    pipeline_device = -1

tts_pipeline = pipeline("text-to-speech", repo_id, device=pipeline_device)

speaker_device = torch.device("cpu" if pipeline_device < 0 else f"cuda:{pipeline_device}")
speaker_embeddings = torch.zeros(1, 512, device=speaker_device, dtype=torch.float32)

speech = tts_pipeline(text, forward_params={"speaker_embeddings": speaker_embeddings})
speech_audio = speech["audio"]
sampling_rate = speech["sampling_rate"]

RESULT = {"speech_audio": speech_audio, "sampling_rate": sampling_rate}
