{% set repo_id = repo_id | default("OpenGVLab/VideoMAEv2-Base") %}
{% set device = device | default("cuda:0") %}
{% set video_path = video_path | default('/u/yunqili4/projects/ML-code-generation/data/video.avi') %}
{% set num_frames = num_frames | default(16) %}
{% set repo_revision = repo_revision | default('main') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
video_path = "{{ video_path }}"
num_frames = {{ num_frames }}
repo_revision = "{{ repo_revision }}"

import os
import torch
import numpy as np
from PIL import Image
from decord import VideoReader, cpu
from huggingface_hub import hf_hub_download
from transformers import AutoConfig, AutoModel, VideoMAEImageProcessor
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json", revision=repo_revision)
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors", revision=repo_revision)
model_dir = os.path.dirname(model_path)

config = AutoConfig.from_pretrained(repo_id, trust_remote_code=True, revision=repo_revision)
processor = VideoMAEImageProcessor.from_pretrained(repo_id, revision=repo_revision)
model = AutoModel.from_config(config, trust_remote_code=True)
state_dict = load_file(model_path)
if "model" in state_dict and isinstance(state_dict["model"], dict):
    state_dict = state_dict["model"]
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

if video_path.startswith("http://") or video_path.startswith("https://"):
    import requests
    from io import BytesIO
    response = requests.get(video_path, timeout=30)
    response.raise_for_status()
    video_bytes = BytesIO(response.content)
    vr = VideoReader(video_bytes, ctx=cpu(0))
else:
    vr = VideoReader(video_path, ctx=cpu(0))

frame_indices = np.linspace(0, len(vr) - 1, num_frames, dtype=np.int64)
frames = vr.get_batch(frame_indices).asnumpy()
video = [Image.fromarray(frame) for frame in frames]
inputs = processor(video, return_tensors="pt")
inputs["pixel_values"] = inputs["pixel_values"].permute(0, 2, 1, 3, 4)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

hidden = outputs
RESULT = {
    "output": hidden.detach().cpu().numpy(),
}
