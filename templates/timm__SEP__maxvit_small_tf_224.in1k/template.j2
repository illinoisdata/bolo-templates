import torch

_original_register_fake = torch.library.register_fake

def _safe_register_fake(*args, **kwargs):
    try:
        return _original_register_fake(*args, **kwargs)
    except RuntimeError:
        def decorator(fn):
            return fn
        return decorator

torch.library.register_fake = _safe_register_fake

from transformers import pipeline

torch_device = torch.device(device)
pipeline_device = -1
if torch_device.type == "cuda":
    pipeline_device = torch_device.index if torch_device.index is not None else 0

pipe = pipeline(task=task, model=model, device=pipeline_device)
RESULT = pipe(input_data)
