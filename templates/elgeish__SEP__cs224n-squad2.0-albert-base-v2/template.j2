{% set repo_id = repo_id | default("elgeish/cs224n-squad2.0-albert-base-v2") %}
{% set device = device | default("cuda:0") %}
{% set context = context | default('Albert was trained by Google Research and released in 2019.') %}
{% set question = question | default('Who trained Albert?') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = "{{ context }}"
question = "{{ question }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = AutoTokenizer.from_pretrained(
    model_path.rsplit('/', 1)[0],
    use_fast=False,
)
model = AutoModelForQuestionAnswering.from_pretrained(
    model_path.rsplit('/', 1)[0],
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx
answer_ids = inputs["input_ids"][0, start_idx:end_idx + 1]
answer = tokenizer.decode(answer_ids, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
