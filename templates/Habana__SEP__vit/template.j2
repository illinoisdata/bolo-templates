{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set repo_id = repo_id | default("Habana/vit") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import ViTImageProcessor, ViTForImageClassification

config_path = hf_hub_download(repo_id=repo_id, filename="gaudi_config.json")
with open(config_path, "r") as f:
    gaudi_config = json.load(f)

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = ViTImageProcessor.from_pretrained("google/vit-base-patch16-224-in21k")
model = ViTForImageClassification.from_pretrained("google/vit-base-patch16-224-in21k")
model.to(device)
model.eval()

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    logits = model(**inputs).logits
    probs = torch.softmax(logits, dim=-1)
    k = min(5, probs.shape[-1])
    topk = torch.topk(probs, k=k, dim=-1)

id2label = model.config.id2label
RESULT = {
    "labels": [id2label[int(i)] for i in topk.indices[0].detach().cpu().tolist()],
    "scores": topk.values[0].detach().cpu().tolist(),
    "gaudi_config": gaudi_config,
}
