{% set repo_id = repo_id | default("IlyaGusev/saiga_mistral_7b_gguf") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('model-q4_K.gguf') %}
{% set prompt = prompt | default('Привет! Кратко расскажи, что ты умеешь.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith('cuda') else 0
llm = Llama(
    model_path=model_path,
    n_gpu_layers=n_gpu_layers,
    n_ctx=2048,
    verbose=False,
)

output = llm(prompt, max_tokens=128, temperature=0.7, top_p=0.95, stop=["</s>"])
RESULT = {"generated_text": output["choices"][0]["text"]}
