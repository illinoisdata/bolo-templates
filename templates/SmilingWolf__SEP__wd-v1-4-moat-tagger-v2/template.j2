{% set repo_id = repo_id | default("SmilingWolf/wd-v1-4-moat-tagger-v2") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set threshold = threshold | default(0.3771) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
threshold = {{ threshold }}

import numpy as np
from PIL import Image
import requests
import onnxruntime as ort
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.onnx")
vars_path = hf_hub_download(repo_id=repo_id, filename="variables/variables.index")

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image = image.resize((448, 448), Image.BICUBIC)
img = np.array(image).astype(np.float32) / 255.0
img = img[:, :, ::-1]
img = np.expand_dims(img, axis=0)

with open(vars_path, "r", encoding="latin-1") as f:
    labels = [line.strip() for line in f if line.strip()]

providers = ["CPUExecutionProvider"]
if device.startswith("cuda"):
    providers = ["CUDAExecutionProvider", "CPUExecutionProvider"]

session = ort.InferenceSession(model_path, providers=providers)
input_name = session.get_inputs()[0].name
output_name = session.get_outputs()[0].name
scores = session.run([output_name], {input_name: img})[0][0]

rating_names = ["general", "sensitive", "questionable", "explicit"]
ratings = {name: float(scores[i]) for i, name in enumerate(rating_names) if i < len(scores)}

tag_scores = scores[4:]
selected_tags = [labels[i] for i, s in enumerate(tag_scores) if float(s) >= threshold and i < len(labels)]

RESULT = {"ratings": ratings, "tags": selected_tags}
