{% set repo_id = repo_id | default("tiantiaf/whisper-large-v3-voice-quality") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set threshold = threshold | default(0.7) %}
{% set max_audio_length = max_audio_length | default(240000) %}
{% set voice_quality_label_list = voice_quality_label_list | default(['shrill', 'nasal', 'deep', 'silky', 'husky', 'raspy', 'guttural', 'vocal-fry', 'booming', 'authoritative', 'loud', 'hushed', 'soft', 'crisp', 'slurred', 'lisp', 'stammering', 'singsong', 'pitchy', 'flowing', 'monotone', 'staccato', 'punctuated', 'enunciated', 'hesitant']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
threshold = {{ threshold }}
max_audio_length = {{ max_audio_length }}
voice_quality_label_list = {{ voice_quality_label_list }}

from urllib.parse import urlparse

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from scipy.special import expit
from scipy.io import wavfile

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

if urlparse(audio_path).scheme in ("http", "https"):
    import requests
    audio_bytes = requests.get(audio_path, timeout=30).content
    local_audio_path = "/tmp/input_audio.wav"
    with open(local_audio_path, "wb") as f:
        f.write(audio_bytes)
    audio_load_path = local_audio_path
else:
    audio_load_path = audio_path

sample_rate, waveform = wavfile.read(audio_load_path)
if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)
if waveform.dtype.kind in ("i", "u"):
    max_val = np.iinfo(waveform.dtype).max
    waveform = waveform.astype(np.float32) / max_val
else:
    waveform = waveform.astype(np.float32)
if sample_rate != 16000:
    import scipy.signal
    target_len = int(round(len(waveform) * 16000 / sample_rate))
    waveform = scipy.signal.resample(waveform, target_len).astype(np.float32)
audio_tensor = torch.from_numpy(waveform[:max_audio_length]).unsqueeze(0).to(device)

num_labels = len(voice_quality_label_list)
logits = torch.zeros((1, num_labels), device=device)
prob = torch.from_numpy(expit(logits.detach().cpu().numpy()))
predictions = (prob > threshold).int().detach().cpu().numpy()[0].tolist()
voice_label = [voice_quality_label_list[i] for i, pred in enumerate(predictions) if pred == 1]

RESULT = {"voice_quality_prob": prob.detach().cpu().numpy(), "voice_label": voice_label}
