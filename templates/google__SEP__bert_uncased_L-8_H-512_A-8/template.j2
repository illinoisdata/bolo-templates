{% set device = "cuda:0" %}
{% set repo_id = "google/bert_uncased_L-8_H-512_A-8" %}
{% set input_text = "The quick brown fox jumps over the lazy dog." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import json
from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: tensor.to(device) for key, tensor in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.cpu()
pooler_output = outputs.pooler_output
if pooler_output is not None:
    pooler_output = pooler_output.cpu()

RESULT = {"last_hidden_state": last_hidden_state.tolist()}
if pooler_output is not None:
    RESULT["pooler_output"] = pooler_output.tolist()
