{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-tr") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default(["I know Tom didn't want to eat that.", "On Sundays, we would get up early and go fishing."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download
import torch

model_weights = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
source_spm_file = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_file = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer = MarianTokenizer.from_pretrained(repo_id, local_files_only=True)
model = MarianMTModel.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs)
translations = [tokenizer.decode(t, skip_special_tokens=True) for t in generated_ids]

RESULT = {"translations": translations}
