{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-en-tr" %}
{% set src_text = ["I know Tom didn't want to eat that.", "On Sundays, we would get up early and go fishing."] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = inputs.to(device)

with torch.no_grad():
    generated_tokens = model.generate(**inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
