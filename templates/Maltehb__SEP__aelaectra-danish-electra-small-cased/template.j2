{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Maltehb/aelaectra-danish-electra-small-cased") %}
{% set text = text | default("Dette er en prøve sætning.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModelForPreTraining

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
outputs = model(**inputs)
logits = outputs["logits"] if isinstance(outputs, dict) else outputs.logits
logits = logits.detach().cpu().numpy()

# Post-process & build RESULT dict
RESULT = {"logits": logits}
