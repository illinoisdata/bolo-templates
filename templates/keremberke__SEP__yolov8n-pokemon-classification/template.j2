{% set repo_id = repo_id | default("keremberke/yolov8n-pokemon-classification") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
topk = {{ topk }}

import os
from urllib.parse import urlparse
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from ultralytics import YOLO
import ultralytics.nn.modules as um
from ultralytics.nn.tasks import ClassificationModel
from torch.nn import Sequential, Conv2d, BatchNorm2d, SiLU, AdaptiveAvgPool2d, Linear


weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if urlparse(image).scheme in ("http", "https"):
    import requests
    from io import BytesIO
    image_obj = Image.open(BytesIO(requests.get(image, timeout=30).content)).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

torch.serialization.add_safe_globals([ClassificationModel, Sequential, Conv2d, BatchNorm2d, SiLU, AdaptiveAvgPool2d, Linear, um.Conv, um.Bottleneck, um.C2f, um.SPPF])
import os
os.environ["TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD"] = "1"
model = YOLO(weights_path)
results = model.predict(source=image_obj, device=device, conf=conf, verbose=False)
probs = results[0].probs
names = results[0].names
top_indices = list(probs.top5)[:topk]
top_items = [(names[i], float(probs.data[i])) for i in top_indices]
processed = {names[i]: float(probs.data[i]) for i in range(len(probs.data))}
RESULT = {
    "top1": names[int(probs.top1)],
    "topk": top_items,
    "probs": processed,
}
