{% set repo_id = repo_id | default("jilijeanlouis/gliner_mediumv2.1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("John Doe works at OpenAI in San Francisco.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import json
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoModel, AutoTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
gliner_config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")

with open(gliner_config_path, "r") as f:
    gliner_cfg = json.load(f)

model_name = gliner_cfg["model_name"]
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModel.from_pretrained(model_name)
state_dict = torch.load(weights_path, map_location="cpu")
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden = outputs.last_hidden_state
RESULT = {"last_hidden_state_shape": list(last_hidden.shape), "config_name": model_name}
