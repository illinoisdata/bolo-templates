{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("jilijeanlouis/gliner_mediumv2.1") %}
{% set text = text | default("This example uses GLiNER token classification inference.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import json

import torch
from transformers import AutoConfig, AutoModelForTokenClassification, AutoTokenizer

tokenizer_repo = "microsoft/deberta-v3-base"
tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo)
config = AutoConfig.from_pretrained(tokenizer_repo)
model = AutoModelForTokenClassification.from_pretrained(repo_id, config=config)
model.to(device)
model.eval()

tokenized = tokenizer(
    text,
    truncation=True,
    max_length=384,
    return_tensors="pt",
    padding=False,
)
inputs = {key: value.to(device) for key, value in tokenized.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
prediction_ids = logits.argmax(dim=-1)[0].cpu().tolist()
probabilities = torch.softmax(logits, dim=-1)[0].cpu()

input_ids = tokenized["input_ids"][0].tolist()
attention_mask = tokenized["attention_mask"][0].tolist()
tokens = tokenizer.convert_ids_to_tokens(input_ids)

id2label = dict(getattr(model.config, "id2label", {}))

token_classification = []
for idx, (token, label_id, mask_value) in enumerate(zip(tokens, prediction_ids, attention_mask)):
    if mask_value == 0:
        continue
    label = id2label.get(label_id, str(label_id))
    score = probabilities[idx, label_id].item()
    token_classification.append(
        {
            "token": token,
            "label": label,
            "score": score,
        }
    )

RESULT = {"token_classification": token_classification}
