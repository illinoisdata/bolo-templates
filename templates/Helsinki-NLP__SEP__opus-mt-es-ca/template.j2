{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-es-ca") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Hola, ¿cómo estás hoy?") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    source_text,
    return_tensors="pt",
    max_length=max_length,
    truncation=True,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
