{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ThomasSimonini/t5-end2end-question-generation") %}
{% set input_context = input_context | default("Context: The Apollo missions landed astronauts on the Moon and illustrated humanity's reach into space.") %}
{% set prefix = prefix | default("generate questions: ") %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(4) %}
{% set length_penalty = length_penalty | default(1.5) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_context = """{{ input_context }}"""
prefix = "{{ prefix }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ "True" if early_stopping else "False" }}

import json
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

input_text = f"{prefix}{input_context.strip()} </s>"
encoded_inputs = tokenizer(input_text, return_tensors="pt")
input_ids = encoded_inputs.input_ids.to(device)
attention_mask = encoded_inputs.attention_mask.to(device)

generate_kwargs = {
    "max_length": max_length,
    "num_beams": num_beams,
    "length_penalty": length_penalty,
    "no_repeat_ngram_size": no_repeat_ngram_size,
    "early_stopping": early_stopping,
}

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    **generate_kwargs,
)
decoded_sequences = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
questions = []
if decoded_sequences:
    first_sequence = decoded_sequences[0]
    questions = [segment.strip() for segment in first_sequence.split("<sep>") if segment.strip()]

RESULT = {"questions": questions}
