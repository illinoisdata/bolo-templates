{% set repo_id = repo_id | default("ThomasSimonini/t5-end2end-question-generation") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Context: "Python is an interpreted, high-level, general-purpose programming language. Created by Guido van Rossum and first released in 1991, Python\'s design philosophy emphasizes code readability with its notable use of significant whitespace."') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import T5ForConditionalGeneration, T5TokenizerFast
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model = T5ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
)
tokenizer = T5TokenizerFast.from_pretrained(repo_id)
model.to(device)
model.eval()

prompt = "generate questions: " + input_text + " </s>"
input_ids = tokenizer.encode(prompt, return_tensors="pt").to(device)
with torch.no_grad():
    generated_ids = model.generate(
        input_ids,
        max_length=256,
        num_beams=4,
        length_penalty=1.5,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )
outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
questions = [item.split("<sep>") for item in outputs]

RESULT = {"output": questions}
