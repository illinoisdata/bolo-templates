{% set repo_id = repo_id | default("TaylorAI/FLAN-Llama-7B-2_Llama2-7B-Flash_868_full_model") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, max_new_tokens=max_new_tokens)
prepared_input = input_prompt

RESULT = pipe(prepared_input)[0]
