{% set repo_id = repo_id | default("MingZhong/unieval-fact") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('The generated text is factually consistent with the source.') %}
{% set source_text = source_text | default('The Eiffel Tower is located in Paris, France.') %}
{% set generated_text = generated_text | default('The Eiffel Tower is in Paris.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
source_text = "{{ source_text }}"
generated_text = "{{ generated_text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = os.path.dirname(weights_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

input_text = f"question: {question} source: {source_text} hypothesis: {generated_text}"
inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=8)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
score = None
for token in output_text.replace(',', ' ').split():
    try:
        score = float(token)
        break
    except ValueError:
        continue

RESULT = {"output_text": output_text, "score": score}
