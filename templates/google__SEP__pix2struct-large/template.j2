{% set repo_id = repo_id | default("google/pix2struct-large") %}
{% set device = device | default("cuda:0") %}
{% set text_prompt = text_prompt | default('Describe the image in detail.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"

import torch
from PIL import Image
from transformers import Pix2StructForConditionalGeneration, Pix2StructProcessor
from huggingface_hub import hf_hub_download
from urllib.parse import urlparse

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

image_path = "/u/yunqili4/projects/ML-code-generation/data/image1.jpeg"
if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(torch.hub.load_state_dict_from_url(image_path, progress=False, map_location="cpu")).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = Pix2StructProcessor.from_pretrained(repo_id)
model = Pix2StructForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = processor(images=image, text=text_prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=32)
output_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"output_text": output_text}
