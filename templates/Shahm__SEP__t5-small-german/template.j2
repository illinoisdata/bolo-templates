{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Shahm/t5-small-german") %}
{% set input_text = input_text | default("Dies ist ein deutscher Beispielsatz mit mehreren Informationen, die ein kompaktes, aussagekräftiges Summary verdienen.") %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set prefix = prefix | default("summarize: ") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
prefix = "{{ prefix }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load model and tokenizer
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input
prefixed_input = f"{prefix}{input_text.strip()}"
inputs = tokenizer(prefixed_input, return_tensors="pt", truncation=True, padding="longest").to(device)

# Run inference
generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    early_stopping=True,
)

# Post-process outputs
summary = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0].strip()
RESULT = {"summary": summary}
