{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("snrspeaks/KeyPhraseTransformer") %}
{% set input_text = input_text | default("extract keyphrases from this text: Machine learning transforms vast data into actionable insights.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set repetition_penalty = repetition_penalty | default(1.0) %}
{% set length_penalty = length_penalty | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True, truncation=True).to(device)
generated_ids = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
    repetition_penalty=repetition_penalty,
    length_penalty=length_penalty,
)
generated_keyphrases = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_keyphrases": generated_keyphrases}
