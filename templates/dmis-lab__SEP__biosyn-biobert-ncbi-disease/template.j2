{% set repo_id = repo_id | default("dmis-lab/biosyn-biobert-ncbi-disease") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Aspirin is associated with gastric ulcer.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import BertConfig, BertForSequenceClassification, BertTokenizerFast

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(model_file)
config = BertConfig.from_pretrained(model_dir)
tokenizer = BertTokenizerFast.from_pretrained(model_dir)
model = BertForSequenceClassification.from_pretrained(model_dir, config=config)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probabilities = torch.softmax(logits, dim=-1)
    predicted_class_id = int(torch.argmax(probabilities, dim=-1).item())
    predicted_score = float(probabilities[0, predicted_class_id].item())

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "probabilities": probabilities.detach().cpu().tolist(),
    "predicted_class_id": predicted_class_id,
    "predicted_score": predicted_score,
}
