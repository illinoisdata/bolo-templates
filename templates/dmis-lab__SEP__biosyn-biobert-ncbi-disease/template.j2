{% set repo_id = repo_id | default("dmis-lab/biosyn-biobert-ncbi-disease") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("The patient showed symptoms of an emerging respiratory disease.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
import json
from pathlib import Path

import torch
from transformers import AutoModelForTokenClassification, AutoTokenizer, BertConfig

tokenizer = AutoTokenizer.from_pretrained(repo_id)
config = BertConfig.from_pretrained(repo_id)
model = AutoModelForTokenClassification.from_pretrained(repo_id, config=config)
runtime_device = torch.device(device)
model.to(runtime_device)
model.eval()

tokenized = tokenizer(
    text_input,
    return_tensors="pt",
    return_offsets_mapping=True,
    truncation=True,
)
offset_mapping = tokenized["offset_mapping"][0].tolist()
input_ids = tokenized["input_ids"][0].tolist()
inputs = {
    name: tensor.to(runtime_device)
    for name, tensor in tokenized.items()
    if name != "offset_mapping"
}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits[0]
probabilities = torch.softmax(logits, dim=-1).cpu()
predictions = torch.argmax(probabilities, dim=-1)
tokens = tokenizer.convert_ids_to_tokens(input_ids)
label_map = getattr(model.config, "id2label", None) or {
    idx: str(idx) for idx in range(model.config.num_labels)
}
entities = []
for idx, (token, offset) in enumerate(zip(tokens, offset_mapping)):
    if offset[0] == offset[1]:
        continue
    label_id = int(predictions[idx].item())
    label = label_map.get(label_id, str(label_id))
    score = probabilities[idx, label_id].item()
    entities.append(
        {
            "token": token,
            "label": label,
            "score": score,
            "start": offset[0],
            "end": offset[1],
        }
    )

RESULT = {"entities": entities}
