{% set repo_id = repo_id | default("keremberke/yolov8m-hard-hat-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import json
from urllib.parse import urlparse

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

model_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
with open(config_path, "r") as f:
    config = json.load(f)

if urlparse(image).scheme in ("http", "https"):
    image_source = image
else:
    image_source = Image.open(image).convert("RGB")

model = YOLO(model_path)
model.overrides["conf"] = conf
model.overrides["iou"] = iou
model.overrides["agnostic_nms"] = agnostic_nms
model.overrides["max_det"] = max_det

results = model.predict(image_source, device=device, verbose=False)
boxes = results[0].boxes
render = results[0].plot()

RESULT = {
    "boxes": boxes.data.cpu().tolist() if boxes is not None else [],
    "render": Image.fromarray(render[..., ::-1]) if hasattr(render, "shape") else render,
    "labels": config.get("names", ["Hardhat", "NO-Hardhat"]),
}
