{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-he-en" %}
{% set device = "cuda:0" %}
{% set src_text = ["היא שכחה לכתוב לו.", "אני רוצה לדעת מיד כשמשהו יקרה."] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

from transformers import MarianTokenizer, MarianMTModel

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

translated = model.generate(**inputs)

translations = [tokenizer.decode(t, skip_special_tokens=True) for t in translated]

RESULT = {"translations": translations}

if __name__ == "__main__":
    with open("translations.txt", "w", encoding="utf-8") as f:
        for translation in RESULT["translations"]:
            f.write(translation + "\n")