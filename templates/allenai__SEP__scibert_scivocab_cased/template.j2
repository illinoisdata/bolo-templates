{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("Trained on scientific literature, SciBERT excels at domain-specific tasks.") %}
{% set output_path = output_path | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/allenai__SEP__scibert_scivocab_cased") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
output_path = "{{ output_path }}"

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(
    text_input,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
inputs = {name: tensor.to(device) for name, tensor in encoded.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.cpu().numpy()
pooler_output = (
    outputs.pooler_output.cpu().numpy() if outputs.pooler_output is not None else None
)

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
