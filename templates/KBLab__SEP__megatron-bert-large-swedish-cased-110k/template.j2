{% set repo_id = repo_id | default("KBLab/megatron-bert-large-swedish-cased-110k") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Detta är en svensk mening för maskerade språkmodeller.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Load tokenizer and model from the repository files directly.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForMaskedLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

mask_token_id = tokenizer.mask_token_id
if mask_token_id is None:
    raise ValueError("Tokenizer does not define a mask token.")

# Create a masked version of the input by replacing the first token after CLS/first wordpiece with [MASK].
input_ids = inputs["input_ids"].clone()
attention_mask = inputs["attention_mask"]
mask_positions = (input_ids == mask_token_id).nonzero(as_tuple=False)
if mask_positions.numel() == 0:
    if input_ids.shape[1] > 2:
        input_ids[0, 1] = mask_token_id
    else:
        input_ids[0, 0] = mask_token_id

with torch.no_grad():
    outputs = model(input_ids=input_ids, attention_mask=attention_mask)
    logits = outputs.logits

masked_index = (input_ids[0] == mask_token_id).nonzero(as_tuple=False)[0].item()
probs = torch.softmax(logits[0, masked_index], dim=-1)
topk = torch.topk(probs, k=5)
top_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())

RESULT = {
    "masked_text": tokenizer.decode(input_ids[0], skip_special_tokens=False),
    "top_tokens": top_tokens,
    "top_probs": topk.values.detach().cpu().tolist(),
}
