{% set repo_id = "namdp-ptit/ViDense" %}
{% set device = "cuda:0" %}
{% set sentences = ["Tỉnh nào có diện tích lớn nhất Việt Nam", "Tỉnh nào có diện tích nhỏ nhất Việt Nam", "Tỉnh nào có diện tích rộng nhất Việt Nam"] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/namdp-ptit__SEP__ViDense" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModel

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

# Preprocess input
inputs = tokenizer(sentences, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Inference
with torch.no_grad():
    outputs = model(**inputs)
    last_hidden = outputs.last_hidden_state
    attention_mask = inputs["attention_mask"]
    pooled = (last_hidden * attention_mask.unsqueeze(-1)).sum(1) / attention_mask.sum(-1).unsqueeze(-1)

# Post-process & build RESULT dict
cosine_sim_1 = torch.nn.functional.cosine_similarity(pooled[0].unsqueeze(0), pooled[1].unsqueeze(0))
cosine_sim_2 = torch.nn.functional.cosine_similarity(pooled[0].unsqueeze(0), pooled[2].unsqueeze(0))

RESULT = {
    "cosine_sim_1": cosine_sim_1.item(),
    "cosine_sim_2": cosine_sim_2.item()
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "cosine_sim_1.txt"), "w") as f:
        f.write(str(RESULT["cosine_sim_1"]))
    with open(os.path.join(output_dir, "cosine_sim_2.txt"), "w") as f:
        f.write(str(RESULT["cosine_sim_2"]))