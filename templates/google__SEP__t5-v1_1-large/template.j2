{% set device = "cuda:0" %}
{% set repo_id = "google/t5-v1_1-large" %}
{% set input_text = "translate English to German: The quick brown fox jumps over the lazy dog." %}
{% set max_new_tokens = 64 %}
{% set output_filename = "generated_text.txt" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_new_tokens = {{ max_new_tokens }}
output_filename = "{{ output_filename }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
