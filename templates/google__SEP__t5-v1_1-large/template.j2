{% set input_text = "translate English to German: The quick brown fox jumps over the lazy dog." %}
{% set max_new_tokens = 64 %}
{% set output_filename = "generated_text.txt" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__t5-v1_1-large" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_new_tokens = {{ max_new_tokens }}
output_filename = "{{ output_filename }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / output_filename).write_text(RESULT["generated_text"], encoding="utf-8")