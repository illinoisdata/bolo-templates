{% set repo_id = repo_id | default("UBC-NLP/AraT5-base") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('اكتب عنوانًا إخباريًا قصيرًا يلخص النص التالي: أعلنت الشركة عن إطلاق منتج جديد يستهدف المستخدمين في المنطقة العربية.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = weights_path.rsplit('/', 1)[0]

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        length_penalty=1.0,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
