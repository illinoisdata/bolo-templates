{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("state-spaces/mamba2-2.7b") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import json
import os
from huggingface_hub import snapshot_download

repo_dir = snapshot_download(repo_id)
file_entries = []
for root, _, filenames in os.walk(repo_dir):
    for filename in filenames:
        file_entries.append(os.path.relpath(os.path.join(root, filename), repo_dir))

tokenizer_config = {}
tokenizer_config_path = os.path.join(repo_dir, "tokenizer_config.json")
if os.path.exists(tokenizer_config_path):
    with open(tokenizer_config_path, "r", encoding="utf-8") as reader:
        tokenizer_config = json.load(reader)

RESULT = {
    "repo_dir": repo_dir,
    "tokenizer_config": tokenizer_config,
    "file_entries": file_entries,
}
