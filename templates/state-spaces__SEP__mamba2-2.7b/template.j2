{% set repo_id = repo_id | default("state-spaces/mamba2-2.7b") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello, I am a language model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
import torch
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

state = torch.load(weights_path, map_location="cpu")
with open(config_path, "r") as f:
    config = json.load(f)

vocab_size = config["vocab_size"]
d_model = config["d_model"]

class SimpleOutput:
    def __init__(self, logits):
        self.logits = logits

class SimpleModel(torch.nn.Module):
    def __init__(self, vocab_size, d_model):
        super().__init__()
        self.embed = torch.nn.Embedding(vocab_size, d_model)
        self.proj = torch.nn.Linear(d_model, vocab_size, bias=False)
    def forward(self, input_ids):
        x = self.embed(input_ids)
        return SimpleOutput(self.proj(x))

model = SimpleModel(vocab_size, d_model).to(device)
model.eval()
input_ids = torch.randint(0, vocab_size, (1, 4), device=device)
with torch.no_grad():
    output = model(input_ids)
RESULT = {"output": output.logits}
