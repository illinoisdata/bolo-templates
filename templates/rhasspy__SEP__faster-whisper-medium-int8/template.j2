{% set device = "cuda:0" %}
{% set repo_id = "rhasspy/faster-whisper-medium-int8" %}
{% set audio_path = "/u/yli77/projects/ML-code-generation/data/audio.wav" %}
{% set language = "en" %}
{% set beam_size = 5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
beam_size = {{ beam_size }}

import io
import json
from pathlib import Path

import requests
import torch
from faster_whisper import WhisperModel

# Adjust device for faster-whisper compatibility
device_str = device
if device_str.startswith("cuda"):
    device_str = "cuda"

# Load model
model = WhisperModel(repo_id, device=device_str, compute_type="int8")

# Load audio source (file path or URL)
def _load_audio(path: str):
    if path.startswith(("http://", "https://")):
        response = requests.get(path)
        response.raise_for_status()
        return io.BytesIO(response.content)
    return path

audio_source = _load_audio(audio_path)

# Run inference
def _transcribe(source):
    segments, info = model.transcribe(source, beam_size=beam_size, language=language)
    return segments

segments = _transcribe(audio_source)

# Post-process results
text = "".join([segment.text for segment in segments])
segments_data = [{"start": segment.start, "end": segment.end, "text": segment.text} for segment in segments]
RESULT = {"text": text, "segments": segments_data}
