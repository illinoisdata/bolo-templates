{% set repo_id = repo_id | default("dlb/electra-base-portuguese-uncased-brwac") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('O Brasil é um país diverso e vibrante.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import ElectraConfig, ElectraTokenizer, ElectraModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = ElectraConfig.from_json_file(config_path)
tokenizer = ElectraTokenizer(vocab_file=vocab_path, do_lower_case=True)
model = ElectraModel(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict = {k.replace('electra.', ''): v for k, v in state_dict.items() if not k.startswith('discriminator_predictions.')}
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state,
    "pooler_output": getattr(outputs, "pooler_output", None),
}
