{% set repo_id = repo_id | default("ElnaggarLab/ankh-large") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('ACDEFGHIKLMNPQRSTVWY') %}
{% set max_new_tokens = max_new_tokens | default(16) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

model = AutoModelForSeq2SeqLM.from_pretrained(
    os.path.dirname(weights_path),
    config=config_path,
    local_files_only=True,
)
model.load_state_dict(torch.load(weights_path, map_location="cpu"))
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path), local_files_only=True)
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
