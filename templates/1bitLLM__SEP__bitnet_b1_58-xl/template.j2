{% set repo_id = repo_id | default("1bitLLM/bitnet_b1_58-xl") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you today?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set do_sample = do_sample | default(False) %}
{% set model = model | default(repo_id) %}
{% set device_value = device_value | default(device) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device_value | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
do_sample = {{ "True" if do_sample else "False" }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt, do_sample=do_sample, max_new_tokens=max_new_tokens)
RESULT = {"outputs": RESULT}
