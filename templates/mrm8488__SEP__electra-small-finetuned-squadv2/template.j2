{% set repo_id = repo_id | default("mrm8488/electra-small-finetuned-squadv2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What has been discovered by scientists from China ?') %}
{% set context = context | default('A new strain of flu that has the potential to become a pandemic has been identified in China by scientists.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Load tokenizer/model directly from the downloaded repository files.
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=False,
    local_files_only=True,
)
model = AutoModelForQuestionAnswering.from_pretrained(
    repo_id,
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True).strip()

RESULT = {
    "answer": answer,
    "start_index": start_idx,
    "end_index": end_idx,
}
