{% set repo_id = repo_id | default("Falconsai/text_summarization") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Hugging Face: Revolutionizing Natural Language Processing Introduction In the rapidly evolving field of Natural Language Processing (NLP), Hugging Face has emerged as a prominent and innovative force. This article will explore the story and significance of Hugging Face, a company that has made remarkable contributions to NLP and AI as a whole. From its inception to its role in democratizing AI, Hugging Face has left an indelible mark on the industry.") %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Falconsai__SEP__text_summarization") %}
{% set prefix = prefix | default("summarize: ") %}
{% set early_stopping = early_stopping | default(true) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set num_beams = num_beams | default(4) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text|tojson }}
output_dir = "{{ output_dir }}"
prefix = {{ prefix|tojson }}
early_stopping = {{ early_stopping }}
length_penalty = {{ length_penalty }}
max_length = {{ max_length }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input text with task prefix
input_str = prefix + input_text
inputs = tokenizer(input_str, return_tensors="pt").to(device)

# Run inference
summary_ids = model.generate(
    **inputs,
    early_stopping=early_stopping,
    length_penalty=length_penalty,
    max_length=max_length,
    min_length=min_length,
    no_repeat_ngram_size=no_repeat_ngram_size,
    num_beams=num_beams,
)

# Post-process and build RESULT dict
summary_list = tokenizer.batch_decode(summary_ids, skip_special_tokens=True)
summary = summary_list[0]
RESULT = {"summary_text": summary}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    # Save summary text to file
    with open(os.path.join(output_dir, "summary_text.txt"), "w") as f:
        f.write(summary)