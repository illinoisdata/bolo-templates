{% set repo_id = repo_id | default("Exscientia/IgT5_unpaired") %}
{% set sequences = sequences | default(["EVVMTQSPASLSVSPGERATLSCRARASLGISTDLAWYQQRPGQAPRLLIYGASTRATGIPARFSGSGSGTEFTLTISSLQSEDSAVYYCQQYSNWPLTFGGGTKVEIK", "ALTQPASVSGSPGQSITISCTGTSSDVGGYNYVSWYQQHPGKAPKLMIYDVSKRPSGVSNRFSGSKSGNTASLTISGLQSEDEADYYCNSLTSISTWVFGGGTKLTVL"]) %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sequences = {{ sequences }}

import torch
from transformers import T5Tokenizer, T5EncoderModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")


def _resolve_device(device_str):
    if device_str.startswith("cuda") and not torch.cuda.is_available():
        return "cpu"
    return device_str


def _load_sequences(seqs):
    return [" ".join(list(s)) for s in seqs]


device = _resolve_device(device)

tokenizer = T5Tokenizer(vocab_file=spiece_path, do_lower_case=False)
model = T5EncoderModel.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded = tokenizer(
    _load_sequences(sequences),
    add_special_tokens=True,
    padding=True,
    return_tensors="pt",
    return_special_tokens_mask=True,
)
encoded = {k: v.to(device) for k, v in encoded.items()}

with torch.no_grad():
    output = model(input_ids=encoded["input_ids"], attention_mask=encoded["attention_mask"])

residue_embeddings = output.last_hidden_state
mask = encoded["special_tokens_mask"].unsqueeze(-1)
residue_embeddings = residue_embeddings.masked_fill(mask.bool(), 0.0)
sequence_embeddings_sum = residue_embeddings.sum(1)
sequence_lengths = torch.sum(encoded["special_tokens_mask"] == 0, dim=1)
sequence_embeddings = sequence_embeddings_sum / sequence_lengths.unsqueeze(1)

RESULT = {"sequence_embeddings": sequence_embeddings.detach().cpu().numpy()}
