{% set repo_id = repo_id | default("bionlp/bluebert_pubmed_mimic_uncased_L-24_H-1024_A-16") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The patient was admitted for chest pain and shortness of breath.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import re
import torch
from transformers import BertTokenizer, BertForMaskedLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

def preprocess(value):
    value = value.lower()
    value = re.sub(r'[\r\n]+', ' ', value)
    value = re.sub(r'[^\x00-\x7F]+', ' ', value)
    value = re.sub(r"\s+'s\b", "'s", value)
    return value

normalized_text = preprocess(text)

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=True)
inputs = tokenizer(normalized_text, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

model = BertForMaskedLM.from_pretrained(repo_id)
state_dict = torch.load(model_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits

RESULT = {"logits": logits}
