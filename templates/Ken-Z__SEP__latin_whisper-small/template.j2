{% set repo_id = repo_id | default("Ken-Z/latin_whisper-small") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import torch
import soundfile as sf
import librosa
from transformers import AutoProcessor, WhisperForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = AutoProcessor.from_pretrained(repo_id)
model = WhisperForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float16 if torch.cuda.is_available() and str(device).startswith("cuda") else torch.float32,
)
model.to(device)
model.eval()

if audio_path.startswith(("http://", "https://")):
    import requests
    import io
    audio_array, sampling_rate = sf.read(io.BytesIO(requests.get(audio_path, timeout=30).content))
else:
    audio_array, sampling_rate = sf.read(audio_path)

if audio_array.ndim > 1:
    audio_array = audio_array.mean(axis=1)
if sampling_rate != 16000:
    audio_array = librosa.resample(audio_array.astype("float32"), orig_sr=sampling_rate, target_sr=16000)
    sampling_rate = 16000

inputs = processor(audio_array, sampling_rate=sampling_rate, return_tensors="pt")
input_features = inputs.input_features.to(device, dtype=model.dtype)
forced_decoder_ids = processor.get_decoder_prompt_ids(language="la", task="transcribe")
with torch.no_grad():
    generated_ids = model.generate(input_features, forced_decoder_ids=forced_decoder_ids)
transcription = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": transcription}
