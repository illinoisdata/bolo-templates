{% set repo_id = repo_id | default("Delphia/twitter-spam-classifier") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-classification") %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}
{% set label_map = label_map | default({0: "valid", 1: "spam"}) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
label_map = {{ label_map | tojson }}

import json
import os
from huggingface_hub import snapshot_download
from transformers import pipeline

# Download the model snapshot and sanitize config
local_dir = snapshot_download(repo_id)
config_path = os.path.join(local_dir, "config.json")
with open(config_path, "r", encoding="utf-8") as f:
    config_dict = json.load(f)
config_dict["id2label"] = label_map
config_dict["label2id"] = {label: index for index, label in label_map.items()}
with open(config_path, "w", encoding="utf-8") as f:
    json.dump(config_dict, f)

pipe = pipeline(task=task, model=local_dir, device=device)
RESULT = pipe(input_prompt)
