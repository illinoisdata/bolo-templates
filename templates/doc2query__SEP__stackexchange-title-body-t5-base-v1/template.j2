{% set repo_id = "doc2query/stackexchange-title-body-t5-base-v1" %}
{% set device = "cuda:0" %}
{% set text = "Python is an interpreted, high-level and general-purpose programming language. Python's design philosophy emphasizes code readability with its notable use of significant whitespace. Its language constructs and object-oriented approach aim to help programmers write clear, logical code for small and large-scale projects." %}
{% set max_input_length = 320 %}
{% set max_length = 64 %}
{% set do_sample = true %}
{% set top_p = 0.95 %}
{% set num_return_sequences = 5 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/doc2query__SEP__stackexchange-title-body-t5-base-v1" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_input_length = {{ max_input_length }}
max_length = {{ max_length }}
do_sample = {{ do_sample }}
top_p = {{ top_p }}
num_return_sequences = {{ num_return_sequences }}
output_dir = "{{ output_dir }}"

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, max_length=max_input_length, truncation=True, return_tensors="pt").to(device)

outputs = model.generate(
    input_ids=inputs.input_ids,
    attention_mask=inputs.attention_mask,
    max_length=max_length,
    do_sample=do_sample,
    top_p=top_p,
    num_return_sequences=num_return_sequences
)

generated_queries = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"generated_queries": generated_queries}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "generated_queries.json"), "w") as f:
        json.dump(RESULT["generated_queries"], f)