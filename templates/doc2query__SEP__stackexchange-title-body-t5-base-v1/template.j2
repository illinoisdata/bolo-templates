{% set repo_id = repo_id | default("doc2query/stackexchange-title-body-t5-base-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Python is an interpreted, high-level and general-purpose programming language. Python's design philosophy emphasizes code readability with its notable use of significant whitespace. Its language constructs and object-oriented approach aim to help programmers write clear, logical code for small and large-scale projects.") %}
{% set max_input_length = max_input_length | default(320) %}
{% set max_length = max_length | default(64) %}
{% set do_sample = do_sample | default(true) %}
{% set top_p = top_p | default(0.95) %}
{% set num_return_sequences = num_return_sequences | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_input_length = {{ max_input_length }}
max_length = {{ max_length }}
do_sample = {{ do_sample }}
top_p = {{ top_p }}
num_return_sequences = {{ num_return_sequences }}

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, max_length=max_input_length, truncation=True, return_tensors="pt").to(device)

outputs = model.generate(
    input_ids=inputs.input_ids,
    attention_mask=inputs.attention_mask,
    max_length=max_length,
    do_sample=do_sample,
    top_p=top_p,
    num_return_sequences=num_return_sequences
)

generated_queries = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"generated_queries": generated_queries}
