{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-de-ar" %}
{% set text_input = ">>ara<< Guten Morgen." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, MarianTokenizer
import torch

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in tokenized.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=tokenizer.model_max_length)

translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
translation = translations[0].strip()

RESULT = {"translation": translation}
