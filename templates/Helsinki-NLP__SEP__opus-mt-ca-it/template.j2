{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-ca-it" %}
{% set input_text = "Bon dia! Com estàs avui?" %}
{% set num_beams = 4 %}
{% set max_length = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoding = tokenizer(input_text, return_tensors="pt")
encoding = {k: v.to(device) for k, v in encoding.items()}
generated_tokens = model.generate(**encoding, num_beams=num_beams, max_length=max_length)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
