{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ca-it") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hola, com estàs?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

run_device = device if torch.cuda.is_available() and str(device).startswith('cuda') else 'cpu'

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(run_device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(run_device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=128)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
