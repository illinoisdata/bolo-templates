{% set repo_id = repo_id | default("FacebookAI/xlm-clm-enfr-1024") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set prompt = prompt | default("Wikipedia was used to") %}
{% set max_new_tokens = max_new_tokens | default(20) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
prompt = {{ prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

input_text = prompt
raw_outputs = pipe(input_text, max_new_tokens=max_new_tokens)

generated_texts = [item["generated_text"] for item in raw_outputs]
RESULT = {"generated_texts": generated_texts}
