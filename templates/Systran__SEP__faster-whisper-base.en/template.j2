{% set repo_id = repo_id | default("Systran/faster-whisper-base.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(5) %}
{% set best_of = best_of | default(5) %}
{% set temperature = temperature | default(0.0) %}
{% set condition_on_previous_text = condition_on_previous_text | default(False) %}
{% set vad_filter = vad_filter | default(False) %}
{% set compute_type = compute_type | default('default') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
best_of = {{ best_of }}
temperature = {{ temperature }}
condition_on_previous_text = {{ condition_on_previous_text }}
vad_filter = {{ vad_filter }}
compute_type = "{{ compute_type }}"

import os
import urllib.parse
import urllib.request
import numpy as np
import librosa
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")
model_dir = os.path.dirname(model_path)

if audio_path.startswith(("http://", "https://")):
    parsed = urllib.parse.urlparse(audio_path)
    local_audio_path = os.path.join("/tmp", os.path.basename(parsed.path) or "audio.wav")
    urllib.request.urlretrieve(audio_path, local_audio_path)
else:
    local_audio_path = audio_path

use_device = "cpu" if str(device).startswith("cuda") else device
if use_device == "cpu":
    use_compute_type = "int8"
else:
    use_compute_type = compute_type

model = WhisperModel(model_dir, device=use_device, compute_type=use_compute_type, local_files_only=True)
audio, sr = librosa.load(local_audio_path, sr=16000, mono=True)
segments, info = model.transcribe(
    audio,
    task=task,
    language=language,
    beam_size=beam_size,
    best_of=best_of,
    temperature=temperature,
    condition_on_previous_text=condition_on_previous_text,
    vad_filter=vad_filter,
)
text = "".join(segment.text for segment in segments).strip()
RESULT = {
    "text": text,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
