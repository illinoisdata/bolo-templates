{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set sampling_rate = sampling_rate | default(16000) %}
{% set repo_id = repo_id | default("patrickvonplaten/tiny-wav2vec2-no-tokenizer") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sampling_rate = {{ sampling_rate }}

import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import Wav2Vec2ForCTC
from scipy.io import wavfile

config_file = hf_hub_download(repo_id="{{ repo_id }}", filename="config.json")
weights_file = hf_hub_download(repo_id="{{ repo_id }}", filename="pytorch_model.bin")
repo_dir = os.path.dirname(config_file)

model = Wav2Vec2ForCTC.from_pretrained(repo_dir)
state_dict = torch.load(weights_file, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    from io import BytesIO
    audio_bytes = requests.get(audio_path, timeout=30).content
    sr, speech = wavfile.read(BytesIO(audio_bytes))
else:
    sr, speech = wavfile.read(audio_path)

if speech.dtype != np.float32:
    if np.issubdtype(speech.dtype, np.integer):
        max_val = np.iinfo(speech.dtype).max
        speech = speech.astype(np.float32) / max_val
    else:
        speech = speech.astype(np.float32)

input_values = torch.tensor(speech, dtype=torch.float32).unsqueeze(0).to(device)
with torch.no_grad():
    outputs = model(input_values=input_values)
logits = outputs.logits.detach().cpu().numpy()
predicted_ids = np.argmax(logits, axis=-1)
RESULT = {"logits": logits, "predicted_ids": predicted_ids}
