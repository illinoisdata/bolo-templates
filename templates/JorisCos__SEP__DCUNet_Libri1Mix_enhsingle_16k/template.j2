{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set sample_rate = sample_rate | default(16000) %}
{% set repo_id = repo_id | default("JorisCos/DCUNet_Libri1Mix_enhsingle_16k") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}

import os
import torch
import soundfile as sf
import numpy as np
from huggingface_hub import hf_hub_download
from asteroid.models import DCUNet

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
state = torch.load(weights_path, map_location="cpu")

if audio_path.startswith(("http://", "https://")):
    import tempfile
    import requests
    r = requests.get(audio_path, timeout=30)
    r.raise_for_status()
    tmp = tempfile.NamedTemporaryFile(suffix=os.path.splitext(audio_path)[1] or ".wav", delete=False)
    tmp.write(r.content)
    tmp.close()
    wav_path = tmp.name
else:
    wav_path = audio_path

waveform, sr = sf.read(wav_path, dtype="float32", always_2d=True)
waveform = waveform.mean(axis=1)
if sr != sample_rate:
    n_samples = int(round(len(waveform) * sample_rate / sr))
    x_old = np.linspace(0.0, 1.0, num=len(waveform), endpoint=False)
    x_new = np.linspace(0.0, 1.0, num=n_samples, endpoint=False)
    waveform = np.interp(x_new, x_old, waveform).astype(np.float32)

x = torch.from_numpy(waveform).float().unsqueeze(0).unsqueeze(0)
model = DCUNet(architecture="DCUNet-10", fix_length_mode="pad")
model.load_state_dict(state, strict=False)
model.to(device)
model.eval()

with torch.no_grad():
    y = model(x.to(device))

if isinstance(y, (tuple, list)):
    y = y[0]
output = y.detach().cpu().squeeze().numpy()

RESULT = {"enhanced_audio": output}
