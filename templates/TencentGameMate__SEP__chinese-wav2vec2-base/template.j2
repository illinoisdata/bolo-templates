repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
output_dir = "{{ output_dir }}"

import io
from pathlib import Path

import numpy as np
import requests
import soundfile as sf
import torch
import torchaudio.functional as F
from transformers import AutoFeatureExtractor, AutoModelForPreTraining


def _is_url(path: str) -> bool:
    return path.startswith("http://") or path.startswith("https://")


def _load_audio(path: str):
    if _is_url(path):
        response = requests.get(path, timeout=30)
        response.raise_for_status()
        with io.BytesIO(response.content) as buffer:
            waveform, sampling_rate = sf.read(buffer)
    else:
        waveform, sampling_rate = sf.read(path)
    return waveform, sampling_rate


def _prepare_waveform(waveform, sampling_rate: int, target_rate: int):
    if waveform.ndim > 1:
        waveform = waveform.mean(axis=1)
    waveform = waveform.astype(np.float32)
    if sampling_rate != target_rate:
        waveform_tensor = torch.from_numpy(waveform)
        resampled = F.resample(waveform_tensor, orig_freq=sampling_rate, new_freq=target_rate)
        waveform = resampled.numpy()
        sampling_rate = target_rate
    return waveform, sampling_rate


feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id)
model = model.to(device)
model.eval()

target_sampling_rate = feature_extractor.sampling_rate
waveform, sampling_rate = _load_audio(audio_path)
waveform, sampling_rate = _prepare_waveform(waveform, sampling_rate, target_sampling_rate)
inputs = feature_extractor(waveform, sampling_rate=sampling_rate, return_tensors="pt")
input_values = inputs.input_values.to(device)

with torch.no_grad():
    outputs = model(input_values, output_hidden_states=True)
    last_hidden_state = outputs.hidden_states[-1].detach().cpu()

RESULT = {
    "last_hidden_state": last_hidden_state,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    np.save(output_path / "last_hidden_state.npy", RESULT["last_hidden_state"].numpy())