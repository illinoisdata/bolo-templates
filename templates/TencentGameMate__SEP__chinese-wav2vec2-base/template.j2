{% set repo_id = repo_id | default("TencentGameMate/chinese-wav2vec2-base") %}
{% set device = device | default("cuda:0") %}
{% set wav_path = wav_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set mask_prob = mask_prob | default(0.0) %}
{% set mask_length = mask_length | default(10) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
wav_path = "{{ wav_path }}"
mask_prob = {{ mask_prob }}
mask_length = {{ mask_length }}

from urllib.parse import urlparse
from pathlib import Path

import torch
import soundfile as sf
from transformers import Wav2Vec2FeatureExtractor, Wav2Vec2Model
from huggingface_hub import hf_hub_download

feature_extractor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(str(Path(feature_extractor_path).parent))
model = Wav2Vec2Model.from_pretrained(str(Path(weights_path).parent), config=str(config_path))
model = model.to(device)
model.eval()

if urlparse(wav_path).scheme in ("http", "https"):
    wav, sr = sf.read(wav_path)
else:
    wav, sr = sf.read(wav_path)

if sr != 16000:
    wav = torch.tensor(wav, dtype=torch.float32)
    wav = torch.nn.functional.interpolate(wav.view(1, 1, -1), size=int(round(wav.shape[0] * 16000 / sr)), mode="linear", align_corners=False).view(-1).numpy()
    sr = 16000

input_values = feature_extractor(wav, sampling_rate=16000, return_tensors="pt").input_values.to(device)

with torch.no_grad():
    outputs = model(input_values)
    last_hidden_state = outputs.last_hidden_state

RESULT = {"last_hidden_state": last_hidden_state}
