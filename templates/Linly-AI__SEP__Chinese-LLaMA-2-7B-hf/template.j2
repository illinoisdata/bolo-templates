{% set repo_id = repo_id | default("Linly-AI/Chinese-LLaMA-2-7B-hf") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("北京有什么好玩的地方？") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
preprocessed_prompt = input_prompt
RESULT = pipe(preprocessed_prompt)
