{% set repo_id = repo_id | default("tennessejoyce/titlewave-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Example question body.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model_dir = os.path.dirname(weights_path)
tokenizer = T5Tokenizer.from_pretrained(model_dir)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer("summarize: " + input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=40,
        min_length=5,
        length_penalty=2.0,
        no_repeat_ngram_size=1,
        num_beams=4,
        early_stopping=True,
    )

summary_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"summary_text": summary_text}
