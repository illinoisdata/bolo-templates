{% set repo_id = repo_id | default("keremberke/yolov8s-scene-classification") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if image.startswith(("http://", "https://")):
    image_input = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image_input = Image.open(image).convert("RGB")

model = YOLO(weights_path)
model.overrides["conf"] = conf
results = model.predict(image_input, device=device)
top1 = int(results[0].probs.top1)
probs = results[0].probs.data.detach().cpu().tolist()
RESULT = {"top1_index": top1, "probabilities": probs}
