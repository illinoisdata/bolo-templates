{% set repo_id = repo_id | default("google/fnet-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('Replace me by any text you\'d like.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import FNetTokenizer, FNetModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Load tokenizer/model from the repo snapshot files.
tokenizer = FNetTokenizer.from_pretrained(
    repo_id,
    tokenizer_file=tokenizer_path,
    sp_model_kwargs={},
)
model = FNetModel.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded_input = tokenizer(
    text,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=512,
)
encoded_input = {k: v.to(device) for k, v in encoded_input.items()}

with torch.no_grad():
    output = model(**encoded_input)

RESULT = {
    "last_hidden_state": output.last_hidden_state,
    "pooler_output": output.pooler_output,
}
