{% set repo_id = repo_id | default("timm/efficientnet_b0.ra_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set model = model | default(repo_id) -%}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}
{% set device_arg = device_arg | default(device) -%}
{% set cuda_lib_dir = cuda_lib_dir | default("/workspace/.pip/nvidia/cuda_runtime/lib") -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device_arg | tojson }}
input_image = {{ input_image | tojson }}
cuda_lib_dir = {{ cuda_lib_dir | tojson }}

import os

_ld = os.environ.get("LD_LIBRARY_PATH", "")
_paths = _ld.split(os.pathsep) if _ld else []
if cuda_lib_dir not in _paths:
    os.environ["LD_LIBRARY_PATH"] = cuda_lib_dir + (os.pathsep + _ld if _ld else "")

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_image)
