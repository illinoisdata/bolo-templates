{% set device = "cuda:0" %}
{% set repo_id = "dbmdz/electra-base-german-europeana-cased-discriminator" %}
{% set text = "Dies ist ein Beispieltext auf Deutsch für die Inferenz mit ELECTRA." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
import os

import numpy as np
import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text,
    return_tensors="pt",
    truncation=True,
    max_length=tokenizer.model_max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits

discriminator_predictions = logits.argmax(dim=-1)

RESULT = {
    "logits": logits.detach().cpu().numpy(),
    "discriminator_predictions": discriminator_predictions.detach().cpu().numpy(),
}
