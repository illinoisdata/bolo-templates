{% set repo_id = repo_id | default("dbmdz/electra-base-german-europeana-cased-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein kurzer deutscher Beispielsatz.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForPreTraining
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_path.rsplit('/', 1)[0],
    vocab_file=vocab_path,
    use_fast=False,
)
model = AutoModelForPreTraining.from_pretrained(
    weights_path.rsplit('/', 1)[0],
    local_files_only=True,
)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probs = torch.sigmoid(logits)
RESULT = {"text": text, "logits": logits.detach().cpu().tolist(), "probabilities": probs.detach().cpu().tolist()}
