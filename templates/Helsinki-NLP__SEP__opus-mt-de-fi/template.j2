{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-de-fi" %}
{% set text_input = "Dies ist ein kurzer Beispielsatz auf Deutsch, der ins Finnische übersetzt werden soll." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text_input, return_tensors="pt", padding=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translated_text = decoded[0]

RESULT = {"translation": translated_text}
