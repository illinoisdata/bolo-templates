{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-de-fi") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Das ist ein kleiner Test.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, MarianMTModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
source_spm_path = hf_hub_download(repo_id=repo_id, filename='source.spm')
target_spm_path = hf_hub_download(repo_id=repo_id, filename='target.spm')
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
vocab_path = hf_hub_download(repo_id=repo_id, filename='vocab.json')

# Use the pretrained Marian tokenizer setup from the repo files
# AutoTokenizer can resolve the SentencePiece assets from the downloaded repo files.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = MarianMTModel.from_pretrained(repo_id, torch_dtype=torch.float32, low_cpu_mem_usage=False)
model.to(device)
model.eval()

inputs = tokenizer([input_text], return_tensors='pt', padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated = model.generate(**inputs, num_beams=4, max_length=128)
output_text = tokenizer.batch_decode(generated, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
