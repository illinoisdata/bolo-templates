{% set repo_id = repo_id | default("timm/vit_large_patch14_clip_224.laion400m_e32") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
import torch
import timm
import requests
from PIL import Image
from io import BytesIO
from torchvision import transforms
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    cfg = json.load(f)
pretrained_cfg = cfg.get("pretrained_cfg", {})
mean = pretrained_cfg.get("mean", [0.48145466, 0.4578275, 0.40821073])
std = pretrained_cfg.get("std", [0.26862954, 0.26130258, 0.27577711])
img_size = pretrained_cfg.get("input_size", [3, 224, 224])[1]

if str(image_path).startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

transform = transforms.Compose([
    transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.BICUBIC),
    transforms.ToTensor(),
    transforms.Normalize(mean=mean, std=std),
])
image_tensor = transform(image).unsqueeze(0).to(device)

model = timm.create_model(f"hf-hub:{repo_id}", pretrained=False)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict)
model.eval().to(device)

with torch.no_grad():
    output = model(image_tensor)

RESULT = {"logits": output.detach().cpu().numpy()}
