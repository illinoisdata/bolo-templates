{% set repo_id = "wasmdashai/vits-ar-sa-huba-v2" %}
{% set device = "cuda:0" %}
{% set text = "السلام عليكم كيفك عساك بخير" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import numpy as np
import torch
from scipy.io.wavfile import write
from transformers import VitsModel, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    generated = model(**inputs)
waveform = generated.waveform.cpu().numpy().reshape(-1)
sampling_rate = model.config.sampling_rate

# Build result dict
RESULT = {"waveform": waveform, "sampling_rate": sampling_rate}
