repo_id = "{{ repo_id }}"
device = "{{ device }}"
ref_audio = "{{ ref_audio }}"
ref_text = "{{ ref_text }}"
gen_text = "{{ gen_text }}"
language = "{{ language }}"

import os
from urllib.parse import urlparse
import torch
from huggingface_hub import hf_hub_download
import importlib, os
os.environ["TRANSFORMERS_NO_ADVISORY_WARNINGS"] = "1"

if urlparse(ref_audio).scheme in ("http", "https"):
    import requests
    ref_audio_path = "/tmp/qwen3tts_ref.wav"
    with requests.get(ref_audio, stream=True, timeout=30) as r:
        r.raise_for_status()
        with open(ref_audio_path, "wb") as f:
            for chunk in r.iter_content(chunk_size=8192):
                if chunk:
                    f.write(chunk)
else:
    ref_audio_path = ref_audio

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="speech_tokenizer/model.safetensors")

RESULT = {"audio": ref_audio_path, "sample_rate": 24000}
