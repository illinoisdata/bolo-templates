{% set repo_id = repo_id | default("keremberke/yolov8n-shoe-classification") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}

from pathlib import Path
from urllib.parse import urlparse

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

model_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if image.startswith(("http://", "https://")):
    image_path = Path("/tmp") / Path(urlparse(image).path).name
    if not image_path.exists():
        image_path.write_bytes(requests.get(image, timeout=30).content)
    image_input = str(image_path)
else:
    image_input = image

model = YOLO(model_path)
results = model.predict(source=image_input, conf=conf, device=device, verbose=False)
probs = results[0].probs
names = results[0].names
predictions = {names[i]: float(probs.data[i]) for i in range(len(names))}
RESULT = {"predictions": predictions, "top1": names[int(probs.top1)], "top1_confidence": float(probs.top1conf)}
