{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("valhalla/t5-base-qg-hl") %}
{% set input_text = input_text | default("<hl> 42 <hl> is the answer to life, the universe and everything. </s>") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
)

generated_questions = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_questions": generated_questions}
