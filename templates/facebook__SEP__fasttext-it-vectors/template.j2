{% set repo_id = repo_id | default("facebook/fasttext-it-vectors") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("apple") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import fasttext
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
model = fasttext.load_model(model_path)

embedding = model.get_word_vector(text)
nearest = model.get_nearest_neighbors(text, k=5)

RESULT = {
    "embedding": embedding.tolist(),
    "nearest_neighbors": [(float(score), word) for score, word in nearest],
}
