{% set repo_id = repo_id | default("Snowflake/Arctic-Text2SQL-R1-7B") %}
{% set device = device | default("cuda:0") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.0) %}
{% set top_p = top_p | default(1.0) %}
{% set question = question | default("How many employees are there?") %}
{% set schema = schema | default("CREATE TABLE employees (id INTEGER, name TEXT, department TEXT, salary REAL);") %}
{% set system_prompt = system_prompt | default("You are an expert text-to-SQL assistant. Given a database schema and a question, write a single SQL query that answers the question. Return only the SQL query.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
question = {{ question | tojson }}
schema = {{ schema | tojson }}
system_prompt = {{ system_prompt | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM


tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
    trust_remote_code=True,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

messages = [
    {"role": "system", "content": system_prompt},
    {"role": "user", "content": f"Schema:\n{schema}\n\nQuestion:\n{question}"},
]
prompt_text = tokenizer.apply_chat_template(
    messages,
    add_generation_prompt=True,
    tokenize=False,
)
enc = tokenizer(prompt_text, return_tensors="pt")
input_ids = enc["input_ids"].to(device)

with torch.no_grad():
    generated = model.generate(
        input_ids=input_ids,
        max_new_tokens=max_new_tokens,
        do_sample=temperature > 0,
        temperature=temperature if temperature > 0 else 1.0,
        top_p=top_p if temperature > 0 else 1.0,
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.pad_token_id,
    )

output_ids = generated[0, input_ids.shape[-1]:]
output_text = tokenizer.decode(output_ids, skip_special_tokens=True).strip()

RESULT = {"sql": output_text}
