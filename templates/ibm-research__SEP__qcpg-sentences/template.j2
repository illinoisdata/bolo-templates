{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ibm-research/qcpg-sentences") %}
{% set input_text = input_text | default("Will this approach work for generating diverse paraphrases?") %}
{% set lexical = lexical | default(0.3) %}
{% set syntactic = syntactic | default(0.5) %}
{% set semantic = semantic | default(0.8) %}
{% set max_length = max_length | default(120) %}
{% set num_beams = num_beams | default(4) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
lexical = {{ lexical }}
syntactic = {{ syntactic }}
semantic = {{ semantic }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

control_ranges = {
    "lex": (0, 100),
    "syn": (0, 80),
    "sem": (0, 95),
}
range_key_map = {
    "semantic_sim": "sem",
    "lexical_div": "lex",
    "syntactic_div": "syn",
}
control_names = ["semantic_sim", "lexical_div", "syntactic_div"]
input_values = [semantic, lexical, syntactic]
control_tokens = []
for name, value in zip(control_names, input_values):
    raw_value = int(5 * round(value * 100 / 5))
    key = range_key_map[name]
    min_val, max_val = control_ranges[key]
    clamped = max(min(raw_value, max_val), min_val)
    token = f"COND_{name.upper()}_{clamped}"
    control_tokens.append(token)

controlled_text = f"{' '.join(control_tokens)} {input_text}"
inputs = tokenizer(controlled_text, return_tensors="pt").to(device)
generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
    early_stopping=True,
)
generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
