{% set repo_id = repo_id | default("TestZee/t5-small-finetuned-pytorch-final") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("The Apollo missions not only placed humans on the Moon but also taught the world resilience and innovation.") %}
{% set generation_prefix = generation_prefix | default("summarize: ") %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
generation_prefix = "{{ generation_prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

prefixed_text = f"{generation_prefix}{text_input}"
inputs = tokenizer(prefixed_text, return_tensors="pt", truncation=True, max_length=512).to(device)

generate_kwargs = {
    "max_length": max_length,
    "min_length": min_length,
    "num_beams": num_beams,
    "length_penalty": length_penalty,
    "no_repeat_ngram_size": no_repeat_ngram_size,
    "early_stopping": early_stopping,
    "pad_token_id": tokenizer.pad_token_id,
}
with torch.no_grad():
    generated_tokens = model.generate(**inputs, **generate_kwargs)

generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True, clean_up_tokenization_spaces=True)
summary = generated_text[0].strip()

RESULT = {"summary": summary}
