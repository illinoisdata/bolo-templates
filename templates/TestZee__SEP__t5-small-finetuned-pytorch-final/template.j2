{% set repo_id = repo_id | default("TestZee/t5-small-finetuned-pytorch-final") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('summarize: The quick brown fox jumps over the lazy dog. This sentence is used as a simple input for testing the summarization model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
repo_dir = os.path.dirname(weights_path)

config = config_path
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, config=config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)

tokenizer = AutoTokenizer.from_pretrained(repo_dir)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=64,
        num_beams=4,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
