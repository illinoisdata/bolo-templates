{% set repo_id = repo_id | default("facebook/mbart-large-50") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default("UN Chief Says There Is No Military Solution in Syria") %}
{% set src_lang = src_lang | default("en_XX") %}
{% set tgt_lang = tgt_lang | default("ro_RO") %}
{% set max_length = max_length | default(200) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
tokenizer.src_lang = src_lang
tokenizer.tgt_lang = tgt_lang
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt").to(device)
forced_bos_token_id = tokenizer.lang_code_to_id[tgt_lang]
generated_tokens = model.generate(**inputs, forced_bos_token_id=forced_bos_token_id, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
