{% set repo_id = repo_id | default("bababababooey/faster-whisper-large-v3") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(1) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}

import os
from urllib.parse import urlparse
import numpy as np
import soundfile as sf
from faster_whisper import WhisperModel


def load_audio(path_or_url):
    if isinstance(path_or_url, str) and path_or_url.startswith(("http://", "https://")):
        import tempfile
        import urllib.request
        suffix = os.path.splitext(urlparse(path_or_url).path)[1] or ".wav"
        fd, tmp_path = tempfile.mkstemp(suffix=suffix)
        os.close(fd)
        urllib.request.urlretrieve(path_or_url, tmp_path)
        path_or_url = tmp_path
    audio, sr = sf.read(path_or_url)
    if audio.ndim > 1:
        audio = np.mean(audio, axis=1)
    if sr != 16000:
        import librosa
        audio = librosa.resample(audio.astype(np.float32), orig_sr=sr, target_sr=16000)
    return audio.astype(np.float32)

ct2_device = "cpu"
compute_type = "int8"
model = WhisperModel(repo_id, device=ct2_device, compute_type=compute_type)
audio = load_audio(audio_path)
segments, info = model.transcribe(audio, task=task, language=language, beam_size=beam_size)
text = "".join(segment.text for segment in segments).strip()

RESULT = {"text": text, "language": info.language, "language_probability": info.language_probability}
