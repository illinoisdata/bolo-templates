{% set repo_id = repo_id | default("timm/tf_efficientnet_b0.aa_in1k") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set device = device | default("cuda:0") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

if isinstance(device, str) and device.startswith("cuda"):
    _pipeline_device = int(device.split(":")[1])
elif device == "cpu":
    _pipeline_device = -1
else:
    _pipeline_device = int(device)

pipe = pipeline(task=task, model=model, device=_pipeline_device)
image = Image.open(input_image).convert("RGB")
RESULT = pipe(image)
