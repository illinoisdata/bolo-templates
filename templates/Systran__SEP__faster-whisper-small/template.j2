{% set repo_id = repo_id | default("Systran/faster-whisper-small") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(1) %}
{% set best_of = best_of | default(1) %}
{% set temperature = temperature | default(0.0) %}
{% set vad_filter = vad_filter | default(false) %}
{% set word_timestamps = word_timestamps | default(false) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
best_of = {{ best_of }}
temperature = {{ temperature }}
vad_filter = {{ 'True' if vad_filter else 'False' }}
word_timestamps = {{ 'True' if word_timestamps else 'False' }}

import os
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if audio_path.startswith(("http://", "https://")):
    import urllib.request
    local_audio_path, _ = urllib.request.urlretrieve(audio_path)
else:
    local_audio_path = audio_path

model_dir = os.path.dirname(model_path)
ct2_device = "cpu"
compute_type = "int8"
model = WhisperModel(model_dir, device=ct2_device, compute_type=compute_type)

segments, info = model.transcribe(
    local_audio_path,
    task=task,
    language=language,
    beam_size=beam_size,
    best_of=best_of,
    temperature=temperature,
    vad_filter=vad_filter,
    word_timestamps=word_timestamps,
)

text = "".join(segment.text for segment in segments).strip()
RESULT = {
    "text": text,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
