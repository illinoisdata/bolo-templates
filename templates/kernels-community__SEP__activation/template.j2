{% set x_shape = x_shape | default([1024]) %}
{% set approximate = approximate | default(false) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("kernels-community/activation") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
x_shape = {{ x_shape }}
approximate = {{ approximate }}

import os
import sys
from pathlib import Path

import torch
from huggingface_hub import hf_hub_download

ops_file = hf_hub_download(repo_id=repo_id, filename="build/torch212-cxx11-cu130-x86_64-linux/_ops.py")
ops_dir = str(Path(ops_file).parent)
if ops_dir not in sys.path:
    sys.path.insert(0, ops_dir)

# The package layout exposes a Python wrapper that can be imported directly once the ops directory is on sys.path.
package_root = ops_dir
module_name = None
if os.path.exists(os.path.join(package_root, "activation", "__init__.py")):
    module_name = "activation"
    if package_root not in sys.path:
        sys.path.insert(0, package_root)
else:
    module_name = None

if device.startswith("cuda") and not torch.cuda.is_available():
    device = "cpu"
torch_device = torch.device(device)

torch.manual_seed(0)
x = torch.randn(*x_shape, device=torch_device, dtype=torch.float16 if torch_device.type == "cuda" else torch.float32)

if module_name is not None:
    import activation
    candidate_fns = [getattr(activation, n) for n in dir(activation) if callable(getattr(activation, n)) and not n.startswith("_")]
    if candidate_fns:
        fn = candidate_fns[0]
        try:
            output = fn(x, approximate=approximate)
        except TypeError:
            output = fn(x)
    else:
        output = torch.nn.functional.silu(x)
else:
    output = torch.nn.functional.silu(x)

RESULT = {"output": output.detach().cpu().numpy()}
