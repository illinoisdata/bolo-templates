{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("facebook/wav2vec2-large-lv60") %}
{% set sample_rate = sample_rate | default(16000) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}

import os
import numpy as np
import torch
import librosa
from transformers import Wav2Vec2Model, Wav2Vec2FeatureExtractor
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
feature_extractor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
model_dir = os.path.dirname(model_path)
feature_dir = os.path.dirname(feature_extractor_path)
feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(feature_dir)
model = Wav2Vec2Model.from_pretrained(model_dir, config=config_path)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    import soundfile as sf
    from io import BytesIO
    audio_bytes = requests.get(audio_path).content
    waveform, sr = sf.read(BytesIO(audio_bytes))
else:
    waveform, sr = librosa.load(audio_path, sr=None)

if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)
if sr != sample_rate:
    waveform = librosa.resample(waveform, orig_sr=sr, target_sr=sample_rate)

inputs = feature_extractor(waveform, sampling_rate=sample_rate, return_tensors="pt")
input_values = inputs.input_values.to(device)
attention_mask = inputs.attention_mask.to(device) if inputs.attention_mask is not None else None

with torch.no_grad():
    outputs = model(input_values=input_values, attention_mask=attention_mask)

last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
mean_hidden_state = last_hidden_state.mean(axis=1)

RESULT = {
    "last_hidden_state": last_hidden_state,
    "mean_hidden_state": mean_hidden_state,
}
