{% set text_inputs = "The committee approved the new policy yesterday." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/prithivida__SEP__active_to_passive_styletransfer" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = "{{ text_inputs }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded_inputs = tokenizer(text_inputs, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

decoded_outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_passive = decoded_outputs[0] if decoded_outputs else ""

RESULT = {"generated_passive": generated_passive}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    file_path = output_path / "generated_passive.txt"
    file_path.write_text(RESULT["generated_passive"], encoding="utf-8")