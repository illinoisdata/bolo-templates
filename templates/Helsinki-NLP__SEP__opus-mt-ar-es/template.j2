{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ar-es") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("مرحبا، كيف حالك؟") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

inference_device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(inference_device)
model.eval()

inputs = tokenizer(source_text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(inference_device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
