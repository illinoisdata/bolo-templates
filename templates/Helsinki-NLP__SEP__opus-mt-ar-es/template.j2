{% set repo_id = "Helsinki-NLP/opus-mt-ar-es" %}
{% set device = "cuda:0" %}
{% set source_text = "مرحبا، كيف حالك؟" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-ar-es" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

inference_device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(inference_device)
model.eval()

inputs = tokenizer(source_text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(inference_device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    translation_file = output_path / "translation.txt"
    translation_file.write_text(translation, encoding="utf-8")