{% set repo_id = repo_id | default("timm/hrnet_w18_small_v2.gluon_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image_path = input_image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image_path = {{ input_image_path | tojson }}

from PIL import Image
from transformers import pipeline

image = Image.open(input_image_path).convert("RGB")

pipe = pipeline(task=task, model=model, device=device)
predictions = pipe(image)

RESULT = {"predictions": predictions}
