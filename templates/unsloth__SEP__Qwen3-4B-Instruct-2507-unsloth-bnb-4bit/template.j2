{% set repo_id = repo_id | default("unsloth/Qwen3-4B-Instruct-2507-unsloth-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(256) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
model = repo_id
input_prompt = "{{ input_prompt }}"
max_new_tokens = {{ max_new_tokens }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

model_input = input_prompt

inference_output = pipe(model_input, max_new_tokens=max_new_tokens)

RESULT = {"outputs": inference_output}
