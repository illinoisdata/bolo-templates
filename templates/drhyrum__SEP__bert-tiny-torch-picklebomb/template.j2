{% set text_input = "The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/drhyrum__SEP__bert-tiny-torch-picklebomb" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
output_dir = "{{ output_dir }}"

import os
import numpy as np
import torch
from transformers import AutoConfig, AutoModel, AutoTokenizer

config = AutoConfig.from_pretrained(repo_id)
model = AutoModel.from_config(config).to(torch.device(device))
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded = tokenizer(text_input, return_tensors="pt", truncation=True, padding=True)
encoded = {key: value.to(torch.device(device)) for key, value in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)

last_hidden_state = outputs.last_hidden_state
RESULT = {"last_hidden_state": last_hidden_state.cpu()}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, "last_hidden_state.npy"), RESULT["last_hidden_state"].numpy())