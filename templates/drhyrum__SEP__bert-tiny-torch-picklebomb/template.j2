{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("drhyrum/bert-tiny-torch-picklebomb") %}
{% set text_input = text_input | default("The quick brown fox jumps over the lazy dog.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""

import os
import numpy as np
import torch
from transformers import AutoConfig, AutoModel, AutoTokenizer

config = AutoConfig.from_pretrained(repo_id)
model = AutoModel.from_config(config).to(torch.device(device))
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded = tokenizer(text_input, return_tensors="pt", truncation=True, padding=True)
encoded = {key: value.to(torch.device(device)) for key, value in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)

last_hidden_state = outputs.last_hidden_state
RESULT = {"last_hidden_state": last_hidden_state.cpu()}
