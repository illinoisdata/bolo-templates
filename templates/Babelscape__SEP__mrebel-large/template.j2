{% set repo_id = "Babelscape/mrebel-large" %}
{% set device = "cuda:0" %}
{% set input_text = "The Red Hot Chili Peppers were formed in Los Angeles by Kiedis, Flea, guitarist Hillel Slovak and drummer Jack Irons." %}
{% set src_lang = "en_XX" %}
{% set tgt_lang = "<triplet>" %}
{% set max_length = 256 %}
{% set num_beams = 3 %}
{% set num_return_sequences = 1 %}
{% set length_penalty = 0.0 %}
{% set decoder_start_token_id = 250058 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Babelscape__SEP__mrebel-large" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
length_penalty = {{ length_penalty }}
decoder_start_token_id = {{ decoder_start_token_id }}
output_dir = "{{ output_dir }}"

import json
import os
from typing import Dict, List

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer


def extract_triplets_typed(text: str) -> List[Dict[str, str]]:
    triplets: List[Dict[str, str]] = []
    relation = ""
    text = text.strip()
    current = "x"
    subject = ""
    object_ = ""
    object_type = ""
    subject_type = ""

    sanitized = (
        text.replace("<s>", "")
        .replace("<pad>", "")
        .replace("</s>", "")
        .replace("tp_XX", "")
        .replace("__en__", "")
    )

    for token in sanitized.split():
        if token == "<triplet>" or token == "<relation>":
            current = "t"
            if relation != "":
                triplets.append(
                    {
                        "head": subject.strip(),
                        "head_type": subject_type,
                        "type": relation.strip(),
                        "tail": object_.strip(),
                        "tail_type": object_type,
                    }
                )
                relation = ""
            subject = ""
        elif token.startswith("<") and token.endswith(">"):
            if current == "t" or current == "o":
                current = "s"
                if relation != "":
                    triplets.append(
                        {
                            "head": subject.strip(),
                            "head_type": subject_type,
                            "type": relation.strip(),
                            "tail": object_.strip(),
                            "tail_type": object_type,
                        }
                    )
                object_ = ""
                subject_type = token[1:-1]
            else:
                current = "o"
                object_type = token[1:-1]
                relation = ""
        else:
            if current == "t":
                subject += " " + token
            elif current == "s":
                object_ += " " + token
            elif current == "o":
                relation += " " + token
    if subject != "" and relation != "" and object_ != "" and object_type != "" and subject_type != "":
        triplets.append(
            {
                "head": subject.strip(),
                "head_type": subject_type,
                "type": relation.strip(),
                "tail": object_.strip(),
                "tail_type": object_type,
            }
        )
    return triplets


tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    src_lang=src_lang,
    tgt_lang=tgt_lang,
)

if hasattr(tokenizer, "set_src_lang_special_tokens"):
    tokenizer.set_src_lang_special_tokens(src_lang)
if hasattr(tokenizer, "src_lang"):
    tokenizer.src_lang = src_lang

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model_inputs = tokenizer(
    input_text,
    max_length=max_length,
    padding=True,
    truncation=True,
    return_tensors="pt",
    src_lang=src_lang,
    tgt_lang=tgt_lang,
)

input_ids = model_inputs["input_ids"].to(device)
attention_mask = model_inputs["attention_mask"].to(device)

generation_kwargs = {
    "decoder_start_token_id": decoder_start_token_id,
    "num_beams": num_beams,
    "num_return_sequences": num_return_sequences,
    "max_length": max_length,
    "length_penalty": length_penalty,
}

generated_tokens = model.generate(input_ids, attention_mask=attention_mask, **generation_kwargs)

decoded_preds = tokenizer.batch_decode(generated_tokens, skip_special_tokens=False)

parsed_triplets = [extract_triplets_typed(pred) for pred in decoded_preds]

RESULT = {
    "decoded_predictions": decoded_preds,
    "typed_triplets": parsed_triplets,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    decoded_path = os.path.join(output_dir, "decoded_predictions.json")
    with open(decoded_path, "w", encoding="utf-8") as decoded_file:
        json.dump(decoded_preds, decoded_file, ensure_ascii=False, indent=2)
    triplets_path = os.path.join(output_dir, "typed_triplets.json")
    with open(triplets_path, "w", encoding="utf-8") as triplets_file:
        json.dump(parsed_triplets, triplets_file, ensure_ascii=False, indent=2)