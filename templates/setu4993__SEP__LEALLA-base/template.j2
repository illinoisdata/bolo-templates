{% set repo_id = repo_id | default("setu4993/LEALLA-base") %}
{% set device = device | default("cuda:0") %}
{% set sentences = sentences | default(["dog", "Puppies are nice.", "I enjoy taking long walks along the beach with my dog."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences }}

import torch
import torch.nn.functional as F
from transformers import BertModel, BertTokenizerFast
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")


tokenizer = BertTokenizerFast.from_pretrained(
    pretrained_model_name_or_path=vocab_path.rsplit('/', 1)[0],
    local_files_only=True,
)
model = BertModel.from_pretrained(
    pretrained_model_name_or_path=weights_path.rsplit('/', 1)[0],
    local_files_only=True,
)
model = model.to(device).eval()

inputs = tokenizer(sentences, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

embeddings = outputs.pooler_output
normalized_embeddings = F.normalize(embeddings, p=2, dim=1)
similarity_matrix = torch.matmul(normalized_embeddings, normalized_embeddings.transpose(0, 1))

RESULT = {"embeddings": embeddings.cpu(), "similarity_matrix": similarity_matrix.cpu()}
