{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-bg") %}
{% set device = device | default("cuda:0") %}
{% set target_lang = target_lang | default("bul") %}
{% set source_text = source_text | default("Hello, world!") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
target_lang = "{{ target_lang }}"
source_text = "{{ source_text }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

full_text = f">>{target_lang}<< {source_text}"
encoded_inputs = tokenizer(full_text, return_tensors="pt").to(device)
generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translations[0]}
