{% set repo_id = "microsoft/layoutlm-large-uncased" %}
{% set device = "cuda:0" %}
{% set words = ["Invoice", "Date", "Amount", "Total", "."] %}
{% set bounding_boxes = [[0, 0, 50, 50], [60, 0, 110, 50], [0, 60, 80, 110], [90, 60, 140, 110], [150, 60, 170, 80]] %}
{% set max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
words = {{ words | tojson }}
bounding_boxes = {{ bounding_boxes | tojson }}
max_length = {{ max_length }}

from transformers import AutoTokenizer, AutoModel
import numpy as np
import os
import torch

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(torch_device)
model.eval()

encoding = tokenizer(
    words,
    boxes=bounding_boxes,
    padding="max_length",
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
    is_split_into_words=True,
)
inputs = {key: value.to(torch_device) for key, value in encoding.items()}

with torch.no_grad():
    model_output = model(**inputs)

last_hidden_state = model_output.last_hidden_state.detach().cpu()
RESULT = {"last_hidden_state": last_hidden_state}
