{% set repo_id = repo_id | default("google/pegasus-large") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('The quick brown fox jumps over the lazy dog. This article discusses how pegasus models are used for abstractive summarization and why text compression matters.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import PegasusTokenizer, PegasusForConditionalGeneration

repo_id = repo_id

tokenizer = PegasusTokenizer.from_pretrained(repo_id)
model = PegasusForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=128,
        num_beams=8,
        length_penalty=0.8,
        early_stopping=True,
    )

summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
