{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-gl-en") %}
{% set text_input = text_input | default("Este é un exemplo de texto en galego.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = {{ text_input | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"translation": translation}
