{% set text_input = "Este é un exemplo de texto en galego." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-gl-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = {{ text_input | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = {{ output_dir | tojson }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"translation": translation}

if __name__ == "__main__":
    destination = Path(output_dir)
    destination.mkdir(parents=True, exist_ok=True)
    (destination / "translation.txt").write_text(translation, encoding="utf-8")