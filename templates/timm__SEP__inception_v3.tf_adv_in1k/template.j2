{% set task = task | default("image-classification") %}
{% set repo_id = repo_id | default("timm/inception_v3.tf_adv_in1k") %}
{% set device = device | default("cuda:0") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}
model = repo_id

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

predictions = pipe(input_data)
RESULT = {
    "predictions": predictions
}
