{% set repo_id = repo_id | default("cmarkea/distilcamembert-base-ner") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Le Crédit Mutuel Arkéa est une banque française située en France.") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, aggregation_strategy="simple")
RESULT = pipe(input_prompt)
