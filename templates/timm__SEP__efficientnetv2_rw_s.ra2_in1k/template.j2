{% set repo_id = repo_id | default("timm/efficientnetv2_rw_s.ra2_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_image | tojson }}

from transformers import pipeline

if isinstance(device, str) and device.startswith("cuda"):
    pipeline_device = int(device.split(":", 1)[1]) if ":" in device else 0
elif device == "cpu":
    pipeline_device = -1
else:
    pipeline_device = device

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)

prepared_input = input_data

RESULT = pipe(prepared_input)
