{% set repo_id = repo_id | default("line-corporation/japanese-large-lm-3.6b-instruction-sft") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("日本語で挨拶と今日の調子を簡潔に教えてください。") %}
{% set generation_max_new_tokens = generation_max_new_tokens | default(64) %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ generation_max_new_tokens | tojson }}
model = repo_id

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt, max_new_tokens=max_new_tokens)
