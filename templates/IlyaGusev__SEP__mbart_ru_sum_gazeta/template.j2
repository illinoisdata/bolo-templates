{% set repo_id = repo_id | default("IlyaGusev/mbart_ru_sum_gazeta") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Высота башни составляет 324 метра (1063 фута), примерно такая же высота, как у 81-этажного здания, и самое высокое сооружение в Париже. Его основание квадратно, размером 125 метров (410 футов) с любой стороны. Во время строительства Эйфелева башня превзошла монумент Вашингтона, став самым высоким искусственным сооружением в мире, и этот титул она удерживала в течение 41 года до завершения строительство здания Крайслер в Нью-Йорке в 1930 году. Это первое сооружение которое достигло высоты 300 метров. Из-за добавления вещательной антенны на вершине башни в 1957 году она сейчас выше здания Крайслер на 5,2 метра (17 футов). За исключением передатчиков, Эйфелева башня является второй самой высокой отдельно стоящей структурой во Франции после виадука Мийо.") %}
{% set max_source_length = max_source_length | default(600) %}
{% set max_target_length = max_target_length | default(200) %}
{% set num_beams = num_beams | default(5) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_source_length = {{ max_source_length }}
max_target_length = {{ max_target_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    text,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=max_source_length,
)
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

output_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_target_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
)

summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"summary": summary}
