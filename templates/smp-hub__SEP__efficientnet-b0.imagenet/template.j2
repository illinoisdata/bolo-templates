{% set repo_id = repo_id | default("smp-hub/efficientnet-b0.imagenet") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
from io import BytesIO

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from torchvision import transforms
import segmentation_models_pytorch as smp
from safetensors.torch import load_file

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    cfg = json.load(f)

if str(image_path).startswith(("http://", "https://")):
    resp = requests.get(image_path, timeout=30)
    resp.raise_for_status()
    image = Image.open(BytesIO(resp.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

mean = cfg.get("mean", [0.485, 0.456, 0.406])
std = cfg.get("std", [0.229, 0.224, 0.225])

model = smp.Unet("efficientnet-b0", encoder_weights=None, classes=1000, activation=None)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

preprocess = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=mean, std=std),
])

x = preprocess(image).unsqueeze(0).to(device)

with torch.no_grad():
    logits = model(x)
    logits = logits.mean(dim=(2, 3))
    probs = torch.softmax(logits, dim=-1)[0]
    values, indices = torch.topk(probs, k=min(topk, probs.numel()))

RESULT = {
    "predicted_indices": indices.detach().cpu().tolist(),
    "predicted_scores": values.detach().cpu().tolist(),
    "logits": logits.detach().cpu().tolist(),
}
