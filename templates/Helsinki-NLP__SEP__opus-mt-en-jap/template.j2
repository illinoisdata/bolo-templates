{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-jap") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("This is a short English sentence to translate into Japanese.") %}
{% set max_input_length = max_input_length | default(128) %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_input_length = {{ max_input_length }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

target_device = torch.device(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(target_device)

texts_to_translate = [input_text]
preprocessed_inputs = tokenizer(
    texts_to_translate,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_input_length,
)
preprocessed_inputs = {key: value.to(target_device) for key, value in preprocessed_inputs.items()}

generated_tokens = model.generate(
    **preprocessed_inputs,
    num_beams=num_beams,
    max_new_tokens=max_new_tokens,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
