{% set repo_id = repo_id | default("caidas/swin2SR-realworld-sr-x4-64-bsrgan-psnr") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import requests
import torch
import numpy as np
from PIL import Image
from transformers import Swin2SRForImageSuperResolution, Swin2SRImageProcessor
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

processor = Swin2SRImageProcessor.from_pretrained(os.path.dirname(preprocessor_path), local_files_only=True)
model = Swin2SRForImageSuperResolution.from_pretrained(os.path.dirname(config_path), local_files_only=True, torch_dtype=torch.float32)
model.to(device)
model.eval()

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

sr = outputs.reconstruction
sr = sr.squeeze(0).detach().cpu().clamp(0, 1)
sr = (sr.permute(1, 2, 0).numpy() * 255.0).round().astype(np.uint8)
sr_image = Image.fromarray(sr)

RESULT = {"super_resolution": sr_image}
