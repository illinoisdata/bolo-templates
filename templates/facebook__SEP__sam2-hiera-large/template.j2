{% set task = task | default("mask-generation") %}
{% set repo_id = repo_id | default("facebook/sam2-hiera-large") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set points_per_batch = points_per_batch | default(64) %}

# Python variable assignments
task = "{{ task }}"
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
points_per_batch = {{ points_per_batch }}

# Imports
from transformers import pipeline

# Initialize pipeline
pipe = pipeline(task=task, model=repo_id, device=device)

# Pre-process input
input_data = image_path

# Run inference and build RESULT
RESULT = pipe(input_data, points_per_batch=points_per_batch)
