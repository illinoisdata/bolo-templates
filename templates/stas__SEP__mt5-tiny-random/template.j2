{% set repo_id = "stas/mt5-tiny-random" %}
{% set device = "cuda:0" %}
{% set input_text = "Translate English to French: The weather is nice today." %}
{% set max_length = 64 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/stas__SEP__mt5-tiny-random" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

processed_inputs = tokenizer(input_text, return_tensors="pt")
processed_inputs = {key: value.to(torch_device) for key, value in processed_inputs.items()}

generated_tokens = model.generate(**processed_inputs, max_length=max_length)
generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_text.txt")
    with open(output_path, "w", encoding="utf-8") as output_file:
        output_file.write(generated_text)