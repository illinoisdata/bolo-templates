{% set device = "cuda:0" %}
{% set repo_id = "csebuetnlp/banglabert" %}
{% set text_input = "আমি কৃতজ্ঞ কারণ আপনি আমার জন্য অনেক কিছু করেছেন।" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from pathlib import Path
import json

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()
inputs = tokenizer(text_input, return_tensors="pt")
inputs = inputs.to(device)
with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits
probabilities = torch.sigmoid(logits)
predictions = (probabilities >= 0.5).long()

input_ids = inputs["input_ids"].squeeze().cpu().tolist()
tokens = tokenizer.convert_ids_to_tokens(input_ids)

logits_list = logits.squeeze(0).cpu().tolist()
probabilities_list = probabilities.squeeze(0).cpu().tolist()
predictions_list = predictions.squeeze(0).cpu().tolist()

RESULT = {
    "tokens": tokens,
    "logits": logits_list,
    "probabilities": probabilities_list,
    "predictions": predictions_list,
}
