{% set repo_id = repo_id | default("csebuetnlp/banglabert") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('আমি কৃতজ্ঞ কারণ আপনি আমার জন্য অনেক কিছু করেছেন।') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForPreTraining, ElectraConfig
import torch

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

config = ElectraConfig.from_json_file(config_path)
model = AutoModelForPreTraining.from_config(config)
state_dict = torch.load(model_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    vocab_file=vocab_path,
    tokenizer_file=None,
    special_tokens_map_file=special_tokens_map_path,
    tokenizer_config=tokenizer_config_path,
)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
predictions = torch.round((torch.sign(logits) + 1) / 2)

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "predictions": predictions.detach().cpu().tolist(),
    "tokens": tokenizer.convert_ids_to_tokens(inputs["input_ids"][0].detach().cpu().tolist()),
}
