{% set repo_id = repo_id | default("TuhinColumbia/QAGenControlCode") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Generate a question answering style training example from the following passage. Return a concise question and its answer.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}

import torch
from huggingface_hub import hf_hub_download
from transformers import BartForConditionalGeneration, BartTokenizerFast

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

tokenizer_dir = "/".join(tokenizer_config_path.split("/")[:-1])
tokenizer = BartTokenizerFast.from_pretrained(tokenizer_dir, local_files_only=True)
model = BartForConditionalGeneration.from_pretrained(tokenizer_dir, local_files_only=True)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        do_sample=do_sample,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
