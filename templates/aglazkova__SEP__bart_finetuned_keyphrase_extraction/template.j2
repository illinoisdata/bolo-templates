{% set repo_id = "aglazkova/bart_finetuned_keyphrase_extraction" %}
{% set device = "cuda:0" %}
{% set text = "In this paper, we investigate cross-domain limitations of keyphrase generation using the models for abstractive text summarization." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
outputs = model.generate(**inputs)

# Post-process output
generated_keyphrases = tokenizer.batch_decode(outputs, skip_special_tokens=True)

# Build RESULT dict
RESULT = {"generated_keyphrases": generated_keyphrases}
