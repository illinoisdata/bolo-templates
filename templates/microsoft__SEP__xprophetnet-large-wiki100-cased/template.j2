{% set repo_id = repo_id | default("microsoft/xprophetnet-large-wiki100-cased") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('the us state department said wednesday it had received no formal word from bolivia that it was expelling the us ambassador there but said the charges made against him are baseless.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from transformers import ProphetNetForConditionalGeneration, AlbertTokenizer
import torch

model = ProphetNetForConditionalGeneration.from_pretrained(repo_id)
tokenizer = AlbertTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=16, num_beams=4, early_stopping=True)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": output_text}
