{% set repo_id = repo_id | default("deepset/gbert-base-germandpr-ctx_encoder") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Wer war Albert Einstein?') %}
{% set passage = passage | default('Albert Einstein war ein theoretischer Physiker. Er entwickelte die Relativitätstheorie.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
passage = "{{ passage }}"

import torch
from transformers import AutoTokenizer, DPRContextEncoder
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = config_path, weights_path

tokenizer = AutoTokenizer.from_pretrained(vocab_path.rsplit('/', 1)[0], use_fast=False)
model = DPRContextEncoder.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(
    passage,
    return_tensors="pt",
    truncation=True,
    max_length=300,
    padding="max_length",
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

embedding = outputs.pooler_output.detach().cpu().numpy()

RESULT = {"embedding": embedding}
