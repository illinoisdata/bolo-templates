{% set passage_text = "Die deutsche Hauptstadt Berlin hat eine reiche Geschichte, insbesondere im Kontext der deutschen Wiedervereinigung." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/deepset__SEP__gbert-base-germandpr-ctx_encoder" %}
{% set max_length = 256 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
passage_text = """{{ passage_text }}"""
output_dir = "{{ output_dir }}"
max_length = {{ max_length }}

from pathlib import Path
import json

import torch
from transformers import AutoModel, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model.eval()

# Pre-process input
encoded_inputs = tokenizer(
    passage_text,
    truncation=True,
    max_length=max_length,
    padding="longest",
    return_tensors="pt",
)
encoded_inputs = {name: tensor.to(torch_device) for name, tensor in encoded_inputs.items()}

# Run inference
with torch.no_grad():
    outputs = model(**encoded_inputs)

embedding_tensor = outputs.pooler_output
if embedding_tensor is None:
    embedding_tensor = outputs.last_hidden_state[:, 0, :]

embedding_tensor = embedding_tensor.squeeze(0).detach().cpu()
passage_embedding = embedding_tensor.tolist()

RESULT = {"passage_embedding": passage_embedding}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    with open(output_path / "passage_embedding.json", "w", encoding="utf-8") as outfile:
        json.dump(RESULT["passage_embedding"], outfile, ensure_ascii=False, indent=2)