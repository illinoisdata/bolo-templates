{% set repo_id = "Helsinki-NLP/opus-mt-en-sw" %}
{% set device = "cuda:0" %}
{% set source_text = "The quick brown fox jumps over the lazy dog." %}
{% set max_length = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
max_length = {{ max_length }}

import os
import torch
from transformers import MarianTokenizer, MarianMTModel

device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device).eval()

inputs = tokenizer(source_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0]

RESULT = {"translation": translation}
