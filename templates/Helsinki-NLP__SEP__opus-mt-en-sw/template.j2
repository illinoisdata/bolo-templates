{% set repo_id = "Helsinki-NLP/opus-mt-en-sw" %}
{% set device = "cuda:0" %}
{% set source_text = "The quick brown fox jumps over the lazy dog." %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-sw" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import MarianTokenizer, MarianMTModel

device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device).eval()

inputs = tokenizer(source_text, return_tensors="pt").to(device)

generated_tokens = model.generate(**inputs, max_length=max_length)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translation_path = os.path.join(output_dir, "translation.txt")
    with open(translation_path, "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])