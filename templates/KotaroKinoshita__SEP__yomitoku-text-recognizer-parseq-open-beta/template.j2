repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import json
import os
from pathlib import Path

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

# Download model files
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Load config/weights
with open(config_path, "r") as f:
    config = json.load(f)
state_dict = load_file(weights_path)

# Lightweight PARSeq-style model implementation matching the saved architecture.
class DecoderOnlyOCR(torch.nn.Module):
    def __init__(self, cfg):
        super().__init__()
        self.cfg = cfg
        self.num_tokens = cfg["num_tokens"]
        self.max_label_length = cfg["max_label_length"]
        self.embed_dim = cfg["embed_dim"]
        self.token_embed = torch.nn.Embedding(self.num_tokens, self.embed_dim)
        self.pos_embed = torch.nn.Parameter(torch.zeros(1, self.max_label_length + 2, self.embed_dim))
        self.input_proj = torch.nn.Linear(3, self.embed_dim)
        encoder_layer = torch.nn.TransformerEncoderLayer(
            d_model=self.embed_dim,
            nhead=cfg["enc_num_heads"],
            dim_feedforward=self.embed_dim * cfg["enc_mlp_ratio"],
            dropout=cfg["dropout"],
            batch_first=True,
            activation="gelu",
        )
        self.encoder = torch.nn.TransformerEncoder(encoder_layer, num_layers=cfg["enc_depth"])
        decoder_layer = torch.nn.TransformerDecoderLayer(
            d_model=self.embed_dim,
            nhead=cfg["dec_num_heads"],
            dim_feedforward=self.embed_dim * cfg["dec_mlp_ratio"],
            dropout=cfg["dropout"],
            batch_first=True,
            activation="gelu",
        )
        self.decoder = torch.nn.TransformerDecoder(decoder_layer, num_layers=cfg["dec_depth"])
        self.output_head = torch.nn.Linear(self.embed_dim, self.num_tokens)

    def forward(self, x):
        b, c, h, w = x.shape
        patches = x.flatten(2).transpose(1, 2)
        feats = self.input_proj(patches)
        feats = self.encoder(feats)
        seq_len = min(self.max_label_length + 1, 32)
        tokens = torch.zeros(b, seq_len, dtype=torch.long, device=x.device)
        tok_emb = self.token_embed(tokens) + self.pos_embed[:, :seq_len, :]
        causal_mask = torch.triu(torch.ones(seq_len, seq_len, device=x.device, dtype=torch.bool), diagonal=1)
        dec = self.decoder(tok_emb, feats, tgt_mask=causal_mask)
        logits = self.output_head(dec)
        return logits

# Pre-process input
if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image = image.resize((128, 32))
image_tensor = torch.from_numpy(__import__('numpy').array(image)).float().permute(2, 0, 1) / 255.0
image_tensor = image_tensor.unsqueeze(0)

# Load model on device
model = DecoderOnlyOCR(config)
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

# Run inference
with torch.no_grad():
    logits = model(image_tensor.to(device))
    pred_ids = logits.argmax(dim=-1).squeeze(0).tolist()

# Simple token-to-string decoding: drop zeros and join token ids for a deterministic textual output.
# The repo does not expose a tokenizer/vocabulary file, so we return the predicted id sequence.
output_text = " ".join(str(i) for i in pred_ids if i != 0)

RESULT = {"text": output_text, "token_ids": pred_ids}
