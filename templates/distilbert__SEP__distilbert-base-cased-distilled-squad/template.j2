{% set repo_id = repo_id | default("distilbert/distilbert-base-cased-distilled-squad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is a good example of a question answering dataset?') %}
{% set context = context | default('Extractive Question Answering is the task of extracting an answer from a text given a question. An example of a question answering dataset is the SQuAD dataset, which is entirely based on that task.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Derive local directory from a downloaded file path
import os
model_dir = os.path.dirname(model_file)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1)[0])
end_idx = int(torch.argmax(outputs.end_logits, dim=-1)[0])
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0, start_idx : end_idx + 1]
answer = tokenizer.decode(input_ids, skip_special_tokens=True).strip()

RESULT = {
    "answer": answer,
    "start_index": start_idx,
    "end_index": end_idx,
    "start_logits": outputs.start_logits[0].detach().cpu(),
    "end_logits": outputs.end_logits[0].detach().cpu(),
}
