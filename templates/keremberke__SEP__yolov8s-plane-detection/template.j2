{% set repo_id = repo_id | default("keremberke/yolov8s-plane-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if isinstance(image, str) and image.startswith(("http://", "https://")):
    image_input = image
else:
    image_input = Image.open(image).convert("RGB")

model = YOLO(weights_path)
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(source=image_input, device=device, verbose=False)
result = results[0]
boxes = result.boxes
boxes_xyxy = boxes.xyxy.cpu().numpy() if boxes is not None else None
boxes_conf = boxes.conf.cpu().numpy() if boxes is not None else None
boxes_cls = boxes.cls.cpu().numpy() if boxes is not None else None
classes = result.names

RESULT = {
    "boxes_xyxy": boxes_xyxy,
    "boxes_conf": boxes_conf,
    "boxes_cls": boxes_cls,
    "classes": classes,
}
