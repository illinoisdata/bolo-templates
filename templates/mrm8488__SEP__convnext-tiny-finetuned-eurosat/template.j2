{% set repo_id = repo_id | default("mrm8488/convnext-tiny-finetuned-eurosat") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set crop_pct = crop_pct | default(1.0) %}

repo_id = "{{ repo_id }}"
task = "{{ task }}"
device = "{{ device }}"
input_data = "{{ input_data }}"
crop_pct = {{ crop_pct }}

from transformers import AutoImageProcessor, pipeline

processor = AutoImageProcessor.from_pretrained(repo_id, crop_pct=crop_pct)
pipe = pipeline(task=task, model=repo_id, image_processor=processor, device=device)
image_input = input_data
RESULT = pipe(image_input)
