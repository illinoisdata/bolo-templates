{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("declare-lab/flan-alpaca-base") %}
{% set prompt = prompt | default("Describe the main features of instruction-tuned language models.") %}
{% set max_length = max_length | default(256) %}
{% set temperature = temperature | default(0.7) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
temperature = {{ temperature }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**inputs, max_length=max_length, do_sample=True, temperature=temperature)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
