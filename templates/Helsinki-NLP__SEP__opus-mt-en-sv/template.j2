{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-sv") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Translate this sentence from English to Swedish.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    source_text,
    return_tensors="pt",
    padding="longest",
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded[0] if decoded else ""

RESULT = {"translation": translation}
