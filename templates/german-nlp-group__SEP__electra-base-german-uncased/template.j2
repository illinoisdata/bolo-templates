{% set device = "cuda:0" %}
{% set repo_id = "german-nlp-group/electra-base-german-uncased" %}
{% set text_input = "Das ist ein Beispielsatz für die Inferenz mit dem Electra-Modell." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

encoded_text = tokenizer(text_input, return_tensors="pt", padding=True, truncation=True)
encoded_input = {key: tensor.to(device) for key, tensor in encoded_text.items()}

outputs = model(**encoded_input)
logits = outputs.logits
predicted_token_ids = logits.argmax(dim=-1)

input_ids = encoded_text["input_ids"].tolist()
input_tokens = [
    tokenizer.convert_ids_to_tokens(token_ids)
    for token_ids in encoded_text["input_ids"]
]

RESULT = {
    "input_tokens": input_tokens,
    "input_ids": input_ids,
    "predicted_token_ids": predicted_token_ids.tolist(),
    "logits": logits.detach().cpu().tolist(),
}
