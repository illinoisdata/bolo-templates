{% set repo_id = repo_id | default("german-nlp-group/electra-base-german-uncased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein kleiner deutscher Beispielsatz.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, ElectraForPreTraining

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Load tokenizer/model
_tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_config_path), use_fast=False)
model = ElectraForPreTraining.from_pretrained(os.path.dirname(config_path), torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = _tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.sigmoid(logits)
RESULT = {"logits": logits.detach().cpu(), "probabilities": probabilities.detach().cpu()}
