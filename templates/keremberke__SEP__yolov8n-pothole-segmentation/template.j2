{% set repo_id = repo_id | default("keremberke/yolov8n-pothole-segmentation") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import requests
from PIL import Image
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if isinstance(image, str) and image.startswith(("http://", "https://")):
    image_input = Image.open(requests.get(image, stream=True, timeout=30).raw).convert("RGB")
else:
    image_input = Image.open(image).convert("RGB")

model = YOLO(weights_path)
results = model.predict(image_input, conf=conf, iou=iou, agnostic_nms=agnostic_nms, max_det=max_det, device=device)
result = results[0]
render = result.plot()

RESULT = {"boxes": result.boxes, "masks": result.masks, "render": Image.fromarray(render) if not isinstance(render, Image.Image) else render}
