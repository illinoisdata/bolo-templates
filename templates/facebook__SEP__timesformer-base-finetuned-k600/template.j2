{% set repo_id = repo_id | default("facebook/timesformer-base-finetuned-k600") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("video-classification") %}
{% set model = model | default(repo_id) %}
{% set video_path = video_path | default("/u/yunqili4/projects/ML-code-generation/data/video.avi") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
video_path = {{ video_path | tojson }}

from transformers import AutoImageProcessor, pipeline

image_processor = AutoImageProcessor.from_pretrained(model)
pipe = pipeline(
    task=task,
    model=model,
    device=device,
    image_processor=image_processor,
)
pipe.video_processor = None
pipe.image_processor = image_processor

inference_input = video_path
pipe_outputs = pipe(inference_input)
RESULT = {"predictions": pipe_outputs}
