{% set repo_id = repo_id | default("YuxinJiang/sup-promcse-roberta-large") %}
{% set device = device | default("cuda:0") %}
{% set sentence = sentence | default('A woman is reading a book.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence = "{{ sentence }}"

import os
import json
import torch
import numpy as np
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

with open(config_path, "r") as f:
    config = json.load(f)

# Prepare tokenizer/model from local downloaded files
local_dir = os.path.dirname(model_path)
tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=True)
model = AutoModel.from_pretrained(local_dir)
model.to(device)
model.eval()

inputs = tokenizer(sentence, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs, return_dict=True)
    last_hidden = outputs.last_hidden_state
    pooled = last_hidden[:, 0]
    embedding = pooled.detach().cpu().numpy()

RESULT = {"embedding": embedding}
