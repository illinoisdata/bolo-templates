{% set device = "cuda:0" %}
{% set repo_id = "YuxinJiang/sup-promcse-roberta-large" %}
{% set sentence_inputs = ["A woman is reading a book.", "A man is playing a guitar."] %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence_inputs = {{ sentence_inputs }}

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

tokenized_inputs = tokenizer(
    sentence_inputs,
    padding=True,
    truncation=True,
    return_tensors="pt"
)
tokenized_inputs = {key: tensor.to(device) for key, tensor in tokenized_inputs.items()}

with torch.no_grad():
    outputs = model(**tokenized_inputs)

sequence_output = outputs.last_hidden_state
pooled_output = getattr(outputs, "pooler_output", None)
if pooled_output is None:
    pooled_output = sequence_output[:, 0, :]

embeddings = pooled_output.detach().cpu()

RESULT = {"embeddings": embeddings.tolist()}
