{% set input_text = input_text | default("Türkiye Cumhuriyetine kısa bir giriş metni.") %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/dbmdz__SEP__bert-base-turkish-128k-cased") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
output_dir = "{{ output_dir }}"

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input
encoded_input = tokenizer(input_text, return_tensors="pt")
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

# Run inference
with torch.no_grad():
    outputs = model(**encoded_input)

# Post-process outputs
cls_embedding_vector = outputs.last_hidden_state[:, 0, :]
cls_embedding = cls_embedding_vector[0].detach().cpu().tolist()

RESULT = {"cls_embedding": cls_embedding}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "cls_embedding.json")
    with open(output_path, "w", encoding="utf-8") as result_file:
        json.dump(RESULT["cls_embedding"], result_file, ensure_ascii=False)