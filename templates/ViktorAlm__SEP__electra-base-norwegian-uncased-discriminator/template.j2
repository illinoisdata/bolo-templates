{% set repo_id = repo_id | default("ViktorAlm/electra-base-norwegian-uncased-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Dette er en enkel testsetning for norsk språkmodell.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForPreTraining, ElectraConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = ElectraConfig.from_json_file(config_path)
model = AutoModelForPreTraining.from_config(config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    vocab_file=vocab_path,
    tokenizer_config_file=tokenizer_config_path,
    special_tokens_map_file=special_tokens_map_path,
    use_fast=False,
)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.sigmoid(logits)
RESULT = {"logits": logits.detach().cpu().tolist(), "probabilities": probabilities.detach().cpu().tolist()}
