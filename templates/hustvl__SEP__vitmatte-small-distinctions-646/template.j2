{% set trimap = trimap | default('/u/yunqili4/projects/ML-code-generation/data/image2.jpeg') %}
{% set repo_id = repo_id | default("hustvl/vitmatte-small-distinctions-646") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
trimap = "{{ trimap }}"

import os
import torch
import requests
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import VitMatteImageProcessor, VitMatteForImageMatting

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

processor = VitMatteImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = VitMatteForImageMatting.from_pretrained(os.path.dirname(config_path), torch_dtype=torch.float32)
model.to(device)
model.eval()

if image.startswith("http://") or image.startswith("https://"):
    image_obj = Image.open(BytesIO(requests.get(image, timeout=30).content)).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

if trimap.startswith("http://") or trimap.startswith("https://"):
    trimap_obj = Image.open(BytesIO(requests.get(trimap, timeout=30).content)).convert("L")
else:
    trimap_obj = Image.open(trimap).convert("L")

size = image_obj.size
trimap_obj = trimap_obj.resize(size, Image.NEAREST)

inputs = processor(images=image_obj, trimaps=trimap_obj, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

output = outputs.alphas
if isinstance(output, torch.Tensor):
    output = output.detach().cpu().numpy()

RESULT = {"alpha_matte": output}
