{% set repo_id = repo_id | default("jpwahle/t5-large-word-sense-disambiguation") %}
{% set device = device | default("cuda:0") %}
{% set text_prompt = text_prompt | default('question: which description describes the word "java" best in the following context? descriptions: [ "A drink consisting of an infusion of ground coffee beans" , "a platform-independent programming language" , "an island in Indonesia to the south of Borneo" ] context: I like to drink \'java\' in the morning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = """{{ text_prompt }}"""

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text_prompt, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs)
generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
if len(generated_texts) == 1:
    generated_text = generated_texts[0]
else:
    generated_text = generated_texts

RESULT = {"generated_text": generated_text}
