{% set repo_id = repo_id | default("facebook/fasttext-ja-vectors") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('apple') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
from huggingface_hub import hf_hub_download
import fasttext
import numpy as np

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
model = fasttext.load_model(model_path)

vector = model.get_word_vector(text)
neighbors = model.get_nearest_neighbors(text, k=5)

RESULT = {
    "vector": vector.tolist(),
    "nearest_neighbors": [(float(score), word) for score, word in neighbors],
}
