{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__dpr-ctx_encoder-multiset-base" %}
{% set input_text = "Hello, is my dog cute ?" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = "{{ input_text }}"

import json
import os

import torch
from transformers import DPRContextEncoder, DPRContextEncoderTokenizer

tokenizer = DPRContextEncoderTokenizer.from_pretrained(repo_id)
model = DPRContextEncoder.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=512)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}
outputs = model(**encoded_inputs)
context_embeddings = outputs.pooler_output
context_embeddings = context_embeddings.detach().cpu()

RESULT = {"embeddings": context_embeddings.tolist()}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    embeddings_path = os.path.join(output_dir, "embeddings.json")
    with open(embeddings_path, "w") as outfile:
        json.dump(RESULT["embeddings"], outfile)