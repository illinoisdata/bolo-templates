{% set repo_id = "cointegrated/SONAR_200_text_encoder" %}
{% set device = "cuda:0" %}
{% set input_texts = ["This is a test sentence.", "Multilingual sentence embedding example."] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/cointegrated__SEP__SONAR_200_text_encoder" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_texts = {{ input_texts }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    input_texts,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
encoded_inputs = {
    key: value.to(device)
    for key, value in encoded_inputs.items()
    if not key.startswith("decoder")
}

with torch.no_grad():
    encoder_outputs = model.encoder(**encoded_inputs)

attention_mask = encoded_inputs["attention_mask"]
hidden_states = encoder_outputs.last_hidden_state
mask_expanded = attention_mask.unsqueeze(-1).type_as(hidden_states)
sum_hidden = (hidden_states * mask_expanded).sum(dim=1)
mask_sum = mask_expanded.sum(dim=1).clamp(min=1e-9)
sentence_embeddings = sum_hidden / mask_sum

sentence_embeddings = sentence_embeddings.cpu()

RESULT = {"sentence_embeddings": sentence_embeddings}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    torch.save(RESULT["sentence_embeddings"], output_path / "sentence_embeddings.pt")