{% set text = text | default('Hello world') %}
{% set repo_id = repo_id | default("cointegrated/SONAR_200_text_encoder") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spm_file = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

model = AutoModel.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model.get_encoder()(**inputs)

embeddings = outputs.last_hidden_state.detach().cpu()
attention_mask = inputs["attention_mask"].detach().cpu()

RESULT = {"embeddings": embeddings, "attention_mask": attention_mask}
