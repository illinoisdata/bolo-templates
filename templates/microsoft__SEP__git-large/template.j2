{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}

import os
from pathlib import Path
import torch
from transformers import AutoProcessor, AutoModelForCausalLM
from PIL import Image
import requests
from io import BytesIO

processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id).to(device)

# Load image from URL or local path
if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(
    pixel_values=inputs["pixel_values"],
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
    eos_token_id=processor.tokenizer.eos_token_id,
)

captions = processor.tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"captions": captions}
