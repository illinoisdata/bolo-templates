{% set repo_id = repo_id | default("squeezebert/squeezebert-uncased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM


tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None and (inputs["input_ids"] == mask_token_id).any():
    mask_index = (inputs["input_ids"][0] == mask_token_id).nonzero(as_tuple=True)[0][0].item()
else:
    mask_index = 0

mask_logits = logits[0, mask_index]
topk = torch.topk(mask_logits, k=5)
top_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
top_scores = topk.values.tolist()

RESULT = {"top_tokens": top_tokens, "top_scores": top_scores, "logits_shape": list(logits.shape)}
