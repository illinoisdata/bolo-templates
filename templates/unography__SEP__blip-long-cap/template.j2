{% set repo_id = repo_id | default("unography/blip-long-cap") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set max_length = max_length | default(250) %}
{% set num_beams = num_beams | default(3) %}
{% set repetition_penalty = repetition_penalty | default(2.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}

import os
import requests
import torch
from PIL import Image
from transformers import BlipProcessor, BlipForConditionalGeneration
from huggingface_hub import hf_hub_download

processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
# Download required tokenizer/config files via representative artifacts; Hugging Face will reuse cache for from_pretrained.
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    raw_image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    raw_image = Image.open(image_path).convert("RGB")

processor = BlipProcessor.from_pretrained(repo_id)
model = BlipForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32).to(device)
model.eval()

inputs = processor(raw_image, return_tensors="pt").to(device)
with torch.no_grad():
    output_ids = model.generate(
        pixel_values=inputs.pixel_values,
        max_length=max_length,
        num_beams=num_beams,
        repetition_penalty=repetition_penalty,
    )
caption = processor.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"caption": caption}
