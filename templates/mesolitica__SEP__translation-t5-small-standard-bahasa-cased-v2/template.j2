{% set repo_id = repo_id | default("mesolitica/translation-t5-small-standard-bahasa-cased-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hai, ada yang bisa saya bantu?") %}
{% set max_new_tokens = max_new_tokens | default(100) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
generation_config_file = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = T5Tokenizer.from_pretrained(repo_id, use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

input_text = f"terjemah ke Melayu: {text}"
input_ids = tokenizer.encode(input_text, return_tensors="pt").to(device)
outputs = model.generate(input_ids, max_new_tokens=max_new_tokens)
output_text = tokenizer.decode(outputs[0], skip_special_tokens=True, spaces_between_special_tokens=False)

RESULT = {"translation": output_text}
