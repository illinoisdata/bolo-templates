{% set repo_id = repo_id | default("smp-hub/efficientnet-b4.imagenet") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
import torch
import torch.nn.functional as F
from PIL import Image
from torchvision import transforms
from huggingface_hub import hf_hub_download
import timm

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    cfg = json.load(f)

if str(image_path).startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

mean = cfg.get("mean", [0.485, 0.456, 0.406])
std = cfg.get("std", [0.229, 0.224, 0.225])
input_size = 380

preprocess = transforms.Compose([
    transforms.Resize((input_size, input_size)),
    transforms.ToTensor(),
    transforms.Normalize(mean=mean, std=std),
])

x = preprocess(image).unsqueeze(0).to(device)
model = timm.create_model("efficientnet_b4", pretrained=False, num_classes=1000)
from safetensors.torch import load_file
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

with torch.no_grad():
    logits = model(x)
    probs = F.softmax(logits, dim=-1)
    values, indices = torch.topk(probs, k=topk, dim=-1)

RESULT = {
    "logits": logits.squeeze(0).detach().cpu(),
    "probabilities": probs.squeeze(0).detach().cpu(),
    "topk_indices": indices.squeeze(0).detach().cpu(),
    "topk_scores": values.squeeze(0).detach().cpu(),
}
