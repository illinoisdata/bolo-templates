{% set repo_id = repo_id | default("vinai/vinai-translate-en2vi-v2") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import MBartForConditionalGeneration, MBart50TokenizerFast
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
tokenizer_path = hf_hub_download(repo_id=repo_id, filename='sentencepiece.bpe.model')

model = MBartForConditionalGeneration.from_pretrained(config_path)
state_dict = torch.load(weights_path, map_location='cpu', weights_only=False)
model.load_state_dict(state_dict)
tokenizer = MBart50TokenizerFast(vocab_file=tokenizer_path, src_lang='en_XX')

model.to(device)
model.eval()
inputs = tokenizer(input_text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=5, max_length=128, forced_bos_token_id=tokenizer.lang_code_to_id['vi_VN'])
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
