repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
import requests
from PIL import Image
from transformers import BertTokenizer, ViTImageProcessor, VisionEncoderDecoderModel, GenerationConfig
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB") if str(image_path).startswith(("http://", "https://")) else Image.open(image_path).convert("RGB")

model = VisionEncoderDecoderModel.from_pretrained(repo_id, torch_dtype=torch.float32).to(device).eval()
tokenizer = BertTokenizer.from_pretrained(repo_id)
image_processor = ViTImageProcessor.from_pretrained(repo_id)

pixel_values = image_processor(images=image, return_tensors="pt").pixel_values.to(device)

generation_args = {
    "bos_token_id": model.config.decoder.bos_token_id,
    "eos_token_id": model.config.decoder.eos_token_id,
    "pad_token_id": model.config.pad_token_id,
    "num_return_sequences": 1,
    "max_length": max_length,
    "use_cache": True,
    "num_beams": num_beams,
    "decoder_start_token_id": tokenizer.cls_token_id,
}

with torch.no_grad():
    generated_ids = model.generate(pixel_values, generation_config=GenerationConfig(**generation_args))

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": output_text}
