repo_id = "{{ repo_id }}"
device = "{{ device }}"
video_path = "{{ video_path }}"
question = "{{ question }}"
max_new_tokens = {{ max_new_tokens }}

import os
import av
import numpy as np
import torch
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download
from transformers import LlavaNextVideoProcessor, LlavaNextVideoForConditionalGeneration

processor = LlavaNextVideoProcessor.from_pretrained(repo_id)
model = LlavaNextVideoForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float16 if torch.cuda.is_available() and device.startswith("cuda") else torch.float32,
    low_cpu_mem_usage=True,
).to(device)
model.eval()

def load_video_frames(path, num_frames=8):
    if urlparse(path).scheme in ("http", "https"):
        import tempfile
        import requests
        suffix = os.path.splitext(urlparse(path).path)[1] or ".mp4"
        with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as f:
            f.write(requests.get(path, stream=True).content)
            local_path = f.name
    else:
        local_path = path
    container = av.open(local_path)
    stream = container.streams.video[0]
    total_frames = stream.frames
    if total_frames and total_frames > 0:
        indices = np.linspace(0, total_frames - 1, num_frames).astype(int)
    else:
        indices = np.arange(num_frames)
    frames = []
    wanted = set(indices.tolist())
    container.seek(0)
    for i, frame in enumerate(container.decode(video=0)):
        if i > indices[-1]:
            break
        if i in wanted:
            frames.append(frame.to_ndarray(format="rgb24"))
    return np.stack(frames)

conversation = [
    {
        "role": "user",
        "content": [
            {"type": "text", "text": question},
            {"type": "video"},
        ],
    }
]
prompt = processor.apply_chat_template(conversation, add_generation_prompt=True)
video = load_video_frames(video_path, num_frames=8)
inputs = processor(text=prompt, videos=video, return_tensors="pt", padding=True)
inputs = {k: v.to(device) if torch.is_tensor(v) else v for k, v in inputs.items()}
with torch.inference_mode():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens, do_sample=False)
output_text = processor.batch_decode(output_ids, skip_special_tokens=True, clean_up_tokenization_spaces=False)[0]

RESULT = {"generated_text": output_text}
