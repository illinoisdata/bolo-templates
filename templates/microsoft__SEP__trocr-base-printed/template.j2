{% set repo_id = "microsoft/trocr-base-printed" %}
{% set device = "cuda:0" %}
{% set document_image_path = "/u/yli77/projects/ML-code-generation/data/doc.jpeg" %}
{% set generate_max_length = 256 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
document_image_path = "{{ document_image_path }}"
generate_max_length = {{ generate_max_length }}

from pathlib import Path
from urllib.parse import urlparse

import requests
from PIL import Image
import torch
from transformers import TrOCRProcessor, VisionEncoderDecoderModel

def load_image(image_source: str) -> Image.Image:
    parsed = urlparse(image_source)
    if parsed.scheme in ("http", "https"):
        response = requests.get(image_source, stream=True)
        response.raise_for_status()
        return Image.open(response.raw).convert("RGB")
    return Image.open(image_source).convert("RGB")

processor = TrOCRProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model.to(device)
model.eval()

image = load_image(document_image_path)
inputs = processor(images=image, return_tensors="pt")
pixel_values = inputs.pixel_values.to(device)

with torch.no_grad():
    generated_ids = model.generate(pixel_values, max_length=generate_max_length)

generated_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
