{% set repo_id = repo_id | default("huawei-noah/TinyBERT_General_6L_768D") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import BertTokenizer, BertModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = BertTokenizer(vocab_file=vocab_path)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

model = BertModel.from_pretrained(repo_id)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state,
    "pooler_output": getattr(outputs, "pooler_output", None),
}
