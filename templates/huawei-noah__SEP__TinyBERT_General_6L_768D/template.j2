{% set text = "Example sentence for TinyBERT inference." %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/huawei-noah__SEP__TinyBERT_General_6L_768D" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import numpy as np
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    text,
    padding="max_length",
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
inputs = {key: tensor.to(device) for key, tensor in inputs.items()}

outputs = model(**inputs)
last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
cls_embedding = last_hidden_state[:, 0, :]

RESULT = {
    "last_hidden_state": last_hidden_state,
    "cls_embedding": cls_embedding,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    np.save(output_path / "last_hidden_state.npy", RESULT["last_hidden_state"])
    np.save(output_path / "cls_embedding.npy", RESULT["cls_embedding"])