{% set input_text = "Hello, world!" %}
{% set source_lang = "en" %}
{% set target_lang = "fr" %}
{% set max_new_tokens = 50 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/stas__SEP__tiny-m2m_100" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}
source_lang = {{ source_lang | tojson }}
target_lang = {{ target_lang | tojson }}
max_new_tokens = {{ max_new_tokens }}
output_dir = {{ output_dir | tojson }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))

tokenizer.src_lang = source_lang

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(model.device) for key, value in inputs.items()}

forced_bos_token_id = tokenizer.get_lang_id(target_lang)
generated_tokens = model.generate(
    **inputs,
    forced_bos_token_id=forced_bos_token_id,
    max_new_tokens=max_new_tokens,
)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(translation, encoding="utf-8")