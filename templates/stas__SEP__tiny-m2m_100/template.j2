{% set repo_id = repo_id | default("stas/tiny-m2m_100") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('Hello world!') %}
{% set src_lang = src_lang|default('en') %}
{% set tgt_lang = tgt_lang|default('fr') %}
{% set max_new_tokens = max_new_tokens|default(20) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text|tojson }}
src_lang = {{ src_lang|tojson }}
tgt_lang = {{ tgt_lang|tojson }}
max_new_tokens = {{ max_new_tokens }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float16 if torch.cuda.is_available() and str(device).startswith('cuda') else torch.float32,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    local_files_only=True,
    src_lang=src_lang,
    tgt_lang=tgt_lang,
)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

forced_bos_token_id = tokenizer.get_lang_id(tgt_lang) if hasattr(tokenizer, 'get_lang_id') else None
output_ids = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    forced_bos_token_id=forced_bos_token_id,
)
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"output_text": output_text}
