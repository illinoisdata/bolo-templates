{% set repo_id = repo_id | default("hellonlp/promcse-bert-base-zh") %}
{% set device = device | default("cuda:0") %}
{% set sentence_a = sentence_a | default('武汉是一个美丽的城市。') %}
{% set sentence_b = sentence_b | default('你好吗') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence_a = "{{ sentence_a }}"
sentence_b = "{{ sentence_b }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model = AutoModel.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model.to(device)
model.eval()

def encode(text):
    inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
    inputs = {k: v.to(device) for k, v in inputs.items()}
    with torch.no_grad():
        out = model(**inputs).last_hidden_state
    mask = inputs["attention_mask"].unsqueeze(-1).type_as(out)
    emb = (out * mask).sum(dim=1) / mask.sum(dim=1).clamp(min=1e-9)
    return torch.nn.functional.normalize(emb, p=2, dim=1).squeeze(0)

emb_a = encode(sentence_a)
emb_b = encode(sentence_b)
similarity = torch.nn.functional.cosine_similarity(emb_a.unsqueeze(0), emb_b.unsqueeze(0)).item()

RESULT = {"similarity": similarity, "embedding_a": emb_a.detach().cpu().tolist(), "embedding_b": emb_b.detach().cpu().tolist()}
