{% set repo_id = repo_id | default("timm/vit_small_patch8_224.dino") %}
{% set device = device | default("cuda:0") %}
{%- set task = task | default("image-feature-extraction") -%}
{%- set model = model | default(repo_id) -%}
{%- set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

processed_input = Image.open(input_image).convert("RGB")

raw_output = pipe(processed_input)

RESULT = {"features": raw_output}
