{% set repo_id = repo_id | default("allenai/PRIMERA") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Multi-document summarization: document 1 discusses the background and motivation of a research problem. Document 2 provides the main methodology and experimental setup. Document 3 reports results, limitations, and future work. Summarize the key points across all documents.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from transformers import AutoTokenizer, LEDForConditionalGeneration
import torch


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = LEDForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=4096,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=142,
        min_length=56,
        num_beams=4,
        length_penalty=2.0,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )

summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
