{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("allenai/PRIMERA") %}
{% set text_input = text_input | default("Multi-document summarization requires the model to condense diverse viewpoints into one coherent narrative. Document one introduces the research setting and the objective of combining multiple sources. Document two details experimental results that extend those findings. The summary should capture both the high-level motivation and the key outcomes.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    truncation=True,
    max_length=4096,
    return_tensors="pt",
)
encoded_inputs = encoded_inputs.to(device)

generation_kwargs = {}
if model.config.task_specific_params:
    generation_kwargs = dict(model.config.task_specific_params.get("summarization", {}))

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        **generation_kwargs,
    )

decoded_summaries = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
summary_text = decoded_summaries[0]

RESULT = {"summary": summary_text}
