{% set repo_id = "declare-lab/nora-long" %}
{% set device = "cuda:0" %}
{% set instruction = 'Pick up the red block and place it on the table.' %}
{% set image_path = '/u/yli77/projects/ML-code-generation/data/image1.jpeg' %}
{% set max_new_tokens = 50 %}

repo_id = '{{ repo_id }}'
device = '{{ device }}'
instruction = '{{ instruction }}'
image_path = '{{ image_path }}'
max_new_tokens = {{ max_new_tokens }}

import os
import json
import re
import requests
from io import BytesIO
from PIL import Image
import torch
from transformers import AutoProcessor, Qwen2_5_VLForConditionalGeneration

processor = AutoProcessor.from_pretrained(repo_id)
model = Qwen2_5_VLForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.bfloat16)
model = model.to(device)

# Preprocess input
if image_path.startswith('http'):
    image = Image.open(BytesIO(requests.get(image_path).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

prompt = (
    f'<|image_pad|> {instruction}\n'
    'Normalized robot action (x y z roll pitch yaw gripper) as seven floats separated by spaces: '
)
inputs = processor(text=prompt, images=[image], return_tensors='pt').to(device)

# Run inference
outputs = model.generate(**inputs, max_new_tokens=max_new_tokens)

# Post-process & build RESULT
result_text = processor.decode(outputs[0], skip_special_tokens=True)
numbers = re.findall(r'-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?', result_text)
actions = [float(number) for number in numbers]
RESULT = {'actions': actions}
