{% set repo_id = "Helsinki-NLP/opus-mt-ca-de" %}
{% set device = "cuda:0" %}
{% set source_text = "Bon dia! Avui és un bon dia per aprendre alguna cosa nova." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
encoded_inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True, max_length=max_length)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams, early_stopping=True)
translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0].strip()
RESULT = {"translation": translation}
