{% set repo_id = repo_id | default("rhasspy/faster-whisper-tiny-int8") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"

import os
import urllib.parse
import urllib.request
from pathlib import Path

import numpy as np
import soundfile as sf
import torch
import whisper
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if audio_path.startswith(("http://", "https://")):
    parsed = urllib.parse.urlparse(audio_path)
    suffix = Path(parsed.path).suffix or ".wav"
    local_audio_path = Path("/tmp") / f"input_audio{suffix}"
    urllib.request.urlretrieve(audio_path, local_audio_path)
    audio_path = str(local_audio_path)

model = whisper.load_model("tiny", device=device)
audio = whisper.load_audio(audio_path)
audio = whisper.pad_or_trim(audio)
mel = whisper.log_mel_spectrogram(audio).to(model.device)
options = whisper.DecodingOptions(language=language, task=task)
result = whisper.decode(model, mel, options)
transcript = result.text.strip()

RESULT = {
    "text": transcript,
    "language": language,
}
