{% set repo_id = repo_id | default("Unbabel/TowerBase-7B-v0.1") %}
{% set device = device | default("cuda:0") %}
{% set max_new_tokens = max_new_tokens | default(20) %}
{% set prompt = prompt | default("English: My name is TowerBase.\nPortuguese:") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}
prompt = {{ prompt | tojson }}

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
    trust_remote_code=False,
)

model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    trust_remote_code=False,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens, do_sample=False)

generated_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
