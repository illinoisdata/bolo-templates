{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Unbabel/TowerBase-7B-v0.1") %}
{% set text_prompt = text_prompt | default("English: My name is TowerBase.\nPortuguese:") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set temperature = temperature | default(0.2) %}
{% set top_p = top_p | default(0.95) %}
{% set result_file_name = result_file_name | default("generated_text.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = """{{ text_prompt }}"""
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
result_file_name = "{{ result_file_name }}"

from pathlib import Path
from transformers import AutoModelForCausalLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(text_prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    top_p=top_p,
)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
