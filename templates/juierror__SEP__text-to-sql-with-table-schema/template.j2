{% set repo_id = repo_id | default("juierror/text-to-sql-with-table-schema") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('get people name with age equal 25') %}
{% set table = table | default(['id', 'name', 'age']) %}
{% set max_length = max_length | default(700) %}
{% set num_beams = num_beams | default(10) %}
{% set top_k = top_k | default(10) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
table = {{ table | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
top_k = {{ top_k }}

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)

inputs = f"question: {question} table: {','.join(table)}"
input_ids = tokenizer(inputs, max_length=max_length, truncation=True, return_tensors="pt").input_ids.to(device)
model = model.to(device)
model.eval()

with torch.no_grad():
    outputs = model.generate(input_ids=input_ids, num_beams=num_beams, top_k=top_k, max_length=max_length)
    result = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"output": result}
