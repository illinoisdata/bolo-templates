{% set repo_id = repo_id | default("juierror/text-to-sql-with-table-schema") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("get people name with age equal 25") %}
{% set table_columns = table_columns | default(["id", "name", "age"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
table_columns = {{ table_columns }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

table_prefix = "table:"
question_prefix = "question:"
joined_table = ",".join(table_columns)
input_text = f"{question_prefix} {question} {table_prefix} {joined_table}"
encoded_inputs = tokenizer(input_text, max_length=700, truncation=True, return_tensors="pt")
input_ids = encoded_inputs.input_ids.to(device)
attention_mask = encoded_inputs.attention_mask.to(device)

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    num_beams=10,
    top_k=10,
    max_length=700,
)

sql = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"sql": sql}
