{% set device = "cuda:0" %}
{% set repo_id = "retrieva-jp/t5-base-long" %}
{% set prompt_text = "Translate English to Japanese: The quick brown fox jumps over the lazy dog." %}
{% set max_new_tokens = 128 %}
{% set num_beams = 4 %}
{% set temperature = 1.0 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt_text = """{{ prompt_text }}"""
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
temperature = {{ temperature }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    prompt_text,
    return_tensors="pt",
    truncation=True,
    padding=True,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
    temperature=temperature,
)

generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"generated_text": generated_texts[0]}
