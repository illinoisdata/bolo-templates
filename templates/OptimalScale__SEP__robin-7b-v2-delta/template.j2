{% set repo_id = repo_id | default("OptimalScale/robin-7b-v2-delta") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

repo_id = {{ repo_id | tojson }}
model = repo_id
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import LlamaTokenizer, pipeline

tokenizer = LlamaTokenizer.from_pretrained(
    model,
    use_fast=False,
    clean_up_tokenization_spaces=False,
    bos_token="</s>",
    eos_token="</s>",
    unk_token="<unk>",
    pad_token="</s>",
)

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt)
