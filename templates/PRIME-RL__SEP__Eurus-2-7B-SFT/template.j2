{% set repo_id = repo_id | default("PRIME-RL/Eurus-2-7B-SFT") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("which number is larger? 9.11 or 9.9?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

os.environ["TOKENIZERS_PARALLELISM"] = "false"
os.environ["NCCL_IGNORE_DISABLED_P2P"] = "1"

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
model_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")

model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    trust_remote_code=True,
    device_map=None,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)

prompt = question + "\n\nPresent the answer in LaTex format: \\boxed{Your answer}"
messages = [{"role": "user", "content": prompt}]
input_text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=256,
        do_sample=False,
        temperature=0.0,
        top_p=1.0,
    )

output_text = tokenizer.decode(generated[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True)
RESULT = {"output": output_text}
