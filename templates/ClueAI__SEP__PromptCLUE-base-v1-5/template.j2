{% set repo_id = repo_id | default("ClueAI/PromptCLUE-base-v1-5") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('翻译成中文：\nThis is a dialogue robot that can talk to people.\n答案：') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="spiece.vocab")
model_dir = os.path.dirname(weights_path)

model = T5ForConditionalGeneration.from_pretrained(model_dir, local_files_only=True)
tokenizer = T5Tokenizer(vocab_file=vocab_path)
model.to(device)
model.eval()

inputs = tokenizer(text=[text.replace("\n", "_")], truncation=True, padding=True, max_length=768, return_tensors="pt").to(device)
with torch.no_grad():
    output_ids = model.generate(**inputs, return_dict_in_generate=True, output_scores=False, max_length=128, num_beams=4, length_penalty=0.6)["sequences"]
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0].replace("_", "\n")

RESULT = {"output": output_text}
