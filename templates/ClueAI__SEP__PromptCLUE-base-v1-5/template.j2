{% set device = "cuda:0" %}
{% set repo_id = "ClueAI/PromptCLUE-base-v1-5" %}
{% set text_input = "翻译成中文：\\nThis is a dialogue robot that can talk to people.\\n答案：" %}
{% set sample_generation = False %}
{% set max_input_length = 768 %}
{% set max_output_length = 128 %}
{% set num_beams = 4 %}
{% set top_p = 0.8 %}
{% set length_penalty = 0.6 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = {{ text_input | tojson }}
sample_generation = {{ "True" if sample_generation else "False" }}
max_input_length = {{ max_input_length }}
max_output_length = {{ max_output_length }}
num_beams = {{ num_beams }}
top_p = {{ top_p }}
length_penalty = {{ length_penalty }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, use_tiktoken=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

preprocessed_prompt = text_input.replace("\n", " ").strip()
encoding = tokenizer(
    preprocessed_prompt,
    truncation=True,
    padding="longest",
    max_length=max_input_length,
    return_tensors="pt",
)
encoding = {key: tensor.to(device) for key, tensor in encoding.items()}

generate_kwargs = {
    "max_length": max_output_length,
    "return_dict_in_generate": True,
    "output_scores": False,
    "early_stopping": True,
}
if sample_generation:
    generate_kwargs.update({"do_sample": True, "top_p": top_p})
else:
    generate_kwargs.update({"num_beams": num_beams, "length_penalty": length_penalty})

with torch.inference_mode():
    generation_output = model.generate(**encoding, **generate_kwargs)

generated_sequences = generation_output["sequences"]
decoded_sequences = tokenizer.batch_decode(generated_sequences, skip_special_tokens=True)
generated_text = decoded_sequences[0].strip()

RESULT = {"generated_text": generated_text}
