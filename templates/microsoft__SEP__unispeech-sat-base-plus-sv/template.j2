{% set repo_id = repo_id | default("microsoft/unispeech-sat-base-plus-sv") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set threshold = threshold | default(0.89) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
threshold = {{ threshold }}

import os
import numpy as np
import torch
import soundfile as sf
from transformers import Wav2Vec2FeatureExtractor, UniSpeechSatForXVector
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(os.path.dirname(preprocessor_path))
model = UniSpeechSatForXVector.from_pretrained(os.path.dirname(weights_path))
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    audio_bytes = requests.get(audio_path).content
    with open("/tmp/input_audio.wav", "wb") as f:
        f.write(audio_bytes)
    load_path = "/tmp/input_audio.wav"
else:
    load_path = audio_path

audio, sr = sf.read(load_path)
if audio.ndim > 1:
    audio = np.mean(audio, axis=1)
if sr != 16000:
    import librosa
    audio = librosa.resample(audio.astype(np.float32), orig_sr=sr, target_sr=16000)
inputs = feature_extractor(audio, sampling_rate=16000, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    embeddings = model(**inputs).embeddings
    embeddings = torch.nn.functional.normalize(embeddings, dim=-1)
    cosine_sim = torch.nn.CosineSimilarity(dim=-1)
    similarity = cosine_sim(embeddings[0], embeddings[0]).item()

RESULT = {"embeddings": embeddings.detach().cpu().numpy(), "similarity": similarity, "threshold": threshold}
