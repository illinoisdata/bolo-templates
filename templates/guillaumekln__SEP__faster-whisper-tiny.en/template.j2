{% set repo_id = repo_id | default("guillaumekln/faster-whisper-tiny.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set beam_size = beam_size | default(1) %}
{% set language = language | default('en') %}
{% set compute_type = compute_type | default('float16') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
beam_size = {{ beam_size }}
language = "{{ language }}"
compute_type = "{{ compute_type }}"

import io
from pathlib import Path

import numpy as np
import requests
import soundfile as sf
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_file = hf_hub_download(repo_id=repo_id, filename="model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    response = requests.get(audio_path, timeout=30)
    response.raise_for_status()
    audio_array, sample_rate = sf.read(io.BytesIO(response.content), dtype="float32")
else:
    audio_array, sample_rate = sf.read(audio_path, dtype="float32")

if audio_array.ndim > 1:
    audio_array = np.mean(audio_array, axis=1)

model_dir = str(Path(model_file).parent)
model = WhisperModel(model_dir, device="cpu", compute_type="int8")
segments, info = model.transcribe(audio_array, language=language, beam_size=beam_size)
text = "".join(segment.text for segment in segments).strip()

RESULT = {"text": text, "language": info.language, "language_probability": info.language_probability}
