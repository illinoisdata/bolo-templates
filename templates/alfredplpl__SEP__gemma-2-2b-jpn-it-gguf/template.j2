{% set repo_id = repo_id | default("alfredplpl/gemma-2-2b-jpn-it-gguf") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-2-2b-jpn-it-Q4_K_M.gguf') %}
{% set prompt = prompt | default('日本語で自己紹介してください。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(model_path=model_path, n_ctx=2048, n_threads=max(1, os.cpu_count() or 1), n_gpu_layers=-1 if str(device).startswith('cuda') else 0, verbose=False)
output = llm(prompt, max_tokens=128, temperature=0.0, top_p=1.0)
text = output['choices'][0]['text']

RESULT = {"text": text}
