{% set repo_id = repo_id | default("google/bert_uncased_L-6_H-256_A-4") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, BertModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = BertModel.from_pretrained(model_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "last_hidden_state": outputs.last_hidden_state,
    "pooler_output": outputs.pooler_output,
}
