{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("facebook/mms-tts-rus") %}
{% set text = text | default("Привет, это пример текста для синтеза речи на русском языке.") %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text = {{ text | tojson }}

from pathlib import Path

import torch
import scipy.io.wavfile
from transformers import VitsModel, AutoTokenizer

torch_device = torch.device(device)
model = VitsModel.from_pretrained(repo_id).to(torch_device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenized_inputs = tokenizer(text, return_tensors="pt")
tokenized_inputs = {key: value.to(torch_device) for key, value in tokenized_inputs.items()}

with torch.no_grad():
    waveform_tensor = model(**tokenized_inputs).waveform

waveform = waveform_tensor.detach().cpu().squeeze(0).numpy()

RESULT = {
    "waveform": waveform,
    "sampling_rate": model.config.sampling_rate,
}
