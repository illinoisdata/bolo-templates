{% set repo_id = repo_id | default("peft-internal-testing/tiny-T5ForConditionalGeneration") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('translate English to German: The house is wonderful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=16, use_cache=False)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
RESULT = {"output": decoded[0]}
