repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
import os
from pathlib import Path

import torch
import torch.nn.functional as F
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from torchvision import transforms
from torchvision.transforms import InterpolationMode

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

class RenderFormerModel(torch.nn.Module):
    def __init__(self, cfg):
        super().__init__()
        self.cfg = cfg
        self.backbone = torch.nn.Sequential(
            torch.nn.Conv2d(3, 32, kernel_size=3, padding=1),
            torch.nn.ReLU(inplace=True),
            torch.nn.Conv2d(32, 32, kernel_size=3, padding=1),
            torch.nn.ReLU(inplace=True),
            torch.nn.Conv2d(32, 3, kernel_size=1),
        )

    def forward(self, x):
        return torch.sigmoid(self.backbone(x))

model = RenderFormerModel(config)
state_dict = load_file(weights_path)
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

if image_path.startswith("http://") or image_path.startswith("https://"):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

input_size = 256
preprocess = transforms.Compose([
    transforms.Resize((input_size, input_size), interpolation=InterpolationMode.BICUBIC),
    transforms.ToTensor(),
])

x = preprocess(image).unsqueeze(0).to(device)
with torch.no_grad():
    y = model(x)

output_image = transforms.ToPILImage()(y.squeeze(0).cpu())
RESULT = {"output_image": output_image}
