{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-ro") %}
{% set device = device | default("cuda:0") %}
{% set source_sentences = source_sentences | default([">>ron<< A bad writer's prose is full of hackneyed phrases.", ">>ron<< Zero is a special number."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_sentences = {{ source_sentences | tojson }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    source_sentences,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**encoded_inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
