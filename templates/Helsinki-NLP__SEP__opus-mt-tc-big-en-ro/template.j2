{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-en-ro" %}
{% set device = "cuda:0" %}
{% set source_sentences = [">>ron<< A bad writer's prose is full of hackneyed phrases.", ">>ron<< Zero is a special number."] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-tc-big-en-ro" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_sentences = {{ source_sentences | tojson }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    source_sentences,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**encoded_inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translations.txt").write_text(
        "\n".join(RESULT["translations"]),
        encoding="utf-8",
    )