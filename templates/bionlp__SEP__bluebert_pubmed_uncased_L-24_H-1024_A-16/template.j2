{% set repo_id = repo_id | default("bionlp/bluebert_pubmed_uncased_L-24_H-1024_A-16") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('BlueBERT is a PubMed pre-trained biomedical language model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import re
import torch
from transformers import BertTokenizer, BertForMaskedLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = __import__("os").path.dirname(weights_path)

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=True)
model = BertForMaskedLM.from_pretrained(model_dir)
model.to(device)
model.eval()

value = text.lower()
value = re.sub(r'[\r\n]+', ' ', value)
value = re.sub(r'[^\x00-\x7F]+', ' ', value)

inputs = tokenizer(value, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    mask_token_id = tokenizer.mask_token_id
    input_ids = inputs["input_ids"]
    mask_positions = (input_ids == mask_token_id).nonzero(as_tuple=False)
    if mask_positions.numel() > 0:
        pos = mask_positions[0]
        batch_idx, seq_idx = int(pos[0]), int(pos[1])
        pred_id = int(torch.argmax(logits[batch_idx, seq_idx]).item())
        predicted_token = tokenizer.decode([pred_id]).strip()
    else:
        pred_id = int(torch.argmax(logits[0, 0]).item())
        predicted_token = tokenizer.decode([pred_id]).strip()

RESULT = {"predicted_token": predicted_token, "predicted_token_id": pred_id}
