{% set repo_id = repo_id | default("hirotasoshu/tiny-random-prophetnet") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, how are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, ProphetNetForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="prophetnet.tokenizer")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")


tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = ProphetNetForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_length=16)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
RESULT = {"generated_text": decoded[0]}
