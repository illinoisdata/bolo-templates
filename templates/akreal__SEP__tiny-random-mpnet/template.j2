{% set repo_id = repo_id | default("akreal/tiny-random-mpnet") %}
{% set device = device | default("cuda:0") %}
{% set text_a = text_a | default('The quick brown fox jumps over the lazy dog.') %}
{% set text_b = text_b | default('A tiny random MPNet model for sentence embeddings.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_a = "{{ text_a }}"
text_b = "{{ text_b }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import MPNetConfig, MPNetModel, BertTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

config = MPNetConfig.from_json_file(config_path)
model = MPNetModel(config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

tokenizer = BertTokenizer.from_pretrained(repo_id)
inputs = tokenizer([text_a, text_b], padding=True, truncation=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden_state = outputs.last_hidden_state
    attention_mask = inputs["attention_mask"].unsqueeze(-1)
    masked_sum = (last_hidden_state * attention_mask).sum(dim=1)
    lengths = attention_mask.sum(dim=1).clamp(min=1)
    sentence_embeddings = masked_sum / lengths
    cosine_similarity = torch.nn.functional.cosine_similarity(sentence_embeddings[0], sentence_embeddings[1], dim=0)

RESULT = {
    "sentence_embeddings": sentence_embeddings.detach().cpu().numpy(),
    "cosine_similarity": cosine_similarity.detach().cpu().item(),
}
