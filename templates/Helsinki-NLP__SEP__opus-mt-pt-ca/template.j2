{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-pt-ca") %}
{% set text_input = text_input | default("Olá, como vai você?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
