{% set repo_id = repo_id | default("laion/larger_clap_general") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-audio-classification") %}
{% set audio = audio | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set candidate_labels = candidate_labels | default(["Sound of a dog", "Sound of vacuum cleaner"]) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
audio = {{ audio | tojson }}
