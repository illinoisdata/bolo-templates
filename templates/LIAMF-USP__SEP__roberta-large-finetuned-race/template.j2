{% set device = "cuda:0" %}
{% set repo_id = "LIAMF-USP/roberta-large-finetuned-race" %}
{% set question = "What is the capital of France?" %}
{% set context = "France is a Western European country whose capital city is famous for the Eiffel Tower, art museums, and a rich cultural history." %}
{% set options = ["Berlin", "Madrid", "Paris", "Rome"] %}
{% set max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
options = {{ options | tojson }}
max_length = {{ max_length }}

from pathlib import Path
import json

import torch
import torch.nn.functional as F
from transformers import AutoTokenizer, AutoModelForMultipleChoice

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMultipleChoice.from_pretrained(repo_id).to(device)

choices_encodings = []
for option in options:
    if "_" in question:
        adjusted_question = question.replace("_", option)
    else:
        adjusted_question = f"{question} {option}"
    encoding = tokenizer(
        context,
        adjusted_question,
        add_special_tokens=True,
        max_length=max_length,
        padding="max_length",
        truncation=True,
        return_tensors="pt",
    )
    choices_encodings.append(encoding)

input_ids = torch.cat([choice["input_ids"] for choice in choices_encodings], dim=0)
attention_mask = torch.cat([choice["attention_mask"] for choice in choices_encodings], dim=0)
model_inputs = {
    "input_ids": input_ids.unsqueeze(0).to(device),
    "attention_mask": attention_mask.unsqueeze(0).to(device),
}

with torch.no_grad():
    outputs = model(**model_inputs)
logits = outputs.logits
probabilities = torch.softmax(logits, dim=-1)
logits_cpu = logits.squeeze(0).cpu()
probabilities_cpu = probabilities.squeeze(0).cpu()
predicted_choice_index = int(logits_cpu.argmax(dim=-1).item())
predicted_option = options[predicted_choice_index]

RESULT = {
    "options": options,
    "logits": logits_cpu.tolist(),
    "probabilities": probabilities_cpu.tolist(),
    "predicted_option": predicted_option,
}
