{% set repo_id = repo_id | default("mmnga/stockmark-gpt-neox-japanese-1.4b-gguf") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('stockmark-gpt-neox-japanese-1.4b-q4_0.gguf') %}
{% set prompt = prompt | default('吾輩は猫である。名前は実を言うと、') %}
{% set max_tokens = max_tokens | default(128) %}
{% set top_p = top_p | default(0.9) %}
{% set temp = temp | default(0.7) %}
{% set repeat_penalty = repeat_penalty | default(1.1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
max_tokens = {{ max_tokens }}
top_p = {{ top_p }}
temp = {{ temp }}
repeat_penalty = {{ repeat_penalty }}

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if device.startswith("cuda") else 0,
    verbose=False,
)

result = llm(
    prompt,
    max_tokens=max_tokens,
    top_p=top_p,
    temperature=temp,
    repeat_penalty=repeat_penalty,
)

output_text = result["choices"][0]["text"]

RESULT = {"text": output_text}
