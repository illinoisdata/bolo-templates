{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Seznam/retromae-small-cs") %}
{% set text_inputs = text_inputs | default(["Dnes je výborné počasí na procházku po parku.", "Večer si oblíbím dobrý film a uvařím si čaj."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs | tojson }}

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    text_inputs,
    padding=True,
    truncation=True,
    max_length=512,
    return_tensors="pt",
)

encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

cls_embeddings = outputs.last_hidden_state[:, 0].cpu()

RESULT = {"cls_embeddings": cls_embeddings.tolist()}
