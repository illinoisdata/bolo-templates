{% set repo_id = repo_id | default("jedyang97/Fast3R_ViT_Large_512") %}
{% set device = device | default("cuda:0") %}
{% set resize_to = resize_to | default(512) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
resize_to = {{ resize_to }}

import os
from pathlib import Path
import torch
from PIL import Image
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
from safetensors.torch import load_file
state_dict = load_file(model_file, device="cpu")

if image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image = image.resize((resize_to, resize_to), Image.Resampling.BICUBIC)
image_tensor = torch.from_numpy(__import__("numpy").array(image)).permute(2, 0, 1).float() / 255.0
image_tensor = image_tensor.unsqueeze(0).to(device)

output = {"state_dict_keys": list(state_dict.keys())[:20], "image_shape": tuple(image_tensor.shape)}
RESULT = {"output": output}
