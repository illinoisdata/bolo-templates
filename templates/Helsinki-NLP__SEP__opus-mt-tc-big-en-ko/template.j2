{% set source_texts = ["2, 4, 6 etc. are even numbers.", "Yes."] %}
{% set target_lang = "ko" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-tc-big-en-ko" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_texts = {{ source_texts }}
target_lang = "{{ target_lang }}"
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
dtype = torch.float16 if torch_device.type != "cpu" else torch.float32
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=dtype)
model = model.to(torch_device)
model.eval()

prepared_inputs = tokenizer(
    source_texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
prepared_inputs = {key: value.to(torch_device) for key, value in prepared_inputs.items()}

target_lang_token = f">>{target_lang}<<"
target_lang_token_id = tokenizer.get_vocab().get(target_lang_token, model.config.decoder_start_token_id)

with torch.inference_mode():
    generated_tokens = model.generate(
        **prepared_inputs,
        forced_bos_token_id=target_lang_token_id,
    )

decoded_translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": decoded_translations}

if __name__ == "__main__":
    result_root = Path(output_dir)
    result_root.mkdir(parents=True, exist_ok=True)
    translation_path = result_root / "translations.txt"
    with translation_path.open("w", encoding="utf-8") as output_file:
        for translation in RESULT["translations"]:
            output_file.write(f"{translation}\n")