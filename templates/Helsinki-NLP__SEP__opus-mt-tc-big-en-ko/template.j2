{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-ko") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('2, 4, 6 etc. are even numbers.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

_ = (config_path, tokenizer_config_path, special_tokens_map_path, vocab_path, source_spm_path, target_spm_path)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([src_text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=4, max_new_tokens=max_new_tokens)

translated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"translation": translated_text}
