{% set repo_id = repo_id | default("vennify/t5-base-grammar-correction") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("This sentences has has bads grammar.") %}
{% set num_beams = num_beams | default(5) %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set prefix = prefix | default("grammar: ") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
num_beams = {{ num_beams }}
max_new_tokens = {{ max_new_tokens }}
prefix = {{ prefix | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(prefix + input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=num_beams,
        max_new_tokens=max_new_tokens,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
