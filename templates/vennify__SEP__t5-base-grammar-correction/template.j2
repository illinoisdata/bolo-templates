{% set device = "cuda:0" %}
{% set repo_id = "vennify/t5-base-grammar-correction" %}
{% set prompt = "grammar: This sentences has has bads grammar." %}
{% set max_length = 256 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text_prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

corrected_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"corrected_text": corrected_text}
