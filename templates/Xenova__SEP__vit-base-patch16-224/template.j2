{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Xenova/vit-base-patch16-224") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import requests
from PIL import Image
import torch
from transformers import ViTImageProcessor, ViTForImageClassification
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="onnx/model.onnx")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = ViTImageProcessor.from_pretrained(repo_id)
inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

model = ViTForImageClassification.from_pretrained("google/vit-base-patch16-224")
model.to(device)
model.eval()

with torch.no_grad():
    logits = model(**inputs).logits
    probs = torch.softmax(logits, dim=-1)[0]
    score, idx = torch.max(probs, dim=-1)

label = model.config.id2label[int(idx)]
RESULT = {"label": label, "score": float(score), "index": int(idx), "weights_path": weights_path}
