{% set prompt = "Summarize the societal impacts of climate change mentioned in the article." %}
{% set generation_max_length = 256 %}
{% set num_beams = 4 %}
{% set do_sample = False %}
{% set temperature = 1.0 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/allenai__SEP__unifiedqa-v2-t5-3b-1363200" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
generation_max_length = {{ generation_max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=generation_max_length,
    num_beams=num_beams,
    do_sample=do_sample,
    temperature=temperature,
)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
summary = decoded[0].strip()
RESULT = {"summary": summary}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")