{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("allenai/unifiedqa-v2-t5-3b-1363200") %}
{% set prompt = prompt | default("Summarize the societal impacts of climate change mentioned in the article.") %}
{% set generation_max_length = generation_max_length | default(256) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(False) %}
{% set temperature = temperature | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
generation_max_length = {{ generation_max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=generation_max_length,
    num_beams=num_beams,
    do_sample=do_sample,
    temperature=temperature,
)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
summary = decoded[0].strip()
RESULT = {"summary": summary}
