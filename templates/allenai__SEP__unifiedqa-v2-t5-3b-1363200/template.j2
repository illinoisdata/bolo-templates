{% set repo_id = repo_id | default("allenai/unifiedqa-v2-t5-3b-1363200") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float16 if torch.cuda.is_available() and str(device).startswith('cuda') else torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

prompt = question if not context else (context.strip() + "\n\n" + question.strip())
inputs = tokenizer(prompt, return_tensors="pt", truncation=True).to(device)
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        do_sample=False,
    )
output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
