{% set repo_id = repo_id | default("FacebookAI/xlm-clm-ende-1024") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set prompt = prompt | default("The quick brown fox jumps over the lazy dog") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
prompt = {{ prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
input_text = prompt
RESULT = pipe(input_text)
RESULT = {"generated_text": RESULT}
