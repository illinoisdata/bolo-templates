repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_prompt = "{{ input_prompt }}"

import torch
from transformers import pipeline

class ConstantTokenizer:
    def __init__(self, token_id: int = 0, seq_length: int = 1):
        self.pad_token_id = token_id
        self.bos_token_id = token_id
        self.eos_token_id = token_id
        self.model_max_length = seq_length
        self.padding_side = "left"
        self.model_input_names = ["input_ids", "attention_mask"]
        self.vocab_size = seq_length

    def __call__(self, text, return_tensors="pt", **kwargs):
        if isinstance(text, (list, tuple)):
            batch_size = len(text)
        else:
            batch_size = 1
        input_ids = torch.full((batch_size, self.model_max_length), self.bos_token_id, dtype=torch.long)
        attention_mask = torch.ones_like(input_ids)
        return {"input_ids": input_ids, "attention_mask": attention_mask}

    def batch_decode(self, sequences, **kwargs):
        if isinstance(sequences, torch.Tensor):
            batch_size = sequences.shape[0]
        else:
            batch_size = len(sequences)
        return ["" for _ in range(batch_size)]

    def decode(self, token_ids, **kwargs):
        return ""

pipe = pipeline(task=task, model=repo_id, device=device)
pipe.tokenizer = ConstantTokenizer()
pipe.model.config.pad_token_id = 0
pipe.model.config.bos_token_id = 0
pipe.model.config.eos_token_id = 0
pipe.model.generation_config.pad_token_id = 0
pipe.model.generation_config.bos_token_id = 0
pipe.model.generation_config.eos_token_id = 0

RESULT = pipe(input_prompt)
