{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("TurkuNLP/eccobert-base-cased-v1") %}
{% set text = text | default("The quick brown fox jumps over the lazy dog.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import AutoModelForPreTraining, AutoTokenizer
import os
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model(**inputs)
prediction_logits = outputs.prediction_logits.detach().cpu()
token_ids = prediction_logits.argmax(dim=-1)[0].tolist()
predicted_tokens = tokenizer.convert_ids_to_tokens(token_ids)

seq_logits = outputs.seq_relationship_logits.detach().cpu()
next_sentence_probabilities = torch.softmax(seq_logits, dim=-1)[0].tolist()

RESULT = {
    "predicted_tokens": predicted_tokens,
    "next_sentence_probabilities": next_sentence_probabilities,
}
