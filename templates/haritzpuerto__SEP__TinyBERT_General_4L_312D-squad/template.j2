{% set repo_id = repo_id | default("haritzpuerto/TinyBERT_General_4L_312D-squad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the model name?') %}
{% set context = context | default('The model is TinyBERT_General_4L_312D-squad, a question answering model fine-tuned on SQuAD.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Load tokenizer/model
# AutoTokenizer will use the downloaded tokenizer files from the local cache paths.
tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_path.rsplit('/', 1)[0],
    use_fast=True,
)
model = AutoModelForQuestionAnswering.from_pretrained(
    weights_path.rsplit('/', 1)[0],
)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
