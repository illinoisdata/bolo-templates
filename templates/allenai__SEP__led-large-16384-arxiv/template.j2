{% set device = "cuda:0" %}
{% set repo_id = "allenai/led-large-16384-arxiv" %}
{% set text_input = "Solar researchers studied the 155-day periodicity in sunspot data and developed methods to confirm if the peak was a true cycle." %}
{% set max_length = 512 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_input = tokenizer(text_input, return_tensors="pt", truncation=True)
input_ids = encoded_input.input_ids.to(device)
attention_mask = encoded_input.attention_mask.to(device)
global_attention_mask = torch.zeros_like(input_ids)
global_attention_mask[:, 0] = 1

generated_sequences = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    global_attention_mask=global_attention_mask,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

decoded_summaries = tokenizer.batch_decode(generated_sequences, skip_special_tokens=True)

RESULT = {"summaries": decoded_summaries}
