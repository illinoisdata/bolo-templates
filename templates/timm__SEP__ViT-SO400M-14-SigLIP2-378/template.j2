repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
labels_list = {{ labels_list }}

import os
import torch
from PIL import Image
from urllib.parse import urlparse
from urllib.request import urlopen
from open_clip import create_model_from_pretrained, get_tokenizer


def load_image(path_or_url):
    if urlparse(path_or_url).scheme in ("http", "https"):
        return Image.open(urlopen(path_or_url)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")


image = load_image(image_path)
model, preprocess = create_model_from_pretrained(f"hf-hub:{repo_id}")
model = model.to(device)
model.eval()
tokenizer = get_tokenizer(f"hf-hub:{repo_id}")

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer(labels_list, context_length=model.context_length).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor, normalize=True)
    text_features = model.encode_text(text_tokens, normalize=True)
    logit_scale = model.logit_scale.exp()
    logit_bias = getattr(model, "logit_bias", 0.0)
    text_probs = torch.sigmoid(image_features @ text_features.T * logit_scale + logit_bias)

RESULT = {
    "labels": labels_list,
    "text_probs": text_probs[0].detach().cpu().tolist(),
}
