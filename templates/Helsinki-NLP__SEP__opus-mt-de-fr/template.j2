{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-de-fr") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein Test.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import MarianMTModel, AutoTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(text, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=4, max_length=128)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
