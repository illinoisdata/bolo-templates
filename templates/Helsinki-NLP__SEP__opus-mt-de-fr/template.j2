{% set source_text = "Ein kurzer deutscher Satz." %}
{% set num_beams = 4 %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-de-fr" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoding = tokenizer(
    source_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoding = {key: tensor.to(device) for key, tensor in encoding.items()}

generated_tokens = model.generate(
    **encoding,
    num_beams=num_beams,
    max_length=max_length,
)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_output = translations[0] if len(translations) == 1 else translations

RESULT = {"translation": translation_output}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    destination = output_path / "translation.txt"
    serialized = (
        translation_output
        if isinstance(translation_output, str)
        else "\n".join(translation_output)
    )
    with destination.open("w", encoding="utf-8") as writer:
        writer.write(serialized)