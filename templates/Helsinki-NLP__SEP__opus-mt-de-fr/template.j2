{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-de-fr" %}
{% set source_text = "Ein kurzer deutscher Satz." %}
{% set num_beams = 4 %}
{% set max_length = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoding = tokenizer(
    source_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoding = {key: tensor.to(device) for key, tensor in encoding.items()}

generated_tokens = model.generate(
    **encoding,
    num_beams=num_beams,
    max_length=max_length,
)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_output = translations[0] if len(translations) == 1 else translations

RESULT = {"translation": translation_output}
