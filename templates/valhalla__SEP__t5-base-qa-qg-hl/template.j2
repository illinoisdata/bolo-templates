{% set repo_id = repo_id | default("valhalla/t5-base-qa-qg-hl") %}
{% set device = device | default("cuda:0") %}
{% set prompt_qg = prompt_qg | default('generate question: <hl> 42 <hl> is the answer to life, the universe and everything. </s>') %}
{% set prompt_qa = prompt_qa | default('question: What is 42 context: 42 is the answer to life, the universe and everything. </s>') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt_qg = "{{ prompt_qg }}"
prompt_qa = "{{ prompt_qa }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_tokenizer_files = [
    hf_hub_download(repo_id=repo_id, filename="spiece.model"),
    hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json"),
    hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json"),
    hf_hub_download(repo_id=repo_id, filename="added_tokens.json"),
]
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = AutoTokenizer.from_pretrained(config_path.rsplit("/", 1)[0], use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(config_path.rsplit("/", 1)[0])
model.to(device)
model.eval()

inputs_qg = tokenizer(prompt_qg, return_tensors="pt")
inputs_qg = {k: v.to(device) for k, v in inputs_qg.items()}
inputs_qa = tokenizer(prompt_qa, return_tensors="pt")
inputs_qa = {k: v.to(device) for k, v in inputs_qa.items()}

with torch.no_grad():
    out_qg = model.generate(**inputs_qg, max_new_tokens=max_new_tokens, num_beams=num_beams)
    out_qa = model.generate(**inputs_qa, max_new_tokens=max_new_tokens, num_beams=num_beams)

text_qg = tokenizer.decode(out_qg[0], skip_special_tokens=True)
text_qa = tokenizer.decode(out_qa[0], skip_special_tokens=True)

RESULT = {"question_generation": text_qg, "question_answering": text_qa}
