{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("valhalla/t5-base-qa-qg-hl") %}
{% set prompt = prompt | default("generate question:  42  is the answer to life, the universe and everything. ") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
prompt = "{{ prompt }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenized_inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}

generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
