{% set repo_id = repo_id | default("1bitLLM/bitnet_b1_58-3B") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set do_sample = do_sample | default(False) %}
{% set max_new_tokens = max_new_tokens | default(64) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
do_sample = {{ do_sample }}
max_new_tokens = {{ max_new_tokens }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

text_inputs = input_prompt

RESULT = pipe(text_inputs, do_sample=do_sample, max_new_tokens=max_new_tokens)
