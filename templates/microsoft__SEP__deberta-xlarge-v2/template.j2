{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("microsoft/deberta-xlarge-v2") %}
{% set text_input = text_input | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    model_outputs = model(**encoded_inputs)
last_hidden_state = model_outputs.last_hidden_state.cpu()
cls_embedding = last_hidden_state[:, 0, :]

RESULT = {
    "last_hidden_state": last_hidden_state,
    "cls_embedding": cls_embedding,
}
