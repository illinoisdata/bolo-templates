{% set repo_id = repo_id | default("microsoft/deberta-xlarge-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import DebertaV2Tokenizer, DebertaV2ForMaskedLM, DebertaV2Config

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spm_path = hf_hub_download(repo_id=repo_id, filename="spm.model")

tokenizer = DebertaV2Tokenizer(vocab_file=spm_path)
config = DebertaV2Config.from_pretrained(config_path)
model = DebertaV2ForMaskedLM(config)
state_dict = torch.load(weights_path, map_location="cpu")
if "deberta.embeddings.position_embeddings.weight" in state_dict:
    state_dict["deberta.embeddings.position_embeddings.weight"] = state_dict.pop("deberta.embeddings.position_embeddings.weight")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {"logits": outputs.logits}
