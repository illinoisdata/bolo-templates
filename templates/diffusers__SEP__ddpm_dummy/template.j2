repo_id = "{{ repo_id }}"
device = "{{ device }}"
batch_size = {{ batch_size }}
num_channels = {{ num_channels }}
height = {{ height }}
width = {{ width }}
time_step_value = {{ time_step_value }}
output_dir = "{{ output_dir }}"

import json
import inspect
import torch
from pathlib import Path
from diffusers import UNet2DModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
with open(config_path, "r", encoding="utf-8") as config_file:
    model_config = json.load(config_file)

init_signature = inspect.signature(UNet2DModel.__init__)
init_param_names = {
    name
    for name, param in init_signature.parameters.items()
    if name != "self" and param.kind in (param.POSITIONAL_OR_KEYWORD, param.KEYWORD_ONLY)
}
model_init_kwargs = {key: value for key, value in model_config.items() if key in init_param_names}
if "attention_head_dim" in init_param_names and "num_head_channels" in model_config:
    model_init_kwargs.setdefault("attention_head_dim", model_config["num_head_channels"])
if "layers_per_block" in init_param_names and "num_res_blocks" in model_config:
    model_init_kwargs.setdefault("layers_per_block", model_config["num_res_blocks"])

model = UNet2DModel(**model_init_kwargs)
model.to(device)
model.eval()

dummy_noise = torch.ones((batch_size, num_channels, height, width), device=device)
time_step = torch.tensor([time_step_value], device=device, dtype=torch.long)

model_output = model(dummy_noise, time_step)
denoised_sample = model_output.sample

RESULT = {"denoised_image": denoised_sample.detach().cpu()}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    torch.save(RESULT["denoised_image"], Path(output_dir) / "denoised_image.pt")