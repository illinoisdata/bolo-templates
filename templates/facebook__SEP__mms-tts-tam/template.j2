{% set repo_id = "facebook/mms-tts-tam" %}
{% set device = "cuda:0" %}
{% set text = "some example text in the Tamil language" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mms-tts-tam" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

from transformers import VitsModel, AutoTokenizer
import torch
import os
from scipy.io.wavfile import write as write_wav

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu().numpy()
RESULT = {"waveform": waveform}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "waveform.wav")
    write_wav(output_path, model.config.sampling_rate, RESULT["waveform"])