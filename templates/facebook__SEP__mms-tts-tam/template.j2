{% set repo_id = repo_id | default("facebook/mms-tts-tam") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("some example text in the Tamil language") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import VitsModel, AutoTokenizer
import torch
import os
from scipy.io.wavfile import write as write_wav

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu().numpy()
RESULT = {"waveform": waveform}
