{% set repo_id = repo_id | default("facebook/m2m100_418M") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Life is like a box of chocolate.") %}
{% set source_lang = source_lang | default("en") %}
{% set target_lang = target_lang | default("fr") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
source_lang = "{{ source_lang }}"
target_lang = "{{ target_lang }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# 4. Load tokenizer/processor & model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
tokenizer.src_lang = source_lang
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

# 5. Pre-process input
encoded_inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

# 6. Run inference
forced_bos_token_id = tokenizer.get_lang_id(target_lang)
generated_tokens = model.generate(**encoded_inputs, forced_bos_token_id=forced_bos_token_id)

# 7. Post-process & build RESULT dict
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translation": translations}

# 8. Main guard
