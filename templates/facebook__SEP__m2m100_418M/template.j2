{% set repo_id = repo_id | default("facebook/m2m100_418M") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('जीवन एक चॉकलेट बॉक्स की तरह है।') %}
{% set src_lang = src_lang | default('hi') %}
{% set tgt_lang = tgt_lang | default('fr') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}
src_lang = {{ src_lang | tojson }}
tgt_lang = {{ tgt_lang | tojson }}
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import M2M100ForConditionalGeneration, M2M100Tokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

model = M2M100ForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

tokenizer = M2M100Tokenizer.from_pretrained(repo_id)
tokenizer.src_lang = src_lang
inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        forced_bos_token_id=tokenizer.get_lang_id(tgt_lang),
        max_new_tokens=max_new_tokens,
    )

output_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
