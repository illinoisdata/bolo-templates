{% set repo_id = repo_id | default("biglab/uiclip_jitteredwebsites-2-224-paraphrased") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-image-classification") %}
{% set model = model | default(repo_id) %}
{% set image_processor = image_processor | default("openai/clip-vit-base-patch32") %}
{% set tokenizer = tokenizer | default("openai/clip-vit-base-patch32") %}
{% set input_image_path = input_image_path | default("/u/yunqili4/projects/ML-code-generation/data/image2.jpeg") %}
{% set candidate_labels = candidate_labels | default(["fox", "bear", "seagull", "cat"]) %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
model = {{ model | tojson }}
image_processor = {{ image_processor | tojson }}
tokenizer = {{ tokenizer | tojson }}
input_image_path = {{ input_image_path | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    device=device,
    tokenizer=tokenizer,
    image_processor=image_processor,
)

inference_inputs = input_image_path
pipe_outputs = pipe(inference_inputs, candidate_labels=candidate_labels)
RESULT = {"predictions": pipe_outputs}
