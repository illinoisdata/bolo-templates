{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("docling-project/DocumentFigureClassifier") %}
{% set top_k = top_k | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
top_k = {{ top_k }}

import json
from io import BytesIO

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoModelForImageClassification, EfficientNetImageProcessor

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = EfficientNetImageProcessor(size={"height": 224, "width": 224}, do_center_crop=True, do_resize=True)
model = AutoModelForImageClassification.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probs = torch.softmax(logits, dim=-1)[0]
    top_probs, top_indices = torch.topk(probs, k=min(top_k, probs.shape[-1]))

id2label = model.config.id2label
predictions = [
    {"label": id2label[int(idx)], "score": float(score)}
    for score, idx in zip(top_probs.tolist(), top_indices.tolist())
]

RESULT = {"predictions": predictions, "logits": logits[0].detach().cpu().tolist()}
