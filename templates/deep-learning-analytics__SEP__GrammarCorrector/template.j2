{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("deep-learning-analytics/GrammarCorrector") %}
{% set text_input = text_input | default("He are moving here.") %}
{% set num_return_sequences = num_return_sequences | default(1) %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set temperature = temperature | default(1.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
num_return_sequences = {{ num_return_sequences }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
temperature = {{ temperature }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_input = tokenizer(
    text_input,
    truncation=True,
    padding="longest",
    return_tensors="pt",
)
encoded_input = {key: tensor.to(torch_device) for key, tensor in encoded_input.items()}

generated_outputs = model.generate(
    **encoded_input,
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
    temperature=temperature,
)

decoded_outputs = tokenizer.batch_decode(
    generated_outputs,
    skip_special_tokens=True,
)

RESULT = {"corrected_texts": decoded_outputs}
