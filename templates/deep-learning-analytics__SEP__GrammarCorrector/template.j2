{% set repo_id = repo_id | default("deep-learning-analytics/GrammarCorrector") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('He are moving here.') %}
{% set num_return_sequences = num_return_sequences | default(2) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_return_sequences = {{ num_return_sequences }}

import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

if input_text.startswith("http://") or input_text.startswith("https://"):
    raise ValueError("input_text must be plain text for this model")

model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32, use_safetensors=False)
tokenizer = T5Tokenizer.from_pretrained(repo_id)
model = model.to(device)
model.eval()

batch = tokenizer([input_text], truncation=True, padding='max_length', max_length=64, return_tensors="pt").to(device)
translated = model.generate(**batch, max_length=64, num_beams=num_return_sequences, num_return_sequences=num_return_sequences, temperature=1.5)
output_texts = tokenizer.batch_decode(translated, skip_special_tokens=True)

RESULT = {"output_texts": output_texts}
