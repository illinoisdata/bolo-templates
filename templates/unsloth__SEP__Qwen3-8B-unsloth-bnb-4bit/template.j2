{% set repo_id = repo_id | default("unsloth/Qwen3-8B-unsloth-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("Give me a short introduction to large language models.") %}
{% set enable_thinking = enable_thinking | default(true) %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
enable_thinking = {{ enable_thinking }}
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")
weights_1 = hf_hub_download(repo_id=repo_id, filename="model-00001-of-00002.safetensors")
weights_2 = hf_hub_download(repo_id=repo_id, filename="model-00002-of-00002.safetensors")
# tokenizer files
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model_dir = os.path.dirname(model_index_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(
    model_dir,
    device_map=None,
    torch_dtype=torch.float16 if "cuda" in device else torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

messages = [{"role": "user", "content": prompt}]
text = tokenizer.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True,
    enable_thinking=enable_thinking,
)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=not enable_thinking,
        temperature=0.7 if not enable_thinking else 0.6,
        top_p=0.8 if not enable_thinking else 0.95,
        top_k=20,
    )
output_ids = generated_ids[0][inputs["input_ids"].shape[1]:]
output_text = tokenizer.decode(output_ids, skip_special_tokens=True)

RESULT = {"text": output_text}
