repo_id = "{{ repo_id }}"
device = "{{ device }}"
heavy_sequences = {{ heavy_sequences }}
light_sequences = {{ light_sequences }}

import torch
from transformers import T5EncoderModel, T5Tokenizer

tokenizer = T5Tokenizer.from_pretrained(repo_id, do_lower_case=False)
model = T5EncoderModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

paired_sequences = []
for sequence_heavy, sequence_light in zip(heavy_sequences, light_sequences):
    paired_sequences.append(" ".join(sequence_heavy) + " </s> " + " ".join(sequence_light))

tokens = tokenizer(
    paired_sequences,
    add_special_tokens=True,
    padding=True,
    return_tensors="pt",
    return_special_tokens_mask=True,
)

tokens = {k: v.to(device) for k, v in tokens.items()}
with torch.no_grad():
    output = model(input_ids=tokens["input_ids"], attention_mask=tokens["attention_mask"])

residue_embeddings = output.last_hidden_state.clone()
residue_embeddings[tokens["special_tokens_mask"] == 1] = 0
sequence_embeddings_sum = residue_embeddings.sum(1)
sequence_lengths = torch.sum(tokens["special_tokens_mask"] == 0, dim=1)
sequence_embeddings = sequence_embeddings_sum / sequence_lengths.unsqueeze(1)

RESULT = {"sequence_embeddings": sequence_embeddings.cpu(), "residue_embeddings": residue_embeddings.cpu()}
