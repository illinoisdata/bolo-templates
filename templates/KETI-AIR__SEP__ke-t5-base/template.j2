{% set repo_id = "KETI-AIR/ke-t5-base" %}
{% set device = "cuda:0" %}
{% set input_text = "summarize: The quick brown fox jumps over the lazy dog and then considers the lessons it learned." %}
{% set max_new_tokens = 64 %}
{% set num_return_sequences = 1 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/KETI-AIR__SEP__ke-t5-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_return_sequences = {{ num_return_sequences }}
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = inputs.to(device)

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    num_return_sequences=num_return_sequences,
)

generated_tokens = generated_tokens.cpu()
generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "generated_texts.txt").write_text("\n".join(RESULT["generated_texts"]))