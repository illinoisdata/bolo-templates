{% set repo_id = repo_id | default("KETI-AIR/ke-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('아버지가 방에 들어가신다.</s>') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = T5Tokenizer(vocab_file=spiece_file)
model = T5ForConditionalGeneration.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=32)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
RESULT = {"generated_text": decoded[0] if decoded else ""}
