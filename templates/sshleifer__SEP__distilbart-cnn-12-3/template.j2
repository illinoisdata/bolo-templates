{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sshleifer/distilbart-cnn-12-3") %}
{% set input_text = input_text | default("NASA released new climate data showing unprecedented heat waves across Europe, raising concerns among scientists about future weather patterns.") %}
{% set num_beams = num_beams | default(4) %}
{% set max_length = max_length | default(142) %}
{% set min_length = min_length | default(56) %}
{% set length_penalty = length_penalty | default(2.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
num_beams = {{ num_beams }}
max_length = {{ max_length }}
min_length = {{ min_length }}
length_penalty = {{ length_penalty }}

from pathlib import Path

import torch

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)
model.eval()

tokenized = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
)
tokenized = {key: value.to(torch_device) for key, value in tokenized.items()}

generated_tokens = model.generate(
    **tokenized,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    early_stopping=True,
    no_repeat_ngram_size=3,
)

summary = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"summary": summary}
