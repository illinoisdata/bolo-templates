{% set repo_id = repo_id | default("UrukHan/t5-russian-spell") %}
{% set device = device | default("cuda:0") %}
{% set input_sequences = input_sequences | default(['сеглдыя хорош ден', 'когд а вы прдет к нам в госи']) %}
{% set max_input = max_input | default(256) %}
{% set max_output = max_output | default(256) %}
{% set num_beams = num_beams | default(4) %}
{% set task_prefix = task_prefix | default('Spell correct: ') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sequences = {{ input_sequences }}
max_input = {{ max_input }}
max_output = {{ max_output }}
num_beams = {{ num_beams }}
task_prefix = "{{ task_prefix }}"

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32, device_map=None)
model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

if isinstance(input_sequences, str):
    input_sequences = [input_sequences]

inputs = tokenizer(
    [task_prefix + seq for seq in input_sequences],
    padding=True,
    truncation=True,
    max_length=max_input,
    return_tensors="pt",
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_output,
        num_beams=num_beams,
    )

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"output_text": output_text}
