{% set repo_id = repo_id | default("concedo/KobbleTinyV2-1.1B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('KobbleTiny-Q4_K.gguf') %}
{% set prompt = prompt | default('Write a short, vivid fantasy scene about a traveler entering an ancient city at dusk.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=4,
    n_gpu_layers=0,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=128,
    temperature=0.7,
    top_p=0.95,
    stop=["### Instruction:", "### Response:"]
)

text = output["choices"][0]["text"]
RESULT = {"text": text}
