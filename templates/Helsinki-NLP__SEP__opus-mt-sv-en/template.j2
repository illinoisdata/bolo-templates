{% set input_text = "Hej världen!" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(input_text, return_tensors="pt", padding=True).to(device)
generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-sv-en"
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])