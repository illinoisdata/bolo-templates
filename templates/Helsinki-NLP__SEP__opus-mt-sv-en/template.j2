{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-sv-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('Hej världen!') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
spm_src_file = hf_hub_download(repo_id=repo_id, filename="source.spm")
spm_tgt_file = hf_hub_download(repo_id=repo_id, filename="target.spm")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    src_lang="sv",
    tgt_lang="en",
    local_files_only=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6, max_length=512)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
