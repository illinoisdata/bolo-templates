{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-yo-en" %}
{% set text = "Bawo ni, bawo ni?" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-yo-en" %}

device = "{{ device }}"
repo_id = "{{ repo_id }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

from transformers import MarianTokenizer, MarianMTModel
import torch
import os

# Load tokenizer and model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)

# Pre-process input text
inputs = tokenizer(text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
generated_tokens = model.generate(**inputs)

# Post-process output tokens
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

# Build result dict
RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    out_file = os.path.join(output_dir, "translation.txt")
    with open(out_file, "w", encoding="utf-8") as f:
        for line in RESULT["translation"]:
            f.write(line + "\n")