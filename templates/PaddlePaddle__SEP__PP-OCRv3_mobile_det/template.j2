{% set repo_id = repo_id | default("PaddlePaddle/PP-OCRv3_mobile_det") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
import os
import sys
import subprocess
from pathlib import Path

import numpy as np
import paddle
from PIL import Image
from huggingface_hub import hf_hub_download
from paddleocr import TextDetection

# Download repository files
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
weights_path = hf_hub_download(repo_id=repo_id, filename='inference.pdiparams')

# Prepare input
if isinstance(image_path, str) and image_path.startswith(('http://', 'https://')):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
    input_path = image
else:
    input_path = image_path

# Load model
model = TextDetection(model_name=json.load(open(config_path))['Global']['model_name'])

# Run inference
output = model.predict(input=input_path, batch_size=1)

# Post-process
results = []
for res in output:
    if hasattr(res, 'to_dict'):
        results.append(res.to_dict())
    else:
        results.append(str(res))

RESULT = {"output": results}
