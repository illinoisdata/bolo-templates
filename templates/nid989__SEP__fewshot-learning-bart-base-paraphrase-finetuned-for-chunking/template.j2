{% set repo_id = repo_id | default("nid989/fewshot-learning-bart-base-paraphrase-finetuned-for-chunking") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("This is a sample paragraph to chunk into meaningful segments using the fine-tuned BART model. It contains multiple sentences. The model should output chunk labels or chunked text depending on its learned behavior.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import json
import os
from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model_dir = os.path.dirname(model_file)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=128,
        num_beams=4,
        length_penalty=1.0,
        early_stopping=True,
    )

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"output_text": output_text}
