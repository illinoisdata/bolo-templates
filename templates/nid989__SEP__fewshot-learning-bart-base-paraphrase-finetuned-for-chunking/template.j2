{% set device = "cuda:0" %}
{% set repo_id = "nid989/fewshot-learning-bart-base-paraphrase-finetuned-for-chunking" %}
{% set input_text = "Chunk the following sentence using paraphrasing: The quick brown fox jumps over the lazy dog." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {
    key: value.to(device)
    for key, value in encoded_inputs.items()
}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
    no_repeat_ngram_size=3,
)

paraphrase = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"paraphrase": paraphrase}
