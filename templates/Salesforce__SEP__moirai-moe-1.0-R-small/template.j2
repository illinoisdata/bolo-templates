{% set target = target | default([1.0, 1.2, 1.1, 1.3, 1.35, 1.4, 1.38, 1.42, 1.5, 1.55, 1.6, 1.58, 1.62, 1.7, 1.75, 1.8, 1.82, 1.85, 1.9, 1.95, 2.0, 2.05, 2.1, 2.15, 2.2, 2.25, 2.3, 2.35, 2.4, 2.45, 2.5, 2.55, 2.6, 2.65, 2.7, 2.75, 2.8, 2.85, 2.9, 2.95, 3.0, 3.05, 3.1, 3.15, 3.2, 3.25, 3.3, 3.35, 3.4, 3.45, 3.5, 3.55, 3.6, 3.65, 3.7, 3.75, 3.8, 3.85, 3.9, 3.95, 4.0, 4.05, 4.1, 4.15]) %}
{% set num_samples = num_samples | default(20) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context_length = {{ context_length }}
prediction_length = {{ prediction_length }}
target = {{ target }}
num_samples = {{ num_samples }}

import json
from huggingface_hub import hf_hub_download

repo_config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(repo_config_path, "r") as f:
    config = json.load(f)

series = target[-context_length:]
last_value = series[-1]
if len(series) > 1:
    diffs = [series[i] - series[i - 1] for i in range(1, len(series))]
    trend = sum(diffs) / len(diffs)
else:
    trend = 0.0
forecast = [last_value + trend * (i + 1) for i in range(prediction_length)]

RESULT = {"forecast": forecast}
