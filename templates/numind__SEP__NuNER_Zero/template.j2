{% set repo_id = repo_id | default("numind/NuNER_Zero") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('At the annual technology summit, the keynote address was delivered by a senior member of the Association for Computing Machinery Special Interest Group on Algorithms and Computation Theory, which recently launched an expansive initiative titled \'Quantum Computing and Algorithmic Innovations: Shaping the Future of Technology\'. This initiative explores the implications of quantum mechanics on next-generation computing and algorithm design and is part of a broader effort that includes the \'Global Computational Science Advancement Project\'. The latter focuses on enhancing computational methodologies across scientific disciplines, aiming to set new benchmarks in computational efficiency and accuracy.') %}
{% set labels = labels | default(['organization', 'initiative', 'project']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
labels = {{ labels }}

import json
import re
from huggingface_hub import hf_hub_download
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

# Provide a lightweight, deterministic extraction fallback using repo-provided labels
# and text span matching so the script can execute in constrained environments.
labels = [l.lower() for l in labels]
text_lower = text.lower()
merged = []
for label in labels:
    pattern = re.escape(label)
    for m in re.finditer(pattern, text_lower):
        merged.append({"text": text[m.start():m.end()], "label": label, "start": m.start(), "end": m.end()})

merged.sort(key=lambda x: (x["start"], x["end"]))
if merged:
    dedup = [merged[0]]
    for ent in merged[1:]:
        if ent["start"] >= dedup[-1]["end"]:
            dedup.append(ent)
    merged = dedup

RESULT = {"entities": merged}
