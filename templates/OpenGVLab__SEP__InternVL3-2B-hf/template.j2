{% set repo_id = repo_id | default("OpenGVLab/InternVL3-2B-hf") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-text-to-text") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set input_prompt = input_prompt | default("Describe this image in detail.") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set return_full_text = return_full_text | default(False) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
model = repo_id
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}
return_full_text = {{ return_full_text }}

from transformers import AutoImageProcessor, AutoTokenizer, pipeline

tokenizer = AutoTokenizer.from_pretrained(model)
feature_extractor = AutoImageProcessor.from_pretrained(model)

pipe = pipeline(
    task=task,
    model=model,
    tokenizer=tokenizer,
    feature_extractor=feature_extractor,
    device=device,
)

messages = [
    {
        "role": "user",
        "content": [
            {"type": "image", "image": input_image},
            {"type": "text", "text": input_prompt},
        ],
    }
]

outputs = pipe(
    text=messages,
    max_new_tokens=max_new_tokens,
    return_full_text=return_full_text,
)

RESULT = {"outputs": outputs}
