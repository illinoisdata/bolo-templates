{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("transformersbook/pegasus-samsum") %}
{% set input_text = input_text | default("Today's meeting concluded with a plan to address the feature gaps next sprint, the support team is handling the critical bug fixes, and the design review will follow once the prototype is stabilized.") %}
{% set max_length = max_length | default(128) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set length_penalty = length_penalty | default(0.8) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True, padding="longest", max_length=1024)
inputs = inputs.to(device)

generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    early_stopping=True,
)

summary = tokenizer.batch_decode(generated_ids, skip_special_tokens=True, clean_up_tokenization_spaces=True)[0]

RESULT = {"summary": summary}
