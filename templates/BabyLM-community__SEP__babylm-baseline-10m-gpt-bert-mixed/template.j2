{% set repo_id = repo_id | default("BabyLM-community/babylm-baseline-10m-gpt-bert-mixed") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('The quick brown fox') %}
{% set masked_text = masked_text | default('The capital of France is [MASK].') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
masked_text = "{{ masked_text }}"

import os
import sys
import torch
from huggingface_hub import hf_hub_download, snapshot_download
from transformers import AutoTokenizer, AutoConfig

local_dir = snapshot_download(repo_id=repo_id, allow_patterns=["configuration_gpt_bert.py", "modeling_gpt_bert.py", "__init__.py"], local_dir="/workspace/.hf_local_model", local_dir_use_symlinks=False)
package_name = "babylm_gptbert_remote"
package_dir = os.path.join("/workspace", package_name)
os.makedirs(package_dir, exist_ok=True)
for fname in ["configuration_gpt_bert.py", "modeling_gpt_bert.py", "__init__.py"]:
    src = os.path.join(local_dir, fname)
    dst = os.path.join(package_dir, fname)
    if not os.path.exists(dst):
        import shutil
        shutil.copyfile(src, dst)
sys.path.insert(0, "/workspace")

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

from babylm_gptbert_remote.configuration_gpt_bert import ModelConfig
from babylm_gptbert_remote.modeling_gpt_bert import GPTBERTForCausalLM, GPTBERTForMaskedLM

config = AutoConfig.from_pretrained(repo_id, trust_remote_code=True)
tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
state_dict = torch.load(model_path, map_location="cpu")

model = GPTBERTForCausalLM(config)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

input_ids = tokenizer(prompt, return_tensors="pt").input_ids.to(device)
with torch.no_grad():
    logits = model(input_ids=input_ids)[0]
next_id = int(torch.argmax(logits[0, -1]).item())
causal_output = tokenizer.decode(torch.cat([input_ids[0].cpu(), torch.tensor([next_id])]), skip_special_tokens=True)

mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None:
    mask_inputs = tokenizer(masked_text, return_tensors="pt").to(device)
    if (mask_inputs.input_ids == mask_token_id).any():
        with torch.no_grad():
            outputs = model(input_ids=mask_inputs.input_ids, attention_mask=mask_inputs.attention_mask)[0]
        filled = mask_inputs.input_ids[0].clone()
        for pos in (mask_inputs.input_ids[0] == mask_token_id).nonzero(as_tuple=False).flatten().tolist():
            filled[pos] = int(torch.argmax(outputs[0, pos]).item())
        masked_output = tokenizer.decode(filled, skip_special_tokens=True)
    else:
        masked_output = None
else:
    masked_output = None

RESULT = {"causal_output": causal_output, "masked_output": masked_output}
