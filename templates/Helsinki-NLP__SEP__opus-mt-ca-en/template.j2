{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-ca-en" %}
{% set text_input = "El català és una llengua oficial." %}
{% set max_length = 128 %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text_input = {{ text_input | tojson }}
max_length = {{ max_length }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(text_input, return_tensors="pt", padding=True).to(device)
generated_ids = model.generate(**encoded, max_length=max_length, num_beams=4)
translation = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"translation": translation}
