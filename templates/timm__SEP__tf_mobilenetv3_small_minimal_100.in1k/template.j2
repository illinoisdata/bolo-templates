{% set repo_id = repo_id | default("timm/tf_mobilenetv3_small_minimal_100.in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
device_id = 0 if device != "cpu" else -1

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device_id)
preprocessed_input = input_image
predictions = pipe(preprocessed_input)
RESULT = {"predictions": predictions}
