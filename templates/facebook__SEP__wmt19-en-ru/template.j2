{% set repo_id = repo_id | default("facebook/wmt19-en-ru") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default('Machine learning is great, isn\'t it?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

import torch
from transformers import FSMTForConditionalGeneration, FSMTTokenizer

model = FSMTForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()
tokenizer = FSMTTokenizer.from_pretrained(repo_id)

inputs = tokenizer(source_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

with torch.no_grad():
    generated_tokens = model.generate(input_ids=input_ids, attention_mask=attention_mask, num_beams=5)

translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation}
