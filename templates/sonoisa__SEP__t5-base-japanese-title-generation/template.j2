{% set device = "cuda:0" %}
{% set repo_id = "sonoisa/t5-base-japanese-title-generation" %}
{% set article_text = "記事本文のサンプルです。日本語で書かれた記事の一部をここに置き換えて、モデルにタイトル生成を依頼します。" %}
{% set tokenizer_max_length = 512 %}
{% set generation_max_length = 64 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = """{{ article_text }}"""
tokenizer_max_length = {{ tokenizer_max_length }}
generation_max_length = {{ generation_max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    article_text,
    return_tensors="pt",
    truncation=True,
    max_length=tokenizer_max_length,
)
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_ids = model.generate(
    **inputs,
    max_length=generation_max_length,
    num_beams=num_beams,
    early_stopping=True,
)
generated_title = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_title": generated_title}
