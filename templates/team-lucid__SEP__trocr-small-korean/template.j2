{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/team-lucid__SEP__trocr-small-korean" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
from io import BytesIO
from pathlib import Path

import requests
from PIL import Image
from torchvision import transforms as T
from transformers import AutoTokenizer, VisionEncoderDecoderModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
model.to(device)

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

preprocess = T.Compose([
    T.Resize((384, 384), interpolation=Image.BICUBIC),
    T.CenterCrop((384, 384)),
    T.ToTensor(),
    T.Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5]),
])
pixel_values = preprocess(image).unsqueeze(0).to(device)

generated_ids = model.generate(pixel_values, max_length=max_length, num_beams=num_beams)
text_outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
text_result = text_outputs[0]

RESULT = {"generated_text": text_result}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    output_file = Path(output_dir) / "generated_text.txt"
    output_file.write_text(RESULT["generated_text"], encoding="utf-8")