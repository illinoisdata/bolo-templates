{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_new_tokens = {{ max_new_tokens }}

import os
import requests
import torch
from PIL import Image
from transformers import VisionEncoderDecoderModel, TrOCRProcessor
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_dir_or_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = TrOCRProcessor.from_pretrained(os.path.dirname(processor_dir_or_file))
model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(device)
model.eval()

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(device)
with torch.no_grad():
    generated_ids = model.generate(pixel_values, max_new_tokens=max_new_tokens)
text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": text}
