{% set repo_id = repo_id | default("tanganke/clip-vit-base-patch32_dtd") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-feature-extraction") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set image_processor_id = image_processor_id | default("openai/clip-vit-base-patch32") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
image_processor_id = {{ image_processor_id | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=repo_id,
    image_processor=image_processor_id,
    device=device,
)

RESULT = pipe(input_image)
