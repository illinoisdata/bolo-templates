{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import requests
import torch
from PIL import Image
from transformers import AutoProcessor, VitPoseForPoseEstimation
import scipy.ndimage
import transformers.models.vitpose.image_processing_pil_vitpose as vitpose_pil
vitpose_pil.affine_transform = scipy.ndimage.affine_transform

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = AutoProcessor.from_pretrained(repo_id)
model = VitPoseForPoseEstimation.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

boxes = [[[0.0, 0.0, float(image.width), float(image.height)]]]
inputs = processor(image, boxes=boxes, return_tensors="pt").to(device)
inputs["dataset_index"] = torch.zeros((inputs["pixel_values"].shape[0],), dtype=torch.long, device=device)
with torch.no_grad():
    outputs = model(**inputs)

pose_results = processor.post_process_pose_estimation(outputs, boxes=boxes, threshold=0.3)
image_pose_result = pose_results[0]
result_people = []
for person_pose in image_pose_result:
    person = {
        "keypoints": person_pose["keypoints"].detach().cpu().numpy().tolist(),
        "labels": person_pose["labels"].detach().cpu().numpy().tolist(),
        "scores": person_pose["scores"].detach().cpu().numpy().tolist(),
    }
    result_people.append(person)

RESULT = {"pose_results": result_people}
