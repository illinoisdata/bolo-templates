{% set repo_id = repo_id | default("bclavie/JaColBERTv2") %}
{% set device = device | default("cuda:0") %}
{% set query = query | default('マクドナルドのフライドポテトの少量のカロリーはいくつですか？') %}
{% set documents = documents | default(['マクドナルドの小さなフライドポテトは何カロリーですか。', '東京の天気予報について教えてください。', '機械学習モデルの評価方法を説明してください。']) %}
{% set repo_revision = repo_revision | default('main') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"
documents = {{ documents }}
repo_revision = "{{ repo_revision }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json", revision=repo_revision)
tokenizer = AutoTokenizer.from_pretrained(repo_id, revision=repo_revision, use_fast=False)
model = AutoModel.from_pretrained(repo_id, revision=repo_revision).to(device)
model.eval()

query_inputs = tokenizer(query, return_tensors="pt", truncation=True, padding=True)
query_inputs = {k: v.to(device) for k, v in query_inputs.items()}
with torch.no_grad():
    query_hidden = model(**query_inputs).last_hidden_state
    doc_embeddings = []
    for doc in documents:
        doc_inputs = tokenizer(doc, return_tensors="pt", truncation=True, padding=True)
        doc_inputs = {k: v.to(device) for k, v in doc_inputs.items()}
        doc_hidden = model(**doc_inputs).last_hidden_state
        score = torch.einsum('bld,bmd->blm', query_hidden, doc_hidden).max(dim=-1).values.sum(dim=-1)
        doc_embeddings.append(score.squeeze().item())

output = {"query": query, "documents": documents, "scores": doc_embeddings}
RESULT = {"output": output}
