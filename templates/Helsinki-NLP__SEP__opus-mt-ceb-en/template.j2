{% set src_text = "Maayong buntag!" %}
{% set max_length = 512 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-ceb-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])