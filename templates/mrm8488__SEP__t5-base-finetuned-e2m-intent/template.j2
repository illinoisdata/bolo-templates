{% set repo_id = repo_id | default("mrm8488/t5-base-finetuned-e2m-intent") %}
{% set device = device | default("cuda:0") %}
{% set event = event | default("PersonX takes PersonY home") %}
{% set max_length = max_length | default(16) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
event = "{{ event }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

features = tokenizer(event, return_tensors="pt")
features = {key: value.to(torch_device) for key, value in features.items()}

generated_ids = model.generate(**features, max_length=max_length, num_beams=num_beams)
intent = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"intent": intent}
