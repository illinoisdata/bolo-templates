{% set repo_id = repo_id | default("timm/nf_resnet50.ra2_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model_id = model_id | default(repo_id) %}
{% set device_id = device_id | default(device) %}
{% set image_input = image_input | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model_id | tojson }}
device = {{ device_id | tojson }}
input_image = {{ image_input | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_image)
