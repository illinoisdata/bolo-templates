{% set repo_id = "Helsinki-NLP/opus-mt-en-nl" %}
{% set device = "cuda:0" %}
{% set input_text = "This is a test sentence." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-nl" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(input_text, return_tensors="pt")
encoded = {k: v.to(device) for k, v in encoded.items()}

generated_ids = model.generate(**encoded)

translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translations.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        for line in RESULT["translations"]:
            f.write(line + "\n")