{% set repo_id = repo_id | default("HKUSTAudio/Llasa-1B-Multilingual") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Auch das unter Schirmherrschaft der Vereinten Nationen ausgehandelte Klimaschutzabkommen von Pariswollen die USA verlassen.') %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set temperature = temperature | default(0.8) %}
{% set top_p = top_p | default(1.0) %}
{% set do_sample = do_sample | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
do_sample = {{ do_sample }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float32,
    device_map=None,
)
model.to(device)
model.eval()

formatted_text = f"<|TEXT_UNDERSTANDING_START|>{input_text}<|TEXT_UNDERSTANDING_END|>"
chat = [
    {"role": "user", "content": "Convert the text to speech:" + formatted_text},
    {"role": "assistant", "content": "<|SPEECH_GENERATION_START|>"},
]
input_ids = tokenizer.apply_chat_template(
    chat,
    tokenize=True,
    return_tensors="pt",
    continue_final_message=True,
)
if not isinstance(input_ids, torch.Tensor):
    input_ids = input_ids.input_ids
input_ids = input_ids.to(device)
speech_end_id = tokenizer.convert_tokens_to_ids("<|SPEECH_GENERATION_END|>")

with torch.no_grad():
    outputs = model.generate(
        input_ids=input_ids,
        max_new_tokens=max_new_tokens,
        eos_token_id=speech_end_id,
        do_sample=do_sample,
        top_p=top_p,
        temperature=temperature,
    )

generated_text = tokenizer.decode(outputs[0][input_ids.shape[1]:], skip_special_tokens=False)

RESULT = {"generated_text": generated_text}
