{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("uclanlp/plbart-python-en_XX") %}
{% set source_text = source_text | default("def greet():\n    print('Hello from PLBART translation!')") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""

import json
import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(source_text, return_tensors="pt", truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=256)
translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translations": translations}
