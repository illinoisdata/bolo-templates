{% set repo_id = repo_id | default("allenai/tulu-2-7b") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("<|user|>\nHello, my name is Eric, how are you?\n<|assistant|>") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.7) %}
{% set top_k = top_k | default(50) %}
{% set top_p = top_p | default(0.95) %}
{% set do_sample = do_sample | default(True) %}
{% set return_full_text = return_full_text | default(True) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_k = {{ top_k }}
top_p = {{ top_p }}
do_sample = {{ do_sample }}
return_full_text = {{ return_full_text }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

prompt = input_prompt

RESULT = {
    "outputs": pipe(
        prompt,
        max_new_tokens=max_new_tokens,
        temperature=temperature,
        top_k=top_k,
        top_p=top_p,
        do_sample=do_sample,
        return_full_text=return_full_text,
    )
}
