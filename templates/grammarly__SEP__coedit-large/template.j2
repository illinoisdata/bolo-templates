{% set repo_id = repo_id | default("grammarly/coedit-large") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Fix grammatical errors in this sentence: When I grow up, I start to understand what he said is quite right.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
gen_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Load tokenizer/model from the downloaded repo files' directory.
model_dir = __import__('os').path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_length=256)

edited_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"edited_text": edited_text}
