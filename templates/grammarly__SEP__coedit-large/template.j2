{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "Fix grammatical errors in this sentence: When I grow up, I start to understand what he said is quite right." %}
{% set max_length = 256 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch.device(device))

encoded_input = tokenizer(input_text, return_tensors="pt")
encoded_input = {
    key: tensor.to(torch.device(device))
    for key, tensor in encoded_input.items()
}

generated_tokens = model.generate(
    **encoded_input,
    max_length=max_length,
    num_beams=num_beams,
)
decoded_output = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
result_text = decoded_output[0].strip()

RESULT = {"edited_text": result_text}

if __name__ == "__main__":
    output_dir = Path("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/grammarly__SEP__coedit-large")
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / "edited_text.txt").write_text(RESULT["edited_text"], encoding="utf-8")