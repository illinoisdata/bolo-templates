{% set repo_id = repo_id | default("allenai/scibert_scivocab_uncased") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is SciBERT pretrained on?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
import torch

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

# Pre-process input & load model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id)
model.to(device)
model.eval()

context = (
    "SciBERT is a pretrained BERT model trained on scientific text from Semantic Scholar papers. "
    "It uses its own scivocab vocabulary and has cased and uncased versions."
)
inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    outputs = model(**inputs)
    start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
    end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
    if end_idx < start_idx:
        end_idx = start_idx

answer_ids = inputs["input_ids"][0, start_idx : end_idx + 1]
answer_text = tokenizer.decode(answer_ids, skip_special_tokens=True)

# Post-process & build RESULT dict
RESULT = {"answer": answer_text, "start_index": start_idx, "end_index": end_idx}
