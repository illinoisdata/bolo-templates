{% set repo_id = repo_id | default("timm/eva02_enormous_patch14_plus_clip_224.laion2b_s9b_b144k") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('a photo of a cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

from io import BytesIO
import json
import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from open_clip import create_model_and_transforms, get_tokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")

with open(config_path, 'r') as f:
    cfg = json.load(f)

if isinstance(image_path, str) and image_path.startswith(('http://', 'https://')):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

model, _, preprocess = create_model_and_transforms(
    model_name='EVA02-E-14-plus',
    pretrained=None,
    precision='fp16' if str(device).startswith('cuda') else 'fp32',
    device=device,
)
state_dict = torch.load(weights_path, map_location='cpu')
if isinstance(state_dict, dict) and 'state_dict' in state_dict:
    state_dict = state_dict['state_dict']
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

image_tensor = preprocess(image).unsqueeze(0).to(device)
if str(device).startswith('cuda'):
    image_tensor = image_tensor.half()

tokenizer = get_tokenizer('EVA02-E-14-plus')
text_tokens = tokenizer([text_prompt]).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logits = 100.0 * image_features @ text_features.T
    probs = logits.softmax(dim=-1)

RESULT = {
    'logits': logits.detach().cpu().numpy(),
    'probs': probs.detach().cpu().numpy(),
    'text_prompt': text_prompt,
}
