{% set repo_id = repo_id | default("setu4993/LaBSE") %}
{% set device = device | default("cuda:0") %}
{% set sentence1 = sentence1 | default("dog") %}
{% set sentence2 = sentence2 | default("Puppies are nice.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = "{{ sentence1 }}"
sentence2 = "{{ sentence2 }}"
max_length = {{ max_length }}

import torch
import torch.nn.functional as F
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from transformers import BertModel, BertTokenizerFast, BertConfig

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

config = BertConfig.from_json_file(config_file)
model = BertModel(config)
state_dict = load_file(weights_file); state_dict.pop("embeddings.position_ids", None); model.load_state_dict(state_dict)
model = model.to(device)
model.eval()

tokenizer = BertTokenizerFast.from_pretrained(
    pretrained_model_name_or_path=repo_id,
    vocab_file=vocab_file,
    tokenizer_file=tokenizer_file,
    tokenizer_config_file=tokenizer_config_file,
    special_tokens_map_file=special_tokens_map_file,
    local_files_only=True,
)

inputs = tokenizer([sentence1, sentence2], return_tensors="pt", padding=True, truncation=True, max_length=max_length)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    embeddings = outputs.pooler_output
    normalized = F.normalize(embeddings, p=2, dim=1)
    similarity = torch.matmul(normalized[0:1], normalized[1:2].transpose(0, 1)).squeeze().item()

RESULT = {
    "sentence1_embedding": embeddings[0].detach().cpu(),
    "sentence2_embedding": embeddings[1].detach().cpu(),
    "cosine_similarity": similarity,
}
