{% set device = device | default("cuda:0") %}
{% set text = text | default('I kept his secret for months, but then he betrayed my trust and lied to everyone.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import json
from pathlib import Path

import torch
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from torch import nn
from transformers import AutoTokenizer

class MoralBERTPredictBetrayal(nn.Module):
    def __init__(self, model_dir):
        super().__init__()
        config = json.load(open(Path(model_dir) / "config.json"))
        self.moral_label = config.get("moral_label")
        self.tokenizer = AutoTokenizer.from_pretrained(model_dir, local_files_only=True)
        state_dict = load_file(str(Path(model_dir) / "model.safetensors"))
        self.embeddings = nn.Embedding(self.tokenizer.vocab_size, 64)
        self.classifier = nn.Linear(64, 3)
        # load matching tensors if shapes align; otherwise keep randomly initialized parameters unavailable
        if "embeddings.weight" in state_dict and state_dict["embeddings.weight"].shape == self.embeddings.weight.shape:
            self.embeddings.weight.data.copy_(state_dict["embeddings.weight"])
        if "classifier.weight" in state_dict and state_dict["classifier.weight"].shape == self.classifier.weight.shape:
            self.classifier.weight.data.copy_(state_dict["classifier.weight"])
        if "classifier.bias" in state_dict and state_dict["classifier.bias"].shape == self.classifier.bias.shape:
            self.classifier.bias.data.copy_(state_dict["classifier.bias"])

    def forward(self, text):
        inputs = self.tokenizer(text, return_tensors="pt", truncation=True)
        input_ids = inputs["input_ids"].to(device)
        attention_mask = inputs["attention_mask"].to(device)
        x = self.embeddings(input_ids)
        x = (x * attention_mask.unsqueeze(-1)).sum(dim=1) / attention_mask.sum(dim=1, keepdim=True).clamp_min(1)
        logits = self.classifier(x)
        return logits

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = str(Path(model_path).parent)
model = MoralBERTPredictBetrayal(model_dir).to(device)
model.eval()

with torch.no_grad():
    logits = model(text)
    probabilities = torch.softmax(logits, dim=-1)[0].tolist()
    predicted_class = int(torch.argmax(logits, dim=-1).item())

RESULT = {
    "text": text,
    "predicted_class": predicted_class,
    "probabilities": probabilities,
    "moral_label": model.moral_label,
}
