{% set repo_id = repo_id %}
{% set device = device %}
{% set source_text = "Hola, ¿cómo estás?" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-es-it" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(source_text, return_tensors="pt", truncation=True, max_length=max_length)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translation_path = os.path.join(output_dir, "translation.txt")
    with open(translation_path, "w", encoding="utf-8") as file:
        file.write(RESULT["translation"])