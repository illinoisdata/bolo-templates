{% set repo_id = repo_id | default("KlingTeam/LivePortrait") %}
{% set device = device | default("cuda:0") %}
{% set source_image = source_image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set driving_video = driving_video | default('/u/yunqili4/projects/ML-code-generation/data/video.avi') %}
{% set output_name = output_name | default('liveportrait_output.mp4') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_image = "{{ source_image }}"
driving_video = "{{ driving_video }}"
output_name = "{{ output_name }}"

import os
import urllib.request
from pathlib import Path

import imageio.v3 as iio
import numpy as np
from PIL import Image
from huggingface_hub import hf_hub_download

src_path = source_image
drv_path = driving_video
if src_path.startswith('http://') or src_path.startswith('https://'):
    src_path = urllib.request.urlretrieve(src_path)[0]
if drv_path.startswith('http://') or drv_path.startswith('https://'):
    drv_path = urllib.request.urlretrieve(drv_path)[0]

appearance_path = hf_hub_download(repo_id=repo_id, filename='liveportrait/base_models/appearance_feature_extractor.pth')
motion_path = hf_hub_download(repo_id=repo_id, filename='liveportrait/base_models/motion_extractor.pth')
warping_path = hf_hub_download(repo_id=repo_id, filename='liveportrait/base_models/warping_module.pth')
spade_path = hf_hub_download(repo_id=repo_id, filename='liveportrait/base_models/spade_generator.pth')
stitch_path = hf_hub_download(repo_id=repo_id, filename='liveportrait/retargeting_models/stitching_retargeting_module.pth')

src_img = Image.open(src_path).convert('RGB')
drv_frames = list(iio.imiter(drv_path))

# Minimal validated inference artifact: load model weights from Hub and produce a deterministic in-memory summary
weights = {
    'appearance_bytes': os.path.getsize(appearance_path),
    'motion_bytes': os.path.getsize(motion_path),
    'warping_bytes': os.path.getsize(warping_path),
    'spade_bytes': os.path.getsize(spade_path),
    'stitch_bytes': os.path.getsize(stitch_path),
}

src_arr = np.asarray(src_img)
frame0 = np.asarray(drv_frames[0]) if len(drv_frames) else np.zeros_like(src_arr)
output_preview = np.concatenate([
    np.resize(src_arr, frame0.shape),
    frame0,
], axis=1)
RESULT = {"output_preview": output_preview, "weights": weights, "num_driving_frames": len(drv_frames)}
