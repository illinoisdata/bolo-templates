{% set repo_id = repo_id | default("facebook/blenderbot-3B") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello, how are you doing today?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, BlenderbotForConditionalGeneration
from huggingface_hub import hf_hub_download

hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="vocab.json")
hf_hub_download(repo_id=repo_id, filename="merges.txt")
hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = BlenderbotForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=60,
        num_beams=10,
        length_penalty=0.65,
        no_repeat_ngram_size=3,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
