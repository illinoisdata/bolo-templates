{% set repo_id = repo_id | default("keremberke/yolov8m-building-segmentation") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if image.startswith("http://") or image.startswith("https://"):
    from urllib.request import urlopen
    input_image = Image.open(urlopen(image)).convert("RGB")
else:
    input_image = Image.open(image).convert("RGB")

model = YOLO(weights_path)
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(source=input_image, device=device, verbose=False)
result = results[0]

boxes = result.boxes
masks = result.masks
if masks is not None:
    masks_data = masks.data.cpu().numpy().tolist()
else:
    masks_data = None
boxes_data = boxes.xyxy.cpu().numpy().tolist() if boxes is not None else None
classes = boxes.cls.cpu().numpy().tolist() if boxes is not None else None
scores = boxes.conf.cpu().numpy().tolist() if boxes is not None else None

RESULT = {
    "boxes_xyxy": boxes_data,
    "classes": classes,
    "scores": scores,
    "masks": masks_data,
}
