{% set repo_id = "xfbai/AMRBART-large-v2" %}
{% set device = "cuda:0" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/xfbai__SEP__AMRBART-large-v2" %}
{% set input_text = "The cat sat on the mat." %}
{% set max_new_tokens = 128 %}
{% set num_beams = 4 %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
output_dir = {{ output_dir | tojson }}
input_text = {{ input_text | tojson }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, BartTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
tokenizer = BartTokenizer.from_pretrained(repo_id)
model = model.to(torch.device(device))
model.eval()

tokenized_inputs = tokenizer(input_text, return_tensors="pt")
tokenized_inputs = {key: value.to(torch.device(device)) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(**tokenized_inputs, max_new_tokens=max_new_tokens, num_beams=num_beams)
generated_tokens = generated_tokens.cpu()
decoded_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"generated_text": decoded_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_text.txt")
    with open(output_path, "w", encoding="utf-8") as writer:
        writer.write(RESULT["generated_text"])