{% set repo_id = repo_id | default("uclanlp/visualbert-vqa") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is in the image?') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
image_path = {{ image_path | tojson }}

import os
import torch
from PIL import Image
from transformers import AutoTokenizer, VisualBertForQuestionAnswering
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

model = VisualBertForQuestionAnswering.from_pretrained(
    os.path.dirname(weights_path),
    local_files_only=True,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained("bert-base-uncased")

if str(image_path).startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = tokenizer(question, return_tensors="pt")
# VisualBERT expects visual embeddings; use a minimal zeroed region tensor matching config.
batch_size = inputs["input_ids"].shape[0]
visual_embeds = torch.zeros((batch_size, 1, 2048), device=device)
visual_attention_mask = torch.ones((batch_size, 1), dtype=torch.long, device=device)
visual_token_type_ids = torch.ones((batch_size, 1), dtype=torch.long, device=device)

inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(
        input_ids=inputs["input_ids"],
        attention_mask=inputs["attention_mask"],
        token_type_ids=inputs.get("token_type_ids"),
        visual_embeds=visual_embeds,
        visual_attention_mask=visual_attention_mask,
        visual_token_type_ids=visual_token_type_ids,
    )

logits = outputs.logits
pred_idx = int(torch.argmax(logits, dim=-1).item())
label = model.config.id2label.get(pred_idx, str(pred_idx))
RESULT = {"predicted_label": label, "logits": logits.detach().cpu().tolist()}
