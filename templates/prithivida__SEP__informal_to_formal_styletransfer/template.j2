{% set device = "cuda:0" %}
{% set repo_id = "prithivida/informal_to_formal_styletransfer" %}
{% set informal_input = "hey, can u send me the notes quickly? i'm swamped rn." %}
{% set max_new_tokens = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
informal_input = "{{ informal_input }}"
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model_inputs = tokenizer(informal_input, return_tensors="pt")
model_inputs = {key: value.to(device) for key, value in model_inputs.items()}

generated_tokens = model.generate(**model_inputs, max_new_tokens=max_new_tokens)
formal_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)
RESULT = {"formal_text": formal_text}
