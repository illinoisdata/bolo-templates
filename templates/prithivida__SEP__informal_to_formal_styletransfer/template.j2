{% set repo_id = repo_id | default("prithivida/informal_to_formal_styletransfer") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('i cant believe its already this late, we shouldnt be doing this now but i dont know what else to say') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

_tokenizer = AutoTokenizer.from_pretrained(
    model_file.rsplit('/', 1)[0],
    use_fast=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    model_file.rsplit('/', 1)[0],
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = _tokenizer(text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=128,
        num_beams=4,
        early_stopping=True,
    )

output_text = _tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
