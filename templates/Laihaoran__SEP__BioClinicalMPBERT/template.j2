{% set input_text = "Patient presents with shortness of breath and abnormal vital signs; recommend further evaluation for potential cardiac issues." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Laihaoran__SEP__BioClinicalMPBERT" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"
from transformers import AutoModel, AutoTokenizer
import torch
import numpy as np
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=512)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    model_outputs = model(**encoded_inputs)
last_hidden_state = model_outputs.last_hidden_state
embedding = last_hidden_state[:, 0, :].squeeze(0).cpu().numpy()

RESULT = {"embedding": embedding}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, "embedding.npy"), RESULT["embedding"])