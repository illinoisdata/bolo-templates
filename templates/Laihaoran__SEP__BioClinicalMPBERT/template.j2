{% set repo_id = repo_id | default("Laihaoran/BioClinicalMPBERT") %}
{% set device = device | default("cuda:0") %}
{% set text = text|default('Clinical note: patient has fever, cough, and shortness of breath. What is the most likely general topic?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text|tojson }}

import torch
from transformers import BertTokenizer, BertForMaskedLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config_dir = "/".join(config_path.split("/")[:-1])


tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=False)
model = BertForMaskedLM.from_pretrained(config_dir, state_dict=torch.load(weights_path, map_location="cpu"), config=config_path)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None and (inputs["input_ids"] == mask_token_id).any():
    mask_positions = (inputs["input_ids"] == mask_token_id).nonzero(as_tuple=False)
    pos = mask_positions[0, 1]
    token_logits = logits[0, pos]
    topk = torch.topk(token_logits, k=5)
    output_value = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
else:
    output_value = logits[0, 0].detach().cpu().tolist()[:10]

RESULT = {"output": output_value}
