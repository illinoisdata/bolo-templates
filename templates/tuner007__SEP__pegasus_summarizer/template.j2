{% set repo_id = repo_id | default("tuner007/pegasus_summarizer") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("India wicket-keeper batsman Rishabh Pant has said someone from the crowd threw a ball on pacer Mohammed Siraj while he was fielding in the ongoing third Test against England on Wednesday. Pant revealed the incident made India skipper Virat Kohli upset.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

auto_tokenizer = AutoTokenizer.from_pretrained(repo_id)
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

batch = auto_tokenizer([input_text], truncation=True, padding='longest', max_length=1024, return_tensors="pt").to(device)
with torch.no_grad():
    gen_out = model.generate(**batch, max_length=128, num_beams=5, num_return_sequences=1, temperature=1.5)
output_text = auto_tokenizer.batch_decode(gen_out, skip_special_tokens=True)

RESULT = {"summary": output_text}
