{% set repo_id = repo_id | default("tuner007/pegasus_summarizer") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("My dog is cute, but he sometimes chews my shoes, which is frustrating.") %}
{% set max_input_length = max_input_length | default(1024) %}
{% set max_summary_length = max_summary_length | default(128) %}
{% set num_beams = num_beams | default(5) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
{% set temperature = temperature | default(1.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_input_length = {{ max_input_length }}
max_summary_length = {{ max_summary_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
temperature = {{ temperature }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Preprocess input text
tokens = tokenizer([input_text], truncation=True, padding="longest", max_length=max_input_length, return_tensors="pt").to(device)

# Generate summary
generated_ids = model.generate(
    **tokens,
    max_length=max_summary_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
    temperature=temperature,
)

# Decode and post-process summaries
summaries = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

# Build the RESULT dict
RESULT = {"summaries": summaries}
