{% set repo_id = repo_id | default("LiquidAI/LFM2-1.2B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("LFM2-1.2B-Q4_K_M.gguf") %}
{% set prompt = prompt | default("Write a short, helpful introduction to Liquid AI's LFM2 model.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith("cuda") else 0
llm = Llama(
    model_path=model_path,
    n_ctx=256,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

outputs = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.95,
    stop=["</s>"],
)

output_text = outputs["choices"][0]["text"].strip()

RESULT = {"generated_text": output_text}
