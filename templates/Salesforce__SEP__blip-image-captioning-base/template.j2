{% set repo_id = repo_id | default("Salesforce/blip-image-captioning-base") %}
{% set device = device | default("cuda:0") %}
{% set text_prompt = text_prompt | default("a photography of") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"

import os
import torch
from PIL import Image
import requests
from transformers import BlipProcessor, BlipForConditionalGeneration
from huggingface_hub import hf_hub_download

repo_files = [
    hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin"),
    hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json"),
    hf_hub_download(repo_id=repo_id, filename="tokenizer.json"),
    hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json"),
    hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json"),
    hf_hub_download(repo_id=repo_id, filename="vocab.txt"),
]
model_dir = os.path.dirname(repo_files[0])
processor = BlipProcessor.from_pretrained(repo_id)
model = BlipForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model = model.to(device)
model.eval()

image_path = "/u/yunqili4/projects/ML-code-generation/data/image1.jpeg"
if str(image_path).startswith("http://") or str(image_path).startswith("https://"):
    raw_image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    raw_image = Image.open(image_path).convert("RGB")

inputs = processor(raw_image, text_prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=20)

caption = processor.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"caption": caption}
