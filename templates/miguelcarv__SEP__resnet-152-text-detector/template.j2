{% set repo_id = repo_id | default("miguelcarv/resnet-152-text-detector") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set model = model | default(repo_id) -%}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}
{% set image_processor = image_processor | default("microsoft/resnet-50") -%}
task = {{ task | tojson }}
model = {{ model | tojson }}
image_path = {{ image_path | tojson }}
image_processor = {{ image_processor | tojson }}
device = {{ device | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    device=device,
    image_processor=image_processor,
)

image = Image.open(image_path).convert("RGB").resize((300, 300))

inference_output = pipe(image)
RESULT = {"predictions": inference_output}
