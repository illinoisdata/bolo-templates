{% set repo_id = repo_id | default("setu4993/smaller-LaBSE") %}
{% set device = device | default("cuda:0") %}
{% set sentence1 = sentence1 | default('dog') %}
{% set sentence2 = sentence2 | default('Puppies are nice.') %}
{% set sentence3 = sentence3 | default('I enjoy taking long walks along the beach with my dog.') %}
{% set sentence4 = sentence4 | default('cane') %}
{% set sentence5 = sentence5 | default('I cuccioli sono carini.') %}
{% set sentence6 = sentence6 | default('Mi piace fare lunghe passeggiate lungo la spiaggia con il mio cane.') %}
{% set sentence7 = sentence7 | default('犬') %}
{% set sentence8 = sentence8 | default('子犬はいいです') %}
{% set sentence9 = sentence9 | default('私は犬と一緒にビーチを散歩するのが好きです') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = "{{ sentence1 }}"
sentence2 = "{{ sentence2 }}"
sentence3 = "{{ sentence3 }}"
sentence4 = "{{ sentence4 }}"
sentence5 = "{{ sentence5 }}"
sentence6 = "{{ sentence6 }}"
sentence7 = "{{ sentence7 }}"
sentence8 = "{{ sentence8 }}"
sentence9 = "{{ sentence9 }}"

import torch
import torch.nn.functional as F
from transformers import BertModel, BertTokenizerFast
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = BertTokenizerFast.from_pretrained(
    pretrained_model_name_or_path=tokenizer_file.rsplit('/', 1)[0],
    vocab_file=vocab_file,
    tokenizer_file=tokenizer_file,
    special_tokens_map_file=special_tokens_map_file,
    tokenizer_config_file=tokenizer_config_file,
)
model = BertModel.from_pretrained(pretrained_model_name_or_path=weights_file.rsplit('/', 1)[0], local_files_only=True)
model.to(device)
model.eval()

sentences_a = [sentence1, sentence2, sentence3]
sentences_b = [sentence4, sentence5, sentence6]
sentences_c = [sentence7, sentence8, sentence9]

inputs_a = tokenizer(sentences_a, return_tensors="pt", padding=True, truncation=True)
inputs_b = tokenizer(sentences_b, return_tensors="pt", padding=True, truncation=True)
inputs_c = tokenizer(sentences_c, return_tensors="pt", padding=True, truncation=True)
inputs_a = {k: v.to(device) for k, v in inputs_a.items()}
inputs_b = {k: v.to(device) for k, v in inputs_b.items()}
inputs_c = {k: v.to(device) for k, v in inputs_c.items()}

with torch.no_grad():
    outputs_a = model(**inputs_a)
    outputs_b = model(**inputs_b)
    outputs_c = model(**inputs_c)

embeddings_a = outputs_a.pooler_output
embeddings_b = outputs_b.pooler_output
embeddings_c = outputs_c.pooler_output

similarity_ab = F.normalize(embeddings_a, p=2, dim=-1) @ F.normalize(embeddings_b, p=2, dim=-1).T
similarity_ac = F.normalize(embeddings_a, p=2, dim=-1) @ F.normalize(embeddings_c, p=2, dim=-1).T
similarity_bc = F.normalize(embeddings_b, p=2, dim=-1) @ F.normalize(embeddings_c, p=2, dim=-1).T

RESULT = {
    "embeddings_a": embeddings_a,
    "embeddings_b": embeddings_b,
    "embeddings_c": embeddings_c,
    "similarity_ab": similarity_ab,
    "similarity_ac": similarity_ac,
    "similarity_bc": similarity_bc,
}
