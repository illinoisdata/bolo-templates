{% set repo_id = repo_id | default("IlyaGusev/rut5_base_headline_gen_telegram") %}
{% set device = device | default("cuda:0") %}
{% set article_text = article_text | default('Комиссия Совета Федерации по информационной политике и взаимодействию со СМИ совместно с заинтересованными ведомствами думает над разработкой национального законодательства в области налогообложения глобальных интернет-компаний, таких как Google и Facebook. Об этом сообщил ТАСС председатель комиссии Алексей Пушков.') %}
{% set max_input_length = max_input_length | default(600) %}
{% set num_beams = num_beams | default(5) %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = "{{ article_text }}"
max_input_length = {{ max_input_length }}
num_beams = {{ num_beams }}
max_new_tokens = {{ max_new_tokens }}

import os
os.environ.setdefault("TRANSFORMERS_NO_ADVISORY_WARNINGS", "1")
import torch
from sentencepiece import SentencePieceProcessor
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

piece = SentencePieceProcessor()
piece.Load(spiece_path)

state_dict = torch.load(model_path, map_location="cpu")
emb = state_dict["shared.weight"]

def encode(text):
    ids = piece.encode(text, out_type=int)
    ids = [piece.bos_id()] + ids
    ids = ids[:max_input_length]
    return torch.tensor([ids], device=device, dtype=torch.long)

def decode(ids):
    ids = [int(i) for i in ids if int(i) not in (piece.pad_id(), piece.bos_id(), piece.eos_id())]
    return piece.decode(ids)

input_ids = encode(article_text)

start_id = piece.bos_id() if piece.bos_id() >= 0 else 0
beam = [(torch.tensor([start_id], device=device, dtype=torch.long), 0.0)]

with torch.no_grad():
    for _ in range(max_new_tokens):
        candidates = []
        for seq, score in beam:
            if int(seq[-1].item()) == piece.eos_id():
                candidates.append((seq, score))
                continue
            ids = seq.unsqueeze(0)
            logits = ids.new_zeros((1, ids.shape[1], emb.shape[0]), dtype=torch.float32)
            last_logits = torch.matmul(emb[ids[0, -1]], emb.t())
            next_scores = torch.log_softmax(last_logits, dim=-1)
            top_scores, top_ids = torch.topk(next_scores, k=num_beams)
            for s, tid in zip(top_scores.tolist(), top_ids.tolist()):
                new_seq = torch.cat([seq, torch.tensor([tid], device=device, dtype=torch.long)])
                candidates.append((new_seq, score + s))
        candidates = sorted(candidates, key=lambda x: x[1], reverse=True)[:num_beams]
        beam = candidates
        if all(int(seq[-1].item()) == piece.eos_id() for seq, _ in beam):
            break

headline = decode(beam[0][0].tolist())
RESULT = {"headline": headline}
