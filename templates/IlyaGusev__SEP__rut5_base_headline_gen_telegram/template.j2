{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("IlyaGusev/rut5_base_headline_gen_telegram") %}
{% set article_text = article_text | default("Сенаторы обсуждают необходимость национального регулирования налогообложения глобальных интернет-компаний для защиты бюджета и справедливости") %}
{% set max_input_length = max_input_length | default(600) %}
{% set max_output_length = max_output_length | default(64) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = """{{ article_text }}"""
max_input_length = {{ max_input_length }}
max_output_length = {{ max_output_length }}
num_beams = {{ num_beams }}

import os
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    article_text,
    max_length=max_input_length,
    padding="max_length",
    truncation=True,
    return_tensors="pt",
)

input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

generated_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_output_length,
    num_beams=num_beams,
)

headline = tokenizer.decode(generated_ids[0], skip_special_tokens=True).strip()
RESULT = {"headline": headline}
