{% set repo_id = repo_id | default("allegro/herbert-klej-cased-tokenizer-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Kto ma lepszą sztukę, ma lepszy rząd – to jasne.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

from transformers import XLMTokenizer

# Download tokenizer files from the Hub
from huggingface_hub import hf_hub_download
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Load tokenizer and run inference
tokenizer = XLMTokenizer(vocab_file=vocab_file, merges_file=merges_file)
encoded = tokenizer(text, return_tensors="pt")
input_ids = encoded["input_ids"]
attention_mask = encoded.get("attention_mask")
tokens = tokenizer.convert_ids_to_tokens(input_ids[0])
decoded = tokenizer.decode(input_ids[0], skip_special_tokens=True)

RESULT = {
    "input_ids": input_ids.tolist(),
    "attention_mask": None if attention_mask is None else attention_mask.tolist(),
    "tokens": tokens,
    "decoded": decoded,
}
