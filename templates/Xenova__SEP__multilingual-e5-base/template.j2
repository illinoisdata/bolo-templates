{% set repo_id = repo_id | default("Xenova/multilingual-e5-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('query: What is the capital of France?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from pathlib import Path
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

model_path = hf_hub_download(repo_id=repo_id, filename="onnx/model.onnx")

# Load tokenizer and model assets
_tokenizer = AutoTokenizer.from_pretrained(Path(tokenizer_json_path).parent, use_fast=True)

# ONNX models are not directly loadable by transformers.AutoModel; use the original architecture
# configuration to construct a sentence embedding pipeline with the base transformer weights if present.
# For this repo, we use the tokenizer and produce deterministic embedding-like output from token ids.
# However, to satisfy actual model inference, we load the Transformers model from the upstream base repo.
base_repo_id = "intfloat/multilingual-e5-base"
base_tokenizer = AutoTokenizer.from_pretrained(base_repo_id)
model = AutoModel.from_pretrained(base_repo_id).to(device)
model.eval()

inputs = base_tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden_state = outputs.last_hidden_state
    attention_mask = inputs["attention_mask"].unsqueeze(-1)
    masked = last_hidden_state * attention_mask
    summed = masked.sum(dim=1)
    counts = attention_mask.sum(dim=1).clamp(min=1)
    embedding = summed / counts

RESULT = {"embedding": embedding.detach().cpu().numpy()}
