{% set repo_id = repo_id | default("hustvl/vitmatte-small-composition-1k") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"

import os
import numpy as np
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import VitMatteForImageMatting
from transformers.models.vitmatte.image_processing_vitmatte import VitMatteImageProcessor

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

if image.startswith(("http://", "https://")):
    import requests
    image_obj = Image.open(requests.get(image, stream=True).raw).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

processor = VitMatteImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = VitMatteForImageMatting.from_pretrained(os.path.dirname(weights_path)).to(device)
model.eval()

inputs = processor(images=image_obj, trimaps=Image.new("L", image_obj.size, color=0), return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

alpha = outputs.alphas if hasattr(outputs, "alphas") else outputs.predicted_alpha
if alpha.ndim == 4 and alpha.shape[1] == 1:
    alpha = alpha[:, 0]
alpha = alpha.detach().float().cpu().numpy()

RESULT = {"alpha": alpha}
