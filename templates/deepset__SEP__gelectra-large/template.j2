{% set repo_id = repo_id | default("deepset/gelectra-large") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Das ist ein Beispielsatz zur Bewertung der Wortwahrscheinlichkeit.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, ElectraForPreTraining

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# tokenizer_config.json is downloaded to ensure the tokenizer files are available;
# AutoTokenizer loads from the local vocab file directory.
model_dir = os.path.dirname(vocab_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = ElectraForPreTraining.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "logits": outputs.logits.detach().cpu().numpy(),
}
