{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("deepset/gelectra-large") %}
{% set text = text | default("Das ist ein Beispielsatz für die Inferenz.") %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ text | tojson }}

import json
from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

encoding = tokenizer(input_text, return_tensors="pt", truncation=True)
encoding = {k: v.to(device) for k, v in encoding.items()}

with torch.no_grad():
    outputs = model(**encoding)

logits = outputs.logits.detach().cpu().tolist()

RESULT = {
    "logits": logits,
}
