{% set device = "cuda:0" %}
{% set repo_id = "circulus/kobart-trans-ko-en-v2" %}
{% set source_text = "안녕하세요. 저는 기계 번역을 테스트합니다." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(source_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation_text": translation}
