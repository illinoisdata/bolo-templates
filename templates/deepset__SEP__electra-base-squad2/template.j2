{% set repo_id = repo_id | default("deepset/electra-base-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the model trained for?') %}
{% set context = context | default('deepset/electra-base-squad2 is an extractive question answering model trained on SQuAD 2.0 for English question answering.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

model_dir = __import__('os').path.dirname(model_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx : end_idx + 1], skip_special_tokens=True).strip()
score = float((start_logits[0, start_idx] + end_logits[0, end_idx]).item())

RESULT = {"answer": answer, "score": score, "start_index": start_idx, "end_index": end_idx}
