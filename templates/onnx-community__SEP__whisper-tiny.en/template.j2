{% set repo_id = repo_id | default("onnx-community/whisper-tiny.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"

import numpy as np
import soundfile as sf
import librosa
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor
import onnxruntime as ort


def load_audio(path_or_url):
    if isinstance(path_or_url, str) and path_or_url.startswith(("http://", "https://")):
        from tempfile import NamedTemporaryFile
        import requests
        r = requests.get(path_or_url, timeout=30)
        r.raise_for_status()
        with NamedTemporaryFile(suffix=".wav", delete=False) as f:
            f.write(r.content)
            return f.name
    return path_or_url


processor = AutoProcessor.from_pretrained(repo_id)
encoder_path = hf_hub_download(repo_id=repo_id, filename="onnx/encoder_model.onnx")
decoder_path = hf_hub_download(repo_id=repo_id, filename="onnx/decoder_model.onnx")

session_options = ort.SessionOptions()
session_options.intra_op_num_threads = 1
session_options.inter_op_num_threads = 1
providers = ["CPUExecutionProvider"]
encoder_session = ort.InferenceSession(encoder_path, sess_options=session_options, providers=providers)
decoder_session = ort.InferenceSession(decoder_path, sess_options=session_options, providers=providers)

raw_audio_path = load_audio(audio_path)
audio, sr = sf.read(raw_audio_path)
if audio.ndim > 1:
    audio = audio.mean(axis=1)
if sr != 16000:
    audio = librosa.resample(audio.astype(np.float32), orig_sr=sr, target_sr=16000)
    sr = 16000
inputs = processor(audio, sampling_rate=sr, return_tensors="np")
input_features = inputs["input_features"].astype(np.float32)

encoder_hidden_states = encoder_session.run(None, {"input_features": input_features})[0]
forced_decoder_ids = processor.get_decoder_prompt_ids(language=language, task=task)
prompt_ids = [processor.tokenizer.bos_token_id] + [token_id for _, token_id in forced_decoder_ids]
decoder_input_ids = np.array([prompt_ids], dtype=np.int64)
outputs = decoder_session.run(None, {"input_ids": decoder_input_ids, "encoder_hidden_states": encoder_hidden_states})
logits = outputs[0]
next_token_id = int(np.argmax(logits[0, -1]))
transcription = processor.tokenizer.decode(prompt_ids + [next_token_id], skip_special_tokens=True)

RESULT = {"transcription": transcription}
