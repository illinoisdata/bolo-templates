repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
labels_list = {{ labels_list }}

import json
import torch
import torch.nn.functional as F
from PIL import Image
from huggingface_hub import hf_hub_download
from open_clip import create_model_from_pretrained, get_tokenizer
from urllib.parse import urlparse
from urllib.request import urlopen

config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_model.safetensors")

def load_image(path_or_url):
    if isinstance(path_or_url, str) and urlparse(path_or_url).scheme in ("http", "https"):
        return Image.open(urlopen(path_or_url)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")

image = load_image(image_path)
model, preprocess = create_model_from_pretrained(f"hf-hub:{repo_id}")
model = model.to(device).eval()
tokenizer = get_tokenizer(f"hf-hub:{repo_id}")

image_tensor = preprocess(image).unsqueeze(0).to(device)
text = tokenizer(labels_list, context_length=model.context_length)
text = text.to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text)
    image_features = F.normalize(image_features, dim=-1)
    text_features = F.normalize(text_features, dim=-1)
    logit_scale = model.logit_scale.exp()
    logit_bias = getattr(model, "logit_bias", None)
    logits = image_features @ text_features.T * logit_scale
    if logit_bias is not None:
        logits = logits + logit_bias
    probs = torch.sigmoid(logits)[0].detach().cpu()

RESULT = {"labels": labels_list, "probabilities": probs.tolist()}
