{% set repo_id = repo_id | default("pinkmanlove/llama-7b-hf") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set temperature = temperature | default(0.2) %}
{% set special_tokens = special_tokens | default({"unk_token": "<unk>", "bos_token": "<s>", "eos_token": "</s>", "pad_token": "<pad>"}) %}

{% set device_setting = device_setting | default(device) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
special_tokens = {{ special_tokens | tojson }}
device = {{ device_setting | tojson }}

from transformers import AutoTokenizer, pipeline

tokenizer = AutoTokenizer.from_pretrained(model, **special_tokens)
pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt, max_new_tokens=max_new_tokens, temperature=temperature)
