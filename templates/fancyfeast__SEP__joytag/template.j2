{% set repo_id = repo_id | default("fancyfeast/joytag") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_data = {{ input_data | tojson }}

from transformers import pipeline, ViTConfig, ViTImageProcessor, ViTForImageClassification

config = ViTConfig.from_pretrained(repo_id)
config.num_labels = config.n_tags
image_size = config.image_size
image_processor = ViTImageProcessor(size={"height": image_size, "width": image_size})
model = ViTForImageClassification.from_pretrained(repo_id, config=config).to(device)

pipe = pipeline(task=task, model=model, image_processor=image_processor, device=device)
RESULT = pipe(input_data)
