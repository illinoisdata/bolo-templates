{% set repo_id = repo_id | default("Musixmatch/umberto-wikipedia-uncased-v1") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("fill-mask") %}
{% set model = model | default(repo_id) %}
{% set masked_prompt = masked_prompt | default("Paris is the {mask} of France.") %}

repo_id = "{{ repo_id }}"
task = "{{ task }}"
model = "{{ model }}"
device = "{{ device }}"
masked_prompt = "{{ masked_prompt }}"

from huggingface_hub import hf_hub_download
from transformers import PreTrainedTokenizerFast, pipeline

tokenizer_file = hf_hub_download(repo_id, "tokenizer.json")
tokenizer = PreTrainedTokenizerFast(
    tokenizer_file=tokenizer_file,
    bos_token="<s>",
    eos_token="</s>",
    unk_token="<unk>",
    pad_token="<pad>",
    cls_token="<s>",
    sep_token="</s>",
    mask_token="<mask>",
    add_prefix_space=True,
)

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
RESULT = pipe(text)
