{% set repo_id = repo_id | default("google/owlv2-base-patch16") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-object-detection") %}
{% set input_path = input_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set candidate_labels = candidate_labels | default(["cat", "dog", "person"]) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_path = {{ input_path | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline
from PIL import Image

pipe = pipeline(task=task, model=repo_id, device=device)

image = Image.open(input_path).convert("RGB")

RESULT = pipe(image, candidate_labels=candidate_labels)
