{% set repo_id = repo_id | default("crangana/trained-gender") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set image_processor = image_processor | default("microsoft/resnet-50") %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}
image_processor = {{ image_processor | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    image_processor=image_processor,
    device=device,
)
RESULT = pipe(input_data)
