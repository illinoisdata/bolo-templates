{% set repo_id = repo_id | default("SmallDoge/Doge-60M") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set ignore_mismatched_sizes = ignore_mismatched_sizes | default(True) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}
ignore_mismatched_sizes = {{ ignore_mismatched_sizes }}

model_kwargs = {"ignore_mismatched_sizes": ignore_mismatched_sizes}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, model_kwargs=model_kwargs)
RESULT = pipe(input_prompt, max_new_tokens=max_new_tokens)
