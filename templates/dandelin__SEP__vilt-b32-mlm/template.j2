{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
masked_prompt = {{ masked_prompt | tojson }}
image_path = {{ image_path | tojson }}

from transformers import ViltProcessor, pipeline
from PIL import Image

class ViltProcessorForFillMask:
    def __init__(self, processor):
        self.processor = processor
        self.tokenizer = processor.tokenizer

    def __getattr__(self, name):
        return getattr(self.tokenizer, name)

    def __call__(self, inputs, return_tensors="pt", **kwargs):
        image, text = inputs
        return self.processor(image, text, return_tensors=return_tensors, **kwargs)

processor = ViltProcessor.from_pretrained(repo_id)
tokenizer = ViltProcessorForFillMask(processor)
pipe = pipeline(task=task, model=repo_id, tokenizer=tokenizer, device=device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
image = Image.open(image_path)
RESULT = pipe((image, text))
