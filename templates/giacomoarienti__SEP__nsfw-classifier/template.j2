{% set repo_id = repo_id | default("giacomoarienti/nsfw-classifier") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set processor_source = processor_source | default("google/vit-base-patch16-224-in21k") %}

repo_id = "{{ repo_id }}"
task = {{ task | tojson }}
device = "{{ device }}"
model = repo_id
input_data = {{ input_image | tojson }}
image_processor = {{ processor_source | tojson }}
feature_extractor = {{ processor_source | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    device=device,
    image_processor=image_processor,
    feature_extractor=feature_extractor,
)
RESULT = pipe(input_data)
