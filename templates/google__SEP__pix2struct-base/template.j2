{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/pix2struct-base") %}
{% set image_path = image_path | default("/u/yli77/projects/ML-code-generation/data/image1.jpeg") %}
{% set prompt_text = prompt_text | default("Describe the image in detail.") %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt_text = "{{ prompt_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from io import BytesIO
from pathlib import Path
import requests
from PIL import Image
from transformers import AutoProcessor, Pix2StructForConditionalGeneration

processor = AutoProcessor.from_pretrained(repo_id)
model = Pix2StructForConditionalGeneration.from_pretrained(repo_id)
model.to(device)

if image_path.startswith(("http://", "https://")):
    response = requests.get(image_path)
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(Path(image_path)).convert("RGB")

inputs = processor(images=image, text=[prompt_text], return_tensors="pt")
inputs = inputs.to(device)

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
generated_texts = processor.tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
caption = generated_texts[0]

RESULT = {"generated_text": caption}
