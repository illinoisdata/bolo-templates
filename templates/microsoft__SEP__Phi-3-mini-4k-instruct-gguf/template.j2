{% set repo_id = repo_id | default("microsoft/Phi-3-mini-4k-instruct-gguf") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Phi-3-mini-4k-instruct-q4.gguf') %}
{% set prompt = prompt | default('How to explain Internet to a medieval knight?') %}
{% set max_tokens = max_tokens | default(128) %}
{% set temperature = temperature | default(0.6) %}
{% set top_p = top_p | default(0.95) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
max_tokens = {{ max_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}

import os
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = 0
if device.startswith('cuda') and torch.cuda.is_available():
    n_gpu_layers = -1

llm = Llama(
    model_path=model_path,
    n_ctx=4096,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

chat_prompt = f"<|user|>\n{prompt}<|end|>\n<|assistant|>"
result = llm(
    chat_prompt,
    max_tokens=max_tokens,
    temperature=temperature,
    top_p=top_p,
    stop=["<|end|>"],
    echo=False,
)
output_text = result['choices'][0]['text']
RESULT = {"text": output_text}
