{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("hyunwoongko/asian-bart-ecjk") %}
{% set input_text = input_text | default("Translate the following sentence into Korean: Hello, world!") %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoding = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding=False,
    max_length=max_length,
)
encoding = {key: value.to(device) for key, value in encoding.items()}

generated_ids = model.generate(
    **encoding,
    max_length=max_length,
    num_beams=num_beams,
)
generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": generated_texts[0]}
