{% set input_text = "Translate the following sentence into Korean: Hello, world!" %}
{% set max_length = 256 %}
{% set num_beams = 5 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/hyunwoongko__SEP__asian-bart-ecjk" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoding = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding=False,
    max_length=max_length,
)
encoding = {key: value.to(device) for key, value in encoding.items()}

generated_ids = model.generate(
    **encoding,
    max_length=max_length,
    num_beams=num_beams,
)
generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": generated_texts[0]}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    text_path = output_path / "generated_text.txt"
    text_path.write_text(RESULT["generated_text"], encoding="utf-8")