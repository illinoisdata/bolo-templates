{% set repo_id = repo_id | default("deepset/minilm-uncased-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("Why is model conversion important?") %}
{% set context = context | default("The option to convert models between FARM and transformers gives freedom to the user and let people easily switch between frameworks.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_text = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True)
score = float((start_logits[start_idx] + end_logits[end_idx]).item())

RESULT = {"answer": answer_text, "score": score, "start_index": start_idx, "end_index": end_idx}
