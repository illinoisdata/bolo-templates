{% set repo_id = repo_id | default("vblagoje/dpr-ctx_encoder-single-lfqa-wiki") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Where an aircraft passes through a cloud, it can disperse the cloud in its path...') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import DPRContextEncoder, DPRContextEncoderTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = DPRContextEncoderTokenizer.from_pretrained(repo_id, local_files_only=True)
model = DPRContextEncoder.from_pretrained(repo_id, local_files_only=True, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
embedding = outputs.pooler_output.detach().cpu().numpy()

RESULT = {"embedding": embedding}
