{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("vblagoje/dpr-ctx_encoder-single-lfqa-wiki") %}
{% set query = query | default("Where an aircraft passes through a cloud, it can disperse the cloud in its path...") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = """{{ query }}"""

import os
from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(query, return_tensors="pt", truncation=True, max_length=512)
encoded = {key: value.to(device) for key, value in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)

embeddings = outputs.pooler_output
embedding_list = embeddings.cpu().tolist()

RESULT = {"query_embedding": embedding_list}
