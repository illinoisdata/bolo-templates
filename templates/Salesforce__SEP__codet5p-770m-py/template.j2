{% set prompt = "def print_hello_world():" %}
{% set max_length = 128 %}
{% set num_return_sequences = 1 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Salesforce__SEP__codet5p-770m-py" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
prompt = {{ prompt | tojson }}
max_length = {{ max_length }}
num_return_sequences = {{ num_return_sequences }}
output_dir = {{ output_dir | tojson }}

import json
import tempfile
from pathlib import Path

import torch
from huggingface_hub import snapshot_download
from transformers import AutoModelForSeq2SeqLM, T5Tokenizer

tokenizer_temp_dir = Path(tempfile.mkdtemp(prefix="codet5_tokenizer_"))
snapshot_download(
    repo_id=repo_id,
    repo_type="model",
    local_dir=tokenizer_temp_dir,
    local_dir_use_symlinks=False,
    allow_patterns=["tokenizer_config.json", "spiece.model"],
)
tokenizer_config_path = tokenizer_temp_dir / "tokenizer_config.json"
with tokenizer_config_path.open("r+", encoding="utf-8") as config_file:
    tokenizer_config = json.load(config_file)
    added_tokens = tokenizer_config.get("added_tokens", [])
    if not isinstance(added_tokens, list):
        added_tokens = []
    tokenizer_config["added_tokens"] = added_tokens
    config_file.seek(0)
    config_file.truncate()
    json.dump(tokenizer_config, config_file)

tokenizer = T5Tokenizer.from_pretrained(tokenizer_temp_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(prompt, return_tensors="pt").to(device)

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_return_sequences=num_return_sequences,
)

decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_code": decoded_outputs}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    output_file = output_path / "generated_code.txt"
    output_file.write_text("\n".join(RESULT["generated_code"]), encoding="utf-8")