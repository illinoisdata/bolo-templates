{% set repo_id = repo_id | default("google/bert_uncased_L-12_H-256_A-4") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(config_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, do_lower_case=True)
model = AutoModelForMaskedLM.from_pretrained(model_dir)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict = {k: v for k, v in state_dict.items() if not k.startswith("bert.pooler") and not k.startswith("cls.seq_relationship")}
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    masked_token_id = tokenizer.mask_token_id
    if masked_token_id is not None and masked_token_id in inputs["input_ids"][0].tolist():
        mask_index = (inputs["input_ids"][0] == masked_token_id).nonzero(as_tuple=False)[0].item()
        top_id = int(logits[0, mask_index].argmax().item())
        predicted_token = tokenizer.decode([top_id]).strip()
    else:
        top_id = int(logits[0, -1].argmax().item())
        predicted_token = tokenizer.decode([top_id]).strip()

RESULT = {
    "predicted_token": predicted_token,
    "logits_shape": tuple(logits.shape),
}
