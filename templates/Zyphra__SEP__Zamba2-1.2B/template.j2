{% set repo_id = repo_id | default("Zyphra/Zamba2-1.2B") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('What factors contributed to the fall of the Roman Empire?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
    trust_remote_code=True,
    local_files_only=False,
)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    trust_remote_code=True,
    use_fast=True,
)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=64, do_sample=False)

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
