{% set repo_id = repo_id | default("monologg/koelectra-base-v3-finetuned-korquad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('한국어로 답해주세요. 이 모델은 무엇을 위해 사용되나요?') %}
{% set context = context | default('monologg/koelectra-base-v3-finetuned-korquad는 한국어 질의응답(Question Answering) 작업을 위해 파인튜닝된 모델입니다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Derive tokenizer directory from a downloaded file path.
tokenizer_dir = os.path.dirname(tokenizer_file)

tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=False)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx:end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()

RESULT = {
    "answer": answer,
    "start_index": start_idx,
    "end_index": end_idx,
    "start_logits": start_logits[0].detach().cpu().tolist(),
    "end_logits": end_logits[0].detach().cpu().tolist(),
}
