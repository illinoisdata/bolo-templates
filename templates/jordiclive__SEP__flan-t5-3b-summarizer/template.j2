{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("jordiclive/flan-t5-3b-summarizer") %}
{% set prompt = prompt | default("Produce an article summary of the following news article:") %}
{% set raw_document = raw_document | default("The economic landscape has shifted dramatically over the past few quarters, with inflation peaking and then gradually easing. The latest data shows that consumer prices are stabilizing, yet uncertainty lingers across labor markets and international trade tensions continue to influence central bank policies.") %}
{% set max_length = max_length | default(200) %}
{% set min_length = min_length | default(30) %}
{% set num_beams = num_beams | default(4) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set early_stopping = early_stopping | default(true) %}
{% set max_input_length = max_input_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
raw_document = """{{ raw_document }}"""
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}
max_input_length = {{ max_input_length }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

input_text = f"{prompt} {raw_document}"
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding="longest",
    max_length=max_input_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)

generated_texts = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
summary_text = generated_texts[0].strip()

RESULT = {"summary": summary_text}
