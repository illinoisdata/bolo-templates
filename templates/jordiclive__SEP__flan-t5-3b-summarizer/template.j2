{% set repo_id = repo_id | default("jordiclive/flan-t5-3b-summarizer") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('You must be 18 years old to live or work in New York State...') %}
{% set prompt = prompt | default('Produce an article summary of the following news article:') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set num_beams = num_beams | default(5) %}
{% set min_length = min_length | default(5) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set truncation = truncation | default(true) %}
{% set max_source_length = max_source_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
truncation = {{ truncation }}
max_source_length = {{ max_source_length }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")


tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_path.rsplit("/", 1)[0],
    use_fast=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    weights_path.rsplit("/", 1)[0],
    torch_dtype=torch.float16 if torch.cuda.is_available() or device.startswith("cuda") else torch.float32,
)
model.to(device)
model.eval()

source_text = f"{prompt} {input_text}"
inputs = tokenizer(
    source_text,
    return_tensors="pt",
    truncation=truncation,
    max_length=max_source_length,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        min_length=min_length,
        no_repeat_ngram_size=no_repeat_ngram_size,
    )

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": generated_text}
