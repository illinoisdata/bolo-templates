{% set repo_id = repo_id | default("megalaa/en-cop-mul-norm-group-greekified") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translation": translations}
