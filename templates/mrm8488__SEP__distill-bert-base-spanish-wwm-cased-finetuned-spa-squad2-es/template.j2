{% set repo_id = repo_id | default("mrm8488/distill-bert-base-spanish-wwm-cased-finetuned-spa-squad2-es") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("¿Para qué lenguaje está trabajando?") %}
{% set context = context | default("Manuel Romero está colaborando activamente con huggingface/transformers para traer el poder de las últimas técnicas de procesamiento de lenguaje natural al idioma español") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import json
import os
from huggingface_hub import hf_hub_download
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(model_file)

with open(config_file, "r") as f:
    config = json.load(f)

# Tokenizer files are downloaded to ensure local availability.
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx

answer = tokenizer.decode(inputs["input_ids"][0][start_idx:end_idx + 1], skip_special_tokens=True)
score = float((torch.softmax(start_logits, dim=-1)[start_idx] * torch.softmax(end_logits, dim=-1)[end_idx]).item())

RESULT = {
    "answer": answer,
    "start": start_idx,
    "end": end_idx,
    "score": score,
}
