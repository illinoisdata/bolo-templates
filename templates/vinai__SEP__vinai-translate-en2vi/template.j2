{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("vinai/vinai-translate-en2vi") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(5) %}
{% set source_lang = source_lang | default("en_XX") %}
{% set target_lang = target_lang | default("vi_VN") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
source_lang = "{{ source_lang }}"
target_lang = "{{ target_lang }}"

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

torch_device = torch.device(device)
model = model.to(torch_device)

tokenizer.src_lang = source_lang
tokenizer.tgt_lang = target_lang

tokenized_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
tokenized_inputs = {key: value.to(torch_device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(
    **tokenized_inputs,
    forced_bos_token_id=tokenizer.lang_code_to_id[target_lang],
    num_beams=num_beams,
    max_new_tokens=max_new_tokens,
)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
