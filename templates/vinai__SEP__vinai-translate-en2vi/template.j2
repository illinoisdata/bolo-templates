{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set max_new_tokens = 128 %}
{% set num_beams = 5 %}
{% set source_lang = "en_XX" %}
{% set target_lang = "vi_VN" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/vinai__SEP__vinai-translate-en2vi" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
source_lang = "{{ source_lang }}"
target_lang = "{{ target_lang }}"
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

torch_device = torch.device(device)
model = model.to(torch_device)

tokenizer.src_lang = source_lang
tokenizer.tgt_lang = target_lang

tokenized_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
tokenized_inputs = {key: value.to(torch_device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(
    **tokenized_inputs,
    forced_bos_token_id=tokenizer.lang_code_to_id[target_lang],
    num_beams=num_beams,
    max_new_tokens=max_new_tokens,
)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translation_path = os.path.join(output_dir, "translation.txt")
    with open(translation_path, "w", encoding="utf-8") as translation_file:
        translation_file.write(RESULT["translation"])