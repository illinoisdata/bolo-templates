{% set repo_id = repo_id | default("vinai/vinai-translate-en2vi") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('I love natural language processing.') %}
{% set src_lang = src_lang | default('en_XX') %}
{% set tgt_lang = tgt_lang | default('vi_VN') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}
src_lang = {{ src_lang | tojson }}
tgt_lang = {{ tgt_lang | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import MBartForConditionalGeneration, MBart50TokenizerFast

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

model = MBartForConditionalGeneration.from_pretrained(config_path)
state_dict = torch.load(weights_path, map_location="cpu", weights_only=False)
model.load_state_dict(state_dict)
tokenizer = MBart50TokenizerFast(vocab_file=spm_path, src_lang=src_lang, tgt_lang=tgt_lang)

model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
forced_bos_token_id = tokenizer.lang_code_to_id[tgt_lang]

with torch.no_grad():
    generated_ids = model.generate(**inputs, forced_bos_token_id=forced_bos_token_id, num_beams=5, max_length=128)

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
