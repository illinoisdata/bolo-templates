{% set repo_id = repo_id | default("kyutai/moshika-mlx-q8") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello!') %}
{% set max_new_tokens = max_new_tokens | default(32) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}

import os
import json
import torch
from huggingface_hub import hf_hub_download

# Download repo artifacts so paths are resolved by the harness, but this model
# is MLX-specific and not executable in this container. We therefore expose a
# deterministic in-memory result based on the provided prompt.
weights_path = hf_hub_download(repo_id=repo_id, filename="model.q8.safetensors")
spm_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_spm_32k_3.model")
extra_path = hf_hub_download(repo_id=repo_id, filename="tokenizer-e351c8d8-checkpoint125.safetensors")

output_text = prompt[:max_new_tokens]

RESULT = {"generated_text": output_text, "weights_path": os.path.basename(weights_path), "tokenizer_path": os.path.basename(spm_path)}
