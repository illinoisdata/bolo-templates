{% set repo_id = "valhalla/t5-small-qg-prepend" %}
{% set device = "cuda:0" %}
{% set input_text = "generate a question about the benefits of transfer learning in natural language processing." %}
{% set max_length = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/valhalla__SEP__t5-small-qg-prepend" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

output_dir = Path(output_dir)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

tokenized_inputs = tokenizer(input_text, return_tensors="pt")
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_ids = model.generate(**tokenized_inputs, max_length=max_length, num_beams=num_beams, early_stopping=True)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_dir.mkdir(parents=True, exist_ok=True)
    text_output = output_dir / "generated_text.txt"
    text_output.write_text(RESULT["generated_text"], encoding="utf-8")