{% set repo_id = repo_id | default("valhalla/t5-small-qg-prepend") %}
{% set device = device | default("cuda:0") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set num_beams = num_beams | default(4) %}
{% set input_text = input_text | default('prepend: The Apollo program was the third United States human spaceflight program carried out by NASA, which accomplished landing the first humans on the Moon from 1969 to 1972.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
input_text = "{{ input_text }}"

import os
import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model_dir = os.path.dirname(weights_path)
tokenizer = T5Tokenizer(vocab_file=spiece_path)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
