{% set repo_id = repo_id | default("ggml-org/gemma-1.1-7b-it-Q4_K_M-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-1.1-7b-it.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short inspirational sentence about persistence.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith('cuda') else 0
llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=max(1, (os.cpu_count() or 1) // 2),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

result = llm(prompt, max_tokens=64, temperature=0.7, top_p=0.95)
text = result['choices'][0]['text']

RESULT = {"text": text, "raw": result}
