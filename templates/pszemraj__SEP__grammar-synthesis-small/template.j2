{% set repo_id = repo_id | default("pszemraj/grammar-synthesis-small") %}
{% set device = device | default("cuda:0") %}
{% set max_length = max_length | default(128) %}
{% set min_length = min_length | default(4) %}
{% set num_beams = num_beams | default(8) %}
{% set repetition_penalty = repetition_penalty | default(1.21) %}
{% set length_penalty = length_penalty | default(1.0) %}
{% set early_stopping = early_stopping | default(true) %}
{% set input_text = input_text | default('i can has cheezburger') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}
input_text = {{ input_text | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
spiece_dir = os.path.dirname(spiece_path)

tokenizer = AutoTokenizer.from_pretrained(spiece_dir, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        min_length=min_length,
        num_beams=num_beams,
        repetition_penalty=repetition_penalty,
        length_penalty=length_penalty,
        early_stopping=early_stopping,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"input_text": input_text, "output_text": output_text}
