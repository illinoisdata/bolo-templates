{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("pszemraj/grammar-synthesis-small") %}
{% set input_text = input_text | default("i can has cheezburger") %}
{% set max_length = max_length | default(128) %}
{% set min_length = min_length | default(4) %}
{% set num_beams = num_beams | default(8) %}
{% set repetition_penalty = repetition_penalty | default(1.21) %}
{% set length_penalty = length_penalty | default(1.0) %}
{% set early_stopping = early_stopping | default(true) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt", truncation=True).to(device)

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    repetition_penalty=repetition_penalty,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
)

decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
correction = decoded_texts[0]
RESULT = {"correction": correction}
