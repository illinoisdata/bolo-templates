{% set repo_id = repo_id | default("Salesforce/codet5-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("def greet(user): print(f'hello <extra_id_0>!')") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from huggingface_hub import hf_hub_download
from transformers import RobertaTokenizer, T5ForConditionalGeneration, T5Config
import torch

vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

config = T5Config.from_json_file(config_path)
tokenizer = RobertaTokenizer(vocab_file=vocab_path, merges_file=merges_path)
state_dict = torch.load(weights_path, map_location="cpu")
model = T5ForConditionalGeneration(config)
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
output_ids = model.generate(**inputs, max_length=8)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
