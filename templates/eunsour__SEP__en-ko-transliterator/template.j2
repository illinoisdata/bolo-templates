{% set input_text = "transformer" %}
{% set src_lang = "en" %}
{% set tgt_lang = "ko" %}
{% set max_length = 64 %}
{% set num_beams = 5 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/eunsour__SEP__en-ko-transliterator" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id, src_lang=src_lang, tgt_lang=tgt_lang)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(  # max_length and num_beams encourage quality generation
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded_strings = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"transliteration": decoded_strings}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    transliteration_path = output_path / "transliteration.txt"
    transliteration_path.write_text("\n".join(RESULT["transliteration"]), encoding="utf-8")