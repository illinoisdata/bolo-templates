{% set device = "cuda:0" %}
{% set repo_id = "eunsour/en-ko-transliterator" %}
{% set input_text = "transformer" %}
{% set src_lang = "en" %}
{% set tgt_lang = "ko" %}
{% set max_length = 64 %}
{% set num_beams = 5 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id, src_lang=src_lang, tgt_lang=tgt_lang)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(  # max_length and num_beams encourage quality generation
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
)

decoded_strings = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"transliteration": decoded_strings}
