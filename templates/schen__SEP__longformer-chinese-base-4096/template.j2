{% set repo_id = repo_id | default("schen/longformer-chinese-base-4096") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('今天天气很好，我们一起去公园散步。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForPreTraining

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model = AutoModelForPreTraining.from_pretrained(os.path.dirname(weights_path), local_files_only=True)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(vocab_path), local_files_only=True, use_fast=False)
inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=4096)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "prediction_logits": outputs.prediction_logits.detach().cpu(),
    "seq_relationship_logits": outputs.seq_relationship_logits.detach().cpu(),
}
