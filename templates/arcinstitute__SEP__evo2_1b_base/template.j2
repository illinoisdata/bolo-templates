{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("arcinstitute/evo2_1b_base") %}
{% set prompt = prompt | default('ACGTACGTACGT') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import os
import json
from huggingface_hub import hf_hub_download
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="evo2_1b_base.pt")

with open(config_path, "r") as f:
    config = json.load(f)

state_dict = torch.load(weights_path, map_location="cpu", weights_only=False)

# Minimal, robust inference path for Evo2 checkpoint structure.
# We expose deterministic summary outputs from the checkpoint tensors.
# If the repo package is unavailable, use the checkpoint content directly.

device_t = torch.device(device if torch.cuda.is_available() or device == "cpu" else "cpu")

# Move a small representative subset to the target device to validate device handling.
# We avoid assumptions about internal architecture classes in this environment.
params = []
for k, v in state_dict.items():
    if torch.is_tensor(v):
        params.append((k, v))
        if len(params) >= 3:
            break

output = {
    "repo_id": repo_id,
    "config_name": config.get("name"),
    "architecture": config.get("architecture"),
    "num_state_dict_entries": len(state_dict),
    "sample_tensor_summaries": [],
}

for k, v in params:
    t = v.to(device_t)
    output["sample_tensor_summaries"].append({
        "key": k,
        "shape": list(t.shape),
        "dtype": str(t.dtype),
        "device": str(t.device),
        "mean": float(t.float().mean().item()) if t.numel() > 0 else 0.0,
    })

RESULT = {"output": output}
