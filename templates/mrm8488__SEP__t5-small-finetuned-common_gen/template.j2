{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("mrm8488/t5-small-finetuned-common_gen") %}
{% set input_text = input_text | default("apples, oranges, and bananas") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model.eval()

tokenizer_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
tokenizer_inputs = tokenizer_inputs.to(torch_device)

generated_ids = model.generate(
    **tokenizer_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
