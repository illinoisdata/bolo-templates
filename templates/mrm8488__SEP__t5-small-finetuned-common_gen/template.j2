{% set repo_id = repo_id | default("mrm8488/t5-small-finetuned-common_gen") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('generate a sentence with: cat, tree, park') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM, T5Tokenizer
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

_tokenizer = T5Tokenizer(vocab_file=spiece_file)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
_model.to(device)
_model.eval()

inputs = _tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = _model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        early_stopping=True,
        no_repeat_ngram_size=3,
    )

output_text = _tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
