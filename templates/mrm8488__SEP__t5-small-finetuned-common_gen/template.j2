{% set input_text = "apples, oranges, and bananas" %}
{% set max_length = 50 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/mrm8488__SEP__t5-small-finetuned-common_gen" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model.eval()

tokenizer_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=512,
)
tokenizer_inputs = tokenizer_inputs.to(torch_device)

generated_ids = model.generate(
    **tokenizer_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    generated_file = output_path / "generated_texts.txt"
    generated_file.write_text("\n".join(RESULT["generated_texts"]), encoding="utf-8")