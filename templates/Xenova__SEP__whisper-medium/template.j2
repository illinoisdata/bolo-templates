{% set repo_id = repo_id | default("Xenova/whisper-medium") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set language = language | default('en') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
language = "{{ language }}"

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor, WhisperForConditionalGeneration
import soundfile as sf
from types import SimpleNamespace

encoder_path = hf_hub_download(repo_id=repo_id, filename="onnx/encoder_model.onnx")

tokenizer = AutoProcessor.from_pretrained(repo_id)

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    from io import BytesIO
    audio_array, sampling_rate = sf.read(BytesIO(requests.get(audio_path).content))
else:
    audio_array, sampling_rate = sf.read(audio_path)

if audio_array.ndim == 2:
    audio_array = audio_array.mean(axis=1)
if sampling_rate != 16000:
    import librosa
    audio_array = librosa.resample(audio_array.astype(np.float32), orig_sr=sampling_rate, target_sr=16000)
    sampling_rate = 16000

inputs = tokenizer(audio_array, sampling_rate=sampling_rate, return_tensors="pt")
input_features = inputs.input_features.to(device)

model = WhisperForConditionalGeneration.from_pretrained("openai/whisper-medium")
model.to(device)
model.eval()
forced_decoder_ids = tokenizer.get_decoder_prompt_ids(language=language, task=task)

with torch.no_grad():
    generated_ids = model.generate(input_features, forced_decoder_ids=forced_decoder_ids)

transcription = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": transcription}
