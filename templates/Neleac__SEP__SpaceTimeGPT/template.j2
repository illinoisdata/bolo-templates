repo_id = "{{ repo_id }}"
device = "{{ device }}"
video_path = "{{ video_path }}"
min_length = {{ min_length }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
image_processor_repo = "{{ image_processor_repo }}"
tokenizer_repo = "{{ tokenizer_repo }}"

from io import BytesIO
from pathlib import Path

import av
import numpy as np
import requests
import torch
from transformers import AutoImageProcessor, AutoTokenizer, VisionEncoderDecoderModel

torch_device = torch.device(device)

processor = AutoImageProcessor.from_pretrained(image_processor_repo)
tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo)
if tokenizer.pad_token_id is None:
    tokenizer.pad_token_id = tokenizer.eos_token_id

model = VisionEncoderDecoderModel.from_pretrained(repo_id).to(torch_device)
model.eval()

def _is_remote_path(path: str) -> bool:
    lower_path = path.lower()
    return lower_path.startswith("http://") or lower_path.startswith("https://")

def _read_video_frames(source: str, target_frame_count: int):
    target_frame_count = max(1, int(target_frame_count))
    if _is_remote_path(source):
        response = requests.get(source)
        response.raise_for_status()
        container = av.open(BytesIO(response.content))
    else:
        container = av.open(source)
    frames = [frame.to_ndarray(format="rgb24") for frame in container.decode(video=0)]
    container.close()
    if not frames:
        raise ValueError("No frames could be decoded from the provided video source.")
    total_frames = len(frames)
    max_index = total_frames - 1
    indices = np.linspace(0, max_index, num=target_frame_count, dtype=np.int64)
    return [frames[int(idx)] for idx in indices]

encoder_config = model.config.encoder
expected_frames = getattr(encoder_config, "num_frames", None)
expected_frames = int(expected_frames) if expected_frames is not None else 8
video_frames = _read_video_frames(video_path, expected_frames)

pixel_values = processor(video_frames, return_tensors="pt").pixel_values.to(torch_device)

generation_kwargs = {
    "max_length": max_length,
    "min_length": min_length,
    "num_beams": num_beams,
    "early_stopping": True,
}

decoder_start_token_id = model.config.decoder_start_token_id
if decoder_start_token_id is None:
    decoder_start_token_id = tokenizer.eos_token_id

eos_token_id = tokenizer.eos_token_id
pad_token_id = tokenizer.pad_token_id

with torch.no_grad():
    generated_ids = model.generate(
        pixel_values,
        pad_token_id=pad_token_id,
        eos_token_id=eos_token_id,
        decoder_start_token_id=decoder_start_token_id,
        **generation_kwargs,
    )

caption = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0].strip()

RESULT = {"caption": caption}
