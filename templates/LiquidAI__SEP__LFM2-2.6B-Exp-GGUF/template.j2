{% set repo_id = repo_id | default("LiquidAI/LFM2-2.6B-Exp-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("LFM2-2.6B-Exp-Q4_K_M.gguf") %}
{% set prompt = prompt | default("Write a short haiku about edge AI.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_ctx = 256
n_threads = max(1, os.cpu_count() or 1)
n_gpu_layers = 0
if str(device).startswith("cuda"):
    n_gpu_layers = -1

llm = Llama(
    model_path=model_path,
    n_ctx=n_ctx,
    n_threads=n_threads,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.95,
    stop=["</s>"],
)

RESULT = {"text": output["choices"][0]["text"]}
