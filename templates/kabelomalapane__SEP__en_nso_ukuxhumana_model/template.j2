{% set repo_id = repo_id | default("kabelomalapane/en_nso_ukuxhumana_model") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Hello, how are you today?") %}
{% set num_beams = num_beams | default(4) %}
{% set max_input_length = max_input_length | default(128) %}
{% set max_generation_length = max_generation_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
num_beams = {{ num_beams }}
max_input_length = {{ max_input_length }}
max_generation_length = {{ max_generation_length }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    source_text,
    return_tensors="pt",
    padding="longest",
    truncation=True,
    max_length=max_input_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_generation_length,
)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"translation": translation}
