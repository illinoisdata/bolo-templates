{% set repo_id = "kabelomalapane/en_nso_ukuxhumana_model" %}
{% set device = "cuda:0" %}
{% set source_text = "Hello, how are you today?" %}
{% set num_beams = 4 %}
{% set max_input_length = 128 %}
{% set max_generation_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/kabelomalapane__SEP__en_nso_ukuxhumana_model" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
num_beams = {{ num_beams }}
max_input_length = {{ max_input_length }}
max_generation_length = {{ max_generation_length }}
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    source_text,
    return_tensors="pt",
    padding="longest",
    truncation=True,
    max_length=max_input_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_generation_length,
)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")