{% set repo_id = repo_id | default("emilyalsentzer/Bio_Discharge_Summary_BERT") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("fill-mask") %}
{% set masked_prompt = masked_prompt | default("The patient is {mask} for hypertension.") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
masked_prompt = {{ masked_prompt | tojson }}

import torch
from transformers import pipeline

torch_device = torch.device(device)
if torch_device.type == "cuda" and torch.cuda.is_available():
    pipeline_device = torch_device.index if torch_device.index is not None else 0
else:
    pipeline_device = -1

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace("{mask}", mask_token)
RESULT = pipe(text)
