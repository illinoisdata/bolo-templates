{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-hi-en" %}
{% set input_text = "यह एक परीक्षण वाक्य है।" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input text
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

# Run inference
generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

# Post-process output
decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_texts[0].strip()

# Prepare RESULT dictionary
RESULT = {"translation": translation}
