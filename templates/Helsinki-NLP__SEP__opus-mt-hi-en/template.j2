{% set input_text = "यह एक परीक्षण वाक्य है।" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-hi-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input text
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

# Run inference
generated_tokens = model.generate(
    **encoded_inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

# Post-process output
decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_texts[0].strip()

# Prepare RESULT dictionary
RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    translation_path = output_path / "translation.txt"
    translation_path.write_text(RESULT["translation"], encoding="utf-8")