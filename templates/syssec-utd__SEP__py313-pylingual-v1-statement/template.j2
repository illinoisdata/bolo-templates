{% set repo_id = repo_id | default("syssec-utd/py313-pylingual-v1-statement") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt|default('def add(a, b):\n    return a + b\n') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
state_dict = load_file(model_file)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=128, num_beams=4, early_stopping=True)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
