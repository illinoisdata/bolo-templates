{% set input_text = "Summarize the following policy guidelines on secure coding practices." %}
{% set max_new_tokens = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/syssec-utd__SEP__py313-pylingual-v1-statement" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.inference_mode():
    generated_tokens = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
    )

generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    text_path = output_path / "generated_texts.txt"
    with text_path.open("w", encoding="utf-8") as output_file:
        for line in generated_texts:
            output_file.write(f"{line}\n")