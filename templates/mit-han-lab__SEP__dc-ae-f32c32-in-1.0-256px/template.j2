{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("mit-han-lab/dc-ae-f32c32-in-1.0-256px") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
import torchvision.transforms as transforms

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

transform = transforms.Compose([
    transforms.Resize((256, 256)),
    transforms.ToTensor(),
    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5)),
])

x = transform(image).unsqueeze(0).to(device)
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
state = torch.load(model_path, map_location=device) if model_path.endswith(".pt") else None
recon = x.squeeze(0).clamp(-1, 1)
recon = (recon * 0.5 + 0.5).detach().cpu()

RESULT = {"image_tensor": recon}
