{% set repo_id = repo_id | default("trl-internal-testing/tiny-DbrxForCausalLM") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") -%}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") -%}
{% set model_kwargs = model_kwargs | default({"ignore_mismatched_sizes": True}) -%}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
model_kwargs = {{ model_kwargs | tojson | replace('true', 'True') | replace('false', 'False') | replace('null', 'None') }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device, model_kwargs=model_kwargs)
RESULT = pipe(input_prompt)
