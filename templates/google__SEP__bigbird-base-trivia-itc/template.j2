{% set repo_id = repo_id | default("google/bigbird-base-trivia-itc") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('France is a country in Western Europe. Its capital and most populous city is Paris.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, BigBirdForQuestionAnswering

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

local_dir = os.path.dirname(model_path)
tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=False)
model = BigBirdForQuestionAnswering.from_pretrained(local_dir)
model.to(device)
model.eval()

encoded = tokenizer(question, context, return_tensors="pt", truncation=True)
encoded = {k: v.to(device) for k, v in encoded.items()}
with torch.no_grad():
    outputs = model(**encoded)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx
input_ids = encoded["input_ids"][0][start_idx:end_idx + 1]
answer = tokenizer.decode(input_ids, skip_special_tokens=True).strip()

RESULT = {
    "start_logits": start_logits.detach().cpu(),
    "end_logits": end_logits.detach().cpu(),
    "answer": answer,
}
