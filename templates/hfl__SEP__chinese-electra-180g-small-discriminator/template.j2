{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("hfl/chinese-electra-180g-small-discriminator") %}
{% set text = text | default("这是一个用于测试的中文输入。") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from pathlib import Path
import json

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

tokenized = tokenizer(text, return_tensors="pt")
tokenized = {key: value.to(device) for key, value in tokenized.items()}
with torch.no_grad():
    outputs = model(**tokenized)

logits = outputs.logits
RESULT = {"logits": logits.cpu().tolist()}
