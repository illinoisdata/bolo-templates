{% set repo_id = repo_id | default("mattmdjaga/segformer_b2_clothes") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-segmentation") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
image_path = "{{ image_path }}"

from transformers import pipeline, SegformerImageProcessor
from PIL import Image

processor = SegformerImageProcessor.from_pretrained(repo_id)

pipe = pipeline(
    task=task,
    model=repo_id,
    image_processor=processor,
    device=device,
)

image = Image.open(image_path)

RESULT = pipe(image)
