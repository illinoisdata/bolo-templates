{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-sk") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The house is wonderful and the garden is beautiful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import MarianMTModel, MarianTokenizer

model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()
tokenizer = MarianTokenizer.from_pretrained(repo_id)

batch = tokenizer([text], return_tensors="pt", padding=True, truncation=True)
batch = {k: v.to(device) for k, v in batch.items()}

with torch.no_grad():
    generated = model.generate(**batch, num_beams=4, max_length=128)

output_text = tokenizer.batch_decode(generated, skip_special_tokens=True)[0]
RESULT = {"translation": output_text}
