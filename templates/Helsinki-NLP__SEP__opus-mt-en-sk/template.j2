{% set repo_id = "Helsinki-NLP/opus-mt-en-sk" %}
{% set device = "cuda:0" %}
{% set source_text = "The world needs more peace." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
device_obj = torch.device(device)
model = model.to(device_obj)

inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True)
inputs = {key: value.to(device_obj) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, num_beams=4, max_length=256)
translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
