{% set repo_id = repo_id | default("microsoft/GODEL-v1_1-large-seq2seq") %}
{% set device = device | default("cuda:0") %}
{% set instruction = instruction | default('Instruction: given a dialog context, you need to response empathically.') %}
{% set knowledge = knowledge | default('') %}
{% set dialog = dialog | default(['Does money buy happiness?', 'It is a question. Money buys you a lot of things, but not enough to buy happiness.', 'What is the best way to buy happiness ?']) %}
{% set max_length = max_length | default(128) %}
{% set min_length = min_length | default(8) %}
{% set top_p = top_p | default(0.9) %}
{% set do_sample = do_sample | default(true) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
instruction = {{ instruction | tojson }}
knowledge = {{ knowledge | tojson }}
dialog = {{ dialog | tojson }}
max_length = {{ max_length }}
min_length = {{ min_length }}
top_p = {{ top_p }}
do_sample = {{ 'True' if do_sample else 'False' }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = model.to(device)
model.eval()

def generate(instruction, knowledge, dialog):
    if knowledge != '':
        knowledge = '[KNOWLEDGE] ' + knowledge
    dialog = ' EOS '.join(dialog)
    query = f"{instruction} [CONTEXT] {dialog} {knowledge}".strip()
    input_ids = tokenizer(query, return_tensors="pt").input_ids.to(device)
    outputs = model.generate(
        input_ids,
        max_length=max_length,
        min_length=min_length,
        top_p=top_p,
        do_sample=do_sample,
    )
    return tokenizer.decode(outputs[0], skip_special_tokens=True)

output = generate(instruction, knowledge, dialog)
RESULT = {"output": output}
