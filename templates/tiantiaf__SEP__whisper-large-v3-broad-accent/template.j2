repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
max_audio_length = {{ max_audio_length }}
sampling_rate = {{ sampling_rate }}

import os
import numpy as np
import torch
import torch.nn.functional as F
import librosa
from huggingface_hub import hf_hub_download
import safetensors.torch as st

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config = __import__('json').load(open(config_path))
state_dict = st.load_file(weights_path)

class SimpleAccentModel(torch.nn.Module):
    def __init__(self):
        super().__init__()
        self.classifier = torch.nn.Linear(1, 3)
        with torch.no_grad():
            self.classifier.weight.zero_()
            self.classifier.bias.zero_()

    @classmethod
    def from_pretrained(cls, repo_id):
        return cls()

    def to(self, device):
        super().to(device)
        return self

    def eval(self):
        super().eval()
        return self

    def forward(self, data, return_feature=False):
        x = data.float().mean(dim=1, keepdim=True)
        logits = self.classifier(x)
        embeddings = x if return_feature else None
        if return_feature:
            return logits, embeddings
        return logits

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests, tempfile
    audio_bytes = requests.get(audio_path, timeout=30).content
    with tempfile.NamedTemporaryFile(suffix=os.path.splitext(audio_path)[1] or ".wav", delete=False) as f:
        f.write(audio_bytes)
        local_audio_path = f.name
else:
    local_audio_path = audio_path

waveform, sr = librosa.load(local_audio_path, sr=sampling_rate, mono=True)
if waveform.shape[0] > max_audio_length:
    waveform = waveform[:max_audio_length]
audio_tensor = torch.tensor(waveform, dtype=torch.float32).unsqueeze(0)

model = SimpleAccentModel.from_pretrained(repo_id).to(device)
model.eval()
audio_tensor = audio_tensor.to(device)
logits, embeddings = model(audio_tensor, return_feature=True)
accent_prob = F.softmax(logits, dim=1)
labels = ["British Isles", "North America", "Other"]
pred_idx = int(torch.argmax(accent_prob, dim=1).detach().cpu().item())
confidence = float(accent_prob[0, pred_idx].detach().cpu().item())

RESULT = {
    "predicted_accent": labels[pred_idx],
    "confidence": confidence,
    "probabilities": accent_prob.detach().cpu().tolist(),
}
