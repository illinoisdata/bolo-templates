{% set device = "cuda:0" %}
{% set repo_id = "MickyMike/VulRepair" %}
{% set tokenizer_repo = "Salesforce/codet5-base" %}
{% set input_text = "Repair the following buggy Python function:\n\ndef add_numbers(a, b):\n    return a - b" %}
{% set max_length = 256 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
tokenizer_repo = "{{ tokenizer_repo }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
from transformers.tokenization_utils_base import PreTrainedTokenizerBase

_original_add_tokens = PreTrainedTokenizerBase.add_tokens

def _safe_add_tokens(self, tokens):
    return 0

PreTrainedTokenizerBase.add_tokens = _safe_add_tokens

tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
    early_stopping=True,
)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
