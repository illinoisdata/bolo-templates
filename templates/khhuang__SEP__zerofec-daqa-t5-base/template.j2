{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("khhuang/zerofec-daqa-t5-base") %}
{% set question = question | default("What is Night of the Living Dead?") %}
{% set context = context | default("Night of the Living Dead is a 1968 American independent horror film , directed by George A.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import json
import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

formatted_input = f"{question} \n {context}"
inputs = tokenizer(formatted_input, return_tensors="pt")
input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)

with torch.no_grad():
    generated_ids = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        max_length=max_length,
        num_beams=num_beams,
    )

generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"answer": generated_texts}
