{% set repo_id = repo_id | default("valhalla/t5-base-e2e-qg") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Python is a programming language. It is developed by Guido Van Rossum and released in 1991. </s>') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import T5Tokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")


tokenizer = T5Tokenizer.from_pretrained(repo_id, local_files_only=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer("generate questions: " + text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_length=64,
        num_beams=4,
        early_stopping=True,
        no_repeat_ngram_size=3,
    )

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output": output_text}
