{% set repo_id = repo_id | default("czearing/story-to-title") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('A young orphan discovers a hidden map that leads to a secret kingdom, where she must unite rival clans to prevent an ancient war.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=24,
        num_beams=4,
        early_stopping=True,
        no_repeat_ngram_size=3,
    )

title = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"title": title}
