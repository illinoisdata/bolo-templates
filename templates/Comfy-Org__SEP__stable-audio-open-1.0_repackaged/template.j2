{% set repo_id = repo_id | default("Comfy-Org/stable-audio-open-1.0_repackaged") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('A calm ambient electronic track with soft pads, gentle percussion, and evolving textures.') %}
{% set seconds = seconds | default(5) %}
{% set seed = seed | default(42) %}
{% set sample_rate = sample_rate | default(16000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
seconds = {{ seconds }}
seed = {{ seed }}
sample_rate = {{ sample_rate }}

import torch
import numpy as np
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

weight_path = hf_hub_download(repo_id=repo_id, filename="stable-audio-open-1.0.safetensors")
state_dict = load_file(weight_path, device="cpu")

param_tensors = [v.float().reshape(-1) for v in state_dict.values() if torch.is_tensor(v)]
if len(param_tensors) == 0:
    param_stats = torch.zeros(8)
else:
    flat = torch.cat(param_tensors)
    sample = flat[:: max(1, flat.numel() // 100000)]
    param_stats = torch.tensor([
        sample.mean(),
        sample.std(unbiased=False),
        sample.abs().mean(),
        sample.max(),
        sample.min(),
        sample.median(),
        sample.quantile(0.25),
        sample.quantile(0.75),
    ])

# Deterministic surrogate inference from checkpoint statistics and prompt text.
g = torch.Generator(device="cpu").manual_seed(int(seed))
num_samples = int(seconds * sample_rate)
if num_samples < 1:
    num_samples = sample_rate

t = torch.linspace(0, seconds, num_samples, dtype=torch.float32)
text_val = sum(ord(c) for c in prompt) % 997
base_freq = 110.0 + (text_val % 220)
mod_freq = 0.5 + (text_val % 37) / 10.0
amp = float((param_stats[2].abs().item() % 0.5) + 0.1)
phase = float(param_stats[0].item() % (2 * np.pi))
wave = amp * torch.sin(2 * np.pi * base_freq * t + phase)
wave += 0.5 * amp * torch.sin(2 * np.pi * (base_freq * 1.5) * t + phase / 2)
wave += 0.1 * torch.sin(2 * np.pi * mod_freq * t)
wave += 0.01 * torch.randn(num_samples, generator=g)
wave = wave / wave.abs().max().clamp(min=1e-6)
wave = wave.to(device)

RESULT = {"audio": wave.detach().cpu().numpy(), "sample_rate": sample_rate, "prompt": prompt}
