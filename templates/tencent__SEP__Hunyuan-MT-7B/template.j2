{% set repo_id = repo_id | default("tencent/Hunyuan-MT-7B") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default("Detect and convert code comments from English to Chinese to ensure localization is accurate.") %}
{% set target_language = target_language | default("Chinese") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.1) %}
{% set top_p = top_p | default(0.95) %}
{% set repetition_penalty = repetition_penalty | default(1.1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = """{{ source_text }}"""
target_language = "{{ target_language }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
repetition_penalty = {{ repetition_penalty }}
from pathlib import Path
import torch
from transformers import AutoModelForCausalLM, AutoTokenizer

device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    device_map="auto",
    torch_dtype=torch.bfloat16,
)
model.to(device)

messages = [
    {
        "role": "user",
        "content": (
            f"Translate the following segment into {target_language}, without additional explanation.\n\n"
            f"{source_text}"
        ),
    }
]
tokenized_chat = tokenizer.apply_chat_template(
    messages,
    tokenize=True,
    add_generation_prompt=False,
    return_tensors="pt",
)
tokenized_chat = tokenized_chat.to(device)

outputs = model.generate(
    **tokenized_chat,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    top_p=top_p,
    repetition_penalty=repetition_penalty,
    do_sample=False,
)

output_text = tokenizer.decode(outputs[0], skip_special_tokens=True)
RESULT = {"translation": output_text}
