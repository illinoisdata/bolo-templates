{% set repo_id = "fxmarty/speecht5-hifigan-tiny" %}
{% set device = "cuda:0" %}
{% set audio_path = "/u/yli77/projects/ML-code-generation/data/audio.wav" %}
{% set sampling_rate = 16000 %}
{% set mel_n_fft = 1024 %}
{% set mel_win_length = 1024 %}
{% set mel_hop_length = 256 %}
{% set mel_n_mels = 80 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sampling_rate = {{ sampling_rate }}
mel_n_fft = {{ mel_n_fft }}
mel_win_length = {{ mel_win_length }}
mel_hop_length = {{ mel_hop_length }}
mel_n_mels = {{ mel_n_mels }}

from transformers import SpeechT5HifiGan

import torch
import torchaudio
import numpy as np
import soundfile as sf
import requests
import io
import os

# Load model
model = SpeechT5HifiGan.from_pretrained(repo_id).to(device)

# Pre-process input
if audio_path.startswith("http"):
    response = requests.get(audio_path)
    response.raise_for_status()
    audio_bytes = io.BytesIO(response.content)
    waveform_np, sr = sf.read(audio_bytes)
else:
    waveform_np, sr = sf.read(audio_path)

waveform = torch.from_numpy(waveform_np.T if waveform_np.ndim > 1 else waveform_np[np.newaxis, :])
waveform = waveform.float()

if sr != sampling_rate:
    waveform = torchaudio.transforms.Resample(orig_freq=sr, new_freq=sampling_rate)(waveform)

# Ensure mono
if waveform.shape[0] > 1:
    waveform = waveform.mean(dim=0, keepdim=True)

# Compute mel spectrogram
mel_transform = torchaudio.transforms.MelSpectrogram(
    sample_rate=sampling_rate,
    n_fft=mel_n_fft,
    win_length=mel_win_length,
    hop_length=mel_hop_length,
    n_mels=mel_n_mels,
)
mel = mel_transform(waveform)
mel = mel.transpose(1, 2)
mel = torch.log(torch.clamp(mel, min=1e-5))
mel = mel.to(device)

# Run inference
with torch.no_grad():
    generated_audio = model(mel)

# Post-process output
generated_audio = generated_audio.squeeze(0).cpu()

# Build RESULT dict
RESULT = {"generated_audio": generated_audio}
