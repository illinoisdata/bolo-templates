{% set repo_id = repo_id | default("fxmarty/speecht5-hifigan-tiny") %}
{% set device = device | default("cuda:0") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import SpeechT5HifiGan, AutoFeatureExtractor
from scipy.io import wavfile

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

# Load model
model = SpeechT5HifiGan.from_pretrained(repo_id, torch_dtype=torch.float32).to(device)
model.eval()

# Load input audio as a source waveform if needed; this model is a vocoder,
# so we create a simple mel-spectrogram-like input from the waveform for validation.
if audio_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    import soundfile as sf
    response = requests.get(audio_path)
    response.raise_for_status()
    waveform, sr = sf.read(BytesIO(response.content))
else:
    import soundfile as sf
    waveform, sr = sf.read(audio_path)

if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)

waveform = waveform.astype(np.float32)
if sr != 16000:
    import librosa
    waveform = librosa.resample(waveform, orig_sr=sr, target_sr=16000)
    sr = 16000

# Create a deterministic pseudo-mel input for the tiny vocoder.
# Shape: [batch, time, mel_bins]
mel_bins = 80
num_frames = max(10, len(waveform) // 256)
features = np.zeros((1, num_frames, mel_bins), dtype=np.float32)
seg_len = max(1, len(waveform) // num_frames)
for i in range(num_frames):
    seg = waveform[i * seg_len:(i + 1) * seg_len]
    if seg.size == 0:
        break
    rms = np.sqrt(np.mean(seg * seg) + 1e-8)
    features[0, i, :] = rms

inputs = torch.from_numpy(features).to(device)
with torch.no_grad():
    output = model(inputs)

if isinstance(output, torch.Tensor):
    audio_out = output.detach().cpu().numpy()
else:
    audio_out = output.cpu().numpy() if hasattr(output, "cpu") else np.array(output)

RESULT = {"audio": audio_out}
