{% set repo_id = repo_id | default("optimum-intel-internal-testing/tiny-random-whisper") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set task = task | default('transcribe') %}
{% set return_timestamps = return_timestamps | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
task = "{{ task }}"
return_timestamps = {{ return_timestamps }}

import os
import requests
import torch
import librosa
from PIL import Image
from transformers import WhisperForConditionalGeneration, WhisperProcessor
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

if str(audio_path).startswith(("http://", "https://")):
    audio_local_path = requests.get(audio_path, timeout=30).content
    import tempfile
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        f.write(audio_local_path)
        audio_local_path = f.name
else:
    audio_local_path = audio_path

processor = WhisperProcessor.from_pretrained(os.path.dirname(processor_config_path))
model = WhisperForConditionalGeneration.from_pretrained(os.path.dirname(model_path), torch_dtype=torch.float32)
model.to(device)
model.eval()

speech, sampling_rate = librosa.load(audio_local_path, sr=16000)
inputs = processor(speech, sampling_rate=sampling_rate, return_tensors="pt")
input_features = inputs.input_features.to(device)

forced_decoder_ids = processor.get_decoder_prompt_ids(language="en", task=task)
with torch.no_grad():
    generated_ids = model.generate(input_features, forced_decoder_ids=forced_decoder_ids, return_timestamps=return_timestamps)
transcription = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"text": transcription}
