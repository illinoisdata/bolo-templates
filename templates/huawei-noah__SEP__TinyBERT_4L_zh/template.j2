{% set repo_id = repo_id | default("huawei-noah/TinyBERT_4L_zh") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('今天天气很好。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import json
import os
import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertModel

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

with open(config_path, "r", encoding="utf-8") as f:
    config = json.load(f)

tokenizer = BertTokenizer(vocab_file=vocab_path)
model = BertModel.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    last_hidden_state = outputs.last_hidden_state
    pooled = last_hidden_state[:, 0, :]
    embedding_norm = pooled.norm(dim=-1).detach().cpu().tolist()
    token_count = int(inputs["input_ids"].shape[1])

RESULT = {
    "embedding_norm": embedding_norm,
    "token_count": token_count,
}
