{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "They were there to enjoy us and they were there to pray for us." %}
{% set max_length = 60 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/eugenesiow__SEP__bart-paraphrase" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(input_text, return_tensors="pt")
encoded = {key: value.to(device) for key, value in encoded.items()}

with torch.no_grad():
    generated_ids = model.generate(**encoded, max_length=max_length, num_beams=num_beams, early_stopping=True)

paraphrases = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"paraphrases": paraphrases}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "paraphrases.txt")
    with open(output_path, "w", encoding="utf-8") as output_file:
        output_file.write("\n".join(RESULT["paraphrases"]))