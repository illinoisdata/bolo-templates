{% set repo_id = repo_id | default("laion/clap-htsat-unfused") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-audio-classification") %}
{% set audio_input = audio_input | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set candidate_labels = candidate_labels | default(["Sound of a dog", "Sound of vacuum cleaner"]) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
audio_input = {{ audio_input | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(audio_input, candidate_labels=candidate_labels)
