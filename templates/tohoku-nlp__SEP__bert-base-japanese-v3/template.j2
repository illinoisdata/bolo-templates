{% set repo_id = repo_id | default("tohoku-nlp/bert-base-japanese-v3") %}
{% set device = device | default("cuda:0") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_length = {{ max_length }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForMaskedLM

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

text = "{{ text if text is defined else '東北大学で[MASK]の研究をしています。' }}"

if isinstance(text, str) and text.startswith(("http://", "https://")):
    raise ValueError("Text input must be a local string, not a URL")

# Load tokenizer and model from the downloaded repository files
local_dir = os.path.dirname(model_file)
tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=False)
model = AutoModelForMaskedLM.from_pretrained(local_dir)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=max_length)
inputs = {k: v.to(device) for k, v in inputs.items()}

mask_token_id = tokenizer.mask_token_id
mask_positions = (inputs["input_ids"] == mask_token_id).nonzero(as_tuple=False)

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits

if mask_positions.numel() > 0:
    topk = torch.topk(logits[mask_positions[:, 0], mask_positions[:, 1]], k=5, dim=-1)
    predictions = []
    for idx in range(mask_positions.shape[0]):
        token_ids = topk.indices[idx].tolist()
        scores = topk.values[idx].tolist()
        predictions.append([
            {"token": tokenizer.convert_ids_to_tokens(tid), "score": float(score)}
            for tid, score in zip(token_ids, scores)
        ])
else:
    predictions = []

RESULT = {
    "text": text,
    "mask_predictions": predictions,
}
