{% set repo_id = "microsoft/codereviewer" %}
{% set device = "cuda:0" %}
{% set input_text = "Review the following Python function for potential issues and improvements." %}
{% set max_length = 512 %}
{% set generation_max_length = 256 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/microsoft__SEP__codereviewer" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
generation_max_length = {{ generation_max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(
    input_text,
    padding="longest",
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
encoded = {key: value.to(device) for key, value in encoded.items()}

generated = model.generate(
    **encoded,
    max_new_tokens=generation_max_length,
    num_beams=num_beams,
    early_stopping=True,
)
review_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"code_review": review_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "code_review.txt")
    with open(output_path, "w", encoding="utf-8") as output_file:
        output_file.write(RESULT["code_review"])