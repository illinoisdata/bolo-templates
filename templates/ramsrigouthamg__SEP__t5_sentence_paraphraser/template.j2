{% set device = "cuda:0" %}
{% set repo_id = "ramsrigouthamg/t5_sentence_paraphraser" %}
{% set input_text = "paraphrase: The quick brown fox jumps over the lazy dog." %}
{% set max_new_tokens = 64 %}
{% set num_beams = 4 %}
{% set early_stopping = True %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
early_stopping = {{ early_stopping }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device_obj = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device_obj)
model.eval()

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device_obj) for key, value in encoded_inputs.items()}
with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        early_stopping=early_stopping,
    )

paraphrased_text = tokenizer.decode(
    generated_tokens[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
RESULT = {"paraphrased_text": paraphrased_text}
