repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import json
from urllib.parse import urlparse

import numpy as np
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from torchvision import transforms

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

parsed = urlparse(image_path)
if parsed.scheme in ("http", "https"):
    import requests
    from io import BytesIO
    img = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    img = Image.open(image_path).convert("RGB")

img = img.resize((224, 224), Image.BICUBIC)
img_tensor = transforms.ToTensor()(img)
img_tensor = transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225))(img_tensor)
img_tensor = img_tensor.unsqueeze(0).to(device)

from torchvision.models import vit_b_16, ViT_B_16_Weights
model = vit_b_16(weights=None)
model.heads = torch.nn.Identity()
model = model.to(device)
model.eval()

with torch.no_grad():
    features = model(img_tensor)

RESULT = {"output": features.detach().float().cpu().numpy()}
