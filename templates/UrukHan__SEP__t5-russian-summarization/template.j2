{% set device = "cuda:0" %}
{% set repo_id = "UrukHan/t5-russian-summarization" %}
{% set input_texts = ["Запад после начала российской специальной операции по демилитаризации Украины ввел несколько раундов новых экономических санкций. В Кремле новые ограничения назвали серьезными, но отметили, что Россия готовилась к ним заранее."] %}
{% set prefix = "summarize: " %}
{% set max_length = 200 %}
{% set min_length = 30 %}
{% set num_beams = 4 %}
{% set length_penalty = 2.0 %}
{% set no_repeat_ngram_size = 3 %}
{% set early_stopping = true %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_texts = {{ input_texts }}
prefix = "{{ prefix }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
prefixed_texts = [prefix + text for text in input_texts]
encoded_inputs = tokenizer(
    prefixed_texts,
    padding="longest",
    truncation=True,
    max_length=max_length,
    return_tensors="pt",
)
input_ids = encoded_inputs.input_ids.to(device)
attention_mask = encoded_inputs.attention_mask.to(device)

# Run inference
outputs = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    length_penalty=length_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)

# Post-process outputs
summaries = tokenizer.batch_decode(outputs, skip_special_tokens=True)

RESULT = {"summaries": summaries}
