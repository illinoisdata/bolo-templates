{% set repo_id = repo_id | default("docling-project/docling-layout-heron-101") %}
{% set device = device | default("cuda:0") %}
{% set threshold = threshold | default(0.6) %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
threshold = {{ threshold }}
image_path = "{{ image_path }}"

import requests
import torch
from PIL import Image
from transformers import RTDetrV2ForObjectDetection, RTDetrImageProcessor

classes_map = {
    0: "Caption",
    1: "Footnote",
    2: "Formula",
    3: "List-item",
    4: "Page-footer",
    5: "Page-header",
    6: "Picture",
    7: "Section-header",
    8: "Table",
    9: "Text",
    10: "Title",
    11: "Document Index",
    12: "Code",
    13: "Checkbox-Selected",
    14: "Checkbox-Unselected",
    15: "Form",
    16: "Key-Value Region",
}

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw)
else:
    image = Image.open(image_path)
image = image.convert("RGB")

image_processor = RTDetrImageProcessor.from_pretrained(repo_id)
model = RTDetrV2ForObjectDetection.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = image_processor(images=[image], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
results = image_processor.post_process_object_detection(
    outputs,
    target_sizes=torch.tensor([image.size[::-1]], device=device),
    threshold=threshold,
)

output = []
for result in results:
    for score, label_id, box in zip(result["scores"], result["labels"], result["boxes"]):
        output.append({
            "label": classes_map[int(label_id.item())],
            "score": round(float(score.item()), 4),
            "box": [round(float(i), 2) for i in box.tolist()],
        })

RESULT = {"detections": output}
