{% set repo_id = repo_id | default("imageomics/bioclip") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set texts = texts | default(['a photo of a bird', 'a photo of a flower', 'a photo of a mushroom', 'a photo of a butterfly', 'a photo of a fish']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
texts = {{ texts }}

import json
import os
from pathlib import Path

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
import open_clip

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

with open(config_path, "r") as f:
    cfg = json.load(f)

pretrained_cfg = cfg.get("preprocess_cfg", {})
model_name = cfg.get("model_cfg", {}).get("vision_cfg", {}).get("layers", None)
model_name = cfg.get("model_name", "ViT-B-16")

model, _, preprocess = open_clip.create_model_and_transforms(
    model_name,
    pretrained=None,
    device=device,
)
state_dict = torch.load(weights_path, map_location="cpu")
if isinstance(state_dict, dict) and "state_dict" in state_dict:
    state_dict = state_dict["state_dict"]
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model = model.to(device).eval()

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = open_clip.tokenize(texts).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logit_scale = model.logit_scale.exp()
    logits = logit_scale * image_features @ text_features.T
    probs = logits.softmax(dim=-1).squeeze(0)

best_idx = int(probs.argmax().item())
RESULT = {
    "texts": texts,
    "probabilities": probs.detach().cpu().tolist(),
    "top_text": texts[best_idx],
    "top_probability": float(probs[best_idx].item()),
}
