{% set repo_id = repo_id | default("google-t5/t5-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Studies have been shown that owning a dog is good for you') %}
{% set task_prefix = task_prefix | default('translate English to German: ') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
task_prefix = "{{ task_prefix }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=True,
    tokenizer_file=tokenizer_json_path,
    vocab_file=spiece_path,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model = model.to(device)
model.eval()

inputs = tokenizer(task_prefix + text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
