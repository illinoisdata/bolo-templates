{% set repo_id = repo_id | default("google-t5/t5-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("translate English to German: The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(100) %}
{% set num_beams = num_beams | default(4) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True)
encoded_inputs = {k: tensor.to(device) for k, tensor in encoded_inputs.items()}

# Run inference
generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)

# Post-process output
decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_outputs[0]

RESULT = {"translation": translation}
