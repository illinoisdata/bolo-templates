{% set repo_id = repo_id | default("timm/resnet50d.a1_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

{% set extra_outputs = extra_outputs | default("predictions") %}

task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
extra_outputs = {{ extra_outputs | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
preprocessed_input = input_image
pipeline_output = pipe(preprocessed_input)
RESULT = {extra_outputs: pipeline_output}
