{% set repo_id = repo_id | default("microsoft/markuplm-base") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default("<html><body><p>Hello world!</p></body></html>") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from transformers import AutoTokenizer, AutoModel
import torch
import os
import numpy as np

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

features = outputs.last_hidden_state.cpu().numpy()

RESULT = {
    "features": features,
}
