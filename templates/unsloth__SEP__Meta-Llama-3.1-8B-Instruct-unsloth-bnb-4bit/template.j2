{% set repo_id = repo_id | default("unsloth/Meta-Llama-3.1-8B-Instruct-unsloth-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you today?") %}
{% set generation_kwargs = generation_kwargs | default({"max_new_tokens": 256, "temperature": 0.7}) %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
generation_kwargs = {{ generation_kwargs | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
raw_outputs = pipe(input_prompt, **generation_kwargs)

RESULT = {"outputs": raw_outputs}
