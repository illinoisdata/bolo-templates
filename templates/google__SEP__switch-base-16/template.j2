{% set input_text = "A <extra_id_0> walks into a bar and orders a <extra_id_1> with a <extra_id_2> pinch of <extra_id_3>." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__switch-base-16" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
input_ids = encoded_inputs.input_ids.to(device)
attention_mask = (
    encoded_inputs.attention_mask.to(device)
    if "attention_mask" in encoded_inputs
    else None
)
model_inputs = {"input_ids": input_ids}
if attention_mask is not None:
    model_inputs["attention_mask"] = attention_mask

generated_outputs = model.generate(**model_inputs)
sequence = generated_outputs[0]
decoded_output = tokenizer.decode(sequence, skip_special_tokens=True)

RESULT = {"generated_text": decoded_output}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    (Path(output_dir) / "generated_text.txt").write_text(
        RESULT["generated_text"], encoding="utf-8"
    )