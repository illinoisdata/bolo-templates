{% set repo_id = repo_id | default("google/switch-base-16") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('A <extra_id_0> walks into a bar a orders a <extra_id_1> with <extra_id_2> pinch of <extra_id_3>.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, SwitchTransformersForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
generation_config_file = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

# Load tokenizer/model from the downloaded repo files' directory
repo_dir = "/".join(model_file.split("/")[:-1])
tokenizer = AutoTokenizer.from_pretrained(repo_dir)
model = SwitchTransformersForConditionalGeneration.from_pretrained(repo_dir)
model = model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(**inputs)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=False)

RESULT = {"output_text": output_text}
