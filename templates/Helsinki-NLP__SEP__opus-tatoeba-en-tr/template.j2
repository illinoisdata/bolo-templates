{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-tatoeba-en-tr" %}
{% set source_text = "Hello, this is a test translation from English to Turkish." %}
{% set max_length = 200 %}
{% set num_beams = 6 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0] if translations else ""
RESULT = {"translation": translation}
if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")