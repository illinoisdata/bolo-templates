{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ru-fr") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Привет, как дела?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

model = MarianMTModel.from_pretrained(repo_id).to(device)
tokenizer = MarianTokenizer(vocab=hf_hub_download(repo_id=repo_id, filename="vocab.json"), source_spm=source_spm_path, target_spm=target_spm_path)

inputs = tokenizer([text], return_tensors="pt", padding=True, truncation=True).to(device)
with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6, max_length=128)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
