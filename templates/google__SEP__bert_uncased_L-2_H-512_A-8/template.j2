{% set device = "cuda:0" %}
{% set repo_id = "google/bert_uncased_L-2_H-512_A-8" %}
{% set input_text = "The capital of France is [MASK]." %}
{% set num_predictions = 5 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_predictions = {{ num_predictions }}

import json
from pathlib import Path

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(input_text, return_tensors="pt")
encoded = {key: tensor.to(device) for key, tensor in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)

logits = outputs.logits
mask_token_id = tokenizer.mask_token_id
mask_positions = (encoded["input_ids"] == mask_token_id).nonzero(as_tuple=True)
mask_index = mask_positions[1][0]
mask_logits = logits[0, mask_index, :]
probabilities = torch.softmax(mask_logits, dim=-1)
topk = torch.topk(probabilities, k=num_predictions)
topk_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
topk_scores = topk.values.tolist()

predictions = [
    {"token": token, "score": score}
    for token, score in zip(topk_tokens, topk_scores)
]

RESULT = {"predictions": predictions}
