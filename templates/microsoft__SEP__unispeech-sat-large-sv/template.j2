{% set repo_id = repo_id | default("microsoft/unispeech-sat-large-sv") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set target_audio_path = target_audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_audio_path = "{{ target_audio_path }}"

import os
import torch
import numpy as np
import soundfile as sf
from transformers import Wav2Vec2FeatureExtractor, UniSpeechSatForXVector
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
model_dir = os.path.dirname(weights_path)
preprocessor_dir = os.path.dirname(preprocessor_path)

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(preprocessor_dir)
model = UniSpeechSatForXVector.from_pretrained(model_dir, local_files_only=True, ignore_mismatched_sizes=True)
model = model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    raise ValueError("URL audio inputs are not supported in this validation script")
else:
    audio_1, sr1 = sf.read(audio_path)
if target_audio_path.startswith("http://") or target_audio_path.startswith("https://"):
    raise ValueError("URL audio inputs are not supported in this validation script")
else:
    audio_2, sr2 = sf.read(target_audio_path)

if audio_1.ndim > 1:
    audio_1 = np.mean(audio_1, axis=1)
if audio_2.ndim > 1:
    audio_2 = np.mean(audio_2, axis=1)

if sr1 != 16000:
    audio_1 = np.interp(np.linspace(0, len(audio_1), int(len(audio_1) * 16000 / sr1), endpoint=False), np.arange(len(audio_1)), audio_1).astype(np.float32)
if sr2 != 16000:
    audio_2 = np.interp(np.linspace(0, len(audio_2), int(len(audio_2) * 16000 / sr2), endpoint=False), np.arange(len(audio_2)), audio_2).astype(np.float32)

inputs_1 = feature_extractor(audio_1, sampling_rate=16000, return_tensors="pt")
inputs_2 = feature_extractor(audio_2, sampling_rate=16000, return_tensors="pt")
inputs_1 = {k: v.to(device) for k, v in inputs_1.items()}
inputs_2 = {k: v.to(device) for k, v in inputs_2.items()}

with torch.no_grad():
    emb1 = model(**inputs_1).embeddings
    emb2 = model(**inputs_2).embeddings
    emb1 = torch.nn.functional.normalize(emb1, dim=-1)
    emb2 = torch.nn.functional.normalize(emb2, dim=-1)
    cosine_sim = torch.nn.functional.cosine_similarity(emb1, emb2).item()

RESULT = {"cosine_similarity": cosine_sim, "embedding_1": emb1.squeeze(0).detach().cpu().numpy(), "embedding_2": emb2.squeeze(0).detach().cpu().numpy()}
