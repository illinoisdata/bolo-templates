{% set repo_id = repo_id | default("stduhpf/google-gemma-3-27b-it-qat-q4_0-gguf-small") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gemma-3-27b-it-q4_0_s.gguf') %}
{% set mmproj_filename = mmproj_filename | default('mmproj-google_gemma-3-27b-it-f16.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe this image in detail.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
mmproj_filename = "{{ mmproj_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import requests
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename=mmproj_filename)

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

llm = Llama(
    model_path=model_path,
    mmproj_path=mmproj_path,
    n_ctx=2048,
    n_gpu_layers=-1 if device.startswith('cuda') else 0,
    verbose=False,
)

response = llm.create_chat_completion(
    messages=[
        {
            "role": "user",
            "content": [
                {"type": "text", "text": prompt},
                {"type": "image_url", "image_url": {"url": image_path}},
            ],
        }
    ],
    temperature=0.2,
    top_p=0.95,
    max_tokens=128,
)

output_text = response["choices"][0]["message"]["content"]
RESULT = {"text": output_text}
