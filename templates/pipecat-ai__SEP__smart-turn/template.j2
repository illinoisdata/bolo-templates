{% set repo_id = repo_id | default("pipecat-ai/smart-turn") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set threshold = threshold | default(0.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
threshold = {{ threshold }}

from pathlib import Path

import torch
import soundfile as sf
from huggingface_hub import hf_hub_download
from transformers import AutoFeatureExtractor, Wav2Vec2BertForSequenceClassification

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
processor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

waveform, sample_rate = sf.read(audio_path, dtype="float32")
if waveform.ndim > 1:
    waveform = waveform.mean(axis=1)

feature_extractor = AutoFeatureExtractor.from_pretrained(Path(processor_path).parent)
inputs = feature_extractor(
    waveform,
    sampling_rate=16000,
    return_tensors="pt",
)

model = Wav2Vec2BertForSequenceClassification.from_pretrained(
    Path(weights_path).parent,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    logits = model(**inputs).logits
    probs = torch.softmax(logits, dim=-1)
    score, label_id = torch.max(probs, dim=-1)

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "probabilities": probs.detach().cpu().tolist(),
    "predicted_label_id": int(label_id.item()),
    "confidence": float(score.item()),
    "is_speaking": bool(score.item() >= threshold),
}
