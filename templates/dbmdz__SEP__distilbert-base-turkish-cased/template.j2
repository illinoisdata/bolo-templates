{% set device = "cuda:0" %}
{% set repo_id = "dbmdz/distilbert-base-turkish-cased" %}
{% set text_input = "Merhaba dunya, bu bir test cumlesidir." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

encoded = tokenizer(text_input, return_tensors="pt")
encoded = {key: value.to(device) for key, value in encoded.items()}

with torch.no_grad():
    outputs = model(**encoded)
sequence_output = outputs.last_hidden_state
pooled_embedding = sequence_output.mean(dim=1).squeeze(0)
embedding = pooled_embedding.cpu().tolist()

RESULT = {"embedding": embedding}
