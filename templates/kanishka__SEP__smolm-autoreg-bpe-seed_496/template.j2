{% set repo_id = repo_id | default("kanishka/smolm-autoreg-bpe-seed_496") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(32) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens | tojson }}

import torch
from transformers import pipeline

target_device = torch.device(device)
if target_device.type == "cuda":
    pipeline_device = target_device.index if target_device.index is not None else 0
else:
    pipeline_device = -1

pipe = pipeline(task=task, model=repo_id, tokenizer=repo_id, device=pipeline_device)
pipe.model.to(target_device)

RESULT = pipe(input_prompt, max_new_tokens=max_new_tokens)
