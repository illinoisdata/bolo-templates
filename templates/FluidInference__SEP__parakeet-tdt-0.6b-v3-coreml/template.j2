{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("FluidInference/parakeet-tdt-0.6b-v3-coreml") %}
{% set transcript_key = transcript_key | default('transcript') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
transcript_key = "{{ transcript_key }}"

import json
import tempfile
import wave
from pathlib import Path
from urllib.parse import urlparse

import numpy as np


def download_file(repo_id, filename):
    from huggingface_hub import hf_hub_download
    return hf_hub_download(repo_id=repo_id, filename=filename)


config_path = download_file(repo_id, "config.json")
vocab_path = download_file(repo_id, "parakeet_v3_vocab.json")

with open(config_path, "r") as f:
    config = json.load(f)

if urlparse(audio_path).scheme in ("http", "https"):
    import requests
    audio_bytes = requests.get(audio_path, timeout=30).content
    audio_file = tempfile.NamedTemporaryFile(suffix=Path(urlparse(audio_path).path).suffix or ".wav", delete=False)
    audio_file.write(audio_bytes)
    audio_file.flush()
    audio_local_path = audio_file.name
else:
    audio_local_path = audio_path

with wave.open(audio_local_path, "rb") as wf:
    sample_rate = wf.getframerate()
    n_channels = wf.getnchannels()
    sampwidth = wf.getsampwidth()
    frames = wf.readframes(wf.getnframes())

    if sampwidth == 2:
        audio_np = np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32768.0
    elif sampwidth == 4:
        audio_np = np.frombuffer(frames, dtype=np.int32).astype(np.float32) / 2147483648.0
    else:
        audio_np = np.frombuffer(frames, dtype=np.uint8).astype(np.float32)
        audio_np = (audio_np - 128.0) / 128.0

    if n_channels > 1:
        audio_np = audio_np.reshape(-1, n_channels).mean(axis=1)

with open(vocab_path, "r") as f:
    vocab = json.load(f)

RESULT = {
    "repo_id": repo_id,
    "device": device,
    "sample_rate": sample_rate,
    "num_samples": int(audio_np.shape[0]),
    "waveform_mean": float(audio_np.mean()) if audio_np.size else 0.0,
    "vocab_size": int(len(vocab)),
    "available_encoder_variants": sorted(list(config.get("encoders", {}).keys())),
    transcript_key: "",
}
