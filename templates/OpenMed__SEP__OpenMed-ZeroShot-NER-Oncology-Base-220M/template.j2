{% set repo_id = repo_id | default("OpenMed/OpenMed-ZeroShot-NER-Oncology-Base-220M") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Mutations in KRAS gene drive oncogenic transformation.') %}
{% set labels = labels | default(['Amino_acid', 'Anatomical_system', 'Cancer', 'Cell', 'Cellular_component', 'Developing_anatomical_structure', 'Gene_or_gene_product', 'Immaterial_anatomical_entity', 'Multi-tissue_structure', 'Organ', 'Organism', 'Organism_subdivision', 'Organism_substance', 'Pathological_formation', 'Simple_chemical', 'Tissue']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
labels = {{ labels | tojson }}

import json
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)

with open(config_path, 'r') as f:
    cfg = json.load(f)
backbone_name = cfg.get('model_name', cfg.get('base_model_name_or_path', 'google/mt5-base'))
model = AutoModelForSeq2SeqLM.from_pretrained(backbone_name)
state = torch.load(weights_path, map_location='cpu')
model.load_state_dict(state, strict=False)
model.to(device)
model.eval()

# Build a simple prompt that exercises the model on the provided labels.
prompt = text + "\nEntities: " + ", ".join(labels)
inputs = tokenizer(prompt, return_tensors='pt').to(device)
output_ids = model.generate(**inputs, max_new_tokens=32)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
