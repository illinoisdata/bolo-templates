{% set repo_id = repo_id | default("google/flan-t5-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Translate English to German: How old are you?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_file = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_file.rsplit('/', 1)[0],
    local_files_only=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    model_file.rsplit('/', 1)[0],
    local_files_only=True,
    torch_dtype=torch.float16 if device.startswith('cuda') else torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=32)

decoded = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": decoded}
