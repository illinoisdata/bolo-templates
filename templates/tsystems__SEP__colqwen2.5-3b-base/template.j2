{% set repo_id = repo_id | default("tsystems/colqwen2.5-3b-base") %}
{% set text_prompt = text_prompt | default("Describe the content of the image in one sentence.") %}
{% set image_path = image_path | default("/u/yli77/projects/ML-code-generation/data/image1.jpeg") %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
text_prompt = {{ text_prompt | tojson }}
image_path = {{ image_path | tojson }}

import io
from pathlib import Path

import numpy as np
import requests
import torch
from PIL import Image
from transformers import AutoModel, AutoProcessor

torch_device = torch.device(device)
processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(torch_device)
model.eval()

if str(image_path).startswith("http://") or str(image_path).startswith("https://"):
    response = requests.get(image_path, timeout=10)
    response.raise_for_status()
    raw_image = Image.open(io.BytesIO(response.content)).convert("RGB")
else:
    raw_image = Image.open(image_path).convert("RGB")

inputs = processor(text=text_prompt, images=raw_image, return_tensors="pt")
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

with torch.inference_mode():
    outputs = model(**inputs)

pooled_embedding = outputs.last_hidden_state[:, 0, :].to(torch.float32).detach().cpu()

RESULT = {"pooled_embedding": pooled_embedding}
