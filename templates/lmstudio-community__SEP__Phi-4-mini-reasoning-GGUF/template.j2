{% set repo_id = repo_id | default("lmstudio-community/Phi-4-mini-reasoning-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Phi-4-mini-reasoning-Q4_K_M.gguf') %}
{% set prompt = prompt | default('How to solve 3*x^2+4*x+5=1?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import re
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith('cuda') else 0
llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

messages = [
    {"role": "user", "content": prompt},
]

response = llm.create_chat_completion(
    messages=messages,
    temperature=0.2,
    top_p=0.95,
    max_tokens=256,
)

output_text = response["choices"][0]["message"]["content"]

RESULT = {"text": output_text}
