{% set repo_id = repo_id %}
{% set device = device %}
{% set text = "The quick brown fox jumps over the lazy dog" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__electra-small-discriminator" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

import json
import os

import torch
from transformers import AutoTokenizer, AutoModelForPreTraining

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(text, return_tensors="pt")
token_ids_for_tokens = encoded_inputs["input_ids"][0]
tokenizer_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    model_outputs = model(**tokenizer_inputs)

logits = model_outputs.logits.squeeze(0)
real_token_probabilities = torch.sigmoid(logits).cpu().tolist()
tokens = tokenizer.convert_ids_to_tokens(token_ids_for_tokens)
RESULT = {
    "tokens": tokens,
    "real_token_probabilities": real_token_probabilities,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    result_path = os.path.join(output_dir, "result.json")
    with open(result_path, "w", encoding="utf-8") as result_file:
        json.dump(RESULT, result_file, ensure_ascii=False, indent=2)