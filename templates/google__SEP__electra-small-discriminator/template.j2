{% set repo_id = repo_id | default("google/electra-small-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set sentence = sentence | default('The quick brown fox fake over the lazy dog') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence = "{{ sentence }}"

import torch
from transformers import ElectraForPreTraining, ElectraTokenizerFast
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")


tokenizer = ElectraTokenizerFast.from_pretrained(vocab_path, tokenizer_file=tokenizer_path, tokenizer_config_file=tokenizer_config_path)
model = ElectraForPreTraining.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(sentence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    predictions = torch.round((torch.sign(logits) + 1) / 2)

RESULT = {
    "sentence": sentence,
    "token_ids": inputs["input_ids"].detach().cpu().tolist(),
    "logits": logits.detach().cpu().tolist(),
    "predictions": predictions.detach().cpu().tolist(),
}
