{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-fi") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('Russia is big.') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}
max_new_tokens = {{ max_new_tokens }}

from transformers import MarianMTModel, MarianTokenizer
import torch

model_name = repo_id
tokenizer = MarianTokenizer.from_pretrained(model_name)
model = MarianMTModel.from_pretrained(model_name)
model.to(device)

if isinstance(src_text, str):
    inputs = [src_text]
else:
    inputs = src_text

encoded = tokenizer(inputs, return_tensors="pt", padding=True, truncation=True)
encoded = {k: v.to(device) for k, v in encoded.items()}

with torch.no_grad():
    generated = model.generate(**encoded, max_new_tokens=max_new_tokens)

translations = [tokenizer.decode(t, skip_special_tokens=True) for t in generated]
output = translations[0] if len(translations) == 1 else translations

RESULT = {"output": output}
