{% set repo_id = repo_id | default("unsloth/Qwen3-1.7B-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Give me a short introduction to large language models.') %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set enable_thinking = enable_thinking | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
enable_thinking = {{ 'True' if enable_thinking else 'False' }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForCausalLM

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model_dir = os.path.dirname(model_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(
    model_dir,
    torch_dtype=torch.bfloat16,
    device_map=None,
    low_cpu_mem_usage=True,
).to(device)
model.eval()

messages = [{"role": "user", "content": prompt}]
text = tokenizer.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True,
    enable_thinking=enable_thinking,
)
inputs = tokenizer(text, return_tensors="pt").to(device)
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=not enable_thinking,
        temperature=0.7 if not enable_thinking else 0.6,
        top_p=0.8 if not enable_thinking else 0.95,
        top_k=20,
    )
output_ids = generated_ids[0][inputs.input_ids.shape[1]:]
output_text = tokenizer.decode(output_ids, skip_special_tokens=True)

RESULT = {"text": output_text}
