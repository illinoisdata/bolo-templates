{% set repo_id = repo_id | default("uclanlp/plbart-base") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('def add(a, b):\n    return a + b') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = {{ text_input | tojson }}

import os
import requests
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
sentencepiece_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

tokenizer = AutoTokenizer.from_pretrained(
    os.path.dirname(sentencepiece_path),
    use_fast=False,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    os.path.dirname(weights_path),
    torch_dtype=None,
)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

output_ids = model.generate(
    **inputs,
    max_new_tokens=64,
    num_beams=5,
)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
