{% set repo_id = "slauw87/bart_summarisation" %}
{% set device = "cuda:0" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/slauw87__SEP__bart_summarisation" %}
{% set text_input -%}
Sugi: I am tired of everything in my life.
Tommy: What? How happy you life is! I do envy you.
Sugi: You don't know that I have been over-protected by my mother these years. I am really about to leave the family and spread my wings.
Tommy: Maybe you are right.
{%- endset %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input.strip() }}"""
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
config_dict = model.config.to_dict()

encoded_inputs = tokenizer(
    text_input,
    truncation=True,
    return_tensors="pt",
)

input_ids = encoded_inputs["input_ids"].to(device)
attention_mask = encoded_inputs["attention_mask"].to(device)

generate_kwargs = {
    "max_length": config_dict.get("max_length", 142),
    "min_length": config_dict.get("min_length", 56),
    "num_beams": config_dict.get("num_beams", 4),
    "no_repeat_ngram_size": config_dict.get("no_repeat_ngram_size", 3),
    "length_penalty": config_dict.get("length_penalty", 2.0),
    "early_stopping": config_dict.get("early_stopping", True),
}

with torch.no_grad():
    generated_tokens = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        **generate_kwargs,
    )

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
summary = decoded[0].strip()

RESULT = {"summary": summary}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")