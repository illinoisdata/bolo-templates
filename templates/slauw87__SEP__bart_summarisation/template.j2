{% set repo_id = repo_id | default("slauw87/bart_summarisation") %}
{% set device = device | default("cuda:0") %}
{% set conversation = conversation | default("Sugi: I am tired of everything in my life. Tommy: What? How happy you life is! I do envy you. Sugi: You don't know that I have been over-protected by my mother these years. I am really about to leave the family and spread my wings. Tommy: Maybe you are right.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
conversation = {{ conversation | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
model = model.to(device)
model.eval()

inputs = tokenizer(conversation, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=142,
        min_length=56,
        num_beams=4,
        no_repeat_ngram_size=3,
        length_penalty=2.0,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
