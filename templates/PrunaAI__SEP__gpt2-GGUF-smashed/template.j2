{% set repo_id = repo_id | default("PrunaAI/gpt2-GGUF-smashed") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('gpt2.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Once upon a time') %}
{% set max_tokens = max_tokens | default(32) %}
{% set temperature = temperature | default(0.7) %}
{% set top_p = top_p | default(0.95) %}
{% set n_ctx = n_ctx | default(128) %}
{% set n_threads = n_threads | default(4) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
max_tokens = {{ max_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
n_ctx = {{ n_ctx }}
n_threads = {{ n_threads }}

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if device.startswith("cuda") else 0
llm = Llama(
    model_path=model_path,
    n_ctx=n_ctx,
    n_threads=n_threads,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=max_tokens,
    temperature=temperature,
    top_p=top_p,
    echo=False,
)

RESULT = {"text": output["choices"][0]["text"]}
