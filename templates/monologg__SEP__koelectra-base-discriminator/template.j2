{% set repo_id = repo_id | default("monologg/koelectra-base-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('나는 내일 밥을 먹었다.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import ElectraForPreTraining, ElectraTokenizer

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Pre-process input & load model

tokenizer = ElectraTokenizer(vocab_file=vocab_path)
model = ElectraForPreTraining.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    predictions = torch.round((torch.sign(logits) + 1) / 2)

# Post-process & build RESULT dict
RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "predictions": predictions.detach().cpu().tolist(),
    "tokens": tokenizer.convert_ids_to_tokens(inputs["input_ids"][0].detach().cpu().tolist()),
}
