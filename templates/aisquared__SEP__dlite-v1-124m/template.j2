{% set repo_id = repo_id | default("aisquared/dlite-v1-124m") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Summarize the benefits of smaller, research-friendly language models.") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.8) %}
{% set top_p = top_p | default(0.92) %}
{% set top_k = top_k | default(0) %}
{% set do_sample = do_sample | default(true) %}
{% set return_instruction_text = return_instruction_text | default(false) %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
top_k = {{ top_k }}
do_sample = {{ "True" if do_sample else "False" }}
return_instruction_text = {{ "True" if return_instruction_text else "False" }}

from transformers import AutoModelForCausalLM, AutoTokenizer, pipeline
from instruct_pipeline import InstructionTextGenerationPipeline, INSTRUCTION_KEY, RESPONSE_KEY, END_KEY

special_tokens = [INSTRUCTION_KEY, RESPONSE_KEY, END_KEY]
tokenizer = AutoTokenizer.from_pretrained(repo_id, padding_side="left")
missing_special_tokens = [token for token in special_tokens if token not in tokenizer.all_special_tokens]
if missing_special_tokens:
    tokenizer.add_special_tokens({"additional_special_tokens": missing_special_tokens})
setattr(tokenizer, "additional_special_tokens", special_tokens)
model = AutoModelForCausalLM.from_pretrained(repo_id)
model.resize_token_embeddings(len(tokenizer))
model = model.to(device)

pipe = pipeline(
    task=task,
    model=model,
    tokenizer=tokenizer,
    device=device,
    pipeline_class=InstructionTextGenerationPipeline,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    top_p=top_p,
    top_k=top_k,
    do_sample=do_sample,
)

instruction_text = input_prompt

RESULT = pipe(instruction_text, return_instruction_text=return_instruction_text)
