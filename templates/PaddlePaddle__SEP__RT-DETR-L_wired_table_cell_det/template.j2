{% set repo_id = repo_id | default("PaddlePaddle/RT-DETR-L_wired_table_cell_det") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set threshold = threshold | default(0.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
threshold = {{ threshold }}

import os
import json
import numpy as np
from PIL import Image
from huggingface_hub import hf_hub_download
from paddleocr import TableCellsDetection

weights_path = hf_hub_download(repo_id=repo_id, filename="inference.pdiparams")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="inference.yml")

if image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = np.array(Image.open(urlopen(image_path)).convert("RGB"))
else:
    image = np.array(Image.open(image_path).convert("RGB"))

model = TableCellsDetection(model_name="RT-DETR-L_wired_table_cell_det")
output = model.predict(image, threshold=threshold, batch_size=1)

predictions = []
for res in output:
    if hasattr(res, "json"):
        try:
            predictions.append(res.json)
        except Exception:
            predictions.append(str(res))
    else:
        predictions.append(str(res))

RESULT = {"predictions": predictions}
