{% set repo_id = repo_id | default("thkim0305/llama3.2_1B_vl") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-text-to-text") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set input_prompt = input_prompt | default("<image> Describe this image") %}

task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
input_prompt = {{ input_prompt | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

strategy = None
if hasattr(pipe, "processor"):
    strategy = getattr(pipe.processor, "vision_feature_select_strategy", None)
if strategy == "default":
    pipe.processor.vision_feature_select_strategy = None

pipeline_inputs = {
    "image": input_image,
    "text": input_prompt,
}

inference_output = pipe(pipeline_inputs["image"], text=pipeline_inputs["text"])

RESULT = {
    "raw_output": inference_output,
}
