{% set repo_id = repo_id | default("deutsche-telekom/bert-multi-english-german-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Where is the Allianz Arena located?') %}
{% set context = context | default('Die Allianz Arena ist ein Fußballstadion im Norden von München und bietet bei Bundesligaspielen 75.021 Plätze, zusammengesetzt aus 57.343 Sitzplätzen, 13.794 Stehplätzen, 1.374 Logenplätzen, 2.152 Business Seats und 966 Sponsorenplätzen. In der Allianz Arena bestreitet der FC Bayern München seit der Saison 2005/06 seine Heimspiele. Bis zum Saisonende 2017 war die Allianz Arena auch Spielstätte des TSV 1860 München.') %}
{% set max_length = max_length | default(384) %}
{% set doc_stride = doc_stride | default(128) %}
{% set max_answer_len = max_answer_len | default(30) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_length = {{ max_length }}
doc_stride = {{ doc_stride }}
max_answer_len = {{ max_answer_len }}

from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

model_dir = str(Path(weights_path).parent)
tokenizer_dir = str(Path(tokenizer_path).parent)

tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(
    question,
    context,
    return_tensors="pt",
    truncation="only_second",
    max_length=max_length,
    stride=doc_stride,
    return_overflowing_tokens=False,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits[0]
end_logits = outputs.end_logits[0]
start_idx = int(torch.argmax(start_logits).item())
end_idx = int(torch.argmax(end_logits).item())
if end_idx < start_idx:
    end_idx = start_idx
if end_idx - start_idx + 1 > max_answer_len:
    end_idx = start_idx + max_answer_len - 1

answer_ids = inputs["input_ids"][0, start_idx:end_idx + 1].tolist()
answer_text = tokenizer.decode(answer_ids, skip_special_tokens=True).strip()

RESULT = {"answer": answer_text}
