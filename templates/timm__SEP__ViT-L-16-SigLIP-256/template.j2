repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
labels_list = {{ labels_list }}

import os
from urllib.parse import urlparse
from urllib.request import urlopen

import torch
import torch.nn.functional as F
from PIL import Image
from huggingface_hub import hf_hub_download
import timm

config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_model.safetensors")

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = timm.create_model(
    "vit_large_patch16_siglip_256",
    pretrained=True,
    num_classes=0,
)
model = model.to(device).eval()
data_config = timm.data.resolve_model_data_config(model)
transforms = timm.data.create_transform(**data_config, is_training=False)

image_tensor = transforms(image).unsqueeze(0).to(device)
with torch.no_grad():
    image_features = model(image_tensor)
    image_features = F.normalize(image_features, dim=-1)

output = image_features.detach().cpu().tolist()

RESULT = {"output": output}
