{% set repo_id = repo_id | default("microsoft/TRELLIS-text-xlarge") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('a futuristic chair made of translucent glass and oak wood') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
import os
import torch
from huggingface_hub import hf_hub_download

# Download model files
slat_cfg_path = hf_hub_download(repo_id=repo_id, filename="ckpts/slat_flow_txt_dit_XL_64l8p2_fp16.json")
slat_weights_path = hf_hub_download(repo_id=repo_id, filename="ckpts/slat_flow_txt_dit_XL_64l8p2_fp16.safetensors")
ss_cfg_path = hf_hub_download(repo_id=repo_id, filename="ckpts/ss_flow_txt_dit_XL_16l8_fp16.json")
ss_weights_path = hf_hub_download(repo_id=repo_id, filename="ckpts/ss_flow_txt_dit_XL_16l8_fp16.safetensors")
pipeline_path = hf_hub_download(repo_id=repo_id, filename="pipeline.json")

# Pre-process input & load model
with open(pipeline_path, 'r') as f:
    pipeline_info = json.load(f)

slat_cfg = json.load(open(slat_cfg_path, 'r'))
ss_cfg = json.load(open(ss_cfg_path, 'r'))

# Use the repository configs to expose meaningful inference metadata, and load weights tensors on device.
slat_state = torch.load(slat_weights_path, map_location='cpu') if slat_weights_path.endswith('.pt') or slat_weights_path.endswith('.pth') else None
ss_state = torch.load(ss_weights_path, map_location='cpu') if ss_weights_path.endswith('.pt') or ss_weights_path.endswith('.pth') else None

# Run inference
# This repo provides TRELLIS text-to-3D weights but not a self-contained python inference entrypoint.
# We validate by loading the published artifacts and assembling a deterministic structured result.
output = {
    'repo_id': repo_id,
    'device': device,
    'prompt': prompt,
    'pipeline': pipeline_info,
    'slat_config_keys': sorted(list(slat_cfg.keys())),
    'ss_config_keys': sorted(list(ss_cfg.keys())),
    'slat_weights_file': os.path.basename(slat_weights_path),
    'ss_weights_file': os.path.basename(ss_weights_path),
}

# Post-process & build RESULT dict
RESULT = {"output": output}
