{% set repo_id = repo_id | default("timm/repvgg_a2.rvgg_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set top_k = top_k | default(5) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"
top_k = {{ top_k }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

image = Image.open(input_image).convert("RGB")

RESULT = pipe(image, top_k=top_k)

RESULT = {"predictions": RESULT}
