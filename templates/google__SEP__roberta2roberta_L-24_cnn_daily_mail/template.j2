{% set repo_id = repo_id | default("google/roberta2roberta_L-24_cnn_daily_mail") %}
{% set device = device | default("cuda:0") %}
{% set article = article | default('The Hollywood Reporter article about The Rocky Horror Picture Show remake and Fox developing a two-hour remake directed by Kenneth Ortega.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article = "{{ article }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

repo_dir = os.path.dirname(config_path)
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, torch_dtype=torch.float32)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("encoder.embeddings.position_ids", None)
state_dict.pop("decoder.bert.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=True)
model.to(device)
model.eval()

inputs = tokenizer(article, return_tensors="pt", truncation=True, max_length=512).to(device)
with torch.no_grad():
    output_ids = model.generate(**inputs, max_length=128, num_beams=4)
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
