repo_id = "{{ repo_id }}"
device = "{{ device }}"
article = {{ article_text | tojson }}
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

import os
from pathlib import Path
import torch
from transformers import BertGenerationTokenizer, AutoModelForSeq2SeqLM

tokenizer = BertGenerationTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(article, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    summary_path = Path(output_dir) / "summary.txt"
    summary_path.write_text(summary, encoding="utf-8")