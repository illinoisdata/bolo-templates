{% set repo_id = repo_id | default("Fuyucchi/yolov8_animeface") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.7) %}
{% set imgsz = imgsz | default(1280) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
iou = {{ iou }}
imgsz = {{ imgsz }}

import os
from pathlib import Path
import requests
from PIL import Image
import torch
import torchvision
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="yolov8x6_animeface.pt")
model = YOLO(weights_path)
model.to(device)

if str(image_path).startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

results = model.predict(source=image, conf=conf, iou=iou, imgsz=imgsz, device=device, verbose=False)
res = results[0]
boxes = res.boxes

output_boxes = boxes.xyxy.detach().cpu().tolist() if boxes is not None and boxes.xyxy is not None else []
output_scores = boxes.conf.detach().cpu().tolist() if boxes is not None and boxes.conf is not None else []
output_classes = boxes.cls.detach().cpu().tolist() if boxes is not None and boxes.cls is not None else []
output_names = [res.names[int(c)] for c in output_classes]

RESULT = {"boxes": output_boxes, "scores": output_scores, "classes": output_classes, "names": output_names}
