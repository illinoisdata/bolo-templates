{% set repo_id = repo_id | default("google/multiberts-seed_0") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

local_device = torch.device(device if torch.cuda.is_available() or device == "cpu" else "cpu")
tokenizer_dir = os.path.dirname(vocab_file)
tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=False)
model = AutoModel.from_pretrained(os.path.dirname(model_file))
model.to(local_device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(local_device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
last_hidden_state = outputs.last_hidden_state.cpu()
pooler_output = outputs.pooler_output.cpu() if outputs.pooler_output is not None else None

RESULT = {"last_hidden_state": last_hidden_state, "pooler_output": pooler_output}
