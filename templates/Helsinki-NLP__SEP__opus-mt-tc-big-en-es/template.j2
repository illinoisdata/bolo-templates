{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-en-es" %}
{% set device = "cuda:0" %}
{% set src_text = ["A wasp stung him and he had an allergic reaction.", "I love nature."] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

import os
from transformers import MarianMTModel, MarianTokenizer
import torch

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
