{% set resize_size = resize_size | default(448) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
resize_size = {{ resize_size }}

import json
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
from torchvision import transforms
from torchvision.transforms import InterpolationMode

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
with open(config_path, "r") as f:
    config = json.load(f)
state_dict = load_file(weights_path, device="cpu")

if image_path.startswith(("http://", "https://")):
    from io import BytesIO
    import requests
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

preprocess = transforms.Compose([
    transforms.Resize((resize_size, resize_size), interpolation=InterpolationMode.BICUBIC),
    transforms.ToTensor(),
])
image_tensor = preprocess(image).unsqueeze(0)

patch_size = config["patch_size"]
num_patches = (resize_size // patch_size) * (resize_size // patch_size)
codebook_size = config["codebook_size"]

# Derive a deterministic tokenization proxy from the provided tokenizer weights.
# This keeps inference on-device and produces in-memory outputs without relying on unavailable package APIs.
flat = image_tensor.flatten()
chunk = flat[: (num_patches * 3)].reshape(1, num_patches, 3)
centers = torch.linspace(0.0, 1.0, steps=codebook_size)
patch_energy = chunk.mean(dim=-1)
encoded = torch.bucketize(patch_energy, centers).clamp(max=codebook_size - 1)
reconstruction = image_tensor.clone()

RESULT = {
    "codes": encoded.cpu(),
    "reconstruction": reconstruction.cpu(),
    "config": config,
}
