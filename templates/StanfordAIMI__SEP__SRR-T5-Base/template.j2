{% set repo_id = "StanfordAIMI/SRR-T5-Base" %}
{% set device = "cuda:0" %}
{% set input_text = "CHEST RADIOGRAPH PERFORMED ON ___  COMPARISON: Prior exam from ___.  CLINICAL HISTORY: Weakness, assess pneumonia.  FINDINGS: Frontal and lateral views of the chest were provided. Midline sternotomy wires are again noted. The heart is poorly assessed, though remains enlarged. There are at least small bilateral pleural effusions.  There may be mild interstitial edema. No pneumothorax. Bony structures are demineralized with kyphotic angulation in the lower T-spine again noted.  IMPRESSION: Limited exam with small bilateral effusions, cardiomegaly, and possible mild interstitial edema." %}
{% set max_input_length = 512 %}
{% set max_new_tokens = 286 %}
{% set min_new_tokens = 120 %}
{% set num_beams = 5 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_input_length = {{ max_input_length }}
max_new_tokens = {{ max_new_tokens }}
min_new_tokens = {{ min_new_tokens }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, padding_side="right", use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    input_text,
    padding="max_length",
    truncation=True,
    max_length=max_input_length,
    return_tensors="pt",
)
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

with torch.inference_mode():
    generated_ids = model.generate(
        input_ids,
        attention_mask=attention_mask,
        max_new_tokens=max_new_tokens,
        min_new_tokens=min_new_tokens,
        decoder_start_token_id=model.config.decoder_start_token_id,
        num_beams=num_beams,
        early_stopping=True,
    )

decoded_report = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
decoded_report = decoded_report.replace("<pad>", "").strip()

RESULT = {"structured_report": decoded_report}
