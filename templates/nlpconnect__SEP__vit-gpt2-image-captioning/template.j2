{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set max_length = max_length | default(16) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from urllib.parse import urlparse
import requests
import torch
from PIL import Image
from transformers import VisionEncoderDecoderModel, ViTImageProcessor, AutoTokenizer
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw)
else:
    image = Image.open(image_path)
if image.mode != "RGB":
    image = image.convert("RGB")

processor = ViTImageProcessor.from_pretrained(os.path.dirname(processor_file))
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_file))
model = VisionEncoderDecoderModel.from_pretrained(os.path.dirname(model_file))
model.to(device)
model.eval()

pixel_values = processor(images=image, return_tensors="pt").pixel_values.to(device)
gen_kwargs = {"max_length": max_length, "num_beams": num_beams}
output_ids = model.generate(pixel_values, **gen_kwargs)
caption = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0].strip()

RESULT = {"caption": caption}
