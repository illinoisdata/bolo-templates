{% set repo_id = repo_id | default("unslothai/aws") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set tokenizer_name = tokenizer_name | default("gpt2") %}
{% set input_prompt = input_prompt | default("I love the Hong Kong University of Science and Technology, my favorite course is MATH4343: Introduction to Graph Theory.") %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set temperature = temperature | default(0.5) %}
{% set top_p = top_p | default(0.9) %}
{% set num_return_sequences = num_return_sequences | default(1) %}

# Pipeline and model configuration variables
task = {{ task | tojson }}
model_repo = {{ repo_id | tojson }}
device = {{ device | tojson }}
tokenizer_name = {{ tokenizer_name | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}
num_return_sequences = {{ num_return_sequences }}

from transformers import AutoTokenizer, pipeline
from huggingface_hub import snapshot_download
import json, os

# Download the model repo locally and patch its config to valid dimensions
local_repo = snapshot_download(model_repo, cache_dir="/workspace")
config_path = os.path.join(local_repo, "config.json")
data = json.load(open(config_path, "r"))
# Override zero values to avoid invalid configuration
data["hidden_size"] = 512
data["num_attention_heads"] = 8
data["num_hidden_layers"] = 4
data["intermediate_size"] = 2048
data["num_key_value_heads"] = 8
# Align vocab size with tokenizer
tokenizer = AutoTokenizer.from_pretrained(tokenizer_name)
data["vocab_size"] = tokenizer.vocab_size
json.dump(data, open(config_path, "w"))

# Create the text-generation pipeline
pipe = pipeline(
    task=task,
    model=local_repo,
    tokenizer=tokenizer,
    device=device,
    model_kwargs={"ignore_mismatched_sizes": True},
)

# Run inference
generation_kwargs = {
    "max_new_tokens": max_new_tokens,
    "temperature": temperature,
    "top_p": top_p,
    "num_return_sequences": num_return_sequences,
}
generated = pipe(input_prompt, **generation_kwargs)

RESULT = {"generated_text": generated}
