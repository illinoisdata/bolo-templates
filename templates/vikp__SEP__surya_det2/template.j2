{% set repo_id = repo_id | default("vikp/surya_det2") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import numpy as np
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoImageProcessor, SegformerForSemanticSegmentation

# Download model files
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Load processor and model
processor = AutoImageProcessor.from_pretrained(repo_id, local_files_only=False)
model = SegformerForSemanticSegmentation.from_pretrained(repo_id, local_files_only=False, ignore_mismatched_sizes=True)
model.to(device)
model.eval()

# Load input image
if image_path.startswith(("http://", "https://")):
    import requests
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
pred = torch.argmax(logits, dim=1)

RESULT = {"logits": logits.detach().cpu().numpy(), "prediction": pred.detach().cpu().numpy()}
