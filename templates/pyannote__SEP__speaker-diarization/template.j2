repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
num_speakers = {{ num_speakers }}
min_speakers = {{ min_speakers }}
max_speakers = {{ max_speakers }}

import os
from urllib.parse import urlparse
import requests


def load_audio_input(path_or_url):
    parsed = urlparse(path_or_url)
    if parsed.scheme in ("http", "https"):
        local_path = os.path.join("/tmp", os.path.basename(parsed.path))
        if not os.path.exists(local_path):
            r = requests.get(path_or_url, timeout=30)
            r.raise_for_status()
            with open(local_path, "wb") as f:
                f.write(r.content)
        return local_path
    return path_or_url


audio_input = load_audio_input(audio_path)

RESULT = {"audio_path": audio_input, "num_speakers": num_speakers, "min_speakers": min_speakers, "max_speakers": max_speakers}
