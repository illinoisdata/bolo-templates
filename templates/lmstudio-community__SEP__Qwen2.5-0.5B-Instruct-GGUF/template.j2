{% set repo_id = repo_id | default("lmstudio-community/Qwen2.5-0.5B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen2.5-0.5B-Instruct-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short haiku about machine learning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if str(device).startswith('cuda') else 0,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

chat = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    top_p=0.95,
    max_tokens=128,
)

output_text = chat["choices"][0]["message"]["content"]

RESULT = {"text": output_text}
