{% set repo_id = repo_id | default("RzZ/Qwen2.5-VL-3B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('qwen25vl-3b-instruct.gguf') %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe the image.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
image = "{{ image }}"
prompt = "{{ prompt }}"

from PIL import Image
from huggingface_hub import hf_hub_download

image_path = image
if isinstance(image, str) and image.startswith(("http://", "https://")):
    image_path = image

weight_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename="mmproj-qwen25vl-3b-instruct.gguf")

image_input = Image.open(image_path).convert("RGB")
output = {
    "model_path": weight_path,
    "mmproj_path": mmproj_path,
    "device": device,
    "prompt": prompt,
    "image_size": image_input.size,
}

RESULT = {"output": output}
