{% set repo_id = repo_id | default("DeepPavlov/distilrubert-small-cased-conversational") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Привет! Как дела?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
model_dir = os.path.dirname(vocab_path)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False, local_files_only=True)
model = AutoModel.from_pretrained(model_dir, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooled_output = last_hidden_state[:, 0]
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooled_output": pooled_output,
}
