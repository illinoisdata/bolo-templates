{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("DeepPavlov/distilrubert-small-cased-conversational") %}
{% set text_input = text_input | default("Привет, как дела?") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}

import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    truncation=True,
    padding=True,
    max_length=max_length,
    return_tensors="pt",
)
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

sequence_output = outputs.last_hidden_state.detach().cpu()

RESULT = {"last_hidden_state": sequence_output}
