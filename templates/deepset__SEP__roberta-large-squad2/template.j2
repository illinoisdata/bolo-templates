{% set repo_id = repo_id | default("deepset/roberta-large-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Why is model conversion important?') %}
{% set context = context | default('The option to convert models between FARM and transformers gives freedom to the user and lets people easily switch between frameworks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

# Load tokenizer and model
# The model will automatically use the downloaded repo files from cache.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits

start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx, "start_logits": start_logits.detach().cpu(), "end_logits": end_logits.detach().cpu()}
