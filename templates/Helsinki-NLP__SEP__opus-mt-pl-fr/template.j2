{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-pl-fr") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Dzień dobry! Czy możesz przetłumaczyć ten tekst na francuski?") %}
{% set num_beams = num_beams | default(6) %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding="longest",
    max_length=max_length,
)
encoded = {key: value.to(device) for key, value in encoded.items()}

with torch.no_grad():
    generated = model.generate(
        **encoded,
        num_beams=num_beams,
        max_length=max_length,
    )

translation = tokenizer.decode(
    generated[0],
    skip_special_tokens=True,
)

RESULT = {"translation": translation}
