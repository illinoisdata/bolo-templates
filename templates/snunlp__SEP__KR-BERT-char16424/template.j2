{% set input_text = "한국어 BERT 모델을 테스트합니다." %}
{% set max_length = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}

import numpy as np
import torch
from pathlib import Path
from transformers import AutoModel, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(torch_device)
model.eval()

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state_array = outputs.last_hidden_state.squeeze(0).cpu().numpy()
pooler_output_tensor = outputs.pooler_output

result_dict = {"last_hidden_state": last_hidden_state_array}
if pooler_output_tensor is not None:
    result_dict["pooler_output"] = pooler_output_tensor.cpu().numpy()

RESULT = result_dict

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    for key, value in RESULT.items():
        np.save(output_path / f"{key}.npy", value)