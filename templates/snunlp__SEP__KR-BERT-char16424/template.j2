{% set repo_id = repo_id | default("snunlp/KR-BERT-char16424") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('토크나이저 예시입니다.') %}
{% set max_length = max_length | default(16) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertConfig, BertForPreTraining

vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

config = BertConfig.from_json_file(config_file)

tokenizer = BertTokenizer(vocab_file=vocab_file, do_lower_case=False)
model = BertForPreTraining(config)
state_dict = torch.load(weights_file, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

subchar_text = torch.tensor([1])
import unicodedata
subchar_text = unicodedata.normalize('NFKD', text)
inputs = tokenizer(subchar_text, return_tensors="pt", truncation=True, max_length=max_length)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

prediction_scores = outputs.prediction_logits
seq_relationship_score = outputs.seq_relationship_logits

token_ids = inputs["input_ids"][0].tolist()
tokens = tokenizer.convert_ids_to_tokens(token_ids)
mlm_top_ids = torch.argmax(prediction_scores[0], dim=-1).tolist()
mlm_top_tokens = tokenizer.convert_ids_to_tokens(mlm_top_ids)

RESULT = {
    "tokens": tokens,
    "mlm_top_tokens": mlm_top_tokens,
    "seq_relationship_logits": seq_relationship_score[0].detach().cpu().tolist(),
}
