{% set repo_id = repo_id | default("mozilla-ai/Meta-Llama-3-8B-Instruct-llamafile") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('You are a helpful assistant.') %}
{% set user_message = user_message | default('Write a short haiku about open source software.') %}
{% set max_tokens = max_tokens | default(64) %}
{% set quant_filename = quant_filename | default('Meta-Llama-3-8B-Instruct.Q4_0.llamafile') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
user_message = "{{ user_message }}"
max_tokens = {{ max_tokens }}
quant_filename = "{{ quant_filename }}"

import os
import subprocess
import requests
from huggingface_hub import hf_hub_download

llamafile_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
os.chmod(llamafile_path, os.stat(llamafile_path).st_mode | 0o111)

conversation = f"<|begin_of_text|><|start_header_id|>system<|end_header_id|>\n{prompt}<|eot_id|><|start_header_id|>user<|end_header_id|>\n{user_message}<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n"

cmd = ["bash", llamafile_path, "-p", conversation, "-n", str(max_tokens), "--log-disable", "--silent-prompt"]
if device.startswith("cuda"):
    cmd.extend(["-ngl", "9999"])

proc = subprocess.run(cmd, input=b"", stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
text = proc.stdout.decode("utf-8", errors="replace")

RESULT = {"generated_text": text}
