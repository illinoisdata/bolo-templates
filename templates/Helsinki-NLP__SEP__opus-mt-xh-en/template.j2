{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-xh-en") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Molo! Ndiyabulela.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)

inputs = tokenizer(input_text, return_tensors="pt", padding=True)
inputs = {key: value.to(torch_device) for key, value in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
    )

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]
RESULT = {"translation": translation}
