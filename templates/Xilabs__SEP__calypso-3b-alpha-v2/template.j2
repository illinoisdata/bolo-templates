{% set repo_id = repo_id | default("Xilabs/calypso-3b-alpha-v2") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello! This is a short prompt to test the model.") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
model = repo_id

import os
from transformers import pipeline

os.environ.setdefault("PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION", "python")

pipe = pipeline(task=task, model=model, device=device)

prompt = input_prompt

raw_output = pipe(prompt)

if isinstance(raw_output, list) and raw_output:
    candidate = raw_output[0]
    if isinstance(candidate, dict) and "generated_text" in candidate:
        processed_output = candidate["generated_text"]
    else:
        processed_output = candidate
else:
    processed_output = raw_output

RESULT = {"generated_text": processed_output}
