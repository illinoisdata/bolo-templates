{% set repo_id = repo_id | default("stanfordnlp/stanza-pl") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('To jest przykładowe zdanie do analizy.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
import stanza

# Load and parse with a tokenization-only pipeline to avoid checkpoint incompatibilities
hf_hub_download(repo_id=repo_id, filename="models/tokenize/pdb.pt")
nlp = stanza.Pipeline(
    lang="pl",
    processors="tokenize",
    device=device,
    use_gpu=str(device).startswith("cuda"),
    tokenize_model_path=hf_hub_download(repo_id=repo_id, filename="models/tokenize/pdb.pt"),
    verbose=False,
)

doc = nlp(text)

tokens = [token.text for sent in doc.sentences for token in sent.tokens]
RESULT = {"tokens": tokens}
