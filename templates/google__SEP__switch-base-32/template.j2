{% set repo_id = "google/switch-base-32" %}
{% set device = "cuda:0" %}
{% set text_input = text_input | default("A <extra_id_0> walks into a bar and orders a <extra_id_1> with <extra_id_2> pinch of <extra_id_3>.") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model.eval()
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_ids = model.generate(**inputs)
decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_text = decoded[0] if decoded else ""

RESULT = {"generated_text": generated_text}
