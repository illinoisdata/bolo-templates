{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-sq") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The house is wonderful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import MarianMTModel, AutoTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated = model.generate(**inputs, max_length=128, num_beams=4)
output_text = tokenizer.batch_decode(generated, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
