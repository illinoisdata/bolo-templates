{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-sq") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hello, world!") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt", padding=True).to(device)
outputs = model.generate(**inputs)
decoded = tokenizer.batch_decode(outputs, skip_special_tokens=True)
translation_text = decoded[0]

RESULT = {"translation_text": translation_text}
