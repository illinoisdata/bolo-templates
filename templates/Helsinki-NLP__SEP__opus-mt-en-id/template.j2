{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-id") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

torch_device = torch.device(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(src_text, return_tensors="pt")
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_new_tokens=max_new_tokens)
translation = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"translation": translation}
