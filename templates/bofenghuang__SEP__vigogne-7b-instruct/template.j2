{% set repo_id = repo_id | default("bofenghuang/vigogne-7b-instruct") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Expliquez la différence entre DoS et phishing.") %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set temperature = temperature | default(0.1) %}
{% set do_sample = do_sample | default(True) %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
do_sample = {{ do_sample }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

preprocessed_prompt = input_prompt.strip()

RESULT = pipe(
    preprocessed_prompt,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    do_sample=do_sample,
)
