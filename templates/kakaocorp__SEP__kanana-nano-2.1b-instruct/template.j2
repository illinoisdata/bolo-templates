{% set repo_id = repo_id | default("kakaocorp/kanana-nano-2.1b-instruct") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline
from transformers.models.llama.configuration_llama import LlamaConfig

LlamaConfig.__class_validators__ = [
    validator
    for validator in getattr(LlamaConfig, "__class_validators__", [])
    if validator.__name__ != "validate_architecture"
]
pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
