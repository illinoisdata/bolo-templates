repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}
hop_length = {{ hop_length }}
win_length = {{ win_length }}
n_mels = {{ n_mels }}
n_fft = {{ n_fft }}
f_min = {{ f_min }}
f_max = {{ f_max }}
power = {{ power }}
normalized = {{ normalized }}
min_max_energy_norm = {{ min_max_energy_norm }}
norm = "{{ norm }}"
mel_scale = "{{ mel_scale }}"
compression = {{ compression }}

import os
import torch
import soundfile as sf
import torchaudio
from huggingface_hub import hf_hub_download
from speechbrain.inference.vocoders import HIFIGAN
import torchaudio.transforms as T

weights_path = hf_hub_download(repo_id=repo_id, filename="generator.ckpt")
hparams_path = hf_hub_download(repo_id=repo_id, filename="hyperparams.yaml")

waveform_np, sr = sf.read(audio_path)
waveform = torch.from_numpy(waveform_np).float()
if waveform.ndim == 1:
    waveform = waveform.unsqueeze(0)
else:
    waveform = waveform.transpose(0, 1)

if sr != sample_rate:
    waveform = torchaudio.transforms.Resample(orig_freq=sr, new_freq=sample_rate)(waveform)

vocoder = HIFIGAN.from_hparams(source=repo_id, savedir=os.path.dirname(weights_path), run_opts={"device": device})

mel_transform = T.MelSpectrogram(sample_rate=sample_rate, n_fft=n_fft, win_length=win_length, hop_length=hop_length, f_min=f_min, f_max=f_max, n_mels=n_mels, power=power, normalized=normalized, norm=norm, mel_scale=mel_scale)
spectrogram = mel_transform(waveform.squeeze()).to(device)
waveforms = vocoder.decode_batch(spectrogram)
output_waveform = waveforms.squeeze(1).detach().cpu()

RESULT = {"waveform": output_waveform, "sample_rate": sample_rate}
