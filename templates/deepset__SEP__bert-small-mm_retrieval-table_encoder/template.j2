{% set repo_id = repo_id | default("deepset/bert-small-mm_retrieval-table_encoder") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("Deep learning enables efficient retrieval embeddings.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os

import numpy as np
import torch
from transformers import AutoTokenizer, DPRContextEncoder

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = DPRContextEncoder.from_pretrained(repo_id).to(device)
model.eval()

encoded_input = tokenizer(
    input_text,
    truncation=True,
    max_length=512,
    return_tensors="pt",
)
encoded_input = {key: value.to(device) for key, value in encoded_input.items()}

with torch.no_grad():
    model_output = model(**encoded_input)

embeddings = model_output.pooler_output.detach().cpu().numpy()
RESULT = {"embeddings": embeddings}
