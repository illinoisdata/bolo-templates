{% set repo_id = repo_id | default("circulus/kobart-chat-all-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('안녕하세요. 오늘 기분은 어떠세요?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoTokenizer, AutoConfig, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

repo_dir = os.path.dirname(weights_path)
config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_dir, config=config)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=64,
        num_beams=4,
        do_sample=False,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
