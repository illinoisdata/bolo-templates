{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("circulus/kobart-chat-all-v2") %}
{% set prompt = prompt | default("안녕하세요! 무엇을 도와드릴까요?") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(prompt, return_tensors="pt")
tokenized_inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}

generated_ids = model.generate(
    **tokenized_inputs,
    max_new_tokens=max_new_tokens,
    pad_token_id=tokenizer.pad_token_id,
)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
