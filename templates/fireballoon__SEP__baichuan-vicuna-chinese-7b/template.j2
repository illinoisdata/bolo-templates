{% set repo_id = repo_id | default("fireballoon/baichuan-vicuna-chinese-7b") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, this is a quick test of baichuan-vicuna-chinese-7b.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set temperature = temperature | default(0.7) %}
{% set top_p = top_p | default(0.95) %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
generated_output = pipe(input_prompt, max_new_tokens=max_new_tokens, temperature=temperature, top_p=top_p)
RESULT = {"generated_output": generated_output}
