{% set input_text = "côn viec kinh doanh thì rất khó khăn nên tôi quyết định chuyển sang nghề khác" %}
{% set max_length = 512 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/bmd1905__SEP__vietnamese-correction" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os
from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM


# Load tokenizer and model onto the target device
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
)
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(**tokenized_inputs, max_length=max_length)
generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"corrected_text": generated_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = Path(output_dir) / "corrected_text.txt"
    output_path.write_text(generated_text, encoding="utf-8")