{% set repo_id = "schhwmn/mbart-large-50-finetuned-ukr-gec" %}
{% set device = "cuda:0" %}
{% set text = 'я й не думав що комп\'ютерна лінгвістика це легкоо.' %}
{% set num_beams = 5 %}
{% set max_length = 200 %}
{% set early_stopping = true %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
early_stopping = {{ early_stopping }}

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model.generate(**inputs, num_beams=num_beams, max_length=max_length, early_stopping=early_stopping)
generated_text = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
