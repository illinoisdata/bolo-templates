{% set repo_id = repo_id | default("laion/CLIP-ViT-L-14-CommonPool.XL.clip-s13B-b90K") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompts = text_prompts | default(['a photo of a cat', 'a photo of a dog', 'a photo of a bird']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompts = {{ text_prompts }}

import json
from io import BytesIO
from urllib.parse import urlparse

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
import open_clip
from open_clip.transform import image_transform

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")

with open(config_path, "r") as f:
    config = json.load(f)

model_cfg = config.get("model_cfg", {})
pretrained_cfg = config.get("pretrained_cfg", {})
model_name = model_cfg.get("model_name", "ViT-L-14")

image_size = pretrained_cfg.get("image_size", 224)
mean = pretrained_cfg.get("mean", [0.48145466, 0.4578275, 0.40821073])
std = pretrained_cfg.get("std", [0.26862954, 0.26130258, 0.27577711])

model = open_clip.create_model(model_name, pretrained=None)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()

preprocess = image_transform(
    image_size=image_size,
    is_train=False,
    mean=tuple(mean),
    std=tuple(std),
)

tokenizer = open_clip.get_tokenizer(model_cfg.get("text_cfg", {}).get("hf_tokenizer_name", repo_id))

if urlparse(image_path).scheme in ("http", "https"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer(text_prompts).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logit_scale = model.logit_scale.exp()
    logits_per_image = logit_scale * image_features @ text_features.T
    probs = logits_per_image.softmax(dim=-1)[0]
    top_idx = int(torch.argmax(probs).item())

RESULT = {
    "labels": text_prompts,
    "probabilities": probs.detach().cpu().tolist(),
    "top_label": text_prompts[top_idx],
}
