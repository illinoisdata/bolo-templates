{% set repo_id = "charsiu/g2p_multilingual_byT5_small_100" %}
{% set device = "cuda:0" %}
{% set text_input = "Sample text for grapheme to phoneme conversion." %}
{% set max_length = 64 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

decoded_sequences = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
if len(decoded_sequences) == 1:
    generated_output = decoded_sequences[0]
else:
    generated_output = "\n".join(decoded_sequences)

RESULT = {"generated_text": generated_output}
