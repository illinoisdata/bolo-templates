{% set repo_id = repo_id %}
{% set device = device %}
{% set text_input = "Sample text for grapheme to phoneme conversion." %}
{% set max_length = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/charsiu__SEP__g2p_multilingual_byT5_small_100" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = """{{ text_input }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_beams=num_beams,
    )

decoded_sequences = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
if len(decoded_sequences) == 1:
    generated_output = decoded_sequences[0]
else:
    generated_output = "\n".join(decoded_sequences)

RESULT = {"generated_text": generated_output}

if __name__ == "__main__":
    destination = Path(output_dir)
    destination.mkdir(parents=True, exist_ok=True)
    (destination / "generated_text.txt").write_text(
        RESULT["generated_text"],
        encoding="utf-8",
    )