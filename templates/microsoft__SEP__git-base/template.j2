{% set device = "cuda:0" %}
{% set repo_id = "microsoft/git-base" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set prompt = "" %}
{% set max_new_tokens = 64 %}
{% set num_return_sequences = 1 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = """{{ prompt }}"""
max_new_tokens = {{ max_new_tokens }}
num_return_sequences = {{ num_return_sequences }}

import os
from io import BytesIO
import requests
import torch
from PIL import Image
from transformers import AutoModelForCausalLM, AutoProcessor

processor = AutoProcessor.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

def _is_url(path: str) -> bool:
    return path.startswith("http://") or path.startswith("https://")

def _load_image(source: str) -> Image.Image:
    if _is_url(source):
        response = requests.get(source)
        response.raise_for_status()
        return Image.open(BytesIO(response.content)).convert("RGB")
    return Image.open(source).convert("RGB")

image = _load_image(image_path)
if prompt:
    inputs = processor(text=prompt, images=image, return_tensors="pt")
else:
    inputs = processor(images=image, return_tensors="pt")

inputs_for_model = {}
for key, tensor in inputs.items():
    if isinstance(tensor, torch.Tensor):
        inputs_for_model[key] = tensor.to(device)
    else:
        inputs_for_model[key] = tensor

with torch.no_grad():
    generated = model.generate(
        **inputs_for_model,
        max_new_tokens=max_new_tokens,
        num_return_sequences=num_return_sequences,
    )

captions = processor.batch_decode(generated, skip_special_tokens=True)

RESULT = {"captions": captions}
