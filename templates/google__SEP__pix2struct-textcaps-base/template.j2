{% set repo_id = repo_id | default("google/pix2struct-textcaps-base") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt_text = prompt_text | default('A picture of') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt_text = "{{ prompt_text }}"

import os
import requests
from PIL import Image
import torch
from transformers import Pix2StructForConditionalGeneration, Pix2StructProcessor

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

processor = Pix2StructProcessor.from_pretrained(repo_id)
model = Pix2StructForConditionalGeneration.from_pretrained(repo_id).to(device)

inputs = processor(images=image, text=prompt_text, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    predictions = model.generate(**inputs, max_new_tokens=32)

output_text = processor.decode(predictions[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
