{% set repo_id = "google/pix2struct-textcaps-base" %}
{% set device = "cuda:0" %}
{% set image_path = "/u/yli77/projects/ML-code-generation/data/image1.jpeg" %}
{% set prompt_text = "" %}
{% set max_patches = None %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
image_path = {{ image_path | tojson }}
prompt_text = {{ prompt_text | tojson }}
max_patches = {{ max_patches }}

import os
from pathlib import Path

import requests
import torch
from PIL import Image
from transformers import Pix2StructForConditionalGeneration, Pix2StructProcessor

processor = Pix2StructProcessor.from_pretrained(repo_id)
model = Pix2StructForConditionalGeneration.from_pretrained(repo_id).to(device)

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path, stream=True)
    image = Image.open(response.raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor_inputs = {"images": image, "return_tensors": "pt"}
if prompt_text:
    processor_inputs["text"] = prompt_text
if max_patches is not None:
    processor_inputs["max_patches"] = max_patches

inputs = processor(**processor_inputs).to(device)
outputs = model.generate(**inputs)
captions = [processor.decode(seq.cpu(), skip_special_tokens=True) for seq in outputs]

RESULT = {"captions": captions}
