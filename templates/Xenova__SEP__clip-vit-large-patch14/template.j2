{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set candidate_labels = candidate_labels | default(['a photo of a cat', 'a photo of two cats', 'a photo of a dog', 'a painting', 'a person']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
candidate_labels = {{ candidate_labels | tojson }}

import requests
import torch
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import CLIPModel, CLIPImageProcessor, CLIPTokenizer

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image_processor = CLIPImageProcessor.from_pretrained(repo_id)
tokenizer = CLIPTokenizer.from_pretrained(repo_id)
model = CLIPModel.from_pretrained("openai/clip-vit-large-patch14").to(device)
model.eval()

inputs = image_processor(images=image, return_tensors="pt")
text_inputs = tokenizer(candidate_labels, padding=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
text_inputs = {k: v.to(device) for k, v in text_inputs.items()}

with torch.no_grad():
    image_outputs = model.vision_model(**inputs)
    image_features = model.visual_projection(image_outputs.pooler_output)
    text_outputs = model.text_model(**text_inputs)
    text_features = model.text_projection(text_outputs.pooler_output)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logits_per_image = model.logit_scale.exp() * image_features @ text_features.T
    probs = logits_per_image.softmax(dim=-1).squeeze(0).detach().cpu().tolist()

RESULT = {"labels": candidate_labels, "probabilities": probs}
