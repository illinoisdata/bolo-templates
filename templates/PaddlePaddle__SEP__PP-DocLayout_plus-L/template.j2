{% set model_name = model_name | default('PP-DocLayout_plus-L') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
model_name = "{{ model_name }}"

import os
from pathlib import Path
from urllib.parse import urlparse
import numpy as np
from PIL import Image
import paddle
from huggingface_hub import hf_hub_download
from paddleocr import LayoutDetection

weights_path = hf_hub_download(repo_id=repo_id, filename="inference.pdiparams")
config_path = hf_hub_download(repo_id=repo_id, filename="inference.yml")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
    image_input = image
else:
    image_input = image_path

model = LayoutDetection(model_name=model_name)
output = model.predict(image_input, batch_size=1, layout_nms=True)

results = []
for res in output:
    if hasattr(res, "json"):
        results.append(res.json)
    elif hasattr(res, "to_dict"):
        results.append(res.to_dict())
    else:
        results.append(str(res))

RESULT = {"output": results}
