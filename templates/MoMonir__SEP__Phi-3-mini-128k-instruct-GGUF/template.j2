{% set repo_id = repo_id | default("MoMonir/Phi-3-mini-128k-instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("phi-3-mini-128k-instruct.Q4_K_M.gguf") %}
{% set prompt = prompt | default("Write a short haiku about machine learning.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=4096,
    n_threads=4,
    n_batch=512,
    n_gpu_layers=0 if str(device).startswith("cpu") else -1,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

# Phi-3 instruct models support chat-style prompting through the Llama chat completion API.
output = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    top_p=0.9,
    max_tokens=128,
)

RESULT = {"output": output}
