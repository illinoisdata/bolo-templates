{% set repo_id = repo_id | default("google/t5-small-lm-adapt") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('summarize: The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from the repository files already downloaded
_tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
_model.to(device)
_model.eval()

inputs = _tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = _model.generate(
        **inputs,
        max_new_tokens=32,
        num_beams=4,
        do_sample=False,
    )

output_text = _tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
