{% set repo_id = repo_id | default("google/t5-small-lm-adapt") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("translate English to German: The house is wonderful.") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__t5-small-lm-adapt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

import os
from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
generated_tokens = model.generate(**inputs, max_new_tokens=max_new_tokens)
generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "generated_text.txt").write_text(RESULT["generated_text"], encoding="utf-8")