{% set repo_id = repo_id | default("microsoft/speecht5_asr") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("automatic-speech-recognition") -%}
{% set model = model | default(repo_id) -%}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") -%}
{% set ld_library_path = ld_library_path | default("/workspace/.pip/nvidia/cu13/lib") -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}
ld_library_path = {{ ld_library_path | tojson }}

import os
existing_ld_library = os.environ.get("LD_LIBRARY_PATH")
if existing_ld_library:
    os.environ["LD_LIBRARY_PATH"] = ld_library_path + ":" + existing_ld_library
else:
    os.environ["LD_LIBRARY_PATH"] = ld_library_path

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_data)
