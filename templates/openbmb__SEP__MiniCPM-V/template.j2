{% set repo_id = repo_id | default("openbmb/MiniCPM-V") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is in the image?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import os
import torch
from PIL import Image
from transformers import AutoModel, AutoTokenizer

model = AutoModel.from_pretrained(repo_id, trust_remote_code=True, torch_dtype=torch.bfloat16)
if device.startswith('cuda') and torch.cuda.is_available():
    model = model.to(device=device, dtype=torch.bfloat16)
else:
    model = model.to(device=device)

tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
model.eval()

image_path = '/u/yunqili4/projects/ML-code-generation/data/image1.jpeg'
if image_path.startswith('http://') or image_path.startswith('https://'):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, stream=True).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

msgs = [{'role': 'user', 'content': question}]
res, context, _ = model.chat(
    image=image,
    msgs=msgs,
    context=None,
    tokenizer=tokenizer,
    sampling=True,
    temperature=0.7,
)

RESULT = {'output': res, 'context': context}
