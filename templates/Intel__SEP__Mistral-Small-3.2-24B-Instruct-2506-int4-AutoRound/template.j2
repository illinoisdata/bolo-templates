{% set repo_id = repo_id | default("Intel/Mistral-Small-3.2-24B-Instruct-2506-int4-AutoRound") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Which country is shown in the image? Answer with the country name only.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import os
from datetime import datetime, timedelta

import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor, AutoTokenizer, Mistral3ForConditionalGeneration


def load_system_prompt(repo_id: str, filename: str) -> str:
    if os.path.isdir(repo_id):
        file_path = os.path.join(repo_id, filename)
    else:
        file_path = hf_hub_download(repo_id=repo_id, filename=filename)
    with open(file_path, 'r') as file:
        system_prompt = file.read()
    today = datetime.today().strftime('%Y-%m-%d')
    yesterday = (datetime.today() - timedelta(days=1)).strftime('%Y-%m-%d')
    model_name = repo_id.split('/')[-1]
    return system_prompt.format(name=model_name, today=today, yesterday=yesterday)


def load_image(path_or_url: str) -> Image.Image:
    if path_or_url.startswith('http://') or path_or_url.startswith('https://'):
        return Image.open(requests.get(path_or_url, stream=True).raw).convert('RGB')
    return Image.open(path_or_url).convert('RGB')


SYSTEM_PROMPT = load_system_prompt(repo_id, 'SYSTEM_PROMPT.txt')
processor = AutoProcessor.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = Mistral3ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
).to(device)
model.eval()

image = load_image(image_path)
messages = [
    {'role': 'system', 'content': SYSTEM_PROMPT},
    {
        'role': 'user',
        'content': [
            {'type': 'text', 'text': prompt},
            {'type': 'image'},
        ],
    },
]
text = processor.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)
inputs = processor(text=[text], images=[image], return_tensors='pt', add_special_tokens=False)
inputs = {k: v.to(device) if torch.is_tensor(v) else v for k, v in inputs.items()}

input_len = inputs['input_ids'].shape[-1]
with torch.inference_mode():
    generation = model.generate(**inputs, max_new_tokens=64, do_sample=False)
    generation = generation[0][input_len:]

decoded = processor.decode(generation, skip_special_tokens=True)
RESULT = {'output': decoded}
