{% set repo_id = "Helsinki-NLP/opus-mt-uk-ru" %}
{% set device = "cuda:0" %}
{% set text = "Привіт, світ!" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-uk-ru" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt").to(device)
generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    file_path = output_path / "translation.txt"
    with file_path.open("w", encoding="utf-8") as f:
        for line in RESULT["translation"]:
            f.write(line)
            f.write("\n")