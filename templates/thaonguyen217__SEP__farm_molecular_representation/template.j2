{% set repo_id = repo_id | default("thaonguyen217/farm_molecular_representation") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("N_primary_amine N_secondary_amine c_6-6 1 n_6-6 n_6-6 c_6-6 c_6-6 2 c_6-6 c_6-6 c_6-6 c_6-6 c_6-6 1 2") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import os
import json
import torch
from transformers import BertForMaskedLM, PreTrainedTokenizerFast
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

tokenizer = PreTrainedTokenizerFast.from_pretrained(os.path.dirname(tokenizer_file), local_files_only=True)
model = BertForMaskedLM.from_pretrained(os.path.dirname(model_file), local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs, output_hidden_states=True)

last_hidden_states = outputs.hidden_states[-1][0].detach().cpu()
RESULT = {"last_hidden_states": last_hidden_states}
