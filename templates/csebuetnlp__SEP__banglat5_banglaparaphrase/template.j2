{% set repo_id = repo_id | default("csebuetnlp/banglat5_banglaparaphrase") %}
{% set device = device | default("cuda:0") %}
{% set input_sentence = input_sentence | default("আমি বাংলায় কথা বলতে ভালোবাসি।") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sentence = "{{ input_sentence }}"

from pathlib import Path

import torch

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)

encoding = tokenizer(input_sentence, return_tensors="pt", padding=True)
encoding = {key: value.to(torch_device) for key, value in encoding.items()}

generated_tokens = model.generate(**encoding)

paraphrase = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True, clean_up_tokenization_spaces=True)[0]

RESULT = {"paraphrase": paraphrase}
