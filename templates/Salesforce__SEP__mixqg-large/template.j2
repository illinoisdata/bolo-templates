{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Salesforce/mixqg-large") %}
{% set context = context | default("In the late 17th century, Robert Boyle proved that air is necessary for combustion.") %}
{% set answer = answer | default("Robert Boyle") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = "{{ context }}"
answer = "{{ answer }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

def format_inputs(context: str, answer: str) -> str:
    return f"{answer}\n{context}"

text = format_inputs(context, answer)
inputs = tokenizer(text, return_tensors="pt")
input_ids = inputs.input_ids.to(device)

generated_ids = model.generate(input_ids, max_length=max_length, num_beams=num_beams)
outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_question = outputs[0] if outputs else ""

RESULT = {"generated_question": generated_question}
