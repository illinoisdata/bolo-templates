{% set device = "cuda:0" %}
{% set repo_id = "DeepChem/ChemBERTa-77M-MTR" %}
{% set input_smiles = "CCO" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_smiles = "{{ input_smiles }}"

import json
from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSequenceClassification

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(input_smiles, truncation=True, padding=True, return_tensors="pt")
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

outputs = model(**encoded_inputs)
logits = outputs.logits[0].detach().cpu().tolist()
id2label = getattr(model.config, "id2label", {})
per_label_scores = (
    {id2label.get(str(index), str(index)): value for index, value in enumerate(logits)}
    if id2label
    else {str(index): value for index, value in enumerate(logits)}
)

RESULT = {"regression_per_label": per_label_scores}
