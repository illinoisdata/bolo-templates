{% set repo_id = repo_id | default("vikp/surya_det") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set threshold = threshold | default(0.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
threshold = {{ threshold }}

import json
import os
from pathlib import Path

import numpy as np
import torch
from PIL import Image
from safetensors.torch import load_file
from transformers import AutoConfig, AutoImageProcessor, SegformerForSemanticSegmentation
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

config = AutoConfig.from_pretrained(config_path)
model = SegformerForSemanticSegmentation(config)
state_dict = load_file(weights_path)
model.load_state_dict({k: v for k, v in state_dict.items() if k != "decode_head.linear_fuse.weight"}, strict=False)
model.to(device)
model.eval()

processor = AutoImageProcessor.from_pretrained(preprocessor_path)

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
prob_text = torch.softmax(logits, dim=1)[:, 1:2]
mask = (prob_text > threshold).squeeze(0).squeeze(0).detach().cpu().numpy().astype(np.uint8)

RESULT = {"mask": mask, "prob_text": prob_text.squeeze(0).squeeze(0).detach().cpu().numpy()}
