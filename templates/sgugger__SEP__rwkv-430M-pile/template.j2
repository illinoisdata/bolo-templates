{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sgugger/rwkv-430M-pile") %}
{% set prompt = prompt | default("Hello, my name is") %}
{% set max_new_tokens = max_new_tokens | default(50) %}
{% set temperature = temperature | default(1.0) %}
{% set do_sample = do_sample | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
do_sample = {{ do_sample }}

from transformers import AutoTokenizer, AutoModelForCausalLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id)
model.to(device)

encoded_input = tokenizer(prompt, return_tensors="pt")
encoded_input = {k: v.to(device) for k, v in encoded_input.items()}

output_ids = model.generate(
    **encoded_input,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    do_sample=do_sample,
)

generated_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
