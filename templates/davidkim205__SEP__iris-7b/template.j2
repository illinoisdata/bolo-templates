{% set repo_id = repo_id %}
{% set device = device %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/davidkim205__SEP__iris-7b" %}
{% set direction = "ko2en" %}
{% set text = "아이리스는 딥러닝을 기반으로 한 한-영어 문장 번역을 위한 모델이다." %}
{% set max_new_tokens = 2048 %}
{% set temperature = 1.0 %}
{% set num_beams = 5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
direction = "{{ direction }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

# Load model and tokenizer
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id, torch_dtype=torch.bfloat16)
model.to(device)
model.eval()

# Prepare prompt based on translation direction
if direction == "ko2en":
    prompt = f"[INST] 다음 문장을 영어로 번역하세요.{text} [/INST]"
elif direction == "en2ko":
    prompt = f"[INST] 다음 문장을 한글로 번역하세요.{text} [/INST]"
else:
    raise ValueError(f"Unsupported direction: {direction}")

inputs = tokenizer(prompt, return_tensors="pt", return_token_type_ids=False)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Inference
gen_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    num_beams=num_beams,
)

# Post-process
prompt_length = inputs["input_ids"].shape[1]
output_tokens = gen_tokens[0, prompt_length:]
result = tokenizer.decode(output_tokens)

# Build RESULT
RESULT = {"translation": result}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translation.txt"), "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])