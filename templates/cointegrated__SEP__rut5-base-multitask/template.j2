{% set repo_id = repo_id | default("cointegrated/rut5-base-multitask") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('fill | Почему они не ___ на меня?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="spiece.model")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = T5Tokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt").to(device)
with torch.no_grad():
    generated = model.generate(**inputs, num_beams=5)
output = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output": output}
