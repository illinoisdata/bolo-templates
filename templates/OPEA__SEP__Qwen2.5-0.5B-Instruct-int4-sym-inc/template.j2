{% set repo_id = repo_id | default("OPEA/Qwen2.5-0.5B-Instruct-int4-sym-inc") %}
{% set device = device | default("cuda:0") %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set prompt = prompt | default('Please introduce Alibaba Group briefly in Chinese.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
max_new_tokens = {{ max_new_tokens }}
prompt = {{ prompt | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

# Load tokenizer/model from the repository local cache directory derived from a downloaded file path.
import os
model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, trust_remote_code=False)
model = AutoModelForCausalLM.from_pretrained(
    model_dir,
    torch_dtype=torch.float16,
    device_map=None,
    trust_remote_code=False,
)
model = model.to(device)
model.eval()

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]
text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        pad_token_id=tokenizer.eos_token_id,
    )

input_len = inputs["input_ids"].shape[-1]
output_ids = generated[0, input_len:]
output_text = tokenizer.decode(output_ids, skip_special_tokens=True)

RESULT = {"text": output_text}
