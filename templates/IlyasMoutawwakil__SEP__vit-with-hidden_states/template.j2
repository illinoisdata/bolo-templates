{% set repo_id = repo_id | default("IlyasMoutawwakil/vit-with-hidden_states") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set image_processor_repo = image_processor_repo | default("google/vit-base-patch16-224-in21k") %}

task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
image_processor_repo = {{ image_processor_repo | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
model = repo_id

from transformers import AutoImageProcessor, pipeline

image_processor = AutoImageProcessor.from_pretrained(image_processor_repo)

pipe = pipeline(task=task, model=model, image_processor=image_processor, device=device)
RESULT = pipe(input_image)
