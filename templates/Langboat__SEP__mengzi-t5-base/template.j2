{% set device = "cuda:0" %}
{% set repo_id = "Langboat/mengzi-t5-base" %}
{% set text_input = "翻译以下中文：今天的天气晴朗，想让模型用更优美的语言表达。" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

encoded_inputs = tokenizer(text_input, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)
generated_tokens = generated_tokens.to("cpu")
decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
generated_text = decoded_texts[0] if decoded_texts else ""

RESULT = {"generated_text": generated_text}
