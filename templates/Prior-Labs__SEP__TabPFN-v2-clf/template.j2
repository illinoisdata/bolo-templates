{% set repo_id = repo_id | default("Prior-Labs/TabPFN-v2-clf") %}
{% set device = device | default("cuda:0") %}
{% set X = X | default([[5.1, 3.5, 1.4, 0.2], [4.9, 3.0, 1.4, 0.2], [6.2, 2.9, 4.3, 1.3], [5.9, 3.0, 5.1, 1.8], [6.0, 2.2, 4.0, 1.0], [5.5, 2.4, 3.8, 1.1]]) %}
{% set y = y | default([0, 0, 1, 2, 1, 1]) %}
{% set x_query = x_query | default([[5.0, 3.4, 1.5, 0.2], [6.1, 2.8, 4.0, 1.3], [6.3, 3.3, 6.0, 2.5]]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
X = {{ X }}
y = {{ y }}
x_query = {{ x_query }}

import json
import numpy as np
from huggingface_hub import hf_hub_download
from tabpfn import TabPFNClassifier

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
with open(config_path, "r") as f:
    _config = json.load(f)

ckpt_path = hf_hub_download(repo_id=repo_id, filename="tabpfn-v2-classifier-v2_default.ckpt")

X = np.asarray(X, dtype=np.float32)
y = np.asarray(y, dtype=np.int64)
x_query = np.asarray(x_query, dtype=np.float32)

model = TabPFNClassifier(model_path=ckpt_path, device=device, show_progress_bar=False)
model.fit(X, y)
proba = model.predict_proba(x_query)
pred = model.predict(x_query)

RESULT = {
    "predictions": pred.tolist(),
    "probabilities": proba.tolist(),
}
