{% set repo_id = repo_id | default("allenai/unifiedqa-t5-3b") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("What is the capital of France?") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from pathlib import Path

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)

outputs = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
