{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("declare-lab/flan-alpaca-large") %}
{% set prompt = prompt | default("Write an email about an alpaca that likes flan") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set do_sample = do_sample | default(true) %}
{% set temperature = temperature | default(0.7) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
do_sample = {{ "True" if do_sample else "False" }}
temperature = {{ temperature }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenized_inputs = tokenizer(prompt, return_tensors="pt")
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_ids = model.generate(
    **tokenized_inputs,
    max_new_tokens=max_new_tokens,
    do_sample=do_sample,
    temperature=temperature,
)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"generated_text": generated_text}
