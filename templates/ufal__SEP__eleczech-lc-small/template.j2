{% set repo_id = repo_id | default("ufal/eleczech-lc-small") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Příliš žluťoučký kůň úpěl ďábelské ódy.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

model = AutoModel.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)
if pooler_output is None:
    attention_mask = inputs.get("attention_mask")
    if attention_mask is not None:
        mask = attention_mask.unsqueeze(-1).type_as(last_hidden_state)
        pooler_output = (last_hidden_state * mask).sum(dim=1) / mask.sum(dim=1).clamp(min=1e-9)
    else:
        pooler_output = last_hidden_state[:, 0]

RESULT = {
    "last_hidden_state": last_hidden_state.detach().cpu(),
    "pooler_output": pooler_output.detach().cpu(),
}
