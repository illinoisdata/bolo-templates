{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ufal/eleczech-lc-small") %}
{% set text_input = text_input | default("Toto je [MASK] věta.") %}
{% set top_k = top_k | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
top_k = {{ top_k }}

# 3. Imports
from pathlib import Path
import json

from transformers import AutoTokenizer, AutoModelForMaskedLM, pipeline

# 4. Load tokenizer/processor & model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
if device.startswith("cuda"):
    pipeline_device = int(device.split(":", 1)[1]) if ":" in device else 0
else:
    pipeline_device = -1
fill_mask_pipeline = pipeline(
    "fill-mask",
    model=model,
    tokenizer=tokenizer,
    device=pipeline_device,
)

# 5. Pre-process input
input_text = text_input

# 6. Run inference
fill_mask_output = fill_mask_pipeline(input_text, top_k=top_k)

# 7. Post-process & build RESULT dict
RESULT = {"fill_mask": fill_mask_output}

# 8. if __name__ == "__main__": guard
