{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("circulus/kobart-chat-mixed-v2") %}
{% set user_prompt = user_prompt | default("안녕하세요! 오늘 어떤 대화를 나누고 싶으세요?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set temperature = temperature | default(1.0) %}
{% set do_sample = do_sample | default(false) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
user_prompt = "{{ user_prompt }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
do_sample = {{ "True" if do_sample else "False" }}
num_return_sequences = {{ num_return_sequences }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(user_prompt, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_new_tokens=max_new_tokens,
    temperature=temperature,
    do_sample=do_sample,
    num_return_sequences=num_return_sequences,
)

generated_texts = tokenizer.batch_decode(
    generated_tokens, skip_special_tokens=True, clean_up_tokenization_spaces=True
)

RESULT = {"generated_texts": generated_texts}
