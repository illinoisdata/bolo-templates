{% set repo_id = repo_id | default("MarkS/bart-base-qa2d") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("question: what day is it today? answer: Tuesday") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import BartTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

tokenizer = BartTokenizer.from_pretrained(repo_id, local_files_only=True)
model = BartForConditionalGeneration.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        input_ids=inputs["input_ids"],
        attention_mask=inputs.get("attention_mask"),
        num_beams=4,
        max_length=64,
    )

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
output_text = decoded[0] if len(decoded) == 1 else decoded

RESULT = {"output": output_text}
