{% set repo_id = repo_id | default("Xenova/nllb-200-distilled-600M") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('The house is wonderful.') %}
{% set src_lang = src_lang | default('eng_Latn') %}
{% set tgt_lang = tgt_lang | default('fra_Latn') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}
src_lang = {{ src_lang | tojson }}
tgt_lang = {{ tgt_lang | tojson }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
sentencepiece_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
model_path = hf_hub_download(repo_id=repo_id, filename="onnx/decoder_model.onnx")

# Load tokenizer/model from the original base model; this repo provides ONNX weights.
tokenizer = AutoTokenizer.from_pretrained(repo_id, src_lang=src_lang, tgt_lang=tgt_lang)
model = AutoModelForSeq2SeqLM.from_pretrained("facebook/nllb-200-distilled-600M")
model = model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
forced_bos_token_id = tokenizer.convert_tokens_to_ids(tgt_lang)
output_ids = model.generate(**inputs, forced_bos_token_id=forced_bos_token_id, max_new_tokens=64)
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
