{% set repo_id = repo_id | default("timm/darknet53.c2ns_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_image = "{{ input_image }}"

from transformers import pipeline
from PIL import Image

if device.startswith("cuda"):
    pipeline_device = int(device.split(":")[-1])
else:
    pipeline_device = -1

pipe = pipeline(task=task, model=repo_id, device=pipeline_device)

image = Image.open(input_image).convert("RGB")

RESULT = pipe(image)
RESULT = {"predictions": RESULT}
