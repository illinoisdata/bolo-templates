{% set repo_id = repo_id | default("trl-internal-testing/tiny-T5ForConditionalGeneration") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('summarize: The quick brown fox jumps over the lazy dog. This sentence is used as a simple test input for a tiny T5 model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=16)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
RESULT = {"generated_text": decoded[0]}
