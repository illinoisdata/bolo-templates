{% set repo_id = repo_id | default("juierror/flan-t5-text2sql-with-schema") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('get people name with age equal 25') %}
{% set table = table | default(['id', 'name', 'age']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
table = {{ table }}

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Load tokenizer/model from repo files available locally after download.
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    tokenizer_file=tokenizer_json_path,
    tokenizer_config_file=tokenizer_config_path,
    special_tokens_map_file=special_tokens_map_path,
)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

table_prefix = "table:"
question_prefix = "question:"
join_table = ",".join(table)
inputs = f"{question_prefix} {question} {table_prefix} {join_table}"
input_ids = tokenizer(inputs, max_length=512, return_tensors="pt").input_ids.to(device)

with torch.no_grad():
    outputs = model.generate(inputs=input_ids, num_beams=10, top_k=10, max_length=700)
result = tokenizer.decode(token_ids=outputs[0], skip_special_tokens=True)

RESULT = {"output": result}
