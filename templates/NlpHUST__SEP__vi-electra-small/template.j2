{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("NlpHUST/vi-electra-small") %}
{% set text_input = text_input | default("Thế giới ML phát triển nhanh chóng.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from pathlib import Path
import json

from transformers import AutoTokenizer, AutoModelForPreTraining

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}
outputs = model(**inputs)

input_ids_cpu = inputs["input_ids"][0].cpu()
tokens = tokenizer.convert_ids_to_tokens(input_ids_cpu)

discriminator_logits = outputs.logits.detach().cpu().tolist()

RESULT = {
    "tokens": tokens,
    "discriminator_logits": discriminator_logits,
}
