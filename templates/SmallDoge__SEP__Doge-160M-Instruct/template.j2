{% set repo_id = repo_id | default("SmallDoge/Doge-160M-Instruct") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hi, how are you doing today?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForCausalLM

_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    trust_remote_code=True,
    torch_dtype=torch.bfloat16,
    device_map=None,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, trust_remote_code=True)

conversation = [{"role": "user", "content": prompt}]
inputs = tokenizer.apply_chat_template(
    conversation=conversation,
    tokenize=True,
    return_tensors="pt",
)
inputs = inputs.to(device)

with torch.no_grad():
    generated = model.generate(
        inputs,
        max_new_tokens=100,
        do_sample=True,
        temperature=0.8,
        top_p=0.9,
        repetition_penalty=1.0,
        use_cache=True,
    )

output_text = tokenizer.decode(generated[0][inputs.shape[-1]:], skip_special_tokens=True)
RESULT = {"text": output_text}
