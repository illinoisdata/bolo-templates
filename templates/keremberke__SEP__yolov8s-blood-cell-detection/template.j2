{% set repo_id = repo_id | default("keremberke/yolov8s-blood-cell-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import os
from pathlib import Path
import torch
from PIL import Image
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if isinstance(image, str) and image.startswith(("http://", "https://")):
    image_input = image
else:
    image_input = Image.open(image).convert("RGB")

model = YOLO(weights_path)
results = model.predict(image_input, device=device, conf=conf, iou=iou, agnostic_nms=agnostic_nms, max_det=max_det)
result = results[0]
render = result.plot()
boxes = result.boxes
labels = []
if boxes is not None and boxes.cls is not None:
    cls_ids = boxes.cls.detach().cpu().tolist()
    names = result.names
    labels = [names[int(i)] for i in cls_ids]

RESULT = {
    "boxes": boxes,
    "labels": labels,
    "render": render,
}
