{% set repo_id = repo_id | default("optimum-intel-internal-testing/tiny-doc-qa-vision-encoder-decoder") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set question = question | default('What is the document about?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
question = "{{ question }}"

import json
import torch
from PIL import Image
from transformers import AutoTokenizer, DonutImageProcessor, VisionEncoderDecoderConfig, VisionEncoderDecoderModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
repo_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
repo_dir = str(__import__('pathlib').Path(repo_file).parent)


def load_image(path_or_url):
    if str(path_or_url).startswith(("http://", "https://")):
        import requests
        from io import BytesIO
        return Image.open(BytesIO(requests.get(path_or_url, timeout=30).content)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")

with open(config_path, "r") as f:
    cfg = json.load(f)
config = VisionEncoderDecoderConfig.from_dict(cfg)
model = VisionEncoderDecoderModel(config)
state_dict = torch.load(model_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

processor = DonutImageProcessor.from_pretrained(str(__import__('pathlib').Path(processor_config_path).parent))
tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)

image = load_image(image_path)
pixel_values = processor(image, return_tensors="pt").pixel_values.to(device)
prompt = f"<s_docvqa><s_question>{question}</s_question><s_answer>"
decoder_input_ids = tokenizer(prompt, add_special_tokens=False, return_tensors="pt").input_ids.to(device)

with torch.no_grad():
    generated_ids = model.generate(pixel_values=pixel_values, decoder_input_ids=decoder_input_ids, max_new_tokens=16)

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"output_text": output_text}
