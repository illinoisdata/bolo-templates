{% set quant_filename = quant_filename | default('LFM2-2.6B-Q4_K_M.gguf') %}
{% set repo_id = repo_id | default("LiquidAI/LFM2-2.6B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Write a short, friendly haiku about edge AI.') %}

repo_id = "{{ repo_id }}"
quant_filename = "{{ quant_filename }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import os
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

if device.startswith("cuda") and torch.cuda.is_available():
    n_gpu_layers = -1
else:
    n_gpu_layers = 0

llm = Llama(
    model_path=weights_path,
    n_ctx=256,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

result = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.9,
    stop=["</s>"]
)

output_text = result["choices"][0]["text"]

RESULT = {"generated_text": output_text}
