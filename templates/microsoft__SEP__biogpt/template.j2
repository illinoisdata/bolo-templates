{% set repo_id = repo_id | default("microsoft/biogpt") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("COVID-19 is") %}
{% set model = model | default(repo_id) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

prompt = input_prompt
pipe_output = pipe(prompt)

RESULT = {"generated_text": pipe_output}
