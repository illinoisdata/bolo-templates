{% set repo_id = repo_id | default("Vamsi/T5_Paraphrase_Paws") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("paraphrase: This is something which I cannot understand at all </s>") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
model = {{ model | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
