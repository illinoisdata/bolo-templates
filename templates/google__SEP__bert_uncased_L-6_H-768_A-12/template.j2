{% set repo_id = repo_id | default("google/bert_uncased_L-6_H-768_A-12") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import json
import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

with open(config_path, "r") as f:
    _ = json.load(f)

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=True)
model = BertModel.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu().tolist()
pooler_output = outputs.pooler_output.detach().cpu().tolist() if outputs.pooler_output is not None else None

RESULT = {"last_hidden_state": last_hidden_state, "pooler_output": pooler_output}
