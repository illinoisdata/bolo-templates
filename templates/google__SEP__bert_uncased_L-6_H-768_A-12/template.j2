{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("google/bert_uncased_L-6_H-768_A-12") %}
{% set text_inputs = text_inputs | default(["The quick brown fox jumps over the lazy dog.", "Transformers enable easy model reuse."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs }}

import json
import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(text_inputs, padding=True, truncation=True, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

pooled_embeddings = outputs.pooler_output.detach().cpu().tolist()
token_embeddings = outputs.last_hidden_state.detach().cpu().tolist()

RESULT = {
    "pooled_embeddings": pooled_embeddings,
    "token_embeddings": token_embeddings,
}
