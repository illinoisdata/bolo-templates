{% set repo_id = repo_id | default("NeuML/t5-small-txtsql") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('translate English to SQL: Show me sports stories since yesterday with team equal Red Sox') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=512)
output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
