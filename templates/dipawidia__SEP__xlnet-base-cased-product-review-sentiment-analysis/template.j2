{% set repo_id = repo_id | default("dipawidia/xlnet-base-cased-product-review-sentiment-analysis") %}
{% set task = task | default("text-classification") %}
{% set model = model | default(repo_id) %}
{% set device = device | default("cuda:0") %}
{% set input_prompt = input_prompt | default("I recently bought these headphones, and the sound is amazing.") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
