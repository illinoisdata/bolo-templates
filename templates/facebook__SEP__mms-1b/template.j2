{% set repo_id = repo_id | default("facebook/mms-1b") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set target_sr = target_sr | default(16000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_sr = {{ target_sr }}

import os
import torch
import librosa
from transformers import Wav2Vec2FeatureExtractor, Wav2Vec2ForPreTraining
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(os.path.dirname(preprocessor_path))
model = Wav2Vec2ForPreTraining.from_pretrained(os.path.dirname(weights_path), config=config_path)
model.to(device)
model.eval()

if audio_path.startswith(("http://", "https://")):
    waveform, sr = librosa.load(audio_path, sr=target_sr)
else:
    waveform, sr = librosa.load(audio_path, sr=target_sr)

inputs = feature_extractor(waveform, sampling_rate=sr, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {"loss": outputs.loss, "projected_states": outputs.projected_states, "codevector_perplexity": outputs.codevector_perplexity}
