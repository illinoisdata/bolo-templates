repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
from io import BytesIO

import numpy as np
import requests
import soundfile as sf
import torch
import torchaudio.functional as F
from transformers import AutoFeatureExtractor, AutoModelForPreTraining

feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

def _load_audio(path: str):
    if path.startswith("http://") or path.startswith("https://"):
        response = requests.get(path)
        response.raise_for_status()
        data, sampling_rate = sf.read(BytesIO(response.content))
    else:
        data, sampling_rate = sf.read(path)
    if data.ndim > 1:
        data = data.mean(axis=1)
    return data, sampling_rate

audio_data, sampling_rate = _load_audio(audio_path)
if sampling_rate != feature_extractor.sampling_rate:
    audio_tensor = torch.tensor(audio_data, dtype=torch.float32)
    audio_data = F.resample(audio_tensor, orig_freq=sampling_rate, new_freq=feature_extractor.sampling_rate).numpy()
    sampling_rate = feature_extractor.sampling_rate

inputs = feature_extractor(
    audio_data,
    sampling_rate=sampling_rate,
    return_tensors="pt",
    padding=True,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

processed_outputs = {}
for key, value in outputs.__dict__.items():
    if isinstance(value, torch.Tensor):
        processed_outputs[key] = value.detach().cpu().numpy()
    else:
        processed_outputs[key] = value
RESULT = {"model_outputs": processed_outputs}
