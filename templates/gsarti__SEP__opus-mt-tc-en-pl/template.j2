{% set repo_id = "gsarti/opus-mt-tc-en-pl" %}
{% set device = "cuda:0" %}
{% set input_text = "Translate this sentence from English to Polish." %}
{% set num_beams = 6 %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/gsarti__SEP__opus-mt-tc-en-pl" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer([input_text], return_tensors="pt", padding=True, truncation=True, max_length=max_length)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_output = translations[0] if translations else ""

RESULT = {"translation": translation_output}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    output_path = Path(output_dir) / "translation.txt"
    output_path.write_text(RESULT["translation"], encoding="utf-8")