{% set repo_id = repo_id | default("bionlp/bluebert_pubmed_uncased_L-12_H-768_A-12") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Aspirin reduces inflammation in rheumatoid arthritis.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import BertTokenizer, BertForMaskedLM, BertConfig
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

config = BertConfig.from_json_file(config_path)
tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=True)
model = BertForMaskedLM(config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
mask_token_id = tokenizer.mask_token_id
if mask_token_id is not None and (inputs["input_ids"] == mask_token_id).any():
    mask_index = (inputs["input_ids"] == mask_token_id).nonzero(as_tuple=False)[0, 1]
    topk = torch.topk(logits[0, mask_index], k=5)
    output_value = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
else:
    output_value = logits[0, 0, :5].detach().cpu().tolist()

RESULT = {"output": output_value}
