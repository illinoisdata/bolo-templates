{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-no-de") %}
{% set device = device | default("cuda:0") %}
{% set src_texts = src_texts | default(["Dette er en test."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_texts = {{ src_texts }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input texts
inputs = tokenizer(src_texts, return_tensors="pt", padding=True).to(device)

# Run inference
generated_ids = model.generate(**inputs)

# Post-process outputs
translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

# Build result dict
RESULT = {"translations": translations}
