{% set repo_id = repo_id | default("malper/unikud") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("שלום עולם") %}
{% set max_length = max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}

import numpy as np
import torch
from pathlib import Path
from transformers import AutoModel, AutoTokenizer

device_obj = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device_obj)
model.eval()

encoded_input = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_input = {key: tensor.to(device_obj) for key, tensor in encoded_input.items()}
with torch.inference_mode():
    outputs = model(**encoded_input)

last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
RESULT = {"last_hidden_state": last_hidden_state}
