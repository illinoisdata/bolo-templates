{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-base-en-sh") %}
{% set input_text = input_text | default([">>hrv<< You're about to make a very serious mistake.", ">>bos_Latn<< I have a busy day ahead."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text }}

import os

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
input_ids = encoded_inputs["input_ids"].to(device)
attention_mask = encoded_inputs["attention_mask"].to(device)

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
