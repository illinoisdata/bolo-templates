{% set audio = audio | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}
{% set repo_id = repo_id | default("onnx-community/whisper-base_timestamped") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio = "{{ audio }}"
language = "{{ language }}"
task = "{{ task }}"

import numpy as np
import soundfile as sf
import torch
from huggingface_hub import hf_hub_download
from transformers import WhisperProcessor, WhisperForConditionalGeneration

_ = hf_hub_download(repo_id=repo_id, filename="onnx/encoder_model.onnx")
processor = WhisperProcessor.from_pretrained(repo_id)
model = WhisperForConditionalGeneration.from_pretrained("openai/whisper-base")

if isinstance(audio, str) and audio.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    audio_bytes = requests.get(audio, timeout=30).content
    waveform, sampling_rate = sf.read(BytesIO(audio_bytes))
else:
    waveform, sampling_rate = sf.read(audio)

if waveform.ndim > 1:
    waveform = np.mean(waveform, axis=1)

if sampling_rate != 16000:
    import librosa
    waveform = librosa.resample(waveform.astype(np.float32), orig_sr=sampling_rate, target_sr=16000)
    sampling_rate = 16000

inputs = processor(waveform, sampling_rate=sampling_rate, return_tensors="pt")
forced_decoder_ids = processor.get_decoder_prompt_ids(language=language, task=task)
with torch.no_grad():
    generated_ids = model.generate(inputs.input_features, forced_decoder_ids=forced_decoder_ids, max_new_tokens=64)

output_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"text": output_text}
