{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-vi-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Chào bạn, bạn khỏe không?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

device = torch.device(device)

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input text
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
generated_ids = model.generate(**inputs)

# Post-process output
decoded = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

# Build RESULT dict
RESULT = {"translation": decoded}
