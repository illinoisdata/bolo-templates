{% set repo_id = repo_id | default("Benjamin-png/swahili-mms-tts-finetuned") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Habari, karibu kwenye mfumo wetu wa kusikiliza kwa Kiswahili.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import json
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, VitsModel

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
preprocessor_config_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

model_dir = os.path.dirname(model_file)

# Load tokenizer/model from downloaded local files
# AutoTokenizer can use the downloaded tokenizer artifacts via the local directory.
tokenizer = AutoTokenizer.from_pretrained(model_dir, local_files_only=True)
model = VitsModel.from_pretrained(model_dir, local_files_only=True).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs).waveform

output_audio = waveform.squeeze().detach().cpu().numpy()
sampling_rate = int(model.config.sampling_rate)

RESULT = {"audio": output_audio, "sampling_rate": sampling_rate, "text": text}
