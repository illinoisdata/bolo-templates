{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("circulus/kobart-copywrite-v1") %}
{% set text = text | default("이 제품의 장점을 광고 문구로 작성하세요.") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(4) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences
)

# Post-process & build RESULT dict
generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
