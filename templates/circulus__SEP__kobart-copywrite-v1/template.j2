{% set text = "이 제품의 장점을 광고 문구로 작성하세요." %}
{% set max_length = 50 %}
{% set num_beams = 4 %}
{% set num_return_sequences = 1 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/circulus__SEP__kobart-copywrite-v1" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences
)

# Post-process & build RESULT dict
generated_texts = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "generated_texts.txt"), "w", encoding="utf-8") as f:
        for seq in RESULT["generated_texts"]:
            f.write(seq + "\n")