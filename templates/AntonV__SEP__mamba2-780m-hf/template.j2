{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("AntonV/mamba2-780m-hf") %}
{% set input_text = input_text | default("Hey how are you doing?") %}
{% set max_new_tokens = max_new_tokens | default(10) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}

from transformers import AutoTokenizer, AutoModelForCausalLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)

output_ids = model.generate(input_ids, max_new_tokens=max_new_tokens)

generated_texts = tokenizer.batch_decode(output_ids, skip_special_tokens=True)

RESULT = {"generated_texts": generated_texts}
