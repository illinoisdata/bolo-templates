{% set repo_id = repo_id | default("AntonV/mamba2-780m-hf") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hey how are you doing?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Load tokenizer and model directly from the downloaded local files.
tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_path.rsplit('/', 1)[0],
    local_files_only=True,
)
model = AutoModelForCausalLM.from_pretrained(
    tokenizer_path.rsplit('/', 1)[0],
    local_files_only=True,
    torch_dtype=torch.float16 if "cuda" in device else torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=10, do_sample=False)

decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)

RESULT = {"generated_text": decoded}
