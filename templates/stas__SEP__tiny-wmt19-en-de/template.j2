{% set repo_id = repo_id | default("stas/tiny-wmt19-en-de") %}
{% set device = device | default("cuda:0") %}
{% set translation_source = translation_source | default("Hello, how are you?") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
translation_source = "{{ translation_source }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(translation_source, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"translation": translation[0]}
