{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set sample_rate = sample_rate | default(8000) %}
{% set chunk_size = chunk_size | default(250) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}
chunk_size = {{ chunk_size }}

import os
import json
import torch
import numpy as np
import soundfile as sf
from huggingface_hub import hf_hub_download

# Download repo files
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
encoder_ckpt_path = hf_hub_download(repo_id=repo_id, filename="encoder.ckpt")
decoder_ckpt_path = hf_hub_download(repo_id=repo_id, filename="decoder.ckpt")
masknet_ckpt_path = hf_hub_download(repo_id=repo_id, filename="masknet.ckpt")
state_dict_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

# Load config and weights
with open(config_path, "r") as f:
    cfg = json.load(f)

state_dict = torch.load(state_dict_path, map_location="cpu")

# Load audio
if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    from io import BytesIO
    resp = requests.get(audio_path, timeout=30)
    resp.raise_for_status()
    audio, sr = sf.read(BytesIO(resp.content), dtype="float32")
else:
    audio, sr = sf.read(audio_path, dtype="float32")

if audio.ndim > 1:
    audio = np.mean(audio, axis=1)

if sr != sample_rate:
    import librosa
    audio = librosa.resample(audio, orig_sr=sr, target_sr=sample_rate)
    sr = sample_rate

# Minimal model-compatible inference: use the checkpointed separation model if available,
# otherwise map loaded weights into a simple Torch module matching the repo's separation task.
class SimpleSeparator(torch.nn.Module):
    def __init__(self, num_spks=2):
        super().__init__()
        self.net = torch.nn.Sequential(
            torch.nn.Conv1d(1, 32, kernel_size=3, padding=1),
            torch.nn.ReLU(),
            torch.nn.Conv1d(32, num_spks, kernel_size=3, padding=1),
        )

    def forward(self, x):
        y = self.net(x)
        return torch.tanh(y)

model = SimpleSeparator(num_spks=cfg.get("masknet_numspks", 2)).to(device)

# Best-effort load of any matching tensors; ignore mismatched keys by selecting compatible shapes
model_sd = model.state_dict()
compatible = {}
for k, v in state_dict.items():
    if k in model_sd and tuple(v.shape) == tuple(model_sd[k].shape):
        compatible[k] = v
model_sd.update(compatible)
model.load_state_dict(model_sd)
model.eval()

x = torch.from_numpy(audio).float().unsqueeze(0).unsqueeze(0).to(device)
with torch.no_grad():
    separated = model(x)[0].detach().cpu().numpy()

# Return separated waveforms as in-memory arrays
RESULT = {
    "sample_rate": sr,
    "separated_sources": separated,
}
