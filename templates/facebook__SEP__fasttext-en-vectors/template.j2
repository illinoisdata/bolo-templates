{% set repo_id = repo_id | default("facebook/fasttext-en-vectors") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('apple') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import numpy as np
from huggingface_hub import hf_hub_download
import gensim
from gensim.models.fasttext import load_facebook_model

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
model = load_facebook_model(model_path)

word_vector = model.wv.get_vector(text)
nearest_neighbors = model.wv.most_similar(text, topn=5)

RESULT = {
    "word_vector": word_vector,
    "nearest_neighbors": nearest_neighbors,
}
