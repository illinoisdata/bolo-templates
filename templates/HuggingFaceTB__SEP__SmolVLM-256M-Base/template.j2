{% set repo_id = repo_id | default("HuggingFaceTB/SmolVLM-256M-Base") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-text-to-text") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set input_prompt = input_prompt | default("Describe this image") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}
input_prompt = {{ input_prompt | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

image = Image.open(input_image).convert("RGB")

inference_output = pipe(image=image, text=input_prompt)

RESULT = {"output": inference_output}
