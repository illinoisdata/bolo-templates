{% set repo_id = repo_id | default("usyd-community/vitpose-plus-small") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoProcessor, VitPoseForPoseEstimation
from scipy.ndimage import affine_transform

if image.startswith('http://') or image.startswith('https://'):
    import requests
    image = Image.open(requests.get(image, stream=True).raw).convert('RGB')
else:
    image = Image.open(image).convert('RGB')

weights_path = hf_hub_download(repo_id=repo_id, filename='model.safetensors')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
processor_dir = hf_hub_download(repo_id=repo_id, filename='preprocessor_config.json').rsplit('/', 1)[0]

image_processor = AutoProcessor.from_pretrained(processor_dir)
model = VitPoseForPoseEstimation.from_pretrained(
    weights_path,
    config=config_path,
    local_files_only=True,
)
model.to(device)
model.eval()

boxes = [[[0.0, 0.0, float(image.width), float(image.height)]]]
inputs = image_processor(image, boxes=boxes, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}
inputs['dataset_index'] = torch.tensor(0, device=device)

with torch.no_grad():
    outputs = model(**inputs)

pose_results = image_processor.post_process_pose_estimation(outputs, boxes=boxes, threshold=0.3)
image_pose_result = pose_results[0]
if len(image_pose_result) > 0:
    first_person = image_pose_result[0]
    keypoints = first_person['keypoints'].detach().cpu().numpy().tolist()
    scores = first_person['scores'].detach().cpu().numpy().tolist()
    labels = first_person['labels'].detach().cpu().numpy().tolist()
else:
    keypoints = []
    scores = []
    labels = []

RESULT = {
    'keypoints': keypoints,
    'scores': scores,
    'labels': labels,
}
