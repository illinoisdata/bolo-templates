{% set repo_id = repo_id | default("AutonLab/MOMENT-1-base") %}
{% set device = device | default("cuda:0") %}
{% set task_name = task_name | default('reconstruction') %}
{% set input_path = input_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set seq_len = seq_len | default(512) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task_name = "{{ task_name }}"
input_path = "{{ input_path }}"
seq_len = {{ seq_len }}

import torch
import soundfile as sf
from momentfm import MOMENTPipeline

if isinstance(input_path, str) and input_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    resp = requests.get(input_path, timeout=30)
    resp.raise_for_status()
    audio, sr = sf.read(BytesIO(resp.content), dtype='float32')
else:
    audio, sr = sf.read(input_path, dtype='float32')

if audio.ndim > 1:
    audio = audio.mean(axis=1)
audio = torch.tensor(audio, dtype=torch.float32)
if audio.numel() < seq_len:
    audio = torch.nn.functional.pad(audio, (0, seq_len - audio.numel()))
else:
    audio = audio[:seq_len]

x = audio.unsqueeze(0).unsqueeze(0).to(device)
mask = torch.ones((x.shape[0], x.shape[-1]), dtype=torch.bool, device=x.device)

model = MOMENTPipeline.from_pretrained(repo_id, model_kwargs={"task_name": task_name})
model.init()
model = model.to(device)
model.eval()

with torch.no_grad():
    out = model.reconstruction(x_enc=x, input_mask=mask)

output_value = {}
for k in ["reconstruction", "forecast", "embedding", "logits", "scores"]:
    if hasattr(out, k):
        v = getattr(out, k)
        output_value[k] = v.detach().cpu().numpy() if torch.is_tensor(v) else v
for k, v in out.__dict__.items():
    if k.startswith("_"):
        continue
    if k not in output_value:
        output_value[k] = v.detach().cpu().numpy() if torch.is_tensor(v) else v

RESULT = {"output": output_value}
