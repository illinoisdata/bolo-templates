{% set repo_id = repo_id | default("facebook/mms-300m") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set target_sampling_rate = target_sampling_rate | default(16000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_sampling_rate = {{ target_sampling_rate }}

import os
import torch
import numpy as np
from scipy.io import wavfile
from transformers import Wav2Vec2FeatureExtractor, Wav2Vec2ForPreTraining
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
processor_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(os.path.dirname(processor_file))
model = Wav2Vec2ForPreTraining.from_pretrained(os.path.dirname(model_file), config=os.path.dirname(config_file), torch_dtype=torch.float32)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    audio_bytes = requests.get(audio_path).content
    tmp_audio_path = "/tmp/input_audio.wav"
    with open(tmp_audio_path, "wb") as f:
        f.write(audio_bytes)
    audio_load_path = tmp_audio_path
else:
    audio_load_path = audio_path

sampling_rate, speech = wavfile.read(audio_load_path)
if speech.dtype != np.float32:
    if np.issubdtype(speech.dtype, np.integer):
        max_val = np.iinfo(speech.dtype).max
        speech = speech.astype(np.float32) / max_val
    else:
        speech = speech.astype(np.float32)
if speech.ndim > 1:
    speech = speech.mean(axis=1)

if sampling_rate != target_sampling_rate:
    import librosa
    speech = librosa.resample(speech, orig_sr=sampling_rate, target_sr=target_sampling_rate)

inputs = feature_extractor(speech, sampling_rate=target_sampling_rate, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    "projected_quantized_states_shape": tuple(outputs.projected_quantized_states.shape) if outputs.projected_quantized_states is not None else None,
    "codevector_perplexity": float(outputs.codevector_perplexity) if outputs.codevector_perplexity is not None else None,
    "loss": float(outputs.loss) if outputs.loss is not None else None,
}
