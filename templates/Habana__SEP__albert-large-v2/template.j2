{% set repo_id = repo_id | default("Habana/albert-large-v2") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the capital of France?') %}
{% set context = context | default('Paris is the capital and most populous city of France.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import json
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
import torch

# Download config file from the repo (this repo contains no weights)
gaudi_config_path = hf_hub_download(repo_id=repo_id, filename="gaudi_config.json")
with open(gaudi_config_path, "r") as f:
    gaudi_config = json.load(f)

# Pre-process input & load model
model_id = "albert-large-v2"
tokenizer = AutoTokenizer.from_pretrained(model_id)
model = AutoModelForQuestionAnswering.from_pretrained(model_id)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    outputs = model(**inputs)
    start_logits = outputs.start_logits
    end_logits = outputs.end_logits
    start_idx = int(torch.argmax(start_logits, dim=-1).item())
    end_idx = int(torch.argmax(end_logits, dim=-1).item())
    if end_idx < start_idx:
        end_idx = start_idx

# Post-process & build RESULT dict
input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx : end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()

RESULT = {
    "answer": answer,
    "start_index": start_idx,
    "end_index": end_idx,
}
