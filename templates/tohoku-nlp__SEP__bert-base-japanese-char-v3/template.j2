{% set repo_id = repo_id | default("tohoku-nlp/bert-base-japanese-char-v3") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('東北大学で[MASK]の研究をしています。') %}
{% set top_k = top_k | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
top_k = {{ top_k }}

import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = "/".join(weights_path.split("/")[:-1])

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False)
model = AutoModelForMaskedLM.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
mask_token_id = tokenizer.mask_token_id
mask_positions = (inputs["input_ids"][0] == mask_token_id).nonzero(as_tuple=False).flatten()
with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits

predictions = []
for pos in mask_positions.tolist():
    probs = torch.softmax(logits[0, pos], dim=-1)
    values, indices = torch.topk(probs, k=top_k)
    tokens = tokenizer.convert_ids_to_tokens(indices.tolist())
    predictions.append(
        [
            {"token": tok, "score": float(score), "id": int(idx)}
            for tok, score, idx in zip(tokens, values.tolist(), indices.tolist())
        ]
    )

RESULT = {"predictions": predictions, "text": text}
