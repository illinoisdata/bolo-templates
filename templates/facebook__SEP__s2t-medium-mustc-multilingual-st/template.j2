{% set repo_id = repo_id | default("facebook/s2t-medium-mustc-multilingual-st") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("automatic-speech-recognition") %}
{% set input_audio = input_audio | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_audio = {{ input_audio | tojson }}

from transformers import Speech2TextProcessor, pipeline

processor = Speech2TextProcessor.from_pretrained(model)
pipe = pipeline(task=task, model=model, processor=processor, device=device)
RESULT = pipe(input_audio)
