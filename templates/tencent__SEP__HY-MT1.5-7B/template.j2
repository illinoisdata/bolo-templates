{% set device = "cuda:0" %}
{% set repo_id = "tencent/HY-MT1.5-7B" %}
{% set translation_input = "It's on the house." %}
{% set target_language = "Chinese" %}
{% set max_new_tokens = 256 %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
translation_input = {{ translation_input | tojson }}
target_language = {{ target_language | tojson }}
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
import torch

from transformers import AutoModelForCausalLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForCausalLM.from_pretrained(repo_id, torch_dtype=torch.bfloat16)
model = model.to(device)
model.eval()

prompt = (
    f"Translate the following segment into {target_language}, without additional explanation.\n\n"
    f"{translation_input}"
)

encoded_inputs = tokenizer(prompt, return_tensors="pt")
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.inference_mode():
    generated = model.generate(
        **encoded_inputs,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        pad_token_id=tokenizer.pad_token_id,
    )

generated_text = tokenizer.decode(
    generated[0][encoded_inputs["input_ids"].shape[-1]:],
    skip_special_tokens=True,
)
translation = generated_text.strip()

RESULT = {"translation": translation}
