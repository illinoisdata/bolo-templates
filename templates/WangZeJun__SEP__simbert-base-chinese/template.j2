{% set text_a = text_a | default('今天天气很好') %}
{% set text_b = text_b | default('今天阳光明媚') %}
{% set max_length = max_length | default(64) %}
{% set repo_id = repo_id | default("WangZeJun/simbert-base-chinese") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_a = "{{ text_a }}"
text_b = "{{ text_b }}"
max_length = {{ max_length }}

import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertModel

weights_path = hf_hub_download(repo_id=repo_id, filename='model.safetensors')
config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
vocab_path = hf_hub_download(repo_id=repo_id, filename='vocab.txt')

tokenizer = BertTokenizer(vocab_file=vocab_path)
model = BertModel.from_pretrained(
    repo_id,
    config=config_path,
    state_dict=None,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(
    text_a,
    text_b,
    return_tensors='pt',
    truncation=True,
    max_length=max_length,
    padding=False,
)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

cls_embedding = outputs.last_hidden_state[:, 0, :].squeeze(0).detach().cpu().numpy()
pooled_output = outputs.pooler_output.squeeze(0).detach().cpu().numpy() if outputs.pooler_output is not None else None
similarity = torch.nn.functional.cosine_similarity(
    outputs.last_hidden_state[:, 0, :],
    outputs.pooler_output,
    dim=-1,
).item() if outputs.pooler_output is not None else None

RESULT = {
    'cls_embedding': cls_embedding,
    'pooled_output': pooled_output,
    'similarity': similarity,
}
