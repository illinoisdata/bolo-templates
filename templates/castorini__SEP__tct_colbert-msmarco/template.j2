{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("castorini/tct_colbert-msmarco") %}
{% set input_text = input_text | default("What is dense retrieval?") %}
{% set max_length = max_length | default(128) %}
{% set tokenizer_repo = tokenizer_repo | default("bert-base-uncased") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
tokenizer_repo = "{{ tokenizer_repo }}"

import numpy as np
import torch
from pathlib import Path
from transformers import AutoTokenizer, BertModel

tokenizer = AutoTokenizer.from_pretrained(tokenizer_repo)
model = BertModel.from_pretrained(repo_id).to(torch.device(device))
model.eval()

tokenized_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding="max_length",
    max_length=max_length,
)
tokenized_inputs = {key: value.to(torch.device(device)) for key, value in tokenized_inputs.items()}

with torch.inference_mode():
    outputs = model(**tokenized_inputs)

embedding = outputs.last_hidden_state.mean(dim=1)
embedding = embedding.cpu().numpy()
RESULT = {"embedding": embedding}
