{% set repo_id = repo_id | default("castorini/tct_colbert-msmarco") %}
{% set device = device | default("cuda:0") %}
{% set text_a = text_a | default('what is the capital of france?') %}
{% set text_b = text_b | default('paris is the capital city of france.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_a = "{{ text_a }}"
text_b = "{{ text_b }}"

import torch
from collections import OrderedDict
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BertConfig, BertModel

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=True)
config = BertConfig.from_json_file(config_path)
model = BertModel(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict = OrderedDict((k[len("bert."):] if k.startswith("bert.") else k, v) for k, v in state_dict.items() if not k.startswith("cls."))
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text_a, text_b, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

cls_embedding = outputs.last_hidden_state[:, 0, :].detach().cpu()
pooled_embedding = outputs.pooler_output.detach().cpu() if outputs.pooler_output is not None else cls_embedding
similarity = torch.nn.functional.cosine_similarity(cls_embedding, pooled_embedding).item()

RESULT = {"cls_embedding": cls_embedding, "pooled_embedding": pooled_embedding, "similarity": similarity}
