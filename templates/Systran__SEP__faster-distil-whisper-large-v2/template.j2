{% set repo_id = repo_id | default("Systran/faster-distil-whisper-large-v2") %}
{% set device = device | default("cuda:0") %}
{% set audio = audio | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio = "{{ audio }}"

from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_dir = hf_hub_download(repo_id=repo_id, filename="model.bin").rsplit("/", 1)[0]
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.json")

if audio.startswith("http://") or audio.startswith("https://"):
    audio_input = audio
else:
    audio_input = audio

whisper_device = "cpu"
compute_type = "int8"
model = WhisperModel(model_dir, device=whisper_device, compute_type=compute_type, local_files_only=True)
segments, info = model.transcribe(audio_input, language="en", task="transcribe", beam_size=1)
output_text = "".join(segment.text for segment in segments)

RESULT = {"text": output_text, "language": info.language, "duration": info.duration}
