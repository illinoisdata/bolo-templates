{% set input_text = "The quick brown [MASK] jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/lysandre__SEP__tiny-bert-random" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import os
import numpy as np
import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

mlm_logits = outputs.prediction_logits.detach().cpu().numpy()
next_sentence_logits = outputs.seq_relationship_logits.detach().cpu().numpy()

RESULT = {
    "mlm_logits": mlm_logits,
    "next_sentence_logits": next_sentence_logits,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, "mlm_logits.npy"), RESULT["mlm_logits"])
    np.save(os.path.join(output_dir, "next_sentence_logits.npy"), RESULT["next_sentence_logits"])