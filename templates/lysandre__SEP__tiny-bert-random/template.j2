{% set repo_id = repo_id | default("lysandre/tiny-bert-random") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizerFast, BertForPreTraining, BertConfig

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Pre-process input & load model

tokenizer = BertTokenizerFast(vocab_file=vocab_path)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

config = BertConfig.from_json_file(config_path)
model = BertForPreTraining(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("bert.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

# Run inference
with torch.no_grad():
    outputs = model(**inputs)

# Post-process & build RESULT dict
RESULT = {
    "prediction_logits": outputs.prediction_logits.detach().cpu(),
    "seq_relationship_logits": outputs.seq_relationship_logits.detach().cpu(),
}
