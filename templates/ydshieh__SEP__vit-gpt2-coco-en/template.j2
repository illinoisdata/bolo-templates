{% set max_length = max_length | default(16) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, VisionEncoderDecoderModel, ViTImageProcessor

preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
image_processor = ViTImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
tokenizer = AutoTokenizer.from_pretrained(os.path.dirname(tokenizer_path))
_ = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
model = VisionEncoderDecoderModel.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pixel_values = image_processor(images=image, return_tensors="pt").pixel_values.to(device)
with torch.no_grad():
    output_ids = model.generate(pixel_values, max_length=max_length, num_beams=num_beams)
preds = tokenizer.batch_decode(output_ids, skip_special_tokens=True)
preds = [pred.strip() for pred in preds]

RESULT = {"predictions": preds}
