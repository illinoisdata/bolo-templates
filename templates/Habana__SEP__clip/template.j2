{% set repo_id = repo_id | default("Habana/clip") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text = text | default('a photo of a cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text = "{{ text }}"

import json
import torch
from PIL import Image
import requests
from huggingface_hub import hf_hub_download
from transformers import AutoModel, AutoProcessor

config_path = hf_hub_download(repo_id=repo_id, filename="gaudi_config.json")
with open(config_path, "r") as f:
    gaudi_config = json.load(f)

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = AutoProcessor.from_pretrained("openai/clip-vit-large-patch14")
model = AutoModel.from_pretrained("openai/clip-vit-large-patch14")
model.to(device)
model.eval()

inputs = processor(text=[text], images=image, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    image_embeds = outputs.image_embeds
    text_embeds = outputs.text_embeds
    logit_scale = model.logit_scale.exp()
    logits_per_image = logit_scale * image_embeds @ text_embeds.t()
    probs = logits_per_image.softmax(dim=-1)

RESULT = {
    "logits_per_image": logits_per_image.detach().cpu().tolist(),
    "probabilities": probs.detach().cpu().tolist(),
    "gaudi_config": gaudi_config,
}
