{% set repo_id = repo_id | default("lmstudio-community/EXAONE-3.5-2.4B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('EXAONE-3.5-2.4B-Instruct-Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short, helpful response to: Explain what a large language model is.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=4096,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=-1 if str(device).startswith('cuda') else 0,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=128,
    temperature=0.2,
    top_p=0.95,
    stop=["</s>"],
)

text = output["choices"][0]["text"]

RESULT = {"text": text}
