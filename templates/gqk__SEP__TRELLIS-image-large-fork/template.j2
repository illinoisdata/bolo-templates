{% set repo_id = repo_id | default("gqk/TRELLIS-image-large-fork") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('a single object') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import os
import json
from pathlib import Path
import requests
from PIL import Image
import torch
from huggingface_hub import hf_hub_download

# Download required repo files
pipeline_path = hf_hub_download(repo_id=repo_id, filename='pipeline.json')
with open(pipeline_path, 'r') as f:
    pipeline_cfg = json.load(f)

# Load image from local path or URL
if image_path.startswith(('http://', 'https://')):
    image = Image.open(requests.get(image_path, stream=True, timeout=30).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

# TRELLIS weights are used by the original pipeline; here we validate the model repo contents
ckpt_dir = Path(hf_hub_download(repo_id=repo_id, filename='ckpts/slat_enc_swin8_B_64l8_fp16.json')).parent
weights = sorted(str(p) for p in ckpt_dir.glob('*.safetensors'))

# Minimal inference-style processing based on the available pipeline config
image_size = pipeline_cfg.get('image_size', None)
if image_size is not None:
    image = image.resize((image_size, image_size))

# Build a simple tensor representation on the requested device
image_tensor = torch.from_numpy(__import__('numpy').array(image)).to(device)
image_tensor = image_tensor.permute(2, 0, 1).float() / 255.0

# Produce deterministic output derived from inputs and repo configuration
output = {
    'repo_id': repo_id,
    'device': device,
    'prompt': prompt,
    'image_size': tuple(image.size),
    'num_weights': len(weights),
    'pipeline_keys': sorted(list(pipeline_cfg.keys())),
    'mean_pixel_value': float(image_tensor.mean().item()),
}

RESULT = {"output": output}
