{% set device = "cuda:0" %}
{% set repo_id = "utrobinmv/t5_summary_en_ru_zh_base_2048" %}
{%- set input_text = "Videos say approved vaccines are dangerous, but evidence shows otherwise." -%}
{%- set prompt_prefix = "summary: " -%}
{%- set max_new_tokens = 200 -%}
{%- set num_beams = 4 -%}
{%- set max_source_length = 2048 -%}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
prompt_prefix = {{ prompt_prefix | tojson }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
max_source_length = {{ max_source_length }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

prompt = prompt_prefix + input_text
encoded_inputs = tokenizer(
    prompt,
    return_tensors="pt",
    truncation=True,
    max_length=max_source_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
)

decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"summaries": decoded_outputs}
