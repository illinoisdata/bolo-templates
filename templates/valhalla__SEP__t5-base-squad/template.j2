{% set repo_id = repo_id | default("valhalla/t5-base-squad") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is Valhalla ?') %}
{% set context = context | default('In Norse mythology, Valhalla is a majestic, enormous hall located in Asgard, ruled over by the god Odin.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model.to(device)
model.eval()

input_text = f"question: {question} context: {context} </s>"
features = tokenizer([input_text], return_tensors="pt")
features = {k: v.to(device) for k, v in features.items()}

with torch.no_grad():
    out = model.generate(
        input_ids=features["input_ids"],
        attention_mask=features["attention_mask"],
        max_new_tokens=32,
    )

output_text = tokenizer.decode(out[0], skip_special_tokens=True)

RESULT = {"output": output_text}
