{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("valhalla/t5-base-squad") %}
{% set question = question | default("What is Valhalla ?") %}
{% set context = context | default("In Norse mythology, Valhalla is a majestic, enormous hall located in Asgard, ruled over by the god Odin.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

input_text = f"question: {question} context: {context} </s>"
inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=512)
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    num_beams=num_beams,
)

generated_tokens = generated_tokens[0].cpu()
answer = tokenizer.decode(generated_tokens, skip_special_tokens=True)

RESULT = {"answer": answer}
