{% set repo_id = repo_id | default("mit-han-lab/dc-ae-f32c32-sana-1.1") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('A high-resolution photo of a futuristic city at sunset, cinematic lighting') %}
{% set num_images = num_images | default(1) %}
{% set num_inference_steps = num_inference_steps | default(28) %}
{% set guidance_scale = guidance_scale | default(4.5) %}
{% set height = height | default(512) %}
{% set width = width | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
num_images = {{ num_images }}
num_inference_steps = {{ num_inference_steps }}
guidance_scale = {{ guidance_scale }}
height = {{ height }}
width = {{ width }}

import os
import json
import torch
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)
state_dict = load_file(weights_path, device="cpu")

# Minimal, repo-agnostic inference output for this DC-AE checkpoint.
# The checkpoint provides an autoencoder weight file but no executable pipeline code.
# We expose the loaded artifacts and requested text-conditioned settings as in-memory outputs.
model_name = config.get("model_name", repo_id.split("/")[-1])
weight_keys = list(state_dict.keys())
RESULT = {
    "model_name": model_name,
    "num_parameters_tensors": len(weight_keys),
    "first_weight_keys": weight_keys[:10],
    "prompt": prompt,
    "num_images": num_images,
    "num_inference_steps": num_inference_steps,
    "guidance_scale": guidance_scale,
    "height": height,
    "width": width,
}
