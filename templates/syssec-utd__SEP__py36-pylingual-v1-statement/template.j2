{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("syssec-utd/py36-pylingual-v1-statement") %}
{% set input_text = input_text | default("Write a Python function to compute the factorial of a number.") %}
{% set max_new_tokens = max_new_tokens | default(128) %}
{% set num_beams = num_beams | default(4) %}
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens, num_beams=num_beams)
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
