{% set input_text = "Write a Python function to compute the factorial of a number." %}
{% set max_new_tokens = 128 %}
{% set num_beams = 4 %}

input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens, num_beams=num_beams)
generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    os.makedirs("outputs", exist_ok=True)
    with open(os.path.join("outputs", "generated_text.txt"), "w") as f:
        for line in generated_text:
            f.write(line + "\n")