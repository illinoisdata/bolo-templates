{% set repo_id = repo_id %}
{% set device = device %}
{% set input_prompt = "Is this review positive or negative? Review: this is the best cast iron skillet you will ever buy" %}
{% set max_length = 128 %}
{% set num_return_sequences = 1 %}
{% set temperature = 1.0 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/bigscience__SEP__T0_3B" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_prompt = "{{ input_prompt }}"
max_length = {{ max_length }}
num_return_sequences = {{ num_return_sequences }}
temperature = {{ temperature }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

execution_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(execution_device)
model.eval()

inputs = tokenizer(input_prompt, return_tensors="pt").to(execution_device)
with torch.inference_mode():
    generated_ids = model.generate(
        **inputs,
        max_length=max_length,
        num_return_sequences=num_return_sequences,
        temperature=temperature,
    )

decoded_outputs = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"generated_text": decoded_outputs}

if __name__ == "__main__":
    out_path = Path(output_dir)
    out_path.mkdir(parents=True, exist_ok=True)
    text_output = out_path / "generated_text.txt"
    with text_output.open("w", encoding="utf-8") as handle:
        for sequence in RESULT["generated_text"]:
            handle.write(sequence)
            handle.write("\n")