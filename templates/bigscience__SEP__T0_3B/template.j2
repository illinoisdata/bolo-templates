{% set repo_id = repo_id | default("bigscience/T0_3B") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Is this review positive or negative? Review: Best cast iron skillet you will every buy.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

from huggingface_hub import hf_hub_download
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Use explicit T5 classes for this checkpoint.
tokenizer = T5Tokenizer(vocab_file=spiece_path)
model = T5ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=16,
        do_sample=False,
        num_beams=1,
    )
output_text = tokenizer.decode(generated[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
