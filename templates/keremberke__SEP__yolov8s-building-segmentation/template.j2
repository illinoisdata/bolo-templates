{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
{% set repo_id = repo_id | default("keremberke/yolov8s-building-segmentation") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True, timeout=30).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = YOLO(weights_path)
results = model.predict(
    source=image,
    device=device,
    conf=conf,
    iou=iou,
    agnostic_nms=agnostic_nms,
    max_det=max_det,
    verbose=False,
)
result = results[0]
boxes = result.boxes
masks = result.masks
render = result.plot()
RESULT = {"render": render, "boxes": boxes, "masks": masks}
