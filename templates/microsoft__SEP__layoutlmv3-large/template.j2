{% set text = text | default('What is the total amount?', true) %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg', true) %}
{% set repo_id = repo_id | default("microsoft/layoutlmv3-large") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
image_path = "{{ image_path }}"

import torch
from PIL import Image
import requests
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import LayoutLMv3Processor, LayoutLMv3ForSequenceClassification

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

if image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = LayoutLMv3Processor.from_pretrained(repo_id, apply_ocr=True)
model = LayoutLMv3ForSequenceClassification.from_pretrained(repo_id)
model.to(device)
model.eval()

encoding = processor(image, text=text, return_tensors="pt", truncation=True)
encoding = {k: v.to(device) if hasattr(v, 'to') else v for k, v in encoding.items()}

with torch.no_grad():
    outputs = model(**encoding)

logits = outputs.logits.detach().cpu()
probs = torch.softmax(logits, dim=-1)
pred_class = int(probs.argmax(dim=-1).item())
RESULT = {"logits": logits, "probabilities": probs, "predicted_class": pred_class}
