{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "The conference begins tomorrow in Warsaw." %}
{% set num_beams = 4 %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-uk" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

tokenized = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(torch_device) for key, value in tokenized.items()}
with torch.no_grad():
    generated = model.generate(
        **inputs,
        num_beams=num_beams,
        max_length=max_length,
    )

decoded = tokenizer.batch_decode(generated, skip_special_tokens=True)
translation = decoded[0] if len(decoded) == 1 else decoded

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translation_output = RESULT["translation"]
    if isinstance(translation_output, list):
        translation_text = "\n".join(translation_output)
    else:
        translation_text = translation_output
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as output_file:
        output_file.write(translation_text)