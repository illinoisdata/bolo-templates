{% set text_prompt = "Hello, this is a SeamlessM4T text-to-speech demo." %}
{% set src_lang = "eng" %}
{% set tgt_lang = "fra" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__hf-seamless-m4t-medium" %}
{% set output_audio_filename = "text_to_speech.wav" %}
{% set sampling_rate = 16000 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_prompt = "{{ text_prompt }}"
src_lang = "{{ src_lang }}"
tgt_lang = "{{ tgt_lang }}"
output_dir = "{{ output_dir }}"
output_audio_filename = "{{ output_audio_filename }}"
sampling_rate = {{ sampling_rate }}

from pathlib import Path
import wave

import numpy as np
from transformers import AutoProcessor, SeamlessM4TModel

processor = AutoProcessor.from_pretrained(repo_id)
model = SeamlessM4TModel.from_pretrained(repo_id).to(device)
model.eval()

text_inputs = processor(text=text_prompt, src_lang=src_lang, return_tensors="pt")
text_inputs = {key: value.to(device) for key, value in text_inputs.items()}

generated_audio = model.generate(**text_inputs, tgt_lang=tgt_lang, generate_speech=True)[0]
speech_waveform = generated_audio.cpu().numpy().squeeze()

RESULT = {"generated_speech_waveform": speech_waveform}

def _write_wave(path: Path, data: np.ndarray, sample_rate: int) -> None:
    clipped = np.clip(data, -1.0, 1.0)
    pcm_data = (clipped * 32767).astype(np.int16)
    with wave.open(str(path), "wb") as wave_file:
        wave_file.setnchannels(1)
        wave_file.setsampwidth(2)
        wave_file.setframerate(sample_rate)
        wave_file.writeframes(pcm_data.tobytes())

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    audio_path = output_path / output_audio_filename
    _write_wave(audio_path, RESULT["generated_speech_waveform"], sampling_rate)