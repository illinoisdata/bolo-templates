{% set repo_id = repo_id | default("facebook/hf-seamless-m4t-medium") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('Hello, my dog is cute') %}
{% set tgt_lang = tgt_lang | default('fra') %}
{% set generate_speech = generate_speech | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
tgt_lang = "{{ tgt_lang }}"
generate_speech = {{ generate_speech }}

import torch
from transformers import AutoProcessor, SeamlessM4TModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
processor = AutoProcessor.from_pretrained(repo_id)
model = SeamlessM4TModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = processor(text=src_text, src_lang="eng", return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_tokens = model.generate(**inputs, tgt_lang=tgt_lang, generate_speech=generate_speech)

if generate_speech:
    output_value = output_tokens[0].detach().cpu().numpy().squeeze()
else:
    output_value = processor.decode(output_tokens[0].tolist(), skip_special_tokens=True)

RESULT = {"output": output_value}
