{% set repo_id = repo_id | default("deepdml/faster-whisper-large-v3-turbo-ct2") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}
{% set beam_size = beam_size | default(5) %}
{% set compute_type = compute_type | default('int8') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"
beam_size = {{ beam_size }}
compute_type = "{{ compute_type }}"

import os
import io
import numpy as np
import soundfile as sf
import requests
from faster_whisper import WhisperModel
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocabulary.json")
model_dir = os.path.dirname(model_path)

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_bytes = requests.get(audio_path, timeout=30).content
    audio, sample_rate = sf.read(io.BytesIO(audio_bytes))
else:
    audio, sample_rate = sf.read(audio_path)

if audio.ndim > 1:
    audio = np.mean(audio, axis=1)

whisper_device = "cpu" if device.startswith("cuda") else device
model = WhisperModel(model_dir, device=whisper_device, compute_type=compute_type)
segments, info = model.transcribe(audio, language=language, task=task, beam_size=beam_size)
text = "".join(segment.text for segment in segments)

RESULT = {
    "text": text,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
