{% set repo_id = repo_id | default("Rostlab/ProstT5_fp16") %}
{% set device = device | default("cuda:0") %}
{% set input_sequence = input_sequence | default('MVLSPADKTNVKAAW') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set num_beams = num_beams | default(1) %}
{% set task_prefix = task_prefix | default('protein sequence:') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_sequence = "{{ input_sequence }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
task_prefix = "{{ task_prefix }}"

import os
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = T5Tokenizer.from_pretrained(os.path.dirname(tokenizer_file), use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(
    os.path.dirname(model_file),
    torch_dtype=torch.float16,
    low_cpu_mem_usage=True,
)
model = model.to(device)
model.eval()

sequence = input_sequence.replace(" ", "")
if not sequence.startswith(task_prefix):
    sequence = f"{task_prefix} {sequence}"
inputs = tokenizer(sequence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
    )
output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
