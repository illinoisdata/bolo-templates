{% set repo_id = repo_id | default("chathuranga-jayanath/codet5-small-v9") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("Generate a Python function that calculates the Fibonacci sequence.") %}
{% set max_length = max_length | default(256) %}
{% set num_beams = num_beams | default(5) %}
{% set output_filename = output_filename | default("generated.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_filename = "{{ output_filename }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
generated_text = decoded_outputs[0] if decoded_outputs else ""

RESULT = {"generated_text": generated_text}
