{% set repo_id = repo_id | default("davidrrobinson/BioLingual") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-audio-classification") %}
{% set audio = audio | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set candidate_labels = candidate_labels | default(["Sound of a sperm whale", "Sound of a sea lion"]) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
audio = {{ audio | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

RESULT = pipe(audio, candidate_labels=candidate_labels)
