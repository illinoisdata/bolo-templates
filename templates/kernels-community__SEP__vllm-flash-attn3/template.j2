{% set repo_id = repo_id | default("kernels-community/vllm-flash-attn3") %}
{% set device = device | default("cuda:0") %}
{% set batch_size = batch_size | default(2) %}
{% set seqlen_q = seqlen_q | default(128) %}
{% set seqlen_k = seqlen_k | default(256) %}
{% set nheads = nheads | default(8) %}
{% set head_dim = head_dim | default(64) %}
{% set causal = causal | default(true) %}
{% set kernel_version = kernel_version | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
batch_size = {{ batch_size }}
seqlen_q = {{ seqlen_q }}
seqlen_k = {{ seqlen_k }}
nheads = {{ nheads }}
head_dim = {{ head_dim }}
causal = {{ causal }}
kernel_version = {{ kernel_version }}

import torch
from kernels import get_kernel

vllm_flash_attn3 = get_kernel(repo_id, version=kernel_version)
flash_attn_func = vllm_flash_attn3.flash_attn_func

torch.manual_seed(42)
if device.startswith("cuda") and torch.cuda.is_available():
    torch.cuda.manual_seed_all(42)

q = torch.randn(batch_size, seqlen_q, nheads, head_dim, device=device, dtype=torch.bfloat16)
k = torch.randn(batch_size, seqlen_k, nheads, head_dim, device=device, dtype=torch.bfloat16)
v = torch.randn(batch_size, seqlen_k, nheads, head_dim, device=device, dtype=torch.bfloat16)
output, lse = flash_attn_func(q, k, v, causal=causal)
RESULT = {"output": output, "lse": lse}
