{% set repo_id = repo_id | default("kyutai/tts-0.75b-en-public") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hey there! How are you? I had the craziest day today.") %}
{% set voice = voice | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set temp = temp | default(0.6) %}
{% set cfg_coef = cfg_coef | default(3.0) %}
{% set padding_between = padding_between | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
voice = "{{ voice }}"
temp = {{ temp }}
cfg_coef = {{ cfg_coef }}
padding_between = {{ padding_between }}

import os
import torch
import soundfile as sf
from huggingface_hub import hf_hub_download
from moshi.models.loaders import CheckpointInfo
from moshi.models.tts import TTSModel

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
moshi_weights_path = hf_hub_download(repo_id=repo_id, filename="dsm_tts_d6ef30c7@1000.safetensors")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_spm_8k_en_fr_audio.model")
mimi_path = hf_hub_download(repo_id=repo_id, filename="tokenizer-e351c8d8-checkpoint125.safetensors")

if voice.startswith("http://") or voice.startswith("https://"):
    import tempfile, requests
    resp = requests.get(voice, timeout=30)
    resp.raise_for_status()
    fd, local_voice = tempfile.mkstemp(suffix=os.path.splitext(voice)[1] or ".wav")
    os.close(fd)
    with open(local_voice, "wb") as f:
        f.write(resp.content)
    voice_path = local_voice
else:
    voice_path = voice

checkpoint_info = CheckpointInfo.from_hf_repo(repo_id)
tts_model = TTSModel.from_checkpoint_info(
    checkpoint_info,
    n_q=16,
    temp=temp,
    cfg_coef=cfg_coef,
    device=torch.device(device),
)
entries = tts_model.prepare_script([text], padding_between=padding_between)
voice_path = tts_model.get_voice_path(voice_path)
prefix = tts_model.get_prefix(voice_path)

pcms = []

def _on_frame(frame):
    if (frame[:, 1:] != -1).all():
        pcm = tts_model.mimi.decode(frame[:, 1:, :]).cpu()
        pcms.append(pcm.clip(-1, 1))

all_entries = [entries]
prefixes = [prefix]
with tts_model.mimi.streaming(len(all_entries)):
    _ = tts_model.generate(all_entries, [], on_frame=_on_frame, prefixes=prefixes)

audios = torch.cat(pcms, dim=-1)
output_audio = audios[0].squeeze(0).numpy()
RESULT = {"audio": output_audio, "sample_rate": tts_model.mimi.sample_rate}
