{% set repo_id = repo_id | default("zai-org/chatglm3-6b") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('你好，请用一句话介绍你自己。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import os
import sys
import shutil
import types
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoConfig

config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
modeling_path = hf_hub_download(repo_id=repo_id, filename='modeling_chatglm.py')
configuration_path = hf_hub_download(repo_id=repo_id, filename='configuration_chatglm.py')
tokenization_path = hf_hub_download(repo_id=repo_id, filename='tokenization_chatglm.py')
quantization_path = hf_hub_download(repo_id=repo_id, filename='quantization.py')
model_index_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin.index.json')
tokenizer_model_path = hf_hub_download(repo_id=repo_id, filename='tokenizer.model')
special_tokens_path = hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
weight_files = [
    'pytorch_model-00001-of-00007.bin',
    'pytorch_model-00002-of-00007.bin',
    'pytorch_model-00003-of-00007.bin',
    'pytorch_model-00004-of-00007.bin',
    'pytorch_model-00005-of-00007.bin',
    'pytorch_model-00006-of-00007.bin',
    'pytorch_model-00007-of-00007.bin',
]
weight_paths = [hf_hub_download(repo_id=repo_id, filename=f) for f in weight_files]

model_dir = os.path.dirname(config_path)
for src in [modeling_path, configuration_path, tokenization_path, quantization_path]:
    dst = os.path.join(model_dir, os.path.basename(src))
    if not os.path.exists(dst):
        shutil.copyfile(src, dst)
if model_dir not in sys.path:
    sys.path.insert(0, model_dir)

pkg_name = 'chatglm_remote'
pkg = types.ModuleType(pkg_name)
pkg.__path__ = [model_dir]
sys.modules[pkg_name] = pkg

from chatglm_remote.modeling_chatglm import ChatGLMForConditionalGeneration

config = AutoConfig.from_pretrained(model_dir, trust_remote_code=True)
tokenizer = AutoTokenizer.from_pretrained(model_dir, trust_remote_code=True)
model = ChatGLMForConditionalGeneration.from_pretrained(
    model_dir,
    config=config,
    trust_remote_code=True,
    torch_dtype=torch.float16,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        do_sample=False,
    )

output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"text": output_text}
