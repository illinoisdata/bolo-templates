{% set repo_id = repo_id | default("castorini/monot5-base-msmarco") %}
{% set device = device | default("cuda:0") %}
{% set query = query | default("What is document reranking?") %}
{% set document = document | default("Monot5 is a T5-base reranker fine-tuned on MS MARCO passages.") %}
{% set max_new_tokens = max_new_tokens | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"
document = """{{ document }}"""
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

input_prompt = f"Query: {query} Document: {document}"
model_inputs = tokenizer(input_prompt, return_tensors="pt", truncation=True, padding=True).to(device)
with torch.no_grad():
    generated_tokens = model.generate(**model_inputs, max_new_tokens=max_new_tokens)

generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True).strip()

RESULT = {"generated_text": generated_text}
