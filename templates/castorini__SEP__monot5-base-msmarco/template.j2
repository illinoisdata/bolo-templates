{% set repo_id = repo_id %}
{% set device = device %}
{% set query = "What is document reranking?" %}
{% set document = "Monot5 is a T5-base reranker fine-tuned on MS MARCO passages." %}
{% set max_new_tokens = 5 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/castorini__SEP__monot5-base-msmarco" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
query = "{{ query }}"
document = """{{ document }}"""
max_new_tokens = {{ max_new_tokens }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

input_prompt = f"Query: {query} Document: {document}"
model_inputs = tokenizer(input_prompt, return_tensors="pt", truncation=True, padding=True).to(device)
with torch.no_grad():
    generated_tokens = model.generate(**model_inputs, max_new_tokens=max_new_tokens)

generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True).strip()

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    destination = Path(output_dir)
    destination.mkdir(parents=True, exist_ok=True)
    (destination / "generated_text.txt").write_text(RESULT["generated_text"], encoding="utf-8")