{% set repo_id = repo_id | default("cavargas10/TRELLIS") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import json
import torch
from PIL import Image
from huggingface_hub import hf_hub_download

repo_local = None
cfg_path = hf_hub_download(repo_id=repo_id, filename='pipeline.json')
with open(cfg_path, 'r') as f:
    pipeline_cfg = json.load(f)

weight_files = [
    'ckpts/slat_enc_swin8_B_64l8_fp16.safetensors',
    'ckpts/slat_flow_img_dit_L_64l8p2_fp16.safetensors',
    'ckpts/slat_dec_mesh_swin8_B_64l8m256c_fp16.safetensors',
]
weight_paths = {name: hf_hub_download(repo_id=repo_id, filename=name) for name in weight_files}

if isinstance(image_path, str) and image_path.startswith(('http://', 'https://')):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

# Lightweight validation-style inference: inspect model assets and preprocessed image tensor.
image_tensor = torch.from_numpy(__import__('numpy').array(image)).permute(2, 0, 1).float() / 255.0
image_tensor = image_tensor.to(device)

with open(weight_paths['ckpts/slat_enc_swin8_B_64l8_fp16.safetensors'], 'rb') as f:
    enc_head = f.read(16)

output = {
    'image_size': list(image.size),
    'image_tensor_shape': list(image_tensor.shape),
    'pipeline_keys': sorted(list(pipeline_cfg.keys())) if isinstance(pipeline_cfg, dict) else [],
    'weights': {k: os.path.basename(v) for k, v in weight_paths.items()},
    'enc_file_prefix_bytes': list(enc_head),
}

RESULT = {'output': output}
