{% set device = "cuda:0" %}
{% set repo_id = "city96/t5-v1_1-xxl-encoder-bf16" %}
{% set text_input = "An image of a cat sitting on a mat with a playful expression." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModel.from_pretrained(repo_id, torch_dtype=torch.bfloat16).to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt", padding=True, truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.inference_mode():
    encoder_outputs = model.encoder(
        input_ids=inputs["input_ids"],
        attention_mask=inputs.get("attention_mask"),
        return_dict=True,
    )

last_hidden_state = encoder_outputs.last_hidden_state.to(torch.float32).detach().cpu().numpy()

RESULT = {"last_hidden_state": last_hidden_state}
