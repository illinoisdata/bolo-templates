{% set repo_id = repo_id | default("city96/t5-v1_1-xxl-encoder-bf16") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('a photo of a cute cat sitting on a chair') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, T5EncoderModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = T5EncoderModel.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.bfloat16,
)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True, use_fast=False)
inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = last_hidden_state.mean(dim=1)

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
