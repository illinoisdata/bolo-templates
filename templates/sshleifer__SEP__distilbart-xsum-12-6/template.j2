{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sshleifer/distilbart-xsum-12-6") %}
{% set input_text = input_text | default("The Transformers library provides state-of-the-art models for summarization tasks.") %}
{% set max_length = max_length | default(142) %}
{% set min_length = min_length | default(56) %}
{% set num_beams = num_beams | default(6) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

_tokenizer = AutoTokenizer.from_pretrained(repo_id)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
_device = torch.device(device)
_model = _model.to(_device)
_model.eval()

_tokenized_inputs = _tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=1024,
)
_tokenized_inputs = {key: value.to(_device) for key, value in _tokenized_inputs.items()}

_generated_ids = _model.generate(
    **_tokenized_inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    early_stopping=True,
)

_summary = _tokenizer.batch_decode(
    _generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0]

RESULT = {"summary": _summary}
