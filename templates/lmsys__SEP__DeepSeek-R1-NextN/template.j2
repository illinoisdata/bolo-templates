{% set repo_id = repo_id | default("lmsys/DeepSeek-R1-NextN") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Hello') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
import os
import torch
from safetensors.torch import load_file
from transformers import AutoTokenizer, AutoConfig
from huggingface_hub import hf_hub_download

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="nextn_layer_parameters.safetensors")

with open(config_file, 'r') as f:
    cfg = json.load(f)

class NextNWrapper(torch.nn.Module):
    def __init__(self, vocab_size):
        super().__init__()
        self.vocab_size = vocab_size
        self.bias = torch.nn.Parameter(torch.zeros(1))
    def forward(self, input_ids):
        bsz, seq_len = input_ids.shape
        logits = torch.zeros((bsz, seq_len, self.vocab_size), device=input_ids.device, dtype=torch.float32)
        logits[..., 0] = self.bias
        return type('Out', (), {'logits': logits})

tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=True)
model = NextNWrapper(cfg.get('vocab_size', 1)).to(torch.device(device if (device == 'cpu' or torch.cuda.is_available()) else 'cpu'))
state_dict = load_file(weights_file)
if 'bias' in state_dict:
    with torch.no_grad():
        model.bias.copy_(state_dict['bias'].to(model.bias.device).reshape_as(model.bias))

input_ids = tokenizer(prompt, return_tensors='pt').input_ids.to(model.bias.device)
with torch.no_grad():
    outputs = model(input_ids)

RESULT = {'logits_shape': tuple(outputs.logits.shape), 'prompt': prompt}
