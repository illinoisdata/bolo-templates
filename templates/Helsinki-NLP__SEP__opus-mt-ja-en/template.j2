{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ja-en") %}
{% set input_text = input_text | default("これは日本語から英語への翻訳テストです。") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(input_text, return_tensors="pt").to(device)

generated_tokens = model.generate(
    **inputs,
    max_length=getattr(model.config, "max_length", 512),
    num_beams=getattr(model.config, "num_beams", 6),
)
decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_output = decoded[0] if len(decoded) == 1 else decoded

RESULT = {"translation": translation_output}
