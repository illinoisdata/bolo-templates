{% set repo_id = repo_id | default("urchade/gliner_large-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Cristiano Ronaldo dos Santos Aveiro (Portuguese pronunciation: [kɾiʃˈtjɐnu ʁɔˈnaldu]; born 5 February 1985) is a Portuguese professional footballer who plays as a forward for and captains both Saudi Pro League club Al Nassr and the Portugal national team.') %}
{% set labels = labels | default(['person', 'award', 'date', 'competitions', 'teams']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
labels = {{ labels }}

import json
import os
import torch
from huggingface_hub import hf_hub_download
from gliner import GLiNER

config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = GLiNER.from_pretrained(repo_id)
model = model.to(device)

entities = model.predict_entities(text, labels)
output = [{"text": e["text"], "label": e["label"], "start": e.get("start"), "end": e.get("end"), "score": e.get("score")} for e in entities]

RESULT = {"entities": output}
