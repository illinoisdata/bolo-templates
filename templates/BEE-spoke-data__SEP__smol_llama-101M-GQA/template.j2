{% set repo_id = repo_id | default("BEE-spoke-data/smol_llama-101M-GQA") %}
{% set device = device | default("cuda:0") %}
{%- set task = task | default("text-generation") -%}
{%- set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") -%}
{%- set max_new_tokens = max_new_tokens | default(64) -%}
{%- set do_sample = do_sample | default(True) -%}
{%- set temperature = temperature | default(0.8) -%}
{%- set repetition_penalty = repetition_penalty | default(1.15) -%}
{%- set no_repeat_ngram_size = no_repeat_ngram_size | default(4) -%}
{%- set eta_cutoff = eta_cutoff | default(0.0006) -%}
{%- set renormalize_logits = renormalize_logits | default(True) -%}
{%- set model = model | default(repo_id) -%}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}
repetition_penalty = {{ repetition_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
eta_cutoff = {{ eta_cutoff }}
renormalize_logits = {{ renormalize_logits }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    device=device,
    max_new_tokens=max_new_tokens,
    do_sample=do_sample,
    temperature=temperature,
    repetition_penalty=repetition_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
    eta_cutoff=eta_cutoff,
    renormalize_logits=renormalize_logits,
)
RESULT = pipe(input_prompt)
