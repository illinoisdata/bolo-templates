{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("uer/bart-base-chinese-cluecorpussmall") %}
{% set text_input = text_input | default("中国的首都是[MASK]京") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(1) %}
{% set do_sample = do_sample | default(False) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
num_return_sequences = {{ num_return_sequences }}
from pathlib import Path
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items() if key != "token_type_ids"}
generated_ids = model.generate(**inputs, max_length=max_length, do_sample=do_sample, num_beams=num_beams, num_return_sequences=num_return_sequences)
decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
decoded_text = decoded[0] if decoded else ""
RESULT = {"generated_text": decoded_text}
