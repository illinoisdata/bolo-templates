{% set repo_id = repo_id | default("uer/bart-base-chinese-cluecorpussmall") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('中国的首都是[MASK]京') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import json
import os
import torch
from huggingface_hub import hf_hub_download
from transformers import BertTokenizer, BartForConditionalGeneration

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

with open(tokenizer_config_path, "r", encoding="utf-8") as f:
    tokenizer_config = json.load(f)
with open(special_tokens_map_path, "r", encoding="utf-8") as f:
    special_tokens_map = json.load(f)

model = BartForConditionalGeneration.from_pretrained(
    os.path.dirname(weights_path),
    local_files_only=True,
)

tokenizer = BertTokenizer(vocab_file=vocab_path, **{k: v for k, v in tokenizer_config.items() if k in ["do_lower_case", "tokenize_chinese_chars", "strip_accents", "never_split", "unk_token", "sep_token", "pad_token", "cls_token", "mask_token"]})
for token_name, token_value in special_tokens_map.items():
    if hasattr(tokenizer, token_name):
        setattr(tokenizer, token_name, token_value)

model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items() if k != "token_type_ids"}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=50, do_sample=False)

generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
