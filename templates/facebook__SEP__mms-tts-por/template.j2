{% set repo_id = "facebook/mms-tts-por" %}
{% set device = "cuda:0" %}
{% set text = "some example text in the Portuguese language" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mms-tts-por" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import VitsModel, AutoTokenizer
import scipy.io.wavfile as wavfile

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu().numpy()
sampling_rate = model.config.sampling_rate

RESULT = {"waveform": waveform, "sampling_rate": sampling_rate}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    wavfile.write(os.path.join(output_dir, "output.wav"), RESULT["sampling_rate"], RESULT["waveform"])