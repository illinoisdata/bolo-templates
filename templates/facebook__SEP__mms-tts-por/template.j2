{% set repo_id = repo_id | default("facebook/mms-tts-por") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("some example text in the Portuguese language") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import VitsModel, AutoTokenizer
import scipy.io.wavfile as wavfile

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs).waveform

waveform = output.squeeze(0).cpu().numpy()
sampling_rate = model.config.sampling_rate

RESULT = {"waveform": waveform, "sampling_rate": sampling_rate}
