{% set repo_id = "google/bert_uncased_L-4_H-256_A-4" %}
{% set device = "cuda:0" %}
{% set text = "The capital of France is <mask>." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__bert_uncased_L-4_H-256_A-4" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
output_dir = "{{ output_dir }}"

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

processed_text = text.replace("<mask>", tokenizer.mask_token) if "<mask>" in text else text
inputs = tokenizer(processed_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

with torch.no_grad():
    outputs = model(input_ids=input_ids, attention_mask=attention_mask)
logits = outputs.logits

mask_token_index = torch.where(input_ids[0] == tokenizer.mask_token_id)[0][0]
mask_token_logits = logits[0, mask_token_index, :]
probs = torch.softmax(mask_token_logits, dim=-1)

topk = torch.topk(probs, k=5)
indices = topk.indices.tolist()
scores = topk.values.tolist()
tokens = tokenizer.convert_ids_to_tokens(indices)

predictions = [{"token": token, "score": score} for token, score in zip(tokens, scores)]

RESULT = {"predictions": predictions}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "predictions.json"), "w") as f:
        json.dump(RESULT["predictions"], f)