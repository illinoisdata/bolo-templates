{% set source_text = "Hyvää huomenta. Tämä on testi." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-fi-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(source_text, return_tensors="pt").to(device)

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)

translation = tokenizer.batch_decode(
    generated_tokens,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0].strip()

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_dir_path = Path(output_dir)
    output_dir_path.mkdir(parents=True, exist_ok=True)
    translation_path = output_dir_path / "translation.txt"
    translation_path.write_text(RESULT["translation"], encoding="utf-8")