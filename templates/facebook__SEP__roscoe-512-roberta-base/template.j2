{% set repo_id = repo_id | default("facebook/roscoe-512-roberta-base") %}
{% set device = device | default("cuda:0") %}
{% set sentences = sentences | default(["This is a test sentence.", "This is another one."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences }}

import os
import json
import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(sentences, return_tensors="pt", padding=True, truncation=True).to(device)
outputs = model(**inputs)
embeddings = outputs.pooler_output
embeddings = embeddings.cpu().tolist()

RESULT = {"embeddings": embeddings}
