{% set repo_id = repo_id | default("michaelyuanqwq/roboengine-sam") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('Segment the robot in the image.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import requests
import torch
from PIL import Image
from io import BytesIO
from safetensors.torch import load_file
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
if image_path.startswith(("http://", "https://")):
    response = requests.get(image_path, timeout=30)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

state_dict = load_file(model_path)
first_key = next(iter(state_dict))
weight = state_dict[first_key]
RESULT = {"output": {"num_tensors": len(state_dict), "first_key": first_key, "first_shape": list(weight.shape), "text_prompt": text_prompt, "image_size": list(image.size)}}
