{% set repo_id = repo_id | default("typhoon-ai/typhoon2.1-gemma3-4b") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('ขอแนะนำตัวสั้นๆ เป็นภาษาไทย') %}
{% set max_new_tokens = max_new_tokens | default(64) %}
{% set temperature = temperature | default(0.6) %}
{% set top_p = top_p | default(0.95) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}
top_p = {{ top_p }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
weights_index_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors.index.json")
weight_1_path = hf_hub_download(repo_id=repo_id, filename="model-00001-of-00002.safetensors")
weight_2_path = hf_hub_download(repo_id=repo_id, filename="model-00002-of-00002.safetensors")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(
    repo_id,
    torch_dtype=torch.bfloat16,
    device_map=None,
)
model = model.to(device)
model.eval()

messages = [
    {"role": "system", "content": "You are a helpful assistant. Respond in the user's language."},
    {"role": "user", "content": prompt},
]

prompt_text = tokenizer.apply_chat_template(
    messages,
    add_generation_prompt=True,
    tokenize=False,
    enable_thinking=False,
)
input_ids = tokenizer(prompt_text, return_tensors="pt").input_ids.to(model.device)

with torch.inference_mode():
    output_ids = model.generate(
        input_ids=input_ids,
        max_new_tokens=max_new_tokens,
        do_sample=True,
        temperature=temperature,
        top_p=top_p,
    )

text = tokenizer.decode(output_ids[0][input_ids.shape[-1]:], skip_special_tokens=True)

RESULT = {"text": text}
