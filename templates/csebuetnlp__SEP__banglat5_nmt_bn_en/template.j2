{% set repo_id = "csebuetnlp/banglat5_nmt_bn_en" %}
{% set device = "cuda:0" %}
{% set source_text = "আমি একটি প্রকল্পের উপর কাজ করছি এবং ইংরেজিতে অনুবাদ করতে চাই।" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
compute_device = torch.device(device)
model = model.to(compute_device)

encoded_inputs = tokenizer(source_text, return_tensors="pt")
encoded_inputs = {key: value.to(compute_device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
