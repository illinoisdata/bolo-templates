{% set repo_id = "Helsinki-NLP/opus-mt-de-cs" %}
{% set device = "cuda:0" %}
{% set text = "Hello world!" %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-de-cs" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"
import os
from pathlib import Path
import torch
from transformers import MarianTokenizer, MarianMTModel

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)
inputs = tokenizer(text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0]
RESULT = {"translation": translation}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    output_file = Path(output_dir) / "translation.txt"
    output_file.write_text(RESULT["translation"], encoding="utf-8")