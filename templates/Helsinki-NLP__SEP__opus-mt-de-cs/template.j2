{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-de-cs") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hello world!") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
import os
from pathlib import Path
import torch
from transformers import MarianTokenizer, MarianMTModel

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(device)
inputs = tokenizer(text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
generated_tokens = model.generate(**inputs, max_length=max_length)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = translations[0]
RESULT = {"translation": translation}
