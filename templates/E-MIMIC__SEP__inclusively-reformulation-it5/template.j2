{% set repo_id = repo_id | default("E-MIMIC/inclusively-reformulation-it5") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('I professori devono essere preparati.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=64)
output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"text": output_text}
