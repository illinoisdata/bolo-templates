{% set input_text = "I professori devono essere preparati." %}
{% set max_length = 128 %}
{% set max_new_tokens = 64 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/E-MIMIC__SEP__inclusively-reformulation-it5" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

model_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding="longest",
    max_length=max_length,
)
model_inputs = {key: value.to(device) for key, value in model_inputs.items()}

generated_tokens = model.generate(
    **model_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
    early_stopping=True,
)

rewritten_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True).strip()

RESULT = {"rewritten_text": rewritten_text}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    rewritten_path = os.path.join(output_dir, "rewritten_text.txt")
    with open(rewritten_path, "w", encoding="utf-8") as handle:
        handle.write(RESULT["rewritten_text"])