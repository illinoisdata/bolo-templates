{% set repo_id = repo_id | default("ogkalu/comic-text-and-bubble-detector") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set threshold = threshold | default(0.3) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
threshold = {{ threshold }}

from io import BytesIO
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoImageProcessor, RTDetrV2ForObjectDetection

image_path_or_url = image
if isinstance(image_path_or_url, str) and image_path_or_url.startswith(("http://", "https://")):
    import requests
    image_pil = Image.open(BytesIO(requests.get(image_path_or_url, timeout=30).content)).convert("RGB")
else:
    image_pil = Image.open(image_path_or_url).convert("RGB")

weights_path = hf_hub_download(repo_id=repo_id, filename="detector.onnx")
processor = AutoImageProcessor.from_pretrained(repo_id)
model = RTDetrV2ForObjectDetection.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = processor(images=image_pil, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

orig_size = torch.tensor([image_pil.size[::-1]], device=device)
results = processor.post_process_object_detection(outputs, threshold=threshold, target_sizes=orig_size)[0]
boxes = results["boxes"].detach().cpu().numpy().tolist()
scores = results["scores"].detach().cpu().numpy().tolist()
labels = results["labels"].detach().cpu().numpy().tolist()
label_names = [model.config.id2label[str(int(i))] if str(int(i)) in model.config.id2label else model.config.id2label[int(i)] for i in labels]

RESULT = {"boxes": boxes, "scores": scores, "labels": labels, "label_names": label_names}
