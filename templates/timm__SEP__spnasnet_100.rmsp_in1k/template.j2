repo_id = {{ repo_id | tojson }}
task = {{ task | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from transformers import pipeline
from PIL import Image

pipe = pipeline(task=task, model=repo_id, device=device)

image = Image.open(input_image).convert("RGB")
image_input = image

inference_output = pipe(image_input)
RESULT = {"predictions": inference_output}
