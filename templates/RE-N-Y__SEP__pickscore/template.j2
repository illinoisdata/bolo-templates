{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set text_prompt = text_prompt | default('a photo of a cat') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text_prompt = "{{ text_prompt }}"

import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import CLIPImageProcessorPil, CLIPTokenizer, CLIPModel

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

image_processor = CLIPImageProcessorPil.from_pretrained("yuvalkirstain/PickScore_v1")
tokenizer = CLIPTokenizer.from_pretrained("yuvalkirstain/PickScore_v1")
model = CLIPModel.from_pretrained("yuvalkirstain/PickScore_v1")
state_dict = torch.load(weights_path, map_location="cpu")
if isinstance(state_dict, dict) and "state_dict" in state_dict:
    state_dict = state_dict["state_dict"]
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

image_inputs = image_processor(images=image, return_tensors="pt")
text_inputs = tokenizer([text_prompt], padding=True, return_tensors="pt")
image_inputs = {k: v.to(device) for k, v in image_inputs.items()}
text_inputs = {k: v.to(device) for k, v in text_inputs.items()}
with torch.no_grad():
    image_outputs = model.vision_model(**image_inputs)
    text_outputs = model.text_model(**text_inputs)
    image_embeds = model.visual_projection(image_outputs.pooler_output)
    text_embeds = model.text_projection(text_outputs.pooler_output)
    image_embeds = image_embeds / image_embeds.norm(dim=-1, keepdim=True)
    text_embeds = text_embeds / text_embeds.norm(dim=-1, keepdim=True)
    score = (image_embeds @ text_embeds.T).squeeze(-1)

RESULT = {"score": score.detach().cpu().tolist()}
