{% set repo_id = repo_id | default("cnmoro/static-nomic-eng-ptbr-tiny") %}
{% set device = device | default("cuda:0") %}
{% set text_inputs = text_inputs | default(['Example sentence']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs }}

import os
import json
import torch
import numpy as np
from huggingface_hub import hf_hub_download
from model2vec import StaticModel

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

with open(config_path, "r") as f:
    config = json.load(f)

model = StaticModel.from_pretrained(repo_id)

embeddings = model.encode(text_inputs)

if isinstance(embeddings, torch.Tensor):
    output_value = embeddings.detach().cpu().numpy().tolist()
else:
    output_value = np.asarray(embeddings).tolist()

RESULT = {"embeddings": output_value}
