{% set device = "cuda:0" %}
{% set repo_id = "nafisehNik/mt5-persian-summary" %}
{% set input_text = "این یک متن نمونه برای خلاصه سازی اخبار فارسی است." %}
{% set num_beams = 2 %}
{% set max_output_length = 120 %}
{% set max_input_length = 1024 %}
{% set length_penalty = 2.0 %}
{% set repetition_penalty = 1.0 %}
{% set early_stopping = True %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
num_beams = {{ num_beams }}
max_output_length = {{ max_output_length }}
max_input_length = {{ max_input_length }}
length_penalty = {{ length_penalty }}
repetition_penalty = {{ repetition_penalty }}
early_stopping = {{ early_stopping }}

import os
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded = tokenizer(
    input_text,
    max_length=max_input_length,
    padding="max_length",
    truncation=True,
    return_tensors="pt",
    add_special_tokens=True,
)
encoded = {key: value.to(device) for key, value in encoded.items()}

generated_ids = model.generate(
    input_ids=encoded["input_ids"],
    attention_mask=encoded["attention_mask"],
    num_beams=num_beams,
    max_length=max_output_length,
    repetition_penalty=repetition_penalty,
    length_penalty=length_penalty,
    early_stopping=early_stopping,
    use_cache=True,
)

decoded = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
summary = decoded[0] if len(decoded) == 1 else decoded

RESULT = {"summary": summary}
