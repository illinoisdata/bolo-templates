{% set repo_id = repo_id | default("nafisehNik/mt5-persian-summary") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("به گزارش شانا به نقل از شرکت پالایش گاز شهید هاشمی نژاد، جمعی از کارشناسان این پالایشگاه با هدف معرفی محصول کود گوگرد بنتونیتی به کشاورزان در شانزدهمین نمایشگاه تخصصی کشاورزی، دام، طیور، ماشین آلات و صنایع وابسته در اردبیل حضور پیدا کردند و به معرفی دستاوردهای این شرکت پرداختند.") %}
{% set num_beams = num_beams | default(2) %}
{% set repetition_penalty = repetition_penalty | default(1.0) %}
{% set length_penalty = length_penalty | default(2.0) %}
{% set early_stopping = early_stopping | default(True) %}
{% set max_output_length = max_output_length | default(120) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
early_stopping = {{ early_stopping }}
max_output_length = {{ max_output_length }}

import torch
from transformers import AutoModelForSeq2SeqLM, T5Tokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
tokenizer = T5Tokenizer.from_pretrained(repo_id, use_fast=False)

inputs = tokenizer(text, max_length=1000, padding="max_length", truncation=True, return_attention_mask=True, add_special_tokens=True, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
model = model.to(device)
model.eval()

with torch.no_grad():
    generated_ids = model.generate(
        input_ids=inputs["input_ids"],
        attention_mask=inputs["attention_mask"],
        num_beams=num_beams,
        max_length=max_output_length,
        repetition_penalty=repetition_penalty,
        length_penalty=length_penalty,
        early_stopping=early_stopping,
        use_cache=True,
    )

output = tokenizer.decode(generated_ids[0], skip_special_tokens=True, clean_up_tokenization_spaces=True)

RESULT = {"output": output}
