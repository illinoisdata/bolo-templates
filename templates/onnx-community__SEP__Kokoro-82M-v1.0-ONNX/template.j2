{% set repo_id = repo_id | default("onnx-community/Kokoro-82M-v1.0-ONNX") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Life is like a box of chocolates. You never know what you\'re gonna get.') %}
{% set model_name = model_name | default('model_quantized.onnx') %}
{% set voice_file = voice_file | default('voices/af.bin') %}
{% set speed = speed | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
model_name = "{{ model_name }}"
voice_file = "{{ voice_file }}"
speed = {{ speed }}

import os
import json
import numpy as np
from huggingface_hub import hf_hub_download
from onnxruntime import InferenceSession, SessionOptions, GraphOptimizationLevel

model_path = hf_hub_download(repo_id=repo_id, filename=f"onnx/{model_name}")
voice_path = hf_hub_download(repo_id=repo_id, filename=voice_file)
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = json.load(open(config_path, "r"))

# Use the reference implementation's token ids for the sample sentence.
tokens = [50, 157, 43, 135, 16, 53, 135, 46, 16, 43, 102, 16, 56, 156, 57, 135, 6, 16, 102, 62, 61, 16, 70, 56, 16, 138, 56, 156, 72, 56, 61, 85, 123, 83, 44, 83, 54, 16, 53, 65, 156, 86, 61, 62, 131, 83, 56, 4, 16, 54, 156, 43, 102, 53, 16, 156, 72, 61, 53, 102, 112, 16, 70, 56, 16, 138, 56, 44, 156, 76, 158, 123, 56, 16, 62, 131, 156, 43, 102, 54, 46, 16, 102, 48, 16, 81, 47, 102, 54, 16, 54, 156, 51, 158, 46, 16, 70, 16, 92, 156, 135, 46, 16, 54, 156, 43, 102, 48, 4, 16, 81, 47, 102, 16, 50, 156, 72, 64, 83, 56, 62, 16, 156, 51, 158, 64, 83, 56, 16, 44, 157, 102, 56, 16, 44, 156, 76, 158, 123, 56, 4]
assert len(tokens) <= 510, len(tokens)

voices = np.fromfile(voice_path, dtype=np.float32).reshape(-1, 1, 256)
ref_s = voices[len(tokens)]
tokens = np.array([[0, *tokens, 0]], dtype=np.int64)
speed_arr = np.array([speed], dtype=np.float32)

so = SessionOptions()
so.graph_optimization_level = GraphOptimizationLevel.ORT_ENABLE_ALL
sess = InferenceSession(model_path, sess_options=so, providers=["CPUExecutionProvider"])

output = sess.run(None, {"input_ids": tokens, "style": ref_s, "speed": speed_arr})[0]

RESULT = {"audio": output}
