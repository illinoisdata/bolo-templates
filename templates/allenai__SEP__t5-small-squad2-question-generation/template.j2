{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("allenai/t5-small-squad2-question-generation") %}
{% set input_text = input_text | default("He thanked all fellow bloggers and organizations that showed support during the conference.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set early_stopping = early_stopping | default(True) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}

import torch
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded = tokenizer(input_text, return_tensors="pt")
input_ids = encoded.input_ids.to(torch_device)
attention_mask = encoded.attention_mask.to(torch_device)

generated_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_length=max_length,
    num_beams=num_beams,
    no_repeat_ngram_size=no_repeat_ngram_size,
    early_stopping=early_stopping,
)

generated_questions = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"generated_questions": generated_questions}
