{% set repo_id = repo_id | default("allenai/t5-small-squad2-question-generation") %}
{% set device = device | default("cuda:0") %}
{% set input_string = input_string | default("shrouds herself in white and walks penitentially disguised as brotherly love through factories and parliaments; offers help, but desires power;") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_string = "{{ input_string }}"

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

input_ids = tokenizer.encode(input_string, return_tensors="pt").to(device)
with torch.no_grad():
    generated_ids = model.generate(input_ids, max_new_tokens=32, num_beams=4)
output = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"output": output}
