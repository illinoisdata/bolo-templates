{% set repo_id = repo_id | default("eugenesiow/msrn") %}
{% set device = device | default("cuda:0") %}
{% set scale = scale | default(4) %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
scale = {{ scale }}
image_path = "{{ image_path }}"

import os
import sys
import subprocess
import importlib.util

for pkg in ["torch", "huggingface_hub", "requests", "pillow"]:
    if importlib.util.find_spec(pkg if pkg != "pillow" else "PIL") is None:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", pkg])

import requests
from PIL import Image
import torch
from huggingface_hub import hf_hub_download
from super_image import MsrnModel, ImageLoader

weights_filename = f"pytorch_model_{scale}x.pt"
weights_path = hf_hub_download(repo_id=repo_id, filename=weights_filename)
hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = ImageLoader.load_image(image)
model = MsrnModel.from_pretrained(repo_id, scale=scale)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

with torch.no_grad():
    preds = model(inputs.to(device))

RESULT = {"preds": preds}
