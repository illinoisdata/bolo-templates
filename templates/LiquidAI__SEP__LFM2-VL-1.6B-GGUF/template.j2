{% set repo_id = repo_id | default("LiquidAI/LFM2-VL-1.6B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('LFM2-VL-1.6B-Q4_0.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe this image in detail.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import os
import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_filename = 'mmproj-LFM2-VL-1.6B-F16.gguf' if 'Q4_0' in quant_filename else 'mmproj-LFM2-VL-1.6B-Q8_0.gguf'
mmproj_path = hf_hub_download(repo_id=repo_id, filename=mmproj_filename)

if str(image_path).startswith(('http://', 'https://')):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

n_gpu_layers = -1 if device.startswith('cuda') else 0
llm = Llama(
    model_path=weights_path,
    mmproj_path=mmproj_path,
    n_ctx=2048,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

messages = [
    {"role": "user", "content": [
        {"type": "text", "text": prompt},
        {"type": "image_url", "image_url": {"url": image_path}},
    ]},
]

output = llm.create_chat_completion(messages=messages, temperature=0.2, max_tokens=128)

RESULT = {"output": output["choices"][0]["message"]["content"]}
