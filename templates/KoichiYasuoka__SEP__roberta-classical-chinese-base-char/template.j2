{% set repo_id = repo_id | default("KoichiYasuoka/roberta-classical-chinese-base-char") %}
{% set device = device | default("cuda:0") %}
{%- set task = task | default("fill-mask") -%}
{%- set masked_prompt = masked_prompt | default("孟子[MASK]梁惠王") -%}
{%- set mask_placeholder = mask_placeholder | default("[MASK]") -%}
{%- set model = model | default(repo_id) -%}


task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
masked_prompt = {{ masked_prompt | tojson }}
mask_placeholder = {{ mask_placeholder | tojson }}

from transformers import pipeline

pipeline_device = -1
pipe = pipeline(task=task, model=model, device=pipeline_device)
mask_token = pipe.tokenizer.mask_token
text = masked_prompt.replace(mask_placeholder, mask_token)
RESULT = pipe(text)
