{% set repo_id = repo_id | default("microsoft/deberta-v2-xlarge-mnli") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-classification") %}
{% set model = model | default(repo_id) %}
{% set input_premise = input_premise | default("I love you.") %}
{% set input_hypothesis = input_hypothesis | default("I like you.") %}

repo_id = "{{ repo_id }}"
model = "{{ model }}"
task = "{{ task }}"
device = "{{ device }}"
input_premise = "{{ input_premise }}"
input_hypothesis = "{{ input_hypothesis }}"

from transformers import pipeline

# Load the pipeline
pipe = pipeline(task=task, model=model, device=device)

# Pre-process the premise and hypothesis
inputs = {"text": input_premise, "text_pair": input_hypothesis}

# Run the model
RESULT = pipe(inputs)
