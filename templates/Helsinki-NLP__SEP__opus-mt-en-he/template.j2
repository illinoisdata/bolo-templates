{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-en-he" %}
{% set src_text = "The quick brown fox jumps over the lazy dog." %}
{% set num_beams = 4 %}
{% set max_length = 512 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-he" %}

device = "{{ device }}"
repo_id = "{{ repo_id }}"
src_text = "{{ src_text }}"
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(src_text, return_tensors="pt")
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs, num_beams=num_beams, max_length=max_length)
translated = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translation.txt"), "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])