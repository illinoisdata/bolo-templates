{% set repo_id = repo_id | default("OpenVINO/Phi-3-mini-4k-instruct-int4-ov") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default('text-generation') %}
{% set input_prompt = input_prompt | default('What is OpenVINO?') %}
{% set max_length = max_length | default(200) %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_length = {{ max_length | tojson }}

from transformers import pipeline, AutoTokenizer
from optimum.intel.openvino import OVModelForCausalLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = OVModelForCausalLM.from_pretrained(repo_id)

pipe = pipeline(task=task, model=model, tokenizer=tokenizer, device=device)
RESULT = pipe(input_prompt, max_length=max_length)
