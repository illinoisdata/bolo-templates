{% set repo_id = repo_id | default("peterchou/ernie-gram") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("在这个城市里，我想要[MASK]生活。") %}
{% set top_k = top_k | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
top_k = {{ top_k }}

import json
from pathlib import Path

import torch
from transformers import AutoModelForMaskedLM, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id).to(device)
model.eval()

# Pre-process input
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

# Run inference
with torch.no_grad():
    outputs = model(**inputs)
logits = outputs.logits

# Post-process results
mask_token_id = tokenizer.mask_token_id
input_ids = inputs["input_ids"]
mask_positions = torch.nonzero(input_ids == mask_token_id, as_tuple=False)
mask_predictions = []
for coordinate in mask_positions:
    batch_index = int(coordinate[0])
    token_index = int(coordinate[1])
    mask_logits = logits[batch_index, token_index, :]
    probabilities = torch.softmax(mask_logits, dim=-1)
    topk_probs, topk_indices = torch.topk(probabilities, k=top_k)
    candidates = []
    for token_id, score in zip(topk_indices.tolist(), topk_probs.tolist()):
        token = tokenizer.convert_ids_to_tokens(token_id)
        candidates.append({"token": token, "score": float(score)})
    mask_predictions.append(
        {
            "batch_index": batch_index,
            "token_index": token_index,
            "candidates": candidates,
        }
    )

RESULT = {"input_text": input_text, "mask_predictions": mask_predictions}
