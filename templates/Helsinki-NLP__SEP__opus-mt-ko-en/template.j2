{% set repo_id = "Helsinki-NLP/opus-mt-ko-en" %}
{% set device = "cuda:0" %}
{% set input_text = "안녕하세요. 이 모델을 테스트합니다." %}
{% set max_length = 200 %}
{% set num_beams = 6 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
