{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("allegro/herbert-klej-cased-v1") %}
{% set text_input = text_input | default("To przykładowe zdanie w języku polskim do analizy.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import os
from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    padding=True,
    max_length=512,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state
cls_embedding = last_hidden_state[:, 0, :]

result_last_hidden_state = last_hidden_state.detach().cpu().numpy()
result_cls_embedding = cls_embedding.detach().cpu().numpy()

RESULT = {
    "last_hidden_state": result_last_hidden_state,
    "cls_embedding": result_cls_embedding,
}
