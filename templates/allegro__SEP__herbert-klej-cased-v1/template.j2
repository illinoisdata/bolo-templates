{% set repo_id = repo_id | default("allegro/herbert-klej-cased-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Kto ma lepszą sztukę, ma lepszy rząd – to jasne.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

_ = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer = AutoTokenizer.from_pretrained("allegro/herbert-klej-cased-tokenizer-v1", use_fast=False)
model = AutoModel.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
