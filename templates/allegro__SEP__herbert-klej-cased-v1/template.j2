{% set text_input = "To przykładowe zdanie w języku polskim do analizy." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/allegro__SEP__herbert-klej-cased-v1" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
output_dir = "{{ output_dir }}"

import os
from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    padding=True,
    max_length=512,
)
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state
cls_embedding = last_hidden_state[:, 0, :]

result_last_hidden_state = last_hidden_state.detach().cpu().numpy()
result_cls_embedding = cls_embedding.detach().cpu().numpy()

RESULT = {
    "last_hidden_state": result_last_hidden_state,
    "cls_embedding": result_cls_embedding,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(Path(output_dir) / "last_hidden_state.npy", RESULT["last_hidden_state"])
    np.save(Path(output_dir) / "cls_embedding.npy", RESULT["cls_embedding"])