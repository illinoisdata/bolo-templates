repo_id = "{{ repo_id }}"
device = "{{ device }}"
past_values = {{ past_values }}

import json
import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoConfig, PatchTSTForPrediction

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

config = AutoConfig.from_pretrained(config_path)
model = PatchTSTForPrediction.from_pretrained(
    weights_path,
    config=config,
    local_files_only=True,
)
model.to(device)
model.eval()

values = np.asarray(past_values, dtype=np.float32)
if values.ndim == 1:
    values = values[:, None]
context_length = int(getattr(config, "context_length", values.shape[0]))
if values.shape[0] < context_length:
    pad = np.repeat(values[:1], context_length - values.shape[0], axis=0)
    values = np.concatenate([pad, values], axis=0)
elif values.shape[0] > context_length:
    values = values[-context_length:]
if values.shape[1] == 1 and getattr(config, 'num_input_channels', 1) > 1:
    values = np.repeat(values, config.num_input_channels, axis=1)
inputs = torch.tensor(values[None, :, :], dtype=torch.float32, device=device)

with torch.no_grad():
    outputs = model(past_values=inputs)

pred = outputs.predictions if hasattr(outputs, 'predictions') else outputs[0]
RESULT = {"predictions": pred.detach().cpu().numpy().tolist()}
