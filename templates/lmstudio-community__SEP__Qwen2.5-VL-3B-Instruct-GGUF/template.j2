{% set repo_id = repo_id | default("lmstudio-community/Qwen2.5-VL-3B-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe the image in detail.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename='mmproj-model-f16.gguf')

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

llm = Llama(
    model_path=weights_path,
    n_gpu_layers=-1 if device.startswith('cuda') else 0,
    chat_format='qwen',
    mmproj_path=mmproj_path,
    verbose=False,
)

messages = [
    {
        'role': 'user',
        'content': [
            {'type': 'image', 'image': image},
            {'type': 'text', 'text': prompt},
        ],
    }
]

output = llm.create_chat_completion(messages=messages, temperature=0.2, max_tokens=256)

RESULT = {"output": output}
