repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import io
import json

import numpy as np
import requests
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
import segmentation_models_pytorch as smp

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

if image_path.startswith("http://") or image_path.startswith("https://"):
    response = requests.get(image_path, timeout=30)
    response.raise_for_status()
    image = Image.open(io.BytesIO(response.content)).convert(config.get("input_space", "RGB"))
else:
    image = Image.open(image_path).convert(config.get("input_space", "RGB"))

image = image.resize((config["input_size"][2], config["input_size"][1]))
image_np = np.asarray(image).astype(np.float32) / 255.0
image_np = (image_np - np.array(config["mean"], dtype=np.float32)) / np.array(config["std"], dtype=np.float32)
image_np = np.transpose(image_np, (2, 0, 1))
inputs = torch.from_numpy(image_np).unsqueeze(0).to(device)

model = smp.Unet("mit_b3", encoder_weights=None, classes=1000, activation=None)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model = model.to(device)
model.eval()
with torch.no_grad():
    output = model.encoder(inputs)
    if isinstance(output, (list, tuple)):
        output = output[-1]
    output = output.detach().cpu().numpy()

RESULT = {"output": output}
