{% set repo_id = repo_id | default("Qwen/Qwen3-1.7B-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen3-1.7B-Q8_0.gguf') %}
{% set prompt = prompt | default('Explain in one sentence what a GGUF model is.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import json
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith('cuda') else 0
llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {"role": "user", "content": prompt},
]

response = llm.create_chat_completion(
    messages=messages,
    temperature=0.7,
    top_p=0.8,
    top_k=20,
    presence_penalty=1.5,
    max_tokens=128,
)

output_text = response["choices"][0]["message"]["content"]

RESULT = {"text": output_text}
