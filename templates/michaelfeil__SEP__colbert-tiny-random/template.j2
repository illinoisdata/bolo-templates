{% set device = "cuda:0" %}
{% set repo_id = "michaelfeil/colbert-tiny-random" %}
{% set query_text = "ColBERT is a dense retrieval architecture built on BERT." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
query_text = "{{ query_text }}"

import numpy as np
import torch
from pathlib import Path
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    query_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    model_outputs = model(**encoded_inputs)

last_hidden_state = model_outputs.last_hidden_state
attention_mask = encoded_inputs["attention_mask"].unsqueeze(-1)
pooled = (last_hidden_state * attention_mask).sum(dim=1)
lengths = attention_mask.sum(dim=1)
embedding = (pooled / lengths).squeeze(0).cpu().numpy()

RESULT = {"query_embedding": embedding}
