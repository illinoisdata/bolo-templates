{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-ar-en" %}
{% set src_text = "هذا اختبار ترجمة." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(src_text, return_tensors="pt", padding=True, truncation=True, max_length=max_length)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
