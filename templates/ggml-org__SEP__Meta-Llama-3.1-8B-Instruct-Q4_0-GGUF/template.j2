{% set repo_id = repo_id | default("ggml-org/Meta-Llama-3.1-8B-Instruct-Q4_0-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("meta-llama-3.1-8b-instruct-q4_0.gguf") %}
{% set prompt = prompt | default("Write a short, friendly greeting from Llama 3.1.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weight_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = 0
if device.startswith("cuda"):
    n_gpu_layers = 999

llm = Llama(
    model_path=weight_path,
    n_ctx=2048,
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

result = llm(prompt, max_tokens=64, temperature=0.7)
output = result["choices"][0]["text"]
RESULT = {"output": output}
