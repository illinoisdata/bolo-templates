{% set repo_id = repo_id | default("iarfmoose/t5-base-question-generator") %}
{% set device = device | default("cuda:0") %}
{% set answer = answer | default('The Eiffel Tower is located in Paris.') %}
{% set context = context | default('The Eiffel Tower is one of the most famous landmarks in the world. It is located in Paris, France, and attracts millions of visitors every year.') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}
{% set top_p = top_p | default(0.95) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
answer = "{{ answer }}"
context = "{{ context }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
top_p = {{ top_p }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False, legacy=True)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

prompt = f"<answer> {answer} <context> {context}"
inputs = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        num_beams=num_beams,
        do_sample=do_sample,
        top_p=top_p,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"question": output_text}
