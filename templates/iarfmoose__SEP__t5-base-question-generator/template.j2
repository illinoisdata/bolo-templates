{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("iarfmoose/t5-base-question-generator") %}
{% set answer_text = answer_text | default("The Eiffel Tower") %}
{% set context_text = context_text | default("The Eiffel Tower is a wrought-iron lattice tower on the Champ de Mars in Paris.") %}
{% set generation_max_new_tokens = generation_max_new_tokens | default(64) %}
{% set generation_num_beams = generation_num_beams | default(5) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
answer_text = {{ answer_text | tojson }}
context_text = {{ context_text | tojson }}
generation_max_new_tokens = {{ generation_max_new_tokens }}
generation_num_beams = {{ generation_num_beams }}

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

input_prompt = f"<answer> {answer_text} <context> {context_text}"
encoded_inputs = tokenizer(input_prompt, return_tensors="pt")
input_ids = encoded_inputs["input_ids"].to(device)
attention_mask = encoded_inputs["attention_mask"].to(device)

generated_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_new_tokens=generation_max_new_tokens,
    num_beams=generation_num_beams,
)

generated_question = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"generated_question": generated_question}
