{% set repo_id = repo_id | default("doc2query/all-with_prefix-t5-base-v1") %}
{% set device = device | default("cuda:0") %}
{% set prefix = prefix | default('answer2question') %}
{% set text = text | default("Python is an interpreted, high-level and general-purpose programming language. Python's design philosophy emphasizes code readability with its notable use of significant whitespace. Its language constructs and object-oriented approach aim to help programmers write clear, logical code for small and large-scale projects.") %}
{% set max_length = max_length | default(64) %}
{% set num_return_sequences = num_return_sequences | default(5) %}
{% set do_sample = do_sample | default(true) %}
{% set top_p = top_p | default(0.95) %}
{% set input_max_length = input_max_length | default(384) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prefix = "{{ prefix }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_return_sequences = {{ num_return_sequences }}
do_sample = {{ do_sample }}
top_p = {{ top_p }}
input_max_length = {{ input_max_length }}

import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = T5Tokenizer.from_pretrained(
    repo_id,
    tokenizer_file=tokenizer_json_path,
    sp_model_kwargs=None,
)
model = T5ForConditionalGeneration.from_pretrained(repo_id, cache_dir=None, local_files_only=True)
model.to(device)
model.eval()

input_text = prefix + ": " + text
inputs = tokenizer.encode(input_text, max_length=input_max_length, truncation=True, return_tensors="pt")
inputs = inputs.to(device)

with torch.no_grad():
    outputs = model.generate(
        input_ids=inputs,
        max_length=max_length,
        do_sample=do_sample,
        top_p=top_p,
        num_return_sequences=num_return_sequences,
    )

generated_queries = [tokenizer.decode(out, skip_special_tokens=True) for out in outputs]
RESULT = {"input_text": input_text, "generated_queries": generated_queries}
