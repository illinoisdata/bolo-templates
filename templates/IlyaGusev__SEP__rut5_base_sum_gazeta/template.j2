{% set repo_id = repo_id | default("IlyaGusev/rut5_base_sum_gazeta") %}
{% set device = device | default("cuda:0") %}
{% set article_text = article_text | default('Высота башни составляет 324 метра (1063 фута), примерно такая же высота, как у 81-этажного здания, и самое высокое сооружение в Париже. Его основание квадратно, размером 125 метров (410 футов) с любой стороны. Во время строительства Эйфелева башня превзошла монумент Вашингтона, став самым высоким искусственным сооружением в мире, и этот титул она удерживала в течение 41 года до завершения строительство здания Крайслер в Нью-Йорке в 1930 году.') %}
{% set max_source_tokens_count = max_source_tokens_count | default(600) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(4) %}
{% set num_beams = num_beams | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = "{{ article_text }}"
max_source_tokens_count = {{ max_source_tokens_count }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
num_beams = {{ num_beams }}

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="spiece.model")

model = T5ForConditionalGeneration.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(
    [article_text],
    max_length=max_source_tokens_count,
    add_special_tokens=True,
    padding="max_length",
    truncation=True,
    return_tensors="pt",
)
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

output_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    no_repeat_ngram_size=no_repeat_ngram_size,
    num_beams=num_beams,
)
summary = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
