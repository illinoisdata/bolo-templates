{% set repo_id = repo_id | default("Ultralytics/YOLO11") %}
{% set device = device | default("cuda:0") %}
{% set model_file = model_file | default('yolo11n.pt') %}
{% set source = source | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set imgsz = imgsz | default(640) %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.7) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
model_file = "{{ model_file }}"
source = "{{ source }}"
imgsz = {{ imgsz }}
conf = {{ conf }}
iou = {{ iou }}

import os
from urllib.parse import urlparse

import requests
from PIL import Image
from ultralytics import YOLO
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename=model_file)
model = YOLO(weights_path)
model.to(device)

if isinstance(source, str) and urlparse(source).scheme in ("http", "https"):
    input_source = Image.open(requests.get(source, stream=True, timeout=30).raw).convert("RGB")
else:
    input_source = source

results = model.predict(source=input_source, imgsz=imgsz, conf=conf, iou=iou, device=device, verbose=False)
result0 = results[0]

boxes = result0.boxes
if boxes is not None:
    boxes_xyxy = boxes.xyxy.detach().cpu().tolist()
    boxes_conf = boxes.conf.detach().cpu().tolist() if boxes.conf is not None else []
    boxes_cls = boxes.cls.detach().cpu().tolist() if boxes.cls is not None else []
else:
    boxes_xyxy = []
    boxes_conf = []
    boxes_cls = []

RESULT = {
    "boxes_xyxy": boxes_xyxy,
    "boxes_confidence": boxes_conf,
    "boxes_class": boxes_cls,
    "names": result0.names,
    "orig_shape": list(result0.orig_shape),
}
