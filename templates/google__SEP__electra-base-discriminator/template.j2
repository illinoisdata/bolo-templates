{% set repo_id = "google/electra-base-discriminator" %}
{% set device = "cuda:0" %}
{% set input_text = "The quick brown fox jumps over the lazy dog" %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}

import json
from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

encoding = tokenizer(input_text, return_tensors="pt")
input_ids = encoding["input_ids"]
token_ids = input_ids.squeeze(0).tolist()
tokens = tokenizer.convert_ids_to_tokens(token_ids)
encoding = {key: value.to(device) for key, value in encoding.items()}

with torch.no_grad():
    outputs = model(**encoding)

logits = outputs.logits.squeeze(0)
predictions = torch.round((torch.sign(logits) + 1) / 2).long()

logits_list = logits.cpu().tolist()
predictions_list = predictions.cpu().tolist()

RESULT = {
    "tokens": tokens,
    "logits": logits_list,
    "reality_predictions": predictions_list,
}
