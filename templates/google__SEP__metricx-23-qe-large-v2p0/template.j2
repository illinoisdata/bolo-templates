{% set repo_id = repo_id | default("google/metricx-23-qe-large-v2p0") %}
{% set device = device | default("cuda:0") %}
{% set source_text = source_text | default('This is a source sentence.') %}
{% set hypothesis_text = hypothesis_text | default('This is a hypothesis translation.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
hypothesis_text = "{{ hypothesis_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

tokenizer = AutoTokenizer.from_pretrained("google/mt5-xl", use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
)
model.to(device)
model.eval()

text = f"source: {source_text} hypothesis: {hypothesis_text}"
inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=4)
    decoded = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"output": decoded}
