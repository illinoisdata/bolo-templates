{% set repo_id = repo_id | default("Systran/faster-whisper-large-v3") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set task = task | default('transcribe') %}
{% set beam_size = beam_size | default(1) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"
beam_size = {{ beam_size }}

import os
import tempfile
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel
from urllib.parse import urlparse
from urllib.request import urlretrieve

weights_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_config_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocabulary_path = hf_hub_download(repo_id=repo_id, filename="vocabulary.json")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    parsed = urlparse(audio_path)
    suffix = os.path.splitext(parsed.path)[1] or ".wav"
    local_audio_path = os.path.join(tempfile.gettempdir(), "input_audio" + suffix)
    urlretrieve(audio_path, local_audio_path)
    audio_path = local_audio_path

actual_device = "cpu"
model = WhisperModel(repo_id, device=actual_device, compute_type="int8")
segments, info = model.transcribe(audio_path, language=language, task=task, beam_size=beam_size)
transcript = "".join(segment.text for segment in segments).strip()

RESULT = {
    "text": transcript,
    "language": info.language,
    "language_probability": float(info.language_probability),
    "duration": float(info.duration),
}
