{% set device = "cuda:0" %}
{% set repo_id = "ChengsenWang/ChatTime-1-7B-Chat" %}
{% set prompt = "Forecast the next 24 steps of the time series based on historical context and describe the expected trend." %}
{% set max_new_tokens = 256 %}
{% set temperature = 0.2 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}
temperature = {{ temperature }}

from pathlib import Path

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer

model_kwargs = {"torch_dtype": torch.bfloat16} if "cuda" in device else {}
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForCausalLM.from_pretrained(repo_id, **model_kwargs)
model.to(device)

tokenized = tokenizer(prompt, return_tensors="pt")
input_ids = tokenized["input_ids"].to(device)
attention_mask = tokenized["attention_mask"].to(device)

generated_tokens = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    max_new_tokens=int(max_new_tokens),
    temperature=float(temperature),
)

generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
