{% set repo_id = "SZTAKI-HLT/hubert-base-cc" %}
{% set device = "cuda:0" %}
{% set text_input = "Ez egy példamondat a modellhez." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from pathlib import Path
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=512,
)
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state.cpu()
RESULT = {"last_hidden_state": last_hidden_state}
