{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-en-ar") %}
{% set source_text = source_text | default(["Hello world!", ">>ara<< I can't help you because I'm busy."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = {{ source_text | tojson }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model_inputs = tokenizer(source_text, return_tensors="pt", padding=True, truncation=True)
model_inputs = {key: value.to(device) for key, value in model_inputs.items()}
generated_tokens = model.generate(**model_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
