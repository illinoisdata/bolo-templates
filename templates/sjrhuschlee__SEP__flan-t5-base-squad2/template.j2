{% set question = question | default('Where do I live?') %}
{% set context = context | default('My name is Sarah and I live in London.') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sjrhuschlee/flan-t5-base-squad2") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
added_tokens_file = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

local_dir = os.path.dirname(model_file)

tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(local_dir)
model.to(device)
model.eval()

cls_token = tokenizer.cls_token or ""
if cls_token:
    q = f"{cls_token}{question}"
else:
    q = question

inputs = tokenizer(q, context, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

all_tokens = tokenizer.convert_ids_to_tokens(inputs["input_ids"][0].tolist())
answer_tokens = all_tokens[start_idx:end_idx + 1]
answer = tokenizer.decode(tokenizer.convert_tokens_to_ids(answer_tokens), skip_special_tokens=True).strip()
score = float((outputs.start_logits[0, start_idx] + outputs.end_logits[0, end_idx]).item())

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx, "score": score}
