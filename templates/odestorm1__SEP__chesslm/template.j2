{% set repo_id = repo_id | default("odestorm1/chesslm") %}
{% set device = device | default("cuda:0") %}
{% set fen = fen | default('r1bqkbnr/pppp1ppp/2n5/4p3/1P6/5NP1/P1PPP1BP/RNBQK2R b KQkq - 1 3') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
fen = "{{ fen }}"

import json
import torch
import torch.nn as nn
from safetensors.torch import load_file
from huggingface_hub import hf_hub_download


class ChessLMEncoder(nn.Module):
    def __init__(self, d_model, dim_feedforward, dropout, nhead, num_layers):
        super().__init__()
        self.d_model = d_model
        self.piece_embed = nn.Embedding(14, d_model)
        self.square_embed = nn.Embedding(64, d_model)
        self.turn_embed = nn.Embedding(2, d_model)
        enc_layer = nn.TransformerEncoderLayer(
            d_model=d_model,
            nhead=nhead,
            dim_feedforward=dim_feedforward,
            dropout=dropout,
            batch_first=True,
            activation="gelu",
            norm_first=True,
        )
        self.transformer = nn.TransformerEncoder(enc_layer, num_layers=num_layers)
        self.norm = nn.LayerNorm(d_model)
        self.head = nn.Linear(d_model, d_model)

    def forward(self, piece_ids, turn_ids):
        bsz = piece_ids.shape[0]
        squares = torch.arange(64, device=piece_ids.device).unsqueeze(0).expand(bsz, -1)
        x = self.piece_embed(piece_ids) + self.square_embed(squares) + self.turn_embed(turn_ids).unsqueeze(1)
        x = self.transformer(x)
        x = self.norm(x)
        pooled = x.mean(dim=1)
        return self.head(pooled)


piece_to_id = {
    '.': 0,
    'P': 1, 'N': 2, 'B': 3, 'R': 4, 'Q': 5, 'K': 6,
    'p': 7, 'n': 8, 'b': 9, 'r': 10, 'q': 11, 'k': 12,
    'M': 13,
}


def parse_fen(fen_str):
    board_str, side_to_move, *_ = fen_str.split()
    rows = board_str.split('/')
    pieces = []
    for row in rows:
        for ch in row:
            if ch.isdigit():
                pieces.extend(['.'] * int(ch))
            else:
                pieces.append(ch)
    piece_ids = torch.tensor([piece_to_id.get(p, 0) for p in pieces], dtype=torch.long).unsqueeze(0)
    turn_id = torch.tensor([0 if side_to_move == 'w' else 1], dtype=torch.long)
    return piece_ids, turn_id


weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
config = json.load(open(config_path))

device_t = torch.device("cpu")
model = ChessLMEncoder(
    d_model=config["d_model"],
    dim_feedforward=config["dim_feedforward"],
    dropout=config["dropout"],
    nhead=config["nhead"],
    num_layers=config["num_layers"],
)
state_dict = load_file(weights_path)
model.load_state_dict(state_dict, strict=False)
model.to(device_t)
model.eval()

piece_ids, turn_id = parse_fen(fen)
piece_ids = piece_ids.to(device_t)
turn_id = turn_id.to(device_t)

with torch.no_grad():
    embedding = model(piece_ids, turn_id)

RESULT = {"embedding": embedding.squeeze(0).detach().cpu().tolist()}
