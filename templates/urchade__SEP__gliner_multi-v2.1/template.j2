{% set repo_id = repo_id | default("urchade/gliner_multi-v2.1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Cristiano Ronaldo dos Santos Aveiro (Portuguese pronunciation: [kɾiʃˈtjɐnu ʁɔˈnaldu]; born 5 February 1985) is a Portuguese professional footballer who plays as a forward for and captains both Saudi Pro League club Al Nassr and the Portugal national team.') %}
{% set labels = labels | default(['person', 'award', 'date', 'competitions', 'teams']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
labels = {{ labels }}

from gliner import GLiNER

model = GLiNER.from_pretrained(repo_id)
model = model.to(device)
entities = model.predict_entities(text, labels)

RESULT = {"entities": entities}
