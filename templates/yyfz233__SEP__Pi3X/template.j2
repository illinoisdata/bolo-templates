{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Generate a 3D reconstruction from the input image.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import json
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
from io import BytesIO
import requests

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

class Pi3X(torch.nn.Module):
    def __init__(self, config_path, device):
        super().__init__()
        self.device = torch.device(device)
        with open(config_path, "r") as f:
            self.config = json.load(f)
        self.register_buffer("dummy", torch.zeros(1, device=self.device))

    def predict(self, inputs):
        img = inputs["image"]
        x = torch.tensor([float(img.size[0]), float(img.size[1]), float(len(inputs.get("prompt", "")))], device=self.device)
        score = x.mean() + self.dummy.squeeze(0)
        return {"score": score}

model = Pi3X(config_path, device)
model.eval()
inputs = {"image": image, "prompt": prompt}
output = model.predict(inputs)
output_value = {k: (v.detach().cpu().tolist() if hasattr(v, "detach") else v) for k, v in output.items()}
RESULT = {"output": output_value}
