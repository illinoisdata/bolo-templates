{% set repo_id = repo_id | default("timm/deit_base_distilled_patch16_384.fb_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}

task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)

image = Image.open(input_image).convert("RGB")

predictions = pipe(image)

RESULT = {"predictions": predictions}
