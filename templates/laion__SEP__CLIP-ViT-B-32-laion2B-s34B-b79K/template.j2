{% set repo_id = repo_id | default("laion/CLIP-ViT-B-32-laion2B-s34B-b79K") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set candidate_labels = candidate_labels | default(['playing music', 'playing sports']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
candidate_labels = {{ candidate_labels }}

import os
from PIL import Image
import torch
from transformers import CLIPModel, CLIPProcessor
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

device_obj = torch.device(device)

if str(image).startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image)).convert("RGB")
else:
    image = Image.open(image).convert("RGB")

processor = CLIPProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = CLIPModel.from_pretrained(os.path.dirname(config_path), local_files_only=True)
state_dict = torch.load(model_path, map_location="cpu")
state_dict.pop("text_model.embeddings.position_ids", None)
state_dict.pop("vision_model.embeddings.position_ids", None)
model.load_state_dict(state_dict, strict=False)
model.to(device_obj)
model.eval()

inputs = processor(text=candidate_labels, images=image, return_tensors="pt", padding=True)
inputs = {k: v.to(device_obj) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits_per_image = outputs.logits_per_image
    probs = logits_per_image.softmax(dim=1)[0]

scores = probs.detach().cpu().tolist()
result = sorted(
    [{"label": label, "score": score} for label, score in zip(candidate_labels, scores)],
    key=lambda x: x["score"],
    reverse=True,
)

RESULT = {"output": result}
