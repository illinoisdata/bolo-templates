{% set repo_id = repo_id | default("dbmdz/bert-base-turkish-128k-uncased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Merhaba, nasılsın?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = outputs.pooler_output

RESULT = {"last_hidden_state": last_hidden_state, "pooler_output": pooler_output}
