{% set repo_id = repo_id | default("timm/swin_tiny_patch4_window7_224.ms_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
preprocessed_image = Image.open(input_image).convert("RGB")
predictions = pipe(preprocessed_image)
RESULT = {"predictions": predictions}
