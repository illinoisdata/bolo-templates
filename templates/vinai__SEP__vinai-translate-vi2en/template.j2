{% set repo_id = "vinai/vinai-translate-vi2en" %}
{% set device = "cuda:0" %}
{% set input_text = "Việt Nam là một đất nước xinh đẹp." %}
{% set max_length = 1024 %}
{% set num_beams = 5 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import MBartTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = MBartTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
outputs = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(outputs, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
