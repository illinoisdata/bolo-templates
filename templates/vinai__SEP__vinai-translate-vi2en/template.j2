{% set repo_id = repo_id | default("vinai/vinai-translate-vi2en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Xin chào, bạn khỏe không?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import MBartForConditionalGeneration, MBart50TokenizerFast
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")

model_dir = __import__('os').path.dirname(model_path)

tokenizer = MBart50TokenizerFast(vocab_file=spm_path, src_lang="vi_VN", tgt_lang="en_XX")
model = MBartForConditionalGeneration.from_pretrained(model_dir).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
forced_bos_token_id = tokenizer.lang_code_to_id["en_XX"]

with torch.no_grad():
    generated_tokens = model.generate(**inputs, forced_bos_token_id=forced_bos_token_id, num_beams=5, max_length=128)

output_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
