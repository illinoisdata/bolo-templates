{% set repo_id = repo_id | default("persiannlp/mt5-large-parsinlu-translation_en_fa") %}
{% set device = device | default("cuda:0") %}
{% set input_string = input_string | default("Praise be to Allah, the Cherisher and Sustainer of the worlds;") %}
{% set max_length = max_length | default(100) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_string = "{{ input_string }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(input_string, return_tensors="pt").to(device)

# Run inference
generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

# Post-process & build RESULT dict
translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
RESULT = {"translations": translations}
