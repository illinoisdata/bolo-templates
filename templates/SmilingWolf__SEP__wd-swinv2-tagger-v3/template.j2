{% set repo_id = repo_id | default("SmilingWolf/wd-swinv2-tagger-v3") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set threshold = threshold | default(0.35) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
threshold = float({{ threshold }})

import json
import numpy as np
import torch
import timm
from PIL import Image
from huggingface_hub import hf_hub_download
from timm.data import resolve_model_data_config, create_transform

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

if image_path.startswith(("http://", "https://")):
    from io import BytesIO
    import requests
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = timm.create_model(config["architecture"], pretrained=False, num_classes=config["num_classes"])
from safetensors.torch import load_file
state_dict = load_file(weights_path)
model.load_state_dict(state_dict)
model.eval().to(device)

data_cfg = resolve_model_data_config(model)
transform = create_transform(**data_cfg, is_training=False)

x = transform(image).unsqueeze(0).to(device)
with torch.no_grad():
    logits = model(x)
    probs = torch.sigmoid(logits)[0].detach().cpu().numpy()

indices = np.argsort(-probs)
top_50 = [(int(i), float(probs[i])) for i in indices[:50]]
selected = [(idx, score) for idx, score in top_50 if score >= threshold]

RESULT = {
    "probs": probs,
    "top_50": top_50,
    "selected": selected,
}
