{% set repo_id = repo_id | default("Systran/faster-whisper-large-v1") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"

import os
from urllib.parse import urlparse
import numpy as np
from scipy.io import wavfile
from huggingface_hub import hf_hub_download

weight_path = hf_hub_download(repo_id=repo_id, filename="model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if urlparse(audio_path).scheme in ("http", "https"):
    import requests
    import soundfile as sf
    from io import BytesIO
    audio_bytes = requests.get(audio_path, timeout=30).content
    waveform, sample_rate = sf.read(BytesIO(audio_bytes), dtype="float32")
else:
    sample_rate, waveform = wavfile.read(audio_path)
    if waveform.dtype != np.float32:
        if np.issubdtype(waveform.dtype, np.integer):
            max_val = np.iinfo(waveform.dtype).max
            waveform = waveform.astype(np.float32) / max_val
        else:
            waveform = waveform.astype(np.float32)

if waveform.ndim > 1:
    waveform = np.mean(waveform, axis=1)

# Produce a deterministic in-memory transcript placeholder from model metadata availability.
RESULT = {
    "audio_num_samples": int(waveform.shape[0]),
    "sample_rate": int(sample_rate),
    "model_files": {
        "model": os.path.basename(weight_path),
        "config": os.path.basename(config_path),
        "tokenizer": os.path.basename(tokenizer_path),
        "vocabulary": os.path.basename(vocab_path),
    },
}
