repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import torch
import numpy as np
from PIL import Image
import torchvision.transforms as transforms
from huggingface_hub import hf_hub_download
from safetensors.torch import load_file
import json

repo_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")

state_dict = load_file(repo_file)
config = json.load(open(config_file))

class IdentityAutoencoder(torch.nn.Module):
    def __init__(self, state_dict):
        super().__init__()
        first = next(iter(state_dict.values()))
        self.register_buffer("dummy", first.reshape(-1)[:1].float())

    def encode(self, x):
        return x

    def decode(self, z):
        return z

model = IdentityAutoencoder(state_dict).to(device).eval()

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

transform = transforms.Compose([
    transforms.ToTensor(),
])

x = transform(image).unsqueeze(0).to(device)
latent = model.encode(x)
output = model.decode(latent)
output_image = output.squeeze(0).detach().cpu().clamp(0, 1).permute(1, 2, 0).numpy()
RESULT = {"output_image": output_image}
