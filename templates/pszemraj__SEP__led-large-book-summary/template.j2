{% set repo_id = repo_id | default("pszemraj/led-large-book-summary") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The majority of available text summarization datasets include short-form source documents that lack long-range causal and temporal dependencies, and often contain strong layout and stylistic biases. While relevant, such datasets will offer limited challenges for future generations of text summarization systems. We address these issues by introducing BookSum, a collection of datasets for long-form narrative summarization.', true) %}
{% set max_length = max_length | default(64, true) %}
{% set min_length = min_length | default(8, true) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3, true) %}
{% set early_stopping = early_stopping | default(true, true) %}
{% set repetition_penalty = repetition_penalty | default(3.5, true) %}
{% set length_penalty = length_penalty | default(0.3, true) %}
{% set encoder_no_repeat_ngram_size = encoder_no_repeat_ngram_size | default(3, true) %}
{% set num_beams = num_beams | default(4, true) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
early_stopping = {{ early_stopping }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
encoder_no_repeat_ngram_size = {{ encoder_no_repeat_ngram_size }}
num_beams = {{ num_beams }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_file = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")

model = AutoModelForSeq2SeqLM.from_pretrained(
    os.path.dirname(config_file),
    local_files_only=True,
    torch_dtype=torch.float32,
).to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(
    os.path.dirname(tokenizer_file),
    local_files_only=True,
)

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=16384)
inputs = {k: v.to(device) for k, v in inputs.items()}

input_ids = inputs["input_ids"]
attention_mask = inputs["attention_mask"]
global_attention_mask = torch.zeros_like(attention_mask)
global_attention_mask[:, 0] = 1

summary_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    global_attention_mask=global_attention_mask,
    max_length=max_length,
    min_length=min_length,
    no_repeat_ngram_size=no_repeat_ngram_size,
    encoder_no_repeat_ngram_size=encoder_no_repeat_ngram_size,
    repetition_penalty=repetition_penalty,
    length_penalty=length_penalty,
    num_beams=num_beams,
    early_stopping=early_stopping,
)
summary_text = tokenizer.decode(summary_ids[0], skip_special_tokens=True)

RESULT = {"summary_text": summary_text}
