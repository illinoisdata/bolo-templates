{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("pszemraj/led-large-book-summary") %}
{% set input_text = input_text | default("LED applies sparse attention to condense lengthy documents for human consumption.") %}
{% set max_length = max_length | default(64) %}
{% set min_length = min_length | default(8) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set encoder_no_repeat_ngram_size = encoder_no_repeat_ngram_size | default(3) %}
{% set repetition_penalty = repetition_penalty | default(3.5) %}
{% set length_penalty = length_penalty | default(0.3) %}
{% set num_beams = num_beams | default(4) %}
{% set early_stopping_flag = early_stopping_flag | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}
encoder_no_repeat_ngram_size = {{ encoder_no_repeat_ngram_size }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
num_beams = {{ num_beams }}
early_stopping = {{ "True" if early_stopping_flag else "False" }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
device_obj = torch.device(device)
model = model.to(device_obj)

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=tokenizer.model_max_length,
)
input_ids = encoded_inputs["input_ids"].to(device_obj)
attention_mask = encoded_inputs["attention_mask"].to(device_obj)
global_attention_mask = torch.zeros_like(input_ids)
global_attention_mask[:, 0] = 1

generated_ids = model.generate(
    input_ids=input_ids,
    attention_mask=attention_mask,
    global_attention_mask=global_attention_mask,
    max_length=max_length,
    min_length=min_length,
    no_repeat_ngram_size=no_repeat_ngram_size,
    encoder_no_repeat_ngram_size=encoder_no_repeat_ngram_size,
    repetition_penalty=repetition_penalty,
    length_penalty=length_penalty,
    num_beams=num_beams,
    early_stopping=early_stopping,
)
summary_text = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)[0].strip()

RESULT = {"summary": summary_text}
