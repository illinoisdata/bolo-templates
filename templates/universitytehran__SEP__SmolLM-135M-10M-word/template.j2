{% set repo_id = repo_id | default("universitytehran/SmolLM-135M-10M-word") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Once upon a time') %}
{% set max_new_tokens = max_new_tokens | default(50) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Load tokenizer/model from repo. Use local downloaded file paths directly where appropriate.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        pad_token_id=tokenizer.eos_token_id,
        eos_token_id=tokenizer.eos_token_id,
    )

completed_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": completed_text}
