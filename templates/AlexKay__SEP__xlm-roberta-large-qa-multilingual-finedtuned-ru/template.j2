{% set repo_id = repo_id | default("AlexKay/xlm-roberta-large-qa-multilingual-finedtuned-ru") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Как зовут автора этого репозитория?') %}
{% set context = context | default('AlexKay/xlm-roberta-large-qa-multilingual-finedtuned-ru is a question answering model repository.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spm_path = hf_hub_download(repo_id=repo_id, filename="sentencepiece.bpe.model")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# tokenizer loads from local downloaded files via the repo directory derived from a downloaded file path
import os
repo_dir = os.path.dirname(config_path)

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(repo_dir)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    start_logits = outputs.start_logits
    end_logits = outputs.end_logits

start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

answer_ids = inputs["input_ids"][0, start_idx:end_idx + 1]
answer = tokenizer.decode(answer_ids, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
