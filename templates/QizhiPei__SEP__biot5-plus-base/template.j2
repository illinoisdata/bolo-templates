{% set repo_id = repo_id | default("QizhiPei/biot5-plus-base") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('Generate a concise biological summary of the following sequence: ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

# Load tokenizer and model on the requested device
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(
    repo_id,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=32,
        do_sample=False,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
