{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Stancld/longt5-tglobal-large-16384-pubmed-3k_steps") %}
{% set text_to_summarize = text_to_summarize | default("Anxiety affects quality of life in those living with Parkinson's disease more so than cognitive status, motor deficits, apathy, and depression.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_to_summarize = """{{ text_to_summarize }}"""
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    text_to_summarize,
    return_tensors="pt",
    truncation=True,
    max_length=4096,
)
inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(
    **inputs,
    max_length=512,
    num_beams=4,
    early_stopping=True,
)
decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
summary_text = decoded[0].strip()

RESULT = {"summary": summary_text}
