{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("DeepPavlov/distilrubert-base-cased-conversational") %}
{% set text_input = text_input | default("Привет, как у тебя дела?") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}

import json
from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    padding=True,
    max_length=max_length,
)
tokens = tokenizer.convert_ids_to_tokens(encoded_inputs["input_ids"][0])
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

last_hidden_state = outputs.last_hidden_state
pooled_embedding = last_hidden_state.mean(dim=1)[0].cpu().tolist()

RESULT = {
    "tokens": tokens,
    "pooled_embedding": pooled_embedding,
}
