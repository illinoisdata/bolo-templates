{% set repo_id = repo_id | default("DeepPavlov/distilrubert-base-cased-conversational") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Это очень интересный фильм.') %}
{% set text_pair = text_pair | default('Мне понравился этот фильм.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
text_pair = "{{ text_pair }}"

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, text_pair, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits.detach().cpu().tolist()
probs = torch.softmax(outputs.logits, dim=-1).detach().cpu().tolist()
pred_id = int(torch.tensor(logits).argmax(dim=-1).item())

RESULT = {"logits": logits, "probs": probs, "predicted_class_id": pred_id}
