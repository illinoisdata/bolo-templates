{% set repo_id = repo_id | default("OpenMed/OpenMed-ZeroShot-NER-Pharma-Large-459M") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Administration of metformin reduced glucose levels significantly.') %}
{% set labels = labels | default(['CHE']) %}
{% set threshold = threshold | default(0.5) %}
{% set flat_ner = flat_ner | default(True) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
labels = {{ labels }}
threshold = {{ threshold }}
flat_ner = {{ flat_ner }}

import torch
from gliner import GLiNER

model = GLiNER.from_pretrained(repo_id, proxies=None, resume_download=False)
model = model.to(device)
entities = model.predict_entities(text, labels, flat_ner=flat_ner, threshold=threshold)
RESULT = {"entities": entities}
