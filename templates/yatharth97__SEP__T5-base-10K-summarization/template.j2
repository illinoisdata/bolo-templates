{% set repo_id = repo_id | default("yatharth97/T5-base-10K-summarization") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('summarize: Apple reported strong quarterly revenue growth driven by services and wearables, while highlighting margin pressure from supply chain costs and foreign exchange headwinds.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Load tokenizer/model from repo files

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_config_path.rsplit("/", 1)[0],
    use_fast=False,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    weights_path.rsplit("/", 1)[0],
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_length=200,
        min_length=30,
        num_beams=4,
        length_penalty=2.0,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": output_text}
