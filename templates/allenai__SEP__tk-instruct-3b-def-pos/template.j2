{% set repo_id = repo_id | default("allenai/tk-instruct-3b-def-pos") %}
{% set device = device | default("cuda:0") %}
{% set instruction_text = instruction_text | default("Definition: return the currency of the given country. Now complete the following example - Input: India. Output:") %}
{% set max_length = max_length | default(64) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
instruction_text = "{{ instruction_text }}"
max_length = {{ max_length }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model_kwargs = {}
if "cuda" in device:
    model_kwargs["torch_dtype"] = torch.bfloat16

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, **model_kwargs).to(device)

inputs = tokenizer(instruction_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length)
generated_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
