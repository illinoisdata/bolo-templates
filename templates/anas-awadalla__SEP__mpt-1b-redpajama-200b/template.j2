{% set repo_id = repo_id | default("anas-awadalla/mpt-1b-redpajama-200b") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set trust_remote_code = trust_remote_code | default(true) %}

repo_id = {{ repo_id | tojson }}
model = {{ model | tojson }}
task = {{ task | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
trust_remote_code = {{ trust_remote_code }}

from transformers import pipeline
from transformers.modeling_utils import PreTrainedModel

def _safe_all_tied_weights_keys(self):
    tied_weights = getattr(self, "_tied_weights_keys", None)
    if tied_weights is None:
        return {}
    return tied_weights

PreTrainedModel.all_tied_weights_keys = property(_safe_all_tied_weights_keys)

pipe = pipeline(task=task, model=model, device=device, trust_remote_code=trust_remote_code)
RESULT = pipe(input_prompt)
