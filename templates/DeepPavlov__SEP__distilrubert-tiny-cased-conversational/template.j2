{% set text = ["Привет, как дела?"] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/DeepPavlov__SEP__distilrubert-tiny-cased-conversational" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text }}
output_dir = "{{ output_dir }}"

from transformers import AutoTokenizer, AutoModel
import torch
import numpy as np
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)

inputs = tokenizer(text, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
hidden_states = [h.detach().cpu().numpy() for h in outputs.hidden_states]
attentions = [a.detach().cpu().numpy() for a in outputs.attentions]

RESULT = {
    "last_hidden_state": last_hidden_state,
    "hidden_states": hidden_states,
    "attentions": attentions,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    np.save(os.path.join(output_dir, "last_hidden_state.npy"), last_hidden_state)
    np.save(os.path.join(output_dir, "hidden_states.npy"), hidden_states)
    np.save(os.path.join(output_dir, "attentions.npy"), attentions)