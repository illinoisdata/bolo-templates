{% set device = "cuda:0" %}
{% set repo_id = "allenai/biomed_roberta_base" %}
{% set text = "Clinical note: A patient exhibits persistent cough and fever." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import json
from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

hidden_states = outputs.last_hidden_state
pooled = hidden_states.mean(dim=1).squeeze()
pooled_embedding = pooled.detach().cpu().tolist()

RESULT = {"pooled_embedding": pooled_embedding}
