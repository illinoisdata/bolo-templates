{% set repo_id = repo_id | default("ggml-org/gemma-1.1-2b-it-Q8_0-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("gemma-1.1-2b-it.Q8_0.gguf") %}
{% set prompt = prompt | default("The meaning to life and the universe is") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(
    model_path=model_path,
    n_ctx=2048,
    n_threads=4,
    n_gpu_layers=-1 if str(device).startswith("cuda") else 0,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=128,
    temperature=0.7,
    top_p=0.95,
    stop=["</s>"]
)

RESULT = {"output": output["choices"][0]["text"]}
