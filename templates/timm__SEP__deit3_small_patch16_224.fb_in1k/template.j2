{% set repo_id = repo_id | default("timm/deit3_small_patch16_224.fb_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
task = "{{ task }}"
input_data = "{{ input_data }}"

import os
import sys

_cuda_lib_paths = [
    "/workspace/.pip/nvidia/cu13/lib",
    "/workspace/.pip/torchvision.libs",
]
_existing_ld = os.environ.get("LD_LIBRARY_PATH", "")
_existing_paths = [path for path in _existing_ld.split(":") if path]
if any(path not in _existing_paths for path in _cuda_lib_paths):
    _new_ld = ":".join(_cuda_lib_paths)
    if _existing_ld:
        _new_ld = f"{_new_ld}:{_existing_ld}"
    os.environ["LD_LIBRARY_PATH"] = _new_ld
    os.execve(sys.executable, [sys.executable, *sys.argv], os.environ)

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(input_data)
