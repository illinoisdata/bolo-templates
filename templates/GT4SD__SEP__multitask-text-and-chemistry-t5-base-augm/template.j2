{% set repo_id = repo_id | default("GT4SD/multitask-text-and-chemistry-t5-base-augm") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("summarize: The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(200) %}
{% set num_beams = num_beams | default(4) %}
{% set do_sample = do_sample | default(false) %}
{% set temperature = temperature | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams, do_sample=do_sample, temperature=temperature)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
