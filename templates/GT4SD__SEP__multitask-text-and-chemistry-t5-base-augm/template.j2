{% set repo_id = "GT4SD/multitask-text-and-chemistry-t5-base-augm" %}
{% set device = "cuda:0" %}
{% set input_text = "summarize: The quick brown fox jumps over the lazy dog." %}
{% set max_length = 200 %}
{% set num_beams = 4 %}
{% set do_sample = false %}
{% set temperature = 1.0 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams, do_sample=do_sample, temperature=temperature)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"generated_text": generated_text}
