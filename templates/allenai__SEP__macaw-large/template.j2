{% set repo_id = repo_id | default("allenai/macaw-large") %}
{% set device = device | default("cuda:0") %}
{% set prompt_text = prompt_text | default("What is the color of a cloudy sky?") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
prompt_text = {{ prompt_text | tojson }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)

inputs = tokenizer(prompt_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)
answer = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"answer": answer}
