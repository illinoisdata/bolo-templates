{% set repo_id = repo_id | default("QizhiPei/biot5-base") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default("What is the function of hemoglobin?") %}
{% set max_length = max_length | default(50) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(prompt, return_tensors="pt").to(device)

generated_ids = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

generated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
