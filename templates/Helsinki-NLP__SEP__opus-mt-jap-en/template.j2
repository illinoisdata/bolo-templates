{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-jap-en") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('こんにちは、元気ですか？') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer/model from local downloaded repo files
local_model_dir = "/".join(weights_path.split("/")[:-1])
tokenizer = AutoTokenizer.from_pretrained(local_model_dir)
model = AutoModelForSeq2SeqLM.from_pretrained(local_model_dir).to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6, max_length=128)

translated_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
