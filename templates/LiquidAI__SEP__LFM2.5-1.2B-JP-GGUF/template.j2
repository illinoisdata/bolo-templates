{% set repo_id = repo_id | default("LiquidAI/LFM2.5-1.2B-JP-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default("LFM2.5-1.2B-JP-Q4_K_M.gguf") %}
{% set prompt = prompt | default("日本語で、LFM2.5モデルの特徴を簡潔に説明してください。") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if device.startswith("cuda") else 0
llm = Llama(
    model_path=model_path,
    n_ctx=512,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

output = llm(
    prompt,
    max_tokens=128,
    temperature=0.7,
    top_p=0.95,
    repeat_penalty=1.05,
    stop=["</s>"],
)

RESULT = {"output": output["choices"][0]["text"]}
