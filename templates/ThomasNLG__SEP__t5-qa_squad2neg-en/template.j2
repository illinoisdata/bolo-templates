{% set repo_id = repo_id | default("ThomasNLG/t5-qa_squad2neg-en") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Who was Louis 14?') %}
{% set context = context | default('Louis 14 was a French King.') %}
{% set max_new_tokens = max_new_tokens | default(32) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = T5Tokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id)
model = model.to(device)
model.eval()

input_text = question + "  " + context
inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

answer = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"answer": answer}
