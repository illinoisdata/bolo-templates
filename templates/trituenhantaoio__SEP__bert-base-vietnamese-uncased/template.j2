{% set input_text = "Xin chào! Đây là một đoạn văn bản mẫu để phân loại." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/trituenhantaoio__SEP__bert-base-vietnamese-uncased" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

logits = outputs.logits
logits_list = logits.squeeze(0).tolist()
predicted_label = int(logits.argmax(dim=-1).squeeze().item())

RESULT = {
    "logits": logits_list,
    "predicted_label": predicted_label,
}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "result.json").write_text(json.dumps(RESULT, ensure_ascii=False, indent=2))