{% set repo_id = repo_id | default("ModelSpace/GemmaX2-28-2B-v0.1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Translate this from Chinese to English:\nChinese: 我爱机器翻译\nEnglish:") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import os
import torch
from transformers import AutoModelForCausalLM, AutoTokenizer
from huggingface_hub import hf_hub_download

# Download essential files only; from_pretrained will use the local cache directory
model_file_1 = hf_hub_download(repo_id=repo_id, filename="model-00001-of-00002.safetensors")
model_file_2 = hf_hub_download(repo_id=repo_id, filename="model-00002-of-00002.safetensors")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")

local_dir = os.path.dirname(model_file_1)

tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(local_dir, torch_dtype=torch.bfloat16)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.inference_mode():
    outputs = model.generate(**inputs, max_new_tokens=50)

RESULT = {"text": tokenizer.decode(outputs[0], skip_special_tokens=True)}
