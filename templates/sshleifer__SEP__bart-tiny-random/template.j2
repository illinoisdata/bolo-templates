{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("sshleifer/bart-tiny-random") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(64) %}
{% set min_length = min_length | default(10) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import os
import torch

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=1024,
)
encoded_inputs = encoded_inputs.to(device)

with torch.no_grad():
    generated_ids = model.generate(
        **encoded_inputs,
        max_length=max_length,
        min_length=min_length,
        num_beams=num_beams,
        early_stopping=True,
    )

decoded_summary = tokenizer.batch_decode(
    generated_ids,
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"summary": decoded_summary}
