{% set repo_id = repo_id | default("deepset/bert-base-cased-squad2") %}
{% set device = device | default("cuda:0") %}
{% set question = question|default('Why is model conversion important?') %}
{% set context = context|default('The option to convert models between FARM and transformers gives freedom to the user and let people easily switch between frameworks.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

import torch
from transformers import AutoModelForQuestionAnswering, AutoTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model = AutoModelForQuestionAnswering.from_pretrained(repo_id)
model.to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

start_idx = int(torch.argmax(outputs.start_logits, dim=-1).item())
end_idx = int(torch.argmax(outputs.end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx
answer_ids = inputs["input_ids"][0][start_idx : end_idx + 1]
answer_text = tokenizer.decode(answer_ids, skip_special_tokens=True)

RESULT = {"answer": answer_text, "start_index": start_idx, "end_index": end_idx}
