{% set repo_id = repo_id | default("lmstudio-community/Qwen3-1.7B-MLX-8bit") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('hello') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = {{ prompt | tojson }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForCausalLM, AutoConfig

config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
model_path = hf_hub_download(repo_id=repo_id, filename='model.safetensors')
hf_hub_download(repo_id=repo_id, filename='tokenizer.json')

model_dir = os.path.dirname(model_path)
config = AutoConfig.from_pretrained(model_dir)
for key in ['quantization', 'quantization_config']:
    if hasattr(config, key):
        delattr(config, key)

tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(
    model_dir,
    config=config,
    torch_dtype=torch.float32,
    low_cpu_mem_usage=True,
    ignore_mismatched_sizes=True,
)
model = model.to(device)

if tokenizer.chat_template is not None:
    messages = [{"role": "user", "content": prompt}]
    prompt = tokenizer.apply_chat_template(messages, add_generation_prompt=True, tokenize=False)

inputs = tokenizer(prompt, return_tensors='pt').to(device)
output_ids = model.generate(**inputs, max_new_tokens=32, do_sample=False)
output = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output}
