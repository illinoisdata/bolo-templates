{% set repo_id = repo_id | default("timm/caformer_b36.sail_in22k_ft_in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set image_input = image_input | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
image_input = {{ image_input | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

image = Image.open(image_input).convert("RGB")

RESULT = pipe(image)
RESULT = {"predictions": RESULT}
