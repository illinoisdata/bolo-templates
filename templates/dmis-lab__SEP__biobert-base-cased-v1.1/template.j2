{% set repo_id = repo_id | default("dmis-lab/biobert-base-cased-v1.1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Biology researchers study gene expression in cancer cells.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import BertTokenizer, BertModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = BertTokenizer(vocab_file=vocab_path, do_lower_case=False)
model = BertModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
