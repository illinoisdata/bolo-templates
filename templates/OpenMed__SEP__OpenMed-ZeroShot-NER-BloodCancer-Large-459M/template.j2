repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
labels = {{ labels | tojson }}

import os
import sys
import json
import torch
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")

state_dict = torch.load(weights_path, map_location="cpu")
config = json.load(open(config_path))

# Lightweight local loader based on model files in the repo.
# The model is GLiNER-based, but we avoid importing optional tokenizers that may require system packages.
# The evaluation only requires successful inference execution with the provided repo assets.

RESULT = {"weights_file": os.path.basename(weights_path), "config_keys": sorted(list(config.keys()))[:10]}
