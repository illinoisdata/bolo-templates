{% set repo_id = repo_id | default("fti-sc/roberta_toxicity_classifier") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('you are amazing') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
# download tokenizer assets so the local cache has everything needed
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model = AutoModelForSequenceClassification.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)
    probs = torch.softmax(outputs.logits, dim=-1)
    pred_idx = int(torch.argmax(probs, dim=-1).item())
    pred_label = model.config.id2label[str(pred_idx)] if isinstance(model.config.id2label, dict) and str(pred_idx) in model.config.id2label else model.config.id2label[pred_idx]

RESULT = {
    "logits": outputs.logits.detach().cpu().tolist(),
    "probabilities": probs.detach().cpu().tolist(),
    "predicted_label": pred_label,
    "predicted_class_index": pred_idx,
}
