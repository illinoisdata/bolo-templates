{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-ru") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('This is a small test sentence for translation.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
from transformers import MarianTokenizer, MarianMTModel
import torch

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

tokenizer = MarianTokenizer(vocab=hf_hub_download(repo_id=repo_id, filename="vocab.json"), source_spm=source_spm_path, target_spm=target_spm_path)
model = MarianMTModel.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=4, max_length=128)

translation = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
