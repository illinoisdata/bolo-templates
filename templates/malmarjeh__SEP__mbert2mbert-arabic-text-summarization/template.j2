{% set text = text | default('شهدت مدينة طرابلس، مساء أمس الأربعاء، احتجاجات شعبية وأعمال شغب لليوم الثالث على التوالي، وذلك بسبب تردي الوضع المعيشي والاقتصادي. واندلعت مواجهات عنيفة وعمليات كر وفر ما بين الجيش اللبناني والمحتجين استمرت لساعات، إثر محاولة فتح الطرقات المقطوعة، ما أدى إلى إصابة العشرات من الطرفين.') %}
{% set max_length = max_length | default(200) %}
{% set num_beams = num_beams | default(3) %}
{% set repetition_penalty = repetition_penalty | default(3.0) %}
{% set length_penalty = length_penalty | default(1.0) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(3) %}
{% set repo_id = repo_id | default("malmarjeh/mbert2mbert-arabic-text-summarization") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
repetition_penalty = {{ repetition_penalty }}
length_penalty = {{ length_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from arabert.preprocess import ArabertPreprocessor

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, fix_mistral_regex=True)
preprocessor = ArabertPreprocessor(model_name="")
text = preprocessor.preprocess(text)
inputs = tokenizer(text, return_tensors="pt", truncation=True).to(device)
output_ids = model.generate(**inputs, num_beams=num_beams, repetition_penalty=repetition_penalty, max_length=max_length, length_penalty=length_penalty, no_repeat_ngram_size=no_repeat_ngram_size, pad_token_id=tokenizer.eos_token_id)
output = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output}
