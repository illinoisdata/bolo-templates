{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = input_text | default("AllenAI's LED is designed to summarize and answer questions over long documents with 16K tokens of context. Provide a concise summary of the input content.") %}
{% set input_max_length = input_max_length | default(4096) %}
{% set max_new_tokens = max_new_tokens | default(256) %}
{% set num_beams = num_beams | default(4) %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/allenai__SEP__led-large-16384") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
input_max_length = {{ input_max_length }}
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(torch_device)

tokenized_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    max_length=input_max_length,
)
tokenized_inputs = {key: value.to(torch_device) for key, value in tokenized_inputs.items()}

generated_ids = model.generate(
    **tokenized_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
)
summary_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary_text}

if __name__ == "__main__":
    output_directory = Path(output_dir)
    output_directory.mkdir(parents=True, exist_ok=True)
    summary_path = output_directory / "summary.txt"
    summary_path.write_text(RESULT["summary"], encoding="utf-8")