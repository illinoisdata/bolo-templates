{% set repo_id = repo_id | default("microsoft/layoutlmv3-base-chinese") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set text = text | default('请识别这张文档图片中的关键信息。') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
text = "{{ text }}"

import os
import requests
import torch
from PIL import Image
from transformers import AutoProcessor, AutoModel
from huggingface_hub import hf_hub_download

runtime_device = device if torch.cuda.is_available() and str(device).startswith("cuda") else "cpu"
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_path = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
processor = AutoProcessor.from_pretrained(os.path.dirname(preprocessor_path), local_files_only=True)
model = AutoModel.from_pretrained(os.path.dirname(config_path), local_files_only=True, torch_dtype=torch.float32)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict = {k: v for k, v in state_dict.items() if k != "layoutlmv3.embeddings.position_ids"}
model.load_state_dict(state_dict, strict=False)
model.to(runtime_device)
model.eval()

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

inputs = processor(image, text=text, return_tensors="pt", padding="max_length", truncation=True)
inputs = {k: v.to(runtime_device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu().numpy()
RESULT = {"last_hidden_state": last_hidden_state}
