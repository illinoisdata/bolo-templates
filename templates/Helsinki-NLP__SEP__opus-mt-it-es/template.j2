{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-it-es" %}
{% set input_text = "Ciao, come stai?" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-it-es" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from transformers import MarianTokenizer, AutoModelForSeq2SeqLM
import torch

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs)

decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
translation_text = decoded[0]

RESULT = {"translation_text": translation_text}

if __name__ == "__main__":
    import os
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translation.txt"), "w", encoding="utf-8") as f:
        f.write(RESULT["translation_text"])