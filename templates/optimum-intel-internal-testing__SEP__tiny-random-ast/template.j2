{% set repo_id = repo_id | default("optimum-intel-internal-testing/tiny-random-ast") %}
{% set device = device | default("cuda:0") %}
{% set sample_rate = sample_rate | default(16000) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
sample_rate = {{ sample_rate }}

import os
import requests
import torch
import numpy as np
from scipy.io import wavfile
from scipy.signal import resample_poly
from huggingface_hub import hf_hub_download
from transformers import ASTModel, ASTConfig, ASTFeatureExtractor

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
preprocessor_file = hf_hub_download(repo_id=repo_id, filename="preprocessor_config.json")

feature_extractor = ASTFeatureExtractor.from_pretrained(os.path.dirname(preprocessor_file))
config = ASTConfig.from_pretrained(os.path.dirname(config_file))
model = ASTModel.from_pretrained(os.path.dirname(model_file), config=config)
model.to(device)
model.eval()

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    audio_bytes = requests.get(audio_path).content
    from io import BytesIO
    sr, audio = wavfile.read(BytesIO(audio_bytes))
else:
    sr, audio = wavfile.read(audio_path)

if audio.ndim > 1:
    audio = audio.mean(axis=1)

if audio.dtype != np.float32:
    if np.issubdtype(audio.dtype, np.integer):
        max_val = np.iinfo(audio.dtype).max
        audio = audio.astype(np.float32) / max_val
    else:
        audio = audio.astype(np.float32)

if sr != sample_rate:
    gcd = np.gcd(sr, sample_rate)
    audio = resample_poly(audio, sample_rate // gcd, sr // gcd)
    sr = sample_rate

inputs = feature_extractor(audio, sampling_rate=sample_rate, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

RESULT = {"last_hidden_state": outputs.last_hidden_state.detach().cpu().numpy()}
