{% set repo_id = repo_id | default("OpenMed/OpenMed-ZeroShot-NER-Pathology-Small-166M") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Early detection of breast cancer improves survival rates.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
threshold = {{ threshold | default(0.5) }}
labels = {{ labels | default(['DISEASE']) }}

import json
import os
from huggingface_hub import hf_hub_download
import torch
from gliner import GLiNER

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
_ = hf_hub_download(repo_id=repo_id, filename="spm.model")

model = GLiNER.from_pretrained(repo_id)
model = model.to(device)

entities = model.predict_entities(text, labels, flat_ner=True, threshold=threshold)
RESULT = {"entities": entities}
