{% set max_length = max_length | default(512) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_texts = {{ source_texts | tojson }}
max_length = {{ max_length }}

from os import makedirs
from os.path import join

import sentencepiece as spm
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoModelForSeq2SeqLM

spiece_model_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
processor = spm.SentencePieceProcessor(model_file=spiece_model_path)

pad_token_id = 0
bos_token_id = 0
eos_token_id = 1

def encode_batch(texts):
    sequences = []
    for text in texts:
        tokens = processor.encode(text, out_type=int)
        trimmed = tokens[: max_length - 1]
        trimmed.append(eos_token_id)
        sequences.append(trimmed)
    max_tokens = max(len(sequence) for sequence in sequences)
    batch_input = torch.full(
        (len(sequences), max_tokens),
        pad_token_id,
        dtype=torch.long,
        device=device,
    )
    attention = torch.zeros_like(batch_input)
    for idx, sequence in enumerate(sequences):
        length = len(sequence)
        batch_input[idx, :length] = torch.tensor(sequence, dtype=torch.long, device=device)
        attention[idx, :length] = 1
    return batch_input, attention

def decode_sequences(batch_ids):
    decoded = []
    for ids in batch_ids:
        filtered = []
        for token_id in ids:
            if token_id == eos_token_id:
                break
            if token_id == pad_token_id:
                continue
            filtered.append(token_id)
        decoded.append(processor.decode(filtered).strip())
    return decoded

tokenizer_inputs, tokenizer_masks = encode_batch(source_texts)

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

generated_ids = model.generate(
    input_ids=tokenizer_inputs,
    attention_mask=tokenizer_masks,
    max_length=max_length,
)

decoded = decode_sequences(generated_ids.cpu().tolist())

RESULT = {"translations": decoded}
