{% set input_text = "Tôi thích khám phá trí tuệ nhân tạo." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/vinai__SEP__vinai-translate-vi2en-v2" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenizer.src_lang = "vi_VN"
encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

forced_bos = tokenizer.lang_code_to_id["en_XX"]
with torch.inference_mode():
    generated_tokens = model.generate(
        **encoded_inputs,
        forced_bos_token_id=forced_bos,
        max_length=512,
        num_beams=4,
    )

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(translation, encoding="utf-8")