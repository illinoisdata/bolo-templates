{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("vinai/vinai-translate-vi2en-v2") %}
{% set input_text = input_text | default("Tôi thích khám phá trí tuệ nhân tạo.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenizer.src_lang = "vi_VN"
encoded_inputs = tokenizer(input_text, return_tensors="pt")
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

forced_bos = tokenizer.lang_code_to_id["en_XX"]
with torch.inference_mode():
    generated_tokens = model.generate(
        **encoded_inputs,
        forced_bos_token_id=forced_bos,
        max_length=512,
        num_beams=4,
    )

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
