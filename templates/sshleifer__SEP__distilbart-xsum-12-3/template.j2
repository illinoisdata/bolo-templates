{% set input_text = "Scientists have shared a detailed report describing how climate change is altering migratory patterns of birds across the Northern Hemisphere, prompting conservationists to call for emergency action to protect key breeding habitats." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = """{{ input_text }}"""

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device_obj = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device_obj)

inputs = tokenizer(
    input_text,
    return_tensors="pt",
    truncation=True,
    padding=True,
)
inputs = {name: tensor.to(device_obj) for name, tensor in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=128,
    num_beams=4,
    early_stopping=True,
)
summary = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"summary": summary}

if __name__ == "__main__":
    path = Path(output_dir)
    path.mkdir(parents=True, exist_ok=True)
    (path / "summary.txt").write_text(RESULT["summary"], encoding="utf-8")