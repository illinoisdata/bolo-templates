{% set repo_id = repo_id | default("sshleifer/distilbart-xsum-12-3") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The Tower of London is a historic castle located on the north bank of the River Thames in central London. It was founded in 1066 as part of the Norman Conquest of England and has served as a royal palace, prison, armory, and treasury.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

# Load tokenizer/model directly from the downloaded local files.
tokenizer = AutoTokenizer.from_pretrained(
    vocab_path.rsplit('/', 1)[0],
    use_fast=False,
)
model = BartForConditionalGeneration.from_pretrained(
    weights_path.rsplit('/', 1)[0],
    torch_dtype=torch.float32,
)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=6,
        max_length=62,
        min_length=11,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )
summary = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"summary": summary}
