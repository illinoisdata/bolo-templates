{% set input_text = "The quick brown fox jumps over the lazy dog." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-el" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

tokenized = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
model_inputs = {name: tensor.to(device) for name, tensor in tokenized.items()}

generated_tokens = model.generate(**model_inputs, max_length=max_length, num_beams=num_beams)
decoded_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_text[0] if decoded_text else ""

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / "translation.txt").write_text(RESULT["translation"], encoding="utf-8")