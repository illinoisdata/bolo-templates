{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-el") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

tokenized = tokenizer(input_text, return_tensors="pt", truncation=True, padding=True)
model_inputs = {name: tensor.to(device) for name, tensor in tokenized.items()}

generated_tokens = model.generate(**model_inputs, max_length=max_length, num_beams=num_beams)
decoded_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_text[0] if decoded_text else ""

RESULT = {"translation": translation}
