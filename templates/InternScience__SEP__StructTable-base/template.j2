{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/InternScience__SEP__StructTable-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
table_image_path = "{{ table_image_path }}"
output_dir = "{{ output_dir }}"

from transformers import AutoProcessor, Pix2StructForConditionalGeneration
from PIL import Image
import requests
import os
from io import BytesIO
import torch

processor = AutoProcessor.from_pretrained(repo_id)
model = Pix2StructForConditionalGeneration.from_pretrained(repo_id)
model.to(device)

if table_image_path.startswith("http://") or table_image_path.startswith("https://"):
    response = requests.get(table_image_path, timeout=10)
    response.raise_for_status()
    image = Image.open(BytesIO(response.content)).convert("RGB")
else:
    image = Image.open(table_image_path).convert("RGB")

inputs = processor(images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs)

latex_output = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"latex": latex_output}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "latex_output.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["latex"])