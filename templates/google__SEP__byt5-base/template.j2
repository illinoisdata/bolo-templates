{% set repo_id = repo_id | default("google/byt5-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Life is like a box of chocolates.') %}
{% set target_text = target_text | default('La vie est comme une boîte de chocolat.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
target_text = "{{ target_text }}"

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

model_inputs = tokenizer([input_text], return_tensors="pt")
labels = tokenizer([target_text], return_tensors="pt").input_ids
model_inputs = {k: v.to(device) for k, v in model_inputs.items()}
labels = labels.to(device)

with torch.no_grad():
    outputs = model(**model_inputs, labels=labels)
    loss = outputs.loss
    generated = model.generate(**model_inputs, max_new_tokens=64)
    decoded = tokenizer.batch_decode(generated, skip_special_tokens=True)

RESULT = {"loss": float(loss.item()), "generated_text": decoded}
