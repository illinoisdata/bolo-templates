{% set repo_id = repo_id | default("cointegrated/rut5-base-paraphraser") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Каждый охотник желает знать, где сидит фазан.') %}
{% set beams = beams | default(5) %}
{% set grams = grams | default(4) %}
{% set do_sample = do_sample | default(false) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
beams = {{ beams }}
grams = {{ grams }}
do_sample = {{ do_sample }}

import torch
from transformers import T5ForConditionalGeneration, T5Tokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

tokenizer = T5Tokenizer.from_pretrained(spiece_path, use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
max_size = int(inputs["input_ids"].shape[1] * 1.5 + 10)
with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        encoder_no_repeat_ngram_size=grams,
        num_beams=beams,
        max_length=max_size,
        do_sample=do_sample,
    )
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output": output_text}
