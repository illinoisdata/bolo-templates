{% set repo_id = "studio-ousia/luke-large-finetuned-conll-2003" %}
{% set device = "cuda:0" %}
{% set text = "Hugging Face is based in New York City." %}
{% set entity_spans = [(0, 12), (25, 38)] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/studio-ousia__SEP__luke-large-finetuned-conll-2003" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
entity_spans = {{ entity_spans }}
output_dir = "{{ output_dir }}"

import json
import os

import torch
from transformers import AutoTokenizer, LukeForEntitySpanClassification

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = LukeForEntitySpanClassification.from_pretrained(repo_id)

device = torch.device(device)
model = model.to(device)
model.eval()

entity_spans_input = [tuple(span) for span in entity_spans]
encoding = tokenizer(
    text,
    entity_spans=entity_spans_input,
    return_tensors="pt",
    truncation=True,
)
encoding = {key: value.to(device) for key, value in encoding.items()}

with torch.no_grad():
    outputs = model(**encoding)
logits = outputs.logits

scores = torch.softmax(logits, dim=-1)
predictions = torch.argmax(scores, dim=-1)

scores = scores[0].cpu()
predictions = predictions[0].cpu()

id2label = {int(key): value for key, value in model.config.id2label.items()}

entity_predictions = []
for index, span in enumerate(entity_spans):
    if index >= predictions.shape[0]:
        break
    label_id = int(predictions[index].item())
    label = id2label.get(label_id, str(label_id))
    score = float(scores[index, label_id].item())
    entity_predictions.append({
        "span": tuple(span),
        "label": label,
        "score": score,
    })

RESULT = {"entity_predictions": entity_predictions}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    result_path = os.path.join(output_dir, "entity_predictions.json")
    with open(result_path, "w", encoding="utf-8") as file:
        json.dump(RESULT, file, ensure_ascii=False, indent=2)