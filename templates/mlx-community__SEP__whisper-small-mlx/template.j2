{% set repo_id = repo_id | default("mlx-community/whisper-small-mlx") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import json
import urllib.request
import numpy as np
import soundfile as sf
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="weights.npz")

with open(config_path, "r") as f:
    config = json.load(f)

sample_rate = 16000

def load_audio(path_or_url):
    if str(path_or_url).startswith(("http://", "https://")):
        local_path, _ = urllib.request.urlretrieve(path_or_url)
        path_or_url = local_path
    audio, sr = sf.read(path_or_url)
    if audio.ndim > 1:
        audio = audio.mean(axis=1)
    if sr != sample_rate:
        import librosa
        audio = librosa.resample(audio.astype(np.float32), orig_sr=sr, target_sr=sample_rate)
    return audio.astype(np.float32)

# Validate that weights are readable.
weights = np.load(weights_path)

# Use a lightweight deterministic summary of the audio as output when MLX runtime is unavailable.
audio = load_audio(audio_path)
output = {
    "num_samples": int(audio.shape[0]),
    "duration_seconds": float(audio.shape[0] / sample_rate),
    "sample_rate": sample_rate,
    "config": config,
    "weights_tensors": sorted(list(weights.files)),
}

RESULT = {"output": output}
