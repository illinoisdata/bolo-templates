{% set repo_id = repo_id | default("google/byt5-small") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Life is like a box of chocolates.') %}
{% set text2 = text2 | default('Today is Monday.') %}
{% set target_text = target_text | default('La vie est comme une boîte de chocolat.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
text2 = "{{ text2 }}"
target_text = "{{ target_text }}"

import os
import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

model_dir = os.path.dirname(weights_path)
tokenizer_dir = os.path.dirname(tokenizer_config_path)

tokenizer = AutoTokenizer.from_pretrained(tokenizer_dir, use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(model_dir)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

model_inputs = tokenizer([text, text2], padding="longest", return_tensors="pt")
labels = tokenizer([target_text, target_text], padding="longest", return_tensors="pt").input_ids
model_inputs = {k: v.to(device) for k, v in model_inputs.items()}
labels = labels.to(device)

with torch.no_grad():
    outputs = model(**model_inputs, labels=labels)
    generated = model.generate(**model_inputs, max_new_tokens=32)

RESULT = {
    "loss": outputs.loss.detach().cpu().item(),
    "generated_text": tokenizer.batch_decode(generated, skip_special_tokens=True),
}
