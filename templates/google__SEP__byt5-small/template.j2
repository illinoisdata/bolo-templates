{% set repo_id = repo_id | default("google/byt5-small") %}
{% set device = device | default("cuda:0") %}
{% set input_texts = input_texts | default(["Life is like a box of chocolates."]) %}
{% set max_length = max_length | default(64) %}
{% set num_return_sequences = num_return_sequences | default(1) %}
{% set do_sample = do_sample | default(false) %}
{% set temperature = temperature | default(1.0) %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__byt5-small") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_texts = {{ input_texts }}
max_length = {{ max_length }}
num_return_sequences = {{ num_return_sequences }}
do_sample = {{ do_sample }}
temperature = {{ temperature }}
output_dir = "{{ output_dir }}"

import json
import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    input_texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: tensor.to(device) for key, tensor in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_return_sequences=num_return_sequences,
        do_sample=do_sample,
        temperature=temperature,
    )

generated_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_text": generated_texts}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "generated_text.json")
    with open(output_path, "w", encoding="utf-8") as writer:
        json.dump(RESULT["generated_text"], writer, ensure_ascii=False, indent=2)