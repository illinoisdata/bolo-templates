{% set repo_id = repo_id | default("ggml-org/SmolVLM-500M-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('SmolVLM-500M-Instruct-Q8_0.gguf') %}
{% set mmproj_filename = mmproj_filename | default('mmproj-SmolVLM-500M-Instruct-Q8_0.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('Describe the image in detail.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
mmproj_filename = "{{ mmproj_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoProcessor, SmolVLMForConditionalGeneration

weight_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename=mmproj_filename)

if image_path.startswith(("http://", "https://")):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

processor = AutoProcessor.from_pretrained("HuggingFaceTB/SmolVLM-500M-Instruct")
tokenizer = AutoTokenizer.from_pretrained("HuggingFaceTB/SmolVLM-500M-Instruct")
model = SmolVLMForConditionalGeneration.from_pretrained(
    "HuggingFaceTB/SmolVLM-500M-Instruct",
    torch_dtype="auto",
)
model = model.to(device)

messages = [
    {
        "role": "user",
        "content": [
            {"type": "image", "image": image},
            {"type": "text", "text": prompt},
        ],
    }
]

prompt_text = processor.apply_chat_template(messages, add_generation_prompt=True)
inputs = processor(text=prompt_text, images=image, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

output_ids = model.generate(**inputs, max_new_tokens=64, do_sample=False)
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"text": output_text}
