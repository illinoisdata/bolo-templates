{% set repo_id = repo_id | default("inpreet/logo_human_pupper") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") -%}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") -%}
{% set image_processor_repo = image_processor_repo | default("google/vit-base-patch16-224-in21k") -%}

# Variable assignments
task = "{{ task }}"
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_data = "{{ input_data }}"
image_processor_repo = "{{ image_processor_repo }}"

# Imports
from transformers import pipeline, AutoImageProcessor

# Load processor and create pipeline
image_processor = AutoImageProcessor.from_pretrained(image_processor_repo)
pipe = pipeline(task=task, model=repo_id, image_processor=image_processor, device=device)

# Run inference
RESULT = pipe(input_data)
