{% set repo_id = repo_id | default("facebook/wav2vec2-large-es-voxpopuli") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("automatic-speech-recognition") %}
{% set tokenizer_id = tokenizer_id | default("facebook/wav2vec2-base-960h") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

repo_id = {{ repo_id | tojson }}
task = {{ task | tojson }}
model = repo_id
tokenizer_id = {{ tokenizer_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, tokenizer=tokenizer_id, device=device)

preprocessed = input_data
raw_result = pipe(preprocessed)

RESULT = {"transcription": raw_result}
