{% set repo_id = repo_id | default("google/bert_uncased_L-10_H-768_A-12") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The quick brown fox jumps over the lazy dog.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

device_t = torch.device(device if torch.cuda.is_available() and str(device).startswith("cuda") else "cpu")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModel.from_pretrained(repo_id)
model.to(device_t)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device_t) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooled_output = outputs.pooler_output
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooled_output": pooled_output,
}
