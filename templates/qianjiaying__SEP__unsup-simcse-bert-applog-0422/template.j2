{% set repo_id = repo_id | default("qianjiaying/unsup-simcse-bert-applog-0422") %}
{% set device = device | default("cuda:0") %}
{% set sentence1 = sentence1 | default('This is a sample query sentence for embedding.') %}
{% set sentence2 = sentence2 | default('This is another sample sentence for similarity comparison.') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentence1 = "{{ sentence1 }}"
sentence2 = "{{ sentence2 }}"

import os
import json
import torch
import torch.nn.functional as F
from transformers import AutoTokenizer, AutoConfig, BertPreTrainedModel, BertModel
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(
    os.path.dirname(vocab_path),
    config=config,
    tokenizer_file=None,
    use_fast=False,
)

class BertForCL(BertPreTrainedModel):
    def __init__(self, config):
        super().__init__(config)
        self.bert = BertModel(config, add_pooling_layer=False)
        self.temperature = 0.05
        self.init_weights()

    def forward(self, input_ids=None, attention_mask=None, token_type_ids=None):
        outputs = self.bert(
            input_ids=input_ids,
            attention_mask=attention_mask,
            token_type_ids=token_type_ids,
            return_dict=True,
        )
        cls = outputs.last_hidden_state[:, 0]
        cls = F.normalize(cls, p=2, dim=-1)
        return cls

model = BertForCL.from_pretrained(os.path.dirname(weights_path), config=config)
state_dict = torch.load(weights_path, map_location="cpu")
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

encoded = tokenizer([sentence1, sentence2], padding=True, truncation=True, max_length=512, return_tensors="pt")
encoded = {k: v.to(device) for k, v in encoded.items()}

with torch.no_grad():
    embeddings = model(**encoded)
    similarity = torch.matmul(embeddings[0], embeddings[1]).item()

RESULT = {
    "sentence1_embedding": embeddings[0].detach().cpu(),
    "sentence2_embedding": embeddings[1].detach().cpu(),
    "cosine_similarity": similarity,
}
