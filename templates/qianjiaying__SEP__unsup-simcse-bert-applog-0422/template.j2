{% set device = "cuda:0" %}
{% set repo_id = "qianjiaying/unsup-simcse-bert-applog-0422" %}
{% set sentences = ["An example sentence for unsupervised SimCSE inference."] %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences }}

import json
from pathlib import Path

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

encoded_inputs = tokenizer(
    sentences,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
encoded_inputs = {k: v.to(device) for k, v in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs, return_dict=True)

pooler_output = outputs.pooler_output
if pooler_output is None:
    pooler_output = outputs.last_hidden_state[:, 0]
sentence_embeddings = pooler_output.detach().cpu().tolist()

RESULT = {"sentence_embeddings": sentence_embeddings}
