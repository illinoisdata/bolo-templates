{% set device = "cuda:0" %}
{% set repo_id = "dbmdz/bert-base-french-europeana-cased" %}
{% set input_text = input_text | default("Bonjour, voici un exemple de texte en français pour tester le modèle de langage.") %}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_text = {{ input_text | tojson }}

import os

import torch
from transformers import AutoTokenizer, AutoModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)

inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
inputs = {key: tensor.to(torch_device) for key, tensor in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()
pooler = getattr(outputs, "pooler_output", None)
pooled_output = pooler.detach().cpu() if pooler is not None else None

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooled_output": pooled_output,
}
