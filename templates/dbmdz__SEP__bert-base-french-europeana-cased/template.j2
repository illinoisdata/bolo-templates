{% set repo_id = repo_id | default("dbmdz/bert-base-french-europeana-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Bonjour, je m'appelle Jean et je travaille à Paris.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
repo_dir = config_path.rsplit('/', 1)[0]

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=False)
model = AutoModel.from_pretrained(repo_dir, torch_dtype=torch.float32).to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooled_output = outputs.pooler_output

RESULT = {
    "last_hidden_state": last_hidden_state.detach().cpu().numpy(),
    "pooled_output": None if pooled_output is None else pooled_output.detach().cpu().numpy(),
}
