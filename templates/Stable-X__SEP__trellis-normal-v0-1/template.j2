{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('a detailed 3d asset of the object in the image') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import os
import json
import torch
from PIL import Image
from urllib.parse import urlparse
from huggingface_hub import hf_hub_download

def load_image(path_or_url):
    if str(path_or_url).startswith(("http://", "https://")):
        from io import BytesIO
        import requests
        return Image.open(BytesIO(requests.get(path_or_url, timeout=30).content)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")


pipeline_json = hf_hub_download(repo_id=repo_id, filename="pipeline.json")
with open(pipeline_json, "r") as f:
    cfg = json.load(f)

image = load_image(image_path)
output = {"repo_id": repo_id, "device": device, "prompt": prompt, "image_size": image.size, "pipeline_config_keys": sorted(cfg.keys())}

RESULT = {"output": output}
