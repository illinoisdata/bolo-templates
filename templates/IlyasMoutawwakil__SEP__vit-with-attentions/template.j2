{% set repo_id = repo_id | default("IlyasMoutawwakil/vit-with-attentions") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set model = model | default(repo_id) %}
{% set image_processor = image_processor | default("google/vit-base-patch16-224") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
image_processor = {{ image_processor | tojson }}
input_image = {{ input_image | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(
    task=task,
    model=model,
    image_processor=image_processor,
    device=device,
)
RESULT = pipe(input_image)
