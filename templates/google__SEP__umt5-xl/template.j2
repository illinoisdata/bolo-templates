{% set prompt = "Translate English to Spanish: The quick brown fox jumps over the lazy dog." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/google__SEP__umt5-xl" %}
{% set output_filename = "generation.txt" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
output_dir = "{{ output_dir }}"
output_filename = "{{ output_filename }}"

from pathlib import Path
from transformers import AutoTokenizer, T5Config, T5ForConditionalGeneration

# Load tokenizer and model using T5 classes to bypass missing model_type in config
tokenizer = AutoTokenizer.from_pretrained(repo_id)
config = T5Config.from_pretrained(repo_id)
model = T5ForConditionalGeneration.from_pretrained(repo_id, config=config).to(device)

inputs = tokenizer(prompt, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(**inputs, max_new_tokens=128)
decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
result_text = decoded_outputs[0]

RESULT = {"generated_text": result_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    result_file = output_path / output_filename
    result_file.write_text(RESULT["generated_text"], encoding="utf-8")