{% set repo_id = repo_id | default("google/umt5-xl") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('translate English to German: The house is wonderful.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, T5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
model_index_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin.index.json")
weights_1 = hf_hub_download(repo_id=repo_id, filename="pytorch_model-00001-of-00002.bin")
weights_2 = hf_hub_download(repo_id=repo_id, filename="pytorch_model-00002-of-00002.bin")

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=32)

decoded = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
output_text = decoded[0] if decoded else ""

RESULT = {"output_text": output_text}
