{% set repo_id = repo_id | default("EbanLee/kobart-summary-v3") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("10년 논란 끝에 밑글씨까지 새기고 제작 완료를 눈앞에 둔 ‘광화문 현판’을 원점에서 재검토해 한글 현판으로 교체하자는 주장이 문화계 명사들이 포함된 자칭 ‘시민모임’에서 나왔다. 이들은 문화재청이 지난해 8월 최종 확정한 복원안이 시민 의견과 시대정신을 반영한 것이 아니라면서 오는 한글날까지 대대적인 현판 교체 시민운동을 벌이겠다고 예고했다.") %}
{% set max_length = max_length | default(300) %}
{% set min_length = min_length | default(12) %}
{% set num_beams = num_beams | default(6) %}
{% set length_penalty = length_penalty | default(1.0) %}
{% set repetition_penalty = repetition_penalty | default(1.5) %}
{% set no_repeat_ngram_size = no_repeat_ngram_size | default(15) %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}
length_penalty = {{ length_penalty }}
repetition_penalty = {{ repetition_penalty }}
no_repeat_ngram_size = {{ no_repeat_ngram_size }}

import torch
from transformers import PreTrainedTokenizerFast, BartForConditionalGeneration
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

tokenizer = PreTrainedTokenizerFast.from_pretrained(
    tokenizer_json_path,
    tokenizer_file=tokenizer_json_path,
    tokenizer_config_file=tokenizer_config_path,
    special_tokens_map_file=special_tokens_map_path,
)
model = BartForConditionalGeneration.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float32,
)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt", padding="max_length", truncation=True, max_length=1026)
inputs = {k: v.to(device) for k, v in inputs.items()}

summary_text_ids = model.generate(
    input_ids=inputs["input_ids"],
    attention_mask=inputs["attention_mask"],
    bos_token_id=model.config.bos_token_id,
    eos_token_id=model.config.eos_token_id,
    length_penalty=length_penalty,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    repetition_penalty=repetition_penalty,
    no_repeat_ngram_size=no_repeat_ngram_size,
)

output_text = tokenizer.decode(summary_text_ids[0], skip_special_tokens=True)

RESULT = {"summary": output_text}
