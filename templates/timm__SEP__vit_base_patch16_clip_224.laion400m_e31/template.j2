{% set repo_id = repo_id | default("timm/vit_base_patch16_clip_224.laion400m_e31") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set candidate_labels = candidate_labels | default(['cat', 'dog', 'car', 'tree', 'person']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
candidate_labels = {{ candidate_labels | tojson }}

import json
import torch
import requests
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
import open_clip

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")

if image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

with open(config_path, "r") as f:
    cfg = json.load(f)

model_name = cfg.get("model_cfg", {}).get("vision_cfg", {}).get("timm_model_name", "ViT-B-16")
model, _, preprocess = open_clip.create_model_and_transforms(model_name, pretrained=None, device=device)
open_clip.load_checkpoint(model, weights_path, strict=False, weights_only=True, device="cpu")
model = model.to(device)
model.eval()

image_input = preprocess(image).unsqueeze(0).to(device)
text_tokens = open_clip.tokenize(candidate_labels).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_input)
    text_features = model.encode_text(text_tokens)
    image_features = image_features / image_features.norm(dim=-1, keepdim=True)
    text_features = text_features / text_features.norm(dim=-1, keepdim=True)
    logits = (100.0 * image_features @ text_features.T).softmax(dim=-1)
    probs = logits[0].detach().cpu().tolist()

RESULT = {"candidate_labels": candidate_labels, "probabilities": probs}
