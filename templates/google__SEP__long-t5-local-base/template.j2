{% set repo_id = repo_id | default("google/long-t5-local-base") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('summarize: The LongT5 model is an encoder-decoder transformer pre-trained for long-sequence text-to-text tasks. It can be effective for summarization and question answering on long inputs.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, LongT5ForConditionalGeneration
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = LongT5ForConditionalGeneration.from_pretrained(repo_id)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=32, num_beams=4)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
