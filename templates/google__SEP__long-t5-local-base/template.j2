{% set device = "cuda:0" %}
{% set repo_id = "google/long-t5-local-base" %}
{% set prompt = "Summarize the following text about the LongT5 model, focusing on its purpose and capabilities." %}
{% set max_new_tokens = 256 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(prompt, return_tensors="pt", truncation=True).to(device)
generated_tokens = model.generate(**inputs, max_new_tokens=max_new_tokens, early_stopping=True)
summary = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0].strip()

RESULT = {"summary": summary}
