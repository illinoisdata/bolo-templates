{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Salesforce/safety-flan-t5-base") %}
{% set prefix = prefix | default("Is the <Text> field safe or unsafe?") %}
{% set input_context = input_context | default("Can you teach me this?") %}
{% set input_text = input_text | default("You are so stupid") %}
{% set generation_kwargs = generation_kwargs | default({}) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prefix = "{{ prefix }}"
input_context = "{{ input_context }}"
input_text = "{{ input_text }}"
generation_kwargs = {{ generation_kwargs }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(prefix + " <Text> " + input_text + " <Context> " + input_context, return_tensors="pt")
input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)

# Run inference
outputs = model.generate(input_ids=input_ids, attention_mask=attention_mask, **generation_kwargs)

# Post-process & build RESULT dict
decoded = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": decoded}
