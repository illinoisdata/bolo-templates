{% set prefix = "Is the <Text> field safe or unsafe?" %}
{% set input_context = "Can you teach me this?" %}
{% set input_text = "You are so stupid" %}
{% set generation_kwargs = {} %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Salesforce__SEP__safety-flan-t5-base" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prefix = "{{ prefix }}"
input_context = "{{ input_context }}"
input_text = "{{ input_text }}"
generation_kwargs = {{ generation_kwargs }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process input
inputs = tokenizer(prefix + " <Text> " + input_text + " <Context> " + input_context, return_tensors="pt")
input_ids = inputs.input_ids.to(device)
attention_mask = inputs.attention_mask.to(device)

# Run inference
outputs = model.generate(input_ids=input_ids, attention_mask=attention_mask, **generation_kwargs)

# Post-process & build RESULT dict
decoded = tokenizer.decode(outputs[0], skip_special_tokens=True)

RESULT = {"generated_text": decoded}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "generated_text.txt"), "w") as f:
        f.write(RESULT["generated_text"])