{% set device = "cuda:0" %}
{% set repo_id = "mrm8488/t5-base-finetuned-common_gen" %}
{% set prompt = "tree plant ground hole dig" %}
{% set max_length = 64 %}
{% set num_beams = 4 %}
{% set num_return_sequences = 1 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import os

_tokenizer = AutoTokenizer.from_pretrained(repo_id)
_model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
_model = _model.to(device)
_model.eval()

_inputs = _tokenizer(prompt, return_tensors="pt")
_inputs = {key: value.to(device) for key, value in _inputs.items()}

_generated = _model.generate(**_inputs, max_length=max_length, num_beams=num_beams, num_return_sequences=num_return_sequences)
_decoded = _tokenizer.batch_decode(
    _generated, skip_special_tokens=True, clean_up_tokenization_spaces=True
)

RESULT = {"generated_sentences": _decoded}
