repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"

import os
import sys
import json
import numpy as np
import torch
import librosa
from huggingface_hub import hf_hub_download, snapshot_download

repo_dir = snapshot_download(repo_id=repo_id, allow_patterns=['*.py', 'config.json', 'bigvgan_generator.pt'])
sys.path.insert(0, repo_dir)

from bigvgan import BigVGAN
from meldataset import get_mel_spectrogram

config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
with open(config_path, 'r') as f:
    h_dict = json.load(f)

class AttrDict(dict):
    __getattr__ = dict.get
    __setattr__ = dict.__setitem__
    __delattr__ = dict.__delitem__

h = AttrDict(h_dict)
h["use_cuda_kernel"] = False
model = BigVGAN(h)
state_dict = torch.load(hf_hub_download(repo_id=repo_id, filename='bigvgan_generator.pt'), map_location='cpu')
if isinstance(state_dict, dict) and 'state_dict' in state_dict:
    state_dict = state_dict['state_dict']
model.load_state_dict(state_dict, strict=False)
model.remove_weight_norm()
model = model.eval().to(device)

if audio_path.startswith('http://') or audio_path.startswith('https://'):
    wav, sr = librosa.load(audio_path, sr=model.h.sampling_rate, mono=True)
else:
    wav, sr = librosa.load(audio_path, sr=model.h.sampling_rate, mono=True)

wav = torch.FloatTensor(wav).unsqueeze(0).to(device)
mel = get_mel_spectrogram(wav, model.h).to(device)

with torch.inference_mode():
    wav_gen = model(mel)

output_waveform = wav_gen.squeeze(0).detach().cpu().numpy()
RESULT = {"waveform": output_waveform, "sample_rate": int(model.h.sampling_rate)}
