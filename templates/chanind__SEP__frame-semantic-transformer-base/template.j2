{% set repo_id = repo_id | default("chanind/frame-semantic-transformer-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The committee approved the budget after a lengthy discussion.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
import torch
from transformers import T5Tokenizer, T5ForConditionalGeneration

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
repo_dir = weights_path.rsplit("/", 1)[0]

# Use the original T5 tokenizer/model classes for this fine-tuned T5 checkpoint.
tokenizer = T5Tokenizer.from_pretrained(repo_dir, use_fast=False)
model = T5ForConditionalGeneration.from_pretrained(repo_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

prompt = f"frame semantic parse: {text}"
inputs = tokenizer(prompt, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated = model.generate(
        **inputs,
        max_new_tokens=128,
        num_beams=4,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated[0], skip_special_tokens=True)
RESULT = {"output_text": output_text}
