{% set text_to_parse = "The agent quickly filled out the application." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/chanind__SEP__frame-semantic-transformer-base" %}
{% set max_new_tokens = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_to_parse = "{{ text_to_parse }}"
output_dir = "{{ output_dir }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import torch
from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

pt_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(pt_device)
model.eval()

encoded_inputs = tokenizer(
    text_to_parse,
    return_tensors="pt",
    padding=True,
    truncation=True,
)
encoded_inputs = {key: tensor.to(pt_device) for key, tensor in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    max_new_tokens=max_new_tokens,
    num_beams=num_beams,
    eos_token_id=tokenizer.eos_token_id,
    pad_token_id=tokenizer.pad_token_id,
)

generated_decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
generated_text = generated_decoded[0]

RESULT = {"generated_text": generated_text}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    (Path(output_dir) / "generated_text.txt").write_text(generated_text, encoding="utf-8")