{% set repo_id = repo_id | default("urchade/gliner_multi_pii-v1") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("""Harilala Rasoanaivo, un homme d'affaires local d'Antananarivo, a enregistré une nouvelle société nommée \"Rasoanaivo Enterprises\" au Lot II M 92 Antohomadinika. Son numéro est le +261 32 22 345 67, et son adresse électronique est harilala.rasoanaivo@telma.mg. Il a fourni son numéro de sécu 501-02-1234 pour l'enregistrement.""") %}
{% set labels = labels | default(["work", "booking number", "personally identifiable information", "driver licence", "person", "book", "full address", "company", "actor", "character", "email", "passport number", "Social Security Number", "phone number"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
labels = {{ labels | tojson }}

import os
import json
import torch
from huggingface_hub import hf_hub_download
from gliner import GLiNER

config_path = hf_hub_download(repo_id=repo_id, filename="gliner_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")

model = GLiNER.from_pretrained(repo_id)
model.to(device)

entities = model.predict_entities(text, labels)
output = [{"text": e["text"], "label": e["label"], "start": e.get("start"), "end": e.get("end"), "score": e.get("score")} for e in entities]

RESULT = {"entities": output}
