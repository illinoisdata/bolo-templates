{% set repo_id = repo_id | default("laion/clap-htsat-fused") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-audio-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set candidate_labels = candidate_labels | default(["Sound of a dog", "Sound of vacuum cleaner"]) %}

repo_id = {{ repo_id | tojson }}
task = {{ task | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}
candidate_labels = {{ candidate_labels | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device)
RESULT = pipe(input_data, candidate_labels=candidate_labels)
