{% set device = "cuda:0" %}
{% set repo_id = "Rostlab/prot_xlnet" %}
{% set text_sequence = "MGDVEKGKKIFIMKCSQCHTVEKGGKHKTGPNLHGLFGRKTGQAPGYSYTAANKNKGIIWGEDTLMEYLENPKKYIPGTKMIFAGIKG" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_sequence = "{{ text_sequence }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSequenceClassification.from_pretrained(repo_id)
model.to(torch_device)
model.eval()

encoded_inputs = tokenizer(text_sequence, return_tensors="pt", truncation=True)
encoded_inputs = {key: tensor.to(torch_device) for key, tensor in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

logits = outputs.logits
probs = torch.softmax(logits, dim=-1)
score_tensor, pred_tensor = torch.max(probs, dim=-1)
pred_idx = pred_tensor.item()
raw_id2label = getattr(model.config, "id2label", None)
if raw_id2label:
    id2label = {int(key): value for key, value in raw_id2label.items()}
else:
    id2label = {}
prediction_label = id2label.get(pred_idx, str(pred_idx))
logits_values = logits[0].cpu().tolist() if logits.dim() == 2 else logits.cpu().tolist()
RESULT = {
    "label": prediction_label,
    "score": float(score_tensor.item()),
    "logits": logits_values,
}
