{% set repo_id = repo_id | default("Rostlab/prot_xlnet") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('MKTFFVAGVILLLLLSGAQG') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import XLNetConfig, XLNetForSequenceClassification, XLNetTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")

sequence = " ".join(list(text.replace(" ", "")))

tokenizer = XLNetTokenizer(vocab_file=tokenizer_path)
config = XLNetConfig.from_json_file(config_path)
model = XLNetForSequenceClassification(config)
state_dict = torch.load(model_path, map_location="cpu")
filtered_state_dict = {k: v for k, v in state_dict.items() if not k.startswith("lm_loss.")}
model.load_state_dict(filtered_state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(sequence, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probabilities = torch.softmax(logits, dim=-1)
    predicted_class = int(torch.argmax(probabilities, dim=-1).item())

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "probabilities": probabilities.detach().cpu().tolist(),
    "predicted_class": predicted_class,
}
