{% set repo_id = repo_id | default("google/t5-efficient-tiny") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("translate English to German: HuggingFace transformers are incredible.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch.device(device))
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(input_text, return_tensors="pt").to(torch.device(device))
with torch.no_grad():
    generated_ids = model.generate(**inputs)
decoded_tokens = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
generated_text = decoded_tokens[0] if decoded_tokens else ""
RESULT = {"generated_text": generated_text}
