{% set repo_id = repo_id | default("google/t5-efficient-tiny") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('summarize: The T5-Efficient-TINY model is a small pretrained T5 checkpoint. It must be fine-tuned for downstream tasks, and this script runs a simple text generation inference example.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    local_files_only=True,
    tokenizer_file=tokenizer_file,
    tokenizer_config_file=tokenizer_config_file,
    special_tokens_map_file=special_tokens_map_file,
    use_fast=False,
)

model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    local_files_only=True,
    torch_dtype=torch.float32,
)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        max_new_tokens=24,
        do_sample=False,
    )

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"output_text": output_text}
