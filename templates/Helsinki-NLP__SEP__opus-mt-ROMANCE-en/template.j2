{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ROMANCE-en") %}
{% set input_text = input_text | default(["Hola, ¿cómo estás?"]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text }}

import os

import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
encoding = tokenizer(input_text, return_tensors="pt", padding=True)
encoding = encoding.to(device)
generated_tokens = model.generate(**encoding, max_length=128, num_beams=4)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translations": translations}
