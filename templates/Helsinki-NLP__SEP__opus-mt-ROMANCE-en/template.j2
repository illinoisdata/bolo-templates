{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-ROMANCE-en") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Hola, ¿cómo estás?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
tokenizer_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")

tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    use_fast=False,
    local_files_only=True,
)
model = AutoModelForSeq2SeqLM.from_pretrained(
    repo_id,
    local_files_only=True,
)
model.to(device)
model.eval()

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=4,
        max_length=128,
    )

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
