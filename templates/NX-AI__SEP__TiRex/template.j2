repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = {{ context }}
prediction_length = {{ prediction_length }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoConfig

weights_path = hf_hub_download(repo_id=repo_id, filename="model.ckpt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json") if False else None

model = torch.load(weights_path, map_location="cpu")
if isinstance(model, dict) and "state_dict" in model:
    state = model["state_dict"]
else:
    state = model

RESULT = {"weights_type": str(type(model)), "keys": list(state.keys())[:5] if hasattr(state, "keys") else []}
