{% set text_inputs = ["The quick brown fox jumps over the lazy dog."] %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set output_filename = "translations.txt" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-af" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"
output_filename = "{{ output_filename }}"

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

output_path = Path(output_dir)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    text_inputs,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
inputs = inputs.to(device)

generated_tokens = model.generate(
    **inputs,
    max_length=max_length,
    num_beams=num_beams,
)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    output_path.mkdir(parents=True, exist_ok=True)
    destination = output_path / output_filename
    destination.write_text("\n".join(RESULT["translations"]), encoding="utf-8")