{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-fr-en") %}
{% set device = device | default("cuda:0") %}
{% set text_inputs = text_inputs | default(["J'ai adoré l'Angleterre.", "C'était la seule chose à faire."]) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_inputs = {{ text_inputs | tojson }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
torch_device = torch.device(device)
model = model.to(torch_device)
model.eval()

inputs = tokenizer(text_inputs, return_tensors="pt", padding=True, truncation=True)
inputs = {k: v.to(torch_device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
