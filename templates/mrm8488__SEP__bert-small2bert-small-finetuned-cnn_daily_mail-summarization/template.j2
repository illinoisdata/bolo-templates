{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/mrm8488__SEP__bert-small2bert-small-finetuned-cnn_daily_mail-summarization" %}
{% set input_text = "The CNN/DailyMail article describes daily news summaries that emphasize the most important sentences in a concise way." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
input_text = "{{ input_text }}"

torch_device = None

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

model_inputs = tokenizer(
    input_text,
    padding="max_length",
    truncation=True,
    max_length=512,
    return_tensors="pt",
)
model_inputs = {key: value.to(torch_device) for key, value in model_inputs.items()}

generated_tokens = model.generate(
    **model_inputs,
    min_length=56,
    max_length=142,
    no_repeat_ngram_size=3,
    length_penalty=2.0,
    num_beams=4,
)
summary_text = tokenizer.decode(generated_tokens[0], skip_special_tokens=True)

RESULT = {"summary": summary_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    summary_file = output_path / "summary.txt"
    summary_file.write_text(RESULT["summary"], encoding="utf-8")