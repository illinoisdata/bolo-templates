{% set repo_id = repo_id | default("ggml-org/tinygemma3-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('tinygemma3-Q8_0.gguf') %}
{% set mmproj_filename = mmproj_filename | default('mmproj-tinygemma3.gguf') %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set prompt = prompt | default('What is in this image?') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
mmproj_filename = "{{ mmproj_filename }}"
image_path = "{{ image_path }}"
prompt = "{{ prompt }}"

import requests
from PIL import Image
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
mmproj_path = hf_hub_download(repo_id=repo_id, filename=mmproj_filename)

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(requests.get(image_path, stream=True).raw).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = Llama(
    model_path=weights_path,
    mmproj_path=mmproj_path,
    n_ctx=512,
    n_gpu_layers=-1 if device.startswith("cuda") else 0,
    verbose=False,
)

response = model.create_chat_completion(
    messages=[
        {
            "role": "user",
            "content": [
                {"type": "text", "text": prompt},
                {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64,"}},
            ],
        }
    ],
    temperature=0.0,
    max_tokens=64,
)

output_text = response["choices"][0]["message"]["content"]
RESULT = {"output": output_text}
