{% set repo_id = repo_id | default("aubmindlab/araelectra-base-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("هذا نص عربي تجريبي") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import json
from pathlib import Path

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
model.eval()

raw_inputs = tokenizer(input_text, return_tensors="pt")
inputs = {name: tensor.to(device) for name, tensor in raw_inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.sigmoid(logits)
predictions = torch.round(probabilities)

tokens = tokenizer.convert_ids_to_tokens(raw_inputs["input_ids"][0])
real_probabilities = probabilities.squeeze().to("cpu").tolist()
prediction_values = [int(value) for value in predictions.squeeze().to("cpu").tolist()]

RESULT = {
    "tokens": tokens,
    "real_probabilities": real_probabilities,
    "predictions": prediction_values,
}
