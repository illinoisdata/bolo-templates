{% set repo_id = repo_id | default("openlm-research/open_llama_3b") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(64) %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}

from transformers import LlamaTokenizer, pipeline

tokenizer = LlamaTokenizer.from_pretrained(repo_id, use_fast=False)
pipe = pipeline(task=task, model=repo_id, tokenizer=tokenizer, device=device)
inputs = input_prompt
raw_output = pipe(inputs, max_new_tokens=max_new_tokens)
RESULT = {"output": raw_output}
