{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("context-sbf/charm-xl") %}
{% set prompt = prompt | default("summarize: In a few sentences, summarize the following article about sustainable energy transitions.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import os
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Pre-process the input prompt
inputs = tokenizer(prompt, return_tensors="pt")
inputs = {key: tensor.to(device) for key, tensor in inputs.items()}

# Run inference
generated_ids = model.generate(**inputs, max_length=200, num_beams=4)

# Post-process
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
