{% set repo_id = repo_id | default("context-sbf/charm-xl") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('summarize: The quick brown fox jumps over the lazy dog. This sentence is repeated to provide a slightly longer input for summarization.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
spiece_path = hf_hub_download(repo_id=repo_id, filename="spiece.model")
weights_index_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin.index.json")
hf_hub_download(repo_id=repo_id, filename="pytorch_model-00001-of-00002.bin")
hf_hub_download(repo_id=repo_id, filename="pytorch_model-00002-of-00002.bin")

model_dir = os.path.dirname(weights_index_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=False, legacy=True)
model = AutoModelForSeq2SeqLM.from_pretrained(model_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=64, num_beams=4)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)
RESULT = {"text": output_text}
