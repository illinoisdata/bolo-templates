{% set device = "cuda:0" %}
{% set repo_id = "readerbench/RoBERT-large" %}
{% set text_input = "Acesta este un exemplu de propoziție în limba română." %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from pathlib import Path
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.detach().cpu()
pooler_output = outputs.pooler_output.detach().cpu() if outputs.pooler_output is not None else None

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
