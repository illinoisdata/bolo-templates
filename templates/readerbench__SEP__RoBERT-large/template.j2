{% set repo_id = repo_id | default("readerbench/RoBERT-large") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("exemplu de propoziție") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModel
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

tokenizer = AutoTokenizer.from_pretrained(
    tokenizer_config_path.rsplit("/", 1)[0],
    use_fast=False,
)
model = AutoModel.from_pretrained(
    tokenizer_config_path.rsplit("/", 1)[0],
)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, "pooler_output", None)
RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
