{% set repo_id = repo_id | default("bmd1905/vietnamese-correction-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("côn viec kin doanh thì rất kho khan nên toi quyết dinh chuyển sang nghề khac  ") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import MBartForConditionalGeneration, BartphoTokenizer
from huggingface_hub import hf_hub_download

tokenizer = BartphoTokenizer.from_pretrained(repo_id)
model = MBartForConditionalGeneration.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer([text], return_tensors="pt", padding=True, truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_length=512,
        num_beams=4,
    )
output_text = tokenizer.batch_decode(output_ids, skip_special_tokens=True)[0]

RESULT = {"output": output_text}
