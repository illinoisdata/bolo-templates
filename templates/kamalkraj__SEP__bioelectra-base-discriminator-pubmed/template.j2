{% set repo_id = repo_id | default("kamalkraj/bioelectra-base-discriminator-pubmed") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("The quick brown fox jumps over the lazy dog") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

import json
import os

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}
outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.sigmoid(logits)
predictions = torch.round(probabilities)

input_ids_cpu = inputs["input_ids"].squeeze(0).cpu()
tokens = tokenizer.convert_ids_to_tokens(input_ids_cpu.tolist())

logits_list = logits.detach().cpu().squeeze(0).tolist()
probabilities_list = probabilities.detach().cpu().squeeze(0).tolist()
predictions_list = predictions.detach().cpu().squeeze(0).int().tolist()

RESULT = {
    "tokens": tokens,
    "logits": logits_list,
    "probabilities": probabilities_list,
    "predictions": predictions_list,
}
