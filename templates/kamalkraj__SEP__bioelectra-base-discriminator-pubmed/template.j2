{% set text = text | default('The quick brown fox fake over the lazy dog') %}
{% set repo_id = repo_id | default("kamalkraj/bioelectra-base-discriminator-pubmed") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import ElectraForPreTraining, ElectraTokenizerFast
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

device_obj = torch.device(device if torch.cuda.is_available() or str(device) == 'cpu' else 'cpu')

tokenizer = ElectraTokenizerFast(vocab_file=vocab_path)
model = ElectraForPreTraining.from_pretrained(repo_id, local_files_only=True)
model.to(device_obj)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device_obj) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    logits = outputs.logits
    probabilities = torch.sigmoid(logits)
    predictions = torch.round(probabilities)

RESULT = {
    "logits": logits.detach().cpu().tolist(),
    "probabilities": probabilities.detach().cpu().tolist(),
    "predictions": predictions.detach().cpu().tolist(),
    "tokens": tokenizer.convert_ids_to_tokens(inputs["input_ids"][0].detach().cpu().tolist()),
}
