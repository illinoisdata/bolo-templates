{% set repo_id = "kamalkraj/bioelectra-base-discriminator-pubmed" %}
{% set device = "cuda:0" %}
{% set input_text = "The quick brown fox jumps over the lazy dog" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/kamalkraj__SEP__bioelectra-base-discriminator-pubmed" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import json
import os

import torch
from transformers import AutoModelForPreTraining, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt")
inputs = {key: value.to(device) for key, value in inputs.items()}
outputs = model(**inputs)

logits = outputs.logits
probabilities = torch.sigmoid(logits)
predictions = torch.round(probabilities)

input_ids_cpu = inputs["input_ids"].squeeze(0).cpu()
tokens = tokenizer.convert_ids_to_tokens(input_ids_cpu.tolist())

logits_list = logits.detach().cpu().squeeze(0).tolist()
probabilities_list = probabilities.detach().cpu().squeeze(0).tolist()
predictions_list = predictions.detach().cpu().squeeze(0).int().tolist()

RESULT = {
    "tokens": tokens,
    "logits": logits_list,
    "probabilities": probabilities_list,
    "predictions": predictions_list,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "tokens.json"), "w", encoding="utf-8") as f:
        json.dump(RESULT["tokens"], f, ensure_ascii=False)
    with open(os.path.join(output_dir, "logits.json"), "w", encoding="utf-8") as f:
        json.dump(RESULT["logits"], f)
    with open(os.path.join(output_dir, "probabilities.json"), "w", encoding="utf-8") as f:
        json.dump(RESULT["probabilities"], f)
    with open(os.path.join(output_dir, "predictions.json"), "w", encoding="utf-8") as f:
        json.dump(RESULT["predictions"], f)