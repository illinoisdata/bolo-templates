{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-gmw-gmw") %}
{% set source_text = source_text | default("Hello, how are you today?") %}
{% set target_lang = target_lang | default("nld") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
target_lang = "{{ target_lang }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

formatted_text = f">>{target_lang}<< {source_text}".strip()
inputs = tokenizer(formatted_text, return_tensors="pt", padding=True, truncation=True).to(device)

with torch.no_grad():
    generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
