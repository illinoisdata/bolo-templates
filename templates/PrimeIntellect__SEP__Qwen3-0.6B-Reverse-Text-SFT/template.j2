{% set repo_id = repo_id | default("PrimeIntellect/Qwen3-0.6B-Reverse-Text-SFT") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('Reverse the text and output only the reversed text.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")
repo_dir = tokenizer_json_path.rsplit('/', 1)[0]

tokenizer = AutoTokenizer.from_pretrained(repo_dir, use_fast=True)
model = AutoModelForCausalLM.from_pretrained(repo_dir, torch_dtype=torch.float32, device_map=None)
model.to(device)
model.eval()

input_text = f"User: {prompt}\nAssistant:"
inputs = tokenizer(input_text, return_tensors="pt")
input_ids = inputs["input_ids"].to(device)
attention_mask = inputs["attention_mask"].to(device)

with torch.no_grad():
    generated = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        max_new_tokens=64,
        do_sample=False,
        temperature=0.0,
        pad_token_id=tokenizer.eos_token_id,
        eos_token_id=tokenizer.eos_token_id,
    )

new_tokens = generated[0, input_ids.shape[-1]:]
output_text = tokenizer.decode(new_tokens, skip_special_tokens=True).strip()

RESULT = {"output": output_text}
