{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set labels_list = labels_list | default(['a dog', 'a cat', 'a donut', 'a beignet']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
labels_list = {{ labels_list }}

import torch
from PIL import Image
from urllib.request import urlopen
from open_clip import create_model_from_pretrained, get_tokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_model.safetensors")


def load_image(path_or_url):
    if str(path_or_url).startswith(("http://", "https://")):
        return Image.open(urlopen(path_or_url)).convert("RGB")
    return Image.open(path_or_url).convert("RGB")

image = load_image(image_path)

model_name = "ViT-L-16-SigLIP2-256"
model, preprocess = create_model_from_pretrained(model_name, pretrained=weights_path, device=device)
model.eval()
tokenizer = get_tokenizer(model_name)

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer(labels_list, context_length=model.context_length).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor, normalize=True)
    text_features = model.encode_text(text_tokens, normalize=True)
    logits = image_features @ text_features.T * model.logit_scale.exp() + model.logit_bias
    probs = torch.sigmoid(logits)

output = [(label, float(prob.item())) for label, prob in zip(labels_list, probs[0])]

RESULT = {"output": output}
