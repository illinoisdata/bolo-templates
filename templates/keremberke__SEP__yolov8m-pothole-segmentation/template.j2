{% set repo_id = repo_id | default("keremberke/yolov8m-pothole-segmentation") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import os
from pathlib import Path
from urllib.parse import urlparse

import numpy as np
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if str(image).startswith(("http://", "https://")):
    from urllib.request import urlopen
    image_obj = Image.open(urlopen(image)).convert("RGB")
else:
    image_obj = Image.open(image).convert("RGB")

model = YOLO(weights_path)
model.to(device)
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(image_obj, device=device)
result = results[0]
render = result.plot()

boxes = result.boxes
masks = result.masks
output = {
    "boxes": boxes,
    "masks": masks,
    "render": render,
}

RESULT = {"output": output}
