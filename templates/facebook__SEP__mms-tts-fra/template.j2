{% set repo_id = repo_id | default("facebook/mms-tts-fra") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Bonjour, ceci est un test de synthèse vocale en français.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import VitsModel, AutoTokenizer

model = VitsModel.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    waveform = model(**inputs).waveform

RESULT = {"waveform": waveform.detach().cpu().numpy(), "sampling_rate": model.config.sampling_rate}
