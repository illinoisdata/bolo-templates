{% set device = "cuda:0" %}
{% set repo_id = "hyunwoongko/ctrlsum-cnndm" %}
{% set article = "The article describes the latest advancements in the tech industry." %}
{% set max_length = 128 %}
{% set min_length = 12 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
article = "{{ article }}"
max_length = {{ max_length }}
min_length = {{ min_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(article, return_tensors="pt", truncation=True)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_ids = model.generate(
    **inputs,
    max_length=max_length,
    min_length=min_length,
    num_beams=num_beams,
    early_stopping=True,
)

summary = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"summary": summary}
