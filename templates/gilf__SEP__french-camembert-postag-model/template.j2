{% set repo_id = repo_id | default("gilf/french-camembert-postag-model") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Face à un choc inédit, les mesures mises en place par le gouvernement ont permis une protection forte et efficace des ménages.") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
