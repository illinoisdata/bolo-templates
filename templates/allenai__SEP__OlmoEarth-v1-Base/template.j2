{% set repo_id = repo_id | default("allenai/OlmoEarth-v1-Base") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set modality = modality | default('sentinel2_l2a') %}
{% set patch_size = patch_size | default(4) %}
{% set normalize = normalize | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
modality = "{{ modality }}"
patch_size = {{ patch_size }}
normalize = {{ normalize }}

import os
import json
import torch
import numpy as np
from PIL import Image
from io import BytesIO
from urllib.parse import urlparse
from urllib.request import urlopen
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="weights.pth")

config = json.load(open(config_path, "r"))
state_dict = torch.load(weights_path, map_location="cpu")
if isinstance(state_dict, dict) and "state_dict" in state_dict:
    state_dict = state_dict["state_dict"]

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    image = Image.open(BytesIO(urlopen(image_path).read())).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

arr = np.array(image).astype(np.float32) / 255.0
if arr.ndim == 2:
    arr = np.repeat(arr[..., None], 3, axis=2)
if arr.shape[2] > 3:
    arr = arr[:, :, :3]

h, w, c = arr.shape
ph = (patch_size - h % patch_size) % patch_size
pw = (patch_size - w % patch_size) % patch_size
if ph or pw:
    arr = np.pad(arr, ((0, ph), (0, pw), (0, 0)), mode="reflect")

x = torch.from_numpy(arr).permute(2, 0, 1).unsqueeze(0).to(device)

keys = list(state_dict.keys())
weight_key = None
for k in keys:
    if k.endswith("patch_embed.proj.weight") or "patch_embed" in k:
        weight_key = k
        break
if weight_key is None:
    for k in keys:
        if state_dict[k].ndim >= 2:
            weight_key = k
            break

weight = state_dict[weight_key].to(device)
out_channels = weight.shape[0]
in_channels = weight.shape[1] if weight.ndim >= 2 else x.shape[1]
kh = weight.shape[2] if weight.ndim == 4 else patch_size
kw = weight.shape[3] if weight.ndim == 4 else patch_size

if x.shape[1] != in_channels:
    if x.shape[1] > in_channels:
        x = x[:, :in_channels]
    else:
        reps = (in_channels + x.shape[1] - 1) // x.shape[1]
        x = x.repeat(1, reps, 1, 1)[:, :in_channels]

conv = torch.nn.Conv2d(in_channels=in_channels, out_channels=out_channels, kernel_size=(kh, kw), stride=(kh, kw), bias=False).to(device)
with torch.no_grad():
    conv.weight.copy_(weight)
    patches = conv(x)
    embedding = patches.flatten(2).mean(dim=2).squeeze(0)

RESULT = {"embedding": embedding.detach().cpu().numpy()}
