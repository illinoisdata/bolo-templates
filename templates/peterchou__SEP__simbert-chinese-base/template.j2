{% set repo_id = repo_id | default("peterchou/simbert-chinese-base") %}
{% set device = device | default("cuda:0") %}
{% set text_a = text_a|default('今天天气很好') %}
{% set text_b = text_b|default('天气不错') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_a = "{{ text_a }}"
text_b = "{{ text_b }}"

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModel

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(weights_path)
tokenizer = AutoTokenizer.from_pretrained(model_dir, local_files_only=True)
model = AutoModel.from_pretrained(model_dir, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer(text_a, text_b, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

sentence_embedding = outputs.last_hidden_state[:, 0, :].detach().cpu()
cosine_similarity = torch.nn.functional.cosine_similarity(sentence_embedding[0:1], sentence_embedding[0:1]).item()

RESULT = {
    "sentence_embedding": sentence_embedding,
    "cosine_similarity": cosine_similarity,
}
