{% set repo_id = "google/pegasus-x-base" %}
{% set device = "cuda:0" %}
{% set text_input = "The quick brown fox jumps over the lazy dog." %}
{% set input_max_length = 1024 %}
{% set generation_max_length = 256 %}
{% set max_new_tokens = 128 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
input_max_length = {{ input_max_length }}
generation_max_length = {{ generation_max_length }}
max_new_tokens = {{ max_new_tokens }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(
    text_input,
    return_tensors="pt",
    truncation=True,
    max_length=input_max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

generated_tokens = model.generate(
    **inputs,
    max_length=generation_max_length,
    max_new_tokens=max_new_tokens,
)

generated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
