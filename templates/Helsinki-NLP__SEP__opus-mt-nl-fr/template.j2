{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-nl-fr") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default('Dit is een testzin.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}

from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download
import torch

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
source_spm_file = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_file = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

tokenizer = MarianTokenizer(vocab=vocab_file, source_spm=source_spm_file, target_spm=target_spm_file)
model = MarianMTModel.from_pretrained(repo_id, local_files_only=True)
model.to(device)
model.eval()

inputs = tokenizer([input_text], return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=6, max_length=512)
output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
