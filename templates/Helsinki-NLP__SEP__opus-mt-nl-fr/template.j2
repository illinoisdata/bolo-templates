{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-nl-fr") %}
{% set text = text | default("Ik hou van programmeren.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_length = {{ max_length }}

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(text, return_tensors="pt")
encoded_inputs = {name: tensor.to(device) for name, tensor in encoded_inputs.items()}

generated_ids = model.generate(**encoded_inputs, max_length=max_length)
translations = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)
translation = translations[0]

RESULT = {"translation": translation}
