{% set repo_id = "MarcoMancini/low-law-emb" %}
{% set device = "cuda:0" %}
{% set sentences = ["This is an example sentence for embedding.", "Each sentence is converted into a dense vector representation."] %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/MarcoMancini__SEP__low-law-emb" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
sentences = {{ sentences | tojson }}
output_dir = "{{ output_dir }}"

from pathlib import Path

import numpy as np
import torch
from transformers import AutoModel, AutoTokenizer

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(
    sentences,
    padding=True,
    truncation=True,
    return_tensors="pt",
)
encoded_inputs = {key: value.to(torch_device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

hidden_states = outputs.last_hidden_state
attention_mask = encoded_inputs["attention_mask"].unsqueeze(-1)
masked_hidden_states = hidden_states * attention_mask
sum_hidden = masked_hidden_states.sum(dim=1)
mask_sum = attention_mask.sum(dim=1).clamp(min=1e-9)
embeddings = sum_hidden / mask_sum
embeddings = embeddings.cpu().numpy()

RESULT = {"embeddings": embeddings}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    np.save(output_path / "embeddings.npy", RESULT["embeddings"])