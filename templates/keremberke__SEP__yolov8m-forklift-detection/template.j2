{% set repo_id = repo_id | default("keremberke/yolov8m-forklift-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import os
from pathlib import Path
import json
import numpy as np
from PIL import Image
import requests
from io import BytesIO
import torch
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if image.startswith(("http://", "https://")):
    pil_image = Image.open(BytesIO(requests.get(image, timeout=30).content)).convert("RGB")
else:
    pil_image = Image.open(image).convert("RGB")

model = YOLO(weights_path)
results = model.predict(source=pil_image, device=device, conf=conf, iou=iou, agnostic_nms=agnostic_nms, max_det=max_det, verbose=False)
boxes = results[0].boxes
render = results[0].plot()

RESULT = {
    "boxes": boxes,
    "render": render,
}
