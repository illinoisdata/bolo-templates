{% set repo_id = repo_id | default("Prior-Labs/tabpfn_2_5") %}
{% set device = device | default("cuda:0") %}
{% set checkpoint_filename = checkpoint_filename | default('tabpfn-v2.5-classifier-v2.5_default.ckpt') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
checkpoint_filename = "{{ checkpoint_filename }}"

import os
import json
import numpy as np
import pandas as pd
import torch
from huggingface_hub import hf_hub_download
from tabpfn import TabPFNClassifier

model_path = hf_hub_download(repo_id=repo_id, filename=checkpoint_filename)

X = pd.DataFrame(
    [
        [5.1, 3.5, 1.4, 0.2],
        [4.9, 3.0, 1.4, 0.2],
        [6.2, 3.4, 5.4, 2.3],
        [5.9, 3.0, 5.1, 1.8],
        [5.0, 3.6, 1.4, 0.2],
        [6.7, 3.1, 4.7, 1.5],
        [6.3, 2.9, 5.6, 1.8],
        [5.5, 2.3, 4.0, 1.3],
    ],
    columns=["sepal_length", "sepal_width", "petal_length", "petal_width"],
)
y = np.array([0, 0, 2, 2, 0, 1, 2, 1])

classifier = TabPFNClassifier(model_path=model_path, device=device)
classifier.fit(X, y)
proba = classifier.predict_proba(X)
preds = classifier.predict(X)

RESULT = {
    "predictions": preds.tolist(),
    "probabilities": proba.tolist(),
}
