{%- set source_text = "Hej från Sverige." %}
{%- set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-gmq-en" %}
{%- set device = device %}
{%- set repo_id = repo_id %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path
import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)

tokenized = tokenizer([source_text], return_tensors="pt", padding=True)
tokenized = {key: value.to(device) for key, value in tokenized.items()}

with torch.no_grad():
    generated_tokens = model.generate(**tokenized)

decoded = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    translation_path = output_path / "translation.txt"
    translation_path.write_text(translation)