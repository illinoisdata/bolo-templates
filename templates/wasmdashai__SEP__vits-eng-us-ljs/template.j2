{% set repo_id = repo_id | default("wasmdashai/vits-eng-us-ljs") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Hello, this is a test of the VITS English voice model.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import json
import torch
import numpy as np
from transformers import VitsModel, AutoTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
added_tokens_path = hf_hub_download(repo_id=repo_id, filename="added_tokens.json")

model = VitsModel.from_pretrained(repo_id, torch_dtype=torch.float32).to(device)
model.eval()
tokenizer = AutoTokenizer.from_pretrained(repo_id)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    output = model(**inputs)

waveform = output.waveform.squeeze().detach().cpu().numpy()
if waveform.ndim == 0:
    waveform = waveform[None]

RESULT = {"audio": waveform, "sampling_rate": 16000}
