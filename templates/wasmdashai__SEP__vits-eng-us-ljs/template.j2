{% set device = "cuda:0" %}
{% set repo_id = "wasmdashai/vits-eng-us-ljs" %}
{% set text_input = "The quick brown fox jumps over the lazy dog." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import os
from pathlib import Path

import soundfile as sf
import torch
from transformers import pipeline

# initialize text-to-speech pipeline
torch_device = torch.device(device)
tts = pipeline("text-to-speech", model=repo_id, device=torch_device)

# run inference
tts_outputs = tts(text_input)
if isinstance(tts_outputs, list):
    tts_outputs = tts_outputs[0]

# post-process output
speech_array = tts_outputs.get("audio")
if speech_array is None:
    speech_array = tts_outputs.get("array")
SAMPLE_RATE = tts_outputs.get("sampling_rate", tts.model.config.sampling_rate)

RESULT = {"speech": speech_array}
