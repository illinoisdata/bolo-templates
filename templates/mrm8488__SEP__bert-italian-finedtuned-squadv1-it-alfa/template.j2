{% set repo_id = repo_id | default("mrm8488/bert-italian-finedtuned-squadv1-it-alfa") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default("Per quale lingua stai lavorando?") %}
{% set context = context | default("Manuel Romero è colaborando attivamente con HF / trasformatori per il trader del poder de las últimas técnicas di procesamiento de lenguaje natural al idioma español") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = {{ question | tojson }}
context = {{ context | tojson }}

import os
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

model_dir = os.path.dirname(model_file)


tokenizer = AutoTokenizer.from_pretrained(model_dir, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(model_dir)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx:end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()
score = float((torch.softmax(start_logits, dim=-1)[0, start_idx] * torch.softmax(end_logits, dim=-1)[0, end_idx]).item())

RESULT = {"answer": answer, "start": start_idx, "end": end_idx, "score": score}
