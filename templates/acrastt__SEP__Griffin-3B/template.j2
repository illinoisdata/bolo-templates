{% set repo_id = repo_id | default("acrastt/Griffin-3B") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set prompt = prompt | default("Hello, my name is Eric, how are you?") %}
{% set model = model | default(repo_id) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
