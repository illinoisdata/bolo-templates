{% set repo_id = repo_id | default("autogluon/mitra-classifier") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"

import json
import os

import pandas as pd
from huggingface_hub import hf_hub_download
from sklearn.datasets import load_wine

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    config = json.load(f)

wine = load_wine(as_frame=True)
df = wine.frame.copy()
if "target" not in df.columns:
    df["target"] = wine.target
input_df = df.iloc[10:12].copy().drop(columns=["target"])

summary = {
    "repo_id": repo_id,
    "device": device,
    "config": config,
    "weights_file": os.path.basename(weights_path),
    "input_shape": tuple(input_df.shape),
    "input_preview": input_df.head(1).to_dict(orient="records")[0],
}

RESULT = {"output": summary}
