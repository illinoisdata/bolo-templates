{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-az-en" %}
{% set source_text = "Salam dunya!" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"

import torch
from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

torch_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)
model.eval()

encoded_inputs = tokenizer(source_text, return_tensors="pt")
encoded_inputs = {name: tensor.to(torch_device) for name, tensor in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
decoded_outputs = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_outputs[0] if len(decoded_outputs) == 1 else decoded_outputs

RESULT = {"translation": translation}
