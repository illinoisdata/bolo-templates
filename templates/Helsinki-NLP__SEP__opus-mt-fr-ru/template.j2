{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-fr-ru") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('Bonjour le monde !') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")

# Load tokenizer/model from downloaded repository files
_tokenizer_dir = __import__('os').path.dirname(tokenizer_config_path)
tokenizer = AutoTokenizer.from_pretrained(_tokenizer_dir, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(_tokenizer_dir, torch_dtype=torch.float32)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_length=128, num_beams=4)

output_text = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]
RESULT = {"translation": output_text}
