{% set repo_id = repo_id | default("beyond/genius-large-k2t") %}
{% set device = device | default("cuda:0") %}
{% set sketch = sketch | default("machine learning data science my future work") %}
{% set max_length = max_length | default(100) %}
{% set num_beams = num_beams | default(2) %}
{% set do_sample = do_sample | default(true) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
sketch = "{{ sketch }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
do_sample = {{ do_sample }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_input = tokenizer(sketch, return_tensors="pt").to(device)
generated_ids = model.generate(**encoded_input, max_length=max_length, num_beams=num_beams, do_sample=do_sample)
generated_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": generated_text}
