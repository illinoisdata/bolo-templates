{% set repo_id = "Helsinki-NLP/opus-mt-es-eu" %}
{% set device = "cuda:0" %}
{% set input_text = "Hola, ¿cómo estás? Espero que tengas un buen día." %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
{% set save_filename = "translation.txt" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}
save_filename = "{{ save_filename }}"

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)
model.eval()

model_inputs = tokenizer(input_text, return_tensors="pt", truncation=True, max_length=max_length)
model_inputs = {k: v.to(device) for k, v in model_inputs.items()}

generated_tokens = model.generate(**model_inputs, max_length=max_length, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
