{% set repo_id = repo_id | default("linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set image_processor = image_processor | default("google/mobilenet_v2_1.0_224") %}

task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
image_processor = {{ image_processor | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=repo_id, device=device, image_processor=image_processor)
inference_output = pipe(input_image)
RESULT = {"inference_output": inference_output}
