{% set repo_id = repo_id | default("cmarkea/distilcamembert-base-nli") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("zero-shot-classification") %}
{% set selected_model = selected_model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Le style très cinéphile de Quentin Tarantino se reconnaît entre autres par sa narration postmoderne et non linéaire, ses dialogues travaillés souvent émaillés de références à la culture populaire, et ses scènes hautement esthétiques mais d'une violence extrême, inspirées de films d'exploitation, d'arts martiaux ou de western spaghetti.") %}
{% set candidate_labels = candidate_labels | default(["cinéma", "technologie", "littérature", "politique"]) %}
{% set hypothesis_template = hypothesis_template | default("Ce texte parle de {}.") %}
task = {{ task | tojson }}
model = {{ selected_model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
candidate_labels = {{ candidate_labels | tojson }}
hypothesis_template = {{ hypothesis_template | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(
    input_prompt,
    candidate_labels=candidate_labels,
    hypothesis_template=hypothesis_template,
)
