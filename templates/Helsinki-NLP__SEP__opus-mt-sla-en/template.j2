{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-sla-en") %}
{% set source_text = source_text | default("Pozdravljen svet!") %}
{% set max_new_tokens = max_new_tokens | default(100) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_new_tokens = {{ max_new_tokens }}

import os
import torch
from transformers import MarianMTModel, MarianTokenizer

torch_device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id).to(torch_device)

encoded_input = tokenizer(source_text, return_tensors="pt", padding=True).to(torch_device)

generated_tokens = model.generate(**encoded_input, max_new_tokens=max_new_tokens)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translated_text}
