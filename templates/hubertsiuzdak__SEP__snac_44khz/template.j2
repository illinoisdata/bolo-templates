{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set repo_id = repo_id | default("hubertsiuzdak/snac_44khz") %}
{% set device = device | default("cuda:0") %}
{% set target_sr = target_sr | default(44100) %}
{% set max_seconds = max_seconds | default(1.0) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
target_sr = {{ target_sr }}
max_seconds = {{ max_seconds }}

import os
import io
import torch
import torch.nn.functional as F
import requests
import soundfile as sf
import librosa
from huggingface_hub import hf_hub_download
from snac import SNAC

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

if audio_path.startswith(("http://", "https://")):
    response = requests.get(audio_path, timeout=30)
    response.raise_for_status()
    audio, sr = sf.read(io.BytesIO(response.content), dtype="float32")
else:
    audio, sr = sf.read(audio_path, dtype="float32")

if audio.ndim > 1:
    audio = audio.mean(axis=1)

if sr != target_sr:
    audio = librosa.resample(audio, orig_sr=sr, target_sr=target_sr)
    sr = target_sr

max_len = int(max_seconds * sr)
if audio.shape[0] > max_len:
    audio = audio[:max_len]

waveform = torch.tensor(audio, dtype=torch.float32).unsqueeze(0).unsqueeze(0)
if waveform.shape[-1] < max_len:
    waveform = F.pad(waveform, (0, max_len - waveform.shape[-1]))

torch_device = torch.device(device if (device.startswith("cuda") and torch.cuda.is_available()) else "cpu")
model = SNAC.from_pretrained(repo_id).to(torch_device).eval()

with torch.inference_mode():
    waveform = waveform.to(torch_device)
    reconstructed, codes = model(waveform)

output_audio = reconstructed.squeeze(0).squeeze(0).detach().cpu()
code_shapes = [tuple(c.shape) for c in codes]
RESULT = {"audio": output_audio, "code_shapes": code_shapes, "sample_rate": sr}
