{% set repo_id = repo_id | default("timm/vit_small_patch16_dinov3.lvd1689m") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-feature-extraction") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from transformers import pipeline
from PIL import Image

pipe = pipeline(task=task, model=repo_id, device=device)

preprocessed_image = Image.open(input_image).convert("RGB")

inference_outputs = pipe(preprocessed_image)

RESULT = {"outputs": inference_outputs}
