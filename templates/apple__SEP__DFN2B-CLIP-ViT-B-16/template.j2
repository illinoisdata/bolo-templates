{% set labels_list = labels_list | default(['a dog', 'a cat', 'a donut', 'a beignet']) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
labels_list = {{ labels_list | tojson }}

import torch
import torch.nn.functional as F
from PIL import Image
from urllib.parse import urlparse
from open_clip import create_model_from_pretrained, get_tokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename="open_clip_pytorch_model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="open_clip_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.json")
_ = hf_hub_download(repo_id=repo_id, filename="merges.txt")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

if urlparse(image_path).scheme in ("http", "https"):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model, preprocess = create_model_from_pretrained("hf-hub:" + repo_id)
model = model.to(device)
model.eval()
tokenizer = get_tokenizer("ViT-B-16")

image_tensor = preprocess(image).unsqueeze(0).to(device)
text_tokens = tokenizer(labels_list, context_length=model.context_length).to(device)

with torch.no_grad():
    image_features = model.encode_image(image_tensor)
    text_features = model.encode_text(text_tokens)
    image_features = F.normalize(image_features, dim=-1)
    text_features = F.normalize(text_features, dim=-1)
    logits = image_features @ text_features.T * model.logit_scale.exp()
    if model.logit_bias is not None:
        logits = logits + model.logit_bias
    text_probs = torch.sigmoid(logits)

RESULT = {"labels": labels_list, "probabilities": text_probs[0].detach().cpu().tolist()}
