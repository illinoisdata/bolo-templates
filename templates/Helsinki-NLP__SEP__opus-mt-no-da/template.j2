{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-no-da") %}
{% set device = device | default("cuda:0") %}
{% set src_texts = src_texts | default(["The quick brown fox jumps over the lazy dog."]) %}
{% set max_length = max_length | default(512) %}
{% set num_beams = num_beams | default(6) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_texts = {{ src_texts }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(src_texts, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
