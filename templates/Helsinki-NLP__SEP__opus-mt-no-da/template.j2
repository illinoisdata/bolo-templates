{% set repo_id = "Helsinki-NLP/opus-mt-no-da" %}
{% set device = "cuda:0" %}
{% set src_texts = ["The quick brown fox jumps over the lazy dog."] %}
{% set max_length = 512 %}
{% set num_beams = 6 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-no-da" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_texts = {{ src_texts }}
max_length = {{ max_length }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(src_texts, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

generated_tokens = model.generate(**inputs, max_length=max_length, num_beams=num_beams)

translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_file = os.path.join(output_dir, "translations.txt")
    with open(output_file, "w", encoding="utf-8") as f:
        for line in RESULT["translations"]:
            f.write(line + "\n")