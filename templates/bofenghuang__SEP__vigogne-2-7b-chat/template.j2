{% set repo_id = repo_id | default("bofenghuang/vigogne-2-7b-chat") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Bonjour ! Pouvez-vous me proposer un résumé court de l'histoire de l'art français ?") %}

task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
