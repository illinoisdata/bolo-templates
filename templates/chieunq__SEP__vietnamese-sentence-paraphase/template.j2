{% set input_text = "Thật tự hào khi là sinh viên trường Đại học Công nghệ" %}
{% set max_length = 64 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/chieunq__SEP__vietnamese-sentence-paraphase" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

preprocessed_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding="longest",
    truncation=True,
    max_length=max_length,
)
preprocessed_inputs = {key: value.to(device) for key, value in preprocessed_inputs.items()}

generated_outputs = model.generate(**preprocessed_inputs, max_length=max_length)
paraphrased_text = tokenizer.decode(
    generated_outputs[0],
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)

RESULT = {"paraphrased_text": paraphrased_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    text_file = output_path / "paraphrased_text.txt"
    text_file.write_text(RESULT["paraphrased_text"], encoding="utf-8")