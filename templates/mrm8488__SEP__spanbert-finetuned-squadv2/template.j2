{% set repo_id = repo_id | default("mrm8488/spanbert-finetuned-squadv2") %}
{% set device = device | default("cuda:0") %}
{% set context = context | default('Manuel Romero has been working hardly in the repository hugginface/transformers lately') %}
{% set question = question | default('Who has been working hard for hugginface/transformers lately?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
context = {{ context | tojson }}
question = {{ question | tojson }}

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
import torch

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")

# Load tokenizer/model
# tokenizer_config and special tokens map are downloaded to ensure files exist locally

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForQuestionAnswering.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors="pt", truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

start_logits = outputs.start_logits
end_logits = outputs.end_logits
start_idx = int(torch.argmax(start_logits, dim=-1).item())
end_idx = int(torch.argmax(end_logits, dim=-1).item())
if end_idx < start_idx:
    end_idx = start_idx

input_ids = inputs["input_ids"][0]
answer_tokens = input_ids[start_idx:end_idx + 1]
answer = tokenizer.decode(answer_tokens, skip_special_tokens=True).strip()

RESULT = {"answer": answer, "start": start_idx, "end": end_idx}
