{% set repo_id = repo_id | default("aiassociates/t5-small-grammar-correction-german") %}
{% set device = device | default("cuda:0") %}
{% set input_text = input_text | default("hier ein kleines beispiel was haltet ihr von der korrektur") %}
{% set prefix = prefix | default("grammar: ") %}
{% set num_beams = num_beams | default(5) %}
{% set min_length = min_length | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
prefix = "{{ prefix }}"
num_beams = {{ num_beams }}
min_length = {{ min_length }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
import torch
import os

# Load model and tokenizer
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

# Preprocess input text with the required prefix
text = prefix + input_text
inputs = tokenizer(text, return_tensors="pt").to(device)

# Inference
output_ids = model.generate(**inputs, num_beams=num_beams, min_length=min_length)

# Post-process and build RESULT dict
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)
RESULT = {"generated_text": output_text}
