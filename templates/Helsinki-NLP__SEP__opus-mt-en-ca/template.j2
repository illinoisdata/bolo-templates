{% set source_text = "The weather is nice today." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-ca" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
output_dir = "{{ output_dir }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(source_text, return_tensors="pt")
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(**tokenized_inputs, num_beams=num_beams, max_length=max_length)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translated_text": translated_text[0]}

if __name__ == "__main__":
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    (Path(output_dir) / "translation.txt").write_text(RESULT["translated_text"], encoding="utf-8")