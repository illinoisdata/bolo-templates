{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-en-ca") %}
{% set source_text = source_text | default("The weather is nice today.") %}
{% set max_length = max_length | default(128) %}
{% set num_beams = num_beams | default(4) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

tokenized_inputs = tokenizer(source_text, return_tensors="pt")
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_tokens = model.generate(**tokenized_inputs, num_beams=num_beams, max_length=max_length)

translated_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translated_text": translated_text[0]}
