{% set repo_id = repo_id | default("airkingbd/dplm_150m") %}
{% set device = device | default("cuda:0") %}
{% set text_input = text_input | default('MKTFFVLLL') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoConfig, AutoTokenizer, EsmForMaskedLM

weights_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

config = AutoConfig.from_pretrained(config_path)
tokenizer = AutoTokenizer.from_pretrained(
    repo_id,
    vocab_file=vocab_path,
    special_tokens_map_file=special_tokens_path,
    tokenizer_config_file=tokenizer_config_path,
    use_fast=False,
)
model = EsmForMaskedLM(config)
state_dict = torch.load(weights_path, map_location="cpu")
state_dict.pop("esm.embeddings.position_embeddings.weight", None)
model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
predicted_token_ids = logits.argmax(dim=-1)
predicted_tokens = tokenizer.convert_ids_to_tokens(predicted_token_ids[0].tolist())

RESULT = {
    "input_text": text_input,
    "predicted_token_ids": predicted_token_ids[0].detach().cpu().tolist(),
    "predicted_tokens": predicted_tokens,
    "logits_shape": list(logits.shape),
}
