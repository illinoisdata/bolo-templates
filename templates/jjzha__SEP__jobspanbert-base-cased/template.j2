{% set repo_id = repo_id | default("jjzha/jobspanbert-base-cased") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('The candidate should have strong Python and machine learning experience.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
local_dir = os.path.dirname(vocab_path)

tokenizer = AutoTokenizer.from_pretrained(local_dir, use_fast=False)
model = AutoModelForMaskedLM.from_pretrained(local_dir, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
mask_token_id = tokenizer.mask_token_id
input_ids = inputs["input_ids"]
mask_positions = (input_ids[0] == mask_token_id).nonzero(as_tuple=False).flatten()
position = int(mask_positions[0].item()) if len(mask_positions) > 0 else input_ids.shape[1] - 1
pred_logits = logits[0, position]
topk = torch.topk(pred_logits, k=5)
top_tokens = tokenizer.convert_ids_to_tokens(topk.indices.tolist())
dist = torch.softmax(pred_logits, dim=-1)

RESULT = {
    "top_tokens": top_tokens,
    "top_token_ids": topk.indices.tolist(),
    "top_token_scores": topk.values.tolist(),
    "predicted_distribution_max_prob": float(dist.max().item()),
}
