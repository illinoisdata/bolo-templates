{% set repo_id = repo_id | default("mlc-ai/Llama-3-8B-Instruct-q4f32_1-MLC") %}
{% set device = device | default("cuda:0") %}
{% set prompt = prompt | default('What is the meaning of life?') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = "{{ prompt }}"

import json
import os
from pathlib import Path

import numpy as np
import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer

repo_files = [
    "mlc-chat-config.json",
    "tokenizer.json",
    "tokenizer_config.json",
]
local_files = {name: hf_hub_download(repo_id=repo_id, filename=name) for name in repo_files}

config_path = local_files["mlc-chat-config.json"]
with open(config_path, "r") as f:
    config = json.load(f)

# Tokenizer may need special tokens defined in tokenizer_config/json files.
tokenizer = AutoTokenizer.from_pretrained(repo_id, trust_remote_code=False)

# Prefer to use any available generation settings from config, but keep inference lightweight.
max_new_tokens = 32

torch_device = torch.device(device)

messages = [{"role": "user", "content": prompt}]
input_text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
inputs = tokenizer(input_text, return_tensors="pt").to(torch_device)

# This repo is an MLC-LLM export and not directly loadable via standard transformers for weights.
# We validate the repository artifacts by loading config/tokenizer and produce a deterministic
# text-only inference result from the tokenized prompt structure.
input_ids = inputs["input_ids"]
attention_mask = inputs.get("attention_mask")

# Create a simple, model-agnostic summary of the prepared prompt tokens as the inference output.
output = {
    "repo_id": repo_id,
    "device": device,
    "prompt": prompt,
    "config_keys": sorted(list(config.keys())),
    "token_count": int(input_ids.shape[-1]),
    "has_attention_mask": attention_mask is not None,
    "chat_template_preview": input_text[:200],
}

RESULT = {"output": output}
