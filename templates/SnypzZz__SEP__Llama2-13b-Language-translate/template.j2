{% set repo_id = repo_id | default("SnypzZz/Llama2-13b-Language-translate") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('The head of the United Nations says there is no military solution in Syria') %}
{% set target_lang = target_lang | default('hi_IN') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
target_lang = "{{ target_lang }}"

from transformers import MBartForConditionalGeneration, MBart50TokenizerFast
import torch

model_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
config_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='config.json')
tokenizer_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='sentencepiece.bpe.model')
special_tokens_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='special_tokens_map.json')
tokenizer_config_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='tokenizer_config.json')
generation_config_path = __import__('huggingface_hub').hf_hub_download(repo_id=repo_id, filename='generation_config.json')

model = MBartForConditionalGeneration.from_pretrained(__import__('os').path.dirname(model_path), local_files_only=True)
tokenizer = MBart50TokenizerFast.from_pretrained(__import__('os').path.dirname(tokenizer_path), src_lang='en_XX', local_files_only=True)
model = model.to(device)

model_inputs = tokenizer(src_text, return_tensors='pt')
model_inputs = {k: v.to(device) for k, v in model_inputs.items()}

generated_tokens = model.generate(
    **model_inputs,
    forced_bos_token_id=tokenizer.lang_code_to_id[target_lang],
)
output_text = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": output_text}
