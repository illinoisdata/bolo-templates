{% set repo_id = "Helsinki-NLP/opus-mt-en-ro" %}
{% set device = "cuda:0" %}
{% set input_text = "Hello, how are you today?" %}
{% set max_new_tokens = 60 %}
{% set num_beams = 4 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-en-ro" %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}
output_dir = "{{ output_dir }}"

import os
import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

torch_device = torch.device(device)
tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

inputs = tokenizer(input_text, return_tensors="pt", padding=True)
inputs = inputs.to(torch_device)

generated_tokens = model.generate(**inputs, max_new_tokens=max_new_tokens, num_beams=num_beams)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(RESULT["translation"])