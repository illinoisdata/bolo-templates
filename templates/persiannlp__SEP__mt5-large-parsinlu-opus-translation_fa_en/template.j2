{% set repo_id = repo_id %}
{% set device = device %}
{% set input_text = "ستایش خدای را که پروردگار جهانیان است." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/persiannlp__SEP__mt5-large-parsinlu-opus-translation_fa_en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

encoded_inputs = tokenizer(input_text, return_tensors="pt", padding=True, truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(**encoded_inputs)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation_text = translations[0] if len(translations) == 1 else translations

RESULT = {"translation": translation_text}

if __name__ == "__main__":
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    translation_file = output_path / "translation.txt"
    translation_file.write_text(translation_text if isinstance(translation_text, str) else "\n".join(translation_text), encoding="utf-8")