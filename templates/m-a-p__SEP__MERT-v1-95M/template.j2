{% set repo_id = repo_id | default("m-a-p/MERT-v1-95M") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("audio-classification") %}
{% set input_data = input_data | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_data = {{ input_data | tojson }}

from transformers import AutoModel, Wav2Vec2FeatureExtractor, pipeline
from transformers.pipelines import AudioClassificationPipeline

class MERTFeatureExtractionPipeline(AudioClassificationPipeline):
    def check_model_type(self, supported_models):
        return

    def _forward(self, model_inputs):
        return self.model(**model_inputs, output_hidden_states=True, return_dict=True)

    def postprocess(self, model_outputs, **kwargs):
        hidden_states = getattr(model_outputs, "last_hidden_state", None)
        if hidden_states is None:
            hidden_states = model_outputs.hidden_states[-1]
        return hidden_states.cpu().detach().tolist()

feature_extractor = Wav2Vec2FeatureExtractor.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id, trust_remote_code=True).to(device)
model.eval()

pipe = pipeline(
    task=task,
    model=model,
    feature_extractor=feature_extractor,
    device=device,
    pipeline_class=MERTFeatureExtractionPipeline,
)
RESULT = pipe(input_data)
