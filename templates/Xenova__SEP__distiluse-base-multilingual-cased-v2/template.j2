{% set repo_id = repo_id | default("Xenova/distiluse-base-multilingual-cased-v2") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("This is a multilingual sentence embedding example.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, DistilBertModel
import torch

_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
_ = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
_ = hf_hub_download(repo_id=repo_id, filename="onnx/model.onnx")

# Use the Transformers PyTorch architecture corresponding to the exported ONNX model.
tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = DistilBertModel.from_pretrained("sentence-transformers/distiluse-base-multilingual-cased-v2")
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
attention_mask = inputs["attention_mask"].unsqueeze(-1)
embeddings = (last_hidden_state * attention_mask).sum(dim=1) / attention_mask.sum(dim=1).clamp(min=1)
embeddings = torch.nn.functional.normalize(embeddings, p=2, dim=1)

RESULT = {"embeddings": embeddings.detach().cpu().tolist()}
