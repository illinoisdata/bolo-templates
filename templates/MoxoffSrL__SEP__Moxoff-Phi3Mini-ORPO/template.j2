{% set repo_id = repo_id | default("MoxoffSrL/Moxoff-Phi3Mini-ORPO") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set input_prompt = input_prompt | default("Summarize the purpose of Moxoff-Phi3Mini-ORPO in a single sentence.") %}

task = {{ task | tojson }}
repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from huggingface_hub import snapshot_download
from transformers import pipeline
import json
import os

local_model_path = snapshot_download(repo_id=repo_id)
config_file_path = os.path.join(local_model_path, "config.json")
with open(config_file_path, "r", encoding="utf-8") as config_file:
    config_dict = json.load(config_file)

rope_scaling = config_dict.pop("rope_scaling", None) or {}
rope_parameters = dict(config_dict.get("rope_parameters", {}))
rope_parameters.setdefault("rope_type", "longrope")
for factor_name in ("short_factor", "long_factor"):
    factor_values = rope_scaling.get(factor_name)
    if factor_values is not None:
        rope_parameters[factor_name] = factor_values
rope_parameters["original_max_position_embeddings"] = config_dict.get(
    "original_max_position_embeddings"
)
rope_parameters.setdefault("rope_theta", config_dict.get("rope_theta"))
config_dict["rope_parameters"] = rope_parameters

with open(config_file_path, "w", encoding="utf-8") as config_file:
    json.dump(config_dict, config_file, ensure_ascii=False)

pipe = pipeline(task=task, model=local_model_path, device=device)
RESULT = pipe(input_prompt)
