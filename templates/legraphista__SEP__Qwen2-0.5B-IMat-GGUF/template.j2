{% set repo_id = repo_id | default("legraphista/Qwen2-0.5B-IMat-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Qwen2-0.5B.Q4_K.gguf') %}
{% set prompt = prompt | default('Write a short, friendly haiku about machine learning.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

llm = Llama(model_path=model_path, n_ctx=512, n_threads=2, n_gpu_layers=-1 if device.startswith("cuda") else 0, verbose=False)
result = llm.create_chat_completion(
    messages=[
        {"role": "system", "content": "You are a helpful assistant."},
        {"role": "user", "content": prompt},
    ],
    temperature=0.0,
    max_tokens=32,
)

generated_text = result["choices"][0]["message"]["content"]
RESULT = {"generated_text": generated_text, "model_path": model_path}
