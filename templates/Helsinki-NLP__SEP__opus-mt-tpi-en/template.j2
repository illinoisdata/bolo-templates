{% set repo_id = "Helsinki-NLP/opus-mt-tpi-en" %}
{% set device = "cuda:0" %}
{% set input_text = "Mi laik kaikai." %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-tpi-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"
output_dir = "{{ output_dir }}"

import os
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

inputs = tokenizer(input_text, return_tensors="pt").to(device)
generated_tokens = model.generate(**inputs)
translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translation": translation}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "translation.txt"), "w", encoding="utf-8") as f:
        for t in RESULT["translation"]:
            f.write(t + "\n")