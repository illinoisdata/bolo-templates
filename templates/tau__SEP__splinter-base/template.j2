{% set repo_id = repo_id | default("tau/splinter-base") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('What is the answer span?') %}
{% set context = context | default('Splinter is a model pretrained in a self-supervised fashion for few-shot question answering. It uses the Recurring Span Selection objective and is case-sensitive.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"
context = "{{ context }}"

from transformers import SplinterTokenizer, SplinterForQuestionAnswering
import torch
from huggingface_hub import hf_hub_download
import os

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')
model_dir = os.path.dirname(weights_path)

tokenizer = SplinterTokenizer.from_pretrained(model_dir, local_files_only=True)
model = SplinterForQuestionAnswering.from_pretrained(model_dir, local_files_only=True, ignore_mismatched_sizes=True)
model.to(device)
model.eval()

inputs = tokenizer(question, context, return_tensors='pt', truncation=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)
    start_logits = outputs.start_logits
    end_logits = outputs.end_logits
    start_idx = int(torch.argmax(start_logits, dim=-1).item())
    end_idx = int(torch.argmax(end_logits, dim=-1).item())
    if end_idx < start_idx:
        end_idx = start_idx
    input_ids = inputs['input_ids'][0]
    answer = tokenizer.decode(input_ids[start_idx:end_idx + 1], skip_special_tokens=True)

RESULT = {"answer": answer, "start_index": start_idx, "end_index": end_idx}
