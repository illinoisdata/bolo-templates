device = "{{ device }}"
input_data = "{{ input_data }}"

# Imports
import wave

import numpy as np
from transformers import pipeline
from feature_extraction_maest import MAESTFeatureExtractor

# Audio helpers
def _read_wave(path: str) -> tuple[np.ndarray, int]:
    with wave.open(path, "rb") as reader:
        num_channels = reader.getnchannels()
        sample_width = reader.getsampwidth()
        sample_rate = reader.getframerate()
        raw_bytes = reader.readframes(reader.getnframes())
    if sample_width == 3:
        frames = np.frombuffer(raw_bytes, dtype=np.uint8).reshape(-1, 3)
        ints = (
            frames[:, 0].astype(np.int32)
            | (frames[:, 1].astype(np.int32) << 8)
            | (frames[:, 2].astype(np.int32) << 16)
        )
        ints = (ints << 8) >> 8
        waveform = ints.astype(np.float32) / float(2 ** 23)
    else:
        dtype = {1: np.uint8, 2: np.int16, 4: np.int32}.get(sample_width)
        if dtype is None:
            raise ValueError(f"Unsupported sample width: {sample_width} bytes")
        waveform = np.frombuffer(raw_bytes, dtype=dtype).astype(np.float32)
        if sample_width == 1:
            waveform = (waveform - 128.0) / 128.0
        elif sample_width == 2:
            waveform /= float(2 ** 15)
        else:
            waveform /= float(2 ** 31)
    if num_channels > 1:
        waveform = waveform.reshape(-1, num_channels).mean(axis=1)
    return waveform, sample_rate

def _resample_audio(waveform: np.ndarray, source_sr: int, target_sr: int) -> np.ndarray:
    if source_sr == target_sr or waveform.size == 0:
        return waveform.astype(np.float32)
    target_len = max(int(np.round(len(waveform) * target_sr / source_sr)), 1)
    positions = np.arange(len(waveform))
    target_positions = np.linspace(0, len(waveform) - 1, target_len)
    return np.interp(target_positions, positions, waveform).astype(np.float32)

# Load feature extractor & pipeline
feature_extractor = MAESTFeatureExtractor.from_pretrained(model)
pipe = pipeline(
    task=task,
    model=model,
    feature_extractor=feature_extractor,
    device=device,
)

target_sampling_rate = getattr(feature_extractor, "sampling_rate", 16000)
waveform, waveform_sr = _read_wave(input_data)
prepared_waveform = _resample_audio(waveform, waveform_sr, target_sampling_rate)
input_payload = {"array": prepared_waveform, "sampling_rate": target_sampling_rate}

# Run inference
RESULT = pipe(input_payload)
