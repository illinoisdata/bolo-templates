{% set repo_id = repo_id | default("MaziyarPanahi/SmolLM2-135M-Instruct-GGUF") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('SmolLM2-135M-Instruct.Q4_K_M.gguf') %}
{% set prompt = prompt | default('Write a short haiku about mountains.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"

import os
import torch
from huggingface_hub import hf_hub_download
from llama_cpp import Llama

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

n_gpu_layers = -1 if str(device).startswith('cuda') and torch.cuda.is_available() else 0
llm = Llama(
    model_path=model_path,
    n_ctx=256,
    n_threads=max(1, os.cpu_count() or 1),
    n_gpu_layers=n_gpu_layers,
    verbose=False,
)

response = llm(
    prompt,
    max_tokens=64,
    temperature=0.7,
    top_p=0.9,
    stop=["</s>"]
)

output_text = response["choices"][0]["text"]
RESULT = {"generated_text": output_text}
