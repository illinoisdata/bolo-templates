{% set repo_id = repo_id | default("Prior-Labs/TabPFN-v2-reg") %}
{% set device = device | default("cuda:0") %}
{% set X_csv = X_csv | default('/workspace/tabular_input.csv') %}
{% set y_col = y_col | default('target') %}
{% set quant_filename = quant_filename | default('tabpfn-v2-regressor.ckpt') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
X_csv = "{{ X_csv }}"
y_col = "{{ y_col }}"
quant_filename = "{{ quant_filename }}"

import os
import numpy as np
import pandas as pd
from huggingface_hub import hf_hub_download
from tabpfn import TabPFNRegressor

weights_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

if os.path.exists(X_csv):
    df = pd.read_csv(X_csv)
else:
    rng = np.random.default_rng(0)
    X = rng.normal(size=(200, 8))
    y = X[:, 0] * 3.0 - X[:, 1] * 2.0 + np.sin(X[:, 2]) + rng.normal(scale=0.1, size=200)
    cols = [f"f{i}" for i in range(X.shape[1])]
    df = pd.DataFrame(X, columns=cols)
    df[y_col] = y

if y_col in df.columns:
    y = df[y_col].to_numpy(dtype=np.float32)
    X_df = df.drop(columns=[y_col])
else:
    X_df = df.copy()
    y = None

X_df = X_df.select_dtypes(include=[np.number]).copy()
X = X_df.to_numpy(dtype=np.float32)

if X.shape[0] < 2:
    X = np.vstack([X, X])
    if y is not None:
        y = np.concatenate([y, y])

if y is None:
    y = X[:, 0] * 0.0

model = TabPFNRegressor(device=device, model_path=weights_path, show_progress_bar=False)
model.fit(X, y)
pred = model.predict(X[: min(5, len(X))])

RESULT = {
    "predictions": np.asarray(pred).tolist(),
    "num_rows": int(X.shape[0]),
    "num_features": int(X.shape[1]),
}
