{% set repo_id = repo_id | default("guillaumekln/faster-whisper-tiny") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}
{% set language = language | default("en") %}
{% set task = task | default("transcribe") %}
{% set beam_size = beam_size | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
task = "{{ task }}"
beam_size = {{ beam_size }}

import os
from pathlib import Path
from urllib.parse import urlparse

import numpy as np
import soundfile as sf
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_file = hf_hub_download(repo_id=repo_id, filename="model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")
model_dir = str(Path(model_file).parent)

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    import requests
    audio_bytes = requests.get(audio_path, timeout=30).content
    import io
    audio, sample_rate = sf.read(io.BytesIO(audio_bytes))
else:
    audio, sample_rate = sf.read(audio_path)

if audio.ndim > 1:
    audio = np.mean(audio, axis=1)

compute_type = "float32"
ct2_device = "cpu"
model = WhisperModel(model_dir, device=ct2_device, compute_type=compute_type)
segments, info = model.transcribe(audio, language=language, task=task, beam_size=beam_size)
transcript = "".join(segment.text for segment in segments).strip()

RESULT = {
    "text": transcript,
    "language": info.language,
    "language_probability": info.language_probability,
    "duration": info.duration,
}
