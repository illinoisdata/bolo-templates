{% set repo_id = repo_id | default("facebook/audiobox-aesthetics") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
start_time = {{ start_time }}
end_time = {{ end_time }}

import json
from pathlib import Path

import torch
from scipy.io import wavfile
from huggingface_hub import hf_hub_download
from audiobox_aesthetics.infer import initialize_predictor

weights_path = hf_hub_download(repo_id=repo_id, filename="checkpoint.pt")
hf_hub_download(repo_id=repo_id, filename="config.json")

if audio_path.startswith("http://") or audio_path.startswith("https://"):
    raise ValueError("Remote URL inputs are not supported in this execution environment.")

predictor = initialize_predictor(ckpt=weights_path)

sample_rate, audio_np = wavfile.read(audio_path)
audio_tensor = torch.as_tensor(audio_np)
if audio_tensor.dtype.is_floating_point:
    waveform = audio_tensor.float()
else:
    info = torch.iinfo(audio_tensor.dtype)
    waveform = audio_tensor.float() / float(info.max)
if waveform.ndim == 1:
    waveform = waveform.unsqueeze(0)
elif waveform.ndim == 2 and waveform.shape[0] > waveform.shape[1]:
    waveform = waveform.transpose(0, 1)

audio_input = {"path": waveform, "sample_rate": int(sample_rate)}
if start_time is not None:
    audio_input["start_time"] = start_time
if end_time is not None:
    audio_input["end_time"] = end_time

with torch.inference_mode():
    output = predictor.forward([audio_input])

if isinstance(output, list) and len(output) == 1:
    output = output[0]

RESULT = {"output": output}
