{% set text_input = "The quick brown fox jumps over the lazy dog." %}
{% set max_length = 128 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/imvladikon__SEP__general_character_bert" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os

import torch
from transformers import AutoModel, AutoTokenizer


tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.cpu()
pooler_output = None
if hasattr(outputs, "pooler_output") and outputs.pooler_output is not None:
    pooler_output = outputs.pooler_output.cpu()

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    torch.save(RESULT["last_hidden_state"], os.path.join(output_dir, "last_hidden_state.pt"))
    if RESULT["pooler_output"] is not None:
        torch.save(RESULT["pooler_output"], os.path.join(output_dir, "pooler_output.pt"))