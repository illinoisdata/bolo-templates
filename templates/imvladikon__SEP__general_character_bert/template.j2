{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("imvladikon/general_character_bert") %}
{% set text_input = text_input | default("The quick brown fox jumps over the lazy dog.") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"
max_length = {{ max_length }}

import os

import torch
from transformers import AutoModel, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModel.from_pretrained(repo_id).to(device)
model.eval()

inputs = tokenizer(
    text_input,
    return_tensors="pt",
    padding="max_length",
    truncation=True,
    max_length=max_length,
)
inputs = {key: value.to(device) for key, value in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state.cpu()
pooler_output = None
if hasattr(outputs, "pooler_output") and outputs.pooler_output is not None:
    pooler_output = outputs.pooler_output.cpu()

RESULT = {
    "last_hidden_state": last_hidden_state,
    "pooler_output": pooler_output,
}
