{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("naver-clova-ix/donut-base-finetuned-rvlcdip") %}
{% set task_prompt = task_prompt | default('<s_rvlcdip>') %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
task_prompt = "{{ task_prompt }}"

import torch
import requests
from PIL import Image
from io import BytesIO
from huggingface_hub import hf_hub_download
from transformers import DonutProcessor, VisionEncoderDecoderModel

weight_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
processor = DonutProcessor.from_pretrained(repo_id)
model = VisionEncoderDecoderModel.from_pretrained(repo_id)
state_dict = torch.load(weight_path, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

if image_path.startswith("http://") or image_path.startswith("https://"):
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

pixel_values = processor(image, return_tensors="pt").pixel_values.to(device)
generated_ids = model.generate(pixel_values, max_length=10)
output = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]

RESULT = {"output": output}
