{% set device = "cuda:0" %}
{% set repo_id = "mrm8488/t5-base-finetuned-span-sentiment-extraction" %}
{% set prompt = "question: positive context: On the monday, so i wont be able to be with you! i love you" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
prompt = """{{ prompt }}"""

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(prompt, return_tensors="pt", truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_ids = model.generate(**encoded_inputs, num_beams=4, max_length=80)
predicted_span = tokenizer.decode(generated_ids[0], skip_special_tokens=True, clean_up_tokenization_spaces=True)

RESULT = {"predicted_span": predicted_span}
