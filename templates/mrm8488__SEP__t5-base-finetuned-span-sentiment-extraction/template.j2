{% set repo_id = repo_id | default("mrm8488/t5-base-finetuned-span-sentiment-extraction") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('question: positive context: On the monday, so i wont be able to be with you! i love you') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
{% set num_beams = num_beams | default(1) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
max_new_tokens = {{ max_new_tokens }}
num_beams = {{ num_beams }}

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
hf_hub_download(repo_id=repo_id, filename="spiece.model")

input_device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(input_device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(input_device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, num_beams=num_beams, max_new_tokens=max_new_tokens)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True, clean_up_tokenization_spaces=True)
RESULT = {"output_text": output_text}
