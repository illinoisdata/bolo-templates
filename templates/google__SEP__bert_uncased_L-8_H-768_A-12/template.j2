{% set repo_id = repo_id | default("google/bert_uncased_L-8_H-768_A-12") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("Hello, I'm a [MASK] model.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import os
import json
import torch
from transformers import AutoTokenizer, AutoModelForMaskedLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForMaskedLM.from_pretrained(repo_id)
model.to(device)

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

logits = outputs.logits
mask_token_index = (inputs["input_ids"] == tokenizer.mask_token_id)[0].nonzero(as_tuple=True)[0]
mask_token_logits = logits[0, mask_token_index, :]

top_k = 5
top_tokens = torch.topk(mask_token_logits, top_k, dim=1).indices[0].tolist()

predictions = []
for token in top_tokens:
    token_str = tokenizer.decode([token]).strip()
    score = torch.softmax(mask_token_logits, dim=1)[0, token].item()
    sequence = text.replace(tokenizer.mask_token, token_str)
    predictions.append({"token": token, "score": score, "token_str": token_str, "sequence": sequence})

RESULT = {"predictions": predictions}
