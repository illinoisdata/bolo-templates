{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-tn-en" %}
{% set input_texts = ["Sbah el khir, kifeh el hal?"] %}
{% set num_beams = 4 %}
{% set max_length = 128 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_texts = {{ input_texts | tojson }}
num_beams = {{ num_beams }}
max_length = {{ max_length }}

from pathlib import Path

from transformers import MarianTokenizer, AutoModelForSeq2SeqLM

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)

encoded_inputs = tokenizer(
    input_texts,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_length,
)
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
