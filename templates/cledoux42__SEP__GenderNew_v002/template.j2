{% set repo_id = repo_id | default("cledoux42/GenderNew_v002") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set image_input = image_input | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}
{% set feature_extractor_repo = feature_extractor_repo | default("google/vit-base-patch16-224-in21k") %}
{% set cuda_library_dirs = cuda_library_dirs | default(["/workspace/cuda_compat", "/workspace/.pip/nvidia/cu13/lib"]) %}

task = {{ task | tojson }}
image_input = {{ image_input | tojson }}
feature_extractor_repo = {{ feature_extractor_repo | tojson }}
cuda_library_dirs = {{ cuda_library_dirs | tojson }}
model_id = {{ repo_id | tojson }}
device = {{ device | tojson }}

import os
import sys

if "CUDA_LD_PREPENDED" not in os.environ:
    existing_ld_library_path = os.environ.get("LD_LIBRARY_PATH")
    paths = [p for p in cuda_library_dirs if p]
    if existing_ld_library_path:
        paths.append(existing_ld_library_path)
    os.environ["LD_LIBRARY_PATH"] = os.pathsep.join(paths)
    os.environ["CUDA_LD_PREPENDED"] = "1"
    os.execve(sys.executable, [sys.executable] + sys.argv, os.environ)

from transformers import ViTImageProcessor, pipeline

image_processor = ViTImageProcessor.from_pretrained(feature_extractor_repo)
pipe = pipeline(task=task, model=model_id, device=device, image_processor=image_processor)

input_data = image_input
result = pipe(input_data)
RESULT = {"predictions": result}
