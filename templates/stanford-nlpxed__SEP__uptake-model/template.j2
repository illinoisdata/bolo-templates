{% set repo_id = repo_id | default("stanford-nlpxed/uptake-model") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('This is a test sentence for inference.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}

import torch
from transformers import AutoModel, AutoTokenizer
from huggingface_hub import hf_hub_download

weights_path = hf_hub_download(repo_id=repo_id, filename='pytorch_model.bin')

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModel.from_pretrained(repo_id, local_files_only=True)
state_dict = torch.load(weights_path, map_location='cpu')
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors='pt', truncation=True, padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

last_hidden_state = outputs.last_hidden_state
pooler_output = getattr(outputs, 'pooler_output', None)
RESULT = {
    'last_hidden_state': last_hidden_state.detach().cpu(),
    'pooler_output': None if pooler_output is None else pooler_output.detach().cpu(),
}
