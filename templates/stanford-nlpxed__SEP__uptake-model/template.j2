{% set repo_id = "stanford-nlpxed/uptake-model" %}
{% set device = "cuda:0" %}
{% set input_text = "The patient is showing signs of improvement." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = "{{ input_text }}"

from pathlib import Path
import json
import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer

model = AutoModelForSequenceClassification.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

encoded_inputs = tokenizer(input_text, return_tensors="pt", truncation=True)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    outputs = model(**encoded_inputs)

logits = outputs.logits
logits_cpu = logits.detach().to("cpu")
logits_list = logits_cpu.tolist()

RESULT = {"logits": logits_list}
