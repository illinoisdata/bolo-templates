{% set repo_id = repo_id | default("facebook/vit-mae-base") %}
{% set device = device | default("cuda:0") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"

import os
import requests
import torch
from PIL import Image
from transformers import AutoImageProcessor, ViTMAEForPreTraining
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename='config.json')
preprocessor_path = hf_hub_download(repo_id=repo_id, filename='preprocessor_config.json')
weights_path = hf_hub_download(repo_id=repo_id, filename='model.safetensors')

if image_path.startswith('http://') or image_path.startswith('https://'):
    image = Image.open(requests.get(image_path, stream=True).raw).convert('RGB')
else:
    image = Image.open(image_path).convert('RGB')

processor = AutoImageProcessor.from_pretrained(os.path.dirname(preprocessor_path))
model = ViTMAEForPreTraining.from_pretrained(os.path.dirname(weights_path))
model = model.to(device)
model.eval()

inputs = processor(images=image, return_tensors='pt')
inputs = {k: v.to(device) for k, v in inputs.items()}
with torch.no_grad():
    outputs = model(**inputs)

RESULT = {
    'loss': outputs.loss.detach().cpu().item() if outputs.loss is not None else None,
    'mask': outputs.mask.detach().cpu(),
    'ids_restore': outputs.ids_restore.detach().cpu(),
}
