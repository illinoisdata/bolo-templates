{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-de-es" %}
{% set src_text = "Hallo Welt" %}
{% set max_length = 128 %}
{% set num_beams = 4 %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = "{{ src_text }}"
max_length = {{ max_length }}
num_beams = {{ num_beams }}

from pathlib import Path

import torch
from transformers import AutoModelForSeq2SeqLM, MarianTokenizer

torch_device = torch.device(device)

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(torch_device)

model_inputs = tokenizer(src_text, return_tensors="pt", padding=True)
model_inputs = {name: tensor.to(torch_device) for name, tensor in model_inputs.items()}

generated_tokens = model.generate(**model_inputs, max_length=max_length, num_beams=num_beams)

translation = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)[0]

RESULT = {"translation": translation}
