{% set repo_id = repo_id | default("jurabi/bert-ner-japanese") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("token-classification") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("株式会社Jurabiは、東京都台東区に本社を置くIT企業である。") %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
RESULT = pipe(input_prompt)
