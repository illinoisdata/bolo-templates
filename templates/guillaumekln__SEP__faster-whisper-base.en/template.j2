{% set repo_id = repo_id | default("guillaumekln/faster-whisper-base.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set compute_type = compute_type | default('int8_float16') %}
{% set beam_size = beam_size | default(5) %}
{% set language = language | default('en') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
compute_type = "{{ compute_type }}"
beam_size = {{ beam_size }}
language = "{{ language }}"

import os
import torch
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_bin = hf_hub_download(repo_id=repo_id, filename="model.bin")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")
_ = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
_ = hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")
model_dir = os.path.dirname(model_bin)

if device.startswith("cuda") and torch.cuda.is_available():
    ct2_device = "cuda"
else:
    ct2_device = "cpu"
    compute_type = "float32"

model = WhisperModel(model_dir, device=ct2_device, compute_type=compute_type)
segments, info = model.transcribe(audio_path, beam_size=beam_size, language=language)
transcription = "".join(segment.text for segment in segments)
segment_list = [{"start": segment.start, "end": segment.end, "text": segment.text} for segment in segments]

RESULT = {"text": transcription, "segments": segment_list, "language": info.language, "language_probability": info.language_probability}
