{% set device = "cuda:0" %}
{% set repo_id = "Helsinki-NLP/opus-mt-pl-de" %}
{% set input_text = "Przykładowe zdanie po polsku do przetłumaczenia." %}
{% set max_length = 256 %}
{% set num_beams = 4 %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = """{{ input_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}

import os
import torch
from transformers import MarianMTModel, MarianTokenizer

tokenizer = MarianTokenizer.from_pretrained(repo_id)
model = MarianMTModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}
with torch.no_grad():
    generated_tokens = model.generate(
        **encoded_inputs,
        max_length=max_length,
        num_beams=num_beams,
    )
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translation": translations}
