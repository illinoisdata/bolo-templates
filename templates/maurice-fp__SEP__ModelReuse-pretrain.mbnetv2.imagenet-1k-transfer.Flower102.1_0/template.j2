{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set repo_id = repo_id | default("maurice-fp/ModelReuse-pretrain.mbnetv2.imagenet-1k-transfer.Flower102.1_0") %}
{% set device = device | default("cuda:0") %}
{% set topk = topk | default(5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
topk = {{ topk }}

import json
import torch
from PIL import Image
from huggingface_hub import hf_hub_download
import timm
from timm.data import resolve_data_config, create_transform

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")

with open(config_path, "r") as f:
    cfg = json.load(f)

img = Image.open(image_path).convert("RGB")

model = timm.create_model(
    "mobilenetv2_100",
    pretrained=False,
    num_classes=cfg["num_classes"],
)
state_dict = torch.load(weights_path, map_location="cpu") if weights_path.endswith(".bin") else __import__("safetensors.torch").torch.load_file(weights_path)
if isinstance(state_dict, dict) and "state_dict" in state_dict:
    state_dict = state_dict["state_dict"]
missing, unexpected = model.load_state_dict(state_dict, strict=False)
model.to(device)
model.eval()

pretrained_cfg = cfg.get("pretrained_cfg", {})
data_config = resolve_data_config(
    {
        "input_size": pretrained_cfg.get("input_size", [3, 224, 224]),
        "interpolation": "bicubic",
        "mean": pretrained_cfg.get("mean", [0.485, 0.456, 0.406]),
        "std": pretrained_cfg.get("std", [0.229, 0.224, 0.225]),
    },
    model=model,
)
transform = create_transform(**data_config, is_training=False)
input_tensor = transform(img).unsqueeze(0).to(device)

with torch.no_grad():
    logits = model(input_tensor)
    probs = torch.softmax(logits, dim=-1)[0]
    values, indices = torch.topk(probs, k=min(topk, probs.shape[-1]))

RESULT = {
    "pred_indices": indices.detach().cpu().tolist(),
    "pred_probs": values.detach().cpu().tolist(),
    "missing_keys": list(missing),
    "unexpected_keys": list(unexpected),
}
