{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("adrianjoheni/translation-model-opus") %}
{% set source_text = source_text | default("Hello, how are you doing today?") %}
{% set max_length = max_length | default(128) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_text = "{{ source_text }}"
max_length = {{ max_length }}

import torch
from pathlib import Path
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

device = torch.device(device)

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
model.eval()

encoded_inputs = tokenizer(
    source_text,
    return_tensors="pt",
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**encoded_inputs)

decoded_texts = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
translation = decoded_texts[0] if decoded_texts else ""

RESULT = {"translation": translation}
