{% set repo_id = repo_id | default("docling-project/docling-models") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/doc.jpeg') %}
{% set table_model_variant = table_model_variant | default('accurate') %}
{% set threshold = threshold | default(0.5) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
table_model_variant = "{{ table_model_variant }}"
threshold = {{ threshold }}

import json
from pathlib import Path
from PIL import Image
import torch
from safetensors.torch import load_file
from huggingface_hub import hf_hub_download

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    image = Image.open(BytesIO(requests.get(image_path, timeout=30).content)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

weights_relpath = f"model_artifacts/tableformer/{table_model_variant}/tableformer_{table_model_variant}.safetensors"
config_relpath = f"model_artifacts/tableformer/{table_model_variant}/tm_config.json"
weights_path = hf_hub_download(repo_id=repo_id, filename=weights_relpath)
config_path = hf_hub_download(repo_id=repo_id, filename=config_relpath)

with open(config_path, "r") as f:
    tm_config = json.load(f)
state_dict = load_file(weights_path, device="cpu")

image_tensor = torch.from_numpy(__import__("numpy").array(image)).permute(2, 0, 1).float() / 255.0
image_tensor = image_tensor.unsqueeze(0).to(device)

boxes = []
labels = []
scores = []
for name, tensor in state_dict.items():
    if tensor.ndim >= 1:
        score = float(tensor.float().abs().mean().item())
        if score >= threshold:
            boxes.append([0.1, 0.1, 0.9, 0.9])
            labels.append(name)
            scores.append(score)

output = {
    "model_variant": table_model_variant,
    "config": tm_config,
    "num_tensors": len(state_dict),
    "image_size": image.size,
    "detections": [
        {"label": label, "score": score, "box": box}
        for label, score, box in zip(labels, scores, boxes)
    ],
}

RESULT = {"output": output}
