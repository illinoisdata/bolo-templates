{% set repo_id = repo_id | default("timm/maxvit_base_tf_224.in1k") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("image-classification") %}
{% set input_image = input_image | default("/u/yunqili4/projects/ML-code-generation/data/image1.jpeg") %}


# variables emitted for template usage
task = {{ task | tojson }}
model = {{ repo_id | tojson }}
device = {{ device | tojson }}
input_image = {{ input_image | tojson }}

from PIL import Image
from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)

image = Image.open(input_image).convert("RGB")
raw_output = pipe(image)

RESULT = {"predictions": raw_output}
