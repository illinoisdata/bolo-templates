{% set repo_id = repo_id | default("bloomberg/KeyBART") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('In this work, we explore how to learn task specific language models aimed towards learning rich representation of keyphrases from text documents.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_file = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_file = hf_hub_download(repo_id=repo_id, filename="merges.txt")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, local_files_only=True)
tokenizer = AutoTokenizer.from_pretrained(repo_id, local_files_only=True)
model = model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=1024)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(
        **inputs,
        num_beams=4,
        max_new_tokens=64,
        no_repeat_ngram_size=3,
        early_stopping=True,
    )

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_text": output_text}
