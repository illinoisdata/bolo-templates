{% set repo_id = repo_id | default("keremberke/yolov8m-valorant-detection") %}
{% set device = device | default("cuda:0") %}
{% set image = image | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image = "{{ image }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import os
from huggingface_hub import hf_hub_download
from ultralytics import YOLO

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
_ = hf_hub_download(repo_id=repo_id, filename="config.json")

image_path = image

model = YOLO(weights_path)
model.overrides['conf'] = conf
model.overrides['iou'] = iou
model.overrides['agnostic_nms'] = agnostic_nms
model.overrides['max_det'] = max_det

results = model.predict(source=image_path, device=device, conf=conf, iou=iou, agnostic_nms=agnostic_nms, max_det=max_det, verbose=False)
result = results[0]

boxes = result.boxes
xyxy = boxes.xyxy.detach().cpu().numpy() if boxes is not None and len(boxes) else None
confidences = boxes.conf.detach().cpu().numpy() if boxes is not None and len(boxes) else None
class_ids = boxes.cls.detach().cpu().numpy().astype(int) if boxes is not None and len(boxes) else None
labels = [model.names[int(i)] for i in class_ids.tolist()] if class_ids is not None else []

RESULT = {
    "xyxy": xyxy,
    "conf": confidences,
    "cls": class_ids,
    "labels": labels,
}
