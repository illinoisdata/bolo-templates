{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("ml6team/mt5-small-german-query-generation") %}
{% set article_text = article_text | default("Das Lama (Lama glama) ist eine Art der Kamele. Es ist in den südamerikanischen Anden verbreitet und eine vom Guanako abstammende Haustierform.") %}
{% set max_length = max_length | default(64) %}
{% set num_beams = num_beams | default(4) %}
{% set num_return_sequences = num_return_sequences | default(4) %}
{% set output_filename = output_filename | default("generated_queries.txt") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
article_text = """{{ article_text }}"""
max_length = {{ max_length }}
num_beams = {{ num_beams }}
num_return_sequences = {{ num_return_sequences }}
output_filename = "{{ output_filename }}"

from pathlib import Path

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)
model.eval()

tokenized_inputs = tokenizer(article_text, return_tensors="pt", padding="longest", truncation=True)
tokenized_inputs = {key: value.to(device) for key, value in tokenized_inputs.items()}

generated_ids = model.generate(
    **tokenized_inputs,
    max_length=max_length,
    num_beams=num_beams,
    num_return_sequences=num_return_sequences,
)
generated_queries = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)

RESULT = {"generated_queries": generated_queries}
