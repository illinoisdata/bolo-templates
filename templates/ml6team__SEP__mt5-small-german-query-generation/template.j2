{% set repo_id = repo_id | default("ml6team/mt5-small-german-query-generation") %}
{% set device = device | default("cuda:0") %}
{% set question = question | default('Das Lama (Lama glama) ist eine Art der Kamele. Es ist in den südamerikanischen Anden verbreitet und eine vom Guanako abstammende Haustierform.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
question = "{{ question }}"

import os
import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

model_file = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_file = hf_hub_download(repo_id=repo_id, filename="config.json")
tokenizer_file = hf_hub_download(repo_id=repo_id, filename="spiece.model")
tokenizer_config_file = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_file = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")

# Load tokenizer/model

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=False, local_files_only=True)
model = AutoModelForSeq2SeqLM.from_config(__import__("transformers").MT5Config.from_json_file(config_file))
state_dict = torch.load(model_file, map_location="cpu")
model.load_state_dict(state_dict)
model.to(device)
model.eval()

inputs = tokenizer(question, return_tensors="pt", truncation=True, max_length=512)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_ids = model.generate(**inputs, max_new_tokens=32, num_beams=4)

output_text = tokenizer.decode(generated_ids[0], skip_special_tokens=True)

RESULT = {"generated_queries": output_text}
