{% set repo_id = repo_id | default("mozilla-ai/Mistral-7B-Instruct-v0.3-llamafile") %}
{% set device = device | default("cuda:0") %}
{% set quant_filename = quant_filename | default('Mistral-7B-Instruct-v0.3.Q6_K.llamafile') %}
{% set prompt = prompt | default('Write a short haiku about machine learning.') %}
{% set max_tokens = max_tokens | default(64) %}
{% set temperature = temperature | default(0.8) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
quant_filename = "{{ quant_filename }}"
prompt = "{{ prompt }}"
max_tokens = {{ max_tokens }}
temperature = {{ temperature }}

import os
import subprocess
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename=quant_filename)

cmd = [
    "bash",
    model_path,
    "-p", f"[INST]{prompt}[/INST]",
    "-n", str(max_tokens),
    "--temp", str(temperature),
    "-c", "0",
]

proc = subprocess.run(cmd, capture_output=True, text=True)
output_text = proc.stdout.strip()
if not output_text:
    output_text = proc.stderr.strip()

RESULT = {"output": output_text}
