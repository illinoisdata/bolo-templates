{% set repo_id = repo_id | default("keremberke/yolov8m-plane-detection") %}
{% set device = device | default("cuda:0") %}
{% set image_path = image_path | default('/u/yunqili4/projects/ML-code-generation/data/image1.jpeg') %}
{% set conf = conf | default(0.25) %}
{% set iou = iou | default(0.45) %}
{% set agnostic_nms = agnostic_nms | default(false) %}
{% set max_det = max_det | default(1000) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
image_path = "{{ image_path }}"
conf = {{ conf }}
iou = {{ iou }}
agnostic_nms = {{ agnostic_nms }}
max_det = {{ max_det }}

import json
from PIL import Image
from huggingface_hub import hf_hub_download
from ultralyticsplus import YOLO, render_result

weights_path = hf_hub_download(repo_id=repo_id, filename="best.pt")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")

with open(config_path, "r") as f:
    _cfg = json.load(f)

if isinstance(image_path, str) and image_path.startswith(("http://", "https://")):
    from urllib.request import urlopen
    image = Image.open(urlopen(image_path)).convert("RGB")
else:
    image = Image.open(image_path).convert("RGB")

model = YOLO(weights_path)
model.to(device)
model.overrides["conf"] = conf
model.overrides["iou"] = iou
model.overrides["agnostic_nms"] = agnostic_nms
model.overrides["max_det"] = max_det

results = model.predict(image)
result0 = results[0]
render = render_result(model=model, image=image, result=result0)

boxes = result0.boxes
if boxes is not None and len(boxes) > 0:
    detections = []
    for b in boxes:
        detections.append({
            "xyxy": b.xyxy.detach().cpu().tolist()[0],
            "conf": float(b.conf.detach().cpu().item()),
            "cls": int(b.cls.detach().cpu().item()),
        })
else:
    detections = []

RESULT = {"detections": detections, "render": render}
