{% set repo_id = repo_id | default("oliverguhr/spelling-correction-english-base") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default('lets do a comparsion') %}
{% set max_new_tokens = max_new_tokens | default(32) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = {{ text | tojson }}
max_new_tokens = {{ max_new_tokens }}

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
model_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
tokenizer_json_path = hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
merges_path = hf_hub_download(repo_id=repo_id, filename="merges.txt")

# Pre-process input & load model

tokenizer = AutoTokenizer.from_pretrained(repo_id, use_fast=True)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id, torch_dtype=torch.float32)
model.to(device)
model.eval()

inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
with torch.no_grad():
    output_ids = model.generate(**inputs, max_new_tokens=max_new_tokens)

# Post-process & build RESULT dict
output_text = tokenizer.decode(output_ids[0], skip_special_tokens=True)

RESULT = {"output_text": output_text}
