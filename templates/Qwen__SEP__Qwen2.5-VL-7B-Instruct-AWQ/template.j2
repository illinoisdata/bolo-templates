repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
input_image = {{ input_image | tojson }}
input_prompt = {{ input_prompt | tojson }}

import torch
import types
from transformers import pipeline
from transformers.quantizers import quantizers_utils

_original_should_convert_module = quantizers_utils.should_convert_module

def _should_convert_module(full_name, patterns=None):
    if "visual" in full_name:
        return False
    return _original_should_convert_module(full_name, patterns)

quantizers_utils.should_convert_module = _should_convert_module

pipe = pipeline(task=task, model=repo_id, device=device, dtype=torch.float16)

lm_head = pipe.model.lm_head
_original_lm_head_forward = lm_head.forward

def _lm_head_forward(self, hidden_states):
    return _original_lm_head_forward(hidden_states.to(self.weight.dtype, copy=False))

lm_head.forward = types.MethodType(_lm_head_forward, lm_head)

processor = pipe.processor if pipe.processor is not None else pipe.tokenizer

template = getattr(processor, "chat_template", None)
if template is None and hasattr(processor, "tokenizer"):
    template = getattr(processor.tokenizer, "chat_template", None)

has_chat_template = template is not None

if has_chat_template:
    messages = [
        {
            "role": "user",
            "content": [
                {"type": "image", "image": input_image},
                {"type": "text", "text": input_prompt},
            ],
        },
    ]
    RESULT = pipe(text=messages)
else:
    RESULT = pipe(input_image, text=input_prompt)
