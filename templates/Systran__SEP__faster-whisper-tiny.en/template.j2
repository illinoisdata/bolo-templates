{% set repo_id = repo_id | default("Systran/faster-whisper-tiny.en") %}
{% set device = device | default("cuda:0") %}
{% set audio_path = audio_path | default('/u/yunqili4/projects/ML-code-generation/data/audio.wav') %}
{% set language = language | default('en') %}
{% set beam_size = beam_size | default(1) %}
{% set temperature = temperature | default(0.0) %}
{% set task = task | default('transcribe') %}
{% set compute_type = compute_type | default('default') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
audio_path = "{{ audio_path }}"
language = "{{ language }}"
beam_size = {{ beam_size }}
temperature = {{ temperature }}
task = "{{ task }}"
compute_type = "{{ compute_type }}"

import os
import numpy as np
import soundfile as sf
from huggingface_hub import hf_hub_download
from faster_whisper import WhisperModel

model_bin = hf_hub_download(repo_id=repo_id, filename="model.bin")
hf_hub_download(repo_id=repo_id, filename="config.json")
hf_hub_download(repo_id=repo_id, filename="tokenizer.json")
hf_hub_download(repo_id=repo_id, filename="vocabulary.txt")

if audio_path.startswith(("http://", "https://")):
    import requests
    from io import BytesIO
    audio_bytes = requests.get(audio_path, timeout=30).content
    audio, sample_rate = sf.read(BytesIO(audio_bytes))
else:
    audio, sample_rate = sf.read(audio_path)

if audio.ndim > 1:
    audio = np.mean(audio, axis=1)

model_device = "cpu" if str(device).startswith("cuda") else device
model = WhisperModel(
    os.path.dirname(model_bin),
    device=model_device,
    compute_type=compute_type,
)

segments_iter, info = model.transcribe(
    audio,
    language=language,
    task=task,
    beam_size=beam_size,
    temperature=temperature,
)
segments = [
    {"start": float(segment.start), "end": float(segment.end), "text": segment.text}
    for segment in segments_iter
]

RESULT = {
    "text": "".join(segment["text"] for segment in segments).strip(),
    "segments": segments,
    "language": info.language,
    "language_probability": float(info.language_probability),
    "duration": float(info.duration),
}
