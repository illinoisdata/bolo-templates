{% set repo_id = repo_id | default("unsloth/Llama-3.2-3B-Instruct-unsloth-bnb-4bit") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("text-generation") %}
{% set model = model | default(repo_id) %}
{% set input_prompt = input_prompt | default("Hello, my name is Eric, how are you?") %}
{% set max_new_tokens = max_new_tokens | default(128) %}

task = {{ task | tojson }}
model = {{ model | tojson }}
device = {{ device | tojson }}
input_prompt = {{ input_prompt | tojson }}
max_new_tokens = {{ max_new_tokens }}

from transformers import pipeline

pipe = pipeline(task=task, model=model, device=device)
prepared_input = input_prompt
generation_kwargs = {"max_new_tokens": max_new_tokens}
RESULT = pipe(prepared_input, **generation_kwargs)
