{% set repo_id = repo_id | default("monologg/koelectra-base-v3-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set output_dir = output_dir | default("/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/monologg__SEP__koelectra-base-v3-discriminator") %}
{% set text = text | default("나는 내일 밥을 먹었다.") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
output_dir = "{{ output_dir }}"
text = "{{ text }}"

from transformers import AutoModelForPreTraining, ElectraTokenizer
import torch
import json
import os

# Load model and tokenizer
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
tokenizer = ElectraTokenizer.from_pretrained(repo_id)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
outputs = model(**inputs)
logits = outputs.logits
preds = torch.round((torch.sign(logits) + 1) / 2)[0]

# Post-process & build RESULT
tokens = tokenizer.convert_ids_to_tokens(inputs["input_ids"][0])
tokens = tokens[1:-1]
preds = preds.tolist()[1:-1]
predictions = [{"token": t, "prediction": p} for t, p in zip(tokens, preds)]

RESULT = {"predictions": predictions}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "predictions.json"), "w", encoding="utf-8") as f:
        json.dump(RESULT["predictions"], f, ensure_ascii=False, indent=2)