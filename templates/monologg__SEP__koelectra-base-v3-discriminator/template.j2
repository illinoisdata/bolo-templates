{% set repo_id = repo_id | default("monologg/koelectra-base-v3-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("나는 내일 밥을 먹었다.") %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"

from transformers import AutoModelForPreTraining, ElectraTokenizer
import torch
import json
import os

# Load model and tokenizer
model = AutoModelForPreTraining.from_pretrained(repo_id).to(device)
tokenizer = ElectraTokenizer.from_pretrained(repo_id)

# Pre-process input
inputs = tokenizer(text, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

# Run inference
outputs = model(**inputs)
logits = outputs.logits
preds = torch.round((torch.sign(logits) + 1) / 2)[0]

# Post-process & build RESULT
tokens = tokenizer.convert_ids_to_tokens(inputs["input_ids"][0])
tokens = tokens[1:-1]
preds = preds.tolist()[1:-1]
predictions = [{"token": t, "prediction": p} for t, p in zip(tokens, preds)]

RESULT = {"predictions": predictions}
