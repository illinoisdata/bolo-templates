{% set repo_id = repo_id | default("monologg/koelectra-base-v3-discriminator") %}
{% set device = device | default("cuda:0") %}
{% set text = text | default("나는 방금 밥을 먹었다.") %}
{% set fake_text = fake_text | default("나는 내일 밥을 먹었다.") %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
text = "{{ text }}"
fake_text = "{{ fake_text }}"

import torch
from transformers import ElectraForPreTraining, ElectraTokenizer
from huggingface_hub import hf_hub_download

model_path = hf_hub_download(repo_id=repo_id, filename="pytorch_model.bin")
config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.txt")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")

model = ElectraForPreTraining.from_pretrained(
    model_path,
    config=config_path,
).to(device)
model.eval()
tokenizer = ElectraTokenizer(vocab_file=vocab_path, tokenizer_file=None)

fake_tokens = tokenizer.tokenize(fake_text)
fake_inputs = tokenizer(fake_text, return_tensors="pt")
fake_inputs = {k: v.to(device) for k, v in fake_inputs.items()}

with torch.no_grad():
    discriminator_outputs = model(**fake_inputs)
    scores = discriminator_outputs.logits
    predictions = torch.round((torch.sign(scores) + 1) / 2)

RESULT = {
    "fake_tokens": fake_tokens,
    "predictions": predictions.detach().cpu().tolist(),
}
