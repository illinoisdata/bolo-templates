{% set source_sentence = "संयुक्त राष्ट्र के प्रमुख का कहना है कि सीरिया में कोई सैन्य समाधान नहीं है" %}
{% set source_lang = "hi_IN" %}
{% set target_lang = "en_XX" %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/facebook__SEP__mbart-large-50-many-to-one-mmt" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
source_sentence = """{{ source_sentence }}"""
source_lang = "{{ source_lang }}"
target_lang = "{{ target_lang }}"
output_dir = "{{ output_dir }}"

from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
import os

model = AutoModelForSeq2SeqLM.from_pretrained(repo_id).to(device)
tokenizer = AutoTokenizer.from_pretrained(repo_id)

tokenizer.src_lang = source_lang
tokenizer.tgt_lang = target_lang

encoded = tokenizer(source_sentence, return_tensors="pt")
encoded = {key: value.to(device) for key, value in encoded.items()}

generated_tokens = model.generate(**encoded)

decoded_sentences = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
primary_translation = decoded_sentences[0] if len(decoded_sentences) == 1 else decoded_sentences
translation = primary_translation if isinstance(primary_translation, str) else "\n".join(primary_translation)

RESULT = {
    "decoded_sentences": decoded_sentences,
    "translation": translation,
}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, "translation.txt")
    with open(output_path, "w", encoding="utf-8") as writer:
        writer.write(RESULT["translation"])