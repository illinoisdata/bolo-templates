{% set device = "cuda:0" %}
{% set repo_id = "facebook/mms-tts-nld" %}
{% set text_input = "Deze tekst dient als voorbeeld voor Nederlandse tekst naar spraak." %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
text_input = "{{ text_input }}"

import numpy as np
import torch
from pathlib import Path
from scipy.io import wavfile
from transformers import AutoTokenizer, VitsModel

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = VitsModel.from_pretrained(repo_id)
model = model.to(device)
model.eval()
inputs = tokenizer(text_input, return_tensors="pt")
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    outputs = model(**inputs)

waveform = outputs.waveform
waveform_tensor = waveform.squeeze(0).cpu()
waveform_array = waveform_tensor.numpy()
sampling_rate = int(model.config.sampling_rate)

RESULT = {"waveform": waveform_array, "sampling_rate": sampling_rate}
