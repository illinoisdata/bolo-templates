{% set repo_id = repo_id | default("ybelkada/hubert-tiny-random") %}
{% set device = device | default("cuda:0") %}
{% set task = task | default("feature-extraction") %}
{% set audio_path = audio_path | default("/u/yunqili4/projects/ML-code-generation/data/audio.wav") %}

repo_id = {{ repo_id | tojson }}
device = {{ device | tojson }}
task = {{ task | tojson }}
audio_path = {{ audio_path | tojson }}

from transformers import AutoFeatureExtractor, pipeline
import soundfile as sf

# Load processor & pipeline
feature_extractor = AutoFeatureExtractor.from_pretrained(repo_id)
pipe = pipeline(
    task=task,
    model=repo_id,
    tokenizer=feature_extractor,
    feature_extractor=feature_extractor,
    device=device,
)

# Pre-process input
speech_array, sampling_rate = sf.read(audio_path)
feature_extractor.sampling_rate = sampling_rate
if speech_array.ndim == 2:
    speech_array = speech_array.mean(axis=1)

# Run inference
RESULT = pipe(speech_array, sampling_rate=sampling_rate)

# Post-process & build RESULT dict
RESULT = {"output": RESULT}
