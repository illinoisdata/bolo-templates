{% set repo_id = "Helsinki-NLP/opus-mt-tc-big-en-pt" %}
{% set device = "cuda:0" %}
{% set src_text = [
    ">>por<< Tom tried to stab me.",
    ">>por<< He has been to Hawaii several times."
] %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text }}

from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model.to(device)

# Pre-process
encoded = tokenizer(src_text, return_tensors="pt", padding=True)
encoded = {k: v.to(device) for k, v in encoded.items()}

# Inference
generated_tokens = model.generate(**encoded)

# Post-process
translations = [tokenizer.decode(t, skip_special_tokens=True) for t in generated_tokens]

RESULT = {"translations": translations}
