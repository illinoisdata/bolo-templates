{% set input_text = ["Kolme kolmanteen on kaksikymmentäseitsemän.", "Heille syntyi poikavauva."] %}
{% set num_beams = 6 %}
{% set max_length = 256 %}
{% set output_dir = "/u/yli77/work_link/yli77/templates/milestone1/transformers/others/_mini-swe/Helsinki-NLP__SEP__opus-mt-tc-big-fi-en" %}

repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
num_beams = {{ num_beams }}
max_length = {{ max_length }}
output_dir = "{{ output_dir }}"

import os
from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

# Pre-process input
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

# Run inference
generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_length,
)

# Post-process
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}

if __name__ == "__main__":
    os.makedirs(output_dir, exist_ok=True)
    translations_path = Path(output_dir) / "translations.txt"
    with open(translations_path, "w", encoding="utf-8") as out_file:
        for item in RESULT["translations"]:
            out_file.write(f"{item}\n")