{% set device = device | default("cuda:0") %}
{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-fi-en") %}
{% set input_text = input_text | default(["Kolme kolmanteen on kaksikymmentäseitsemän.", "Heille syntyi poikavauva."]) %}
{% set num_beams = num_beams | default(6) %}
{% set max_length = max_length | default(256) %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
input_text = {{ input_text | tojson }}
num_beams = {{ num_beams }}
max_length = {{ max_length }}

import os
from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(repo_id)
model = AutoModelForSeq2SeqLM.from_pretrained(repo_id)
model = model.to(device)

# Pre-process input
encoded_inputs = tokenizer(
    input_text,
    return_tensors="pt",
    padding=True,
    truncation=True,
    max_length=max_length,
)
encoded_inputs = {key: value.to(device) for key, value in encoded_inputs.items()}

# Run inference
generated_tokens = model.generate(
    **encoded_inputs,
    num_beams=num_beams,
    max_length=max_length,
)

# Post-process
translations = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)

RESULT = {"translations": translations}
