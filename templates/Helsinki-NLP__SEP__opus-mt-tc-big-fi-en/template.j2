{% set repo_id = repo_id | default("Helsinki-NLP/opus-mt-tc-big-fi-en") %}
{% set device = device | default("cuda:0") %}
{% set src_text = src_text | default('Kolme kolmanteen on kaksikymmentäseitsemän.') %}
repo_id = "{{ repo_id }}"
device = "{{ device }}"
src_text = {{ src_text | tojson }}

import torch
from transformers import MarianMTModel, MarianTokenizer
from huggingface_hub import hf_hub_download

config_path = hf_hub_download(repo_id=repo_id, filename="config.json")
weights_path = hf_hub_download(repo_id=repo_id, filename="model.safetensors")
tokenizer_config_path = hf_hub_download(repo_id=repo_id, filename="tokenizer_config.json")
special_tokens_map_path = hf_hub_download(repo_id=repo_id, filename="special_tokens_map.json")
vocab_path = hf_hub_download(repo_id=repo_id, filename="vocab.json")
source_spm_path = hf_hub_download(repo_id=repo_id, filename="source.spm")
target_spm_path = hf_hub_download(repo_id=repo_id, filename="target.spm")
generation_config_path = hf_hub_download(repo_id=repo_id, filename="generation_config.json")

# Load tokenizer and model
# MarianTokenizer can infer sentencepiece files from the local files if passed the directory
model_dir = "/".join(config_path.split("/")[:-1])
tokenizer = MarianTokenizer.from_pretrained(model_dir, local_files_only=True)
model = MarianMTModel.from_pretrained(model_dir, local_files_only=True, torch_dtype=torch.float16 if torch.cuda.is_available() and device.startswith("cuda") else None)
model.to(device)
model.eval()

inputs = tokenizer(src_text, return_tensors="pt", padding=True)
inputs = {k: v.to(device) for k, v in inputs.items()}

with torch.no_grad():
    generated_tokens = model.generate(**inputs, num_beams=6)

translated = tokenizer.batch_decode(generated_tokens, skip_special_tokens=True)
RESULT = {"translation": translated}
